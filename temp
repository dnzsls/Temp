def load_model_from_pickle(path=None, year=2026, month=8, verbose=True):
    """Aylık run pickle'ından slot bazlı model kadrosunu çıkarır.

    results[tarih][kuyruk]['mip_info'] içinden okur:
        mip_in_by_slot  → inhouse kişi
        mip_out_by_slot → outsource kişi
    Vardiya açmaya gerek yok; pickle zaten slot bazında tutuyor. Bu sayede
    surplus dağıtımı sonrası NİHAİ sayılar gelir (assignments ile aynı kaynak).

    Çıktı: data_date, interval,
           model_in_{q}, model_out_{q}  (her kuyruk)
           model_in_toplam, model_out_toplam, model_toplam
    """
    path = path or f"monthly_v9_forecast_{year}_{month:02d}.pkl"
    if not os.path.exists(path):
        raise FileNotFoundError(f"Pickle bulunamadı: {path}")

    with open(path, 'rb') as f:
        results = pickle.load(f)

    rows = []
    bos_gunler, eksik_kuyruk = [], []
    for date_str, day in results.items():
        d = pd.to_datetime(date_str)
        if d.year != year or d.month != month:
            continue
        if not day:
            bos_gunler.append(d)
            continue
        for q in QUEUES:
            r = day.get(q)
            if not r:
                eksik_kuyruk.append((d, q))
                continue
            mi = r.get('mip_info', {}) or {}
            inn = mi.get('mip_in_by_slot', {}) or {}
            out = mi.get('mip_out_by_slot', {}) or {}
            if not inn and not out:                      # ayrım yoksa toplamı inhouse say
                inn = mi.get('mip_by_slot', {}) or {}
            for slot in set(inn) | set(out):
                rows.append({'data_date': d, 'slot_30': slot, 'queue': q,
                             'inhouse': inn.get(slot, 0), 'outsource': out.get(slot, 0)})

    if not rows:
        raise ValueError(f"{path}: {year}/{month:02d} için sonuç yok.")

    long = pd.DataFrame(rows)

    first = pd.Timestamp(year=year, month=month, day=1)
    all_days = pd.date_range(first, first + pd.offsets.MonthEnd(1), freq='D')
    out = pd.MultiIndex.from_product(
        [all_days, SLOTS_30], names=['data_date', 'slot_30']).to_frame(index=False)

    for q in QUEUES:
        sub = long[long['queue'] == q][['data_date', 'slot_30', 'inhouse', 'outsource']]
        sub = sub.rename(columns={'inhouse': f"model_in_{q}", 'outsource': f"model_out_{q}"})
        out = out.merge(sub, on=['data_date', 'slot_30'], how='left')

    value_cols = [f"model_{s}_{q}" for q in QUEUES for s in ('in', 'out')]
    out[value_cols] = out[value_cols].fillna(0).round().astype(int)

    out['model_in_toplam'] = out[[f"model_in_{q}" for q in QUEUES]].sum(axis=1)
    out['model_out_toplam'] = out[[f"model_out_{q}" for q in QUEUES]].sum(axis=1)
    out['model_toplam'] = out['model_in_toplam'] + out['model_out_toplam']

    out['interval'] = out['slot_30']
    out = out.sort_values(['data_date', 'slot_30']).reset_index(drop=True)
    out = out[['data_date', 'interval'] + value_cols +
              ['model_in_toplam', 'model_out_toplam', 'model_toplam']]

    if verbose:
        _print_pickle_summary(out, long, all_days, bos_gunler, eksik_kuyruk, path)
    return out


def _print_pickle_summary(out, long, all_days, bos_gunler, eksik_kuyruk, path):
    kapsanan = long['data_date'].nunique()
    print(f"PICKLE: {os.path.basename(path)}  |  {kapsanan}/{len(all_days)} gün")
    if bos_gunler:
        print(f"  ⚠ sonucu boş (None) {len(bos_gunler)} gün: "
              f"{', '.join(d.strftime('%d.%m') for d in bos_gunler)}")
    if eksik_kuyruk:
        ozet = {}
        for d, q in eksik_kuyruk:
            ozet.setdefault(q, []).append(d.strftime('%d.%m'))
        for q, gunler in ozet.items():
            print(f"  ⚠ {q}: {len(gunler)} günde sonuç yok (INFEASIBLE olabilir): "
                  f"{', '.join(gunler[:10])}{' …' if len(gunler) > 10 else ''}")

    satirlar = [{
        'kuyruk': q,
        'inhouse_tepe': int(out[f"model_in_{q}"].max()),
        'outsource_tepe': int(out[f"model_out_{q}"].max()),
        'inhouse_kisi_slot': int(out[f"model_in_{q}"].sum()),
        'outsource_kisi_slot': int(out[f"model_out_{q}"].sum()),
    } for q in QUEUES]
    show(pd.DataFrame(satirlar))


# ---------------------------------------------------------------------------
# MODEL TARAFI — {data_date, kuyruk, vardiya, kisi, company} (tablo hâli)
# ---------------------------------------------------------------------------

def build_model_coverage(df_model, year=2026, month=8, model_cols=None,
                         company='inhouse', verbose=True):
    """Modelin vardiya bazlı kişi sayılarını slot ızgarasına açar.

    Plan tarafıyla AYNI shift_slots parser'ını kullanır — iki taraf arasında
    vardiya→slot yöntem farkı oluşmaz.

    Çıktı: data_date, interval, model_kitle, model_kurumsal, model_gold
    """
    cols = {**DEFAULT_MODEL_COLS, **(model_cols or {})}
    resolved = {k: _resolve_col(df_model, v) for k, v in cols.items()}

    zorunlu = ['date', 'queue', 'shift', 'kisi']
    eksik = [cols[k] for k in zorunlu if resolved[k] is None]
    if eksik:
        raise KeyError(f"MODEL: şu kolon(lar) yok: {eksik}  |  "
                       f"mevcut: {list(df_model.columns)}")

    df = df_model.copy()
    df['data_date'] = _to_date_series(df[resolved['date']]).dt.normalize()
    df['queue'] = _normalize_queue(df[resolved['queue']])
    df['kisi'] = pd.to_numeric(df[resolved['kisi']], errors='coerce').fillna(0)

    # Company filtresi
    if company and resolved['company'] is not None:
        c = df[resolved['company']].astype(str).str.strip().str.lower()
        n0 = len(df)
        df = df[c == str(company).lower()]
        if verbose and len(df) < n0:
            print(f"  ℹ MODEL: company='{company}' filtresi — "
                  f"{n0 - len(df):,} satır elendi ({len(df):,} kaldı).")
    elif company and verbose:
        print(f"  ℹ MODEL: company kolonu yok, filtre uygulanmadı.")

    n0 = len(df)
    df = df[(df['data_date'].dt.year == year) & (df['data_date'].dt.month == month)]
    if verbose and len(df) < n0:
        print(f"  ℹ MODEL: {n0 - len(df):,} satır {year}/{month:02d} dışında, elendi.")

    bilinmeyen = df[df['queue'].isna()][resolved['queue']].dropna().unique()
    if len(bilinmeyen):
        print(f"  ⚠ MODEL: tanınmayan kuyruk değerleri elendi: {list(bilinmeyen)[:10]}")
    df = df[df['queue'].notna()]

    slot_map = {v: shift_slots(v) for v in df[resolved['shift']].astype(str).unique()}
    cozulmeyen = [v for v, s in slot_map.items() if not s]
    if cozulmeyen:
        print(f"  ⚠ MODEL: vardiya olarak okunamayan {len(cozulmeyen)} değer "
              f"(kapsamaya girmedi): {cozulmeyen[:8]}")

    df['slot_30'] = df[resolved['shift']].astype(str).map(slot_map)
    df = df.explode('slot_30').dropna(subset=['slot_30'])

    model = (df.groupby(['data_date', 'slot_30', 'queue'])['kisi']
               .sum().rename('kisi').reset_index())

    first = pd.Timestamp(year=year, month=month, day=1)
    all_days = pd.date_range(first, first + pd.offsets.MonthEnd(1), freq='D')
    out = pd.MultiIndex.from_product(
        [all_days, SLOTS_30], names=['data_date', 'slot_30']).to_frame(index=False)

    for q in QUEUES:
        sub = model[model['queue'] == q][['data_date', 'slot_30', 'kisi']]
        out = out.merge(sub.rename(columns={'kisi': f"model_{q}"}),
                        on=['data_date', 'slot_30'], how='left')

    value_cols = [f"model_{q}" for q in QUEUES]
    out[value_cols] = out[value_cols].fillna(0).round().astype(int)
    out['interval'] = out['slot_30']
    out = out.sort_values(['data_date', 'slot_30']).reset_index(drop=True)
    out = out[['data_date', 'interval'] + value_cols]

    if verbose:
        print("MODEL kapsama — tepe kişi: " +
              '  '.join(f"{q}={int(out[f'model_{q}'].max())}" for q in QUEUES))
    return out


