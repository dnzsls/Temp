def _eksen(ax, g, adim=4, y_adim=None):
    ax.set_xticks(range(0, len(g), adim))
    ax.set_xticklabels([g['interval'].iloc[i] for i in range(0, len(g), adim)],
                       fontsize=8, color=RENK['metin2'])
    ax.grid(axis='y', color=RENK['izgara'], lw=1, zorder=0)
    ax.set_axisbelow(True)
    # DİKEY kılavuz — alan dolgularının ÜSTÜNE çizilir; grid'e bırakılırsa
    # dolgunun altında kalıp tam okunması gereken yerde kayboluyor.
    for i in range(0, len(g), adim):
        ax.axvline(i, color=RENK['metin2'], lw=0.6, alpha=0.22, zorder=3.5)
    for k in ('top', 'right'):
        ax.spines[k].set_visible(False)
    for k in ('left', 'bottom'):
        ax.spines[k].set_color(RENK['izgara'])
    ax.tick_params(colors=RENK['metin2'], labelsize=8)
    # sharex/sharey olsa bile HER panel kendi sayısal değerlerini yazsın
    ax.tick_params(labelbottom=True, labelleft=True)
    ax.set_xlim(-0.5, len(g) - 0.5)
    ax.set_facecolor(RENK['yuzey'])
    if y_adim:
        from matplotlib.ticker import MultipleLocator
        ax.yaxis.set_major_locator(MultipleLocator(y_adim))
        ax.set_ylim(bottom=0)


def _kutu(ax, metin, konum=(0.98, 0.95), renk='#fff7d6'):
    ax.text(*konum, metin, transform=ax.transAxes, ha='right', va='top',
            fontsize=8, color=RENK['metin'],
            bbox=dict(boxstyle='round,pad=0.4', facecolor=renk,
                      edgecolor='#d9d2a8', linewidth=0.8))


def _kismi_notu(g):
    """Panel başlığına eklenecek not: kısmiler bu tabloda var mı, yok mu.

    Veriden türetilir — hangi tabloyu (df_genel / df_genel_kismili) verirsen
    ver, başlık doğru yazar. Modelde hafta içi kısmi olmadığı için orada da
    otomatik '(kısmisiz)' çıkar.
    """
    if 'kapasite_pt' not in g:
        return ''
    return ' (kısmiler dahil)' if float(g['kapasite_pt'].sum()) > 0 else ' (kısmisiz)'


def _cagri_paneli(ax, g, etiket='Gerçekleşen çağrı', adim=None):
    """Üstteki ince çağrı paneli — alttaki grafikle AYNI x ekseni."""
    x = range(len(g))
    ax.fill_between(x, g['cagri'], color=RENK['cagri'], alpha=0.18, zorder=1)
    ax.plot(x, g['cagri'], color=RENK['cagri'], lw=1.8, zorder=3, label=etiket)
    ax.set_ylabel('çağrı adedi', fontsize=9, color=RENK['cagri'])
    ax.tick_params(axis='y', colors=RENK['cagri'], labelsize=8, labelleft=True)
    ax.set_xticks(range(0, len(g), 4))
    ax.set_xticklabels([g['interval'].iloc[i] for i in range(0, len(g), 4)],
                       fontsize=7.5, color=RENK['metin2'])
    ax.tick_params(axis='x', labelbottom=True)   # sharex olsa da yazsın
    ax.grid(axis='y', color=RENK['izgara'], lw=1, zorder=0)
    ax.set_axisbelow(True)
    for i in range(0, len(g), 4):
        ax.axvline(i, color=RENK['metin2'], lw=0.6, alpha=0.22, zorder=2)
    for k in ('top', 'right'):
        ax.spines[k].set_visible(False)
    for k in ('left', 'bottom'):
        ax.spines[k].set_color(RENK['izgara'])
    ax.set_facecolor(RENK['yuzey'])
    ax.set_ylim(bottom=0)
    ax.set_xlim(-0.5, len(g) - 0.5)
    if adim:
        from matplotlib.ticker import MultipleLocator
        ax.yaxis.set_major_locator(MultipleLocator(adim))
    i_tepe = int(g['cagri'].idxmax())
    ax.annotate(f"tepe {g['cagri'].iloc[i_tepe]:,.0f} @ {g['interval'].iloc[i_tepe]}",
                xy=(i_tepe, g['cagri'].iloc[i_tepe]), xytext=(0, 4),
                textcoords='offset points', ha='center', fontsize=7.5,
                color=RENK['cagri'])
    return ax


def grafik_genel(df, queue='KİTLE', kirilim=False, olcu='ortalama', y_adim=25,
                 cagri_adim=None, cagri_ust=True, kaydet=None):
    """Hafta içi / hafta sonu: slot kapasitesi + vardiya başlangıcı + çağrı.

    kirilim=True  → kapasite inhouse/outsource ayrı çizilir
    olcu          → 'ortalama' (varsayılan) veya 'medyan'
    y_adim        → kişi ekseninde tick aralığı; None = otomatik
    cagri_adim    → çağrı ekseninde tick aralığı; None = otomatik
    cagri_ust=True → çağrı ÜSTTE ayrı panelde, x ekseni ortak (çift eksen yok)
    cagri_ust=False → eski hal: çağrı sağ eksende kesikli
    """
    import matplotlib.pyplot as plt

    if cagri_ust:
        fig, axes = plt.subplots(2, 2, figsize=(16, 7.5), sharex='col',
                                 gridspec_kw={'height_ratios': [1, 2.8]})
        ust, alt = axes[0], axes[1]
    else:
        fig, alt = plt.subplots(1, 2, figsize=(16, 5.5))
        ust = [None, None]
    fig.patch.set_facecolor(RENK['yuzey'])

    for j, (hs, ad) in enumerate([(0, 'HAFTA İÇİ'), (1, 'HAFTA SONU')]):
        ax = alt[j]
        g = slot_ozet(df, hafta_sonu=hs, olcu=olcu)
        if g.empty:
            ax.set_visible(False)
            if ust[j] is not None:
                ust[j].set_visible(False)
            continue
        x = range(len(g))

        if cagri_ust:
            _cagri_paneli(ust[j], g, adim=cagri_adim)
            ust[j].set_title(f"{queue} — {ad} ({olcu})", fontsize=11,
                             fontweight='bold', color=RENK['metin'],
                             loc='left', pad=8)
            if j == 0:
                ust[j].legend(loc='upper left', frameon=False, fontsize=8,
                              labelcolor=RENK['metin2'])

        if kirilim:
            ust_in = g['kapasite_in']
            ust_out = ust_in + g['kapasite_out']
            ax.fill_between(x, ust_in, color=RENK['inhouse'],
                            alpha=0.45, zorder=1, label='Kapasite — inhouse')
            ax.fill_between(x, ust_in, ust_out, color=RENK['outsource'],
                            alpha=0.85, zorder=1, label='Kapasite — outsource')
            if g['kapasite_pt'].sum() > 0:
                ax.fill_between(x, ust_out, g['kapasite_toplam'],
                                color=RENK['kismi'], alpha=0.60, zorder=1,
                                label='Kapasite — kısmi')
            ax.plot(x, g['kapasite_toplam'], color=RENK['kapasite'], lw=2, zorder=3)
        else:
            ax.fill_between(x, g['kapasite_toplam'], color=RENK['dolgu'],
                            zorder=1, label='Slot kapasitesi (sahadaki kişi)')
            ax.plot(x, g['kapasite_toplam'], color=RENK['kapasite'], lw=2,
                    marker='o', ms=3.5, zorder=3)

        ax.plot(x, g['baslangic_toplam'], color=RENK['baslangic'], lw=2,
                marker='o', ms=3.5, zorder=4, label='Vardiya başlangıcı (kaç kişi başlıyor)')

        ax.set_ylabel('kişi', fontsize=9, color=RENK['metin2'])
        if not cagri_ust:
            ax.set_title(f"{queue} — {ad} ({olcu})\n"
                         f"Slot kapasitesi vs vardiya başlangıcı",
                         fontsize=11, fontweight='bold', color=RENK['metin'],
                         loc='left', pad=10)
        _eksen(ax, g, y_adim=y_adim)

        if not cagri_ust:                                 # eski hal: sağ eksen
            ax2 = ax.twinx()
            ax2.plot(x, g['cagri'], color=RENK['cagri'], lw=1.8, ls='--',
                     zorder=5, label='Çağrı adedi')
            ax2.set_ylabel('çağrı adedi', fontsize=9, color=RENK['cagri'])
            ax2.tick_params(axis='y', colors=RENK['cagri'], labelsize=8)
            for k in ('top', 'left'):
                ax2.spines[k].set_visible(False)
            ax2.spines['right'].set_color(RENK['cagri'])
            ax2.grid(False)
            ax2.set_ylim(bottom=0)
            if cagri_adim:
                from matplotlib.ticker import MultipleLocator
                ax2.yaxis.set_major_locator(MultipleLocator(cagri_adim))

        i_tepe = int(g['kapasite_toplam'].idxmax())
        _kutu(ax, f"Tepe kapasite\n{g['kapasite_toplam'].iloc[i_tepe]:.0f} kişi "
                  f"@ {g['interval'].iloc[i_tepe]}")
        etiket = 'ortalaması' if olcu == 'ortalama' else 'medyanı'
        _kutu(ax, f"{int(g['gun_sayisi'].iloc[0])} gün {etiket}",
              konum=(0.98, 0.72), renk='#eaf1fb')

        if cagri_ust:
            ax.legend(loc='upper left', frameon=False, fontsize=8,
                      labelcolor=RENK['metin2'])
        else:
            h1, l1 = ax.get_legend_handles_labels()
            h2, l2 = ax2.get_legend_handles_labels()
            ax.legend(h1 + h2, l1 + l2, loc='upper left', frameon=False,
                      fontsize=8, labelcolor=RENK['metin2'])

    fig.tight_layout()
    if kaydet:
        fig.savefig(kaydet, dpi=150, facecolor=fig.get_facecolor())
        print(f"✓ {kaydet}")
    return fig


def grafik_olcekli(df, queue='KİTLE', olcu='ortalama', y_adim=25,
                   olcek='ortak', kirilim=True, kaydet=None):
    """TEK EKSEN: kapasite + vardiya başlangıcı + ÖLÇEKLENMİŞ çağrı.

    Çağrı bir çarpanla kişi eksenine oturtulur:  k = tepe_kapasite / tepe_çağrı

    ⚠ Amaç yalnızca ŞEKİL karşılaştırması. Eğrilerin kesişmesi HİÇBİR ŞEY
      ifade etmez — çarpan keyfîdir. Anlamlı (birimli) karşılaştırma için
      HÜCRE 12'ye bak: orada çağrı 'gereken kişi'ye çevriliyor.

    olcek='ortak' (varsayılan) → hafta içi ve hafta sonu AYNI çarpanı kullanır;
        iki panel birbiriyle kıyaslanabilir kalır.
    olcek='panel' → her panel kendi çarpanını kullanır; şekil uyumu en iyi
        olur ama paneller arası kıyas bozulur.
    """
    import matplotlib.pyplot as plt

    veri = {hs: slot_ozet(df, hafta_sonu=hs, olcu=olcu) for hs in (0, 1)}
    dolu = [g for g in veri.values() if not g.empty]
    if not dolu:
        raise ValueError("Çizilecek veri yok.")
    if olcek not in ('ortak', 'panel'):
        raise ValueError("olcek: 'ortak' veya 'panel'")

    k_ortak = (max(g['kapasite_toplam'].max() for g in dolu)
               / max(g['cagri'].max() for g in dolu))
    y_max = max(g['kapasite_toplam'].max() for g in dolu) * 1.30

