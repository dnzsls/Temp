# HAKEM — gerçek çağrıdan Erlang ihtiyacı, kim daha yakın?
# ---------------------------------------------------------------------------

import math

# kitle erlang ayarları (CONFIG_WEEKDAY['queue_configs']['kitle']['erlang'])
TARGET_ASA = 30
INTERVAL_MIN = 30
KITLE_SHRINKAGE = {
    0: 0.07, 1: 0.07, 2: 0.07, 3: 0.07, 4: 0.07, 5: 0.07, 6: 0.07,
    7: 0.07, 8: 0.07, 9: 0.24, 10: 0.17, 11: 0.17, 12: 0.16,
    13: 0.19, 14: 0.21, 15: 0.25, 16: 0.26, 17: 0.29, 18: 0.18,
    19: 0.17, 20: 0.18, 21: 0.14, 22: 0.13, 23: 0.19, 'default': 0.0,
}


def _erlang_c(agents, traffic):
    if agents <= traffic or agents == 0:
        return 1.0
    eb = traffic / agents
    for i in range(2, int(agents) + 1):
        eb = (traffic * eb) / (i + traffic * eb)
    return min(eb / (1 - (traffic / agents) * (1 - eb)), 1.0)


def _asa(agents, traffic, aht):
    if agents <= traffic or agents == 0:
        return 999
    return (_erlang_c(agents, traffic) * (aht / 60)) / (agents - traffic) * 60


def gerekli_kisi(calls, aht, slot, shrinkage=None, target_asa=TARGET_ASA):
    """Bir slot için Erlang-C ihtiyacı (shrinkage uygulanmış)."""
    if calls <= 0:
        return 0
    traffic = (calls * (aht / 60)) / INTERVAL_MIN
    if traffic == 0:
        return 0
    ham = math.ceil(traffic * 3) + 10
    for a in range(math.ceil(traffic), ham + 1):
        if _asa(a, traffic, aht) <= target_asa:
            ham = a
            break
    shr_cfg = shrinkage if shrinkage is not None else KITLE_SHRINKAGE
    shr = shr_cfg.get(int(slot[:2]), shr_cfg.get('default', 0.0))
    return math.ceil(ham / (1 - shr))


def _erlang_serisi(calls_serisi, slot_serisi, aht):
    cache = {}
    out = []
    for c, s in zip(calls_serisi, slot_serisi):
        key = (int(c), s)
        if key not in cache:
            cache[key] = gerekli_kisi(int(c), aht, s)
        out.append(cache[key])
    return out


def kalibre_aht(results, queue='kitle', adaylar=range(90, 331, 10), verbose=True):
    """Pickle'daki Erlang'ı en iyi yeniden üreten AHT'yi bulur.

    Sadece pickle'ı kullanır: model, kendi forecast çağrılarından
    (calls_by_slot) bir Erlang (erlang_by_slot) üretti. Hangi AHT o Erlang'ı
    geri veriyorsa, gerçek çağrılar için de o AHT geçerlidir.

    df_aht'yi PL/SQL'den çekiyorsan buna gerek yok — aht_saatlik() kullan.
    """
    kayit = []
    for date_str, day in results.items():
        r = (day or {}).get(queue)
        if not r:
            continue
        erl = r.get('erlang_by_slot') or {}
        calls = r.get('calls_by_slot') or {}
        for slot, e in erl.items():
            c = calls.get(slot, 0)
            if e > 0 and c > 0:
                kayit.append({'interval': slot, 'calls': c, 'erlang_pkl': e})
    if not kayit:
        raise ValueError(f"results içinde {queue} için erlang_by_slot + "
                         f"calls_by_slot eşleşmesi yok.")

    df = pd.DataFrame(kayit)
    en_iyi, en_iyi_hata = None, None
    for aht in adaylar:
        tahmin = _erlang_serisi(df['calls'], df['interval'], aht)
        hata = (pd.Series(tahmin) - df['erlang_pkl'].values).abs().mean()
        if en_iyi_hata is None or hata < en_iyi_hata:
            en_iyi, en_iyi_hata = aht, hata

    if verbose:
        print(f"AHT kalibrasyonu: {en_iyi} sn  "
              f"(pickle Erlang'ından ortalama sapma {en_iyi_hata:.1f} kişi, "
              f"{len(df):,} slot üzerinden)")
        if en_iyi_hata > 3:
            print("  ⚠ sapma yüksek — alt-kuyruk ağırlıklı AHT tek değere "
                  "sığmıyor olabilir; hakem sonuçlarını temkinli yorumla.")
    return en_iyi


def hakem_tablosu(df_kitle, df_act30, aht, esik=2, verbose=True):
    """Gerçek çağrı ihtiyacına kim daha yakın: plan mı model mi?

    df_kitle : compare_kitle çıktısı (model_toplam / plan_toplam)
    df_act30 : actual_calls_30 çıktısı (actual_kitle)
    esik     : |plan_sapma - model_sapma| bu değerin altındaysa BERABERE
    """
    df = df_kitle.merge(df_act30[['data_date', 'interval', 'actual_kitle']],
                        on=['data_date', 'interval'], how='inner')
    if df.empty:
        raise ValueError("df_kitle ile actual kesişmedi — tarih aralıklarını kontrol et.")

    df['ihtiyac'] = _erlang_serisi(df['actual_kitle'], df['interval'], aht)
    df['model_sapma'] = df['model_toplam'] - df['ihtiyac']
    df['plan_sapma'] = df['plan_toplam'] - df['ihtiyac']

    fark = df['plan_sapma'].abs() - df['model_sapma'].abs()
    df['kazanan'] = 'BERABERE'
    df.loc[fark < -esik, 'kazanan'] = 'BEN'
    df.loc[fark > esik, 'kazanan'] = 'MODEL'
    df.loc[df['ihtiyac'] == 0, 'kazanan'] = '—'        # çağrı yok, kıyas anlamsız

    df = df[['data_date', 'interval', 'actual_kitle', 'ihtiyac',
             'model_toplam', 'model_sapma', 'plan_toplam', 'plan_sapma',
             'kazanan']]
    if verbose:
        skor_ozeti(df, esik)
    return df


def skor_ozeti(df_hakem, esik=2):
    """Tek bakışta: kim kaç slotta daha iyi."""
    kiyaslanan = df_hakem[df_hakem['kazanan'] != '—']
    n = len(kiyaslanan)
    if not n:
        print("Kıyaslanacak slot yok.")
        return None

    sayim = kiyaslanan['kazanan'].value_counts()
    ben, model = int(sayim.get('BEN', 0)), int(sayim.get('MODEL', 0))
    berabere = int(sayim.get('BERABERE', 0))

    print(f"SKOR ({n:,} slot, berabere eşiği ±{esik} kişi)")
    print(f"  BEN      {ben:>6,}  (%{ben/n*100:.0f})")
    print(f"  MODEL    {model:>6,}  (%{model/n*100:.0f})")
    print(f"  BERABERE {berabere:>6,}  (%{berabere/n*100:.0f})")
    kazanan = 'BEN' if ben > model else ('MODEL' if model > ben else 'BERABERE')
    print(f"  → genel: {kazanan}")

    ozet = pd.DataFrame([{
        'kim': etiket,
        'ort_mutlak_sapma': round(kiyaslanan[kol].abs().mean(), 1),
        'ort_sapma': round(kiyaslanan[kol].mean(), 1),
        'fazla_slot': int((kiyaslanan[kol] > 0).sum()),
        'eksik_slot': int((kiyaslanan[kol] < 0).sum()),
    } for etiket, kol in (('BEN (plan)', 'plan_sapma'),
                          ('MODEL', 'model_sapma'))])
    show(ozet)
    return ozet


def hakem_gunluk(df_hakem):
    """Gün bazında kazanan."""
    d = df_hakem[df_hakem['kazanan'] != '—'].copy()
    g = d.groupby('data_date').agg(
        ihtiyac=('ihtiyac', 'sum'),
        model=('model_toplam', 'sum'),
        plan=('plan_toplam', 'sum'),
        model_mutlak_sapma=('model_sapma', lambda s: s.abs().sum()),
        plan_mutlak_sapma=('plan_sapma', lambda s: s.abs().sum()),
    ).reset_index()
    g['kazanan'] = g.apply(
        lambda r: 'BEN' if r['plan_mutlak_sapma'] < r['model_mutlak_sapma']
        else ('MODEL' if r['model_mutlak_sapma'] < r['plan_mutlak_sapma']
              else 'BERABERE'), axis=1)
    g['gun'] = pd.to_datetime(g['data_date']).dt.weekday.map(
        lambda i: ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'][i])
    return g[['data_date', 'gun', 'ihtiyac', 'model', 'plan',
              'model_mutlak_sapma', 'plan_mutlak_sapma', 'kazanan']]


def hakem_saat(df_hakem):
    """Saat bazında kazanan — hangi saatlerde sen daha iyisin."""
    d = df_hakem[df_hakem['kazanan'] != '—'].copy()
    g = d.groupby('interval').agg(
        ihtiyac=('ihtiyac', 'mean'),
        model=('model_toplam', 'mean'),
        plan=('plan_toplam', 'mean'),
        model_mutlak_sapma=('model_sapma', lambda s: s.abs().mean()),
        plan_mutlak_sapma=('plan_sapma', lambda s: s.abs().mean()),
    ).round(1).reset_index()
    g['kazanan'] = g.apply(
        lambda r: 'BEN' if r['plan_mutlak_sapma'] < r['model_mutlak_sapma']
        else ('MODEL' if r['model_mutlak_sapma'] < r['plan_mutlak_sapma']
              else 'BERABERE'), axis=1)
    return g



# --- ACTUAL ÇAĞRILAR → 30 DK ----------------------------------------------

import datetime as _dt

DEFAULT_ACTUAL_COLS = {
    'date':     ['data_date', 'date', 'tarih'],
    'time':     ['min_time_period_value', 'interval', 'saat_dilimi'],
    'kitle':    ['kitle_nof_call', 'kitle_nof_col', 'kitle_total_call'],
    'kurumsal': ['kurumsal_nof_call', 'kurumsal_nof_col'],
    'gold':     ['gold_nof_call', 'gold_nof_col', 'gold_total_call'],
}


def _to_slot_30(value):
    """'10:45' / '10:45:00' / time / timedelta / timestamp → '10:30'."""
    if isinstance(value, (pd.Timedelta, _dt.timedelta)):
        tm = int(pd.Timedelta(value).total_seconds() // 60) % (24 * 60)
        h, m = divmod(tm, 60)
        return f"{h:02d}:{(m // 30) * 30:02d}"
    if isinstance(value, (_dt.datetime, pd.Timestamp, _dt.time)):
        return f"{value.hour:02d}:{(value.minute // 30) * 30:02d}"
    m = re.search(r'(\d{1,2}):(\d{2})', str(value).strip())
    if not m:
        raise ValueError(f"Saat değeri çözümlenemedi: {value!r}")
    return f"{int(m.group(1)) % 24:02d}:{(int(m.group(2)) // 30) * 30:02d}"


def actual_calls_30(df_actual, year=2026, month=8, queue='kitle',
                    actual_cols=None, verbose=True):
    """Gerçekleşen 15dk çağrıları 30dk'ya toplar.

    Girdi: data_date, min_time_period_value, {queue}_nof_call
    Çıktı: data_date, interval, actual_{queue}
    """
    cols = {**DEFAULT_ACTUAL_COLS, **(actual_cols or {})}
    d_col = _resolve_col(df_actual, cols['date'])
    t_col = _resolve_col(df_actual, cols['time'])
    c_col = _resolve_col(df_actual, cols[queue])
    eksik = [k for k, v in (('date', d_col), ('time', t_col), (queue, c_col))
             if v is None]
    if eksik:
        raise KeyError(f"ACTUAL: şu alan(lar) için kolon yok: {eksik}  |  "
                       f"mevcut: {list(df_actual.columns)}")

    out = pd.DataFrame({
        'data_date': _to_date_series(df_actual[d_col]).dt.normalize(),
        'interval': df_actual[t_col].map(_to_slot_30),
        f"actual_{queue}": pd.to_numeric(df_actual[c_col], errors='coerce').fillna(0),
    })

    bad = out['data_date'].isna() | out['interval'].isna()
    if bad.any():
        print(f"  ⚠ ACTUAL: {int(bad.sum()):,} satırda tarih/saat çözümlenemedi, "
              f"toplamdan düşüyor.")

    out = out.groupby(['data_date', 'interval'], as_index=False).sum()
    n0 = len(out)
    out = out[(out['data_date'].dt.year == year) & (out['data_date'].dt.month == month)]
    if verbose:
        print(f"ACTUAL ({queue}) — {out['data_date'].nunique()} gün, "
              f"{len(out):,} slot, toplam {int(out[f'actual_{queue}'].sum()):,} çağrı"
              + (f"  ({n0 - len(out):,} satır ay dışı, elendi)" if n0 > len(out) else ""))
    return out.sort_values(['data_date', 'interval']).reset_index(drop=True)


# --- AHT: monthly run formatındaki df_aht'den saatlik AHT ------------------

def aht_saatlik(df_aht, queue='kitle', df_sq_calls=None, verbose=True):
    """df_aht (saat, sub_queue, line_based_main_group, weighted_avg_aht)
    → {saat: aht} sözlüğü.

    df_sq_calls verilirse (saat × sub_queue çağrı adedi) alt-kuyruklar çağrı
    payıyla ağırlıklanır — modelin calculate_weighted_aht'i ile aynı mantık.
    Verilmezse alt-kuyrukların basit ortalaması alınır.
    """
    gerekli = ['saat', 'sub_queue', 'line_based_main_group', 'weighted_avg_aht']
    eksik = [c for c in gerekli if c not in df_aht.columns]
    if eksik:
        raise KeyError(f"df_aht'de eksik kolon: {eksik}  |  "
                       f"mevcut: {list(df_aht.columns)}")

    grup = f"{queue}_cagrilar"
    d = df_aht[df_aht['line_based_main_group'] == grup].copy()
    if d.empty:
        raise ValueError(f"df_aht'de '{grup}' yok. "
                         f"Mevcut: {sorted(df_aht['line_based_main_group'].unique())}")
    d['saat'] = d['saat'].astype(int)
    d['weighted_avg_aht'] = pd.to_numeric(d['weighted_avg_aht'], errors='coerce')

    if df_sq_calls is not None:
        w = df_sq_calls.rename(columns={c: c.lower() for c in df_sq_calls.columns})
        w['saat'] = w['saat'].astype(int)
        d = d.merge(w[['saat', 'sub_queue', 'calls']], on=['saat', 'sub_queue'],
                    how='left')
        d['calls'] = d['calls'].fillna(0)
        toplam = d.groupby('saat')['calls'].transform('sum')
        d['agirlik'] = (d['calls'] / toplam).where(toplam > 0, 1 / d.groupby('saat')['sub_queue'].transform('count'))
        saatlik = (d.assign(x=d['weighted_avg_aht'] * d['agirlik'])
                     .groupby('saat')['x'].sum().round().astype(int).to_dict())
        yontem = 'çağrı ağırlıklı'
    else:
        saatlik = d.groupby('saat')['weighted_avg_aht'].mean().round().astype(int).to_dict()
        yontem = 'alt-kuyruk basit ortalaması'

    if verbose:
        print(f"AHT ({queue}, {yontem}): "
              f"{min(saatlik.values())}–{max(saatlik.values())} sn, "
              f"{len(saatlik)} saat")
        if df_sq_calls is None:
            print("  ℹ alt-kuyruk çağrı kırılımı verilirse ağırlıklı AHT "
                  "hesaplanır (modelin yöntemi).")
    return saatlik


def _aht_of(aht, slot):
    """aht tek sayı ya da {saat: aht} olabilir."""
    if isinstance(aht, dict):
        h = int(slot[:2])
        return aht.get(h, aht.get('default', 150))
    return aht


