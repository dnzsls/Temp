          "takim_kod": takim_kod_map.get(_T, ""),     # eşleşme bu kodla yapıldı
          "uye": len(takimlar[_T]), "olcu": _olcu_ad}
    _var = _g_or is not None and _T in _g_or.index and _g_or.at[_T, "top"] > 0
    _r["gecmis_olcu_top"] = round(float(_g_or.at[_T, "top"]), 1) if _var else 0
    for _k in ("aksam", "gece"):
        _o = float(_g_or.at[_T, f"{_k}_oran"]) if _var else None
        _r[f"gecmis_{_k}_%"] = None if _o is None else round(100 * _o, 1)
        _r[f"ort_{_k}_%"] = round(100 * _ort_ad[_k], 1)
        _r[f"fark_{_k}_puan"] = (None if _o is None
                                 else round(100 * (_o - _ort_ad[_k]), 1))
        _r[f"ceza_{_k}"] = gecmis_katsayi.get((_T, _k), 0)
        _bo = (float(_b_or.at[_T, f"{_k}_oran"])
               if _T in _b_or.index and _b_or.at[_T, "top"] > 0 else None)
        _r[f"bu_ay_{_k}_%"] = None if _bo is None else round(100 * _bo, 1)
    _r["durum"] = ("✓" if _var else
                   ("— df_gecmis yok" if df_gecmis is None
                    else "⚠ geçmişte eşleşmedi (takım anahtarı tutmadı)"))
    _ad_satir.append(_r)
df_takim_adalet = (pd.DataFrame(_ad_satir)
                   .sort_values(["ceza_gece", "ceza_aksam"], ascending=False)
                   .reset_index(drop=True))

# SAĞLAMA: sayfadaki fark'tan yeniden hesaplanan ceza = H19B'nin modele verdiği
