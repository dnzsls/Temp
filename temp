# %% [HÜCRE 7] — İZİN GÜNLERİNİ BİRLEŞTİR ───────────────────────────────
# Her agent için tek izin kümesi: özel-off + tekrarlı(Pzt/Cuma) + tam-ay(idari/doğum)

# 1) df_izin (ÖNCELİKLİ) + df_off → agent başına tarih→tip haritası (tip_map).
#    tip: "izin" (kotadan düşer) | "off_t"/"off_t2" (blok ama kota DÜŞMEZ).
#    Çakışan tarihte df_izin kazanır: df_izin'i ÖNCE yazıyoruz, df_off'u setdefault
#    ile ekliyoruz → df_izin'de olan tarihi df_off EZEMEZ.
tip_map = {}                                            # code -> {tarih: tip}
_BILINEN_TIP = {"izin", "off_t", "off_t2"}              # tanınan tipler; boş/diğer → YOK SAY (normal çalışma)
if df_izin is not None:                                 # df_izin ÖNCE → öncelikli
    for _, row in df_izin.iterrows():
        code = str(row["agent_user_code"]).strip()
        if row["izin_tipi"] not in _BILINEN_TIP:        # boş/tanınmayan tip → yok say
            continue
        tip_map.setdefault(code, {})[row["tarih"]] = row["izin_tipi"]
if df_off is not None:
    _off_tipli = "izin_tipi" in df_off.columns
    _off_bos = 0                                        # boş/tanınmayan izin_tipi satır sayısı
    for _, row in df_off.iterrows():
        code = str(row["agent_user_code"]).strip()
        tipi = row["izin_tipi"] if _off_tipli else "izin"   # tip kolonu yoksa izin varsay
        if tipi not in _BILINEN_TIP:                    # boş/tanınmayan tip → YOK SAY (normal çalışma)
            _off_bos += 1
            continue
        for c in gun_cols:                              # gun_cols H3'te tanımlandı
            if int(row[c]) == 1:
                try:
                    d = dt.date(AY_YIL, AY_AY, int(c.split("_")[1]))
                except ValueError:
                    continue                            # ayda olmayan gün (gun_31 vs.)
                tip_map.setdefault(code, {}).setdefault(d, tipi)   # df_izin varsa DOKUNMA
    if _off_bos:
        print(f"df_off: {_off_bos} satır boş/tanınmayan izin_tipi → YOK SAYILDI (normal çalışma)")

# 2) tekrarlı hafta içi izin: flag → hafta günü (0=Pzt .. 4=Cuma)
#    Yeni gün eklemek için tek yer burası (tek format).
HAFTAICI_IZIN_FLG = {
    "pazartesi_izinli_flg": 0,
    "sali_izinli_flg":      1,
    "carsamba_izinli_flg":  2,
    "persembe_izinli_flg":  3,
    "cuma_izinli_flg":      4,
}
gunluk_izin = {wd: {d for d in GUN_SET if d.weekday() == wd}
               for wd in set(HAFTAICI_IZIN_FLG.values())}   # hafta günü → o ayın tüm o günleri


def _b(row, col):
    """flag (float/str) → bool"""
    return pd.to_numeric(row.get(col, 0), errors="coerce") == 1


# süt izni ↔ resmi tatil emilimi: bir ISO haftada HAFTA İÇİ resmi tatil varsa,
# o hafta süt izni "tatile sayılır" → süt agent o hafta süt iznini KULLANMAZ
# (normal gününde çalışır), tatil günü zaten off. Sadece süt izni için geçerli;
# hafta sonu tatil emilmez (zaten AYLIK_IS_GUNU'yu da etkilemez).
_TATIL = set(dt.date.fromisoformat(t) for t in RESMI_TATILLER)   # H16 ile aynı liste
tatil_haftalari = {d.isocalendar()[:2] for d in _TATIL if d.weekday() < 5}

# 3) agent başına birleştir → izin_map (kotadan düşer) + off_block_map (blok, kota DÜŞMEZ)
izin_map = {}
off_block_map = {}                                     # off_t2 → SERT blok (değişken açılmaz)
off_soft_map = {}                                      # off_t  → YUMUŞAK talep (değişken açılır, cezalı)
off_tip_map = {}                                       # code -> {tarih: off_t/off_t2} (roster etiketi)
for _, row in df_tam.iterrows():
    code = str(row["agent_user_code"]).strip()
    izin = set()
    off_block = set()
    off_soft = set()
    off_tip = {}
    for d, tipi in tip_map.get(code, {}).items():      # df_izin+df_off tarihlerini tipe ayır
        if tipi == "izin":
            izin.add(d)
        elif tipi == "off_t2":                         # SERT: her zaman karşılanır → blok
            off_block.add(d)
            off_tip[d] = tipi
        else:                                          # off_t → YUMUŞAK talep, blok DEĞİL
            off_soft.add(d)                            #   karşılanmazsa H20B(3) cezası
            off_tip[d] = tipi
    if _b(row, "idari_izinli_flg") or _b(row, "dogum_izni_flg"):
        izin |= GUN_SET                                # tüm ay
    sut = _b(row, "sut_izni_flg")                      # süt izni → tatil haftası emilimi
    for flg, wd in HAFTAICI_IZIN_FLG.items():          # tekrarlı hafta içi izin günleri
        if _b(row, flg):
            gunler = gunluk_izin[wd]
            if sut:                                    # süt: tatil haftasındaki izni EMME
                gunler = {d for d in gunler
                          if d.isocalendar()[:2] not in tatil_haftalari}
            izin |= gunler
    # hamile/süt HAFTA SONU çalışamaz (H14) → hafta sonu telafisi YOK:
    #  • HAFTA İÇİ off_t/off_t2 → İZİN'e çevrilir (kullanıcı kararı 2026-09-28).
    #    Gerekçe: bu agentlarda off_t2 bloklu ama kotayı düşürmüyordu; telafi
    #    edecek hafta sonu da olmadığı için kota dolmuyor ve model INFEASIBLE
    #    oluyordu. İzin hem bloklar hem kotayı düşürür → çelişki kalmaz.
    #    ESKİ DAVRANIŞ (2026-09-18 → 2026-09-28): talep YOK SAYILIYOR, o gün
    #    normal çalışma günü oluyordu; "gün gerçekten off olacaksa veriye izin
    #    gir" kuralı vardı. Artık veri düzeltmesine gerek yok.
    #  • HAFTA SONU off_t/off_t2/izin → anlamsız (zaten off, H14) → kaldırılır.
    if sut or _b(row, "hamile_flg"):
        izin |= {d for d in (off_block | off_soft) if d.weekday() < 5}
        off_block = set()                                # talep izne çevrildi → blok listesi boş
        off_soft = set()
        off_tip = {}
        izin = {d for d in izin if d.weekday() < 5}      # hafta sonu izinleri at → "off"
    izin_map[code] = izin
    off_block_map[code] = off_block
    off_soft_map[code] = off_soft
    off_tip_map[code] = off_tip

df_tam["izin_gun_sayisi"] = df_tam["agent_user_code"].map(
    lambda c: len(izin_map.get(str(c).strip(), set())))

tam_ay = sum(1 for v in izin_map.values() if v >= GUN_SET)
print(f"izin girişi olan agent: {sum(1 for v in izin_map.values() if v)}  |  "
      f"off_t2 (SERT blok) olan agent: {sum(1 for v in off_block_map.values() if v)}  |  "
      f"off_t (YUMUŞAK talep) olan agent: {sum(1 for v in off_soft_map.values() if v)} "
      f"({sum(len(v) for v in off_soft_map.values())} kişi-gün)")
print(f"tüm-ay izinli (idari/doğum): {tam_ay}")
print("en çok izinli 10 agent:")
print(df_tam[["agent_user_code", "izin_gun_sayisi"]]
      .sort_values("izin_gun_sayisi", ascending=False).head(10).to_string(index=False))


# %% [HÜCRE 7B] — OFF_T ÖNCELİĞİ: KİŞİYE GÖRE W_OFF_T (df_off_gecmis) ───
# SORUN: off_t (yumuşak off talebi) cezası HERKESTE AYNI (W_OFF_T=20). İki agent
# aynı güne off_t istediğinde ve kova sadece birine izin verebiliyorsa, model
# ikisini de 20'ye mal olan EŞİT seçenek görüyor → hangisini çalıştıracağı
# rastgele. Oysa geçmişte AZ izin isteyenin öne geçmesi gerekiyor.
#
# ÇÖZÜM: cezayı kişiye özel yap. Ceza, o gün agentı ÇALIŞTIRMANIN fiyatı:
#   yüksek ağırlık → çalıştırmak pahalı → izni ÖNCE onaylanır
#   düşük ağırlık  → çalıştırmak ucuz  → izni EN SON onaylanır
# Yeni değişken/kısıt YOK; H20B(3)'teki mevcut terimin KATSAYISI değişiyor.
#
# ÖLÇÜ: oran = geçmiş izin TALEBİ (gün) ÷ kıdem (ay)
#   Neden kıdeme bölünüyor: 24 aylık agentın 6 günü ile 6 aylık agentın 6 günü
#   aynı şey değil. Kullanıcı kararı (2026-09-18).
#   KIDEM TABANI (KIDEM_TABAN_AY): çok yeni agentta bölen küçülüp oran şişiyor
#   (1 ay kıdem + 2 gün talep → 2.0 → "çok isteyen" görünür). Bölen en az
#   KIDEM_TABAN_AY alınır → yeni başlayan haksız yere sona atılmaz.
#   Bu yüzden oran df_off_gecmis'teki hazır off_kidem_ratio'dan DEĞİL, talep ve
#   kıdemden YENİDEN hesaplanır; hazır sütun sadece yedek (talep/kıdem yoksa).
#
# EŞLEME — YÜZDELİK SIRA (kullanıcı seçimi: "A ile başla"):
#   agentlar orana göre sıralanır; en az isteyen W_OFF_T_MAX, en çok isteyen
#   W_OFF_T_MIN alır, arası doğrusal. Oranın MUTLAK büyüklüğü değil SIRASI
#   önemli → veri kümüle olup oranlar büyüdükçe eşik elle güncellenmez,
#   dağılım kendini ayarlar. Eşit oranlı agentlar AYNI ağırlığı alır → model
#   aralarında serbesttir (kullanıcı: "eşit cezada rastgele seçsin").
#
# BANT NEDEN 12–24 (kalibrasyon — bozmadan önce oku):
#   • ÜST uç < W_EKSIK_HI/HS (25) olmalı: aksi hâlde off_t vermek coverage
#     eksiğinden pahalı olur ve model kovayı boşaltıp izin verir.
#   • ALT uç, hafta içi off cezasının (W_HI_OFF+surplus = 4..14) ALTINA
#     inebilir — BİLİNÇLİ: en çok isteyen agentın off_t'si sıkı günde (ceza 14)
#     verilmez, bol günde (ceza 4) yine verilir. "En sona koy" bu demek.
#   • Bant daraltmak (ör. 16–22) ayrımı zayıflatır, genişletmek yukarıdaki iki
#     sınırı bozar.
#
# ÜÇ AYRI "BOŞ" DURUMU — ilk koşuda (2026-09-18) karıştırılmıştı, düzeltildi:
#   (a) TALEP KAYDI YOK, kıdem biliniyor → agent geçmişte HİÇ izin İSTEMEMİŞ.
#       Bu "bilinmiyor" DEĞİL, veri: talep = 0 → oran 0 → EN YÜKSEK öncelik.
#       ÖLÇÜLDÜ: 465 agentın 324'ü df_off_gecmis'te YOK (tablo yalnız talep
#       edenleri tutuyor). İlk sürüm bunları "bilinmeyen" sayıp EN DÜŞÜK
#       önceliğe atıyordu → ağırlık dağılımı {12: 328} çıktı, yani hiç izin
#       istemeyenler en sona düştü ve kural TERSİNE çalıştı.
#   (b) TALEP VAR, kıdem yok → df_kidem'den doldurulur (H14B verisi hazır).
#   (c) İKİSİ DE YOK → gerçekten veri yok → W_OFF_T_MIN (en düşük öncelik,
#       kullanıcı kararı).
# EŞİTLİK: oranı aynı olan agentlar (özellikle 0 olanlar) rank(method="min")
# ile AYNI ve EN İYİ sırayı alır → hepsi W_OFF_T_MAX. "average" olsaydı 324
# kişi orta sıraya düşer ve bandın üst ucu hiç kullanılmazdı.
# AYARLAR H0'da: OFF_T_ONCELIK, W_OFF_T_MAX, W_OFF_T_MIN, KIDEM_TABAN_AY

w_offt = {}                # agent → kişiye özel W_OFF_T (yoksa sabit W_OFF_T)
# H29 Excel roster kolonlarına AÇILAN ölçüler (kural değil, GÖSTERİM):
# "off_t'si verilemeyen kişi gerçekten çok mu istiyor?" sorusu tabloda cevaplansın.
# GEÇMİŞTEN türeyen her şeye `gecmis_` öneki (kullanıcı kuralı, 2026-09-18).
off_gecmis_talep = {}      # agent → GEÇMİŞ izin talebi (ham gün, df_off_gecmis)
off_gecmis_oran  = {}      # agent → talep ÷ max(kıdem ay, KIDEM_TABAN_AY)
if not (OFF_T_ONCELIK and df_off_gecmis is not None):
    print("off_t önceliği: KAPALI ("
          + ("OFF_T_ONCELIK=False" if not OFF_T_ONCELIK else "df_off_gecmis yok")
          + f") → tüm agentlar sabit W_OFF_T={W_OFF_T} ile")
else:
    from collections import Counter as _Counter7b

    _7b_kod = df_tam["agent_user_code"].astype(str).str.strip().tolist()
    _7b_t = (df_off_gecmis.dropna(subset=["agent_user_code"])
             .drop_duplicates("agent_user_code").set_index("agent_user_code"))
    _7b_kidem_yedek = (dict(zip(df_kidem["agent_user_code"], df_kidem["kidem_ay"]))
                       if df_kidem is not None else {})

    def _7b_sayi(_a, _kol):
        """tabloda o agentın o kolonu → float ya da NaN (kolon yoksa da NaN)."""
        if _a not in _7b_t.index or _kol not in _7b_t.columns:
            return float("nan")
        return float(pd.to_numeric(_7b_t.at[_a, _kol], errors="coerce"))

    _oran, _7b_bilinmeyen = {}, []
    _7b_kaynak = _Counter7b()
    _7b_kidem_dolduruldu = []
    _7b_talep_yok = []                   # talep kaydı yok → 0 istemiş sayıldı
    _7b_sapma = []                       # (agent, hazır oran, yeniden hesap) — taban etkisi
    for _a7 in _7b_kod:
        _talep = _7b_sayi(_a7, "izin_talep_gun_sayisi")
        _kid = _7b_sayi(_a7, "kidem_ay")
        if pd.isna(_kid):                                    # tabloda yok → df_kidem
            _kv = _7b_kidem_yedek.get(_a7)
            if _kv is not None and pd.notna(_kv):
                _kid = float(_kv)
                _7b_kidem_dolduruldu.append(_a7)
        _hazir = _7b_sayi(_a7, "off_kidem_ratio")
        if pd.notna(_talep) and pd.notna(_kid):              # ASIL yol
            _oran[_a7] = _talep / max(_kid, KIDEM_TABAN_AY)
            off_gecmis_talep[_a7] = float(_talep)            # Excel kolonu
            _7b_kaynak["talep÷kıdem (taban uygulanmış)"] += 1
            if pd.notna(_hazir) and abs(_hazir - _oran[_a7]) > 0.01:
                _7b_sapma.append((_a7, _hazir, _oran[_a7]))
        elif pd.notna(_hazir):                               # YEDEK: hazır sütun
            _oran[_a7] = _hazir
            _7b_kaynak["hazır off_kidem_ratio (yedek)"] += 1
        elif pd.notna(_kid):                                 # TALEP KAYDI YOK, kıdem VAR
            _oran[_a7] = 0.0                                 #   → hiç istememiş = 0
            off_gecmis_talep[_a7] = 0.0                      # Excel kolonu (0 istemiş)
            _7b_talep_yok.append(_a7)
            _7b_kaynak["talep kaydı YOK → 0 istedi (en yüksek öncelik)"] += 1
        else:                                                # ikisi de yok → veri yok
            _7b_bilinmeyen.append(_a7)
            _7b_kaynak["BİLİNMEYEN (kıdem de yok) → en düşük öncelik"] += 1

    # ── YÜZDELİK SIRA → AĞIRLIK ───────────────────────────────────────
    # rank(method="min"): eşit oranlar AYNI ve EN İYİ sırayı alır → aralarında
    # model kayıtsız kalır (kullanıcı: "eşit cezada rastgele seçsin").
    # "average" DEĞİL: oranı 0 olan (hiç izin istemeyen) kalabalık grup orta
    # sıraya düşüyor ve bandın üst ucu (W_OFF_T_MAX) hiç kullanılmıyordu.
    if _oran:
        _s7 = pd.Series(_oran)
        _r7 = _s7.rank(method="min")                         # 1 = en AZ isteyen
        _n7 = len(_s7)
        for _a7, _rr in _r7.items():
            _p = 0.0 if _n7 <= 1 else (float(_rr) - 1) / (_n7 - 1)   # 0..1
            w_offt[_a7] = int(round(W_OFF_T_MAX
                                    - (W_OFF_T_MAX - W_OFF_T_MIN) * _p))
    for _a7 in _7b_bilinmeyen:
        w_offt[_a7] = W_OFF_T_MIN
    off_gecmis_oran.update(_oran)                            # H29 Excel kolonu

    # ── RAPOR ─────────────────────────────────────────────────────────
    _7b_W = 100
    print("=" * _7b_W)
    print(f"H7B — OFF_T ÖNCELİĞİ  (kişiye özel W_OFF_T; bant {W_OFF_T_MIN}–"
          f"{W_OFF_T_MAX}, sabit değer {W_OFF_T} yerine)")
    print("=" * _7b_W)
    print(f"  ölçü: geçmiş izin TALEBİ (gün) ÷ max(kıdem ay, {KIDEM_TABAN_AY})  "
          f"→ yüzdelik sıra → ağırlık")
    print(f"  yüksek ağırlık = çalıştırmak pahalı = izni ÖNCE onaylanır")
    print(f"  oran kaynağı: {dict(_7b_kaynak)}")
    if _7b_kidem_dolduruldu:
        print(f"    • {len(_7b_kidem_dolduruldu)} agentın kıdemi df_off_gecmis'te "
              f"boştu, df_kidem'den dolduruldu")
    if _7b_talep_yok:
        print(f"    • {len(_7b_talep_yok)} agentın TALEP KAYDI YOK → 'hiç izin "
              f"istememiş' sayıldı (oran 0 → en yüksek öncelik "
              f"{W_OFF_T_MAX}). df_off_gecmis yalnız talep EDENLERİ tutuyorsa "
              f"bu normaldir.")
    if _7b_bilinmeyen:
        print(f"    ⚠ {len(_7b_bilinmeyen)} agentta oran HESAPLANAMADI → "
              f"W_OFF_T={W_OFF_T_MIN} (en düşük öncelik): "
              f"{_7b_bilinmeyen[:10]}{' ...' if len(_7b_bilinmeyen) > 10 else ''}")
        print(f"      kalıcı çözüm: bu agentların kıdemini/talebini veriye gir.")
    if _7b_sapma:
        print(f"    • {len(_7b_sapma)} agentta hazır off_kidem_ratio ile yeniden "
              f"hesap FARKLI (kıdem tabanı {KIDEM_TABAN_AY} ay devrede) — en büyük 3:")
        for _a7, _h, _y in sorted(_7b_sapma, key=lambda r: -(r[1] - r[2]))[:3]:
            print(f"        {_a7}: tabloda {_h:.2f} → kullanılan {_y:.2f} "
                  f"(yeni başlayan cezası kaldırıldı)")
    _7b_dag = _Counter7b(w_offt.values())
    print(f"  ağırlık dağılımı (ağırlık → agent): "
          f"{dict(sorted(_7b_dag.items(), reverse=True))}")
    if _oran:
        _sirali = sorted(_oran.items(), key=lambda kv: kv[1])
        print(f"  EN AZ isteyen 5 (izni önce onaylanır):")
        for _a7, _o7 in _sirali[:5]:
            print(f"     {_a7}: oran {_o7:.2f} → ağırlık {w_offt[_a7]}")
        print(f"  EN ÇOK isteyen 5 (izni en son):")
        for _a7, _o7 in _sirali[-5:][::-1]:
            print(f"     {_a7}: oran {_o7:.2f} → ağırlık {w_offt[_a7]}")
    # kalibrasyon sağlaması — bant komşu ağırlıklarla çelişmesin
    if W_OFF_T_MAX >= W_EKSIK_HI:
        print(f"  ⚠ W_OFF_T_MAX({W_OFF_T_MAX}) ≥ W_EKSIK_HI({W_EKSIK_HI}) → off_t "
              f"vermek coverage eksiğinden pahalı; model kovayı boşaltıp izin verir.")
    else:
        print(f"  ✓ üst uç {W_OFF_T_MAX} < eksik cezası {W_EKSIK_HI} → coverage "
              f"her zaman önce gelir")
    print(f"  NOT: alt uç {W_OFF_T_MIN}, hafta içi off cezasının üst ucunun "
          f"({W_HI_OFF + W_SURPLUS_OFF}) ALTINDA → en çok isteyenin off_t'si SIKI "
          f"günde verilmez, BOL günde verilir (bilinçli).")
    print(f"  NOT: aynı ağırlığa düşen agentlar arasında model SERBEST — eşitlikte "
          f"tercih yapmaz.")
    print("=" * _7b_W)


# %% [HÜCRE 8] — MODEL GİRDİLERİNİ HAZIRLA ─────────────────────────────
# df'leri CP-SAT'ın anlayacağı sade yapılara çevir (henüz model/kısıt yok).
AGENTS = [str(c).strip() for c in df_tam["agent_user_code"]]

# gün → o gün talebi olan vardiyalar  +  (gün, vardiya) → kaç kişi
# saat[(gün, vardiya)] = (baslangic, bitis)  → saat-bazlı kısıtlar için (sonra)
gun_vardiyalari = {}
talep = {}
saat = {}
for _, row in df_talep.iterrows():
