def _wrap_weekly_info_as_daily(info, df_calls_30, queue, date_str):
    """V9 weekly info_per_day[d] çıktısını gün-bazlı dict'e çevirir.
    Forecast modunda 'actual' alanı yok — None yerine boş struct.
    """
    d = pd.to_datetime(date_str)
    calls_col = f"{queue}_total"
    df_day = df_calls_30[df_calls_30['data_date'] == d]
    calls_by_slot = (dict(zip(df_day['slot_30'], df_day[calls_col]))
                     if calls_col in df_day.columns else {})
    return {
        'mip_info': info,
        'erlang_by_slot': info.get('erlang_by_slot', {}),
        'calls_by_slot': calls_by_slot,
        'actual': None,                      # forecast: gerçek yok
        'date': d,
        'queue': queue,
    }


def _short_stage_note(solution_stage, total_shortfall_week=0):
    """solution_stage string'ini kısa nota çevirir."""
    if not solution_stage:
        return '?'
    s = solution_stage
    if s.startswith('STAGE 1'):
        return 'orijinal'
    if s.startswith('STAGE 2'):
        try:
            payload = s.split(': ', 1)[1]
        except IndexError:
            payload = s
        return f"shrinkage {payload}"
    if s.startswith('STAGE 3'):
        return f"shortfall {total_shortfall_week} kişi-slot"
    return s


def _run_weekend_silent(df_forecast, df_shifts_dict, date_str, config):
    """Haftasonu forecast pipeline'ı stdout'u yutarak çağır."""
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        r = run_all_queues_forecast(df_forecast, df_shifts_dict,
                                     date_str, config=config)
    return r


def _derive_outsource_kadro(results, weekday_blocks, config, queues, verbose=True):
    """V10 — HAFTALIK ADAM-GÜN'den günlük outsource kadrosunu TÜRETİR.

    NEDEN: eskiden operasyon `total_kadro[queue]['outsource']` altına doğrudan
    GÜNLÜK KİŞİ giriyordu. O sayı planlamanın elindeki hazır rakamdan geliyordu;
    ileriye dönük tahminde böyle bir rakam YOK. Elde olan şey vendor'un o hafta
    çalıştırabileceği ADAM-GÜN. Bu fonksiyon onu günlük kişiye çevirir:

        kadro/gün = (haftalık adam-gün − o haftanın hafta sonu outsource'u)
                    ÷ o haftanın hafta içi gün sayısı

    Hafta sonu ÖNCE düşülür çünkü hafta sonu outsource ihtiyacı esnek değil
    (kitle'de `outsource_ratio` 0.60-0.65 ile zaten çivili) — artan kapasite
    hafta içine dağıtılır.

    GİRDİ (config['surplus_distribution']):
        'outsource_adam_gun': {'kitle': {'hafta_1': 1613, 'hafta_2': 1978, ...}}
        'outsource_adam_gun_pt_dahil': False

    ÖN KOŞUL: `results` içinde o ayın HAFTA SONU günleri ÇÖZÜLMÜŞ olmalı →
    bu yüzden run_month_forecast'ta hafta sonu bloğu hafta içinden ÖNCE koşar.

    Hafta anahtarı `_week_of_month` ile üretilir (pipeline'daki bölümlemenin
    BİREBİR aynısı, import edilerek) — ay sınırına saygılı, Pzt başlangıçlı.
    2026 Eylül'de: hafta_1=1-6(4 h.içi), hafta_2=7-13(5), hafta_3=14-20(5),
    hafta_4=21-27(5), hafta_5=28-30(3).

    BÖLEN = len(block), yani o haftanın PLANLANAN hafta içi gün sayısı.
    RESMİ TATİL: hafta içine düşen resmi tatil NORMAL İŞ GÜNÜ sayılır (bölene
    dahil) — operasyonla teyit edildi (2026-09-01): outsource o gün de çalışıyor,
    ayrı bir ele alma gerekmiyor. Ör. 29 Ekim'de bölen 5 kalır.

    Returns: {queue: {'hafta_N': kadro, ...}} — boşsa {} (config yoksa no-op).
    """
    sd = config.get('surplus_distribution', {})
    adam_gun_cfg = sd.get('outsource_adam_gun', {})
    if not adam_gun_cfg:
        return {}
    pt_dahil = sd.get('outsource_adam_gun_pt_dahil', False)

    # hafta_N → o haftanın hafta sonu tarihleri (results'tan, çözülmüş olanlar)
    hs_by_week = {}
    for ds in results:
        d = pd.to_datetime(ds).date()
        if d.weekday() >= 5:
            hs_by_week.setdefault(_week_of_month(ds), []).append(ds)

    turetilen, satirlar, uyarilar = {}, [], []

    for queue in queues:
        q_cfg = adam_gun_cfg.get(queue)
        if not q_cfg:
            continue                      # kurumsal/gold: outsource agent yok → giriş de yok
        per_week = {}
        for block in weekday_blocks:
            wk = _week_of_month(block[0].strftime('%Y-%m-%d'))
            key = f"hafta_{wk}"
            gun = len(block)
            adam_gun = q_cfg.get(key)
            if adam_gun is None:
                uyarilar.append(f"{queue}/{key}: adam-gün GİRİLMEMİŞ → kadro türetilmedi")
                continue

            hs_out = hs_pt = 0
            hs_detay = []
            for ds in sorted(hs_by_week.get(wk, [])):
                r = results.get(ds)
                qr = (r or {}).get(queue)
                if not qr:
                    uyarilar.append(f"{queue}/{key}: {ds} hafta sonu sonucu YOK → 0 sayıldı")
                    continue
                mi = qr.get('mip_info', {}) or {}
                o = int(mi.get('total_outsource_kisi', 0) or 0)
                p = int(mi.get('total_part_time_kisi', 0) or 0)
                hs_out += o
                hs_pt += p
                hs_detay.append(str(o))

            dusulen = hs_out + (hs_pt if pt_dahil else 0)
            kalan = int(adam_gun) - dusulen
            if kalan < 0:
                uyarilar.append(f"{queue}/{key}: hafta sonu ({dusulen}) adam-günü ({adam_gun}) AŞIYOR → kadro 0")
            # YUVARLAMA: en yakına (floor DEĞİL). Operasyonun Eylül tablosuyla
            # birebir uyum için: 1498/5=299.6→300, 1623/5=324.6→325, 950/3=316.7→317.
            # Yukarı yuvarlama bütçeyi birkaç adam-gün aşabilir (300×5=1500 > 1498);
            # bilinçli — "kapasiteyi bir tık fazla tut" tercihiyle aynı yönde.
            # Sıkı bütçe isteniyorsa: max(0, kalan // gun)
            kadro = max(0, int(round(kalan / gun))) if gun else 0
            per_week[key] = kadro
            satirlar.append((queue, key, int(adam_gun), hs_out, hs_pt,
                             "+".join(hs_detay) or "—", kalan, gun, kadro))
        if per_week:
            turetilen[queue] = per_week

    if verbose and satirlar:
        print("\n" + "=" * 92)
        print("▶ OUTSOURCE KADRO TÜRETİMİ (V10) — haftalık adam-gün → günlük kişi")
        print("=" * 92)
        print(f"  {'kuyruk':<9}{'hafta':<9}{'adam-gün':>9}{'h.sonu':>8}  {'(Cts+Paz)':<11}"
              f"{'kalan':>7}{'h.içi':>6}{'kadro/gün':>11}")
        print("  " + "-" * 88)
        for q, key, ag, ho, hp, det, kal, gun, kad in satirlar:
            print(f"  {q:<9}{key:<9}{ag:>9}{ho:>8}  {'(' + det + ')':<11}"
                  f"{kal:>7}{gun:>6}{kad:>11}")
        print("  " + "-" * 88)
        print(f"  formül: kadro/gün = (adam-gün − hafta sonu outsource) ÷ hafta içi gün sayısı")
        print(f"  part-time bütçeden düşülüyor mu: {'EVET' if pt_dahil else 'HAYIR'} "
              f"(outsource_adam_gun_pt_dahil)")
        print(f"  NOT: resmi tatil = normal iş günü (bölene dahil) — operasyon kararı.")
        for u in dict.fromkeys(uyarilar):
            print(f"  ⚠ {u}")
        print("=" * 92)
    elif verbose and adam_gun_cfg:
        print("\n⚠ OUTSOURCE KADRO TÜRETİMİ: hiçbir hafta hesaplanamadı "
              "(adam-gün girişi ya da hafta sonu sonucu yok)")

    return turetilen


def run_month_forecast(year, month, df_forecast, df_shifts_dict,
                       cfg_weekday, cfg_weekend,
                       queues=('kitle', 'kurumsal', 'gold'),
                       verbose=False):
    """Bir ayın tüm günlerini FORECAST verisi üzerinden koşar.

    Haftaiçi: V9 weekly (Stage 4 dahil), forecast 30dk'lik formata pre-convert edilir.
    Haftasonu: weekend_forecast_v10.run_all_queues_forecast.

    V10 — KOŞU SIRASI DEĞİŞTİ: HAFTA SONU ÖNCE, hafta içi SONRA.
    Sebep: hafta içi outsource kadrosu artık hafta sonunun çıktısından türetiliyor
    (`_derive_outsource_kadro`). Bağımlılık tek yönlü — hafta sonu modeli sadece
    df_forecast + tarih alıyor, hafta içi sonucuna hiç bakmıyor, dolayısıyla takas
    güvenli. `outsource_adam_gun` config'i yoksa türetme no-op olur ve davranış
    V9 ile aynı kalır (sadece sıra değişmiş olur, sonuç değişmez).

    Returns: {date_str: {queue: {mip_info, ...}} | None}
    df_actual KULLANILMAZ.
    """
    results = {}
    cal = calendar.Calendar()
    all_days = [d for d in cal.itermonthdates(year, month) if d.month == month]

    # Haftaiçi blokları (ardışık Pzt-Cum)
    weekday_blocks = []
    current = []
    for d in all_days:
        if d.weekday() < 5:
            current.append(d)
        else:
            if current:
                weekday_blocks.append(current)
                current = []
    if current:
        weekday_blocks.append(current)

    # FORECAST → 30 dk internal format (BİR KEZ — tüm haftalara yetecek)
    # run_week_all_queues bunu df_calls_30_pre olarak alacak, tekrar
    # convert etmeyecek (hız avantajı).
    df_calls_30 = prepare_forecast_calls_30(df_forecast, config=cfg_weekday)

    # ---- 1) HAFTASONU GÜNLERİ (V10: hafta içinden ÖNCE) ----
    weekend_days = [d for d in all_days if d.weekday() >= 5]
    if weekend_days:
        print(f"\n▶ Haftasonu günleri: {len(weekend_days)} gün")
    for d in weekend_days:
        date_str = d.strftime('%Y-%m-%d')
        day_name = DAY_LABELS_TR[d.weekday()]
        try:
            if verbose:
                r = run_all_queues_forecast(df_forecast, df_shifts_dict,
                                             date_str, config=cfg_weekend)
            else:
                r = _run_weekend_silent(df_forecast, df_shifts_dict,
                                         date_str, cfg_weekend)
            results[date_str] = r
            if r:
                parts = []
                for queue in queues:
                    if queue in r and r[queue] is not None:
                        parts.append(f"{queue}: OK")
                    else:
                        parts.append(f"{queue}: INFEASIBLE")
                print(f"  ✓ {date_str} ({day_name}) — " + "  |  ".join(parts))
            else:
                print(f"  ✗ {date_str} ({day_name}) — boş sonuç")
        except Exception as e:
            print(f"  ✗ {date_str} ({day_name}) — weekend hatası: {e}")
            results[date_str] = None

    # ---- 2) OUTSOURCE KADROSUNU TÜRET + cfg_weekday'e ENJEKTE ET (V10) ----
    # Pipeline dosyasına DOKUNULMUYOR: türetilen sayı, pipeline'ın zaten okuduğu
    # `total_kadro[queue]['outsource']` anahtarına yazılıyor. cfg_weekday'in
    # KOPYASI değiştiriliyor → çağıranın config'i bozulmaz.
    kadro_turetilen = _derive_outsource_kadro(
        results, weekday_blocks, cfg_weekday, queues, verbose=True)
    if kadro_turetilen:
        cfg_weekday = copy.deepcopy(cfg_weekday)
        _tk = cfg_weekday.setdefault('surplus_distribution', {}).setdefault('total_kadro', {})
        for _q, _per_week in kadro_turetilen.items():
            _q_cfg = _tk.setdefault(_q, {})
            _eski = _q_cfg.get('outsource')
            # MEVCUT girişi KORU, türetilen haftaları ÜZERİNE yaz — doğrudan ATAMA DEĞİL.
            # Sebep: türetilen sözlükte yalnızca hesaplanabilen hafta_N'ler var, 'default'
            # YOK. Düz atasaydık, adam-günü girilmemiş bir hafta _resolve_kadro'da
            # 'default'a düşer, onu da bulamayıp 0 dönerdi → o hafta outsource kadro
            # tavanı ve surplus doldurması SESSİZCE kapanırdı. Birleştirince elle
            # girilmiş 'default' (ve türetilemeyen haftalar) yedek olarak kalır.
            _q_cfg['outsource'] = ({**_eski, **_per_week} if isinstance(_eski, dict)
                                   else dict(_per_week))

    # ---- 3) HAFTAİÇİ BLOKLARI ----
    for block in weekday_blocks:
        block_dates = [d.strftime('%Y-%m-%d') for d in block]
        block_label = f"{block_dates[0]} → {block_dates[-1]} ({len(block)} gün)"
        print(f"\n▶ Haftaiçi blok: {block_label}")

        try:
            if verbose:
                week_results = run_week_all_queues(
                    df_forecast=df_forecast,
                    df_shifts_by_queue=df_shifts_dict,
                    target_dates=block_dates,
                    config=cfg_weekday,
                    queues=queues,
                    df_calls_30_pre=df_calls_30,    # pre-computed: tekrar convert etme
                    verbose=True,
                )
            else:
                buf = io.StringIO()
                with contextlib.redirect_stdout(buf):
                    week_results = run_week_all_queues(
                        df_forecast=df_forecast,
                        df_shifts_by_queue=df_shifts_dict,
                        target_dates=block_dates,
                        config=cfg_weekday,
                        queues=queues,
                        df_calls_30_pre=df_calls_30,
                        verbose=False,
                    )
        except Exception as e:
            print(f"  ✗ blok hatası: {e}")
            for d in block:
                results[d.strftime('%Y-%m-%d')] = None
            continue

        for d in block:
            date_str = d.strftime('%Y-%m-%d')
            day_label = DAY_LABELS_EN[d.weekday()]
            day_name = DAY_LABELS_TR[d.weekday()]

            day_result = {}
            parts = []
            for queue in queues:
                q_res = week_results.get(queue)
                if q_res is None:
                    parts.append(f"{queue}: INFEASIBLE")
                    continue
                info = q_res.get('info_per_day', {}).get(day_label)
                if info is None:
                    parts.append(f"{queue}: INFEASIBLE")
                    continue
                day_result[queue] = _wrap_weekly_info_as_daily(
                    info, df_calls_30, queue, date_str)
                note = _short_stage_note(
                    q_res.get('solution_stage'),
                    q_res.get('total_shortfall_week', 0),
                )
                parts.append(f"{queue}: OK [{note}]")

            if not day_result:
                results[date_str] = None
                print(f"  ✗ {date_str} ({day_name}) — tümü INFEASIBLE")
            else:
                results[date_str] = day_result
                has_sf = any(
                    week_results.get(q, {}).get('total_shortfall_week', 0) > 0
                    for q in day_result
                )
                mark = "⚠" if has_sf else "✓"
                print(f"  {mark} {date_str} ({day_name}) — " + "  |  ".join(parts))

    return results


