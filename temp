# ── Sheet5: TAKIM GEÇMİŞ ADALETİ — H19B'nin AYNI ölçüsü ────────────────
# H19B geçmişi vardiya vardiya DEĞİL, İKİ KUTU olarak görüyor:
#   GECE  : başlangıç ∈ GECE_TIPLERI
#   AKŞAM : başlangıç ≥ GEC_BASLANGIC (gece hariç)
# ve ORAN kullanıyor: takımın o kutudaki ölçüsü ÷ takımın TOPLAM ölçüsü. Pay ve
# payda AYNI pencereden geldiği için geçmişin kaç aylık olduğu (Ocak 2026 →)
# sorun DEĞİL. Ceza = round(W_GECMIS × max(0, oran − ortalama) × 100), TEK YÖNLÜ:
# ortalamanın altındaki takım 0 alır. Sabah/gündüz tiplerine dokunulmuyor.
# Bu sayfa o hesabın her adımını gösterir + bu ayın çizelgesini AYNI oran
# biçiminde yanına koyar (kıyaslanabilir olsun).
def _kutu_oran(df, takim_kol="takim", vardiya_kol="saat", olcu_kol=None):
    """takım → akşam/gece/toplam ölçü + oran (H19B ile AYNI kutulama).

    olcu_kol None → her satır 1 sayılır (kişi-gün); verilirse o kolon toplanır.
    TOPLAM, kutuya girmeyen (sabah/gündüz) satırları da içerir — H19B'de de öyle.
    """
    def _kutu_guvenli(s):
        """Vardiya etiketi → kutu. Bozuk etiket (çözümlenemeyen saat) → None.
        _gecmis_kutu → dakika() iki nokta bekliyor ve HATA VERİYOR; veri
        tarafındaki tek bir bozuk satır bütün Excel çıktısını düşürmesin."""
        _p = _vardiya_parse(s)
        if not _p:
            return None
        try:
            return _gecmis_kutu(_p[0])
        except (ValueError, TypeError):
            return None

    d = df.copy()
    d["_kutu"] = d[vardiya_kol].map(_kutu_guvenli)
    d["_olcu"] = (1.0 if olcu_kol is None
                  else pd.to_numeric(d[olcu_kol], errors="coerce").fillna(0.0))
    out = pd.DataFrame({"top": d.groupby(takim_kol)["_olcu"].sum()})
    for _k in ("aksam", "gece"):
        out[_k] = d[d["_kutu"] == _k].groupby(takim_kol)["_olcu"].sum()
    out[["aksam", "gece"]] = out[["aksam", "gece"]].fillna(0.0)
    for _k in ("aksam", "gece"):
        out[f"{_k}_oran"] = out[_k] / out["top"].where(out["top"] > 0)
    return out


if df_gecmis is not None:
    _olcu_ad = ("gun_agent_ratio" if "gun_agent_ratio" in df_gecmis.columns
                else "total_gun_sayisi")
    _g_or = _kutu_oran(df_gecmis, vardiya_kol="shifts_adj", olcu_kol=_olcu_ad)
