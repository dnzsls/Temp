def _gorunum(a, c):
    """BU AY hücresi → (Excel metni, kategori). c = 'YYYY-MM-DD' kolon adı."""
    v = roster.at[a, c]
    d = dt.date.fromisoformat(c)
    if v == "izin":
        # doğum izni TÜM AYI kaplar (H7) → o agentın her hücresi böyle görünür
        return ("DOĞUM İZNİ", "dogum_izin") if a in _dogum_set else ("İZİN", "izin")
    if v == "off_t2":
        return "OFF_T2", "off_t2"
    if v == "off_t":
        return "OFF_T", "off_t"
    if v == "off":
        return "OFF", "off"
    _sa = v.replace("mesai ", "")                       # ham saat aralığı
    if d in TATIL:
        metin, kat = f"RESMİ TATİL MESAİ\n{_sa}", "resmi_tatil"
    elif d in ARIFE:
        metin, kat = ((f"ARİFE\n{_sa}", "arife") if a in arife_kisitli
                      else (f"ARİFE MESAİ\n{_sa}", "arife_mesai"))
    elif d.weekday() >= 5:
        if (a, c) in _norm_hucre:
            metin, kat = f"NORM\n{_sa}", "norm"
        elif (a, c) in _telafi_hucre:
            metin, kat = f"TELAFİ\n{_sa}", "telafi"
        else:
            metin, kat = f"MESAİ\n{_sa}", "mesai"
    else:
        metin, kat = _sa, "normal"                      # hafta içi normal → dolgusuz
    if (a, c) in prov_hucre:                            # H14D flexy: iki parça + ücret etiketi
        _etk = {"norm": "NORM", "telafi": "TELAFİ", "mesai": "MESAİ",
                "resmi_tatil": "RESMİ TATİL MESAİ", "arife_mesai": "ARİFE MESAİ"}
        metin = (f"PROVİZYON · {_etk.get(kat, '')}\n"
                 + " + ".join(f"{b}-{e}" for b, e in PROVIZYON["hs_parcalar"]))
        kat = "provizyon"
    if (a, c) in offt_karsilanmadi:                     # off_t istendi ama çalıştırıldı
        kat = "offt_kars"                               # etiket kalır, renk KIRMIZI olur
    return metin, kat

def _onceki_gorunum(a, d):
    """ÖNCEKİ AY hücresi (salt okunur) → (metin, kategori). d = date."""
    v = onceki_gunluk.get(a, {}).get(d)
    if v is None:
        return "", "onc_bos"
    if v == "izin":
        return "İZİN", "onc_izin"
    if v in _ONC_HIZIN:
        return "H.İZİN", "onc_hizin"
    if v == "off":
        return "OFF", "onc_off"
    if v in OFF_T_DEGERLERI:
        return v.upper(), "onc_off"
    return (v, "onc_calisma") if _vardiya_parse(v) else (str(v).upper(), "onc_bos")


