# =============================================================================
# FORECAST ↔ ACTUAL ÇAĞRI KARŞILAŞTIRMA (30 DK)
# =============================================================================
# Amaç: gerçekleşen çağrı adetleri ile forecast'i 30 dakikalık slotlarda,
# kuyruk bazında (kitle / kurumsal / gold) yan yana koymak.
#
# Çıktı kolonları:
#   data_date, interval,
#   forecast_kitle, actual_kitle,
#   forecast_kurumsal, actual_kurumsal,
#   forecast_gold, actual_gold
#
# ACTUAL girdi formatı (15 dk):
#   data_date, weekday_flg, min_time_period_value ('10:30', '00:00' …),
#   kitle_nof_call, kurumsal_nof_call, gold_nof_call
#
# FORECAST girdi formatı: monthly run'daki df_forecast ile aynı (15 dk, geniş).
# 30dk'ya çevirme monthly run'ın kullandığı prepare_forecast_calls_30 ile
# yapılır — böylece karşılaştırma modelin gerçekten gördüğü değerler üzerinden
# olur, ayrı bir toplama mantığı devreye girmez.
# =============================================================================

import pandas as pd

from forecast_weekly_weekday_pipeline_final import prepare_forecast_calls_30

SLOTS_30 = [f"{h:02d}:{m}" for h in range(24) for m in ('00', '30')]

QUEUES = ('kitle', 'kurumsal', 'gold')

# monthly run CONFIG_WEEKDAY['forecast_cols'] ile aynı varsayılan
DEFAULT_FORECAST_COLS = {
    'datetime':       'model_data_date',
    'date':           'truncddate',
    'kitle_total':    'kitle_nof_call',
    'kurumsal_total': 'kurumsal_nof_call',
    'gold_total':     'gold_total_call',
}

DEFAULT_ACTUAL_COLS = {
    'date':     'data_date',
    'time':     'min_time_period_value',
    'kitle':    'kitle_nof_call',
    'kurumsal': 'kurumsal_nof_call',
    'gold':     'gold_nof_call',
}


# =============================================================================
# ACTUAL → 30 DK
# =============================================================================

def _to_slot_30(value):
    """'10:45' / '10:45:00' / '2026-08-03 10:45' → '10:30'."""
    s = str(value).strip()
    if ' ' in s:                       # tam timestamp geldiyse saat kısmını al
        s = s.split(' ', 1)[1].strip()
    if 'T' in s:
        s = s.split('T', 1)[1].strip()
    parts = s.split(':')
    hour = int(parts[0])
    minute = int(parts[1]) if len(parts) > 1 else 0
    return f"{hour:02d}:{(minute // 30) * 30:02d}"


def prepare_actual_calls_30(df_actual, actual_cols=None):
    """15dk'lık gerçekleşen çağrıları 30dk'ya toplar.

    Returns: data_date, slot_30, actual_kitle, actual_kurumsal, actual_gold
    """
    acols = dict(DEFAULT_ACTUAL_COLS)
    if actual_cols:
        acols.update(actual_cols)

    df = df_actual.copy()
    df['data_date'] = pd.to_datetime(df[acols['date']], dayfirst=True).dt.normalize()
    df['slot_30'] = df[acols['time']].apply(_to_slot_30)

    agg = {}
    for q in QUEUES:
        col = acols[q]
        if col in df.columns:
            df[f"actual_{q}"] = pd.to_numeric(df[col], errors='coerce').fillna(0)
            agg[f"actual_{q}"] = 'sum'
        else:
            print(f"  ⚠ actual: '{col}' kolonu yok — actual_{q} = 0 kabul edildi.")

    if not agg:
        raise ValueError("Actual veride hiçbir kuyruk kolonu bulunamadı.")

    out = df.groupby(['data_date', 'slot_30'], as_index=False).agg(agg)
    for q in QUEUES:
        if f"actual_{q}" not in out.columns:
            out[f"actual_{q}"] = 0
    return out


# =============================================================================
# FORECAST → 30 DK
# =============================================================================

def prepare_forecast_30(df_forecast, forecast_cols=None, config=None):
    """Forecast'i monthly run ile birebir aynı şekilde 30dk'ya çevirir.

    config verilirse (örn. CONFIG_WEEKDAY) doğrudan o kullanılır — alt-kuyruk
    kolonları da dahil. Verilmezse forecast_cols'tan minimal config kurulur.

    Returns: data_date, slot_30, forecast_kitle, forecast_kurumsal, forecast_gold
    """
    if config is None:
        fcols = dict(DEFAULT_FORECAST_COLS)
        if forecast_cols:
            fcols.update(forecast_cols)
        config = {'forecast_cols': fcols, 'sub_queues': {}}

    df_30 = prepare_forecast_calls_30(df_forecast, config=config)

    out = df_30[['data_date', 'slot_30']].copy()
    for q in QUEUES:
        col = f"{q}_total"
        if col in df_30.columns:
            out[f"forecast_{q}"] = pd.to_numeric(df_30[col], errors='coerce').fillna(0)
        else:
            fname = config['forecast_cols'].get(f"{q}_total", '?')
            print(f"  ⚠ forecast: '{fname}' kolonu bulunamadı — "
                  f"forecast_{q} = 0 kabul edildi.")
            out[f"forecast_{q}"] = 0

    return out.groupby(['data_date', 'slot_30'], as_index=False).sum()


# =============================================================================
# KARŞILAŞTIRMA
# =============================================================================

def build_comparison(df_actual, df_forecast, year=2026, month=8,
                     forecast_cols=None, actual_cols=None, config=None,
                     interval_style='start', verbose=True):
    """Ayın tüm günleri × 48 slot için forecast/actual tablosu üretir.

    interval_style: 'start' → '10:30'   |   'range' → '10:30-11:00'
    Veride olmayan (gün, slot) kombinasyonları 0 ile doldurulur.
    """
    df_a = prepare_actual_calls_30(df_actual, actual_cols)
    df_f = prepare_forecast_30(df_forecast, forecast_cols, config)

    # Ayın tam ızgarası — eksik gün/slot gizlenmesin
    days = pd.date_range(f"{year}-{month:02d}-01", periods=1, freq='MS')
    all_days = pd.date_range(days[0], days[0] + pd.offsets.MonthEnd(1), freq='D')
    grid = pd.MultiIndex.from_product([all_days, SLOTS_30],
                                      names=['data_date', 'slot_30']).to_frame(index=False)

    df = (grid
          .merge(df_f, on=['data_date', 'slot_30'], how='left')
          .merge(df_a, on=['data_date', 'slot_30'], how='left'))

    value_cols = [f"{side}_{q}" for q in QUEUES for side in ('forecast', 'actual')]
    for c in value_cols:
        if c not in df.columns:
            df[c] = 0
    df[value_cols] = df[value_cols].fillna(0).round().astype(int)

    if interval_style == 'range':
        idx = df['slot_30'].map({s: i for i, s in enumerate(SLOTS_30)})
        end = idx.map(lambda i: SLOTS_30[(i + 1) % len(SLOTS_30)])
        df['interval'] = df['slot_30'] + '-' + end
    else:
        df['interval'] = df['slot_30']

    df = df[['data_date', 'interval',
             'forecast_kitle', 'actual_kitle',
             'forecast_kurumsal', 'actual_kurumsal',
             'forecast_gold', 'actual_gold']]
    df = df.sort_values(['data_date', 'interval']).reset_index(drop=True)

    if verbose:
        _print_coverage(df, df_a, df_f, all_days, year, month)

    return df


def _print_coverage(df, df_a, df_f, all_days, year, month):
    """Eksik gün / sıfır hacim uyarıları — sessiz veri kaybını yakalamak için."""
    print(f"\n{'='*70}")
    print(f"FORECAST ↔ ACTUAL KARŞILAŞTIRMA — {year}/{month:02d}")
    print(f"{'='*70}")
    print(f"  Satır: {len(df):,}  ({len(all_days)} gün × {len(SLOTS_30)} slot)")

    a_days = set(df_a['data_date'].unique())
    f_days = set(df_f['data_date'].unique())
    miss_a = sorted(d for d in all_days if d not in a_days)
    miss_f = sorted(d for d in all_days if d not in f_days)
    if miss_a:
        print(f"  ⚠ ACTUAL'da veri olmayan {len(miss_a)} gün: "
              f"{', '.join(d.strftime('%d.%m') for d in miss_a)}")
    if miss_f:
        print(f"  ⚠ FORECAST'ta veri olmayan {len(miss_f)} gün: "
              f"{', '.join(d.strftime('%d.%m') for d in miss_f)}")
    if not miss_a and not miss_f:
        print("  ✓ Her iki tarafta da ayın 31 günü mevcut.")

    print(f"\n  {'Kuyruk':<10} {'Forecast':>14} {'Actual':>14} {'Fark':>12} {'Sapma':>9}")
    print(f"  {'-'*10} {'-'*14} {'-'*14} {'-'*12} {'-'*9}")
    for q in QUEUES:
        f_sum = int(df[f"forecast_{q}"].sum())
        a_sum = int(df[f"actual_{q}"].sum())
        diff = f_sum - a_sum
        pct = (diff / a_sum * 100) if a_sum else 0.0
        print(f"  {q:<10} {f_sum:>14,} {a_sum:>14,} {diff:>+12,} {pct:>8.1f}%")
    print()


def save_comparison(df, path=None, year=2026, month=8):
    """Excel'e yazar."""
    path = path or f"forecast_vs_actual_{year}_{month:02d}.xlsx"
    out = df.copy()
    out['data_date'] = pd.to_datetime(out['data_date']).dt.strftime('%Y-%m-%d')
    out.to_excel(path, index=False)
    print(f"✓ Kaydedildi: {path}")
    return path


