    if TAKIM_ANAHTAR == "kod":
        print(f"⚠ TAKIM_ANAHTAR='kod' ama df_agents'te kod kolonu YOK "
              f"{TAKIM_KOD_ADAYLARI} → İSİM anahtarına düşüldü (eski davranış).")
    _t6_parca = _t6_isim                                       # anahtarın 2. parçası
else:
    _t6_k = df_tam[_t6_kod].astype(str).str.strip()
    _t6_k = _t6_k.where(~_t6_k.str.lower().isin(("", "nan", "none", "null")))
    # BOŞ KOD GRUPTAN DOLDURULUR: aynı gösterim adına (aynı wmg + aynı lider)
    # sahip bir üyenin kodu varsa o kod TÜM gruba yazılır. Satır satır isme
