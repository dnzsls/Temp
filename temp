def vardiya_genis_uzun(df, queue='kitle', verbose=True):
    """GENİŞ Excel → uzun şema: data_date · vardiya · working_main_group · kisi.

    {queue}_in_kisi_sayisi    → inhouse
    {queue}_out_kisi_sayisi   → outsource
    {queue}_kismi_kisi_sayisi → part_time   (opsiyonel)
    Tek kolonlu kuyruk ({queue}_kisi_sayisi) → hepsi inhouse.
    """
    d_col = _resolve_col(df, VARDIYA_KOL['date'])
    v_col = _resolve_col(df, VARDIYA_KOL['shift'])
    if d_col is None or v_col is None:
        raise KeyError(f"tarih/vardiya kolonu yok  |  mevcut: {list(df.columns)}")

    in_col = _resolve_col(df, [f"{queue}_in_kisi_sayisi", f"{queue}_inhouse_kisi_sayisi",
                               f"{queue}_in"])
    out_col = _resolve_col(df, [f"{queue}_out_kisi_sayisi", f"{queue}_outsource_kisi_sayisi",
                                f"{queue}_out"])
    pt_col = _resolve_col(df, [f"{queue}_kismi_kisi_sayisi", f"{queue}_pt_kisi_sayisi",
                               f"{queue}_part_time_kisi_sayisi", f"{queue}_kismi"])
    tek_col = _resolve_col(df, [f"{queue}_kisi_sayisi", f"{queue}_kisi"])

    hedef = []
    if in_col:
        hedef.append((in_col, f"{queue}_inhouse"))
    if out_col:
        hedef.append((out_col, f"{queue}_outsource"))
    if pt_col:
        hedef.append((pt_col, f"{queue}_part_time"))
    if not hedef and tek_col:
        hedef.append((tek_col, f"{queue}_inhouse"))
        if verbose:
            print(f"  ℹ '{queue}' in/out ayrımı yok — hepsi inhouse sayıldı.")
    if not hedef:
        raise KeyError(f"'{queue}' kişi kolonu yok  |  mevcut: {list(df.columns)}")

    tarih = _to_date_series(df[d_col]).dt.normalize()
    vard = df[v_col].astype(str)
    parca = [pd.DataFrame({'data_date': tarih, 'vardiya': vard,
                           'working_main_group': grup,
                           'kisi_sayisi': pd.to_numeric(df[kol], errors='coerce').fillna(0)})
             for kol, grup in hedef]
    out = pd.concat(parca, ignore_index=True)
    out = out[out['kisi_sayisi'] > 0]
    out = (out.groupby(['data_date', 'vardiya', 'working_main_group'],
                       as_index=False)['kisi_sayisi'].sum()
              .sort_values(['data_date', 'vardiya']).reset_index(drop=True))

    if verbose:
        print(f"PLAN ({queue}) — kolonlar: {', '.join(k for k, _ in hedef)}")
        print(f"  {len(out):,} satır  |  {out['data_date'].nunique()} gün  "
              f"({out.data_date.min():%d.%m.%Y} – {out.data_date.max():%d.%m.%Y})")
        if not pt_col:
            print("  ℹ kısmi kolonu yok — part_time 0 kalacak.")
    return out


def plan_tablosu(df_uzun, year, month, kismi_haftaici_haric=True,
                 outsource_ek_slot=OUTSOURCE_EK_SLOT, verbose=True):
    """Uzun vardiya tablosundan gün × slot kapasitesi + vardiya başlangıcı.

    - Geceyi aşan vardiyanın 00:00 sonrası kısmı ERTESİ güne yazılır.
      Ayın 1'inin gecesi için ÖNCEKİ AYIN SON GÜNÜ veride olmalı.
    - Outsource vardiyaları +30 dk uzun sayılır (yalnız KAPASİTE'ye).
    - kismi_haftaici_haric=True → kısmiler hafta içi sayılmaz, hafta sonu sayılır.
    """
    d = df_uzun.copy()
    d['data_date'] = _to_date_series(d['data_date']).dt.normalize()
    d['company'] = _company(d['working_main_group'])
    d['kisi'] = pd.to_numeric(d['kisi_sayisi'], errors='coerce').fillna(0)
    d['_v'] = d['vardiya'].astype(str)

    kismi_mi = d['company'].eq('part_time')
    if kismi_mi.any():
        if kismi_haftaici_haric:
            at = (d['data_date'].dt.weekday < 5) & kismi_mi
            if verbose:
                print(f"  ℹ kısmi: hafta içi {int(d.loc[at, 'kisi'].sum()):,} kişi "
                      f"çıkarıldı, hafta sonu korundu.")
            d = d[~at]
            kismi_mi = kismi_mi[~at]
        if verbose:
            print(f"  ℹ kısmi (hafta sonu) {int(d.loc[kismi_mi, 'kisi'].sum()):,} kişi.")
    elif verbose:
        print("  ℹ kısmi çalışan yok.")

    ay_bas = pd.Timestamp(year, month, 1)
    ay_son = ay_bas + pd.offsets.MonthEnd(1)
    onceki = ay_bas - pd.Timedelta(days=1)
    gunler = pd.date_range(ay_bas, ay_son, freq='D')

    uniq = d['_v'].unique()
    p_in = {v: shift_slots_ofset(v) for v in uniq}
    p_out = {v: (shift_slots_ofset(v, outsource_ek_slot) if p_in[v] else []) for v in uniq}
    bas_map = {v: shift_baslangic(v) for v in uniq}
    if verbose:
        cozulmeyen = [v for v, s in p_in.items() if not s]
        if cozulmeyen:
            print(f"  ⚠ okunamayan vardiya (atlandı): {cozulmeyen[:8]}")
        if not (d['data_date'] == onceki).any():
            print(f"  ⚠ {onceki:%d.%m.%Y} veride YOK → {ay_bas:%d.%m} gece "
                  f"slotları eksik kalacak.")

    out = pd.MultiIndex.from_product(
        [gunler, SLOTS_30], names=['data_date', 'interval']).to_frame(index=False)

    # KAPASİTE — önceki ayın son günü dahil (geceye sarkanlar için)
    kap_kaynak = d[(d['data_date'] >= onceki) & (d['data_date'] <= ay_son)]
    k = kap_kaynak.assign(_p=[(p_out if c == 'outsource' else p_in)[v]
                              for c, v in zip(kap_kaynak['company'], kap_kaynak['_v'])])
    k = k.explode('_p').dropna(subset=['_p'])
    k['interval'] = k['_p'].map(lambda t: t[1])
    k['data_date'] = k['data_date'] + pd.to_timedelta(k['_p'].map(lambda t: t[0]), unit='D')
    k = k[(k['data_date'] >= ay_bas) & (k['data_date'] <= ay_son)]
    k = k.groupby(['data_date', 'interval', 'company'], as_index=False)['kisi'].sum()

    # BAŞLANGIÇ — sadece ilk slot, kendi gününde
    d_ay = d[(d['data_date'] >= ay_bas) & (d['data_date'] <= ay_son)]
    b = d_ay.assign(interval=d_ay['_v'].map(bas_map)).dropna(subset=['interval'])
    b = b.groupby(['data_date', 'interval', 'company'], as_index=False)['kisi'].sum()

    for kaynak, onek in ((k, 'kapasite'), (b, 'baslangic')):
        for sirket, sonek in SIRKETLER:
            alt = kaynak[kaynak['company'] == sirket][['data_date', 'interval', 'kisi']]
            out = out.merge(alt.rename(columns={'kisi': f"{onek}_{sonek}"}),
                            on=['data_date', 'interval'], how='left')

    deger = [f"{o}_{s}" for o in ('kapasite', 'baslangic') for _, s in SIRKETLER]
    out[deger] = out[deger].fillna(0).round().astype(int)
    out['kapasite_toplam'] = out[[f"kapasite_{s}" for _, s in SIRKETLER]].sum(axis=1)
    out['baslangic_toplam'] = out[[f"baslangic_{s}" for _, s in SIRKETLER]].sum(axis=1)
    out = out.sort_values(['data_date', 'interval']).reset_index(drop=True)

    if verbose:
        print(f"PLAN — {d_ay['data_date'].nunique()}/{len(gunler)} gün  |  tepe kapasite: "
              f"in {int(out['kapasite_in'].max())} · out {int(out['kapasite_out'].max())} "
              f"· pt {int(out['kapasite_pt'].max())}")
    return _gun_tipi_ekle(out)


