# %% [HÜCRE 31B] — RR SAYFASI: İKİ YAKLAŞIM YAN YANA (Excel'e ek) ───────
# SORU: tahmini çağrının yüzde kaçını karşılayabiliyorum?
# İKİ CEVAP — aynı satırda yan yana, çünkü aynı slotta çelişebiliyorlar:
#
#   [İŞ BİRİMİ]  "yazdığım kadro bu çağrıyı kaç tane karşılar?"
#       nmt    = kişi − round(kişi×rapor_etkisi) − round(kişi×kapasite_kaybi)
#       ck     = nmt × (RR_CAGRI_SAAT/2)            # 15/saat → 7,5/slot
#       kap_rr = ck ÷ forecast çağrı
#     VARSAYIM: agent 30 dk boyunca HİÇ boş durmaz, çağrılar arka arkaya dizilir
#     → teorik tavan. kap_rr %100 = doluluk %100 (kuyruk payı YOK).
#     Zincir Model-1'in Kap_RR'ı ile BİREBİR (yuvarlama dahil) → sayılar çakışır.
#
#   [MODEL]      "bu çağrıyı 30 sn beklemeyle cevaplamak için kaç kişi gerekir?"
#       erlang_need = PICKLE'DAN (results[gün][QUEUE]['erlang_by_slot'])
#       rr2         = (kişi + outsource) ÷ erlang_need
#     VARSAYIM: çağrı düzensiz gelir, hedefi tutmak için boşta pay şart
#     → gerçekçi ihtiyaç. Yeniden hesap YOK, Model-1 ne dediyse o (H0).
#
# HANGİ SAYI İŞE YARAR: Model-1 kendi Erlang ihtiyacını MIP'te sert kısıt olarak
# zorluyor → rr2_model1 genelde ≥%100 çıkar, ayırt etmez. Asıl ölçü rr2_model2:
# isimli agent atarken izin/kota/takım kuralları yüzünden geride kalan kısım.
#
# KAYNAKLAR (yeni veri YOK):
#   forecast çağrı : results[gün][QUEUE]['calls_by_slot']
#   erlang_need    : results[gün][QUEUE]['erlang_by_slot']
#   model1_kisi    : mip_info['mip_in_by_slot']   (Model-1 INHOUSE kova planı)
#   outsource      : mip_info['mip_out_by_slot']  (kurumsalda 0)
#   part_time      : mip_info['mip_pt_by_slot']   (kurumsalda 0; kitlede hafta
#                    sonu 32 kişi) → outsource ile birlikte İKİ tarafa da aynen
#                    eklenir. Model-1 hem Erlang kısıtını hem Kap_RR'ı
#                    mip_by_slot = inhouse+outsource+PT TOPLAMI üzerinden kuruyor;
#                    aynı tabanı kullanmazsak sayılar Model-1 ile tutmaz.
#                    Model-2 bu iki grubu HİÇ planlamıyor (PT H5'te eleniyor) →
#                    ikisi de sabit, modelin değiştirdiği bir şey değil
#   model2_kisi    : H31 _at_slot (isimli atama; arife yarım + provizyon HARİÇ)
# Excel'e ÜÇ SAYFA eklenir, diğer sayfalara dokunulmaz:
#   rr_gun    : gün özeti (tarih × iki ölçü)
#   rr_slot   : slot detayı (30 dk, bantlı)
#   rr_mantik : hesap mantığı (sabit örnek)
# AYRI SAYFA ŞART (2026-10-05): tek sayfada dondurulan başlık gün özetinin
# başlığıydı → slot satırlarına inince kolonlar YANLIŞ başlık altında okunuyordu.
_rr_k = RR_CAGRI_SAAT / 2.0
_RR_BLOK = ("ORTAK", "İŞ BİRİMİ (15 çağrı/saat)", "MODEL (Erlang)")


def _rr_gun_tipi(_wd):
    """hafta günü (0=Pzt) → KAP_KAYBI tablosu anahtarı."""
    return "cumartesi" if _wd == 5 else "pazar" if _wd == 6 else "hafta_ici"


def _rr_nmt(_kisi, _gt, _slot):
    """İŞ BİRİMİ zinciri → (kk_oran, nmt). Model-1 ile aynı: TAM KİŞİ yuvarlama,
    toplam (inhouse+outsource) üzerinde BİR kez."""
    _h = int(_slot[:2])
    _kk = KAP_KAYBI[_gt]
    _kko = _kk.get(_h, _kk["default"])
    _reo = RAPOR_ETKISI.get(_h, RAPOR_ETKISI["default"])
    return _kko, _kisi - round(_kisi * _reo) - round(_kisi * _kko)


_rr_satir = []
_rr_erl_yok = 0                                    # erlang_need bulunamayan slot
for _ds in PLAN_GUNLER:
    _rq = (results.get(_ds) or {}).get(QUEUE) or {}
    _mi = _rq.get("mip_info", {}) or {}
    _calls = _rq.get("calls_by_slot") or _mi.get("calls_by_slot") or {}
    _m1in = _mi.get("mip_in_by_slot") or _mi.get("mip_by_slot") or {}
    _m1out = _mi.get("mip_out_by_slot") or {}
    _m1pt = _mi.get("mip_pt_by_slot") or {}
    _erl = _mi.get("erlang_by_slot") or _rq.get("erlang_by_slot") or {}
    _d = dt.date.fromisoformat(_ds)
    _gt = _rr_gun_tipi(_d.weekday())
    for _s in _SLOTS:
        _c = float(_calls.get(_s, 0) or 0)
        _k1 = float(_m1in.get(_s, 0) or 0)
        _k2 = float(_at_slot.get((_ds, _s), 0))
        _ko = float(_m1out.get(_s, 0) or 0)
        _kp = float(_m1pt.get(_s, 0) or 0)
        if _c <= 0 and _k1 <= 0 and _k2 <= 0:
            continue                               # boş slot → satır yok
        _sbt = _ko + _kp                           # Model-2'nin planlamadığı sabit kadro
        _t1, _t2 = _k1 + _sbt, _k2 + _sbt          # Model-1'in mip_by_slot'uyla aynı taban
        _kko, _n1 = _rr_nmt(_t1, _gt, _s)
        _,    _n2 = _rr_nmt(_t2, _gt, _s)
        _ck1, _ck2 = _n1 * _rr_k, _n2 * _rr_k
        _en = _erl.get(_s)                         # erlang_need — pickle'dan
        if _en is None and _c > 0:
            _rr_erl_yok += 1
        _en = float(_en) if _en is not None else None
        _rr_satir.append({
            # ── ORTAK
            "tarih": _ds, "gun": DAY_TR[_d.weekday()], "slot": _s,
            "forecast_cagri": round(_c, 1),
            "model1_kisi": int(_k1), "model2_kisi": int(_k2),
            "fark_kisi": int(_k2 - _k1),
            "outsource": int(_ko), "part_time": int(_kp),
            # ── İŞ BİRİMİ
            "kk_oran": _kko,
            "nmt_model1": int(_n1), "nmt_model2": int(_n2),
            "kap_rr_model1": round(_ck1 / _c, 3) if _c > 0 else None,
            "kap_rr_model2": round(_ck2 / _c, 3) if _c > 0 else None,
            # ── MODEL
            "erlang_need": (int(_en) if _en is not None else None),
            "rr2_model1": round(_t1 / _en, 3) if _en else None,
            "rr2_model2": round(_t2 / _en, 3) if _en else None,
            # (gün özeti için, sayfaya yazılmaz)
            "_ck1": _ck1, "_ck2": _ck2,
        })
_RR_KOL = ["tarih", "gun", "slot", "forecast_cagri",
           "model1_kisi", "model2_kisi", "fark_kisi", "outsource", "part_time",
           "kk_oran", "nmt_model1", "nmt_model2",
           "kap_rr_model1", "kap_rr_model2",
           "erlang_need", "rr2_model1", "rr2_model2"]
_RR_BLOK_SINIR = (9, 14)                           # ORTAK | İŞ BİRİMİ | MODEL kolon kesimi
df_rr_slot = (pd.DataFrame(_rr_satir) if _rr_satir
              else pd.DataFrame(columns=_RR_KOL + ["_ck1", "_ck2"]))

# ── GÜN ÖZETİ: iki ölçü birden, Model-1 ile AYNI toplama ─────────────
# İŞ BİRİMİ : kap_rr_day = Σck ÷ Σçağrı   (slot RR'larının ortalaması DEĞİL)
# MODEL     : rr2_day    = Σkişi ÷ Σerlang_need — YALNIZ erlang_need>0 slotlar
#             (Model-1 gibi: ihtiyacı 0 olan slottaki kişi payı şişirmesin)
# ⚠ İkisi de fazla slotun eksik slotu kapatmasına izin verir → gün sayısı iyimser.
#   Gizlenmeyen ölçü 'cevaplanabilen' kolonu: Σmin(ck, çağrı) ÷ Σçağrı.
_rr_gun = []
if len(df_rr_slot):
    for (_ds, _g), _t in df_rr_slot.groupby(["tarih", "gun"], sort=True):
        _e = _t["erlang_need"].sum(min_count=1)
        _te = _t[_t["erlang_need"].fillna(0) > 0]      # İHTİYAÇLI slotlar
        # TOPLAMA TABANI = _te (İKİ ÖLÇÜ İÇİN DE). Model-1 kap_rr_day'i de
        # `if erl <= 0: continue` bloğunun İÇİNDE topluyor → ihtiyacı 0 olan
        # slot her iki rapordan da düşüyor.
        # NEDEN ŞART (ölçüldü): çağrısı 0 olan slot (gece nöbeti) paydaya 0
        # ekler ama paya kişi×7,5 ekler → süzülmezse kap_rr ŞİŞER.
        #   09:00: 55 çağrı, 8 kişi → ck 52,5   |   02:00: 0 çağrı, 3 kişi → ck 22,5
        #   süzgeçsiz: 75,0 ÷ 55 = %136   ✗  (gece kapasitesi sabahın çağrısına yazıldı)
        #   süzgeçli : 52,5 ÷ 55 =  %95   ✓  (Model-1 Excel'i ile çakışır)
        # EMNİYET: erlang verisi HİÇ yoksa (_te boş) eski davranışa düşülür →
        # eski pickle'da kap_rr yine hesaplanır, sadece rr2 boş kalır.
        _kb = _te if len(_te) else _t
        _c = _kb["forecast_cagri"].sum()
        _s1, _s2 = _kb["_ck1"].sum(), _kb["_ck2"].sum()
        _cev = (_kb[["_ck2", "forecast_cagri"]].min(axis=1).sum() / _c) if _c else None
        _sbt_e = int(_te["outsource"].sum() + _te["part_time"].sum())
        _rr_gun.append({
            "tarih": _ds, "gun": _g, "forecast_cagri": round(_c),
            "model1_kisi_slot": int(_t["model1_kisi"].sum()),
            "model2_kisi_slot": int(_t["model2_kisi"].sum()),
            "outsource_slot": int(_t["outsource"].sum()),
            "part_time_slot": int(_t["part_time"].sum()),
            "kap_rr_model1": round(_s1 / _c, 3) if _c else None,
            "kap_rr_model2": round(_s2 / _c, 3) if _c else None,
            "cevaplanabilen_model2": round(_cev, 3) if _cev is not None else None,
            "erlang_need_slot": (int(_e) if pd.notna(_e) else None),
            "rr2_model1": (round((_te["model1_kisi"].sum() + _sbt_e) / _e, 3)
                           if pd.notna(_e) and _e else None),
            "rr2_model2": (round((_te["model2_kisi"].sum() + _sbt_e) / _e, 3)
                           if pd.notna(_e) and _e else None),
            "kap<1_slot_model2": int((_t["kap_rr_model2"] < 1).sum()),
            "rr2<1_slot_model2": int((_t["rr2_model2"] < 1).sum()),
        })
df_rr_gun = pd.DataFrame(_rr_gun)

