def model_coverage_from_results(results, year=2026, month=8, verbose=True):
    """Aylık run sonuçlarından (results dict) slot bazlı model kadrosunu çıkarır.

    results[tarih][kuyruk]['mip_info'] içinden okur:
        mip_in_by_slot  → inhouse kişi
        mip_out_by_slot → outsource kişi
    Vardiya açmaya gerek yok; pickle zaten slot bazında tutuyor. Bu sayede
    surplus dağıtımı sonrası NİHAİ sayılar gelir (assignments ile aynı kaynak).

    Çıktı: data_date, interval,
           model_in_{q}, model_out_{q}  (her kuyruk)
           model_in_toplam, model_out_toplam, model_toplam
    """
    rows = []
    bos_gunler, eksik_kuyruk = [], []
    for date_str, day in results.items():
        d = pd.to_datetime(date_str)
        if d.year != year or d.month != month:
            continue
        if not day:
            bos_gunler.append(d)
            continue
        for q in QUEUES:
            r = day.get(q)
            if not r:
                eksik_kuyruk.append((d, q))
                continue
            mi = r.get('mip_info', {}) or {}
            inn = mi.get('mip_in_by_slot', {}) or {}
            out = mi.get('mip_out_by_slot', {}) or {}
            if not inn and not out:                      # ayrım yoksa toplamı inhouse say
                inn = mi.get('mip_by_slot', {}) or {}
            for slot in set(inn) | set(out):
                rows.append({'data_date': d, 'slot_30': slot, 'queue': q,
                             'inhouse': inn.get(slot, 0), 'outsource': out.get(slot, 0)})

    if not rows:
        raise ValueError(f"results içinde {year}/{month:02d} için sonuç yok.")

    long = pd.DataFrame(rows)

    first = pd.Timestamp(year=year, month=month, day=1)
    all_days = pd.date_range(first, first + pd.offsets.MonthEnd(1), freq='D')
    out = pd.MultiIndex.from_product(
        [all_days, SLOTS_30], names=['data_date', 'slot_30']).to_frame(index=False)

    for q in QUEUES:
        sub = long[long['queue'] == q][['data_date', 'slot_30', 'inhouse', 'outsource']]
        sub = sub.rename(columns={'inhouse': f"model_in_{q}", 'outsource': f"model_out_{q}"})
        out = out.merge(sub, on=['data_date', 'slot_30'], how='left')

    value_cols = [f"model_{s}_{q}" for q in QUEUES for s in ('in', 'out')]
    out[value_cols] = out[value_cols].fillna(0).round().astype(int)

    out['model_in_toplam'] = out[[f"model_in_{q}" for q in QUEUES]].sum(axis=1)
    out['model_out_toplam'] = out[[f"model_out_{q}" for q in QUEUES]].sum(axis=1)
    out['model_toplam'] = out['model_in_toplam'] + out['model_out_toplam']

    out['interval'] = out['slot_30']
    out = out.sort_values(['data_date', 'slot_30']).reset_index(drop=True)
    out = out[['data_date', 'interval'] + value_cols +
              ['model_in_toplam', 'model_out_toplam', 'model_toplam']]

    if verbose:
        _print_pickle_summary(out, long, all_days, bos_gunler, eksik_kuyruk)
    return out


def _print_pickle_summary(out, long, all_days, bos_gunler, eksik_kuyruk):
    kapsanan = long['data_date'].nunique()
    print(f"MODEL (pickle) — {kapsanan}/{len(all_days)} gün")
    if bos_gunler:
        print(f"  ⚠ sonucu boş (None) {len(bos_gunler)} gün: "
              f"{', '.join(d.strftime('%d.%m') for d in bos_gunler)}")
    if eksik_kuyruk:
        ozet = {}
        for d, q in eksik_kuyruk:
            ozet.setdefault(q, []).append(d.strftime('%d.%m'))
        for q, gunler in ozet.items():
            print(f"  ⚠ {q}: {len(gunler)} günde sonuç yok (INFEASIBLE olabilir): "
                  f"{', '.join(gunler[:10])}{' …' if len(gunler) > 10 else ''}")

    satirlar = [{
        'kuyruk': q,
        'inhouse_tepe': int(out[f"model_in_{q}"].max()),
        'outsource_tepe': int(out[f"model_out_{q}"].max()),
        'inhouse_kisi_slot': int(out[f"model_in_{q}"].sum()),
        'outsource_kisi_slot': int(out[f"model_out_{q}"].sum()),
    } for q in QUEUES]
    show(pd.DataFrame(satirlar))


