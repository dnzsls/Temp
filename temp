# Sheet5: TAKIM × VARDİYA — vardiya başına TEK hücre: "geçmiş+bu ay"
# "Bu takım 00:00'ı bugüne kadar kaç GÜN yapmış?" sorusunun tek tabloda cevabı.
# Satır = takım, sütun = vardiya, HÜCRE = "geçmiş+bu ay"  (ör. "70+1" → 71 oldu).
#   geçmiş : df_gecmis.total_gun_sayisi (H19B'yi besleyen aynı veri) — GÜN
#   bu ay  : bu ayın çizelgesinde o vardiyanın yapıldığı FARKLI HAFTA İÇİ GÜN
#            (ARIFE_YARIM ve hafta sonu hariç) — aynı birim
# Bu ay atama YOKSA sadece geçmiş yazılır ("70"); ikisi de 0 ise hücre BOŞ bırakılır
# (tablo seyrek, boşluk okumayı kolaylaştırıyor). "x+y" olan hücreler YEŞİL.
# Sonda üç SAYISAL özet sütunu (sıralama/filtre için): GEÇMİŞ Σ | BU AY Σ | GENEL Σ.
#
# VARDİYA ADI NORMALİZE EDİLİYOR — yoksa aynı vardiya İKİ sütun oluyordu:
# df_gecmis geceyi "00:00-08:00" yazıyor, model "24:00-08:00" kullanıyor (H15'in
# gece-yarısı hesabı için). Saat 24 → 00'a çevrilip sıfır dolgulanıyor.
def _vardiya_norm(s):
    """'24:00-08:00' → '00:00-08:00';  ' 9:00-18:00 ' → '09:00-18:00'."""
    _p = str(s).strip().split("-")
    if len(_p) != 2:
        return str(s).strip()
    _o = []
    for _t in _p:
        try:
            _h, _m = _t.strip().split(":")
            _o.append(f"{int(_h) % 24:02d}:{int(_m):02d}")
        except ValueError:
            return str(s).strip()
    return "-".join(_o)


# BİRİM: GÜN — kişi-gün DEĞİL. df_gecmis.total_gun_sayisi gün sayıyor; "bu ay" da
# aynı birimde olmalı, yoksa "geçmiş+bu ay" elma ile armut toplar.
#   .size()                → satır sayısı = (agent, gün) ataması → KİŞİ-GÜN
#   ["tarih"].nunique()    → o takımın o vardiyayı yaptığı FARKLI GÜN sayısı ✓
# Ölçüldü: 12 kişilik takım 7 gün 09:00 çalışınca 84 yazıyordu ("0+82" gibi hücreler);
# TOPLAM satırında geçmiş 32'ye karşılık bu ay 1094 çıkıyordu — birim farkı.
# Tavan artık ayın HAFTA İÇİ gün sayısı (Ağustos'ta 21).
# HAFTA SONU HARİÇ: df_gecmis hafta içi düzeni yansıtıyor; hafta sonu atamaları
# takımın "hangi vardiyayı yapıyor" sorusuna girmiyor (takım tipi zaten hafta içi
# kuralı — H19). df_gecmis toplu geldiği için orada ayıklama YAPILAMAZ; hafta sonu
# içeriyorsa geçmiş tarafı bir miktar yüksek kalır.
_bu_ay_tv, _gec_tv = {}, {}
_tv_hi = df_sonuc[(df_sonuc["vardiya"] != ARIFE_YARIM)
                  & df_sonuc["tarih"].map(
                      lambda ds: dt.date.fromisoformat(ds).weekday() < 5)].copy()
_tv_hi["_v"] = _tv_hi["saat"].map(_vardiya_norm)   # önce normalize → sonra say
for (_T, _v), _n in _tv_hi.groupby(["takim", "_v"])["tarih"].nunique().items():
    _bu_ay_tv[(_T, _v)] = int(_n)
if df_gecmis is not None:
    for (_T, _st), _n in (df_gecmis.groupby(["takim", "shifts_adj"])
                          ["total_gun_sayisi"].sum().items()):
        _k = (_T, _vardiya_norm(_st))
        _gec_tv[_k] = _gec_tv.get(_k, 0) + int(_n)
_vardiya_kol = sorted({_v for _, _v in _bu_ay_tv} | {_v for _, _v in _gec_tv})

_tv_satir, _tv_yesil = [], set()                   # _tv_yesil: (satır no, vardiya)
for _i_t, _T in enumerate(sorted(takimlar)):
    _r = {"takim": _T, "uye": len(takimlar[_T])}
    _gt = _bt = 0
    for _v in _vardiya_kol:
        _g, _b = _gec_tv.get((_T, _v), 0), _bu_ay_tv.get((_T, _v), 0)
        _r[_v] = ("" if _g == 0 and _b == 0 else
                  (f"{_g}" if _b == 0 else f"{_g}+{_b}"))
        if _b:
            _tv_yesil.add((_i_t, _v))              # bu ay artmış → yeşil
        _gt += _g
        _bt += _b
    _r["GEÇMİŞ Σ"], _r["BU AY Σ"], _r["GENEL Σ"] = _gt, _bt, _gt + _bt
    _tv_satir.append(_r)
df_takim_vardiya = pd.DataFrame(_tv_satir)
if len(df_takim_vardiya):                          # en alta TOPLAM satırı
    _tr = {"takim": "— TOPLAM —", "uye": int(df_takim_vardiya["uye"].sum())}
