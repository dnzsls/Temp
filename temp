_gun = [c for c in roster.columns if c != "takim"]                 # tarih kolonları
_OFF_ONLY = ["off", "off_t", "off_t2"]                             # off türleri (model off + blok off_t/off_t2)
_OFF_LIKE = _OFF_ONLY + ["izin"]                                   # çalışma-dışı tüm hücreler (off + izin)
# NOT: eski hafta-bazlı kırılım (_hafta: wd/we/tat/wtatil) kaldırıldı — mesai/norm
# artık AY bazlı hesaplanıyor, ISO hafta ayrımına ihtiyaç kalmadı.

# AY BAZLI mesai/norm — ölçü H17'nin kotasıyla BİREBİR aynı:
#   mesai = max(0, (hafta içi + hafta sonu çalışma) − kota)     ← H17: çalışma ≤ kota+MAX_MESAI
#   norm  = min(hafta sonu çalışma, max(0, kota − hafta içi))   ← hafta içi off ↔ hafta sonu takası
#
# NEDEN DEĞİŞTİ — eskiden HAFTA bazlıydı: her ISO haftası kendi içinde kapanıyor,
# eşiğin ALTINDA kalan hafta fazla haftayı telafi etmiyordu (max(0,…) negatifi kesiyor).
# Sonuç: aynı agentta rapor mesai_gun=3 derken H17 net 1 mesai görüyordu → "MAX_MESAI=2
# iken 3 mesai yazmış, kural ihlal edilmiş" yanılgısı. Artık tek ölçü.
#   Ör. 3 hafta 6 gün (Cmt 8 / Pzr 16 / Cmt 22) + 1 hafta 4 gün + 31 Ağu off = 22 gün,
#       kota 21 → mesai 1 (3 değil), norm 2. Ayın sonundaki iki off, önceki haftaların
#       hafta sonu çalışmasının borcunu kapatıyor ("borç kapatma" ay içinde geçerli).
#
# ÖNCEKİ AYDAN TEK İSTİSNA — SINIR HAFTASI ALACAĞI (onceki_eksik, H8C):
# Sınır ISO haftasının hafta içi günleri önceki ayda, hafta sonu günleri BU ayda.
# O haftada hafta içi off almışsa (ör. 4 gün çalışma + 1 off), haftanın 5. günü
# bu ayın hafta sonuna düşer → MESAİ değil NORM. Alacak ancak o gün fiilen
# çalışıldıysa kullanılır ve sınır haftasının bu aya düşen gün sayısıyla tavanlı.
# Daha geriye BAKILMAZ (önceki ayın diğer haftaları hesaba girmez; veri de
# her zaman tüm ayı içermiyor). H17'nin tavanı da aynı alacağı taşır → tutarlı.
# Bunun dışında her ayın kendi kotası geçerlidir. (Taşımanın diğer kullanımları —
# H12 7 gün, H15 11 saat, H16C haftalık tavan, H20B off dengesi, H20E mesai
# eşiği — aynen duruyor.) Resmi tatilde çalışma ikisinin de dışında, ayrı sayaçta.
_norm_say  = {}                                    # agent → kaç hafta sonu günü NORM (H29 rengi okur)
_kredi_say = {}                                    # agent → sınır haftası alacağından FİİLEN kullanılan
_SINIR_HS = [c for c in _gun                       # sınır haftasının BU AYA düşen (tatil-dışı) günleri
             if dt.date.fromisoformat(c).isocalendar()[:2] == SINIR_HAFTA
             and dt.date.fromisoformat(c) not in TATIL]


def _mesai_norm_say(a):
    W = E = rtatil = 0                              # hafta içi / hafta sonu / resmi tatil çalışması
    for c in _gun:
        if roster.at[a, c] in _OFF_LIKE:
            continue                                # off / off_t / off_t2 / izin → çalışma değil
        d = dt.date.fromisoformat(c)
        if d in TATIL:
            rtatil += 1                             # resmi tatilde çalışma → mesaiden AYRI
        elif d.weekday() >= 5:
            E += 1
        else:
            W += 1
    kota = kota_map.get(a)                          # H17'nin GERÇEK kotası (yeniden hesaplanmaz)
    if kota is None:                                # H17 kısıt koymadı (kota=0 / değişkensiz agent)
        _norm_say[a] = _kredi_say[a] = 0
        return 0, 0, rtatil
    # SINIR HAFTASI ALACAĞI (H8C/H17 ile AYNI ifade): önceki ayın son haftasında
    # hafta içi off almışsa, bu ayın sınır hafta sonunda çalıştığı gün MESAİ değil
    # NORM. Alacak ancak o gün fiilen çalışıldıysa kullanılır → min(...).
    kredi = min(onceki_eksik.get(a, 0),
                sum(1 for c in _SINIR_HS if roster.at[a, c] not in _OFF_LIKE))
    mesai = max(0, (W + E) - kota - kredi)          # kotayı (+alacağı) aşan gün → MESAİ
    norm  = min(E, max(0, kota - W) + kredi)        # hafta içi eksiğini + alacağı kapatan hafta sonu → NORM
    _norm_say[a], _kredi_say[a] = norm, kredi
    return mesai, norm, rtatil


_cal_top = (~roster[_gun].isin(_OFF_LIKE)).sum(axis=1)             # toplam çalışma
_off     = (roster[_gun] == "off").sum(axis=1)                    # off_gun = SADECE modelin verdiği off
# off_t / off_t2 buraya GİRMEZ — onlar agentın TALEP ETTİĞİ off, modelin kararı değil;
# kendi kolonlarında (off_t_gun / off_t2_gun) duruyorlar. Eskiden üçü toplanıyordu ve
# "model bu kişiye kaç gün off vermiş" sorusu tablodan okunamıyordu.
# NOT: H23'ün df_ozet["off"] kolonu DEĞİŞMEDİ — orada calisma+off+izin = gün sayısı
# sağlaması var, off_t/off_t2 düşerse toplam tutmaz.
