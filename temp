def model2_coverage(df_model2, year=2026, month=8, cols=None, queue='kitle',
                    kolon='sahada', verbose=True):
    """Atama modeli (model 2) çıktısını slot bazlı inhouse coverage'a çevirir.

    Girdi biçimleri:
      0) PAKET (dict) : agent_cov_*.pkl — {'interval','agent_plan','gun','atama'}
                        → 'interval' tablosu doğrudan kullanılır (en hızlı yol)
      1) SLOT   : data_date, interval, kisi
      2) VARDİYA: data_date, vardiya, kisi          → shift_slots ile açılır
      3) AGENT  : data_date, vardiya, agent_user_code → slotta tekil agent sayılır

    kolon: paket girdisinde hangi sütun okunacak
      'sahada' → atanan + arife  (sahada fiilen telefonda olan kişi) — VARSAYILAN
      'atanan' → arife hariç     (Stage-1 coverage ile aynı ölçü)

    Çıktı: data_date, interval, model2_in
    """
    # ── 0) PAKET (dict) → interval tablosu ────────────────────────────
    if isinstance(df_model2, dict):
        _meta = df_model2.get('meta', {})
        if 'interval' not in df_model2:
            raise KeyError(f"MODEL2 paketinde 'interval' tablosu yok. "
                           f"Anahtarlar: {list(df_model2)}")
        d = df_model2['interval'].copy()
        _q = _meta.get('kuyruk', queue)
        _tercih = [f"{kolon}_{_q}", f"sahada_{_q}", f"atanan_{_q}",
                   'sahada', 'atanan', 'model2_in']
        _kol = next((k for k in _tercih if k in d.columns), None)
        if _kol is None:
            raise KeyError(f"MODEL2 interval tablosunda kişi kolonu yok. "
                           f"Mevcut: {list(d.columns)}")
        if 'plani_var' in d.columns:
            d = d[d['plani_var'] == 1]              # planı olmayan gün → coverage yok
        out = pd.DataFrame({
            'data_date': _to_date_series(d['data_date']).dt.normalize(),
            'interval': d['interval'].map(_to_slot_30),
            'model2_in': pd.to_numeric(d[_kol], errors='coerce').fillna(0),
        })
        out = out.groupby(['data_date', 'interval'], as_index=False).sum()
        out = out[(out['data_date'].dt.year == year) &
                  (out['data_date'].dt.month == month)]
        out['model2_in'] = out['model2_in'].round().astype(int)
        out = out.sort_values(['data_date', 'interval']).reset_index(drop=True)
        if verbose:
            print(f"MODEL2 (paket '{_kol}') — {out['data_date'].nunique()} gün, "
                  f"{len(out):,} slot, tepe {int(out['model2_in'].max())} kişi"
                  + (f"  |  kaynak durum: {_meta['durum']}" if 'durum' in _meta else ""))
            if _kol.startswith('atanan'):
                print("  ℹ arife yarım vardiyası HARİÇ (coverage ölçüsü). "
                      "Sahadaki kişi için kolon='sahada'.")
        return out

    c = {**DEFAULT_M2_COLS, **(cols or {})}
    d_col = _resolve_col(df_model2, c['date'])
    s_col = _resolve_col(df_model2, c['slot'])
    v_col = _resolve_col(df_model2, c['shift'])
    a_col = _resolve_col(df_model2, c['agent'])
    k_col = _resolve_col(df_model2, c['kisi'])

    if d_col is None:
        raise KeyError(f"MODEL2: tarih kolonu yok  |  mevcut: {list(df_model2.columns)}")

    df = df_model2.copy()

    # Arife yarım vardiyası (09:00-13:00 ek) coverage'a GİRMEZ → düş
    for _k in ('vardiya', 'shift'):
        if _k in df.columns:
            _m = df[_k].astype(str) == ARIFE_YARIM_KOD
            if _m.any():
                if verbose:
                    print(f"  ℹ MODEL2: {int(_m.sum()):,} arife yarım vardiya satırı "
                          f"elendi (coverage dışı).")
                df = df[~_m]
            break

    df['data_date'] = _to_date_series(df[d_col]).dt.normalize()
    n0 = len(df)
    df = df[(df['data_date'].dt.year == year) & (df['data_date'].dt.month == month)]
    if verbose and len(df) < n0:
        print(f"  ℹ MODEL2: {n0 - len(df):,} satır {year}/{month:02d} dışında, elendi.")

    if s_col is not None and k_col is not None:                 # 1) slot bazlı
        bicim = 'slot bazlı'
        df['interval'] = df[s_col].map(_to_slot_30)
        df['model2_in'] = pd.to_numeric(df[k_col], errors='coerce').fillna(0)
        out = df.groupby(['data_date', 'interval'], as_index=False)['model2_in'].sum()

    elif v_col is not None:                                     # 2/3) vardiya bazlı
        slot_map = {v: shift_slots(v) for v in df[v_col].astype(str).unique()}
        cozulmeyen = [v for v, s in slot_map.items() if not s]
        if cozulmeyen:
            print(f"  ⚠ MODEL2: vardiya olarak okunamayan {len(cozulmeyen)} değer "
                  f"(off/izin sayıldı): {cozulmeyen[:8]}")
        df['interval'] = df[v_col].astype(str).map(slot_map)
        df = df.explode('interval').dropna(subset=['interval'])

        if k_col is not None:                                   # 2) vardiya + kişi
            bicim = 'vardiya bazlı (kişi sayısı)'
            df['model2_in'] = pd.to_numeric(df[k_col], errors='coerce').fillna(0)
            out = df.groupby(['data_date', 'interval'], as_index=False)['model2_in'].sum()
        elif a_col is not None:                                 # 3) agent bazlı
            bicim = 'agent bazlı (tekil agent)'
            out = (df.groupby(['data_date', 'interval'])[a_col]
                     .nunique().rename('model2_in').reset_index())
        else:
            raise KeyError("MODEL2: vardiya var ama ne kişi sayısı ne agent kolonu "
                           f"bulundu  |  mevcut: {list(df_model2.columns)}")
    else:
        raise KeyError("MODEL2: slot/vardiya kolonu bulunamadı  |  "
                       f"mevcut: {list(df_model2.columns)}")

    out['model2_in'] = out['model2_in'].round().astype(int)
    out = out.sort_values(['data_date', 'interval']).reset_index(drop=True)

    if verbose:
        print(f"MODEL2 ({bicim}) — {out['data_date'].nunique()} gün, "
              f"{len(out):,} slot, tepe {int(out['model2_in'].max())} kişi")
    return out


