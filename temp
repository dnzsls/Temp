def _gorunum(a, c):
    """BU AY hücresi → (Excel metni, kategori). c = 'YYYY-MM-DD' kolon adı."""
    v = roster.at[a, c]
    d = dt.date.fromisoformat(c)
    if v == "izin":
        return "İZİN", "izin"
    if v == "off_t2":
        return "OFF_T2", "off_t2"
    if v == "off_t":
        return "OFF_T", "off_t"
    if v == "off":
        return "OFF", "off"
    _sa = v.replace("mesai ", "")                       # ham saat aralığı
    if d in TATIL:
        metin, kat = f"RESMİ TATİL MESAİ\n{_sa}", "resmi_tatil"
    elif d in ARIFE:
        metin, kat = ((f"ARİFE\n{_sa}", "arife") if a in arife_kisitli
                      else (f"ARİFE MESAİ\n{_sa}", "arife_mesai"))
    elif d.weekday() >= 5:
        if (a, c) in _norm_hucre:
            metin, kat = f"NORM\n{_sa}", "norm"
        elif (a, c) in _telafi_hucre:
            metin, kat = f"TELAFİ\n{_sa}", "telafi"
        else:
            metin, kat = f"MESAİ\n{_sa}", "mesai"
    else:
        metin, kat = _sa, "normal"                      # hafta içi normal → dolgusuz
    if (a, c) in offt_karsilanmadi:                     # off_t istendi ama çalıştırıldı
        kat = "offt_kars"                               # etiket kalır, renk KIRMIZI olur
    return metin, kat

