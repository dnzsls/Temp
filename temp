def gun_tipi(date_like):
    """tarih → 'hafta_ici' | 'cumartesi' | 'pazar'"""
    import pandas as pd
    wd = pd.to_datetime(date_like).weekday()
    return 'cumartesi' if wd == 5 else 'pazar' if wd == 6 else 'hafta_ici'


def blok_coz(config, queue, date_like):
    """queue_configs[queue][gün_tipi] bloğunu config'in ÜSTÜNE çıkarır.

    Dönen config düz yapıdadır: config['erlang'], ['mip'], ['slot_cap'],
    ['rr_penalty'], ['hourly_report'], ['balance_penalty'] — hepsi o
    (kuyruk, gün tipi) bloğundan. Mevcut yardımcı fonksiyonlar bu anahtarları
    doğrudan okur, hangi bloktan geldiğini bilmez.

    Sığ kopya döner → çağıranın config'i değişmez.
    """
    tip = gun_tipi(date_like)
    qc = config.get('queue_configs') or {}
    if queue not in qc:
        raise ValueError(f"queue_configs['{queue}'] YOK — tanımlı: {sorted(qc)}")
    blok = qc[queue].get(tip)
    if not blok:
        raise ValueError(f"queue_configs['{queue}']['{tip}'] YOK")
    eksik = [k for k in _BLOK if k not in blok]
    if eksik:
        raise ValueError(f"queue_configs['{queue}']['{tip}'] EKSİK: {eksik}")
    yeni = copy.copy(config)
    yeni.update({k: blok[k] for k in _BLOK})
    yeni['_gun_tipi'] = tip
    return yeni
