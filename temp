def _profil(df, hafta_sonu, kolonlar):
    """Gün tipine göre slot ortalaması (ortalama gün)."""
    d = df[df['hafta_sonu'] == hafta_sonu]
    if d.empty:
        return pd.DataFrame()
    g = d.groupby('interval', as_index=False)[kolonlar].mean()
    g['gun_sayisi'] = d['data_date'].nunique()
    return g.sort_values('interval').reset_index(drop=True)


def ihtiyac_slot_tablosu(df_ihtiyac):
    """interval | hafta içi (çağrı · AHT · gereken) | hafta sonu (aynı) — ortalama gün."""
    parca = []
    for hs, on in ((0, 'HI'), (1, 'HS')):
        g = _profil(df_ihtiyac[df_ihtiyac['cagri'] > 0].pipe(
            lambda x: df_ihtiyac[df_ihtiyac['data_date'].isin(x['data_date'])]),
            hs, ['cagri', 'aht', 'gereken'])
        if g.empty:
            continue
        g = g.drop(columns='gun_sayisi').set_index('interval').round(
            {'cagri': 0, 'aht': 0, 'gereken': 1})
        parca.append(g.add_prefix(f'{on}_'))
    return pd.concat(parca, axis=1).reset_index()


def kapasite_yan_yana(tablolar, hafta_sonu=0):
    """interval | ihtiyaç | her kaynağın kapasitesi — ortalama gün (planlı günler)."""
    kodlar = [k for k in KAYNAKLAR if k in tablolar]
    if not kodlar:
        return pd.DataFrame()
    ilk = tablolar[kodlar[0]]
    ilk = ilk[(ilk['hafta_sonu'] == hafta_sonu) & (ilk['cagri'] > 0)]
    g = ilk.groupby('interval')[['cagri', 'gereken']].mean().round(1)
    g = g.rename(columns={'gereken': 'ihtiyac'})
    for k in kodlar:
        t = tablolar[k]
        t = t[t['hafta_sonu'] == hafta_sonu]
        plan = t.groupby('data_date')['kapasite_toplam'].transform('sum') > 0
        g[k] = t[plan].groupby('interval')['kapasite_toplam'].mean().round(1)
    return g.reset_index()


