# %% [HÜCRE 25B] — EKSİK COVERAGE TEŞHİSİ (neden dolmadı?) ─────────────
# "Coverage yine eksik" sorusunun cevabını 5 adımda arar. Sıra ÖNEMLİ: üstteki
# adım sorunu açıklıyorsa alttakiler semptomdur, ağırlıkla çözülmez.
#   1) YAPISAL KAPASİTE — Σtalep, tüm agentların TOPLAM tavanını aşıyor mu?
#      Aşıyorsa hiçbir ağırlık/parametre kapatamaz; tek çare kadro/outsource
#      ya da Stage-1 talebini düşürmek.
#   2) EKSİK NEREDE — hafta içi / hafta sonu, gün, vardiya tipi kırılımı.
#   3) TAKIM-TİP TAHSİSİ — hafta içi kova ancak takımı O HAFTA o tipe atanmış
#      agentlarla dolar (H19 SERT). Tipe atanan toplam kişi < o tipin talebi ise
#      eksik buradan gelir; ağırlık değil TAKIM/TİP granülerliği sorunudur.
#   4) KİM NEREDE — eksik kovalarda, o gün müsait olan agentlar nereye gitmiş
#      (başka tip / off / off_t / izin / yapısal yasak).
#   5) AĞIRLIK KONTROLÜ — eksik cezası gerçekten bağlayıcı mı, yoksa başka bir
#      ceza mı daha pahalı (amaç fonksiyonundaki payları).
from collections import Counter, defaultdict

print("=" * 78)
print("H25B — EKSİK COVERAGE TEŞHİSİ")
print("=" * 78)

# ── 1) YAPISAL KAPASİTE BİLANÇOSU ─────────────────────────────────────
_arife_atama = sum(solver.Value(x[(a, ds, v)]) for (a, ds, v) in x
                   if v == ARIFE_YARIM)                     # coverage dışı → düş
_gercek_atama = sum(solver.Value(x[k]) for k in x) - _arife_atama
_top_talep = sum(talep.values())
_top_kota  = sum(kota_map.values())
_top_ust   = sum(ust_map.values())
print(f"\n[1] YAPISAL KAPASİTE (kişi-gün)")
print(f"    Σ talep (tüm kovalar)            : {_top_talep}")
print(f"    Σ kota  (SERT taban, H17)        : {_top_kota}")
print(f"    Σ ust   (SERT tavan = kota+mesai+tatil+alacak) : {_top_ust}")
print(f"    gerçekleşen atama (arife hariç)  : {_gercek_atama}")
_acik = _top_talep - _top_ust
if _acik > 0:
    print(f"    ⚠ TOPLAM YAPISAL AÇIK: talep, mutlak tavanı {_acik} kişi-gün AŞIYOR.")
else:
    print(f"    toplam tavan yeterli (fazla {-_acik} kişi-gün); "
          f"kullanılmayan tavan {_top_ust - _gercek_atama} kişi-gün.")

# ── 1B) HAFTA İÇİ / HAFTA SONU AYRI BİLANÇO — asıl belirleyici olan bu ────
# Toplam karşılaştırma YANILTICI: kotanın ÜSTÜNDEKİ kapasite (mesai payı) zorunlu
# olarak HAFTA SONU günüdür (kota = tüm müsait hafta içi gün). Hafta sonu doluysa
# o kapasite ölü kalır, hafta içine AKTARILAMAZ.
#   hafta içi TAVAN  = Σ kota           (agent en fazla tüm müsait hafta içi gününü çalışır)
#   hafta sonu TAVAN = Σ (ust − kota)   (mesai + tatil + sınır alacağı payı)
# Hafta içi talep Σ kota'yı aşıyorsa fark YAPISALDIR: takım-tip düzeltmesi,
# ağırlık, MAX_MESAI — hiçbiri kapatamaz (mesai hafta içine gün ekleyemez).
_talep_hi = sum(k for (ds, _v), k in talep.items()
                if dt.date.fromisoformat(ds).weekday() < 5)
_talep_hs = _top_talep - _talep_hi
_hs_tavan = _top_ust - _top_kota
print(f"\n[1B] HAFTA İÇİ / HAFTA SONU AYRI (mesai kapasitesi hafta içine AKTARILAMAZ)")
print(f"    HAFTA İÇİ  talep {_talep_hi:6d}  vs tavan (Σkota) {_top_kota:6d}  "
      f"→ {'⚠ YAPISAL AÇIK ' + str(_talep_hi - _top_kota) if _talep_hi > _top_kota else 'tavan yeterli (+' + str(_top_kota - _talep_hi) + ')'}")
print(f"    HAFTA SONU talep {_talep_hs:6d}  vs tavan (Σust−Σkota) {_hs_tavan:6d}  "
      f"→ {'⚠ AÇIK ' + str(_talep_hs - _hs_tavan) if _talep_hs > _hs_tavan else 'tavan yeterli (+' + str(_hs_tavan - _talep_hs) + ')'}")
if _talep_hi > _top_kota:
    _yap = _talep_hi - _top_kota
    print(f"    → Hafta içi eksiğin EN AZ {_yap} kişi-günü YAPISAL. Kalanı dağıtım.")
    print(f"      Yapısal kısmın çaresi: kadro/outsource ya da Stage-1 hafta içi talebini")
    print(f"      düşürmek. MAX_MESAI ve takım-tip ayarı bu kısma DOKUNAMAZ.")
else:
    print(f"    → Hafta içi eksik tamamen DAĞITIM sorunu (takım-tip tahsisi, [3]'e bak).")

# ── 2) EKSİK NEREDE ───────────────────────────────────────────────────
_eks = df_cov[df_cov["fark"] < 0].copy()
_eks["eksik"] = -_eks["fark"]
_eks["hs"] = _eks["tarih"].map(lambda ds: dt.date.fromisoformat(ds).weekday() >= 5)
_eks["gun"] = _eks["tarih"].map(lambda ds: DAY_TR[dt.date.fromisoformat(ds).weekday()])
_eks["tip"] = _eks["saat"].str.split("-").str[0]
print(f"\n[2] EKSİK KIRILIMI  (toplam {int(_eks['eksik'].sum())} kişi-gün, "
      f"{len(_eks)} kova)")
_hi_e = int(_eks.loc[~_eks["hs"], "eksik"].sum())
_hs_e = int(_eks.loc[_eks["hs"], "eksik"].sum())
print(f"    HAFTA İÇİ : {_hi_e:5d}  ({len(_eks[~_eks['hs']])} kova)  ← W_EKSIK_HI={W_EKSIK_HI}")
print(f"    HAFTA SONU: {_hs_e:5d}  ({len(_eks[_eks['hs']])} kova)  ← W_EKSIK_HS={W_EKSIK_HS}, sert band ±{HS_TOL}")
print("    vardiya tipine göre:")
for _t, _g in _eks.groupby("tip"):
    print(f"      {_t}: {int(_g['eksik'].sum()):4d} kişi-gün, {len(_g)} kova")
print("    güne göre (en kötü 10):")
_gun_e = _eks.groupby(["tarih", "gun"])["eksik"].sum().sort_values(ascending=False)
for (_ds, _g), _v in _gun_e.head(10).items():
    print(f"      {_ds} {_g}: {int(_v)} kişi-gün")

# ── 3) TAKIM-TİP TAHSİSİ (hafta içi kovaların ASIL kısıtı) ────────────
# H19 SERT: agent o hafta ancak takımının seçtiği tipte çalışabilir. Yani bir
# tipin o haftaki KAPASİTESİ = o tipe atanan takımların üye sayısı. Talep bunu
# aşıyorsa kova matematiksel olarak dolamaz — ağırlıkla ilgisi yok.
_secim = {}                                        # (takım, hafta) → seçilen tip
for (_T, _wk, _bas), _b in takim_tip.items():
    if solver.Value(_b):
        _secim[(_T, _wk)] = _bas
_tip_kapasite = defaultdict(int)                   # (hafta, tip) → atanan üye sayısı
for (_T, _wk), _bas in _secim.items():
    _tip_kapasite[(_wk, _bas)] += len(takimlar.get(_T, []))
print(f"\n[3] TAKIM-TİP TAHSİSİ vs TALEP  (hafta içi, H19 sert kuralı)")
print(f"    {'hafta':>10} {'tip':>7} {'zirve talep':>12} {'tipe atanan kişi':>18}  durum")
_tip_sorun = 0
for _wk in sorted(haftalar):
    if _wk in tatil_haftalari:
        continue
    if _wk == KILIT_HAFTA:                         # sınır haftasında takım seçimi yok
        print(f"    {_wk[0]}-W{_wk[1]:>3} — SINIR HAFTASI: tipler H19E ile önceki aydan "
              f"geldi, takım tahsisi yok (kapasite tablosu H19E'de)")
        continue
    _hi = [ds for ds in haftalar[_wk] if dt.date.fromisoformat(ds).weekday() < 5]
    _tipler = sorted({saat[(ds, v)][0] for ds in _hi
                      for v in gun_vardiyalari[ds] if (ds, v) in talep})
    for _t in _tipler:
        _zirve = max((sum(talep[(ds, v)] for v in gun_vardiyalari[ds]
                          if (ds, v) in talep and saat[(ds, v)][0] == _t)
                      for ds in _hi), default=0)
        _kap = _tip_kapasite.get((_wk, _t), 0)
        _dur = "✓" if _kap >= _zirve else f"⚠ AÇIK {_zirve - _kap}"
        if _kap < _zirve:
            _tip_sorun += 1
        print(f"    {_wk[0]}-W{_wk[1]:>3} {_t:>7} {_zirve:>12} {_kap:>18}  {_dur}")
if _tip_sorun:
    print(f"    ⚠ {_tip_sorun} (hafta,tip) kombinasyonunda takım kapasitesi talebin ALTINDA →")
    print(f"      hafta içi eksiğin ANA sebebi bu. Çözüm ağırlık DEĞİL: takım-tip")
    print(f"      granülerliği (W_TAKIM düşür / takım bölünmesine izin ver) ya da")
    print(f"      Stage-1'de tip dağılımını takım boyutlarına yaklaştır.")
else:
    print(f"    ✓ her (hafta,tip) için atanan takım kapasitesi zirve talebi karşılıyor →")
    print(f"      hafta içi eksik takım-tip tahsisinden DEĞİL, gün içi dağılımdan.")

# ── 4) KİM NEREDE — en kötü 10 eksik kovada agentların gittiği yer ────
print(f"\n[4] EN KÖTÜ 10 EKSİK KOVA — o gün agentlar nerede?")
_kot = _eks.sort_values("eksik", ascending=False).head(10)
for _, _r in _kot.iterrows():
    _ds, _v, _t = _r["tarih"], _r["vardiya"], _r["saat"].split("-")[0]
    _d = dt.date.fromisoformat(_ds)
    _c = Counter()
    for a in AGENTS:
        if (a, _ds, _v) in x and solver.Value(x[(a, _ds, _v)]) == 1:
            _c["BU KOVADA"] += 1
            continue
        if _d in izin_map.get(a, set()):
            _c["izin"] += 1
        elif _d in off_block_map.get(a, set()):
            _c["off_t2"] += 1
        elif (a, _ds, _v) not in x:
            _c["değişken yok"] += 1
        elif a in sabah_agents and not (dakika(saat[(_ds, _v)][0]) < dakika(saat[(_ds, _v)][1])
                                        and dakika(saat[(_ds, _v)][1]) <= LIMIT):
            _c["sabahçı (H13)"] += 1
        elif a in hafta_sonu_yasak and _d.weekday() >= 5:
            _c["hamile/süt (H14)"] += 1
        elif (_d.weekday() < 5
              and _secim.get((agent_takim.get(a), _d.isocalendar()[:2])) not in (None, _t)):
            # H19 SERT: takımı o hafta BAŞKA tipe atanmış → bu kovaya giremez.
            # Bu kişiler "off" görünse bile sebep off tercihi değil, takım kilidi.
            _c["takım TİPİ farklı (H19)"] += 1
        else:
            _hucre = roster.at[a, _ds] if _ds in roster.columns else None
            if _hucre in ("off", "off_t"):
                _c["OFF verilmiş" if _hucre == "off" else "off_t verilmiş"] += 1
            elif _hucre in _OFF_LIKE:
                _c[str(_hucre)] += 1
            elif isinstance(_hucre, str) and _hucre.replace("mesai ", "").split("-")[0] != _t:
                _c["BAŞKA TİPTE çalışıyor"] += 1
            else:
                _c["aynı tip, başka kova"] += 1
    print(f"    {_ds} {_r['gun']} {_r['saat']}: talep {int(_r['talep'])}, "
          f"atanan {int(_r['atanan'])}, EKSİK {int(_r['eksik'])}")
    print(f"        {dict(_c.most_common())}")

# ── 5) AMAÇ FONKSİYONU PAYLARI — hangi ceza gerçekten bağlayıcı ───────
# Eksik cezası toplam amacın küçük bir kısmıysa, model onu "ucuz" buluyordur.
_eksik_ceza = (_hi_e * W_EKSIK_HI) + (_hs_e * W_EKSIK_HS)
_offt_ceza  = len(offt_karsilanmadi) * W_OFF_T
_amac_deg = 0.0 if FIZIBILITE_MODU else solver.ObjectiveValue()   # fizibilite modunda amaç yok
print(f"\n[5] AMAÇ FONKSİYONU PAYLARI  (toplam = {_amac_deg:.0f}"
      + ("  — FİZİBİLİTE MODU: amaç kurulmadı, paylar anlamsız)" if FIZIBILITE_MODU else ")"))
print(f"    eksik coverage cezası : {_eksik_ceza:>10}  "
      f"(%{100 * _eksik_ceza / max(1, _amac_deg):.1f})")
print(f"    off_t karşılanmayan   : {_offt_ceza:>10}  "
      f"({len(offt_karsilanmadi)} kişi-gün × {W_OFF_T})")
print(f"    → eksik payı düşükse model eksiği ucuz buluyor; ama önce [1] ve [3]'e bak,")
print(f"      orada yapısal/tahsis sorunu varsa ağırlık artırmak İŞE YARAMAZ.")
print("=" * 78)


# %% [HÜCRE 25C] — ORANSAL ADALET TAVANI SİMÜLASYONU (SALT OKUNUR) ─────
# SORU: mesai/norm dengesini AĞIRLIK yerine KISIT ile yönetsek ne olurdu?
#   önerilen kısıt:  N × deger_a  ≤  M + N × TOL     (M = Σ deger_a, N = uygun agent)
#   sadeleşmiş hâli: deger_a ≤ (fiili ortalama) + TOL  → "kimse ortalamanın TOL üstüne çıkamaz"
# Bu hücre kısıtı KURMAZ. Mevcut çözümü okuyup "kursaydık ne olurdu"yu ölçer:
#   kaç agent tavanın üstünde, o kişilerden kaç gün alınırdı, o günleri BAŞKASI
#   alabilir mi (emilim kapasitesi), ve hafta sonunda sert bandı kırar mıydı.
# Model değişmiyor → yeniden çözmeye gerek yok, H22'den sonra istediğin an koşar.
#
# İKİ TARAF SİMETRİK DEĞİL:
#   MESAİ tavanı  → HACMİ kısar. Bağlarsa agent daha az gün çalışır; hafta sonu
#                   sert bandı norm ile doldurulabildiği için kayıp HAFTA İÇİ
#                   kovalara gider = yumuşak ceza. INFEASIBLE olmaz.
#   HAFTA SONU tavanı → YERİ kısar. Bağlarsa o Cmt/Pzr kovasına kimse konamaz,
#                   ama kovanın SERT alt sınırı var (talep − HS_TOL) → INFEASIBLE.
# Bu yüzden [2]'nin altında ayrı bir fizibilite kontrolü ([3]) var; mesaide gerekmiyor.
print("=" * 78)
print("H25C — ORANSAL ADALET TAVANI SİMÜLASYONU (model DEĞİŞMEZ, sadece ölçüm)")
print("=" * 78)

_TOL_LISTE = (0, 1, 2)


def _oransal(baslik, deger, uygun, tavan_map=None, birim="kişi-gün"):
    """Her TOL için tavanı ve etkisini yazdır.
    deger    : agent → mevcut sayı (mesai günü / hafta sonu günü)
    uygun    : kısıtın kapsayacağı agent kümesi (N buradan gelir)
    tavan_map: agent → o agentın FİİLEN çıkabileceği en yüksek değer
               (mesai: MAX_MESAI; hafta sonu: müsait hafta sonu günü sayısı)
               → emilim kapasitesi bununla sınırlanır, hayali kapasite sayılmaz
    """
    M = sum(deger.get(a, 0) for a in uygun)
    N = len(uygun)
    if not N:
        print(f"\n{baslik}: uygun agent yok → atlandı")
        return
    print(f"\n{baslik}")
    print(f"    fiili toplam M = {M} {birim}  |  uygun agent N = {N}  |  "
          f"ortalama = {M / N:.2f}")
    _dag = Counter(deger.get(a, 0) for a in uygun)
    print(f"    mevcut dağılım (değer → agent): {dict(sorted(_dag.items()))}")
    print(f"    {'TOL':>4} {'tavan':>6} {'üstünde':>9} {'taşınacak':>10} "
          f"{'emilim kap.':>12}  sonuç")
    for _tol in _TOL_LISTE:
        _cap = M // N + _tol                       # N×d ≤ M + N×TOL  ⇔  d ≤ M/N + TOL
        _ust = [a for a in uygun if deger.get(a, 0) > _cap]
        _tasin = sum(deger[a] - _cap for a in _ust)          # tavanın üstünden alınacak gün
        _emilim = 0                                          # geri kalanın tavana kadar boşluğu
        for a in uygun:
            _lim = _cap if tavan_map is None else min(_cap, tavan_map.get(a, _cap))
            _emilim += max(0, _lim - deger.get(a, 0))
        _sonuc = ("✓ toplam korunur (yük başkasına geçer)" if _emilim >= _tasin
                  else f"⚠ en az {_tasin - _emilim} {birim} KAYBOLUR")
        print(f"    {_tol:>4} {_cap:>6} {len(_ust):>9} {_tasin:>10} "
              f"{_emilim:>12}  {_sonuc}")
    print(f"    NOT: tavan FİİLİ toplamdan (M) türüyor. Kısıt kurulunca model M'yi")
    print(f"         değiştirirse tavan da değişir → bu tablo ilk-adım tahminidir.")
    print(f"         'emilim kapasitesi' üst sınırdır: o agent o GÜN müsait mi ayrı mesele.")


# ── 0) KİŞİSEL HAFTA SONU MÜSAİTLİĞİ (emilim hesabının tabanı) ────────
# "Duvarın üstündekilerden alınan günü kim alacak?" sorusunun cevabı, o kişilerin
# FİİLEN müsait olmasına bağlı. İzni çok olan agent 3'e çıkamaz → onun boş görünen
# kapasitesi HAYALİDİR. Bu yüzden emilim, MAX_MESAI ile değil KİŞİSEL tavanla sınırlanır.
#   müsait hafta sonu günü = o gün değişkeni olan hafta sonu günü sayısı
#     (izin / off_t2 → değişken yok; hamile/süt zaten uygun kümesinin dışında)
#   H18 açıksa 1 tam Cmt+Pzr off ZORUNLU → −2
# Mesai günü zorunlu olarak hafta sonu günüdür (kota = tüm müsait hafta içi gün)
# → kişisel mesai tavanı = min(MAX_MESAI, müsait hafta sonu günü).
# NOT: bu hâlâ ÜST sınır — o günlerin bir kısmı norm olarak kullanılıyor olabilir.
_hs_kol = [c for c in _gun if dt.date.fromisoformat(c).weekday() >= 5
           and dt.date.fromisoformat(c) not in TATIL]
_hs_uygun = [a for a in roster.index if a not in hafta_sonu_yasak]
_hs_musait = {}
for a in _hs_uygun:
    _m = sum(1 for c in _hs_kol
             if any((a, c, v) in x for v in gun_vardiyalari.get(c, [])))
    _hs_musait[a] = max(0, _m - (2 if CIFT_HS_OFF else 0))
_mus_dag = Counter(_hs_musait.values())
print(f"\n[0] KİŞİSEL HAFTA SONU MÜSAİTLİĞİ  ({len(_hs_kol)} hafta sonu günü"
      + (f", H18 zorunlu çift off düşülmüş" if CIFT_HS_OFF else "") + ")")
print(f"    müsait gün → agent: {dict(sorted(_mus_dag.items()))}")
print(f"    → emilim kapasitesi bu tavanla sınırlanıyor; 'boş ama ulaşılamaz' "
      f"kapasite sayılmıyor.")

# ── 1) MESAİ (ay bazlı, H22'nin mesai_gun'ü ile AYNI ölçü) ────────────
_m_uygun = [a for a in roster_2.index if a in kota_map and a not in ozel_agents]
_m_deger = {a: int(roster_2.at[a, "mesai_gun"]) for a in _m_uygun}
_m_tavan = {a: min(MAX_MESAI, _hs_musait.get(a, MAX_MESAI)) for a in _m_uygun}
_oransal(f"[1] MESAİ  (uygun = kota_map'te olan ve özel flag'siz; MAX_MESAI={MAX_MESAI})",
         _m_deger, _m_uygun, _m_tavan, "mesai-günü")
# kaç agentın KİŞİSEL tavanı duvarın altında kalıyor → duvar onlara zaten dokunmuyor,
# ama emilim kapasitesine de katkı veremiyorlar
_M_m, _N_m = sum(_m_deger.values()), len(_m_uygun)
for _tol in _TOL_LISTE:
    _cap = _M_m // _N_m + _tol
    _kisitli = [a for a in _m_uygun if _m_tavan[a] < _cap]
    _hayali = sum(_cap - _m_tavan[a] for a in _kisitli)
    print(f"    TOL={_tol} (tavan {_cap}): kişisel tavanı duvarın ALTINDA olan "
          f"{len(_kisitli)} agent → {_hayali} günlük kapasite ULAŞILAMAZ "
          f"(MAX_MESAI varsayılsaydı emilime sayılırdı)")
print(f"    → bu taraf bağlarsa kayıp HAFTA İÇİ kovalara gider (yumuşak ceza), "
      f"INFEASIBLE riski YOK.")

# ── 2) HAFTA SONU GÜNÜ (norm + mesai BİRLİKTE — H20C'nin ölçüsü) ──────
_hs_deger = {a: sum(1 for c in _hs_kol if roster.at[a, c] not in _OFF_LIKE)
             for a in _hs_uygun}
_oransal("[2] HAFTA SONU GÜNÜ  (norm + mesai birlikte; uygun = hamile/süt HARİÇ)",
         _hs_deger, _hs_uygun, _hs_musait, "hafta sonu günü")

# ── 3) HAFTA SONU FİZİBİLİTE — tavan sert bandı kırar mı? ─────────────
# Hafta sonu kovalarının SERT alt sınırı: talep − HS_TOL. Toplamı karşılamak için
# gereken kişi-gün ile, tavan altında kalan TOPLAM kapasiteyi karşılaştır:
#   kapasite(TOL) = Σ_a min(tavan, o agentın müsait hafta sonu günü)
# kapasite < gereken → o TOL ile model ÇÖZÜMSÜZ olur (H25B'deki gibi eksik yazmaz).
_gereken_hs = sum(max(0, kisi - HS_TOL) for (ds, v), kisi in talep.items()
                  if dt.date.fromisoformat(ds).weekday() >= 5)
_M_hs = sum(_hs_deger.values())
_N_hs = len(_hs_uygun)
print(f"\n[3] HAFTA SONU FİZİBİLİTE  (sert band alt sınırı: talep − HS_TOL={HS_TOL})")
print(f"    sert band için GEREKEN toplam : {_gereken_hs} kişi-gün")
print(f"    şu an atanan                  : {_M_hs} kişi-gün "
      f"(fazla {_M_hs - _gereken_hs})")
print(f"    {'TOL':>4} {'tavan':>6} {'tavan altı kapasite':>20}  durum")
for _tol in _TOL_LISTE:
    _cap = (_M_hs // _N_hs + _tol) if _N_hs else 0
    _kap = sum(min(_cap, _hs_musait[a]) for a in _hs_uygun)
    _dur = ("✓ güvenli" if _kap >= _gereken_hs
            else f"⚠ INFEASIBLE RİSKİ — {_gereken_hs - _kap} kişi-gün AÇIK")
    print(f"    {_tol:>4} {_cap:>6} {_kap:>20}  {_dur}")
print(f"    NOT: bu TOPLAM kontrolü. Toplam yetse bile tek bir gün dolmayabilir →")
print(f"         aşağıdaki gün bazlı tabloya bak.")

# gün bazlı: o gün gerçekten müsait agent, o günün sert alt sınırını karşılıyor mu
print(f"\n    gün bazlı (en dar 10 hafta sonu günü — tavandan BAĞIMSIZ, ham müsaitlik):")
_gun_satir = []
for _ds in sorted({c for c in _hs_kol}):
    _min_gerek = sum(max(0, talep[(_ds, v)] - HS_TOL) for v in gun_vardiyalari[_ds]
                     if (_ds, v) in talep)
    _mus = sum(1 for a in _hs_uygun
               if any((a, _ds, v) in x for v in gun_vardiyalari[_ds]))
    _gun_satir.append((_ds, _min_gerek, _mus, _mus - _min_gerek))
for _ds, _g, _m, _f in sorted(_gun_satir, key=lambda t: t[3])[:10]:
    _d = dt.date.fromisoformat(_ds)
    print(f"      {_ds} {DAY_TR[_d.weekday()]}: sert alt sınır {_g:4d}  "
          f"müsait agent {_m:4d}  pay {_f:+5d}"
          f"{'   ⚠ DAR' if _f < 0.15 * max(1, _g) else ''}")

# ── 4) KARAR ÖZETİ ────────────────────────────────────────────────────
print(f"\n[4] OKUMA KILAVUZU")
print(f"    [1] 'taşınacak' düşük + 'emilim' yüksek → mesai kısıtı ucuz, uygulanabilir.")
print(f"    [1] 'KAYBOLUR' çıkıyorsa → o TOL ile toplam mesai düşer, coverage eksiği artar.")
print(f"    [3] herhangi bir TOL'de 'INFEASIBLE RİSKİ' → hafta sonu tavanı O TOL ile")
print(f"        kurulamaz; bir üst TOL'e geç ya da hafta sonunu ağırlıkla yönetmeye devam et.")
print("=" * 78)


# %% [HÜCRE 25D] — TEK KOVA RÖNTGENİ (SALT OKUNUR) ────────────────────
# SORU: "3 Ağustos 09:00'da 59 lazımdı, 26 atandı — neden 2 takım daha
#        buraya konmadı?"
# Bu hücre TEK bir (gün, vardiya tipi) için dört adımda cevap arar. Sıra ÖNEMLİ:
#   [1] GÜN mü dar? O gün toplam talep vs o gün müsait agent. Gün genelinde
#       kapasite yoksa tip değiştirmek HİÇBİR ŞEY çözmez — kova başka kovadan
#       çalar, toplam eksik aynı kalır.
#   [2] TİP kapasitesi ne? H19 SERT: kova ancak o hafta o tipe atanmış takımlarla
#       dolar. Atanan üye sayısı talebin altındaysa matematiksel olarak dolamaz.
#   [3] Kapasite VARDI da gelmedi mi? O tipe atanmış üyeler o gün nerede —
#       off / izin / off_t / aynı tipte başka kova. "Kapasite yok" ile
#       "kapasite var ama off verilmiş" bambaşka iki sorun, çözümleri de farklı.
#   [4] Hangi takım TAŞINABİLİRDİ, bedeli ne? Kritik nokta: takım tipi HAFTALIK.
#       Pazartesi için bir takımı 09:00'a çekersen o takım TÜM HAFTA orada kalır
#       → verici tip başka bir gün açığa düşebilir. Bu yüzden vericinin o
#       haftadaki EN DAR günü hesaplanıyor; taşımanın gerçek bedeli o.
# Model değişmiyor, salt okunur.
INCELE_KOVA = []        # [("2026-08-03", "09:00"), ...] — BOŞ ise en kötü N eksik
INCELE_SAYI = 3         # otomatik seçimde kaç kova incelensin

print("=" * 78)
print("H25D — TEK KOVA RÖNTGENİ (neden bu kova eksik kaldı?)")
print("=" * 78)

# hedef listesi: elle verilmediyse en çok eksiği olan kovalar (tip bazında birleşik)
if INCELE_KOVA:
    _hedefler = [(ds, tip) for ds, tip in INCELE_KOVA]
else:
    _eks_tip = {}                                  # (gün, tip) → toplam eksik
    for (ds, v), kisi in talep.items():
        _at = sum(1 for a in AGENTS if (a, ds, v) in x and solver.Value(x[(a, ds, v)]))
        if _at < kisi:
            _k = (ds, saat[(ds, v)][0])
            _eks_tip[_k] = _eks_tip.get(_k, 0) + (kisi - _at)
    _hedefler = [k for k, _ in sorted(_eks_tip.items(), key=lambda kv: -kv[1])][:INCELE_SAYI]

_secim_d = {}                                      # (takım, hafta) → seçilen tip
for (_T, _wk, _bas), _b in takim_tip.items():
    if solver.Value(_b):
        _secim_d[(_T, _wk)] = _bas


def _gun_tip_sayi(ds, tip):
    """o gün, o tipteki kovaların (talep, atanan) toplamı."""
    _t = _a = 0
    for v in gun_vardiyalari.get(ds, []):
        if (ds, v) in talep and saat[(ds, v)][0] == tip:
            _t += talep[(ds, v)]
            _a += sum(1 for a in AGENTS if (a, ds, v) in x and solver.Value(x[(a, ds, v)]))
    return _t, _a


def _yapabilir(a, ds, tip):
    """agent o gün o TİPTE fiziksel olarak çalışabilir mi (sert yasaklar)."""
    for v in gun_vardiyalari.get(ds, []):
        if (a, ds, v) not in x or saat[(ds, v)][0] != tip:
            continue
        bas, bit = saat[(ds, v)]
        if a in sabah_agents and not (dakika(bas) < dakika(bit) and dakika(bit) <= LIMIT):
            continue                               # H13 sabahçı
        if a in junior_agents and bas in GECE_TIPLERI:
            continue                               # H14B kıdem/gece
        if a in hafta_sonu_yasak and dt.date.fromisoformat(ds).weekday() >= 5:
            continue                               # H14 hamile/süt
        return True
    return False


def _tip_musait(ds, tip, wk):
    """o gün, o tipe atanmış takımların o TİPTE FİİLEN çalışabilen üye sayısı.
    (izin/off_t2 → değişken yok; sabahçı/kıdem/hamile → yapamaz)
    NEDEN 'atanan' DEĞİL: H17 kotayı SERT tutuyor → herkes bir yerde çalışmak
    ZORUNDA. Bir tipe ihtiyaçtan fazla takım atandıysa model o fazla insanları
    o tipin kovalarına PARK ediyor ve 'atanan' talebin üstüne çıkıyor
    (ör. 15:00: 96 üye, talep 56, atanan 66). 'atanan − talep' bunu 10 kişilik
    pay gibi gösteriyordu; oysa gerçek pay 96 − 56 = 40. Doğru ölçü MÜSAİT ÜYE."""
    return sum(1 for _T, _u in takimlar.items() if _secim_d.get((_T, wk)) == tip
               for a in _u if _yapabilir(a, ds, tip))


for _ds, _tip in _hedefler:
    _d = dt.date.fromisoformat(_ds)
    _wk = _d.isocalendar()[:2]
    _hafta_gun = haftalar.get(_wk, [])
    _t_tip, _a_tip = _gun_tip_sayi(_ds, _tip)
    print(f"\n{'─' * 74}")
    print(f"KOVA: {_ds} {DAY_TR[_d.weekday()]}  tip {_tip}  →  talep {_t_tip}, "
          f"atanan {_a_tip}, EKSİK {_t_tip - _a_tip}   (ISO hafta {_wk[0]}-W{_wk[1]})")
    print(f"{'─' * 74}")

    # ── [1] GÜN BİLANÇOSU ────────────────────────────────────────────
    _g_talep = sum(talep[(_ds, v)] for v in gun_vardiyalari[_ds] if (_ds, v) in talep)
    _g_atanan = sum(1 for a in AGENTS for v in gun_vardiyalari[_ds]
                    if (a, _ds, v) in x and solver.Value(x[(a, _ds, v)])
                    and (_ds, v) in talep)
    _g_musait = sum(1 for a in AGENTS
                    if any((a, _ds, v) in x for v in gun_vardiyalari[_ds]))
    _g_izin = sum(1 for a in AGENTS if _d in izin_map.get(a, set()))
    _g_offt2 = sum(1 for a in AGENTS if _d in off_block_map.get(a, set()))
    print(f"\n[1] GÜN BİLANÇOSU ({_ds})")
    print(f"    o günün TOPLAM talebi (tüm tipler) : {_g_talep}")
    print(f"    o gün atanan (tüm tipler)          : {_g_atanan}  "
          f"→ günlük açık {_g_talep - _g_atanan}")
    print(f"    o gün DEĞİŞKENİ olan agent         : {_g_musait} "
          f"(izin {_g_izin}, off_t2 {_g_offt2} hariç)")
    if _g_musait < _g_talep:
        print(f"    ⚠ GÜN DAR: müsait agent ({_g_musait}) < günlük talep ({_g_talep}) →")
        print(f"      bu kovayı doldurmak BAŞKA kovayı boşaltır. Takım taşımak toplam")
        print(f"      eksiği DEĞİŞTİRMEZ, sadece yerini değiştirir.")
    else:
        print(f"    → gün genelinde {_g_musait - _g_talep} kişilik pay var; sorun")
        print(f"      DAĞITIMDA (tip tahsisi / off yerleşimi) → [2] ve [3]'e bak.")

    # ── [2] O HAFTA TİP TAHSİSİ ──────────────────────────────────────
    _tip_uye, _tip_takim = {}, {}
    for _T, _uyeler in takimlar.items():
        _s = _secim_d.get((_T, _wk))
        if _s is None:
            continue
        _tip_uye[_s] = _tip_uye.get(_s, 0) + len(_uyeler)
        _tip_takim.setdefault(_s, []).append((_T, len(_uyeler)))
    print(f"\n[2] O HAFTANIN TİP TAHSİSİ  (H19: takım hafta boyu tek tipte)")
    print(f"    {'tip':>7} {'takım':>6} {'üye':>5} {'o gün talep':>12} "
          f"{'o gün atanan':>13} {'hafta zirve':>12} {'PAY':>6}")
    _pay_arti = _pay_eksi = 0
    for _t in sorted(set(_tip_uye) | {_tip}):
        _tt, _ta = _gun_tip_sayi(_ds, _t)
        _zirve = max((_gun_tip_sayi(g, _t)[0] for g in _hafta_gun
                      if dt.date.fromisoformat(g).weekday() < 5), default=0)
        _pay = _tip_uye.get(_t, 0) - _zirve        # KAPASİTE payı (üye − zirve talep)
        _pay_arti += max(0, _pay)
        _pay_eksi += max(0, -_pay)
        _im = "  ← İNCELENEN" if _t == _tip else ""
        print(f"    {_t:>7} {len(_tip_takim.get(_t, [])):>6} {_tip_uye.get(_t, 0):>5} "
              f"{_tt:>12} {_ta:>13} {_zirve:>12} {_pay:>+6}{_im}")
    print(f"    PAY = üye − hafta zirve talebi (KAPASİTE payı).  "
          f"Σ fazla +{_pay_arti} / Σ açık −{_pay_eksi}")
    if _pay_arti >= _pay_eksi:
        print(f"    → Tipler arası TOPLAM kapasite yeterli ({_pay_arti} ≥ {_pay_eksi}):")
        print(f"      daha iyi bir takım→tip tahsisi MATEMATİKSEL OLARAK VAR.")
    print(f"    NOT: 'o gün atanan' talebi AŞABİLİR — kota SERT olduğu için fazla")
    print(f"         üyeler o tipin kovalarına PARK edilir. Bolluğun ölçüsü PAY'dır,")
    print(f"         'atanan − talep' DEĞİL.")
    _kap = _tip_uye.get(_tip, 0)
    if _kap < _t_tip:
        print(f"    ⚠ Bu tipe atanan TOPLAM üye {_kap} < talep {_t_tip} → kova")
        print(f"      matematiksel olarak dolamaz. Eksiğin ≥{_t_tip - _kap}'i tahsis kaynaklı.")
    else:
        print(f"    → Tipe atanan üye ({_kap}) talebi ({_t_tip}) karşılıyor; demek ki")
        print(f"      üyeler o gün ÇALIŞMIYOR → [3]'e bak.")

    # ── [3] BU TİPE ATANANLAR O GÜN NEREDE ───────────────────────────
