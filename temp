# MODEL TARAFI — pickle
# --------------------------------------------------------------------------

def model_tablosu(results, year, month, queue='kitle', verbose=True):
    """Pickle'dan PLAN ile AYNI şemada gün × slot tablosu.

    kapasite  ← mip_in_by_slot / mip_out_by_slot / mip_pt_by_slot
    başlangıç ← assignments + shift_coverage['start'|'company']

    NOT: mip_in_by_slot part_time'ı İÇERMEZ; kısmiler mip_pt_by_slot'ta.
    NOT: outsource +30 dk kuralı burada UYGULANMAZ — modelin vardiya
         tanımları pickle'da zaten yerleşik.
    """
    def _s(ad):
        ad = str(ad or 'inhouse').lower()
        if 'outsource' in ad:
            return 'outsource'
        if 'part' in ad:
            return 'part_time'
        return 'inhouse'

    kap, bas, aylar, infeasible = [], [], set(), []
    for ds, day in (results or {}).items():
        d = pd.to_datetime(ds).normalize()
        aylar.add(d.strftime('%Y-%m'))
        if d.year != year or d.month != month:
            continue
        r = (day or {}).get(queue)
        if not r:
            infeasible.append(d)
            continue
        mi = r.get('mip_info', {}) or {}
        inn = mi.get('mip_in_by_slot', {}) or {}
        o = mi.get('mip_out_by_slot', {}) or {}
        pt = mi.get('mip_pt_by_slot', {}) or {}
        if not inn and not o:
            inn = dict(mi.get('mip_by_slot', {}) or {})
        for sl in set(inn) | set(o) | set(pt):
            kap.append({'data_date': d, 'interval': _to_slot_30(sl),
                        'kapasite_in': inn.get(sl, 0), 'kapasite_out': o.get(sl, 0),
                        'kapasite_pt': pt.get(sl, 0)})
        sc = mi.get('shift_coverage', {}) or {}
        for sh, adet in (mi.get('assignments', {}) or {}).items():
            if not adet or adet <= 0:
                continue
            bilgi = sc.get(sh, {}) or {}
            b0 = bilgi.get('start') or shift_baslangic(sh)
            if b0:
                bas.append({'data_date': d, 'interval': _to_slot_30(b0),
                            'sirket': _s(bilgi.get('company')), 'kisi': adet})

    if not kap:
        raise ValueError(f"pickle'da {year}/{month:02d} '{queue}' yok. "
                         f"İçindeki aylar: {sorted(aylar)}")

    ay_bas = pd.Timestamp(year, month, 1)
    gunler = pd.date_range(ay_bas, ay_bas + pd.offsets.MonthEnd(1), freq='D')
    out = pd.MultiIndex.from_product(
        [gunler, SLOTS_30], names=['data_date', 'interval']).to_frame(index=False)
    out = out.merge(pd.DataFrame(kap).groupby(['data_date', 'interval'],
                                              as_index=False).sum(),
                    on=['data_date', 'interval'], how='left')

    if bas:
        b = pd.DataFrame(bas).groupby(['data_date', 'interval', 'sirket'],
                                      as_index=False)['kisi'].sum()
        for sirket, sonek in SIRKETLER:
            alt = b[b['sirket'] == sirket][['data_date', 'interval', 'kisi']]
            out = out.merge(alt.rename(columns={'kisi': f"baslangic_{sonek}"}),
                            on=['data_date', 'interval'], how='left')
    else:
        for _, sonek in SIRKETLER:
            out[f"baslangic_{sonek}"] = 0
        if verbose:
            print("  ⚠ pickle'da 'assignments' yok — başlangıç 0 kalacak.")

    deger = [f"{o}_{s}" for o in ('kapasite', 'baslangic') for _, s in SIRKETLER]
    for kol in deger:
        if kol not in out:
            out[kol] = 0
    out[deger] = out[deger].fillna(0).round().astype(int)
    out['kapasite_toplam'] = out[[f"kapasite_{s}" for _, s in SIRKETLER]].sum(axis=1)
    out['baslangic_toplam'] = out[[f"baslangic_{s}" for _, s in SIRKETLER]].sum(axis=1)
    out = out.sort_values(['data_date', 'interval']).reset_index(drop=True)

    if verbose:
        dolu = (out.groupby('data_date')['kapasite_toplam'].sum() > 0).sum()
        print(f"MODEL ({queue}) — {dolu}/{len(gunler)} gün planlı  |  tepe kapasite: "
              f"in {int(out['kapasite_in'].max())} · out {int(out['kapasite_out'].max())} "
              f"· pt {int(out['kapasite_pt'].max())}")
        if infeasible:
            print(f"  ⚠ planı olmayan {len(infeasible)} gün: "
                  f"{', '.join(d.strftime('%d.%m') for d in infeasible[:8])}")
    return _gun_tipi_ekle(out)


