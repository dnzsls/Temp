def _tarih_ozeti(df, year, month, onceki_gerekli=False):
    d_col = _resolve_col(df, VARDIYA_KOL['date'])
    if d_col is None:
        return "tarih kolonu yok"
    try:
        t = _to_date_series(df[d_col]).dt.normalize()
    except Exception as ex:
        return f"✗ tarih okunamadı → {ex}"
    ay = t[(t.dt.year == year) & (t.dt.month == month)]
    s = (f"{t.min():%d.%m.%Y} – {t.max():%d.%m.%Y}  |  {year}/{month:02d}: "
         f"{ay.nunique()} gün {'✓' if len(ay) else '✗ YOK'}")
    if onceki_gerekli:
        onceki = pd.Timestamp(year=year, month=month, day=1) - pd.Timedelta(days=1)
        s += (f"  |  {onceki:%d.%m} (gece için) "
              f"{'✓' if (t == onceki).any() else '⚠ yok'}")
    return s


def girdi_goster(sira, ad, aciklama, obj, year, month, zorunlu=False,
                 onceki_gerekli=False, n=5):
    print(f"\n[{sira}] {ad} — {aciklama}")
    if obj is None:
        print(f"    {'✗ YOK (zorunlu)' if zorunlu else '— yok (opsiyonel)'}")
        return
    if isinstance(obj, pd.DataFrame):
        print(f"    {obj.shape[0]:,} satır × {obj.shape[1]} kolon  |  "
              f"{_tarih_ozeti(obj, year, month, onceki_gerekli)}")
        show(obj.head(n))
        return
    if isinstance(obj, dict) and 'interval' in obj:              # agent_cov paketi
        m = obj.get('meta', {}) or {}
        print(f"    agent_cov paketi  |  anahtarlar {list(obj)}  |  durum {m.get('durum')}"
              f"  |  agent {m.get('agent_sayisi')}")
        iv = obj['interval']
        print(f"    interval: {_tarih_ozeti(iv, year, month)}")
        show(iv.head(n))
        if isinstance(obj.get('agent_plan'), pd.DataFrame):
            print("    agent_plan:")
            show(obj['agent_plan'].head(n))
        return
    if isinstance(obj, dict):                                    # MIP pickle
        aylar = {}
        for ds in obj:
            try:
                x = pd.to_datetime(ds)
                aylar[(x.year, x.month)] = aylar.get((x.year, x.month), 0) + 1
            except Exception:
                continue
        print(f"    MIP pickle  |  {len(obj)} gün  |  aylar: "
              + ', '.join(f"{y}/{mm:02d} ({c})" for (y, mm), c in sorted(aylar.items()))
              + f"  |  {year}/{month:02d} {'✓' if (year, month) in aylar else '✗ YOK'}")
        for ds, day in sorted(obj.items()):
            x = pd.to_datetime(ds)
            r = (day or {}).get('kitle')
            if x.year == year and x.month == month and r:
                mi = r.get('mip_info', {}) or {}
                inn = mi.get('mip_in_by_slot', {}) or {}
                out = mi.get('mip_out_by_slot', {}) or {}
                pt = mi.get('mip_pt_by_slot', {}) or {}
                slotlar = [s for s in SLOTS_30 if s >= '08:00'][:n]
                print(f"    örnek gün {x:%d.%m.%Y} (kitle, mip_info):")
                show(pd.DataFrame({'interval': slotlar,
                                   'mip_in': [inn.get(s, 0) for s in slotlar],
                                   'mip_out': [out.get(s, 0) for s in slotlar],
                                   'mip_pt (okunmaz)': [pt.get(s, 0) for s in slotlar]}))
                break
        return
    print(f"    tip: {type(obj).__name__}")


