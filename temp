# ---------------------------------------------------------------------------
# AYLIK SLA — ÇAĞRI CİNSİNDEN DEFTER  (bu dosyanın EKLENTİSİ)
# ---------------------------------------------------------------------------
# Erlang-C'ye (kişi, trafik, AHT) verince İKİ AYRI çıktı alınır:
#   ASA = ortalama bekleme (saniye)        ← Model-1 sizing bunu kullanıyor
#   SL  = P(bekleme ≤ T sn)                ← iş hedefi BU (%80 / 30 sn)
# İkisi aynı şey değil; aynı ASA farklı AHT'de farklı SL verir.
#
# AYLIK hedef HACİM-AĞIRLIKLI:  Σ(çağrı_i × SL_i) / Σ çağrı_i ≥ 0.80
# → yüzde toplanmaz, ÇAĞRI toplanır. Her slotta %80 aramak gereksiz sıkı:
#   bol slottaki fazlalık dar slottaki açığı ÖDER (kredi/borç defteri).

SLA_HEDEF = 0.80          # aylık servis seviyesi hedefi
SLA_SANIYE = 30           # "30 saniye içinde"

# katman kodu → (etiket, df_hakem'deki kişi kolonu)
# Kolon yoksa o katman sessizce atlanır (girdi hazır değil demektir).
SLA_KATMANLAR = [
    ('ihtiyac',      '1 İHTİYAÇ (Erlang)',  'ihtiyac'),
    ('model1',       '2 BİZ  — MODEL-1',    'model_toplam'),
    ('model2',       '3 BİZ  — MODEL-2',    'model2_toplam'),
    ('ekip_model1',  '4 EKİP — MODEL-1',    'plan_toplam'),
    ('ekip_model2',  '5 EKİP — MODEL-2',    'ekip_model2_toplam'),
]


def calc_sl(agents, traffic, aht, T=SLA_SANIYE):
    """P(bekleme ≤ T sn) — Erlang-C'nin SERVİS SEVİYESİ çıktısı.

    agents : TELEFONDA olan kişi (shrinkage DÜŞÜLMÜŞ) — çizelgedeki kişi DEĞİL
    traffic: erlang (çağrı × AHT / interval)
    aht    : saniye
    """
    if agents <= traffic or agents <= 0:
        return 0.0                       # kuyruk patlar → 30 sn içinde cevap ~0
    ec = _erlang_c(agents, traffic)
    return max(0.0, min(1.0, 1.0 - ec * math.exp(-(agents - traffic) * T / aht)))


def _telefonda(kisi, slot, shrinkage=None):
    """Çizelgedeki kişi → TELEFONDA olan kişi.

    erlang_need de dahil tüm kadro sayıları shrinkage ŞİŞİRİLMİŞ:
        final = ceil(raw / (1 − shr))
    SL'i şişirilmiş sayıyla hesaplamak SL'i olduğundan YÜKSEK gösterir.
    """
    shr_cfg = shrinkage if shrinkage is not None else KITLE_SHRINKAGE
    shr = shr_cfg.get(int(str(slot)[:2]), shr_cfg.get('default', 0.0))
    return float(kisi) * (1.0 - shr)


def _aht_kolonu(df, aht):
    """aht: sayı | {saat: aht} | DataFrame(data_date, interval, aht) → Series."""
    if isinstance(aht, pd.DataFrame):
        d = df[['data_date', 'interval']].merge(aht, on=['data_date', 'interval'],
                                                how='left')
        return d['aht'].fillna(float(aht['aht'].mean())).values
    return [_aht_of(aht, s) for s in df['interval']]


def gereken_telefonda(calls, aht, hedef=SLA_HEDEF, T=SLA_SANIYE):
    """O slotta SL ≥ hedef için TELEFONDA kaç kişi gerekir (tam sayı)."""
    if calls <= 0:
        return 0
    traffic = (calls * (aht / 60.0)) / INTERVAL_MIN
    ust = math.ceil(traffic * 3) + 30
    for a in range(math.ceil(traffic), ust + 1):
        if calc_sl(a, traffic, aht, T) >= hedef:
            return a
    return ust


def _cizelge_karsiligi(telefonda, slot, shrinkage=None):
    """TELEFONDA gereken kişi → ÇİZELGEYE yazılması gereken kişi (shrinkage ters)."""
    shr_cfg = shrinkage if shrinkage is not None else KITLE_SHRINKAGE
    shr = shr_cfg.get(int(str(slot)[:2]), shr_cfg.get('default', 0.0))
    return math.ceil(telefonda / (1.0 - shr)) if shr < 1 else telefonda


def sla_slot_tablosu(df_hakem, aht, hedef=SLA_HEDEF, T=SLA_SANIYE,
                     shrinkage=None, verbose=True):
    """df_hakem → her slot için katman başına SL + kredi/borç (ÇAĞRI cinsinden).

    Eklenen kolonlar (mevcut her katman için):
        sl_<kod>     : o slotta 30 sn içinde cevaplanma oranı (0..1)
        kredi_<kod>  : çağrı × (SL − hedef)   → (+) kredi, (−) borç
    Kimlik: Σ kredi_<kod> = −AÇIK   (defter kapanır)

    ÇAĞRISI OLMAYAN slot dışarıda bırakılır — SL tanımsız, ağırlığı da 0.
    """
    df = df_hakem.copy()
    if 'actual_kitle' not in df.columns:
        raise KeyError("sla_slot_tablosu: 'actual_kitle' (gerçek çağrı) yok — "
                       "hakem_tablosu çıktısını ver.")
    df = df[pd.to_numeric(df['actual_kitle'], errors='coerce').fillna(0) > 0].copy()
    if df.empty:
        raise ValueError("Çağrısı olan slot yok — df_actual ile kesişimi kontrol et.")

    df['aht_sn'] = _aht_kolonu(df, aht)
    df['traffic'] = (df['actual_kitle'] * (df['aht_sn'] / 60.0)) / INTERVAL_MIN

    _var = []
    for kod, _et, kol in SLA_KATMANLAR:
        if kol not in df.columns:
            continue
        _var.append(kod)
        df[f'tel_{kod}'] = [_telefonda(k, s, shrinkage)
                            for k, s in zip(df[kol], df['interval'])]
        df[f'sl_{kod}'] = [calc_sl(a, t, h, T) for a, t, h
                           in zip(df[f'tel_{kod}'], df['traffic'], df['aht_sn'])]
        df[f'kredi_{kod}'] = df['actual_kitle'] * (df[f'sl_{kod}'] - hedef)
    if verbose:
        _eks = [e for k, e, c in SLA_KATMANLAR if k not in _var]
        print(f"SLA slot tablosu: {len(df):,} slot (çağrısı olan), "
              f"{df['data_date'].nunique()} gün  |  katman: {_var}")
        if _eks:
            print(f"  ℹ girdisi olmayan katman (atlandı): {_eks}")
    return df


def sla_defteri(df_sla, hedef=SLA_HEDEF, T=SLA_SANIYE, verbose=True):
    """[BÖLÜM 1] AYLIK DEFTER — katman başına tek satır, ÇAĞRI cinsinden."""
    C = float(df_sla['actual_kitle'].sum())
    HEDEF = hedef * C
    satir = []
    for kod, et, kol in SLA_KATMANLAR:
        if f'sl_{kod}' not in df_sla.columns:
            satir.append({'katman': et, 'telefonda_ort': None, 'aylik_SL': None,
                          'cevaplanan': None, 'hedef': round(HEDEF),
                          'ACIK_cagri': None, 'durum': '— girdi yok'})
            continue
        A = float((df_sla['actual_kitle'] * df_sla[f'sl_{kod}']).sum())
        acik = HEDEF - A
        satir.append({
            'katman': et,
            'telefonda_ort': round(df_sla[f'tel_{kod}'].mean(), 1),
            'aylik_SL': round(100 * A / C, 2),
            'cevaplanan': round(A),
            'hedef': round(HEDEF),
            'ACIK_cagri': round(acik),
            'durum': '✓ TUTUYOR' if acik <= 0 else '⚠ AÇIK',
        })
    out = pd.DataFrame(satir)
    if verbose:
        print(f"\n[1] AYLIK SLA DEFTERİ  (hedef %{hedef*100:.0f} / {T} sn)")
        print(f"    toplam çağrı (C)          : {C:>12,.0f}")
        print(f"    hedef 30sn-içi ({hedef:.2f}×C) : {HEDEF:>12,.0f}")
        print(f"    → AÇIK = hedef − cevaplanan  (≤0 ise hedef tutuyor)")
        show(out)
        print(f"    NOT: SL, TELEFONDA olan kişiden hesaplanıyor "
              f"(shrinkage düşülmüş). Çizelgedeki kişi daha yüksek.")
    return out


def sla_kredi_borc(df_sla, katman='model2', hedef=SLA_HEDEF, verbose=True):
    """[BÖLÜM 2] Hangi slotlar ödüyor, hangileri yiyor — ÇAĞRI cinsinden.

    Kimlik: KREDİ + BORÇ = −AÇIK. Bol slottaki fazlalık dar slottaki açığı öder;
    bu yüzden slot bazlı %80 aramak GEREKSİZ.
    """
    kol = f'sl_{katman}'
    if kol not in df_sla.columns:
        print(f"  ℹ katman '{katman}' yok — atlandı.")
        return None
    ust = df_sla[df_sla[kol] >= hedef]
    alt = df_sla[df_sla[kol] < hedef]
    kredi = float(ust[f'kredi_{katman}'].sum())
    borc = float(alt[f'kredi_{katman}'].sum())          # negatif
    kadrosuz = df_sla[df_sla[f'tel_{katman}'] <= 0]
    out = pd.DataFrame([
        {'grup': f'SL ≥ %{hedef*100:.0f}', 'slot': len(ust),
         'cagri': round(ust['actual_kitle'].sum()), 'katki_cagri': round(kredi)},
        {'grup': f'SL < %{hedef*100:.0f}', 'slot': len(alt),
         'cagri': round(alt['actual_kitle'].sum()), 'katki_cagri': round(borc)},
        {'grup': 'NET', 'slot': len(df_sla),
         'cagri': round(df_sla['actual_kitle'].sum()),
         'katki_cagri': round(kredi + borc)},
    ])
    if verbose:
        print(f"\n[2] KREDİ / BORÇ  — katman '{katman}'")
        show(out)
        print(f"    NET katkı = −AÇIK  (defter kapanıyor)")
        if len(kadrosuz):
            print(f"    ⚠ ÇAĞRI VAR AMA KADRO YOK: {len(kadrosuz)} slot, "
                  f"{int(kadrosuz['actual_kitle'].sum()):,} çağrı → SAF BORÇ "
                  f"({round(float(kadrosuz[f'kredi_{katman}'].sum())):,})")
            print(f"      (gece dilimleri; borcun bu kısmı kadro ekleyerek değil "
                  f"vardiya AÇARAK kapanır)")
    return out


def sla_en_borclu(df_sla, katman='model2', n=15, verbose=True):
    """[BÖLÜM 3] En çok borç yazan slotlar — aylık açığın nereden geldiği."""
    kol = f'kredi_{katman}'
    if kol not in df_sla.columns:
        print(f"  ℹ katman '{katman}' yok — atlandı.")
        return None
    _, _, kisi_kol = next(k for k in SLA_KATMANLAR if k[0] == katman)
    out = (df_sla.nsmallest(n, kol)[
        ['data_date', 'interval', 'actual_kitle', kisi_kol,
         f'tel_{katman}', f'sl_{katman}', kol]].copy())
    out[f'sl_{katman}'] = (100 * out[f'sl_{katman}']).round(1)
    out[f'tel_{katman}'] = out[f'tel_{katman}'].round(1)
    out[kol] = out[kol].round(0)
    out = out.rename(columns={'actual_kitle': 'cagri', kisi_kol: 'cizelgede',
                              f'tel_{katman}': 'telefonda',
                              f'sl_{katman}': 'SL_%', kol: 'borc_cagri'})
    if verbose:
        print(f"\n[3] EN ÇOK BORÇ YAZAN {n} SLOT — katman '{katman}'")
        show(out)
    return out


def sla_marjinal(df_sla, katman='model2', n=15, hedef=SLA_HEDEF,
                 shrinkage=None, T=SLA_SANIYE, verbose=True):
    """[BÖLÜM 4] +1 KİŞİ NEREYE? — marjinal kazanç ÇAĞRI cinsinden.

        kazanc_i = çağrı_i × [ SL_i(kişi+1) − SL_i(kişi) ]

    200 çağrılı slotta +1 kişi, 20 çağrılı slotta +1 kişiden 10 KAT fazla
    aylık SL satın alır. Model-1 bu sayıyı hiç bilmiyor — erlang_need her
    slota bağımsız bakıyor, HACMİ hiç tartmıyor.
    """
    if f'sl_{katman}' not in df_sla.columns:
        print(f"  ℹ katman '{katman}' yok — atlandı.")
        return None
    _, _, kisi_kol = next(k for k in SLA_KATMANLAR if k[0] == katman)
    d = df_sla.copy()
    d['sl_art1'] = [calc_sl(_telefonda(k + 1, s, shrinkage), t, h, T)
                    for k, s, t, h in zip(d[kisi_kol], d['interval'],
                                          d['traffic'], d['aht_sn'])]
    d['kazanc_cagri'] = d['actual_kitle'] * (d['sl_art1'] - d[f'sl_{katman}'])

    # ── KRİTİK slot: telefonda ≤ trafik → kuyruk PATLIYOR, SL≈0.
    # Burada +1 kişi HİÇBİR ŞEY kazandırmaz (0 → 0) → saf marjinal sıralama bu
    # slotları EN SONA atar, oysa aylık açığın büyük kısmı buradan gelir.
    # Bu yüzden ayrı listelenir ve "kaç kişi gerekir" hesaplanır.
    d['kritik'] = d[f'tel_{katman}'] <= d['traffic']
    d['gereken_tel'] = [gereken_telefonda(c, h, hedef, T)
                        for c, h in zip(d['actual_kitle'], d['aht_sn'])]
    d['gereken_cizelge'] = [_cizelge_karsiligi(g, s, shrinkage)
                            for g, s in zip(d['gereken_tel'], d['interval'])]
    d['eksik_kisi'] = (d['gereken_cizelge'] - d[kisi_kol]).clip(lower=0)
    # o slotu hedefe çekmenin TAM kazancı (kısmi değil)
    d['tam_kazanc_cagri'] = d['actual_kitle'] * (hedef - d[f'sl_{katman}'])

    C = float(d['actual_kitle'].sum())
    A = float((d['actual_kitle'] * d[f'sl_{katman}']).sum())
    acik0 = hedef * C - A

    _kr = d[d['kritik']]
    if verbose and len(_kr):
        _o = _kr.nlargest(n, 'tam_kazanc_cagri')[
            ['data_date', 'interval', 'actual_kitle', kisi_kol,
             f'tel_{katman}', 'traffic', 'gereken_cizelge', 'eksik_kisi',
             'tam_kazanc_cagri']].copy()
        _o[f'tel_{katman}'] = _o[f'tel_{katman}'].round(1)
        _o['traffic'] = _o['traffic'].round(1)
        _o['tam_kazanc_cagri'] = _o['tam_kazanc_cagri'].round(0)
        _o = _o.rename(columns={'actual_kitle': 'cagri', kisi_kol: 'cizelgede',
                                f'tel_{katman}': 'telefonda',
                                'traffic': 'trafik',
                                'gereken_cizelge': 'gereken',
                                'eksik_kisi': '+kisi',
                                'tam_kazanc_cagri': 'kazanc_cagri'})
        print(f"\n[4a] ⚠ KRİTİK SLOTLAR — telefonda ≤ trafik, kuyruk PATLIYOR "
              f"(SL≈0)")
        print(f"     Burada +1 kişi işe YARAMAZ; '+kisi' kadar eklemek gerekir.")
        show(_o)
        print(f"     kritik slot: {len(_kr)}  |  "
              f"çağrı {int(_kr['actual_kitle'].sum()):,}  |  "
              f"toplam kazanç potansiyeli "
              f"{float(_kr['tam_kazanc_cagri'].sum()):,.0f} çağrı  "
              f"(AÇIK'ın %{100*float(_kr['tam_kazanc_cagri'].sum())/max(1,acik0):.0f}'i)")
        print(f"     gereken toplam ek kişi-slot: {int(_kr['eksik_kisi'].sum()):,}")

    d = d[~d['kritik']]                     # marjinal sıralama SADECE kalanlar
    if d.empty:
        if verbose:
            print(f"\n[4b] +1 KİŞİ NEREYE: kritik olmayan slot yok — "
                  f"önce [4a]'yı kapat.")
        return None
    ilk = d.nlargest(n, 'kazanc_cagri')
    kum = float(ilk['kazanc_cagri'].sum())

    out = ilk[['data_date', 'interval', 'actual_kitle', kisi_kol,
               f'sl_{katman}', 'sl_art1', 'kazanc_cagri']].copy()
    out[f'sl_{katman}'] = (100 * out[f'sl_{katman}']).round(1)
    out['sl_art1'] = (100 * out['sl_art1']).round(1)
    out['kazanc_cagri'] = out['kazanc_cagri'].round(1)
    out = out.rename(columns={'actual_kitle': 'cagri', kisi_kol: 'kisi',
                              f'sl_{katman}': 'SL_%', 'sl_art1': 'SL+1_%'})
    if verbose:
        print(f"\n[4b] +1 KİŞİ NEREYE?  — katman '{katman}' "
              f"(marjinal kazanç; kritik slotlar HARİÇ)")
        show(out)
        print(f"    bu {n} slota +1 kişi → kazanç {kum:,.0f} çağrı  |  "
              f"AÇIK {acik0:,.0f} → {acik0 - kum:,.0f}")
        if acik0 - kum <= 0:
            print(f"    ✓ bu {n} slot aylık hedefi TUTTURMAYA YETER")
        else:
            print(f"    ⚠ yetmez — aynı mantıkla listeyi uzat (n'i büyüt)")
    return out


def sla_saat_bazinda(df_sla, katman='model2', verbose=True):
    """Saat bazında toplu görünüm — hangi saat dilimi borcu taşıyor."""
    if f'sl_{katman}' not in df_sla.columns:
        return None
    g = df_sla.groupby(df_sla['interval'].str[:2]).apply(
        lambda x: pd.Series({
            'slot': len(x),
            'cagri': round(x['actual_kitle'].sum()),
            'SL_%': round(100 * (x['actual_kitle'] * x[f'sl_{katman}']).sum()
                          / max(1.0, x['actual_kitle'].sum()), 1),
            'katki_cagri': round(x[f'kredi_{katman}'].sum()),
        }), include_groups=False).reset_index(names='saat')
    if verbose:
        print(f"\n[5] SAAT BAZINDA — katman '{katman}'")
        show(g)
    return g

