DEFAULT_PLAN_AGG_COLS = {
    'date':  ['data_date', 'date', 'tarih'],
    'shift': ['vardiya', 'shift'],
    'group': ['working_main_group', 'company', 'line_based_main_group'],
    'kisi':  ['kisi_sayisi', 'kisi', 'count', 'adet'],
}


def _company_from_group(s):
    """'outsource' → outsource, geri kalan her şey (izmir_kitle, gebze_kitle…)
    → inhouse."""
    v = s.astype(str).str.strip().str.lower()
    return v.map(lambda x: 'outsource' if 'outsource' in x else 'inhouse')


def build_plan_coverage_kitle(df_plan, year=2026, month=8, plan_cols=None,
                              verbose=True):
    """Vardiya bazlı plan tablosunu slot ızgarasına açar (tamamı kitle).

    Girdi: DATA_DATE, VARDIYA, WORKING_MAIN_GROUP, KISI_SAYISI
    Çıktı: data_date, interval, plan_in, plan_out, plan_toplam
    """
    cols = {**DEFAULT_PLAN_AGG_COLS, **(plan_cols or {})}
    resolved = {k: _resolve_col(df_plan, v) for k, v in cols.items()}
    eksik = [cols[k] for k, v in resolved.items() if v is None]
    if eksik:
        raise KeyError(f"PLAN: şu kolon(lar) yok: {eksik}  |  "
                       f"mevcut: {list(df_plan.columns)}")

    df = df_plan.copy()
    df['data_date'] = _to_date_series(df[resolved['date']]).dt.normalize()
    df['company'] = _company_from_group(df[resolved['group']])
    df['kisi'] = pd.to_numeric(df[resolved['kisi']], errors='coerce').fillna(0)

    n0 = len(df)
    df = df[(df['data_date'].dt.year == year) & (df['data_date'].dt.month == month)]
    if verbose and len(df) < n0:
        print(f"  ℹ PLAN: {n0 - len(df):,} satır {year}/{month:02d} dışında, elendi.")

    slot_map = {v: shift_slots(v) for v in df[resolved['shift']].astype(str).unique()}
    cozulmeyen = [v for v, s in slot_map.items() if not s]
    if cozulmeyen:
        print(f"  ⚠ PLAN: vardiya olarak okunamayan {len(cozulmeyen)} değer "
              f"(kapsamaya girmedi): {cozulmeyen[:8]}")

    df['slot_30'] = df[resolved['shift']].astype(str).map(slot_map)
    df = df.explode('slot_30').dropna(subset=['slot_30'])

    agg = (df.groupby(['data_date', 'slot_30', 'company'])['kisi']
             .sum().reset_index())

    first = pd.Timestamp(year=year, month=month, day=1)
    all_days = pd.date_range(first, first + pd.offsets.MonthEnd(1), freq='D')
    out = pd.MultiIndex.from_product(
        [all_days, SLOTS_30], names=['data_date', 'slot_30']).to_frame(index=False)

    for comp, kol in (('inhouse', 'plan_in'), ('outsource', 'plan_out')):
        sub = agg[agg['company'] == comp][['data_date', 'slot_30', 'kisi']]
        out = out.merge(sub.rename(columns={'kisi': kol}),
                        on=['data_date', 'slot_30'], how='left')

    out[['plan_in', 'plan_out']] = out[['plan_in', 'plan_out']].fillna(0).round().astype(int)
    out['plan_toplam'] = out['plan_in'] + out['plan_out']
    out['interval'] = out['slot_30']
    out = out.sort_values(['data_date', 'slot_30']).reset_index(drop=True)
    out = out[['data_date', 'interval', 'plan_in', 'plan_out', 'plan_toplam']]

    if verbose:
        gunler = df['data_date'].nunique()
        print(f"PLAN (kitle) — {gunler}/{len(all_days)} gün  |  tepe: "
              f"inhouse={int(out['plan_in'].max())} "
              f"outsource={int(out['plan_out'].max())}")
    return out


def compare_kitle(df_plan_cov, df_model_cov, only_plan_days=True, verbose=True):
    """Kitle için slot bazlı model ↔ plan karşılaştırması.

    fark = plan - model  (eksi: modelin dediğinden az kişi konmuş)
    only_plan_days: planda hiç kişi olmayan günleri tablodan çıkarır.
    """
    df = df_model_cov[['data_date', 'interval', 'model_in_kitle',
                       'model_out_kitle']].merge(
        df_plan_cov, on=['data_date', 'interval'], how='outer')

    df = df.rename(columns={'model_in_kitle': 'model_in',
                            'model_out_kitle': 'model_out'})
    for c in ('model_in', 'model_out', 'plan_in', 'plan_out'):
        df[c] = df[c].fillna(0).astype(int)
    df['model_toplam'] = df['model_in'] + df['model_out']
    df['plan_toplam'] = df['plan_in'] + df['plan_out']

    if only_plan_days:
        gunluk = df.groupby('data_date')['plan_toplam'].sum()
        bos = list(gunluk[gunluk == 0].index)
        if bos:
            df = df[~df['data_date'].isin(bos)]
            if verbose:
                print(f"  ℹ planda kişi olmayan {len(bos)} gün "
                      f"(karşılaştırmaya alınmadı): "
                      f"{', '.join(d.strftime('%d.%m.%Y') for d in bos)}")

    df['fark_in'] = df['plan_in'] - df['model_in']
    df['fark_out'] = df['plan_out'] - df['model_out']
    df['fark_toplam'] = df['plan_toplam'] - df['model_toplam']

    df = df.sort_values(['data_date', 'interval']).reset_index(drop=True)
    df = df[['data_date', 'interval',
             'model_in', 'plan_in', 'fark_in',
             'model_out', 'plan_out', 'fark_out',
             'model_toplam', 'plan_toplam', 'fark_toplam']]

    if verbose:
        satirlar = []
        for etiket, mo, pl, fa in (
                ('inhouse', 'model_in', 'plan_in', 'fark_in'),
                ('outsource', 'model_out', 'plan_out', 'fark_out'),
                ('toplam', 'model_toplam', 'plan_toplam', 'fark_toplam')):
            aktif = df[mo] > 0
            satirlar.append({
                'kesim': etiket,
                'model_kisi_slot': int(df[mo].sum()),
                'plan_kisi_slot': int(df[pl].sum()),
                'fark': int(df[fa].sum()),
                'eksik_slot': int((df[fa][aktif] < 0).sum()),
                'fazla_slot': int((df[fa][aktif] > 0).sum()),
            })
        print("KİTLE — MODEL ↔ PLAN  (fark = plan - model)")
        show(pd.DataFrame(satirlar))
    return df


def kitle_gunluk(df_cmp):
    """Slot tablosunu gün bazına toplar (kişi-slot)."""
    cols = ['model_in', 'plan_in', 'fark_in', 'model_out', 'plan_out', 'fark_out',
            'model_toplam', 'plan_toplam', 'fark_toplam']
    d = df_cmp.groupby('data_date', as_index=False)[cols].sum()
    d['gun'] = pd.to_datetime(d['data_date']).dt.weekday.map(
        lambda i: ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'][i])
