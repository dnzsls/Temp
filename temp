def fark_tablosu(df_plan, df_model, min_kapasite=5):
    """Fark haritasının sayısal hali: slot × gün tipi."""
    import numpy as np
    a = df_plan.rename(columns={'kapasite_toplam': 'plan_kisi'})
    b = df_model.rename(columns={'kapasite_toplam': 'model_kisi'})
    m = a[['data_date', 'hafta_sonu', 'interval', 'plan_kisi', 'cagri']].merge(
        b[['data_date', 'interval', 'model_kisi']],
        on=['data_date', 'interval'], how='inner')
    g = m.groupby(['hafta_sonu', 'interval'], as_index=False).agg(
        plan_kisi=('plan_kisi', 'mean'), model_kisi=('model_kisi', 'mean'),
        cagri=('cagri', 'mean'))
    g['fark_kisi'] = (g['model_kisi'] - g['plan_kisi']).round(1)
    g['gun_tipi'] = np.where(g['hafta_sonu'] == 1, 'hafta sonu', 'hafta içi')
    g[['plan_kisi', 'model_kisi', 'cagri']] = g[['plan_kisi', 'model_kisi', 'cagri']].round(1)
    return g[['gun_tipi', 'interval', 'cagri', 'plan_kisi', 'model_kisi', 'fark_kisi']]


def tablo_ayni_mi(df_a, df_b, ad_a='A', ad_b='B', tolerans=0):
    """İki genel_bakis tablosu birebir aynı mı — farkları döker."""
    anahtar = ['data_date', 'interval']
    kol = [k for k in OLCU_KOL + ['cagri'] if k in df_a and k in df_b]
    m = df_a[anahtar + kol].merge(df_b[anahtar + kol], on=anahtar,
                                  suffixes=(f'_{ad_a}', f'_{ad_b}'), how='outer')
    sonuc = []
    for k in kol:
        a, b = m[f"{k}_{ad_a}"].fillna(0), m[f"{k}_{ad_b}"].fillna(0)
        d = (b - a)
        sapan = int((d.abs() > tolerans).sum())
        sonuc.append({'kolon': k, 'sapan_slot': sapan,
                      f'{ad_a}_toplam': int(a.sum()), f'{ad_b}_toplam': int(b.sum()),
                      'fark_toplam': int(d.sum()),
                      'maks_mutlak_fark': float(d.abs().max())})
    out = pd.DataFrame(sonuc)
    ayni = int(out['sapan_slot'].sum()) == 0
    print(f"{'✓ BİREBİR AYNI' if ayni else '⚠ FARK VAR'} — {ad_a} vs {ad_b} "
          f"({len(m):,} gün×slot karşılaştırıldı)")
    return out


def slot_yan_yana(hafta_sonu=0, olcu='ortalama', **tablolar):
    """Verilen tabloların slot profillerini tek tabloda yan yana koyar.

    Örn: slot_yan_yana(0, plan=df_genel, kismili=df_genel_kismili)
    """
    birlesik = None
    for ad, df in tablolar.items():
        g = slot_ozet(df, hafta_sonu=hafta_sonu, olcu=olcu)
        if g.empty:
            continue
        alt = g[['interval', 'kapasite_toplam', 'baslangic_toplam', 'cagri']].rename(
            columns={'kapasite_toplam': f'{ad}_kapasite',
                     'baslangic_toplam': f'{ad}_baslangic',
                     'cagri': f'{ad}_cagri'})
        birlesik = alt if birlesik is None else birlesik.merge(alt, on='interval')
    adlar = list(tablolar)
    if birlesik is not None and len(adlar) == 2:
        a, b = adlar
        birlesik[f'fark_{b}_eksi_{a}'] = (birlesik[f'{b}_kapasite']
                                          - birlesik[f'{a}_kapasite']).round(1)
    return birlesik


def gunluk_kadro(df_vardiya, results, df_actual, year, month, queue='kitle',
                 model_year=None, model_month=None,
                 cols=None, verbose=True):
    """Gün gün tek tablo: gerçekleşen çağrı + model kişi + plan kişi.

    Birim KİŞİ (kişi-slot değil): o gün kaç kişi vardiyaya yazılmış.
      model_* ← mip_info['total_inhouse_kisi' | 'total_outsource_kisi'
                         | 'total_part_time_kisi']
      plan_*  ← df_vardiya KISI_SAYISI toplamı; kısmiler working_main_group
                'kismi/part' üzerinden plan_pt kolonuna ayrılır

    model_year/month verilmezse year/month kullanılır (pickle farklı aya
    aitse ikisini ayrı ver).
    """
    my = model_year if model_year is not None else year
    mm = model_month if model_month is not None else month

    # --- PLAN ---
    c = {**VARDIYA_KOL, **(cols or {})}
    r = {k: _resolve_col(df_vardiya, v) for k, v in c.items()}
    eksik = [c[k] for k, v in r.items() if v is None]
    if eksik:
        raise KeyError(f"VARDİYA: kolon yok: {eksik}")

    p = df_vardiya.copy()
    p['data_date'] = _to_date_series(p[r['date']]).dt.normalize()
    p['kisi'] = pd.to_numeric(p[r['kisi']], errors='coerce').fillna(0)
    p['sirket'] = _company(p[r['group']])          # kismi/part → part_time
    p = p[(p['data_date'].dt.year == year) & (p['data_date'].dt.month == month)]
    plan = p.pivot_table(index='data_date', columns='sirket', values='kisi',
                         aggfunc='sum', fill_value=0)
    plan = plan.rename(columns={'inhouse': 'plan_in', 'outsource': 'plan_out',
                                'part_time': 'plan_pt'})
    for k in ('plan_in', 'plan_out', 'plan_pt'):
        if k not in plan:
            plan[k] = 0
    plan['plan_toplam'] = plan[['plan_in', 'plan_out', 'plan_pt']].sum(axis=1)

    # --- MODEL ---
    sat = []
    for ds, day in (results or {}).items():
        d = pd.to_datetime(ds).normalize()
        if d.year != my or d.month != mm:
            continue
        q = (day or {}).get(queue)
        mi = (q or {}).get('mip_info', {}) or {}
        sat.append({'data_date': d,
                    'model_in': mi.get('total_inhouse_kisi', 0),
                    'model_out': mi.get('total_outsource_kisi', 0),
                    'model_pt': mi.get('total_part_time_kisi', 0),
                    'model_total_kisi': mi.get('total_kisi', 0),
                    'model_infeasible': int(q is None or not q)})
    model = pd.DataFrame(sat).set_index('data_date') if sat else pd.DataFrame()
    if len(model):
        # total_inhouse_kisi / _outsource_ / _part_time_ AYRIK kümeler
        # (weekend_forecast_final.py: in_shifts pt eklenmeden ÖNCE kuruluyor,
        #  total = total_in + total_out + total_pt). Çıkarma YAPILMAZ.
        model['model_toplam'] = model[['model_in', 'model_out', 'model_pt']].sum(axis=1)
        if 'model_total_kisi' in model:
            sapan = model[model['model_total_kisi'] != model['model_toplam']]
            if len(sapan):
                print(f"  ⚠ {len(sapan)} günde in+out+pt ≠ total_kisi "
                      f"(ilk: {sapan.index[0]:%d.%m}) — pickle şeması değişmiş olabilir.")

    # --- ÇAĞRI ---
    cg = cagri_tablosu(df_actual, year, month, queue=queue, cols=cols, verbose=False)
    cagri = cg.groupby('data_date')['cagri'].sum().rename('cagri')

    # --- BİRLEŞTİR ---
    ay_bas = pd.Timestamp(year=year, month=month, day=1)
    gunler = pd.date_range(ay_bas, ay_bas + pd.offsets.MonthEnd(1), freq='D')
    out = pd.DataFrame(index=gunler)
    out.index.name = 'data_date'
    for parca in (cagri, model, plan):
        if len(parca):
            out = out.join(parca)

    out = out.reset_index()
    out['gun'] = out['data_date'].dt.weekday.map(lambda i: GUN_TR[i])
    out['hafta_sonu'] = (out['data_date'].dt.weekday >= 5).astype(int)
    sayisal = [k for k in ('cagri', 'model_in', 'model_out', 'model_pt',
                           'model_toplam', 'plan_in', 'plan_out', 'plan_pt',
                           'plan_toplam') if k in out]
    out[sayisal] = out[sayisal].fillna(0).round().astype(int)
    out['fark_toplam'] = out.get('model_toplam', 0) - out.get('plan_toplam', 0)
    out['cagri_kisi'] = (out['cagri'] / out['plan_toplam'].replace(0, pd.NA)).round(1)

    kol = (['data_date', 'gun', 'hafta_sonu', 'cagri']
           + [k for k in ('model_in', 'model_out', 'model_pt', 'model_toplam',
                          'plan_in', 'plan_out', 'plan_pt', 'plan_toplam',
                          'fark_toplam', 'cagri_kisi') if k in out])
    out = out[kol]

    if verbose:
        eksik_gun = out[(out['plan_toplam'] == 0) | (out['model_toplam'] == 0)]
        if len(eksik_gun):
            print(f"  ⚠ {len(eksik_gun)} günde plan veya model 0: "
                  f"{', '.join(eksik_gun['data_date'].dt.strftime('%d.%m'))}")
        for hs, ad in ((0, 'hafta içi'), (1, 'hafta sonu')):
            a = out[out['hafta_sonu'] == hs]
            if len(a):
                print(f"  {ad:<10} ort. çağrı {a['cagri'].mean():>8,.0f}  |  "
                      f"model {a['model_toplam'].mean():>6.1f} kişi  |  "
                      f"plan {a['plan_toplam'].mean():>6.1f} kişi  |  "
                      f"fark {a['fark_toplam'].mean():>+6.1f}")
    return out


# ---------------------------------------------------------------------------
# ERLANG-C İHTİYACI (monthly run ile aynı ayarlar)
# ---------------------------------------------------------------------------

TARGET_ASA = 30              # hedef ortalama cevaplama süresi (sn)
INTERVAL_MIN = 30            # slot uzunluğu (dk)
KITLE_SHRINKAGE = {          # CONFIG_WEEKDAY['queue_configs']['kitle']['erlang']
    0: 0.07, 1: 0.07, 2: 0.07, 3: 0.07, 4: 0.07, 5: 0.07, 6: 0.07,
    7: 0.07, 8: 0.07, 9: 0.24, 10: 0.17, 11: 0.17, 12: 0.16,
    13: 0.19, 14: 0.21, 15: 0.25, 16: 0.26, 17: 0.29, 18: 0.18,
    19: 0.17, 20: 0.18, 21: 0.14, 22: 0.13, 23: 0.19, 'default': 0.0,
}

SQ_KOL = {
    'date':      ['data_date', 'date', 'tarih'],
    'time':      ['min_time_period_value', 'interval', 'saat_dilimi'],
    'sub_queue': ['resource_group_key', 'sub_queue', 'alt_kuyruk'],
    'calls':     ['nof_call', 'calls', 'cagri', 'call_count'],
    'group':     ['line_based_main_group'],
}


def _erlang_c(agents, traffic):
    if agents <= traffic or agents == 0:
        return 1.0
    eb = traffic / agents
    for i in range(2, int(agents) + 1):
        eb = (traffic * eb) / (i + traffic * eb)
    return min(eb / (1 - (traffic / agents) * (1 - eb)), 1.0)


def _asa(agents, traffic, aht):
    if agents <= traffic or agents == 0:
        return 999
    return (_erlang_c(agents, traffic) * (aht / 60)) / (agents - traffic) * 60


def gerekli_kisi(calls, aht, slot, shrinkage=None, target_asa=TARGET_ASA):
    """Bir slot için Erlang-C ihtiyacı (shrinkage uygulanmış)."""
    if calls <= 0 or aht <= 0:
        return 0
    traffic = (calls * (aht / 60)) / INTERVAL_MIN
    if traffic == 0:
        return 0
    ham = math.ceil(traffic * 3) + 10
    for a in range(math.ceil(traffic), ham + 1):
        if _asa(a, traffic, aht) <= target_asa:
            ham = a
            break
    shr_cfg = shrinkage if shrinkage is not None else KITLE_SHRINKAGE
    shr = shr_cfg.get(int(slot[:2]), shr_cfg.get('default', 0.0))
    return math.ceil(ham / (1 - shr))


def aht_slot_bazli(df_actual_sq, df_aht, queue='kitle', sq_cols=None, verbose=True):
    """Her (gün × slot) için alt-kuyruk çağrı payına göre AĞIRLIKLI AHT.

    Modelin calculate_weighted_aht'i ile aynı:
        aht_slot = Σ(çağrı_sq × aht_sq) / Σ(çağrı_sq)

    df_actual_sq : uzun format actual — data_date, min_time_period_value,
                   resource_group_key, line_based_main_group, nof_call
    df_aht       : saat, sub_queue, line_based_main_group, weighted_avg_aht

    Çıktı: data_date, interval, aht
    """
    cols = {**SQ_KOL, **(sq_cols or {})}
    d_col = _resolve_col(df_actual_sq, cols['date'])
    t_col = _resolve_col(df_actual_sq, cols['time'])
    q_col = _resolve_col(df_actual_sq, cols['sub_queue'])
    c_col = _resolve_col(df_actual_sq, cols['calls'])
    eksik = [k for k, v in (('date', d_col), ('time', t_col),
                            ('sub_queue', q_col), ('calls', c_col)) if v is None]
    if eksik:
        raise KeyError(f"ALT-KUYRUK: kolon yok: {eksik}  |  "
                       f"mevcut: {list(df_actual_sq.columns)}")

    kaynak = df_actual_sq
    g_col = _resolve_col(kaynak, cols['group'])
    if g_col is not None:
        kaynak = kaynak[kaynak[g_col].astype(str).str.strip().str.lower()
                        == f"{queue}_cagrilar"]
        if kaynak.empty:
            raise ValueError(f"ALT-KUYRUK: '{queue}_cagrilar' satırı yok.")

    d = pd.DataFrame({
        'data_date': _to_date_series(kaynak[d_col]).dt.normalize(),
        'interval': kaynak[t_col].map(_to_slot_30),
        'sub_queue': kaynak[q_col].astype(str).str.strip(),
        'calls': pd.to_numeric(kaynak[c_col], errors='coerce').fillna(0),
    })
    d['saat'] = d['interval'].str[:2].astype(int)
    d = d.groupby(['data_date', 'interval', 'saat', 'sub_queue'],
                  as_index=False)['calls'].sum()

    a = df_aht[df_aht['line_based_main_group'] == f"{queue}_cagrilar"].copy()
    if a.empty:
        raise ValueError(f"df_aht'de '{queue}_cagrilar' yok.")
    a['saat'] = a['saat'].astype(int)
    a['sub_queue'] = a['sub_queue'].astype(str).str.strip()
    a['aht'] = pd.to_numeric(a['weighted_avg_aht'], errors='coerce')

    m = d.merge(a[['saat', 'sub_queue', 'aht']], on=['saat', 'sub_queue'], how='left')
    eslesmeyen = sorted(m[m['aht'].isna()]['sub_queue'].unique())
    if eslesmeyen:
        print(f"  ⚠ df_aht'de karşılığı olmayan alt-kuyruk (atlandı): {eslesmeyen[:8]}")
    m = m.dropna(subset=['aht'])
    m = m[m['calls'] > 0]

    out = (m.assign(x=m['calls'] * m['aht'])
             .groupby(['data_date', 'interval'], as_index=False)
             .agg(x=('x', 'sum'), c=('calls', 'sum')))
    out['aht'] = (out['x'] / out['c']).round(1)
    out = out[['data_date', 'interval', 'aht']]
    if verbose:
        print(f"AHT (slot bazlı, çağrı ağırlıklı): {out['aht'].min():.0f}–"
              f"{out['aht'].max():.0f} sn  |  ortalama {out['aht'].mean():.0f} sn  |  "
              f"{len(out):,} slot")
    return out


def erlang_ekle(df, aht, shrinkage=None, verbose=True):
    """genel_bakis tablosuna 'aht' ve 'gereken_erlang' kolonlarını ekler.

    aht:
      sayı            → tüm slotlarda sabit AHT (sn)
      {saat: aht}     → saate göre
      DataFrame       → aht_slot_bazli() çıktısı (data_date, interval, aht)

    Erlang GÜN×SLOT bazında hesaplanır, ortalama sonra alınır — doğru sıra
    budur (ortalama çağrının Erlang'ı ≠ Erlang'ların ortalaması).
    """
    d = df.copy()
    if isinstance(aht, pd.DataFrame):
        d = d.merge(aht[['data_date', 'interval', 'aht']],
                    on=['data_date', 'interval'], how='left')
        bos = int(d['aht'].isna().sum())
        if bos and verbose:
            print(f"  ⚠ {bos:,} slotta AHT yok → o slotlar için Erlang 0 sayıldı.")
        d['aht'] = d['aht'].fillna(0)
    elif isinstance(aht, dict):
        d['aht'] = d['interval'].str[:2].astype(int).map(
            lambda h: aht.get(h, aht.get('default', 0)))
    else:
        d['aht'] = float(aht)

    onbellek = {}
    def _hesap(c, a, sl):
        k = (int(c), round(float(a)), sl)
        if k not in onbellek:
            onbellek[k] = gerekli_kisi(int(c), float(a), sl, shrinkage)
        return onbellek[k]

    d['gereken_erlang'] = [_hesap(c, a, sl) for c, a, sl
                           in zip(d['cagri'], d['aht'], d['interval'])]
    if verbose:
        hi = d['hafta_sonu'] == 0
        print(f"ERLANG — hafta içi tepe {int(d.loc[hi, 'gereken_erlang'].max())} kişi  |  "
              f"toplam {int(d['gereken_erlang'].sum()/2):,} kişi-saat ihtiyaç")
    return d


def ihtiyac_profili(df, hafta_sonu=0, cagri_adedi=CAGRI_ADEDI, olcu='ortalama'):
    """Slot profiline 'gereken_kisi' kolonu ekler.

    gereken_kisi = çağrı_slot ÷ (cagri_adedi / 2)
      Bir kişi saatte cagri_adedi çağrı karşılar; slot yarım saat olduğu için
      bir kişi slotta cagri_adedi/2 çağrı karşılar.
    Böylece kapasite ve ihtiyaç AYNI birime (kişi) gelir, tek eksende çizilir.
    """
    g = slot_ozet(df, hafta_sonu=hafta_sonu, olcu=olcu)
    if g.empty:
        return g
    g['gereken_kisi'] = (g['cagri'] / (cagri_adedi / 2)).round(1)

    ek = [k for k in ('gereken_erlang', 'aht') if k in df.columns]
    if ek:
        d = df if hafta_sonu is None else df[df['hafta_sonu'] == hafta_sonu]
        gb = d.groupby('interval', as_index=False)[ek]
        a = (gb.mean() if olcu == 'ortalama' else gb.median()).round(1)
        g = g.merge(a, on='interval', how='left')

    g['fark_kisi'] = (g['kapasite_toplam'] - g['gereken_kisi']).round(1)
    if 'gereken_erlang' in g:
        g['fark_erlang'] = (g['kapasite_toplam'] - g['gereken_erlang']).round(1)
    return g


def ihtiyac_ozeti(df, cagri_adedi=CAGRI_ADEDI):
    """Gün tipi × slot: kapasite, gereken kişi, fark, karşılama oranı."""
    import numpy as np
    parca = []
    for hs, ad in ((0, 'hafta içi'), (1, 'hafta sonu')):
        g = ihtiyac_profili(df, hafta_sonu=hs, cagri_adedi=cagri_adedi)
        if g.empty:
            continue
        kol = ['interval', 'kapasite_toplam', 'cagri', 'gereken_kisi', 'fark_kisi']
        kol += [k for k in ('aht', 'gereken_erlang', 'fark_erlang') if k in g]
        g = g[kol]
        g.insert(0, 'gun_tipi', ad)
        parca.append(g)
    if not parca:
        return pd.DataFrame()
    out = pd.concat(parca, ignore_index=True)
    out['karsilama'] = (out['kapasite_toplam']
                        / out['gereken_kisi'].replace(0, np.nan)).round(2)
    if 'gereken_erlang' in out:
        out['karsilama_erlang'] = (out['kapasite_toplam']
                                   / out['gereken_erlang'].replace(0, np.nan)).round(2)
    return out


def grafik_ihtiyac(df_plan, df_model, queue='KİTLE', cagri_adedi=CAGRI_ADEDI,
                   olcu='ortalama', yontem='kapasite', y_adim=50, kaydet=None):
    """TEK EKSEN: kapasite vs gereken kişi. Sağ eksen YOK.

    Üst satır PLAN, alt satır MODEL. Sol sütun hafta içi, sağ sütun hafta sonu.
    Çağrı 'gereken kişi'ye çevrilir (çağrı ÷ (cagri_adedi/2)) — iki çizgi aynı
    birimde olur, kesişmeleri gerçek anlam taşır:
      MAVİ alan    → kapasite ihtiyacın ÜSTÜNDE (fazla)
      KIRMIZI alan → kapasite ihtiyacın ALTINDA (eksik)

    yontem:
      'kapasite' → ihtiyaç = çağrı ÷ (cagri_adedi/2)   [15 çağrı/saat kuralı]
      'erlang'   → ihtiyaç = Erlang-C (erlang_ekle ile hesaplanmış olmalı)
      'ikisi'    → alanlar Erlang'a göre, 15 kuralı ince gri çizgi olarak da
                   gösterilir

    İnhouse/outsource kırılımı YOK — sadece toplam kapasite ve +/− alanları.
    """
    import matplotlib.pyplot as plt
    import numpy as np

    kaynaklar = [('PLAN', df_plan), ('MODEL', df_model)]
    veri = {(ad, hs): ihtiyac_profili(d, hs, cagri_adedi, olcu)
            for ad, d in kaynaklar for hs in (0, 1)}
    dolu = [g for g in veri.values() if not g.empty]
    if not dolu:
        raise ValueError("Çizilecek veri yok.")
    if yontem in ('erlang', 'ikisi') and 'gereken_erlang' not in dolu[0]:
        raise ValueError("'gereken_erlang' kolonu yok — önce erlang_ekle() çalıştır.")
    ana_kol = 'gereken_kisi' if yontem == 'kapasite' else 'gereken_erlang'
    ana_ad = (f'Gereken kişi ({cagri_adedi} çağrı/saat)' if yontem == 'kapasite'
              else f'Gereken kişi (Erlang-C, ASA≤{TARGET_ASA}sn)')
    y_max = max(max(g['kapasite_toplam'].max(),
                    max(g[k].max() for k in ('gereken_kisi', 'gereken_erlang')
                        if k in g))
                for g in dolu) * 1.28          # kutulara tepede yer bırak

    fig, axes = plt.subplots(2, 2, figsize=(16, 10), sharex=True, sharey=True)
    fig.patch.set_facecolor(RENK['yuzey'])

    for i, (ad, _) in enumerate(kaynaklar):
        for j, (hs, gun_ad) in enumerate([(0, 'HAFTA İÇİ'), (1, 'HAFTA SONU')]):
            ax = axes[i][j]
            g = veri[(ad, hs)]
            if g.empty:
                ax.set_visible(False)
                continue
            x = np.arange(len(g))
            kap = g['kapasite_toplam'].values
            ger = g[ana_kol].values

            # TABAN — karşılanan ihtiyaç (ihtiyaç çizgisinin altı)
            ax.fill_between(x, 0, ger, color=RENK['karsilanan'], alpha=0.55,
                            zorder=1, label='Karşılanan ihtiyaç')
            # FAZLA / EKSİK — ihtiyaç ile kapasite arasındaki bant
            ax.fill_between(x, ger, kap, where=(kap >= ger), interpolate=True,
                            color=RENK['fazla'], zorder=2, label='FAZLA kapasite')
            ax.fill_between(x, ger, kap, where=(kap < ger), interpolate=True,
                            color=RENK['eksik'], alpha=0.85, zorder=3,
                            label='EKSİK kapasite')

            ax.plot(x, kap, color=RENK['kapasite'], lw=2.4, zorder=4,
                    label='Kapasite (sahadaki kişi)')
            ax.plot(x, ger, color=RENK['metin'], lw=2.0, ls='--', zorder=5,
                    label=ana_ad)
            if yontem == 'ikisi':
                ax.plot(x, g['gereken_kisi'].values, color=RENK['metin2'],
                        lw=1.3, ls=':', zorder=5,
                        label=f'Gereken kişi ({cagri_adedi} çağrı/saat)')

            ax.set_ylabel('kişi', fontsize=9, color=RENK['metin2'])
            ax.set_title(f"{ad} — {gun_ad}{_kismi_notu(g)}", fontsize=11,
                         fontweight='bold', color=RENK['metin'], loc='left', pad=8)
            _eksen(ax, g, y_adim=y_adim)
            ax.set_ylim(0, y_max)

            fazla = float(np.clip(kap - ger, 0, None).sum()) / 2      # kişi-saat
            eksik = float(np.clip(ger - kap, 0, None).sum()) / 2
            oran = kap.sum() / ger.sum() if ger.sum() else float('nan')
            i_dip = int(np.argmin(kap - ger))
            _kutu(ax, f"Karşılama {oran:.0%}\n"
                      f"fazla {fazla:,.0f} · eksik {eksik:,.0f} kişi-saat\n"
                      f"en dar slot {g['interval'].iloc[i_dip]} "
                      f"({kap[i_dip] - ger[i_dip]:+.0f} kişi)",
                  konum=(0.98, 0.97))

            if i == 0 and j == 0:
                ax.legend(loc='upper left', frameon=False, fontsize=8,
                          labelcolor=RENK['metin2'])

    yontem_ad = {'kapasite': f'{cagri_adedi} çağrı/saat kuralı',
                 'erlang': f'Erlang-C · ASA≤{TARGET_ASA}sn · shrinkage dahil',
                 'ikisi': f'Erlang-C (alan) + {cagri_adedi} çağrı/saat (nokta)'}[yontem]
    fig.suptitle(f"{queue} — kapasite vs gereken kişi  ({yontem_ad})",
                 fontsize=13, fontweight='bold', color=RENK['metin'],
                 x=0.01, ha='left', y=0.995)
    fig.tight_layout(rect=(0, 0, 1, 0.97))
    if kaydet:
        fig.savefig(kaydet, dpi=150, facecolor=fig.get_facecolor())
        print(f"✓ {kaydet}")
    return fig


