# roster_2 SONUNA özet kolonlar: çalışma / mesai / norm / resmi_tatil / off (AY BAZLI)
#   W = hafta içi (tatil-dışı) çalışma, E = hafta sonu (tatil-dışı) çalışma,
#   kota = H17'nin kota_map değeri (ayın iş günü − hafta içi izin).
#   mesai_gun       = max(0, (W+E) − kota)          → kotayı aşan gün (RESMİ TATİL HARİÇ)
#   norm_gun        = min(E, max(0, kota − W))      → hafta içi off yerine hafta sonu (takas)
#   resmi_tatil_gun = resmi tatilde çalışılan gün (mesaiden AYRI)
#   calisma_gun     = toplam − mesai − resmi_tatil (normal + arife + norm)
#   off_gun         = SADECE modelin verdiği off (izin/off_t/off_t2 ayrı kolonlarda)
#   mesai_gun artık H17'nin MAX_MESAI'siyle AYNI ölçü → rapor ile kısıt çelişmez.
_gun = [c for c in roster.columns if c != "takim"]                 # tarih kolonları
_OFF_ONLY = ["off", "off_t", "off_t2"]                             # off türleri (model off + blok off_t/off_t2)
_OFF_LIKE = _OFF_ONLY + ["izin"]                                   # çalışma-dışı tüm hücreler (off + izin)
# NOT: eski hafta-bazlı kırılım (_hafta: wd/we/tat/wtatil) kaldırıldı — mesai/norm
# artık AY bazlı hesaplanıyor, ISO hafta ayrımına ihtiyaç kalmadı.

# AY BAZLI mesai/norm — ölçü H17'nin kotasıyla BİREBİR aynı:
#   mesai = max(0, (hafta içi + hafta sonu çalışma) − kota)     ← H17: çalışma ≤ kota+MAX_MESAI
#   norm  = min(hafta sonu çalışma, max(0, kota − hafta içi))   ← hafta içi off ↔ hafta sonu takası
#
# NEDEN DEĞİŞTİ — eskiden HAFTA bazlıydı: her ISO haftası kendi içinde kapanıyor,
# eşiğin ALTINDA kalan hafta fazla haftayı telafi etmiyordu (max(0,…) negatifi kesiyor).
# Sonuç: aynı agentta rapor mesai_gun=3 derken H17 net 1 mesai görüyordu → "MAX_MESAI=2
# iken 3 mesai yazmış, kural ihlal edilmiş" yanılgısı. Artık tek ölçü.
#   Ör. 3 hafta 6 gün (Cmt 8 / Pzr 16 / Cmt 22) + 1 hafta 4 gün + 31 Ağu off = 22 gün,
#       kota 21 → mesai 1 (3 değil), norm 2. Ayın sonundaki iki off, önceki haftaların
#       hafta sonu çalışmasının borcunu kapatıyor ("borç kapatma" ay içinde geçerli).
#
# ÖNCEKİ AYDAN TEK İSTİSNA — SINIR HAFTASI ALACAĞI (onceki_eksik, H8C):
# Sınır ISO haftasının hafta içi günleri önceki ayda, hafta sonu günleri BU ayda.
# O haftada hafta içi off almışsa (ör. 4 gün çalışma + 1 off), haftanın 5. günü
# bu ayın hafta sonuna düşer → MESAİ değil NORM. Alacak ancak o gün fiilen
# çalışıldıysa kullanılır ve sınır haftasının bu aya düşen gün sayısıyla tavanlı.
# Daha geriye BAKILMAZ (önceki ayın diğer haftaları hesaba girmez; veri de
# her zaman tüm ayı içermiyor). H17'nin tavanı da aynı alacağı taşır → tutarlı.
# Bunun dışında her ayın kendi kotası geçerlidir. (Taşımanın diğer kullanımları —
# H12 7 gün, H15 11 saat, H16C haftalık tavan, H20B off dengesi, H20E mesai
# eşiği — aynen duruyor.) Resmi tatilde çalışma ikisinin de dışında, ayrı sayaçta.
_norm_say  = {}                                    # agent → kaç hafta sonu günü NORM (H29 rengi okur)
_kredi_say = {}                                    # agent → sınır haftası alacağından FİİLEN kullanılan
_SINIR_HS = [c for c in _gun                       # sınır haftasının BU AYA düşen (tatil-dışı) günleri
             if dt.date.fromisoformat(c).isocalendar()[:2] == SINIR_HAFTA
             and dt.date.fromisoformat(c) not in TATIL]


def _mesai_norm_say(a):
    W = E = rtatil = 0                              # hafta içi / hafta sonu / resmi tatil çalışması
    for c in _gun:
        if roster.at[a, c] in _OFF_LIKE:
            continue                                # off / off_t / off_t2 / izin → çalışma değil
        d = dt.date.fromisoformat(c)
        if d in TATIL:
            rtatil += 1                             # resmi tatilde çalışma → mesaiden AYRI
        elif d.weekday() >= 5:
            E += 1
        else:
            W += 1
    kota = kota_map.get(a)                          # H17'nin GERÇEK kotası (yeniden hesaplanmaz)
    if kota is None:                                # H17 kısıt koymadı (kota=0 / değişkensiz agent)
        _norm_say[a] = _kredi_say[a] = 0
        return 0, 0, rtatil
    # SINIR HAFTASI ALACAĞI (H8C/H17 ile AYNI ifade): önceki ayın son haftasında
    # hafta içi off almışsa, bu ayın sınır hafta sonunda çalıştığı gün MESAİ değil
    # NORM. Alacak ancak o gün fiilen çalışıldıysa kullanılır → min(...).
    kredi = min(onceki_eksik.get(a, 0),
                sum(1 for c in _SINIR_HS if roster.at[a, c] not in _OFF_LIKE))
    mesai = max(0, (W + E) - kota - kredi)          # kotayı (+alacağı) aşan gün → MESAİ
    norm  = min(E, max(0, kota - W) + kredi)        # hafta içi eksiğini + alacağı kapatan hafta sonu → NORM
    _norm_say[a], _kredi_say[a] = norm, kredi
    return mesai, norm, rtatil


_cal_top = (~roster[_gun].isin(_OFF_LIKE)).sum(axis=1)             # toplam çalışma
_off     = (roster[_gun] == "off").sum(axis=1)                    # off_gun = SADECE modelin verdiği off
# off_t / off_t2 buraya GİRMEZ — onlar agentın TALEP ETTİĞİ off, modelin kararı değil;
# kendi kolonlarında (off_t_gun / off_t2_gun) duruyorlar. Eskiden üçü toplanıyordu ve
# "model bu kişiye kaç gün off vermiş" sorusu tablodan okunamıyordu.
# NOT: H23'ün df_ozet["off"] kolonu DEĞİŞMEDİ — orada calisma+off+izin = gün sayısı
# sağlaması var, off_t/off_t2 düşerse toplam tutmaz.
_mn = {a: _mesai_norm_say(a) for a in roster_2.index}

# ── GÜN BAZINDA ETİKET: hangi hafta sonu günü NORM (yeşil), hangisi MESAİ (sarı) ──
# TOPLAM sayı ay bazlı (_norm_say) — ama DAĞITIM hafta önceliklidir:
#   1) AYNI HAFTA takası önce: o hafta hafta içi off'u varsa, o haftanın hafta sonu
#      günü NORM sayılır ("Cuma off ↔ Cumartesi çalışma" göz önünde eşleşsin).
#   2) Artan norm hakkı (borç BAŞKA haftada kapanmış) sondan geriye dağıtılır.
# Sadece "sondan N tane" seçmek görsel olarak karıştırıyordu: aynı hafta içinde
# offu olup hafta sonu çalışan gün MESAİ, norm ise alakasız bir haftada çıkıyordu.
# Sağlama: Σ_hafta min(o hafta hafta sonu, o hafta hafta içi eksiği) ≤ ay normu
# (çünkü ay eksiği = Σ hafta eksiği) → 1. adım toplamı asla aşamaz.
_hafta_kolon = {}                                  # (yıl,hafta) → {"wd": [...], "we": [...]}
for c in _gun:
    d = dt.date.fromisoformat(c)
    if d in TATIL:
        continue                                   # resmi tatil ikisinin de dışında
    wk = d.isocalendar()[:2]
    _hafta_kolon.setdefault(wk, {"wd": [], "we": []})
    _hafta_kolon[wk]["we" if d.weekday() >= 5 else "wd"].append(c)
_hs_kolon = sorted(c for c in _gun                 # tatil-dışı hafta sonu kolonları, kronolojik
                   if dt.date.fromisoformat(c).weekday() >= 5
                   and dt.date.fromisoformat(c) not in TATIL)


def _norm_gunleri(a):
    """(NORM günleri, TELAFİ günleri) — ikisi de kotaya sayılır, ücretli mesai DEĞİL.
    NORM   = AYNI HAFTA takası (o haftanın hafta içi off'unun karşılığı)
    TELAFİ = BAŞKA HAFTADAKİ fazla off'un telafisi (aynı haftada karşılığı yok)
    """
    kalan = _norm_say.get(a, 0)
    if not kalan:
        return set(), set()
    ayni = []
    for wk in sorted(_hafta_kolon):                # 1) aynı hafta takası → NORM
        h = _hafta_kolon[wk]
        T = sum(1 for c in h["wd"] if roster.at[a, c] != "izin")        # kotaya giren hafta içi gün
        W = sum(1 for c in h["wd"] if roster.at[a, c] not in _OFF_LIKE)  # o hafta çalışılan hafta içi
        we = [c for c in h["we"] if roster.at[a, c] not in _OFF_LIKE]
        eksik = max(0, T - W)                       # o haftanın hafta içi açığı
        if wk == SINIR_HAFTA:                       # sınır haftasının hafta içi günleri ÖNCEKİ AYDA →
            eksik += _kredi_say.get(a, 0)           #   açık oradan gelir (H8C alacağı)
        k = min(len(we), eksik)                     # o haftaki eksiği kapatan hafta sonu günü
        if k:
            ayni += we[-k:]
    ayni = ayni[:kalan]                             # güvenlik (teorik olarak zaten ≤ kalan)
    telafi = []
    if len(ayni) < kalan:                           # 2) borç BAŞKA haftada kapanmış → TELAFİ
        _sec = set(ayni)
        artan = [c for c in _hs_kolon
                 if roster.at[a, c] not in _OFF_LIKE and c not in _sec]
        telafi = artan[-(kalan - len(ayni)):]
    return set(ayni), set(telafi)


_norm_hucre, _telafi_hucre = set(), set()          # (agent, gün) → NORM (yeşil) / TELAFİ (açık yeşil)
for _a in roster_2.index:
    _n, _t = _norm_gunleri(_a)
    _norm_hucre |= {(_a, c) for c in _n}
    _telafi_hucre |= {(_a, c) for c in _t}
# calisma_gun = toplam − mesai − resmi_tatil (normal + arife + norm; overtime ve tatil hariç)
roster_2["calisma_gun"]     = [int(_cal_top[a]) - _mn[a][0] - _mn[a][2] for a in roster_2.index]
roster_2["mesai_gun"]       = [_mn[a][0] for a in roster_2.index]     # resmi tatil HARİÇ
roster_2["norm_gun"]        = [_mn[a][1] for a in roster_2.index]
roster_2["resmi_tatil_gun"] = [_mn[a][2] for a in roster_2.index]     # resmi tatilde çalışma
roster_2["off_gun"]         = [int(_off[a]) for a in roster_2.index]

# OFF/İZİN KIRILIMI — dört kolon, HER BİRİ AYRIK (üst üste binmiyor):
#   off_gun          = SADECE modelin verdiği off (talep edilmemiş)
#   izin_gun         = yıllık/idari izin (kotayı DÜŞÜRÜR, model değiştiremez)
#   off_t2_gun       = SERT off talebi — bloklu, her zaman karşılanır
#   off_t_gun        = YUMUŞAK off talebi, KARŞILANAN (o gün off verildi)
#   off_t_verilemeyen= YUMUŞAK off talebi, KARŞILANMAYAN → agent o gün ÇALIŞTI
#                      (Excel'de KIRMIZI hücre; W_OFF_T cezası ödendi)
# Sağlama-1: off_t_gun + off_t_verilemeyen = agentın toplam off_t talebi.
# Sağlama-2: off_gun + izin_gun + off_t2_gun + off_t_gun + calisma_gun + mesai_gun
#            + resmi_tatil_gun = ayın gün sayısı  (verilemeyen off_t zaten çalışma
#            günü olarak sayılıyor, iki kez toplanmasın).
roster_2["izin_gun"]          = [int((roster.loc[a, _gun] == "izin").sum())
                                 for a in roster_2.index]
roster_2["off_t2_gun"]        = [int((roster.loc[a, _gun] == "off_t2").sum())
                                 for a in roster_2.index]
roster_2["off_t_gun"]         = [int((roster.loc[a, _gun] == "off_t").sum())
                                 for a in roster_2.index]
from collections import Counter as _Counter22             # hücre tek başına da koşsun
_offt_yok = _Counter22(a for a, _ds in offt_karsilanmadi)  # agent → karşılanmayan off_t
roster_2["off_t_verilemeyen"] = [_offt_yok.get(a, 0) for a in roster_2.index]

# ÖNCEKİ AY (H8C) — sınır ISO haftasının ÖNCEKİ AYA düşen günleri (ör. 07-27..07-31):
# o günlerde kaç gün çalışmış / off / izin / off_t. Haftalık kuralların (H20B off
# dengesi, H20E mesai eşiği, H22 mesai/norm) gördüğü sayılar birebir bunlar →
# "08-01 neden mesai / neden off" sorusunun cevabı bu 4 kolonda.
# NOT: kayan 7 günlük pencere (H12) 6 gün geriye bakar (07-26 dahil) → o kısıt
#      bu kolonlarda GÖRÜNMEZ; burası ISO haftası, kolonlar 5 günü toplar.
# Tabloda olmayan agent (yeni başlayan vb.) → BOŞ; 0 ile karışmasın.
if TASIMA_GUNLER and onceki_calisti:
    roster_2["onceki_calisma_gun"] = [onceki_gun.get(a)  for a in roster_2.index]
    roster_2["onceki_off_gun"]     = [onceki_off.get(a)  for a in roster_2.index]
    roster_2["onceki_izin_gun"]    = [onceki_izin.get(a) for a in roster_2.index]
    roster_2["onceki_offt_gun"]    = [onceki_offt.get(a) for a in roster_2.index]
    _bilinmeyen = sum(1 for a in roster_2.index if a not in onceki_calisti)
    print(f"önceki ay kolonları: {TASIMA_GUNLER[0]}..{TASIMA_GUNLER[-1]} "
          f"({len(TASIMA_GUNLER)} gün) → calisma/off/izin/offt  |  "
          f"veri olmayan agent: {_bilinmeyen} (boş bırakıldı)")

print(f"\nroster_2: {roster_2.shape[0]} agent × {roster_2.shape[1]} kolon "
      f"(takim + 3 flag + gün + calisma/mesai/norm/resmi_tatil/off + önceki ay özet)")
print(roster_2.head(15))


# %% [HÜCRE 23] — AGENT ÖZET (çalışma / off / izin gün sayısı) ──────────
# roster hücreleri "izin" / "off" / saat → her agent için say.
gun_kolon = [c for c in roster.columns if c != "takim"]
_off_only = ["off", "off_t", "off_t2"]                                  # off + blok (kota nötr) → off sütunu
df_ozet = pd.DataFrame({
    "takim":   roster["takim"],
    "calisma": (~roster[gun_kolon].isin(_off_only + ["izin"])).sum(axis=1),  # saat = çalışma
    "off":     (roster[gun_kolon].isin(_off_only)).sum(axis=1),
    "izin":    (roster[gun_kolon] == "izin").sum(axis=1),
})
df_ozet["toplam"] = df_ozet[["calisma", "off", "izin"]].sum(axis=1)     # = gün sayısı (sağlama)
print(f"agent özet: {len(df_ozet)} agent (toplam {len(gun_kolon)} gün/agent olmalı)")
print(df_ozet.head(15))

# df_ozet_fark: df_ozet'e DOKUNMADAN ayrı df — çalışması H17'deki [kota, ust]
# aralığı DIŞINDA kalan agentlar (kotanın altında EKSİK / tavanın üstünde AŞAN).
# kota/ust YENİDEN HESAPLANMAZ → H17'nin kota_map/ust_map'inden okunur → rapor
# her zaman modelle birebir (sapma/hayali aşım olmaz). H17 sert kısıt olduğundan
# normalde hepsi aralıkta; bu sadece sağlama.
_fark = []
for a in df_ozet.index:
    if a not in kota_map:                            # H17'de kısıt konmadı (kota=0/değişkensiz)
        continue
    kota, ust = kota_map[a], ust_map[a]              # modelin GERÇEK değerleri
    c = int(df_ozet.loc[a, "calisma"])
    if c < kota:
        durum = f"EKSİK -{kota - c}"
    elif c > ust:
        durum = f"AŞAN +{c - ust}"
    else:
        continue                                     # aralıkta → uyumlu
    _fark.append({"agent": a, "takim": df_ozet.loc[a, "takim"],
                  "calisma": c, "kota": kota, "ust": ust, "durum": durum})

df_ozet_fark = pd.DataFrame(_fark)
if len(df_ozet_fark):
    print(f"\n⚠ df_ozet_fark: {len(df_ozet_fark)} agent [kota, ust] aralığı DIŞINDA:")
    print(df_ozet_fark.to_string(index=False))
else:
    print("\n✓ df_ozet_fark boş — tüm agentlar kota aralığında (uyumsuz yok)")


# %% [HÜCRE 24] — TAKIM BAZLI DAĞILIM (günlük takım → vardiya) ─────────
# Bir takım o gün hangi vardiya(lar)da, kaç kişi. Bölünme buradan görünür.
df_sonuc["takim"] = df_sonuc["agent"].map(agent_takim)

# takım × gün × saat → kaç kişi (sadece çalışanlar)
df_takim = (df_sonuc.groupby(["takim", "tarih", "saat"]).size()
