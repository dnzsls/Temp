def gun_tipi(tarih):
    wd = pd.Timestamp(tarih).weekday()
    return 'hafta_ici' if wd < 5 else ('cumartesi' if wd == 5 else 'pazar')


def ihtiyac_v10(calls, aht, slot, shrinkage):
    """find_optimal_agents (v10) ile BİREBİR: ASA ≤ 30 sn için telefonda
    gereken kişi → ceil(ham / (1 − shrinkage)) = çizelgedeki kişi."""
    if calls <= 0 or aht <= 0:
        return 0
    traffic = (calls * (aht / 60)) / INTERVAL_MIN
    if traffic == 0:
        return 0
    ham = math.ceil(traffic * 3) + 10
    for a in range(math.ceil(traffic), ham + 1):
        if _asa(a, traffic, aht) <= TARGET_ASA:
            ham = a
            break
    shr = shrinkage.get(int(slot[:2]), shrinkage.get('default', 0.10))
    return math.ceil(ham / (1 - shr))


def _slot_sozluk(d):
    """Pickle sözlüğünün slot anahtarlarını '09:00' biçimine getirir."""
    return {_to_slot_30(k): v for k, v in (d or {}).items()}


