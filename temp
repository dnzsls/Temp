# ── GÜN KATEGORİSİ: norm / telafi / mesai (Sheet2 + Sheet3 ortak) ─────
# LEJANT'taki renklerle ve H31'in _mesai_mi() fonksiyonuyla BİREBİR aynı kural.
# Ayrı ayrı yazılırsa Excel'deki renk ile buradaki sayı zamanla ayrışır.
#   norm   = hafta sonu çalışma, AYNI HAFTA hafta içi off'unun karşılığı
#            → kota İÇİNDE, ücretli mesai DEĞİL
#   telafi = hafta sonu çalışma, BAŞKA haftadaki fazla off'un telafisi
#            → o da ücretli mesai DEĞİL
#   mesai  = ÜCRETLİ mesai — üç kaynak birden:
#              hafta sonu (norm/telafi olmayan) + resmi tatilde çalışma
#              + arife tam gün (kısıtlı OLMAYAN agent; kısıtlının 9-13'ü mesai değil)
#   normal = sıradan hafta içi çalışma
def _gun_kat29(a, ds):
    """(agent, gün) → 'norm' | 'telafi' | 'mesai' | 'normal'"""
    d = dt.date.fromisoformat(ds)
    if d in TATIL:                                   # LEJANT: RESMİ TATİL MESAİ
        return "mesai"
    if d in ARIFE and a not in arife_kisitli:        # LEJANT: ARİFE MESAİ
        return "mesai"
    if d.weekday() < 5:
        return "normal"
    if (a, ds) in _norm_hucre:                       # H22'de hesaplandı
        return "norm"
    if (a, ds) in _telafi_hucre:
        return "telafi"
    return "mesai"


# Sheet2 verisi: (gün, vardiya) → planlanan talep vs gerçekleşen atama
# (ARIFE_YARIM talep'te olmadığı için otomatik hariç → sadece gerçek kovalar)
# norm/telafi/mesai kolonları: O KOVAYA atanan kişiler arasındaki kırılım.
# Hafta içi kovalarda üçü de 0 çıkar (norm/mesai hafta sonu kavramı) — resmi
# tatil ve arife günleri istisna, orada hafta içi kovada da mesai görünür.
