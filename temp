            rr = f"{m/e:.0%}" if e > 0 else "-"; pk = "*" if slot in peak_slots else " "
            print(f"   {slot}{pk:<2} {w:>5.0f} {e:>7} {m:>7} {mi:>5} {mo:>5} {rr:>6} {m-e:>+5}")

