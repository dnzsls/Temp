def kapasite_pickle(results, year, month, queue='kitle', verbose=True):
    """Model-1 (MIP) pickle'ı → gün × slot kapasite + vardiya başlangıcı.

    kapasite  ← mip_in_by_slot / mip_out_by_slot      (mip_pt_by_slot OKUNMAZ)
    başlangıç ← assignments + shift_coverage (part_time vardiyaları atlanır)
    Slotlar pickle'da nasıl yazılmışsa öyle alınır (kaydırma yok).
    """
    kap, bas, aylar, bos, pt_top = [], [], {}, [], 0.0
    for ds, day in (results or {}).items():
        d = pd.to_datetime(ds).normalize()
        aylar[(d.year, d.month)] = aylar.get((d.year, d.month), 0) + 1
        if d.year != year or d.month != month:
            continue
        r = (day or {}).get(queue)
        if not r:
            bos.append(d)
            continue
        mi = r.get('mip_info', {}) or {}
        inn = mi.get('mip_in_by_slot', {}) or {}
        out = mi.get('mip_out_by_slot', {}) or {}
        pt_top += float(sum((mi.get('mip_pt_by_slot', {}) or {}).values()))
        if not inn and not out:
            inn = dict(mi.get('mip_by_slot', {}) or {})
        for sl in set(inn) | set(out):
            s30 = _to_slot_30(sl)
            kap.append((d, s30, 'inhouse', inn.get(sl, 0)))
            kap.append((d, s30, 'outsource', out.get(sl, 0)))
        sc = mi.get('shift_coverage', {}) or {}
        for sh, adet in (mi.get('assignments', {}) or {}).items():
            if not adet or adet <= 0:
                continue
            bilgi = sc.get(sh, {}) or {}
            sirket = _sirket_tek(bilgi.get('company'))
            if sirket == 'part_time':
                continue
            b0 = bilgi.get('start') or shift_baslangic(sh)
            if b0:
                bas.append((d, _to_slot_30(b0), sirket, adet))

    if not kap:
        liste = ', '.join(f"{y}/{m:02d} ({n} gün)" for (y, m), n in sorted(aylar.items()))
        raise ValueError(f"df_model1 (pickle) içinde {year}/{month:02d} '{queue}' yok. "
                         f"Pickle'daki aylar: {liste or '—'}")
    kol = ['data_date', 'interval', 'sirket', 'kisi']
    out = _kap_izgara(_ay_gunleri(year, month), pd.DataFrame(kap, columns=kol),
                      pd.DataFrame(bas, columns=kol))
    if verbose:
        dolu = int((out.groupby('data_date')['kapasite_toplam'].sum() > 0).sum())
        print(f"    → {dolu}/{len(_ay_gunleri(year, month))} gün planlı  |  tepe kapasite "
              f"in {int(out['kapasite_in'].max())} · out {int(out['kapasite_out'].max())}"
              + (f"  |  kısmi HARİÇ ({pt_top:,.0f} kişi-slot okunmadı)" if pt_top else ""))
        if bos:
            print(f"    ⚠ sonucu olmayan {len(bos)} gün: "
                  f"{', '.join(x.strftime('%d.%m') for x in bos[:10])}")
    return out


def kapasite_model2(df_model2, kap_m1, year, month, queue='kitle', verbose=True):
    """Bizim Model-2 → gün × slot kapasite.

    inhouse   ← agent_cov paketi (sahada = atanan + arife) ya da agent tablosu
    outsource ← Model-1'in outsource'u (Model-2 outsource'u kişiye dağıtmıyor)
    başlangıç ← paketteki agent_plan'dan (vardiya başlangıç saatleri)
    """
    gunler = _ay_gunleri(year, month)
    cov = model2_coverage(df_model2, year=year, month=month, queue=queue, verbose=False)
    k_in = cov.rename(columns={'model2_in': 'kisi'}).assign(sirket='inhouse')

    plan = df_model2.get('agent_plan') if isinstance(df_model2, dict) else df_model2
    b_in = pd.DataFrame(columns=['data_date', 'interval', 'sirket', 'kisi'])
    if isinstance(plan, pd.DataFrame):
        d_col = _resolve_col(plan, VARDIYA_KOL['date'])
        v_col = _vardiya_kolonu(plan)
        if d_col and v_col:
            p = pd.DataFrame({
                'data_date': _to_date_series(plan[d_col]).dt.normalize(),
                'interval': plan[v_col].map(shift_baslangic)}).dropna(subset=['interval'])
            p = p[(p['data_date'] >= gunler[0]) & (p['data_date'] <= gunler[-1])]
            b_in = (p.groupby(['data_date', 'interval'], as_index=False).size()
                     .rename(columns={'size': 'kisi'}).assign(sirket='inhouse'))

    m1 = kap_m1[['data_date', 'interval', 'kapasite_out', 'baslangic_out']]
    k_out = m1.rename(columns={'kapasite_out': 'kisi'}).assign(sirket='outsource')
    b_out = m1.rename(columns={'baslangic_out': 'kisi'}).assign(sirket='outsource')
    kol = ['data_date', 'interval', 'sirket', 'kisi']
    out = _kap_izgara(gunler, pd.concat([k_in[kol], k_out[kol]]),
                      pd.concat([b_in[kol], b_out[kol]]))
    if verbose:
        g = out.groupby('data_date')['kapasite_in'].sum()
        bos = list(g[g == 0].index)
        print(f"    → {len(gunler) - len(bos)}/{len(gunler)} gün inhouse atamalı  |  tepe "
              f"in {int(out['kapasite_in'].max())} · out {int(out['kapasite_out'].max())} "
              f"(outsource Model-1'den)")
        if bos:
            print(f"    ⚠ inhouse ataması olmayan {len(bos)} gün: "
                  f"{', '.join(x.strftime('%d.%m') for x in bos[:10])}")
    return out


