def model_vardiya_tablosu(results, year, month, queue='kitle', verbose=True):
    """Monthly run pickle'ından df_vardiya ile AYNI şemada tablo üretir.

    Kaynak: results[tarih][queue]['mip_info']
      kapasite  ← mip_in_by_slot / mip_out_by_slot / mip_pt_by_slot
      başlangıç ← assignments + shift_coverage['start'|'company']

    ÖNEMLİ: mip_in_by_slot part_time'ı İÇERMEZ (weekend modelinde in_shifts
    yalnız company==inhouse). Kısmiler ayrı 'mip_pt_by_slot' sözlüğünde ve
    burada kapasite_pt kolonuna yazılır. Hafta içi pipeline'da bu anahtar
    yoktur → kapasite_pt 0 kalır.

    NOT: outsource +30 dk kuralı burada UYGULANMAZ — modelin kendi vardiya
    tanımları pickle'da zaten yerleşik.

    Çıktı: data_date, interval,
           kapasite_in, kapasite_out, kapasite_toplam,
           baslangic_in, baslangic_out, baslangic_toplam
    """
    def _sirket(ad):
        ad = str(ad or 'inhouse').lower()
        if 'outsource' in ad:
            return 'outsource'
        if 'part' in ad:
            return 'part_time'
        return 'inhouse'

    kap, bas, aylar = [], [], set()
    infeasible, kacaklar = [], []
    for date_str, day in (results or {}).items():
        d = pd.to_datetime(date_str).normalize()
        aylar.add((d.year, d.month))
        if d.year != year or d.month != month:
            continue
        r = (day or {}).get(queue)
        if not r:
            infeasible.append(d)
            continue
        mi = r.get('mip_info', {}) or {}

        inn = mi.get('mip_in_by_slot', {}) or {}
        out = mi.get('mip_out_by_slot', {}) or {}
        pt = mi.get('mip_pt_by_slot', {}) or {}
        tot = mi.get('mip_by_slot', {}) or {}
        if not inn and not out:
            inn = dict(tot)
        for slot in set(inn) | set(out) | set(pt):
            kap.append({'data_date': d, 'interval': _to_slot_30(slot),
                        'kapasite_in': inn.get(slot, 0),
                        'kapasite_out': out.get(slot, 0),
                        'kapasite_pt': pt.get(slot, 0)})
        if tot:                                   # in+out+pt = toplam mı?
            kacak = sum(tot.get(sl, 0) - inn.get(sl, 0) - out.get(sl, 0) - pt.get(sl, 0)
                        for sl in tot)
            if kacak:
                kacaklar.append((d, kacak))

        sc = mi.get('shift_coverage', {}) or {}
        for sh, adet in (mi.get('assignments', {}) or {}).items():
            if not adet or adet <= 0:
                continue
            bilgi = sc.get(sh, {}) or {}
            baslangic = bilgi.get('start') or shift_baslangic(sh)
            if not baslangic:
                continue
            sirket = _sirket(bilgi.get('company'))
            bas.append({'data_date': d, 'interval': _to_slot_30(baslangic),
                        'sirket': sirket, 'kisi': adet})

    if not kap:
        raise ValueError(
            f"pickle'da {year}/{month:02d} için '{queue}' sonucu yok. "
            f"İçindeki aylar: {sorted(aylar)} — MODEL_YEAR/MODEL_MONTH'u düzelt.")

    ay_bas = pd.Timestamp(year=year, month=month, day=1)
    gunler = pd.date_range(ay_bas, ay_bas + pd.offsets.MonthEnd(1), freq='D')
    out_df = pd.MultiIndex.from_product([gunler, SLOTS_30],
                                        names=['data_date', 'interval']).to_frame(index=False)

    k = pd.DataFrame(kap).groupby(['data_date', 'interval'], as_index=False).sum()
    out_df = out_df.merge(k, on=['data_date', 'interval'], how='left')

    if bas:
        b = pd.DataFrame(bas).groupby(['data_date', 'interval', 'sirket'],
                                      as_index=False)['kisi'].sum()
        for sirket, sonek in SIRKETLER:
            alt = b[b['sirket'] == sirket][['data_date', 'interval', 'kisi']]
            out_df = out_df.merge(alt.rename(columns={'kisi': f"baslangic_{sonek}"}),
                                  on=['data_date', 'interval'], how='left')
    else:
        for _, sonek in SIRKETLER:
            out_df[f"baslangic_{sonek}"] = 0
        if verbose:
            print("  ⚠ pickle'da 'assignments' yok — vardiya başlangıcı 0 kalacak.")

    deger = [f"{o}_{s}" for o in ('kapasite', 'baslangic') for _, s in SIRKETLER]
    for kol in deger:
        if kol not in out_df:
            out_df[kol] = 0
    out_df[deger] = out_df[deger].fillna(0).round().astype(int)
    out_df['kapasite_toplam'] = out_df[[f"kapasite_{s}" for _, s in SIRKETLER]].sum(axis=1)
    out_df['baslangic_toplam'] = out_df[[f"baslangic_{s}" for _, s in SIRKETLER]].sum(axis=1)
    out_df = out_df.sort_values(['data_date', 'interval']).reset_index(drop=True)

    if verbose:
        dolu = (out_df.groupby('data_date')['kapasite_toplam'].sum() > 0).sum()
        pt_gun = (out_df.groupby('data_date')['kapasite_pt'].sum() > 0).sum()
        print(f"MODEL ({queue}) — {dolu}/{len(gunler)} gün planlı  |  "
              f"tepe kapasite: inhouse {int(out_df['kapasite_in'].max())} "
              f"outsource {int(out_df['kapasite_out'].max())} "
              f"kısmi {int(out_df['kapasite_pt'].max())} ({pt_gun} günde)  |  "
              f"tepe başlangıç: {int(out_df['baslangic_toplam'].max())} kişi")
        if kacaklar:
            print(f"  ⚠ {len(kacaklar)} günde in+out+pt ≠ mip_by_slot "
                  f"(ilk: {kacaklar[0][0]:%d.%m}, fark {kacaklar[0][1]}) — "
                  f"bilinmeyen bir company türü olabilir.")
        if infeasible:
            print(f"  ⚠ planı olmayan/INFEASIBLE {len(infeasible)} gün: "
                  f"{', '.join(d.strftime('%d.%m') for d in infeasible[:8])}")
    return out_df


def _yogunluk_pivot(df, min_kapasite=5):
    import numpy as np
    d = df.copy()
    ks = d['kapasite_toplam'] / 2
    d['_y'] = d['cagri'] / ks.replace(0, np.nan)
    d.loc[d['kapasite_toplam'] < min_kapasite, '_y'] = np.nan
    return d.pivot_table(index='data_date', columns='interval', values='_y',
                         aggfunc='mean').reindex(columns=SLOTS_30)


def grafik_fark_haritasi(df_plan, df_model, queue='KİTLE', olcu='kisi',
                         min_kapasite=5, kaydet=None):
    """Gün × slot: MODEL − PLAN farkı.

    olcu='kisi'     → kapasite farkı (kişi). Kırmızı = model daha çok kişi
                      koymuş, Mavi = model daha az kişi koymuş.
    olcu='yogunluk' → çağrı/kişi-saat farkı. Kırmızı = model daha sıkışık,
                      Mavi = model daha rahat. (Ölçülemeyen slotlar gri.)

    İki tablo da genel_bakis() çıktısı olmalı; ortak gün/slotlar kesişir.
    """
    import matplotlib.pyplot as plt
    import numpy as np
    from matplotlib.colors import TwoSlopeNorm

    if olcu == 'kisi':
        pa = df_plan.pivot_table(index='data_date', columns='interval',
                                 values='kapasite_toplam', aggfunc='sum')
        pb = df_model.pivot_table(index='data_date', columns='interval',
                                  values='kapasite_toplam', aggfunc='sum')
        birim, baslik = 'kişi', 'kapasite farkı (kişi)'
    elif olcu == 'yogunluk':
        pa = _yogunluk_pivot(df_plan, min_kapasite)
        pb = _yogunluk_pivot(df_model, min_kapasite)
        birim, baslik = 'çağrı/kişi-saat', 'yoğunluk farkı'
    else:
        raise ValueError("olcu: 'kisi' veya 'yogunluk'")

    gunler = pa.index.intersection(pb.index)
    if not len(gunler):
        raise ValueError("Plan ve model tablolarında ortak gün yok — "
                         "MODEL_MONTH ile MONTH aynı mı?")
    pa = pa.reindex(index=gunler, columns=SLOTS_30)
    pb = pb.reindex(index=gunler, columns=SLOTS_30)
    fark = pb - pa

    gecerli = fark.values[~np.isnan(fark.values)]
    sinir = float(np.nanpercentile(np.abs(gecerli), 95)) or 1.0

    cmap = plt.get_cmap('RdBu_r').copy()
    cmap.set_bad(RENK['izgara'])

