SLOTS_30 = [f"{h:02d}:{m}" for h in range(24) for m in ('00', '30')]


SLOT_IDX = {s: i for i, s in enumerate(SLOTS_30)}


def _resolve_col(df, spec):
    """Aday kolon adlarından df'te bulunan ilkini döndürür (yoksa None).

    Önce birebir, sonra büyük/küçük harf duyarsız arar — SQL kolonları
    KISI_SAYISI gibi büyük harfle gelebiliyor.
    """
    cands = [spec] if isinstance(spec, str) else list(spec)
    for c in cands:
        if c in df.columns:
            return c
    lower = {str(c).lower(): c for c in df.columns}
    for c in cands:
        if str(c).lower() in lower:
            return lower[str(c).lower()]
    return None


# Tarih deseni — SIFIRSIZ ay/gün de kapsanıyor ({1,2}), yoksa '2026-8-1'
# ISO sayılmıyordu ve dayfirst=True'ya düşüp pandas '%Y-%d-%m' tahmin ediyordu:
#   ValueError: unconverted data remains when parsing with format "%Y-%d-%m": "3"
_ISO_RE  = r'^\s*\d{4}-\d{1,2}-\d{1,2}'          # 2026-08-01 / 2026-8-1 (+saat)


_GGAA_RE = r'^\s*\d{1,2}[./]\d{1,2}[./]\d{4}'    # 01.08.2026 / 01/08/2026


def _to_date_series(s, ad='tarih', verbose=False):
    """Tarih kolonunu güvenle datetime'a çevirir — FORMAT TAHMİN ETMEZ.

    Eski sürüm `pd.to_datetime(s, dayfirst=...)` ile pandas'ın tahminine
    güveniyordu. Sıfırsız tarihte ('2026-8-1') regex ISO'yu kaçırıyor,
    dayfirst=True'ya düşüyor ve pandas '%Y-%d-%m' (yıl-GÜN-ay) tahmin
    ediyordu → hem HATA hem (daha kötüsü) SESSİZ gün/ay TERSİ riski.
    Ölçüldü: '2026-8-1' → ValueError "unconverted data remains … '3'".

    Artık desen açıkça sınıflandırılıyor:
      ISO (yıl önce)  → format='ISO8601', tutmazsa format='mixed', dayfirst=False
      gg.aa.yyyy      → format='mixed', dayfirst=True
      karışık         → format='mixed', dayfirst = ISO hiç yoksa True
    Çözümlenemeyen satır SESSİZ GEÇMEZ — örnekle birlikte hata verir; tarih
    yanlış okunursa bütün ay/slot eşlemesi kayar, sessiz kalması en kötüsü.
    """
    if pd.api.types.is_datetime64_any_dtype(s):
        return pd.to_datetime(s)
    if pd.api.types.is_numeric_dtype(s):
        raise TypeError(f"{ad}: sayısal kolon tarih olarak okunamaz "
                        f"(örnek: {s.dropna().head(3).tolist()})")

    t = s.astype(str).str.strip()
    _bos = t.eq('') | t.isin(('nan', 'None', 'NaT'))
    iso = t.str.match(_ISO_RE).fillna(False)
    ggaa = t.str.match(_GGAA_RE).fillna(False)

    if (iso | _bos).all():
        out = pd.to_datetime(t, format='ISO8601', errors='coerce')
        if (out.isna() & ~_bos).any():                  # sıfırsız/karışık ISO
            out = pd.to_datetime(t, format='mixed', dayfirst=False, errors='coerce')
        yontem = 'ISO (yıl-ay-gün)'
    elif (ggaa | _bos).all():
        out = pd.to_datetime(t, format='mixed', dayfirst=True, errors='coerce')
        yontem = 'gün.ay.yıl'
    else:
        out = pd.to_datetime(t, format='mixed', dayfirst=not iso.any(),
                             errors='coerce')
        yontem = f"KARIŞIK (dayfirst={not iso.any()})"

    bad = out.isna() & ~_bos
    if bad.any():
        raise ValueError(
            f"{ad}: {int(bad.sum()):,} satırda tarih çözümlenemedi "
            f"(yöntem: {yontem}). Örnekler: {t[bad].head(5).tolist()}  |  "
            f"Kolonu önce pd.to_datetime(..., format='...') ile kendin çevirip "
            f"tekrar dene.")
    if verbose:
        print(f"  ℹ {ad}: {yontem}  |  örnek "
              f"{t[~_bos].head(3).tolist()}")
    return out


_SHIFT_RE = re.compile(r'(\d{1,2})[:.](\d{2})\s*[-–—]\s*(\d{1,2})[:.](\d{2})')


def shift_slots(text):
    """'08:00-17:00' → kapsadığı 30dk slot listesi.

    Geceyi aşan vardiyaları da doğru işler ('22:00-06:00' → 22:00…05:30).
    Vardiya metni çözümlenemezse (OFF, İZİN, boş) boş liste döner.
    """
    m = _SHIFT_RE.search(str(text))
    if not m:
        return []

    sh, sm, eh, em = (int(g) for g in m.groups())
    start = f"{sh % 24:02d}:{(sm // 30) * 30:02d}"
    end_idx_raw = (eh % 24) * 2 + (em // 30)
    if eh == 24 or (eh % 24) * 60 + em == 0:       # '…-24:00' / '…-00:00'
        end_idx_raw = len(SLOTS_30)

    i, j = SLOT_IDX[start], end_idx_raw
    if j <= i:                                     # geceyi aşıyor
        j += len(SLOTS_30)
    return [SLOTS_30[k % len(SLOTS_30)] for k in range(i, j)]


