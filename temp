    _top = 0
    for _v in _vardiya_kol:
        _b = _bu_ay_tv.get((_T, _v), 0)
        _r[_v] = "" if _b == 0 else _b
        _top += _b
    _r["kisi_gun_Σ"] = _top
    _r["vardiya_cesidi"] = sum(1 for _v in _vardiya_kol
                               if _bu_ay_tv.get((_T, _v), 0))
    _tv_satir.append(_r)
df_takim_vardiya = pd.DataFrame(_tv_satir)
if len(df_takim_vardiya):                          # en alta TOPLAM satırı
    _tr = {"takim": "— TOPLAM —", "takim_kod": "",
           "uye": int(df_takim_vardiya["uye"].sum())}
    for _v in _vardiya_kol:
        _s = sum(_n for (_T2, _v2), _n in _bu_ay_tv.items() if _v2 == _v)
        _tr[_v] = "" if _s == 0 else int(_s)
    _tr["kisi_gun_Σ"] = int(df_takim_vardiya["kisi_gun_Σ"].sum())
    _tr["vardiya_cesidi"] = len(_vardiya_kol)
    df_takim_vardiya = pd.concat(
        [df_takim_vardiya, pd.DataFrame([_tr])[df_takim_vardiya.columns]],
