def _to_slot_30(value):
    """'10:45' / '10:45:00' / time / timedelta / timestamp → '10:30'."""
    if isinstance(value, (pd.Timedelta, _dt.timedelta)):
        tm = int(pd.Timedelta(value).total_seconds() // 60) % (24 * 60)
        h, m = divmod(tm, 60)
        return f"{h:02d}:{(m // 30) * 30:02d}"
    if isinstance(value, (_dt.datetime, pd.Timestamp, _dt.time)):
        return f"{value.hour:02d}:{(value.minute // 30) * 30:02d}"
    m = re.search(r'(\d{1,2}):(\d{2})', str(value).strip())
    if not m:
        raise ValueError(f"Saat değeri çözümlenemedi: {value!r}")
    return f"{int(m.group(1)) % 24:02d}:{(int(m.group(2)) // 30) * 30:02d}"


def actual_calls_30(df_actual, year=2026, month=8, queue='kitle',
                    actual_cols=None, verbose=True):
    """Gerçekleşen 15dk çağrıları 30dk'ya toplar.

    Girdi: data_date, min_time_period_value, {queue}_nof_call
    Çıktı: data_date, interval, actual_{queue}
    """
    cols = {**DEFAULT_ACTUAL_COLS, **(actual_cols or {})}
    d_col = _resolve_col(df_actual, cols['date'])
    t_col = _resolve_col(df_actual, cols['time'])
    g_col = _resolve_col(df_actual, cols['group'])
    n_col = _resolve_col(df_actual, cols['calls'])
    c_col = _resolve_col(df_actual, cols[queue])

    uzun = g_col is not None and n_col is not None
    eksik = [k for k, v in (('date', d_col), ('time', t_col)) if v is None]
    if not uzun and c_col is None:
        eksik.append(queue)
    if eksik:
        raise KeyError(f"ACTUAL: şu alan(lar) için kolon yok: {eksik}  |  "
                       f"mevcut: {list(df_actual.columns)}")

    if uzun:                              # monthly run formatı (satır bazlı)
        df = df_actual[df_actual[g_col].astype(str).str.strip().str.lower()
                       == f"{queue}_cagrilar"]
        if df.empty:
            mevcut = sorted(df_actual[g_col].dropna().astype(str).unique())
            raise ValueError(f"ACTUAL: '{queue}_cagrilar' satırı yok. "
                             f"Mevcut: {mevcut[:10]}")
        deger = pd.to_numeric(df[n_col], errors='coerce').fillna(0)
        if verbose:
            print(f"  ℹ ACTUAL: uzun format ({g_col} = {queue}_cagrilar, "
                  f"{len(df):,} satır)")
    else:                                 # geniş format
        df = df_actual
        deger = pd.to_numeric(df[c_col], errors='coerce').fillna(0)

    out = pd.DataFrame({
        'data_date': _to_date_series(df[d_col]).dt.normalize(),
        'interval': df[t_col].map(_to_slot_30),
        f"actual_{queue}": deger.values,
    })

    bad = out['data_date'].isna() | out['interval'].isna()
    if bad.any():
        print(f"  ⚠ ACTUAL: {int(bad.sum()):,} satırda tarih/saat çözümlenemedi, "
              f"toplamdan düşüyor.")

    out = out.groupby(['data_date', 'interval'], as_index=False).sum()
    n0 = len(out)
    out = out[(out['data_date'].dt.year == year) & (out['data_date'].dt.month == month)]
    if verbose:
        print(f"ACTUAL ({queue}) — {out['data_date'].nunique()} gün, "
              f"{len(out):,} slot, toplam {int(out[f'actual_{queue}'].sum()):,} çağrı"
              + (f"  ({n0 - len(out):,} satır ay dışı, elendi)" if n0 > len(out) else ""))
    return out.sort_values(['data_date', 'interval']).reset_index(drop=True)


def aht_saatlik(df_aht, queue='kitle', df_sq_calls=None, verbose=True):
    """df_aht (saat, sub_queue, line_based_main_group, weighted_avg_aht)
    → {saat: aht} sözlüğü.

    df_sq_calls verilirse (saat × sub_queue çağrı adedi) alt-kuyruklar çağrı
    payıyla ağırlıklanır — modelin calculate_weighted_aht'i ile aynı mantık.
    Verilmezse alt-kuyrukların basit ortalaması alınır.
    """
    gerekli = ['saat', 'sub_queue', 'line_based_main_group', 'weighted_avg_aht']
    eksik = [c for c in gerekli if c not in df_aht.columns]
    if eksik:
        raise KeyError(f"df_aht'de eksik kolon: {eksik}  |  "
                       f"mevcut: {list(df_aht.columns)}")

    grup = f"{queue}_cagrilar"
    d = df_aht[df_aht['line_based_main_group'] == grup].copy()
    if d.empty:
        raise ValueError(f"df_aht'de '{grup}' yok. "
                         f"Mevcut: {sorted(df_aht['line_based_main_group'].unique())}")
    d['saat'] = d['saat'].astype(int)
    d['weighted_avg_aht'] = pd.to_numeric(d['weighted_avg_aht'], errors='coerce')

    if df_sq_calls is not None:
        w = df_sq_calls.rename(columns={c: c.lower() for c in df_sq_calls.columns})
        w['saat'] = w['saat'].astype(int)
        d = d.merge(w[['saat', 'sub_queue', 'calls']], on=['saat', 'sub_queue'],
                    how='left')
        d['calls'] = d['calls'].fillna(0)
        toplam = d.groupby('saat')['calls'].transform('sum')
        d['agirlik'] = (d['calls'] / toplam).where(toplam > 0, 1 / d.groupby('saat')['sub_queue'].transform('count'))
        saatlik = (d.assign(x=d['weighted_avg_aht'] * d['agirlik'])
                     .groupby('saat')['x'].sum().round().astype(int).to_dict())
        yontem = 'çağrı ağırlıklı'
    else:
        saatlik = d.groupby('saat')['weighted_avg_aht'].mean().round().astype(int).to_dict()
        yontem = 'alt-kuyruk basit ortalaması'

    if verbose:
        print(f"AHT ({queue}, {yontem}): "
              f"{min(saatlik.values())}–{max(saatlik.values())} sn, "
              f"{len(saatlik)} saat")
        if df_sq_calls is None:
            print("  ℹ alt-kuyruk çağrı kırılımı verilirse ağırlıklı AHT "
                  "hesaplanır (modelin yöntemi).")
    return saatlik


