def performans_tablosu(m, ihtiyac, son_gun=None, ad='MODEL', verbose=True):
    """Model tablosu + gerçekleşen ihtiyaç → gün × slot performans.

    Günler: SON_GUN'a kadar, gerçek çağrısı olan, modelde planı olan.
    RR (b): atanan kişi ÷ Erlang ihtiyacı
      RR_plan   = kap_toplam ÷ gereken_plan    (tahmin çağrısına göre)
      RR_gercek = kap_toplam ÷ gereken_gercek  (gerçek çağrıya göre)
    """
    t = m.merge(ihtiyac, on=['data_date', 'interval'], how='left')
    t[['cagri_gercek', 'gereken_gercek']] = t[['cagri_gercek', 'gereken_gercek']].fillna(0)
    gc = t.groupby('data_date')['cagri_gercek'].sum()
    gunler = set(gc[gc > 0].index)
    atilan_sg = set()
    if son_gun is not None:
        sinir = pd.Timestamp(son_gun).normalize()
        atilan_sg = {g for g in gunler if g > sinir}
        gunler -= atilan_sg
    cagrisiz = set(gc[gc <= 0].index)
    t = t[t['data_date'].isin(gunler)].copy()
    if t.empty:
        raise ValueError(f"{ad}: karşılaştırılacak gün yok (SON_GUN / çağrı verisi?).")

    t['sapma_%'] = np.where(t['cagri_gercek'] > 0,
                            100 * (t['cagri_tahmin'] - t['cagri_gercek'])
                            / t['cagri_gercek'].where(t['cagri_gercek'] > 0), np.nan)
    t['RR_plan'] = t['kap_toplam'] / t['gereken_plan'].where(t['gereken_plan'] > 0)
    t['RR_gercek'] = t['kap_toplam'] / t['gereken_gercek'].where(t['gereken_gercek'] > 0)
    t['gun'] = t['data_date'].dt.weekday.map(lambda i: GUN_TR[i])
    t['hafta_sonu'] = (t['data_date'].dt.weekday >= 5).astype(int)
    kol = ['data_date', 'gun', 'hafta_sonu', 'interval', 'cagri_tahmin', 'cagri_gercek',
           'sapma_%', 'aht_model', 'aht_gercek', 'gereken_plan', 'gereken_gercek',
           'kap_in', 'kap_out', 'kap_pt', 'kap_toplam', 'RR_plan', 'RR_gercek']
    t = t[kol].sort_values(['data_date', 'interval']).reset_index(drop=True)
    if verbose:
        tt = pd.to_datetime(t['data_date'])
        print(f"  ✓ {ad}: {tt.dt.normalize().nunique()} gün "
              f"({tt.min():%d.%m} – {tt.max():%d.%m})"
              + (f"  |  SON_GUN sonrası atılan {len(atilan_sg)} gün" if atilan_sg else "")
              + (f"  |  çağrısız atılan {len(cagrisiz)} gün" if cagrisiz else ""))
    return t


def _ozet(t):
    """Bir alt küme için özet — RR günlük/dönemlik: Σkapasite ÷ Σihtiyaç
    (ihtiyacı olan slotlar; modelin kendi gün RR'si ile aynı: Erlang ağırlıklı)."""
    gp = t[t['gereken_plan'] > 0]
    gg = t[t['gereken_gercek'] > 0]
    ct, cg = float(t['cagri_tahmin'].sum()), float(t['cagri_gercek'].sum())
    ger = float(gg['gereken_gercek'].sum())
    return {
        'cagri_tahmin': ct, 'cagri_gercek': cg,
        'sapma_%': 100 * (ct - cg) / cg if cg else np.nan,
        'RR_plan': float(gp['kap_toplam'].sum()) / float(gp['gereken_plan'].sum())
                   if len(gp) else np.nan,
        'RR_gercek': float(gg['kap_toplam'].sum()) / ger if ger else np.nan,
        'karsilanan_%': 100 * float(np.minimum(gg['kap_toplam'], gg['gereken_gercek']).sum())
                        / ger if ger else np.nan,
        'eksik_kisi_saat': float(np.clip(gg['gereken_gercek'] - gg['kap_toplam'], 0,
                                         None).sum()) / 2,
        'gun_sayisi': t['data_date'].nunique(),
    }


def _ortak(perf):
    kumeler = [set(t['data_date']) for t in perf.values()]
    return set.intersection(*kumeler) if kumeler else set()


def gun_ozeti(perf, verbose=True):
    """Gün gün + HAFTA İÇİ / HAFTA SONU / DÖNEM satırları — modeller yan yana.

    RR_plan   : tahmine göre modelin kendi RR'si
    RR_gercek : gerçek çağrıya göre
    karsilanan_%     : Σ min(kapasite, ihtiyaç) ÷ Σ ihtiyaç (fazla, eksiği kapatmaz)
    eksik_kisi_saat  : gerçek ihtiyacın altında kalan kişi-saat
    """
    kodlar = list(perf)
    ortak = sorted(_ortak(perf))
    gruplar = [(g.strftime('%d.%m'), GUN_TR[g.weekday()],
                (lambda t, g=g: t[t['data_date'] == g])) for g in ortak]
    for hs, et in ((0, 'HAFTA İÇİ'), (1, 'HAFTA SONU')):
        if any(g.weekday() >= 5 if hs else g.weekday() < 5 for g in ortak):
            gruplar.append((et, 'ort.', (lambda t, hs=hs: t[(t['hafta_sonu'] == hs)
                                                           & t['data_date'].isin(ortak)])))
    gruplar.append(('DÖNEM', 'top.', lambda t: t[t['data_date'].isin(ortak)]))

    satir = []
    for et, gun, sec in gruplar:
        b = _ozet(sec(perf[kodlar[0]]))
        bol = b['gun_sayisi'] if gun == 'ort.' else 1
        s = {'gun': et, 'gun_adi': gun,
             'cagri_tahmin': round(b['cagri_tahmin'] / bol),
             'cagri_gercek': round(b['cagri_gercek'] / bol),
             'sapma_%': round(b['sapma_%'], 1)}
        for k in kodlar:
            o = _ozet(sec(perf[k]))
            s[f'{k}_RR_plan'] = round(o['RR_plan'], 2)
            s[f'{k}_RR_gercek'] = round(o['RR_gercek'], 2)
            s[f'{k}_karsilanan_%'] = round(o['karsilanan_%'], 1)
            s[f'{k}_eksik_kisi_saat'] = round(o['eksik_kisi_saat'] / bol)
        satir.append(s)
    out = pd.DataFrame(satir)

    if verbose:
        print(f"GÜN ÖZETİ — {len(ortak)} ortak gün  "
              f"(ort. satırları gün başına; DÖNEM toplam)")
        show(out)
        d = out[out['gun'] == 'DÖNEM'].iloc[0]
        print(f"  • tahmin sapması: {d['sapma_%']:+.1f}%  (+ tahmin fazla · − tahmin az)")
        for k in kodlar:
            print(f"  • {MODEL_AD[k]}: RR plan {d[f'{k}_RR_plan']:.2f} → gerçek "
                  f"{d[f'{k}_RR_gercek']:.2f} ({d[f'{k}_RR_gercek'] - d[f'{k}_RR_plan']:+.2f})"
                  f"  ·  karşılanan ihtiyaç %{d[f'{k}_karsilanan_%']}"
                  f"  ·  eksik {d[f'{k}_eksik_kisi_saat']:,.0f} kişi-saat")
        if len(kodlar) == 2:
            print(f"  • dağıtım etkisi (M1 → M2): RR gerçek {d['M1_RR_gercek']:.2f} → "
                  f"{d['M2_RR_gercek']:.2f}  ({d['M2_RR_gercek'] - d['M1_RR_gercek']:+.2f})")
        print("  RR plan → gerçek farkı = tahmin hatası (çağrı + AHT) · "
              "M1 → M2 farkı = kişilere dağıtım")
    return out


def gun_slotlari(t, gun=None):
    """Tek günün slot slot tablosu (çağrısı ya da kapasitesi olan slotlar)."""
    g = pd.Timestamp(gun).normalize() if gun else t['data_date'].max()
    d = t[(t['data_date'] == g) & ((t['cagri_gercek'] > 0) | (t['kap_toplam'] > 0))]
    if d.empty:
        print(f"  ℹ {g:%d.%m.%Y} tabloda yok — tablodaki günler: "
              f"{t['data_date'].min():%d.%m} – {t['data_date'].max():%d.%m}")
        return d, g
    kol = ['interval', 'cagri_tahmin', 'cagri_gercek', 'sapma_%', 'gereken_plan',
           'gereken_gercek', 'kap_in', 'kap_out', 'kap_pt', 'kap_toplam',
           'RR_plan', 'RR_gercek']
    d = d[kol].copy()
    d[['cagri_tahmin', 'cagri_gercek']] = d[['cagri_tahmin', 'cagri_gercek']].round(0)
    d[['sapma_%']] = d[['sapma_%']].round(1)
    d[['RR_plan', 'RR_gercek']] = d[['RR_plan', 'RR_gercek']].round(2)
    return d.reset_index(drop=True), g


def slot_profili(perf, hafta_sonu):
    """Ortalama gün (hafta içi / hafta sonu) — slot bazında, modeller yan yana.
    RR sütunları: o slotun ay içi Σkapasite ÷ Σihtiyaç."""
    ortak = _ortak(perf)
    kodlar = list(perf)
    b = perf[kodlar[0]]
    b = b[(b['hafta_sonu'] == hafta_sonu) & b['data_date'].isin(ortak)]
    if b.empty:
        return pd.DataFrame()
    g = b.groupby('interval')[['cagri_tahmin', 'cagri_gercek',
                               'gereken_plan', 'gereken_gercek']].mean()
    for k in kodlar:
        t = perf[k]
        t = t[(t['hafta_sonu'] == hafta_sonu) & t['data_date'].isin(ortak)]
        g[f'kap_{k}'] = t.groupby('interval')['kap_toplam'].mean()
        tg = t[t['gereken_gercek'] > 0].groupby('interval')[['kap_toplam', 'gereken_gercek']].sum()
        tp = t[t['gereken_plan'] > 0].groupby('interval')[['kap_toplam', 'gereken_plan']].sum()
        g[f'RR_plan_{k}'] = tp['kap_toplam'] / tp['gereken_plan']
        g[f'RR_gercek_{k}'] = tg['kap_toplam'] / tg['gereken_gercek']
    g = g.reindex(SLOTS_30)
    yuv = {c: (2 if c.startswith('RR') else 1) for c in g.columns}
    out = g.round(yuv).reset_index().rename(columns={'index': 'interval'})
    out['gun_sayisi'] = b['data_date'].nunique()
    return out


def grafik_performans(perf, queue='KİTLE', y_adim=50, kaydet=None):
    """Üstte tahmin ↔ gerçek çağrı, altta ÜST ÜSTE: gerçek ihtiyaç (siyah kesikli),
    planlanan ihtiyaç (gri noktalı), MODEL-1 ve MODEL-2 kapasitesi. Ortalama gün."""
    import matplotlib.pyplot as plt
    veri = {hs: slot_profili(perf, hs) for hs in (0, 1)}
    dolu = [g for g in veri.values() if not g.empty]
    if not dolu:
        raise ValueError("Çizilecek veri yok.")
    kodlar = list(perf)
    kisi_max = max(max(g[['gereken_plan', 'gereken_gercek'] + [f'kap_{k}' for k in kodlar]]
                       .max()) for g in dolu) * 1.32
    cagri_max = max(max(g['cagri_tahmin'].max(), g['cagri_gercek'].max()) for g in dolu) * 1.25
    ortak = _ortak(perf)

    fig, axes = plt.subplots(2, 2, figsize=(16, 9.5), sharex='col',
                             gridspec_kw={'height_ratios': [1, 2.6]})
    fig.patch.set_facecolor(RENK['yuzey'])
    for j, (hs, ad) in enumerate([(0, 'HAFTA İÇİ'), (1, 'HAFTA SONU')]):
        g = veri[hs]
        if g.empty:
            axes[0][j].set_visible(False)
            axes[1][j].set_visible(False)
            continue
        x = np.arange(len(g))
        n_gun = int(g['gun_sayisi'].iloc[0])

        ax = axes[0][j]
        ax.fill_between(x, g['cagri_gercek'], color=RENK['cagri'], alpha=0.15, zorder=1)
        ax.plot(x, g['cagri_gercek'], color=RENK['cagri'], lw=2, zorder=3,
                label='Gerçekleşen çağrı')
        ax.plot(x, g['cagri_tahmin'], color=RENK['metin2'], lw=1.6, ls='--', zorder=4,
                label='Tahmin çağrı (Model-1 girdisi)')
        ax.set_ylabel('çağrı', fontsize=9, color=RENK['metin2'])
        ax.set_title(f"{queue} — {ad}  ({n_gun} gün ortalama)", fontsize=11,
                     fontweight='bold', color=RENK['metin'], loc='left', pad=8)
        _eksen(ax, g)
        ax.set_ylim(0, cagri_max)
        top_t, top_g = g['cagri_tahmin'].sum(), g['cagri_gercek'].sum()
        _kutu(ax, f"tahmin sapması {100 * (top_t - top_g) / top_g:+.1f}%"
              if top_g else "gerçek çağrı yok")
        if j == 0:
            ax.legend(loc='upper left', frameon=False, fontsize=8,
                      labelcolor=RENK['metin2'])

        ax = axes[1][j]
        ax.fill_between(x, 0, g['gereken_gercek'], color=RENK['karsilanan'],
                        alpha=0.8, zorder=1)
        ax.plot(x, g['gereken_gercek'], color=RENK['metin'], lw=2.2, ls='--', zorder=5,
                label=f'Gereken kişi — gerçek çağrıdan (Erlang, ASA≤{TARGET_ASA}sn)')
        ax.plot(x, g['gereken_plan'], color=RENK['metin2'], lw=1.6, ls=':', zorder=5,
                label='Gereken kişi — tahminden (planlanan)')
        satir = []
        for k in kodlar:
            ax.plot(x, g[f'kap_{k}'], color=MODEL_RENK[k], lw=2.6 if k == 'M1' else 2.2,
                    zorder=6 if k == 'M2' else 4, label=f'{MODEL_AD[k]} — kapasite')
            t = perf[k]
            o = _ozet(t[(t['hafta_sonu'] == hs) & t['data_date'].isin(ortak)])
            satir.append(f"{MODEL_AD[k]}: RR plan {o['RR_plan']:.2f} · gerçek "
                         f"{o['RR_gercek']:.2f} · eksik {o['eksik_kisi_saat'] / n_gun:,.0f} "
                         f"kişi-saat/gün")
        ax.set_ylabel('kişi', fontsize=9, color=RENK['metin2'])
        _eksen(ax, g, y_adim=y_adim)
        ax.set_ylim(0, kisi_max)
        _kutu(ax, '\n'.join(satir))
        if j == 0:
            ax.legend(loc='upper left', frameon=False, fontsize=8,
                      labelcolor=RENK['metin2'])
    fig.suptitle(f"{queue} — PERFORMANS TAKİBİ: plan ↔ gerçekleşen  "
                 f"(RR = atanan ÷ Erlang ihtiyacı · hafta sonu kısmiler dahil)",
                 fontsize=13, fontweight='bold', color=RENK['metin'],
                 x=0.01, ha='left', y=0.995)
    fig.tight_layout(rect=(0, 0, 1, 0.96))
    _kaydet(fig, kaydet)
    return fig


