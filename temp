def pt_vardiyalari(config):
    """config['part_time']['shifts'] → kapsama sözlüğü (gün sınırı ayrılmış).

    PT artık hafta içinde de kullanılıyor; vardiya saatleri gün tipine göre
    DEĞİŞMİYOR (operasyon kararı, 2026-10-07).
    """
    pt = config.get('part_time', {}) or {}
    if not pt.get('enabled', False):
        return {}
    out = {}
    for s in pt.get('shifts', []):
        bas, bit = s.split('-')
        tum = [t for t in SLOTS_30 if is_slot_in_shift(t, bas, bit)]
        bn = f"{int(bas[:2]) % 24:02d}:{bas[3:5]}"
        key = f"pt_{bas.replace(':', '')}_{bit.replace(':', '')}"
        out[key] = {
            'shift': key, 'company': 'part_time', 'start': bas, 'end': bit,
            'slots':    [t for t in tum if t >= bn],
            'slots_d1': [t for t in tum if t <  bn],
            'slots_full': tum,
        }
    return out


