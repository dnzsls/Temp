import pandas as pd

df13 = gunluk_df.copy()                      # ← H13'teki günlük tablonun adı
tarih_kol = next(c for c in df13.columns
                 if c.lower() in ("tarih", "date", "data_date", "gun"))
df13[tarih_kol] = pd.to_datetime(df13[tarih_kol])
df13 = df13.sort_values(tarih_kol).reset_index(drop=True)

hafta_sonu = df13[tarih_kol].dt.weekday >= 5
df13["_blok"] = (hafta_sonu != hafta_sonu.shift()).cumsum()
df13["_tur"]  = hafta_sonu.map({False: "hafta_ici", True: "hafta_sonu"})

# --- HAFTA ETİKETLERİ ---
# (a) ISO hafta numarası (takvim haftası, ör. 27, 28...)
df13["iso_hafta"] = df13[tarih_kol].dt.isocalendar().week
# (b) ay içi sıra: kaçıncı hafta içi / kaçıncı hafta sonu bloğu
_blok_tur = df13.groupby("_blok")["_tur"].first()
_sira = _blok_tur.groupby(_blok_tur).cumcount() + 1          # tür içi 1,2,3...
df13["blok_sira"] = df13["_blok"].map(_sira)

sayisal = df13.select_dtypes("number").columns.drop(
    ["_blok", "iso_hafta", "blok_sira"], errors="ignore")
ozet = (df13.groupby(["_blok", "_tur"])
             .agg(bas=(tarih_kol, "min"),
                  bit=(tarih_kol, "max"),
                  gun=(tarih_kol, "size"),
                  iso_hafta=("iso_hafta", "min"),
                  blok_sira=("blok_sira", "first"),
                  **{c: (c, "mean") for c in sayisal})
             .reset_index()
             .sort_values("bas"))

# okunur etiket: "1. hafta içi (ISO 27)"
ozet["etiket"] = (ozet["blok_sira"].astype(str) + ". "
                  + ozet["_tur"].str.replace("_", " ")
                  + " (ISO " + ozet["iso_hafta"].astype(str) + ")")
ozet["aralik"] = (ozet["bas"].dt.strftime("%d.%m") + "–"
                  + ozet["bit"].dt.strftime("%d.%m"))

ozet = ozet.drop(columns=["_blok", "bas", "bit", "iso_hafta", "blok_sira"])
ozet[sayisal] = ozet[sayisal].round(1)
# kolon sırası: etiket + tür + aralık önce
on = ["etiket", "_tur", "aralik", "gun"]
ozet = ozet[on + [c for c in ozet.columns if c not in on]]
print(ozet.to_string(index=False))
