def show(df, n=None):
    """DataFrame'i Jupyter tablosu olarak gösterir (terminalde metne düşer)."""
    x = df.head(n) if n else df
    if _display is not None:
        _display(x)
    else:
        print(x.to_string(index=False))
    return x


SLOTS_30 = [f"{h:02d}:{m}" for h in range(24) for m in ('00', '30')]
SLOT_IDX = {s: i for i, s in enumerate(SLOTS_30)}

QUEUES = ('kitle', 'kurumsal', 'gold')

# line_based_main_group → kuyruk
QUEUE_BY_GROUP = {
    'kitle_cagrilar':    'kitle',
    'kurumsal_cagrilar': 'kurumsal',
    'gold_cagrilar':     'gold',
}

DEFAULT_MODEL_COLS = {
    'date':    ['data_date', 'date', 'tarih'],
    'queue':   ['kuyruk', 'queue', 'line_based_main_group'],
    'shift':   ['vardiya', 'shift'],
    'kisi':    ['kisi', 'kisi_sayisi', 'count', 'adet'],
    'company': ['company', 'sirket'],
}

DEFAULT_PLAN_COLS = {
    'agent': 'agent_user_code',
    'date':  'date',
    'shift': 'vardiya',
    'group': 'line_based_main_group',
    'mesai': 'mesai_mi_calisti',
}

# Her flag için: 'exclude' → o gün sahada saymaz | 'include' → normal sayılır.
# NOT: sut_izni_flg şimdilik 'include' — günün hangi saatinde ne kadar düşüleceği
# kuralı netleşince kısmi düşüm olarak ayrıca ele alınacak.
DEFAULT_FLAG_RULES = {
    'egitim_flg':     'exclude',
    'vob_flg':        'exclude',
    'hamile_flg':     'include',
    'sut_izni_flg':   'include',
    'kismi_flg':      'include',   # vardiya kolonu zaten kısa saati yazıyor
    'kidem_1_ay_flg': 'include',
}

TRUTHY = {1, '1', 1.0, True, 'e', 'evet', 'y', 'yes', 't', 'true', 'x', 'var'}


def _is_true(s):
    """1 / 'E' / 'Evet' / True / 'X' gibi değerleri bool'a çevirir."""
    return s.map(lambda v: str(v).strip().lower() in TRUTHY
                 if not isinstance(v, (int, float, bool)) or isinstance(v, bool)
                 else v in TRUTHY)


def _resolve_col(df, spec):
    """Aday kolon adlarından df'te bulunan ilkini döndürür (yoksa None).

    Önce birebir, sonra büyük/küçük harf duyarsız arar — SQL kolonları
    KISI_SAYISI gibi büyük harfle gelebiliyor.
    """
    cands = [spec] if isinstance(spec, str) else list(spec)
    for c in cands:
        if c in df.columns:
            return c
    lower = {str(c).lower(): c for c in df.columns}
    for c in cands:
        if str(c).lower() in lower:
            return lower[str(c).lower()]
    return None


def _normalize_queue(s):
    """'kitle_cagrilar' / 'Kitle' / 'kitle' → 'kitle'."""
    v = s.astype(str).str.strip().str.lower()
    return v.map(lambda x: QUEUE_BY_GROUP.get(x, x if x in QUEUES else None))


def _to_date_series(s):
    """ISO ('2026-08-03') ise dayfirst kapalı, aksi halde açık."""
    if pd.api.types.is_datetime64_any_dtype(s):
        return pd.to_datetime(s)
    sample = s.dropna().astype(str)
    is_iso = bool(len(sample)) and sample.str.match(r'^\d{4}-\d{2}-\d{2}').all()
    return pd.to_datetime(s, dayfirst=not is_iso)


_SHIFT_RE = re.compile(r'(\d{1,2})[:.](\d{2})\s*[-–—]\s*(\d{1,2})[:.](\d{2})')


def shift_slots(text):
    """'08:00-17:00' → kapsadığı 30dk slot listesi.

    Geceyi aşan vardiyaları da doğru işler ('22:00-06:00' → 22:00…05:30).
    Vardiya metni çözümlenemezse (OFF, İZİN, boş) boş liste döner.
    """
    m = _SHIFT_RE.search(str(text))
    if not m:
        return []

    sh, sm, eh, em = (int(g) for g in m.groups())
    start = f"{sh % 24:02d}:{(sm // 30) * 30:02d}"
    end_idx_raw = (eh % 24) * 2 + (em // 30)
    if eh == 24 or (eh % 24) * 60 + em == 0:       # '…-24:00' / '…-00:00'
        end_idx_raw = len(SLOTS_30)

    i, j = SLOT_IDX[start], end_idx_raw
    if j <= i:                                     # geceyi aşıyor
        j += len(SLOTS_30)
    return [SLOTS_30[k % len(SLOTS_30)] for k in range(i, j)]


def build_plan_coverage(df_plan, year=2026, month=8, plan_cols=None,
                        flag_rules=None, verbose=True):
    """Vardiya planını (gün × 30dk slot × kuyruk) kişi sayısına çevirir.

    Aynı agent aynı gün birden fazla satırda geçse bile bir slotta bir kez
    sayılır (agent_user_code üzerinden tekilleştirme).
    """
    cols = {**DEFAULT_PLAN_COLS, **(plan_cols or {})}
    rules = {**DEFAULT_FLAG_RULES, **(flag_rules or {})}

    eksik = [v for k, v in cols.items() if v not in df_plan.columns]
    if eksik:
        raise KeyError(f"PLAN: şu kolon(lar) yok: {eksik}  |  "
                       f"mevcut: {list(df_plan.columns)}")

    df = df_plan.copy()
    df['data_date'] = _to_date_series(df[cols['date']]).dt.normalize()
    df['queue'] = df[cols['group']].astype(str).str.strip().str.lower().map(QUEUE_BY_GROUP)
    df['mesai'] = _is_true(df[cols['mesai']])

    n0 = len(df)

    # Ay filtresi
    df = df[(df['data_date'].dt.year == year) & (df['data_date'].dt.month == month)]
    if verbose and len(df) < n0:
        print(f"  ℹ PLAN: {n0 - len(df):,} satır {year}/{month:02d} dışında, elendi.")

    # Tanınmayan kuyruk
    bilinmeyen = df[df['queue'].isna()][cols['group']].dropna().unique()
    if len(bilinmeyen):
        print(f"  ⚠ PLAN: tanınmayan {cols['group']} değerleri elendi: "
              f"{list(bilinmeyen)[:10]}")
    df = df[df['queue'].notna()]

    # Flag süzgeci
    for flag, rule in rules.items():
        if rule != 'exclude':
            continue
        if flag not in df.columns:
            if verbose:
                print(f"  ℹ PLAN: '{flag}' kolonu yok, kural atlandı.")
            continue
        maske = _is_true(df[flag])
        if verbose and maske.any():
            print(f"  ℹ PLAN: {flag} → {int(maske.sum()):,} satır sahada sayılmadı.")
        df = df[~maske]

    # Vardiya metni → slotlar
    vardiyalar = df[cols['shift']].astype(str).unique()
    slot_map = {v: shift_slots(v) for v in vardiyalar}
    cozulmeyen = [v for v, s in slot_map.items() if not s]
    if cozulmeyen and verbose:
        print(f"  ℹ PLAN: vardiya olarak okunamayan {len(cozulmeyen)} değer "
              f"(off/izin sayıldı): {cozulmeyen[:8]}")

    df['slot_30'] = df[cols['shift']].astype(str).map(slot_map)
    df = df.explode('slot_30').dropna(subset=['slot_30'])

    # Slot × kuyruk bazında tekil agent sayısı
    plan = (df.groupby(['data_date', 'slot_30', 'queue'])[cols['agent']]
              .nunique().rename('kisi').reset_index())
    mesai = (df[df['mesai']].groupby(['data_date', 'slot_30', 'queue'])[cols['agent']]
               .nunique().rename('mesai').reset_index())

    # Ayın tam ızgarası
    first = pd.Timestamp(year=year, month=month, day=1)
    all_days = pd.date_range(first, first + pd.offsets.MonthEnd(1), freq='D')
    out = pd.MultiIndex.from_product(
        [all_days, SLOTS_30], names=['data_date', 'slot_30']).to_frame(index=False)

    for q in QUEUES:
        for src, prefix in ((plan, 'plan'), (mesai, 'mesai')):
            col = 'kisi' if prefix == 'plan' else 'mesai'
            sub = src[src['queue'] == q][['data_date', 'slot_30', col]]
            sub = sub.rename(columns={col: f"{prefix}_{q}"})
            out = out.merge(sub, on=['data_date', 'slot_30'], how='left')

    value_cols = [f"{p}_{q}" for q in QUEUES for p in ('plan', 'mesai')]
    out[value_cols] = out[value_cols].fillna(0).astype(int)

    out['interval'] = out['slot_30']
    out = out.sort_values(['data_date', 'slot_30']).reset_index(drop=True)
    out = out[['data_date', 'interval'] +
              [f"plan_{q}" for q in QUEUES] + [f"mesai_{q}" for q in QUEUES]]

    if verbose:
        _print_plan_summary(out, all_days)
    return out


def _print_plan_summary(out, all_days):
    print(f"VARDİYA PLANI — SLOT BAZLI KİŞİ  |  {len(out):,} satır "
          f"({len(all_days)} gün × {len(SLOTS_30)} slot)")
    satirlar = []
    for q in QUEUES:
        s = out[f"plan_{q}"]
        tepe = out.loc[s.idxmax()] if s.max() else None
        satirlar.append({
            'kuyruk': q,
            'tepe_kisi': int(s.max()),
            'tepe_saat': tepe['interval'] if tepe is not None else '—',
            'ort_kisi_saat_gun': round(
                out.groupby('data_date')[f"plan_{q}"].sum().mean() / 2),
            'mesai_payi_%': round(out[f"mesai_{q}"].sum() / s.sum() * 100, 1)
                            if s.sum() else 0.0,
        })
    ozet = pd.DataFrame(satirlar)
    show(ozet)

    bos = out.groupby('data_date')[[f"plan_{q}" for q in QUEUES]].sum().sum(axis=1)
    if (bos == 0).any():
        gunler = ', '.join(bos[bos == 0].index.strftime('%d.%m'))
        print(f"  ⚠ planda hiç kişi olmayan günler: {gunler}")
    return ozet


