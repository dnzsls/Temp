import pandas as pd

GEC_BASLANGIC, W_GECMIS = "15:00", 5      # H0'daki değerlerle aynı olmalı

def _dk(t):
    s, d = str(t).split(":"); m = int(s) * 60 + int(d)
    return 1440 if m == 0 else m          # 00:00 → 1440 (gece geç sayılır)

def _p(v):
    q = str(v).split("-")
    if len(q) != 2: return None
    try:
        for t in q:
            a, b = t.split(":"); int(a); int(b)
    except ValueError: return None
    return q[0], q[1]

