def aht_slot_bazli(df_actual_sq, df_aht, queue='kitle', sq_cols=None,
                   verbose=True):
    """Her (gün × slot) için alt-kuyruk çağrı payına göre ağırlıklı AHT.

    Modelin calculate_weighted_aht'i ile aynı mantık:
        aht_slot = Σ(çağrı_sq × aht_sq) / Σ(çağrı_sq)

    df_actual_sq: df_actual'ın kendisi olabilir — uzun formatta
                  (data_date, min_time_period_value, resource_group_key,
                   line_based_main_group, nof_call) alt-kuyruk kırılımı zaten var
    df_aht                    : saat, sub_queue, line_based_main_group,
                                weighted_avg_aht

    Çıktı: data_date, interval, aht   → hakem/rr fonksiyonlarına doğrudan verilir
    """
    cols = {**DEFAULT_SQ_COLS, **(sq_cols or {})}
    d_col = _resolve_col(df_actual_sq, cols['date'])
    t_col = _resolve_col(df_actual_sq, cols['time'])
    q_col = _resolve_col(df_actual_sq, cols['sub_queue'])
    c_col = _resolve_col(df_actual_sq, cols['calls'])
    eksik = [k for k, v in (('date', d_col), ('time', t_col),
                            ('sub_queue', q_col), ('calls', c_col)) if v is None]
    if eksik:
        raise KeyError(f"ALT-KUYRUK: şu alan(lar) için kolon yok: {eksik}  |  "
                       f"mevcut: {list(df_actual_sq.columns)}")

    kaynak = df_actual_sq
    g_col = _resolve_col(kaynak, cols['group'])
    if g_col is not None:                 # aynı tabloda diğer kuyruklar da varsa süz
        kaynak = kaynak[kaynak[g_col].astype(str).str.strip().str.lower()
                        == f"{queue}_cagrilar"]
        if kaynak.empty:
            raise ValueError(f"ALT-KUYRUK: '{queue}_cagrilar' satırı yok.")

    d = pd.DataFrame({
        'data_date': _to_date_series(kaynak[d_col]).dt.normalize(),
        'interval': kaynak[t_col].map(_to_slot_30),
        'sub_queue': kaynak[q_col].astype(str).str.strip(),
        'calls': pd.to_numeric(kaynak[c_col], errors='coerce').fillna(0),
    })
    d['saat'] = d['interval'].str[:2].astype(int)
    d = d.groupby(['data_date', 'interval', 'saat', 'sub_queue'],
                  as_index=False)['calls'].sum()

    a = df_aht[df_aht['line_based_main_group'] == f"{queue}_cagrilar"].copy()
    if a.empty:
        raise ValueError(f"df_aht'de '{queue}_cagrilar' yok.")
    a['saat'] = a['saat'].astype(int)
    a['sub_queue'] = a['sub_queue'].astype(str).str.strip()
    a['aht'] = pd.to_numeric(a['weighted_avg_aht'], errors='coerce')

    m = d.merge(a[['saat', 'sub_queue', 'aht']], on=['saat', 'sub_queue'],
                how='left')
    eslesmeyen = sorted(m[m['aht'].isna()]['sub_queue'].unique())
    if eslesmeyen:
        print(f"  ⚠ df_aht'de karşılığı olmayan alt-kuyruklar (atlandı): "
              f"{eslesmeyen[:8]}")
    m = m.dropna(subset=['aht'])
    m = m[m['calls'] > 0]

    out = (m.assign(x=m['calls'] * m['aht'])
             .groupby(['data_date', 'interval'], as_index=False)
             .agg(x=('x', 'sum'), c=('calls', 'sum')))
    out['aht'] = (out['x'] / out['c']).round(1)
    out = out[['data_date', 'interval', 'aht']]

    if verbose:
        print(f"AHT (slot bazlı, çağrı ağırlıklı): {out['aht'].min():.0f}–"
              f"{out['aht'].max():.0f} sn, {len(out):,} slot  "
              f"(ortalama {out['aht'].mean():.0f} sn)")
    return out


