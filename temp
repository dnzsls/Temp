# MODEL — günlük kişi sayısı
import numpy as np
sat = []
for ds, day in results.items():
    d = pd.to_datetime(ds)
    if d.year != MODEL_YEAR or d.month != MODEL_MONTH: continue
    r = (day or {}).get(QUEUE)
    if not r: continue
    mi = r['mip_info']
    sat.append({'d': d, 'hi': d.weekday() < 5,
                'in': mi.get('total_inhouse_kisi', 0),
                'out': mi.get('total_outsource_kisi', 0),
                'pt': mi.get('total_part_time_kisi', 0),
                'toplam': mi.get('total_kisi', 0)})
m = pd.DataFrame(sat)
print("\nMODEL günlük kişi:")
show(m.groupby('hi')[['in','out','pt','toplam']].mean().round(1).reset_index())
