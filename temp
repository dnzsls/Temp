          f"kullanılmayan tavan {_top_ust - _gercek_atama} kişi-gün.")

# ── 1B) KİŞİ-GÜN HAVUZU — hafta içi ve hafta sonu AYNI havuzu paylaşıyor ──
# ESKİ HÂLİ YANILTICIYDI, kayda geçsin:
#   hafta içi TAVAN  = Σ kota
#   hafta sonu TAVAN = Σ (ust − kota)
# İki satır bağımsız tavan gibi sunuluyordu. Gizli varsayım: "hafta sonu ancak
# MESAİ olarak yapılır". Oysa hafta sonu NORM olarak da yapılır (agent bir hafta
# içi gününü off alıp yerine hafta sonu çalışır; toplam gün aynı, kota dolu,
# mesai YOK). NORM günü KOTADAN gelir → o gün hafta içi kapasiteden DÜŞER.
# Ölçülen sonuç (2026-09): tablo "hafta sonu açık 399" diyordu ama gerçek hafta
# sonu eksiği 4'tü — model açığı NORM ile kapattı ve faturayı hafta içine yazdı.
# "Hafta içi yapısal açık 86" da bu yüzden gerçeğin çok altındaydı.
#
# DOĞRU KURGU — üç sert sınır, tek havuz:
#   (a) hafta içi çalışma       ≤ Σ kota              (hafta içinde o kadar gün var)
#   (b) hafta içi + hafta sonu  ≤ Σ ust               (kota + mesai + tatil payı)
#   (c) hafta sonu              ≥ Σ(talep − HS_TOL)   (H10 SERT band, ZORUNLU)
# (c) önce dolar → hafta içine kalan tavan:
#   W_max = min( Σkota , Σust − zorunlu_hafta_sonu )
# Hafta içi KAÇINILMAZ açık = talep_hi − W_max. Bu sayı ağırlıkla, MAX_MESAI ile,
# takım-tip ayarıyla KAPANMAZ — kadro/outsource ya da Stage-1 talebi kararıdır.
_talep_hi = sum(k for (ds, _v), k in talep.items()
                if dt.date.fromisoformat(ds).weekday() < 5
                and dt.date.fromisoformat(ds) not in TATIL)
_talep_tat = sum(k for (ds, _v), k in talep.items()
                 if dt.date.fromisoformat(ds) in TATIL)
_talep_hs = _top_talep - _talep_hi - _talep_tat
# (c) hafta sonu sert bandın ZORUNLU kıldığı alt sınır
_zorunlu_hs = sum(max(0, k - HS_TOL) for (ds, _v), k in talep.items()
                  if dt.date.fromisoformat(ds).weekday() >= 5
                  and dt.date.fromisoformat(ds) not in TATIL)
# FİİLEN atanan — df_cov'dan (tahmin YOK, çözümün kendi sayısı)
_cov_d = df_cov["tarih"].map(dt.date.fromisoformat)
_at_hs  = int(df_cov.loc[(_cov_d.map(lambda d: d.weekday() >= 5))
                         & (~_cov_d.isin(TATIL)), "atanan"].sum())
_at_tat = int(df_cov.loc[_cov_d.isin(TATIL), "atanan"].sum())
_at_hi  = int(df_cov.loc[(_cov_d.map(lambda d: d.weekday() < 5))
                         & (~_cov_d.isin(TATIL)), "atanan"].sum())
# hafta sonunun MESAİ / NORM kırılımı — roster_2 (H22) ile BİREBİR aynı ölçü.
# E (hafta sonu çalışma) = mesai_gun + norm_gun kimliği H22'de kanıtlı:
#   mesai = max(0, E − borç),  norm = min(E, borç)   → toplamı her zaman E
_hs_mesai = int(roster_2["mesai_gun"].sum())
_hs_norm  = int(roster_2["norm_gun"].sum())
# HAFTA İÇİ TAVAN — iki sınırın darı
_W_kota = _top_kota
_W_ust  = _top_ust - _zorunlu_hs - _talep_tat
_W_max  = min(_W_kota, _W_ust)
_kacinilmaz_hi = max(0, _talep_hi - _W_max)
# kova bazlı hafta içi eksik (tatil hariç) — [2] ile aynı ölçü
_eksik_hi_kova = int(-df_cov.loc[(df_cov["fark"] < 0)
                                 & (_cov_d.map(lambda d: d.weekday() < 5))
                                 & (~_cov_d.isin(TATIL)), "fark"].sum())

print(f"\n[1B] KİŞİ-GÜN HAVUZU — hafta içi ve hafta sonu AYNI havuzu paylaşıyor")
print(f"    ÜÇ SERT SINIR:")
print(f"      (a) hafta içi çalışma       ≤ Σkota            = {_top_kota:>6}")
print(f"      (b) hafta içi + hafta sonu  ≤ Σust             = {_top_ust:>6}")
print(f"      (c) hafta sonu              ≥ Σ(talep−{HS_TOL}) [SERT] = {_zorunlu_hs:>6}")
print(f"    ⚠ (a) ile (c) AYNI havuzdan yiyor: hafta sonu günü MESAİ ise kotanın")
print(f"      ÜSTÜNDEN gelir; NORM ise KOTADAN gelir → hafta içinden düşer.")
print(f"      Mesai payı (Σust−Σkota = {_top_ust - _top_kota}) aşıldıktan sonrası ZORUNLU NORM.")
print(f"\n    FİİLEN NE OLDU (çözümün kendi sayıları)")
print(f"      hafta sonu : talep {_talep_hs:>6}   atanan {_at_hs:>6}"
      f"   (sert band ±{HS_TOL})")
print(f"         ├ MESAİ olarak        {_hs_mesai:>6}   ← kotanın üstü, hafta içine dokunmaz")
print(f"         └ NORM/TELAFİ olarak  {_hs_norm:>6}   ← KOTADAN yendi, hafta içinden çıktı")
if _talep_tat:
    print(f"      resmi tatil: talep {_talep_tat:>6}   atanan {_at_tat:>6}")
print(f"      hafta içi  : talep {_talep_hi:>6}   atanan {_at_hi:>6}")
print(f"\n    HAFTA İÇİ KAÇINILMAZ AÇIK")
print(f"      tavan = min( Σkota {_W_kota} , Σust−zorunlu_hs{'−tatil' if _talep_tat else ''} "
      f"{_W_ust} ) = {_W_max}"
      f"   [{'Σkota' if _W_kota <= _W_ust else 'hafta sonu baskısı'} bağlıyor]")
print(f"      hafta içi talep                                  {_talep_hi}")
if _kacinilmaz_hi:
    print(f"      → EN AZ {_kacinilmaz_hi} kişi-gün KAÇINILMAZ — model kapatamaz")
    print(f"        (çare: kadro/outsource ya da Stage-1 hafta içi talebi)")
    print(f"      → kova bazlı hafta içi eksik: {_eksik_hi_kova}")
    print(f"      → aradaki {_eksik_hi_kova - _kacinilmaz_hi} kişi-gün DÜZELTİLEBİLİR "
          f"(yanlış yere atama + kullanılmayan tavan) → [2] ve [3]'e bak")
else:
    print(f"      → kaçınılmaz açık YOK; hafta içi eksiğin ({_eksik_hi_kova}) TAMAMI")
    print(f"        dağıtım sorunu (tip dağılımı / off yerleşimi) → [2] ve [3]'e bak")

# ── 2) EKSİK NEREDE ───────────────────────────────────────────────────
_eks = df_cov[df_cov["fark"] < 0].copy()
_eks["eksik"] = -_eks["fark"]
_eks["hs"] = _eks["tarih"].map(lambda ds: dt.date.fromisoformat(ds).weekday() >= 5)
_eks["gun"] = _eks["tarih"].map(lambda ds: DAY_TR[dt.date.fromisoformat(ds).weekday()])
_eks["tip"] = _eks["saat"].str.split("-").str[0]
print(f"\n[2] EKSİK KIRILIMI  (toplam {int(_eks['eksik'].sum())} kişi-gün, "
