# %% [HÜCRE 7] — İZİN GÜNLERİNİ BİRLEŞTİR ───────────────────────────────
# Her agent için tek izin kümesi: özel-off + tekrarlı(Pzt/Cuma) + tam-ay(idari/doğum)

# 1) df_izin (ÖNCELİKLİ) + df_off → agent başına tarih→tip haritası (tip_map).
#    tip: "izin" (kotadan düşer) | "off_t"/"off_t2" (blok ama kota DÜŞMEZ).
#    Çakışan tarihte df_izin kazanır: df_izin'i ÖNCE yazıyoruz, df_off'u setdefault
#    ile ekliyoruz → df_izin'de olan tarihi df_off EZEMEZ.
tip_map = {}                                            # code -> {tarih: tip}
_BILINEN_TIP = {"izin", "off_t", "off_t2"}              # tanınan tipler; boş/diğer → YOK SAY (normal çalışma)
if df_izin is not None:                                 # df_izin ÖNCE → öncelikli
    for _, row in df_izin.iterrows():
        code = str(row["agent_user_code"]).strip()
        if row["izin_tipi"] not in _BILINEN_TIP:        # boş/tanınmayan tip → yok say
            continue
        tip_map.setdefault(code, {})[row["tarih"]] = row["izin_tipi"]
if df_off is not None:
    _off_tipli = "izin_tipi" in df_off.columns
    _off_bos = 0                                        # boş/tanınmayan izin_tipi satır sayısı
    for _, row in df_off.iterrows():
        code = str(row["agent_user_code"]).strip()
        tipi = row["izin_tipi"] if _off_tipli else "izin"   # tip kolonu yoksa izin varsay
        if tipi not in _BILINEN_TIP:                    # boş/tanınmayan tip → YOK SAY (normal çalışma)
            _off_bos += 1
            continue
        for c in gun_cols:                              # gun_cols H3'te tanımlandı
            if int(row[c]) == 1:
                try:
                    d = dt.date(AY_YIL, AY_AY, int(c.split("_")[1]))
                except ValueError:
                    continue                            # ayda olmayan gün (gun_31 vs.)
                tip_map.setdefault(code, {}).setdefault(d, tipi)   # df_izin varsa DOKUNMA
    if _off_bos:
        print(f"df_off: {_off_bos} satır boş/tanınmayan izin_tipi → YOK SAYILDI (normal çalışma)")

# 2) tekrarlı hafta içi izin: flag → hafta günü (0=Pzt .. 4=Cuma)
#    Yeni gün eklemek için tek yer burası (tek format).
HAFTAICI_IZIN_FLG = {
    "pazartesi_izinli_flg": 0,
    "sali_izinli_flg":      1,
    "carsamba_izinli_flg":  2,
    "persembe_izinli_flg":  3,
    "cuma_izinli_flg":      4,
}
gunluk_izin = {wd: {d for d in GUN_SET if d.weekday() == wd}
               for wd in set(HAFTAICI_IZIN_FLG.values())}   # hafta günü → o ayın tüm o günleri


def _b(row, col):
    """flag (float/str) → bool"""
    return pd.to_numeric(row.get(col, 0), errors="coerce") == 1


# süt izni ↔ resmi tatil emilimi: bir ISO haftada HAFTA İÇİ resmi tatil varsa,
# o hafta süt izni "tatile sayılır" → süt agent o hafta süt iznini KULLANMAZ
# (normal gününde çalışır), tatil günü zaten off. Sadece süt izni için geçerli;
# hafta sonu tatil emilmez (zaten AYLIK_IS_GUNU'yu da etkilemez).
_TATIL = set(dt.date.fromisoformat(t) for t in RESMI_TATILLER)   # H16 ile aynı liste
tatil_haftalari = {d.isocalendar()[:2] for d in _TATIL if d.weekday() < 5}

# 3) agent başına birleştir → izin_map (kotadan düşer) + off_block_map (blok, kota DÜŞMEZ)
izin_map = {}
off_block_map = {}                                     # off_t2 → SERT blok (değişken açılmaz)
off_soft_map = {}                                      # off_t  → YUMUŞAK talep (değişken açılır, cezalı)
off_tip_map = {}                                       # code -> {tarih: off_t/off_t2} (roster etiketi)
for _, row in df_tam.iterrows():
    code = str(row["agent_user_code"]).strip()
    izin = set()
    off_block = set()
    off_soft = set()
    off_tip = {}
    for d, tipi in tip_map.get(code, {}).items():      # df_izin+df_off tarihlerini tipe ayır
        if tipi == "izin":
            izin.add(d)
        elif tipi == "off_t2":                         # SERT: her zaman karşılanır → blok
            off_block.add(d)
            off_tip[d] = tipi
        else:                                          # off_t → YUMUŞAK talep, blok DEĞİL
            off_soft.add(d)                            #   karşılanmazsa H20B(3) cezası
            off_tip[d] = tipi
    if _b(row, "idari_izinli_flg") or _b(row, "dogum_izni_flg"):
        izin |= GUN_SET                                # tüm ay
    sut = _b(row, "sut_izni_flg")                      # süt izni → tatil haftası emilimi
    for flg, wd in HAFTAICI_IZIN_FLG.items():          # tekrarlı hafta içi izin günleri
        if _b(row, flg):
            gunler = gunluk_izin[wd]
            if sut:                                    # süt: tatil haftasındaki izni EMME
                gunler = {d for d in gunler
                          if d.isocalendar()[:2] not in tatil_haftalari}
            izin |= gunler
    # hamile/süt HAFTA SONU çalışamaz (H14) → hafta sonu telafisi YOK:
    #  • off_t/off_t2 → YOK SAY → o gün NORMAL çalışma. (off_t kotayı düşürmez +
    #    telafi yok → bloklarsak kota dolmaz → INFEASIBLE.) Gün gerçekten off
    #    olacaksa veriye off_t DEĞİL, İZİN girilmeli (izin kotayı düşürür).
    #  • hafta sonu izin → anlamsız (zaten off) → kaldır ("off" görünür).
    if sut or _b(row, "hamile_flg"):
        off_block = set()                                # off_t/off_t2 yok say → normal çalışma
        off_soft = set()
        off_tip = {}
        izin = {d for d in izin if d.weekday() < 5}      # hafta sonu izinleri at → "off"
    izin_map[code] = izin
    off_block_map[code] = off_block
    off_soft_map[code] = off_soft
    off_tip_map[code] = off_tip

df_tam["izin_gun_sayisi"] = df_tam["agent_user_code"].map(
    lambda c: len(izin_map.get(str(c).strip(), set())))

tam_ay = sum(1 for v in izin_map.values() if v >= GUN_SET)
print(f"izin girişi olan agent: {sum(1 for v in izin_map.values() if v)}  |  "
      f"off_t2 (SERT blok) olan agent: {sum(1 for v in off_block_map.values() if v)}  |  "
      f"off_t (YUMUŞAK talep) olan agent: {sum(1 for v in off_soft_map.values() if v)} "
      f"({sum(len(v) for v in off_soft_map.values())} kişi-gün)")
print(f"tüm-ay izinli (idari/doğum): {tam_ay}")
print("en çok izinli 10 agent:")
print(df_tam[["agent_user_code", "izin_gun_sayisi"]]
      .sort_values("izin_gun_sayisi", ascending=False).head(10).to_string(index=False))


# %% [HÜCRE 8] — MODEL GİRDİLERİNİ HAZIRLA ─────────────────────────────
# df'leri CP-SAT'ın anlayacağı sade yapılara çevir (henüz model/kısıt yok).
AGENTS = [str(c).strip() for c in df_tam["agent_user_code"]]

# gün → o gün talebi olan vardiyalar  +  (gün, vardiya) → kaç kişi
# saat[(gün, vardiya)] = (baslangic, bitis)  → saat-bazlı kısıtlar için (sonra)
gun_vardiyalari = {}
talep = {}
saat = {}
for _, row in df_talep.iterrows():
    ds, v, kisi = row["tarih"], row["vardiya"], int(row["talep"])
    gun_vardiyalari.setdefault(ds, []).append(v)
    talep[(ds, v)] = kisi
    saat[(ds, v)] = (row["baslangic"], row["bitis"])

# ── ARİFE YARIM-GÜN SÖZDE-VARDİYASI (09:00-13:00) ──────────────────────
# Arife günü kısıtlılar (süt/hamile/mesai) öğleden sonrayı yapamaz → onlara
# özel SABİT 09:00-13:00 yarım vardiya. Bu vardiya COVERAGE'A GİRMEZ
# (talep'e EKLENMEZ) → 9-18 (ve diğer) talebi DÜŞMEZ: 20 ihtiyaç varsa 3'ü
# arife 9-13 çalışsa bile talep yine 20 (ek/bonus). Ama gun_vardiyalari +
# saat'e girer → H11/H12/H16C/H17 onu İŞ GÜNÜ sayar (kota/haftalık/günde-1).
# Kim alır/almaz (kısıtlı sadece bunu, normal alamaz) → H16B'de.
ARIFE = set(dt.date.fromisoformat(d) for d in ARIFE_GUNLERI)
ARIFE_YARIM = "__ARIFE_YARIM__"                    # sözde-vardiya kodu (talep'te YOK)
_ay_h, _ay_m = ARIFE_SON_BASLANGIC.split(":")
_ay_bit = int(_ay_h) * 60 + int(_ay_m) + 4 * 60    # 09:00 + 4 saat → 13:00
ARIFE_YARIM_SAAT = (ARIFE_SON_BASLANGIC, f"{_ay_bit // 60:02d}:{_ay_bit % 60:02d}")
for ds in list(gun_vardiyalari):
    if dt.date.fromisoformat(ds) in ARIFE:
        gun_vardiyalari[ds].append(ARIFE_YARIM)
        saat[(ds, ARIFE_YARIM)] = ARIFE_YARIM_SAAT  # talep'e EKLENMEZ → coverage dışı

PLAN_GUNLER = sorted(gun_vardiyalari)              # talebi olan günler

print(f"agent (tam zamanlı, {QUEUE}): {len(AGENTS)}")
print(f"planlanacak gün: {len(PLAN_GUNLER)}  ({PLAN_GUNLER[0]} .. {PLAN_GUNLER[-1]})")
print(f"(gün × vardiya) çift: {len(talep)}  | toplam kişi-slot: {sum(talep.values())}")


# %% [HÜCRE 8B] — GÜN-BAZLI FAZLA/EKSİK (surplus'a göre off dağıtımı) ────
# Her HAFTA İÇİ plan günü için pickle'dan TOPLAM net = fazla − eksik:
#   fazla = surplus_total_added   → o gün dağıtılan TOPLAM fazla (kişi; bu veride hep outsource)
#   eksik = total_shortfall       → o gün açık (kişi-slot)
#   net   = fazla − eksik  → YÜKSEK = bol gün (off ucuz), DÜŞÜK/negatif = sıkı (herkes çalışsın)
# NEDEN TOPLAM (inhouse değil): inhouse fazlası bu veride hep 0 (Stage-1 tüm inhouse'u kullanıyor,
# fazlayı outsource'a dağıtıyor). Toplam bol gün → inhouse off vermek TOPLAM fazla ile SOĞURULUR
# (coverage ihtiyaç altına düşmez). Sıkı/açık gün → herkes çalışsın.
# Ağırlık gun_off_w[gün] ∈ [0,1] (min-max normalize): 1 = en bol (off en ucuz), 0 = en sıkı.
# NOT: Bu hücre SADECE tabloyu kurar; cezaya bağlama sonraki adımda (H20B).
gun_net = {}
for ds in PLAN_GUNLER:
    d = dt.date.fromisoformat(ds)
    if d.weekday() >= 5:                              # sadece hafta içi (hafta sonu ayrı pipeline)
        continue
    mi = results[ds][QUEUE]["mip_info"]
    fazla = mi.get("surplus_total_added") or 0        # TOPLAM fazla (bu veride outsource'ta)
    eksik = mi.get("total_shortfall") or 0
    gun_net[ds] = int(fazla - eksik)

# normalize → w ∈ [0,1]: en yüksek net → 1 (off en ucuz), en düşük → 0 (off en pahalı)
if gun_net:
    _lo, _hi = min(gun_net.values()), max(gun_net.values())
    _rng = _hi - _lo
    gun_off_w = {ds: ((v - _lo) / _rng if _rng > 0 else 0.5)
                 for ds, v in gun_net.items()}
else:
    gun_off_w = {}

print(f"gün-bazlı fazla/eksik (hafta içi {len(gun_net)} gün):")
for ds in sorted(gun_net):
    d = dt.date.fromisoformat(ds)
    print(f"  {ds} {d.strftime('%a')}: net={gun_net[ds]:+d}  "
          f"off_ağırlık(w)={gun_off_w[ds]:.2f}  (1=off ucuz, 0=off pahalı)")


# %% [HÜCRE 8C] — ÖNCEKİ AY TAŞIMA (sınır günleri) ─────────────────────
# Ay sınırında modelin GÖRMEDİĞİ önceki ay günleri var. İki ayrı pencere:
#   PENCERE_GUNLER : ayın 1. gününden önceki 6 gün → KAYAN 7 GÜNLÜK PENCERE (H12)
#                    + son günün vardiyası → 11 SAAT dinlenme (H15).
#                    Ay Pazartesi başlasa bile GEREKLİ (ikisi de günlük kural).
#   TASIMA_GUNLER  : ayın ilk ISO haftasının önceki aya düşen günleri → HAFTALIK
#                    kurallar (ISO-hafta tavanı, H20B off dengesi, H20E mesai
#                    eşiği, H22 mesai/norm raporu). Ay Pazartesi başlıyorsa BOŞ.
# Bu hücre df_onceki'yi okuyup sözlükleri kurar — KISIT YOK, sadece veri + doğrulama.
#   df_onceki kolonları: agent_user_code | tarih | vardiya
#   vardiya: '09:00-18:00' (çalışma) | 'off' | 'izin' | 'off_t' | 'off_t2'
#     • izin        → kotayı DÜŞÜRÜR   → haftalık mesai eşiğini indirir
#     • off_t/off_t2→ blok, kota düşmez → model içinde haftalık off sayımına da
#                     girmez (H20B: değişkeni olmayan gün off sayılmaz) → ayrı sayaç
#     • off         → normal off (haftalık off dengesine girer)
#   Tablo daha geniş aralık getirebilir → sadece yukarıdaki günler süzülür.
# df_onceki yoksa sözlükler BOŞ kalır → model eskisi gibi çalışır (geriye uyumlu).

AY_ILK        = dt.date.fromisoformat(GUNLER[0])            # planlanan ayın ilk günü
SINIR_HAFTA   = AY_ILK.isocalendar()[:2]                    # sınır ISO haftası (yıl, hafta)
ONCEKI_SON    = AY_ILK - dt.timedelta(days=1)               # önceki ayın son günü (11 saat için)
PENCERE_GUNLER = sorted(d for i in range(1, 7)              # kayan 7 günlük pencere → 6 gün geriye
                        for d in [AY_ILK - dt.timedelta(days=i)]
                        if d not in GUN_SET)
TASIMA_GUNLER = sorted(d for i in range(1, AY_ILK.weekday() + 1)   # Pzt başlarsa → boş liste
                       for d in [AY_ILK - dt.timedelta(days=i)]
                       if d not in GUN_SET)                 # planlanan ayın kendi günü ise taşıma değil
ONCEKI_GUNLER = sorted(set(PENCERE_GUNLER) | set(TASIMA_GUNLER))   # okunacak tüm önceki ay günleri
SINIR_AY_GUN  = [ds for ds in PLAN_GUNLER                   # sınır haftasının BU AYA düşen günleri
                 if dt.date.fromisoformat(ds).isocalendar()[:2] == SINIR_HAFTA]   # (ör. 01-02 Ağu)

onceki_gun, onceki_izin, onceki_off = {}, {}, {}   # agent → sınır İSO HAFTASINDA çalışma/izin/off gün sayısı
onceki_offt          = {}                          # agent → off_t + off_t2 gün sayısı (blok ama kota nötr)
OFF_T_DEGERLERI      = {"off_t", "off_t2"}         # tanınan blok-off etiketleri
onceki_calisti       = {}                          # agent → {tarih} ÇALIŞILAN önceki ay günleri (kayan pencere)
onceki_izin_hi       = {}                          # agent → HAFTA İÇİ izin günü (H20E/H22 mesai eşiğini düşürür)
onceki_musait_hi     = {}                          # agent → HAFTA İÇİ müsait gün (çalışma+off; izin/off_t hariç) → H16C
onceki_tip           = {}                          # agent → hafta içi vardiya tipi (başlangıç); çok tipliyse None
onceki_son_vardiya   = {}                          # agent → önceki ayın SON gününün vardiyası ('15:00-24:00') / None
onceki_off_hi        = {}                          # agent → sınır haftasında HAFTA İÇİ off günü
onceki_eksik         = {}                          # agent → SINIR HAFTASI ALACAĞI (norm hakkı), tavanlı
onceki_gunluk        = {}                          # agent → {tarih: ham değer} — Excel'de salt okunur basım (H29)
# SINIR HAFTASI ALACAĞI — sınır ISO haftası TEK BİR HAFTA gibi değerlendirilir:
#   o haftanın hafta içi günleri önceki ayda, hafta sonu günleri BU ayda.
#   Önceki ayda hafta içi 4 gün çalışıp 1 gün OFF olmuşsa, o haftanın 5. günü
#   bu ayın hafta sonuna düşer → o gün MESAİ değil NORM (takas).
#   alacak = sınır haftasındaki hafta içi off günü  (izin/off_t hariç — onlar
#            kotayı düşürür ya da bloktur, telafi gerektirmez)
#   tavan  = sınır haftasının bu aya düşen gün sayısı (ör. 2 → Cmt+Pzr)
# Daha geriye BAKILMAZ: önceki ayın diğer haftaları bu hesaba girmez (veri de
# her zaman tüm ayı içermiyor). Kullanımı: H17 tavan, H22 mesai/norm, H29 renk.
_tasima_uyari        = []                          # (agent, gün, sorun)


def _vardiya_parse(v):
    """'09:00-18:00' → ('09:00', '18:00');  'off'/'izin'/bozuk → None."""
    p = str(v).split("-")
    if len(p) != 2:
        return None
    try:
        for t in p:
            s, d = t.split(":")
            int(s), int(d)
    except ValueError:
        return None
    return p[0], p[1]


df_onceki = globals().get("df_onceki")
if df_onceki is None:
    print("df_onceki yok → önceki ay taşıması DEVRE DIŞI (kurallar ay içiyle sınırlı)")
elif not ONCEKI_GUNLER:
    print(f"önceki ay günü yok ({AY_ILK}) → taşıma gerekmiyor")
else:
    _onc = df_onceki.copy()
    _onc.columns = [str(c).strip().lower() for c in _onc.columns]
    _onc["agent_user_code"] = _onc["agent_user_code"].astype(str).str.strip()
    _onc["vardiya"] = _onc["vardiya"].astype(str).str.strip().str.lower()
    _onc["tarih_d"] = pd.to_datetime(_onc["tarih"], errors="coerce").dt.date
    _tum_satir = len(_onc)
    _onc = _onc[_onc["tarih_d"].isin(set(ONCEKI_GUNLER))]    # sadece gereken önceki ay günleri

    for a, g in _onc.groupby("agent_user_code"):
        _gv = dict(zip(g["tarih_d"], g["vardiya"]))          # tarih → vardiya
        calisti = set()
        for d in ONCEKI_GUNLER:                              # pencere + ISO hafta günleri
            v = _gv.get(d)
            if v is None:
                _tasima_uyari.append((a, d.isoformat(), "satır yok"))
                continue
            if _vardiya_parse(v):
                calisti.add(d)                               # çalışılan gün (kayan pencere + tip için)
            elif v not in ({"izin", "off"} | OFF_T_DEGERLERI):
                _tasima_uyari.append((a, d.isoformat(), f"tanınmayan değer: {v}"))
        onceki_calisti[a] = calisti
        onceki_gunluk[a] = dict(_gv)                         # ham değerler → H29 salt-okunur kolonlar
        # sınır ISO haftası sayaçları (haftalık kurallar) — pencere günleri BURAYA girmez
        onceki_gun[a]  = len(calisti & set(TASIMA_GUNLER))
        onceki_izin[a] = sum(1 for d in TASIMA_GUNLER if _gv.get(d) == "izin")
        onceki_off[a]  = sum(1 for d in TASIMA_GUNLER if _gv.get(d) == "off")
        onceki_offt[a] = sum(1 for d in TASIMA_GUNLER if _gv.get(d) in OFF_T_DEGERLERI)
        onceki_izin_hi[a] = sum(1 for d in TASIMA_GUNLER            # sadece HAFTA İÇİ izin
                                if d.weekday() < 5 and _gv.get(d) == "izin")
        onceki_musait_hi[a] = sum(1 for d in TASIMA_GUNLER          # hafta içi MÜSAİT gün:
                                  if d.weekday() < 5                #   çalışma + off  (izin/off_t hariç)
                                  and (d in calisti or _gv.get(d) == "off"))
        onceki_off_hi[a] = sum(1 for d in TASIMA_GUNLER             # hafta içi OFF → sınır haftası alacağı
                               if d.weekday() < 5 and _gv.get(d) == "off")
        onceki_eksik[a] = min(onceki_off_hi[a], len(SINIR_AY_GUN))  # tavan: bu aya düşen gün sayısı
        tipler = {_vardiya_parse(_gv[d])[0] for d in TASIMA_GUNLER      # hafta içi tip (H20 sürekliliği)
                  if d in calisti and d.weekday() < 5}
        if len(tipler) == 1:
            onceki_tip[a] = next(iter(tipler))
        elif len(tipler) > 1:                                # o hafta tip değiştirmiş → kilit uygulanamaz
            onceki_tip[a] = None
            _tasima_uyari.append((a, "-", f"birden çok hafta içi tip: {sorted(tipler)}"))
        _son = _gv.get(ONCEKI_SON)                           # önceki ayın son günü → 11 saat
        onceki_son_vardiya[a] = _son if (_son and _vardiya_parse(_son)) else None

    # ── doğrulama / özet ───────────────────────────────────────────────
    _agent_set = set(AGENTS)
    _tablo_set = set(onceki_gun)
    _eksik = sorted(_agent_set - _tablo_set)                 # modelde var, tabloda yok → taşıma yok
    _fazla = len(_tablo_set - _agent_set)                    # tabloda var, modelde yok (başka kuyruk/PT)
    print(f"önceki ay taşıma: pencere {len(PENCERE_GUNLER)} gün "
          f"({PENCERE_GUNLER[0]} .. {PENCERE_GUNLER[-1]}) → kayan 7 gün + 11 saat  |  "
          f"ISO hafta {SINIR_HAFTA[0]}-W{SINIR_HAFTA[1]}: {len(TASIMA_GUNLER)} gün"
          + (f" ({TASIMA_GUNLER[0]} .. {TASIMA_GUNLER[-1]}) → haftalık kurallar"
             if TASIMA_GUNLER else " (ay Pazartesi başlıyor → haftalık taşıma yok)"))
    print(f"  df_onceki {_tum_satir} satır → kullanılan {len(_onc)} satır  |  "
          f"eşleşen agent: {len(_agent_set & _tablo_set)}/{len(AGENTS)}  "
          f"(tabloda olup modelde olmayan: {_fazla})")
    if _eksik:
        print(f"  ⚠ {len(_eksik)} agent tabloda YOK → o agentlarda taşıma uygulanmayacak: "
              f"{_eksik[:10]}{' ...' if len(_eksik) > 10 else ''}")
    _es = _agent_set & _tablo_set
    _pen_dag = pd.Series({a: len(onceki_calisti[a] & set(PENCERE_GUNLER))
                          for a in _es}).value_counts().sort_index()
    print(f"  PENCERE'de ({len(PENCERE_GUNLER)} gün) çalışılan gün → agent sayısı: {_pen_dag.to_dict()}"
          f"   (6 = kayan pencere tavanı 0'a iner)")
    if TASIMA_GUNLER:
        _cal_dag = pd.Series({a: onceki_gun[a] for a in _es}).value_counts().sort_index()
        print(f"  ISO haftada çalışılan gün → agent sayısı: {_cal_dag.to_dict()}")
        print(f"  ISO hafta gün-tipi toplamı (eşleşen {len(_es)} agent): "
              f"çalışma {sum(onceki_gun[a] for a in _es)} | off {sum(onceki_off[a] for a in _es)} | "
              f"izin {sum(onceki_izin[a] for a in _es)} | off_t/off_t2 {sum(onceki_offt[a] for a in _es)}")
        # sağlama: 4 sayacın toplamı ISO hafta gün sayısına eşit olmalı
        # (değilse o agentta eksik gün ya da tanınmayan değer var → aşağıdaki uyarılarda görünür)
        _uyusmaz = [a for a in _es if onceki_gun[a] + onceki_izin[a] + onceki_off[a]
                    + onceki_offt[a] != len(TASIMA_GUNLER)]
        if _uyusmaz:
            print(f"  ⚠ {len(_uyusmaz)} agentta sayaç toplamı {len(TASIMA_GUNLER)} değil: {_uyusmaz[:10]}")
    _son_cal = sum(1 for a in _es if onceki_son_vardiya.get(a))
    print(f"  {ONCEKI_SON} günü çalışan: {_son_cal} agent → 11 saat kuralı bunlarda {AY_ILK}'e taşacak")
    _tip_dag = pd.Series([onceki_tip.get(a) for a in _agent_set & _tablo_set
                          if onceki_tip.get(a)]).value_counts()
    print(f"  hafta içi vardiya tipi dağılımı: {_tip_dag.to_dict()}")
    _ek_dag = pd.Series({a: onceki_eksik.get(a, 0) for a in _es}).value_counts().sort_index()
    print(f"  SINIR HAFTASI ALACAĞI (hafta içi off → bu ayın hafta sonu NORM sayılır): "
          f"{_ek_dag.to_dict()}  |  bu aya düşen gün: {SINIR_AY_GUN} (tavan {len(SINIR_AY_GUN)})")
    if _tasima_uyari:
        print(f"  ⚠ {len(_tasima_uyari)} uyarı (ilk 10): {_tasima_uyari[:10]}")
    else:
        print("  ✓ eksik gün / tanınmayan değer yok")


# %% [HÜCRE 9] — CP-SAT MODEL + KARAR DEĞİŞKENLERİ ─────────────────────
# x[(agent, gün, vardiya)] = 1 → o agent o gün o vardiyada çalışıyor.
# BLOK gün için değişken AÇILMAZ (o gün atanamaz): izin ∪ off_block (SADECE off_t2).
#   izin   → bloklu, kotadan DÜŞER (H17)
#   off_t2 → bloklu, kota düşmez (SERT talep, her zaman karşılanır)
#   off_t  → BLOKLU DEĞİL (yumuşak talep): değişken açılır, model karşılamazsa
#            H20B(3) cezası yer → "verebildiğini ver". Karşılanmayan gün Excel'de kırmızı.
model = cp_model.CpModel()

x = {}
for a in AGENTS:
    bloklu = izin_map.get(a, set()) | off_block_map.get(a, set())   # izin + off_t2
    for ds in PLAN_GUNLER:
        if dt.date.fromisoformat(ds) in bloklu:
            continue
        for v in gun_vardiyalari[ds]:
            x[(a, ds, v)] = model.NewBoolVar(f"x_{a}_{ds}_{v}")

ust_sinir = len(AGENTS) * len(talep)
print(f"karar değişkeni: {len(x)}  (izinsiz üst sınır {ust_sinir}; "
      f"blok (izin+off_t2) günleri düşüldü → {ust_sinir - len(x)} adet açılmadı)")

# ── TEŞHİS ALTYAPISI (TESHIS_MODU) ────────────────────────────────────
# Gevşetilebilir sert kural grupları birer "varsayım" literaline bağlanır.
# INFEASIBLE olursa CP-SAT hangi varsayım kümesinin yettiğini söyler (H21) →
# suçlu kural tek koşuda çıkar. TESHIS_MODU=False iken hiçbir şey değişmez.
_teshis = []                                       # (ad, literal)


def _tes_ekle(ad, *ktlar):
    """TESHIS_MODU açıksa verilen kısıtları tek bir varsayım literaline bağlar."""
    if not TESHIS_MODU or not ktlar:
        return
    _b = model.NewBoolVar(f"AS_{ad}")
    for _kt in ktlar:
        _kt.OnlyEnforceIf(_b)
    _teshis.append((ad, _b))


# %% [HÜCRE 10] — COVERAGE (serbest bölge ±SERBEST, SERT BAND YOK) ─────
# Sert üst/alt sınır YOK → kova talebi aşılabilir veya eksik bırakılabilir.
# (Sert min-çalışma feasible olsun diye coverage serbest esner.)
# Serbest bölge: talep ± SERBEST arası BEDAVA; ötesi cezalı (W_COVERAGE ağırlık).
UB = len(AGENTS)                              # sapma üst sınırı (en fazla tüm agentlar)
amac = []                                     # amaç fonksiyonu terimleri (minimize edilecek)
cov = {}
n_eksik = 0                                   # eksik cezası konan kova sayısı (özet için)
n_min = 0                                     # MIN_KOVA sert tabanı konan kova sayısı
for (ds, v), kisi in talep.items():
    katilan = []                              # bu çiftte değişkeni olan agentlar
    for a in AGENTS:
        if (a, ds, v) in x:
            katilan.append(x[(a, ds, v)])
    atanan = sum(katilan)
    _hs = dt.date.fromisoformat(ds).weekday() >= 5
    # SERT band'lar: hafta sonu coverage'a TAM otursun; hafta içi gece yığılmasın.
    if _hs:                                              # HAFTA SONU → talep ± HS_TOL (sıkı)
        model.Add(atanan >= kisi - HS_TOL)               #   takım bütünlüğü yok → boşaltılmasın
        model.Add(atanan <= kisi + HS_TOL)
    elif saat[(ds, v)][0] in GECE_BASLANGIC:             # HAFTA İÇİ GECE → talep ± GECE_BUFFER
        model.Add(atanan >= kisi - GECE_BUFFER)          #   fazlalık geceye yığılamaz, gündüzde kalır
        model.Add(atanan <= kisi + GECE_BUFFER)
    # HAFTA İÇİ GÜNDÜZ → sert band YOK, esnek (aşağıdaki konveks ceza)
    # SERT TABAN: aktif kova boş kalamaz. Hafta içi gündüzde band olmadığı ve
    # W_EKSIK_HI=0 olduğu için model bir vardiyayı tamamen boşaltabiliyordu;
    # takım-tip kilidi (H19) geldikten sonra bu risk arttı (bir tipe hiç takım
    # atanmayabilir). min(...) → talebi MIN_KOVA'dan küçük kovada talep kadar.
    if MIN_KOVA and katilan:
        model.Add(atanan >= min(MIN_KOVA, kisi))
        n_min += 1
    sapma = model.NewIntVar(0, UB, f"sapma_{ds}_{v}")
    model.Add(sapma >= atanan - kisi)         # sapma ≥ |atanan - talep|
    model.Add(sapma >= kisi - atanan)
    # konveks ceza: 0–5 bedava | 5–15 normal | 15+ ağır
    ceza1 = model.NewIntVar(0, UB, f"covceza1_{ds}_{v}")
    model.Add(ceza1 >= sapma - SERBEST_COVERAGE)  # SERBEST'i (5) aşan kısım
    ceza2 = model.NewIntVar(0, UB, f"covceza2_{ds}_{v}")
    model.Add(ceza2 >= sapma - AGIR_ESIK)         # AGIR_ESIK'i (15) aşan kısım (ekstra)
    amac.append(W_COVERAGE * ceza1 + W_COVERAGE2 * ceza2)
    # ASİMETRİK EKSİK CEZASI: yukarıdaki sapma simetrik ve ±SERBEST bedava →
    # kovayı eksik bırakmak bedavaydı. Burada sadece EKSİK yön, ilk kişiden
    # itibaren cezalandırılıyor (fazla yön dokunulmadan kalıyor).
    _w_eksik = W_EKSIK_HS if _hs else W_EKSIK_HI
    if _w_eksik:
        eksik = model.NewIntVar(0, UB, f"eksik_{ds}_{v}")
        model.Add(eksik >= kisi - atanan)     # ReLU: max(0, talep − atanan)
        amac.append(_w_eksik * eksik)
        n_eksik += 1
    cov[(ds, v)] = sapma

print(f"coverage: {len(cov)} çift (serbest ±{SERBEST_COVERAGE}, ağır eşik ±{AGIR_ESIK}; "
      f"sert sınır YOK, konveks ceza)")
print(f"  eksik cezası (asimetrik, ilk kişiden): {n_eksik} kova  "
      f"(hafta sonu ağ. {W_EKSIK_HS}, hafta içi ağ. {W_EKSIK_HI})")
print(f"  MIN_KOVA sert tabanı (aktif kova boş kalamaz): {n_min} kova, "
      f"en az {MIN_KOVA} kişi")


# %% [HÜCRE 11] — GÜNDE ≤1 VARDİYA ──────────────────────────────────────
# Bir agent bir günde en fazla 1 vardiyada çalışır (0 = o gün off).
n = 0
for a in AGENTS:
    for ds in PLAN_GUNLER:
        gunun = []                            # bu agentın o günkü vardiya değişkenleri
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) in x:
                gunun.append(x[(a, ds, v)])
        if gunun:
            model.Add(sum(gunun) <= 1)
            n += 1

print(f"günde ≤1 vardiya kısıtı: {n} (agent × gün)")


# %% [HÜCRE 12] — 7 GÜN ÜST ÜSTE ÇALIŞAMAZ (≥1 off) ────────────────────
# KAYAN 7 GÜNLÜK PENCERE: her 7 ardışık takvim gününde ≤6 çalışma.
# ISO-hafta sınırını aşan ardışıklığı da yakalar (spec 5.1-4).
# ÖNCEKİ AY TAŞIMASI (H8C): gün gün → onceki_calisti (PENCERE_GUNLER = son 6 gün).

# PLAN_GUNLER'i ISO-haftalara grupla — bu kısıt kullanmıyor ama H16C / H17B /
# H20B / H20D / H20E bu sözlüğü kullanıyor, ilk kuran hücre burası.
haftalar = {}
for ds in PLAN_GUNLER:
    yil, hafta, _ = dt.date.fromisoformat(ds).isocalendar()
    haftalar.setdefault((yil, hafta), []).append(ds)

# Pencere ayın 1. gününden ÖNCE de başlar (önceki aya sarkan 6 pencere):
#   Σ(ay içi değişken) ≤ 6 − (o pencereye düşen ÖNCEKİ AY çalışma günü)
# Ör. 07-27..08-02 penceresi: Temmuz'da 5 gün çalışmışsa 08-01/02'den en fazla 1'i.
gunler_d = [dt.date.fromisoformat(ds) for ds in PLAN_GUNLER]
_pen_bas = [AY_ILK - dt.timedelta(days=k) for k in range(6, 0, -1)] + gunler_d   # taşan + ay içi
n, n_tas = 0, 0
_tas_tavan = {}                                     # agent → taşan pencerelerdeki EN DÜŞÜK tavan
for a in AGENTS:
    _calisti = onceki_calisti.get(a, set())         # önceki ayda çalıştığı günler (H8C)
    for s in _pen_bas:
        if s + dt.timedelta(days=6) > gunler_d[-1]:
            continue                                # pencere ayın sonunu taşıyor → dur
        pencere = [s + dt.timedelta(days=k) for k in range(7)]
        pencere_varlar = []
        for d in pencere:
            ds = d.isoformat()
            for v in gun_vardiyalari.get(ds, []):
                if (a, ds, v) in x:
                    pencere_varlar.append(x[(a, ds, v)])
        if not pencere_varlar:
            continue
        onceki_cal = sum(1 for d in pencere if d < AY_ILK and d in _calisti)
        tavan = max(0, 6 - onceki_cal)              # önceki aydan gelen çalışma tavandan düşer
        model.Add(sum(pencere_varlar) <= tavan)
        n += 1
        if onceki_cal:                              # taşıma gerçekten ısırdı mı
            n_tas += 1
            _tas_tavan[a] = min(_tas_tavan.get(a, 6), tavan)

print(f"peş peşe ≤6 gün kısıtı (kayan 7 gün): {n} (agent × pencere)")
if n_tas:
    _td = pd.Series(_tas_tavan).value_counts().sort_index().to_dict()
    print(f"  önceki ay taşıması: {n_tas} pencerede ısırdı, {len(_tas_tavan)} agent  |  "
          f"en düşük tavan → agent sayısı: {_td}  (0 = ay başında hiç çalışamaz)")

# %% [HÜCRE 13] — SABAH ÇALIŞANLAR (bitiş ≤ 20:00) ─────────────────────
# sabah_calisir_flg=1 → yalnız aynı gün biten ve bitişi ≤20:00 vardiyalar.
# Uygun olmayan (gün, vardiya) için o agentın değişkeni = 0.
def dakika(t):                                     # "09:00" → 540, "24:00"/"00:00" → 1440
    s, d = str(t).split(":")
    m = int(s) * 60 + int(d)
    return 1440 if m == 0 else m                    # 00:00 = gece yarısı (gün sonu)

LIMIT = dakika("20:00")                            # 1200

sabah_agents = set()
for _, row in df_tam.iterrows():
    if pd.to_numeric(row.get("sabah_calisir_flg", 0), errors="coerce") == 1:
        sabah_agents.add(str(row["agent_user_code"]).strip())

n = 0
for a in sabah_agents:
    for ds in PLAN_GUNLER:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) not in x:
                continue
            bas, bit = saat[(ds, v)]
            uygun = dakika(bas) < dakika(bit) and dakika(bit) <= LIMIT
            if not uygun:
                model.Add(x[(a, ds, v)] == 0)      # bu vardiyada çalışamaz
                n += 1

print(f"sabah çalışan agent: {len(sabah_agents)}  |  yasaklanan (agent,gün,vardiya): {n}")


# %% [HÜCRE 14] — HAMİLE / SÜT: HAFTA SONU ÇALIŞAMAZ ──────────────────
# hamile_flg / sut_izni_flg = 1 → Cmt/Pzr çalışamaz.
# (≤20:00 bu agentlarda zaten sabah_calisir ile sağlanıyor.
#  Resmi tatil kısmı, tatil takvimi girdisi gelince eklenecek.)
hafta_sonu_yasak = set()
for _, row in df_tam.iterrows():
    hamile = pd.to_numeric(row.get("hamile_flg", 0), errors="coerce") == 1
    sut    = pd.to_numeric(row.get("sut_izni_flg", 0), errors="coerce") == 1
    if hamile or sut:
        hafta_sonu_yasak.add(str(row["agent_user_code"]).strip())

n = 0
for a in hafta_sonu_yasak:
    for ds in PLAN_GUNLER:
        if dt.date.fromisoformat(ds).weekday() < 5:    # hafta içi → serbest
            continue
        for v in gun_vardiyalari[ds]:                  # Cmt/Pzr → yasak
            if (a, ds, v) in x:
                model.Add(x[(a, ds, v)] == 0)
                n += 1

print(f"hafta sonu yasaklı agent (hamile/süt): {len(hafta_sonu_yasak)}  |  "
      f"yasaklanan (agent,gün,vardiya): {n}")


# %% [HÜCRE 14B] — KIDEM: MIN_KIDEM_AY'DAN AZ → GECE (00:00) YASAK ─────
# Kıdemi MIN_KIDEM_AY(6) aydan az olan agent, başlangıcı GECE_BASLANGIC
# ("00:00"/"24:00") olan hiçbir kovada çalışamaz — hafta içi ve hafta sonu.
# Kaynak: df_kidem.kidem_ay (ondalıklı ay). Kıdemi BİLİNMEYEN → kıdemli sayılır.
#
# TAKIM BÜTÜNLÜĞÜ KAPISI (kritik) — `tip_yasak`:
# H19 üyeyi takımının haftalık tipine SERT bağlıyor; tek istisna "fiziksel
# imkânsızlık" ve bunu şöyle tespit ediyordu:  (a, wk, tip) not in agent_tip
# yani "o tipte DEĞİŞKENİ YOK". Burada değişken VAR, sadece 0'a çivileniyor →
# tespit çalışmaz, `sapan` 0'da kalır, takım geceye giderse junior üye hiçbir
# vardiyada çalışamaz ve kota SERT olduğu için model INFEASIBLE olur.
# Çözüm: yasağı ayrıca (agent, tip) kümesi olarak da yayınlıyoruz; H19 bunu
# okuyup o üyeye ayrılma HAKKI veriyor. Ceza (W_TAKIM=10) yerinde kalıyor →
# model geceyi önce junior'ı OLMAYAN takımlara verir, mecbur kalırsa böler.
# NOT: aynı boşluk sabahçı agentlar (H13) için de var — orada da değişken 0'a
# çivileniyor. tip_yasak mekanizması onu da taşıyabilir; şimdilik SADECE kıdem
# kuralı dolduruluyor (tek seferde tek değişiklik).
GECE_TIPLERI = set(GECE_BASLANGIC)                 # {"00:00", "24:00"}
junior_agents = set()                              # kıdemi yetersiz agentlar
tip_yasak = set()                                  # (agent, vardiya başlangıcı) → o tip YASAK

if df_kidem is not None and MIN_KIDEM_AY:
    _kidem_map = dict(zip(df_kidem["agent_user_code"],
                          df_kidem["kidem_ay"]))   # agent → ondalıklı ay
    _bilinmeyen = [a for a in AGENTS
                   if a not in _kidem_map or pd.isna(_kidem_map.get(a))]
    junior_agents = {a for a in AGENTS
                     if a in _kidem_map and pd.notna(_kidem_map[a])
                     and _kidem_map[a] < MIN_KIDEM_AY}
    nk = 0
    for a in junior_agents:
        for ds in PLAN_GUNLER:
            for v in gun_vardiyalari[ds]:
                if (a, ds, v) in x and saat[(ds, v)][0] in GECE_TIPLERI:
                    model.Add(x[(a, ds, v)] == 0)
                    nk += 1
        for _t in GECE_TIPLERI:
            tip_yasak.add((a, _t))                 # H19 ayrılma kapısı bunu okur
    # takım kırılımı: hangi takımda kaç junior var → gece o takıma verilirse
    # kaç kişi ayrılmak zorunda kalır (W_TAKIM cezası buradan gelir)
    _a_takim = dict(zip(df_tam["agent_user_code"].astype(str).str.strip(),
                        df_tam["takim"]))
    _tk_junior = {}
    for a in junior_agents:
        _T = _a_takim.get(a)
        _tk_junior[_T] = _tk_junior.get(_T, 0) + 1
    print(f"kıdem/gece kuralı: kıdem < {MIN_KIDEM_AY} ay olan {len(junior_agents)} agent → "
          f"{nk} (agent,gün,vardiya) gece yasağı  |  {len(tip_yasak)} (agent,tip) "
          f"takım ayrılma hakkı")
    if _bilinmeyen:
        print(f"  ⚠ {len(_bilinmeyen)} agentın kıdemi df_kidem'de YOK/okunamadı → "
              f"KIDEMLİ sayıldı (gece yazılabilir): "
              f"{_bilinmeyen[:10]}{' ...' if len(_bilinmeyen) > 10 else ''}")
    if _tk_junior:
        print(f"  junior'ı olan takım sayısı: {len(_tk_junior)}/{df_tam['takim'].nunique()}"
              f"  |  en çok junior'lı 5 takım: "
              f"{sorted(_tk_junior.items(), key=lambda kv: -kv[1])[:5]}")

    # ── FİZİBİLİTE ÖN KONTROLÜ: gece kovaları kıdemlilerle dolabiliyor mu? ──
    # Gece kovalarında SERT band var (hafta içi ±GECE_BUFFER, hafta sonu ±HS_TOL)
    # → alt sınırı dolduracak KIDEMLİ agent yoksa model INFEASIBLE olur.
    # 45 dakikalık çözümün sonunda öğrenmek yerine burada listeliyoruz.
    _gece_sorun = []
    for (ds, v), kisi in talep.items():
        if saat[(ds, v)][0] not in GECE_TIPLERI:
            continue
        _hs = dt.date.fromisoformat(ds).weekday() >= 5
        _alt = kisi - (HS_TOL if _hs else GECE_BUFFER)
        _mus = sum(1 for a in AGENTS
                   if (a, ds, v) in x and a not in junior_agents
                   and not (a in hafta_sonu_yasak and _hs)
                   and a not in sabah_agents)      # sabahçı geceye giremez (H13)
        if _mus < _alt:
            _gece_sorun.append((ds, v, kisi, _alt, _mus))
    if _gece_sorun:
        print(f"  ⚠ {len(_gece_sorun)} gece kovasında KIDEMLİ müsait agent, sert band "
              f"alt sınırının ALTINDA → model INFEASIBLE olabilir:")
        for ds, v, kisi, alt, mus in _gece_sorun[:10]:
            print(f"       {ds} {saat[(ds, v)][0]}-{saat[(ds, v)][1]}: talep {kisi} "
                  f"(alt sınır {alt}) ama kıdemli müsait {mus}")
        print(f"     → MIN_KIDEM_AY'ı düşür ya da gece talebini Stage-1'de azalt.")
    else:
        print(f"  ✓ tüm gece kovaları kıdemli agentlarla sert band içinde dolabiliyor")
else:
    print(f"kıdem/gece kuralı: KAPALI "
          f"({'df_kidem yok' if df_kidem is None else 'MIN_KIDEM_AY=0'})")

# ── GENEL TİP YASAĞI: agent o TİPTE hiç çalışamıyorsa H19 kapısını aç ──
# Yukarıdaki kıdem kuralı tip_yasak'a SADECE gece tiplerini yazıyordu. Aynı boşluk
# SABAHÇI (H13) agentlar için de vardı ve daha tehlikeliydi:
#   H13 bitişi >20:00 olan vardiyaları x==0'a ÇİVİLİYOR ama değişkeni SİLMİYOR
#   → H19'un "fiziksel imkânsızlık" tespiti ((a,wk,tip) not in agent_tip) çalışmıyor
#   → sapan 0'da kalıyor → takım 15:00'e giderse sabahçı üye HİÇBİR vardiyada
#     çalışamıyor, kotası SERT → model INFEASIBLE.
# Eskiden görünmüyordu çünkü model o takımları geç tipe hiç göndermiyordu (kaçış
# yolu vardı). H19D "zirve talebi karşıla" diye zorlayınca kaçış kapandı ve
# INFEASIBLE ortaya çıktı — hamile/süt agentların takımlarının hep sabah tipine
# yazılması da bu kilidin belirtisiydi.
# Burada GENEL kural: agent o tipte hafta içi ÇALIŞABİLECEĞİ tek bir kova bile
# bulamıyorsa (H13 sabahçı / H14B kıdem-gece / H14 hamile), o tip ona YASAK →
# H19 ayrılma hakkı verir, takım geç tipe gidebilir, üye gündüz kalır (W_TAKIM=10).
_tip_kova = {}                                     # tip → [(gün, vardiya)] hafta içi
for (_ds, _v) in talep:
    if dt.date.fromisoformat(_ds).weekday() < 5:
        _tip_kova.setdefault(saat[(_ds, _v)][0], []).append((_ds, _v))


def _kova_calisabilir(a, ds, v):
    """agent bu kovada FİİLEN çalışabilir mi (sert 0'a çivilemeler dahil)?"""
    if (a, ds, v) not in x:
        return False                               # izin / off_t2 → değişken yok
    bas, bit = saat[(ds, v)]
    if a in sabah_agents and not (dakika(bas) < dakika(bit) and dakika(bit) <= LIMIT):
        return False                               # H13
    if a in junior_agents and bas in GECE_TIPLERI:
        return False                               # H14B
    if a in hafta_sonu_yasak and dt.date.fromisoformat(ds).weekday() >= 5:
        return False                               # H14 (hafta içi döngüde tetiklenmez)
    return True


_gen_yasak, _gen_agent = 0, set()
for a in AGENTS:
    for _t, _kovalar in _tip_kova.items():
        if (a, _t) in tip_yasak:
            continue                               # kıdem kuralı zaten yazmış
        if not any(_kova_calisabilir(a, _ds, _v) for _ds, _v in _kovalar):
            tip_yasak.add((a, _t))
            _gen_yasak += 1
            _gen_agent.add(a)

print(f"genel tip yasağı: {_gen_yasak} (agent,tip) — {len(_gen_agent)} agent o tipte "
      f"hafta içi hiç çalışamıyor (sabahçı/kıdem) → H19 ayrılma hakkı açıldı")
if _gen_agent:
    _yd = {}
    for a, _t in tip_yasak:
        _yd[_t] = _yd.get(_t, 0) + 1
    print(f"  tip → yasaklı agent sayısı: {dict(sorted(_yd.items()))}")
print(f"  toplam tip_yasak: {len(tip_yasak)} (agent,tip)  [kıdem + genel]")


# %% [HÜCRE 15] — 11 SAAT DİNLENME (vardiyalar arası) ─────────────────
# Ardışık iki gün arasında ≥11 saat dinlenme:
#   önceki bitiş + 11 saat ≤ sonraki başlangıç.
# Gece yarısını aşan vardiya (bitiş ≤ başlangıç) ertesi güne sarkar (+1 gün).
DINLENME = 11 * 60                                  # 660 dk


def bas_dakika(t):                                  # BAŞLANGIÇ: 00:00 → 0 (gün başı)
    s, d = str(t).split(":")                        # (dakika() 00:00'ı 1440 yapar = bitiş için)
    return int(s) * 60 + int(d)


def bitis_abs(bas, bit):
    """gün başından itibaren mutlak bitiş dakikası (aşıyorsa +1 gün)."""
    b0, b1 = bas_dakika(bas), dakika(bit)           # başlangıç 00:00→0, bitiş 00:00→1440
    return b1 if b1 > b0 else b1 + 1440


# ardışık (peş peşe takvim) gün çiftleri
gunler_d = [dt.date.fromisoformat(ds) for ds in PLAN_GUNLER]
ardisik = []
for i in range(len(gunler_d) - 1):
    if (gunler_d[i + 1] - gunler_d[i]).days == 1:
        ardisik.append((gunler_d[i].isoformat(), gunler_d[i + 1].isoformat()))

n = 0
for a in AGENTS:
    for ds1, ds2 in ardisik:
        for v1 in gun_vardiyalari[ds1]:
            if (a, ds1, v1) not in x:
                continue
            bas1, bit1 = saat[(ds1, v1)]
            b1_abs = bitis_abs(bas1, bit1)          # gün1 başına göre bitiş
            for v2 in gun_vardiyalari[ds2]:
                if (a, ds2, v2) not in x:
                    continue
                bas2, _ = saat[(ds2, v2)]
                b2_abs = bas_dakika(bas2) + 1440    # gün2 başlangıcı (00:00→0, +1440)
                if b2_abs - b1_abs < DINLENME:      # dinlenme < 11s → ikisi birden olamaz
                    model.Add(x[(a, ds1, v1)] + x[(a, ds2, v2)] <= 1)
                    n += 1

print(f"11 saat dinlenme kısıtı: {n} (yasaklanan ardışık vardiya çifti)")

# ── ÖNCEKİ AYDAN TAŞIMA (H8C): son gün bitişi ↔ ayın 1. günü başlangıcı ─
# Önceki ayın SON gününde çalışılan vardiya (onceki_son_vardiya) ile ayın ilk
# günü arasında da 11 saat aranır — aynı hesap (bitis_abs / bas_dakika+1440).
# Ör. 07-31 "15:00-24:00" → 08-01'de 11:00'dan önce başlayan vardiya yasak;
#     07-31 "24:00-08:00" → bitiş ertesi gün 08:00 → 08-01'de 19:00 öncesi yasak.
_ilk_ds = AY_ILK.isoformat()
n_tas, n_agent_tas = 0, 0
if onceki_son_vardiya and _ilk_ds in gun_vardiyalari:
    for a in AGENTS:
        sv = onceki_son_vardiya.get(a)
        if not sv:
            continue                                    # son gün off/izin → dinlenme kısıtı yok
        bas1, bit1 = sv.split("-")
        b1_abs = bitis_abs(bas1, bit1)                   # önceki günün başına göre bitiş
        n_agent_tas += 1
        for v in gun_vardiyalari[_ilk_ds]:
            if (a, _ilk_ds, v) not in x:
                continue
            b2_abs = bas_dakika(saat[(_ilk_ds, v)][0]) + 1440   # ertesi gün başlangıcı
            if b2_abs - b1_abs < DINLENME:
                model.Add(x[(a, _ilk_ds, v)] == 0)
                n_tas += 1

print(f"  önceki aydan 11 saat taşıması: {n_agent_tas} agent önceki ayın son günü "
      f"({TASIMA_GUNLER[-1] if TASIMA_GUNLER else '-'}) çalışmış → {_ilk_ds} için "
      f"{n_tas} (agent,vardiya) yasağı")


# %% [HÜCRE 16] — MESAİYE KALAMAZ: RESMİ TATİL YASAĞI ────────────────
# mesaiye_kalamaz_flg=1 → (a) resmi tatilde çalışamaz,
#                          (b) toplam çalışma günü ≤ ayın iş günü sayısı.
# Hafta sonu yasak DEĞİL: hafta içi izin alıp hafta sonu çalışsa bile tavanı
# (örn. 22) aşmadığı sürece mesai sayılmaz.
TATIL = set(dt.date.fromisoformat(d) for d in RESMI_TATILLER)

# ayın iş günü sayısı = hafta içi günler − resmi tatiller
AYLIK_IS_GUNU = 0
for d in GUN_SET:
    if d.weekday() < 5 and d not in TATIL:
        AYLIK_IS_GUNU += 1

mesai_yok = set()
for _, row in df_tam.iterrows():
    if pd.to_numeric(row.get("mesaiye_kalamaz_flg", 0), errors="coerce") == 1:
        mesai_yok.add(str(row["agent_user_code"]).strip())

# (a) resmi tatilde çalışamaz
yasak = 0
for a in mesai_yok:
    for ds in PLAN_GUNLER:
        if dt.date.fromisoformat(ds) in TATIL:
            for v in gun_vardiyalari[ds]:
                if (a, ds, v) in x:
                    model.Add(x[(a, ds, v)] == 0)
                    yasak += 1

# (b) gün tavanı → yeni H17'de (tüm agentlar için min/max birlikte)
print(f"ayın iş günü: {AYLIK_IS_GUNU}  |  mesaiye kalamaz agent: {len(mesai_yok)}  |  "
      f"tatil yasağı (agent,gün,vardiya): {yasak}  (gün tavanı → H17)")


# %% [HÜCRE 16B] — ARİFE ATAMA KURALI (kısıtlı → sadece 09:00-13:00 ek) ──
# Arife sözde-vardiyası (ARIFE_YARIM 09:00-13:00) H8'de eklendi; coverage'a
# GİRMEZ. Burada KİM neyi alır:
#  • kısıtlı (süt/hamile/mesai) → arife günü SADECE ARIFE_YARIM; tüm GERÇEK
#    kovalar YASAK (öğleden sonra tatil/mesai yapamaz). Yarım vardiya 9-18
#    talebine sayılmaz → o talep tam gün çalışan normal agentlarla dolar.
#  • normal agent → ARIFE_YARIM'ı ALAMAZ (gerçek kovada tam gün; öğleden
#    sonra mesai). Böylece 9-13 çalışanlar "ek/bonus" olur, talebi düşürmez.
#  • mesai (mesaiye_kalamaz) → HAFTA SONU arifede ARIFE_YARIM da YASAK →
#    hafta sonu arifede OFF, hafta içi çalışır (iş birimi Ctesi yarım-gün
#    istemedi). Süt/hamile hafta sonu zaten off (H14).
arife_kisitli = hafta_sonu_yasak | mesai_yok        # süt/hamile + mesaiye_kalamaz
arife_gercek_yasak = 0                               # kısıtlıya yasaklanan gerçek kova
arife_pseudo_yasak = 0                               # normale yasaklanan yarım vardiya
arife_mesai_hs_yasak = 0                             # mesai hafta sonu arifede off
for ds in PLAN_GUNLER:
    hafta_sonu = dt.date.fromisoformat(ds).weekday() >= 5
    if dt.date.fromisoformat(ds) not in ARIFE:
        continue
    for a in AGENTS:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) not in x:
                continue
            if a in arife_kisitli and v != ARIFE_YARIM:
                model.Add(x[(a, ds, v)] == 0)       # kısıtlı → gerçek kova yasak
                arife_gercek_yasak += 1
            elif a in mesai_yok and hafta_sonu and v == ARIFE_YARIM:
                model.Add(x[(a, ds, v)] == 0)       # mesai hafta sonu arifede off
                arife_mesai_hs_yasak += 1
            elif a not in arife_kisitli and v == ARIFE_YARIM:
                model.Add(x[(a, ds, v)] == 0)       # normal → yarım vardiya yasak
                arife_pseudo_yasak += 1

print(f"arife atama: {len(ARIFE)} gün, {len(arife_kisitli)} kısıtlı agent (süt/hamile/mesai) → "
      f"gerçek kova yasağı {arife_gercek_yasak}, normale yarım-vardiya yasağı {arife_pseudo_yasak}, "
      f"mesai hafta sonu off {arife_mesai_hs_yasak}")


# %% [HÜCRE 16C] — MESAİYE KALAMAZ: HAFTADA ≤ MÜSAİT HAFTA İÇİ GÜN ─────
# mesaiye_kalamaz agent HAFTA SONU MESAİ yapamaz. Haftalık toplam çalışma ≤
# o haftanın MÜSAİT HAFTA İÇİ günü (wd_say = tatil/izin/off_t hariç hafta içi).
#   • Tüm müsait hafta içi + hafta sonu = MESAİ → YASAK (wd_say aşılır).
#   • Hafta içi bir günü off bırakıp hafta sonu = NORM (toplam yine ≤ wd_say) → serbest.
# NOT: eski "≤5" sabiti, hafta içi izinli agentta (ör. Cuma izin → 4 gün) Pzt-Per + Cmt = 5
#      ≤ 5 geçiyordu ama o Cmt MESAİ oluyordu (T=4). wd_say ile bu kapatıldı.
#      H17B tatil haftalarında zaten wd_say uyguluyor; bu her haftaya genelliyor.
# SINIR HAFTASI TAŞIMASI (H8C): o hafta ÖNCEKİ AYA taşıyorsa iki taraf da tamamlanır —
#   sol:  ay içi çalışma + önceki ayda çalışılan gün (onceki_gun)
#   sağ:  ay içi müsait hafta içi + önceki ay müsait hafta içi (onceki_musait_hi)
# Taşımasız hali Ağustos'ta wd_say=0 verip bu agentları 01-02'de tamamen kapatıyordu;
# doğrusu: Temmuz'da 5 gün çalıştıysa kapalı, 4 gün + 1 off ise 1 gün (NORM) serbest.
nm, nm_tas = 0, 0
for a in mesai_yok:
    for wk, hafta_gunleri in haftalar.items():
        wd_say = sum(1 for ds in hafta_gunleri            # müsait hafta içi (tatil/izin/off_t hariç)
                     if dt.date.fromisoformat(ds).weekday() < 5
                     and dt.date.fromisoformat(ds) not in TATIL
                     and any((a, ds, v) in x for v in gun_vardiyalari[ds]))
        haftalik = [x[(a, ds, v)] for ds in hafta_gunleri
                    for v in gun_vardiyalari[ds] if (a, ds, v) in x]
        if haftalik:
            tavan = wd_say
            if wk == SINIR_HAFTA and a in onceki_gun:
                tavan = max(0, wd_say + onceki_musait_hi.get(a, 0) - onceki_gun[a])
                nm_tas += 1
            model.Add(sum(haftalik) <= tavan)             # ≤ müsait hafta içi → hafta sonu MESAİ olamaz
            nm += 1

print(f"mesaiye kalamaz haftada ≤müsait hafta içi gün: {len(mesai_yok)} agent, {nm} (agent,hafta) kısıtı"
      + (f"  |  sınır haftası taşıması: {nm_tas} agent" if nm_tas else ""))


# %% [HÜCRE 16D] — AKŞAM/GECE: AYDA ≤ MAX_AKSAM_HAFTA (sert rotasyon) ────
# Bir agent ay içinde EN FAZLA MAX_AKSAM_HAFTA(2) ISO haftada akşam/gece
# vardiyası çalışabilir (3. hafta yasak). Akşam/gece = başlangıç ≥ AKSAM_BASLANGIC
# (17:00; gece 00:00→1440 dahil). H20 gereği agent hafta boyu tek tipte → "gece
# başladıysa hafta boyu gece" → sayım HAFTA bazında. H20D bunun YUMUŞAK adalet
# hali (>1 haftaya ceza); bu SERT tavan (>MAX imkânsız).
# NOT: "2 ayda 1" (aylar arası) kısmı tek-ay modelinde yapılamaz.
_aksam_dk = dakika(AKSAM_BASLANGIC)
gece_gv_set = {(ds, v) for (ds, v) in talep if dakika(saat[(ds, v)][0]) >= _aksam_dk}
ng = 0
_kt_aksam = []                                       # TESHIS_MODU: akşam tavanı kısıtları
for a in AGENTS:
    hafta_ind = []                                   # her hafta: agent o hafta akşam/gece mi (0/1)
    for wk, gunler in haftalar.items():
        wv = [x[(a, ds, v)] for ds in gunler for v in gun_vardiyalari[ds]
              if (a, ds, v) in x and (ds, v) in gece_gv_set]
        if wv:
            ind = model.NewBoolVar(f"gecehaf_{a}_{wk[0]}{wk[1]}")
            for xv in wv:
                model.Add(ind >= xv)                 # o hafta akşam/gece varsa gösterge 1
            hafta_ind.append(ind)
    if hafta_ind:
        _kt_aksam.append(model.Add(sum(hafta_ind) <= MAX_AKSAM_HAFTA))  # ayda ≤ MAX
        ng += 1
_tes_ekle("H16D_aksam_hafta_tavani", *_kt_aksam)

print(f"akşam/gece ayda ≤{MAX_AKSAM_HAFTA} hafta (sert): {ng} agent, "
      f"{len(gece_gv_set)} akşam/gece kovası")


# %% [HÜCRE 17] — ÇALIŞMA GÜN ARALIĞI (kota ≤ çalışma ≤ kota+mesai+tatil) ─
# Her agent kotası = AYLIK_IS_GUNU − hafta içi izin (SERT, doldurmak zorunda).
#   normal           → kota ≤ çalışma ≤ kota+2+tatil  (≤2 mesai + resmi tatilde çalışma)
#   hamile/süt/mesai → çalışma = kota                 (mesai/tatil yok)
# Tatil payı: resmi tatil günleri kotadan düşük (H16); normal agent, talep varsa
# bunları EKSTRA çalışabilir → tavana TÜM resmi tatil günü sayısı eklenir
# (hafta içi + hafta sonu). Sadece izin verir, zorlamaz (talep yoksa boş kalır).
# Örn: 3 gün hafta içi izin + 1 resmi tatil → kota=18 → normal 18..21, özel 18.
ozel_agents = hafta_sonu_yasak | mesai_yok       # hamile/süt + mesaiye_kalamaz
tatil_gun = len(TATIL)                            # resmi tatil günü sayısı (H16'dan)
kota_map, ust_map = {}, {}                        # H23 raporu GERÇEK değerleri okusun (sapma olmasın)
n_kredi = 0                                       # sınır haftası alacağı verilen agent sayısı
kredi_map = {}                                    # agent → kredi (IntVar ya da 0) — H20E AYNI
                                                  # ifadeyi kullansın diye saklanıyor (aşağıda)

for a in AGENTS:
    tum = []
    for ds in PLAN_GUNLER:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) in x:
                tum.append(x[(a, ds, v)])
    if not tum:
        continue
    calisma = sum(tum)
    hi_izin = sum(1 for d in izin_map.get(a, set())
                  if d in GUN_SET and d.weekday() < 5
                  and d not in TATIL)                   # hafta içi izin (tatil HARİÇ → çift sayma yok)
    kota = max(0, AYLIK_IS_GUNU - hi_izin)
    if kota == 0:
        continue
    _pay = 0 if a in ozel_agents else MAX_MESAI           # özel flag (hamile/süt/mesai) → mesai yok
    tatil_var = [x[(a, ds, v)] for ds in PLAN_GUNLER      # resmi tatilde çalışma değişkenleri
                 if dt.date.fromisoformat(ds) in TATIL
                 for v in gun_vardiyalari[ds] if (a, ds, v) in x]
    # SINIR HAFTASI ALACAĞI (H8C): önceki ayın son haftasında hafta içi off almışsa,
    # o haftanın 5. günü bu ayın hafta sonuna düşer → MESAİ sayılmasın. Alacak ancak
    # o gün FİİLEN çalışılırsa açılır (kredi ≤ sınır hafta sonu çalışması), yoksa
    # agent alacağı ayın ortasındaki sıradan bir günde harcardı.
    _ek = onceki_eksik.get(a, 0)
    kredi = 0
    if _ek:
        sinir_var = [x[(a, ds, v)] for ds in SINIR_AY_GUN
                     for v in gun_vardiyalari[ds] if (a, ds, v) in x]
        if sinir_var:
            kredi = model.NewIntVar(0, _ek, f"kredi_{a}")
            model.Add(kredi <= sum(sinir_var))
            n_kredi += 1
    kredi_map[a] = kredi                                  # H20E oransal mesai tavanı AYNI
                                                          # ifadeyi kullanacak (rapor=kısıt)
    ust = kota + _pay + tatil_gun + _ek                   # TOPLAM tavan (tatil + alacak dahil)
    kota_map[a], ust_map[a] = kota, ust                  # H23 raporu için gerçek değerler
    model.Add(calisma >= kota)                            # SERT taban: kotayı doldur
    # SERT tavan — resmi tatilde çalışma HARİÇ: mesai_gun (H22) ile BİREBİR aynı ölçü.
    #   mesai_gun = (calisma − tatil_çalışma) − kota  →  bu kısıt onu ≤ MAX_MESAI yapar.
    # Eskiden `calisma <= kota + MAX_MESAI + tatil_gun` idi; tatil payı KOŞULSUZ
    # veriliyordu → agent tatili çalışmasa bile o payı NORMAL bir günde kullanıp
    # mesai_gun = MAX_MESAI + tatil_gun'a çıkabiliyordu (MAX_MESAI=2 iken 3 mesai).
    # Artık pay ancak tatil FİİLEN çalışılırsa açılıyor.
    model.Add(calisma - sum(tatil_var) - kredi <= kota + _pay)
    model.Add(calisma <= ust)                             # toplam tavan (yukarıdakinin sonucu)

print(f"çalışma aralığı: {len(AGENTS)} agent  (kota=iş günü−haftaiçi_izin; "
      f"normal kota..kota+{MAX_MESAI}(mesai)+{tatil_gun}(tatil), özel flag={len(ozel_agents)} =kota)"
      + (f"  |  sınır haftası alacağı: {n_kredi} agent" if n_kredi else ""))


# %% [HÜCRE 17B] — RESMİ TATİL HAFTASI: ÖZEL AGENT HAFTALIK KOTA (sert) ─
# SADECE resmi tatil içeren haftalarda: özel flag (süt/hamile/mesai) agent
# o hafta EN FAZLA o haftanın MÜSAİT HAFTA İÇİ günü kadar çalışır.
#   wd_say = (hafta içi gün) − (resmi tatil) − (izin)   ← DİNAMİK, sabit değil
#   1 tatil → 4, 2 tatil → 3 ...  arife resmi tatil değil → hafta içi sayılır.
# 5. gün (hafta sonu) mesai olurdu → yapamaz. Aylık kotayı haftalara dengeli
# yayar (Cmt yerine boş bıraktığı hafta içi günü çalışır). Diğer haftalar serbest.
# Normal agent hariç (onlar 5→1 mesai, 6→2 mesai yapabilir; mesai_gun böyle sayar).
ntk = 0
for a in ozel_agents:
    for gunler in haftalar.values():
        if not any(dt.date.fromisoformat(ds) in TATIL for ds in gunler):
            continue                                   # tatil haftası değil → serbest
        wd_say = sum(1 for ds in gunler                # müsait hafta içi (tatil hariç, izinsiz)
                     if dt.date.fromisoformat(ds).weekday() < 5
                     and dt.date.fromisoformat(ds) not in TATIL
                     and any((a, ds, v) in x for v in gun_vardiyalari[ds]))
        haftalik = [x[(a, ds, v)] for ds in gunler
                    for v in gun_vardiyalari[ds] if (a, ds, v) in x]
        if haftalik and wd_say:
            model.Add(sum(haftalik) <= wd_say)         # ≤ müsait hafta içi → 5. gün yasak
            ntk += 1

print(f"resmi tatil haftası özel kota: {ntk} (özel agent, tatil haftası) kısıtı")


# %% [HÜCRE 18] — AYDA ≥1 ÇİFT HAFTA SONU OFF (sert) ──────────────────
# Her agent ay boyunca en az bir Cmt+Pzr çiftini BİRLİKTE off geçirmeli.
gset = set(PLAN_GUNLER)
hs_ciftleri = []                                 # ardışık (Cmt, Pzr) çiftleri
for ds in PLAN_GUNLER:
    d = dt.date.fromisoformat(ds)
    if d.weekday() == 5:                          # Cumartesi
        pzr = (d + dt.timedelta(days=1)).isoformat()
        if pzr in gset:
            hs_ciftleri.append((ds, pzr))

n = 0
_kt_cift = []                                    # TESHIS_MODU: çift hafta sonu off kısıtları
if CIFT_HS_OFF:
    for a in AGENTS:
        cift_off = []
        for cmt, pzr in hs_ciftleri:
            gun_var = [x[(a, cmt, v)] for v in gun_vardiyalari[cmt] if (a, cmt, v) in x]
            gun_var += [x[(a, pzr, v)] for v in gun_vardiyalari[pzr] if (a, pzr, v) in x]
            co = model.NewBoolVar(f"ciftoff_{a}_{cmt}")
            for xv in gun_var:
                model.Add(co + xv <= 1)          # o hafta sonu çalışıyorsa co=0
            cift_off.append(co)
        if cift_off:
            _kt_cift.append(model.Add(sum(cift_off) >= 1))   # ≥1 tam hafta sonu off
            n += 1
    _tes_ekle("H18_cift_hafta_sonu_off", *_kt_cift)
    print(f"çift hafta sonu off: {n} agent (≥1 tam Cmt+Pzr off), "
          f"{len(hs_ciftleri)} hafta sonu")
else:
    print(f"çift hafta sonu off: KAPALI (CIFT_HS_OFF=False) — {len(hs_ciftleri)} "
          f"hafta sonu çifti var ama kısıt kurulmadı")


# %% [HÜCRE 19] — TAKIM BÜTÜNLÜĞÜ (takım hafta boyu TEK tip + cezalı istisna) ─
# Takım o HAFTA tek vardiya-tipinde toplanır. Üç parça:
#   agent_tip[a,hafta,tip]  : agent o hafta bu tipte çalışıyor mu   (gösterge)
#   takim_tip[T,hafta,tip]  : takımın o haftaki tipi                (SERT, tam 1)
#   takim_sapan[a,hafta]    : üye takımının tipinden ayrıldı mı     (YUMUŞAK, W_TAKIM)
#   kısıt: agent_tip[a,wk,bas] ≤ takim_tip[T,wk,bas] + takim_sapan[a,wk]
# Yalnız HAFTA İÇİ; resmi tatil haftası muaf (tatil düzeni bozar).
#
# NEDEN DEĞİŞTİ — eski kurgu cezayı SONRADAN veriyordu: model herkesi serbestçe
# dağıtıyor, sonra "bu takım 3 tipe bölünmüş" diye ceza yazıyorduk. İki sorun:
#   (a) Gradyansız: ceza kullanılan TİP sayısına bakıyordu, kaç kişinin ayrıldığına
#       değil → 19/1 ile 10/10 aynı cezayı yiyordu; ilk kişiden sonrası bedavaydı.
#   (b) LP gevşemesi çok gevşek → alt sınır negatif kalıyor, çözücü 2700 sn'de bile
#       yakınsamıyordu (gap %104, amacın %84'ü bu ceza, takım-haftaların yalnız
#       54/145'i tek tip). Ağırlığı 100→300 yapmak hiçbir şeyi değiştirmedi.
# Yeni kurguda dallanma uzayı takım×hafta×tip (~1160 ikili) — çözücünün kapatabileceği
# bir yapı; takım bütünlüğü ceza satın alınan bir şey değil, modelin iskeleti.

# ISO-haftalar (H19 kendi içinde kursun → hücre tek başına da çalışsın)
haftalar = {}
for ds in PLAN_GUNLER:
    yil, hafta, _ = dt.date.fromisoformat(ds).isocalendar()
    haftalar.setdefault((yil, hafta), []).append(ds)

# hafta içi resmi tatil olan haftalar → o hafta takım tek-tip cezası GEVŞETİLİR
# (tatil düzeni bozar; vardiya farklılaşabilir).
tatil_haftalari = {dt.date.fromisoformat(t).isocalendar()[:2]
                   for t in RESMI_TATILLER if dt.date.fromisoformat(t).weekday() < 5}

# SINIR HAFTASI (H19E): o haftada takım tek-tip kuralı ARANMAZ — hafta önceki ayın
# çizelgesiyle başlıyor ve o çizelge bu modelden çıkmadığı için takımlar orada
# bölünmüş olabilir. Herkesi kendi 31 Ağustos tipine kilitlerken takıma da "tek tip"
# dersek ikisi çakışır ve model çözümsüz olur. Bütünlük ertesi hafta geri gelir.
# NOT: bu muafiyet SADECE (3)'ü — takım seçimini — kapsar. (1)'deki agent_tip
# göstergesi kurulmaya devam eder, yoksa H20 (agent haftada tek tip) ve H19E kilidi
# o hafta dayanacak bir şey bulamaz.
KILIT_HAFTA = (SINIR_HAFTA if (SINIR_TIP_KILIT and TASIMA_GUNLER
                               and SINIR_HAFTA in haftalar) else None)

# takım → üye agent kodları  +  tüm başlangıç-tipleri
takimlar = {}
for _, row in df_tam.iterrows():
    takimlar.setdefault(row["takim"], []).append(str(row["agent_user_code"]).strip())
TIP_SET = sorted({saat[(ds, v)][0] for (ds, v) in talep})

# (1) agent-hafta-tip göstergesi: agent o hafta bu tipte çalışıyor mu.
#     H20 de AYNI sözlüğü kullanır → gösterge bir kez üretilir (eskiden H19 ve
#     H20 ayrı ayrı üretiyordu; değişken/kısıt sayısı yarıya iner).
#     Sadece HAFTA İÇİ ve tatil-dışı haftalar (hafta sonu tip kuralının dışında).
agent_tip = {}
for a in AGENTS:
    for wk, gunler in haftalar.items():
        if wk in tatil_haftalari:
            continue
        tip_var = {}
        for ds in gunler:
            if dt.date.fromisoformat(ds).weekday() >= 5:
                continue
            for v in gun_vardiyalari[ds]:
                if (a, ds, v) in x:
                    tip_var.setdefault(saat[(ds, v)][0], []).append(x[(a, ds, v)])
        for bas, varlar in tip_var.items():
            ind = model.NewBoolVar(f"at_{a}_{wk[0]}{wk[1]}_{bas}".replace(":", ""))
            for xv in varlar:
                model.Add(ind >= xv)           # bu tipte çalışırsa gösterge 1
            agent_tip[(a, wk, bas)] = ind

# (2) o hafta hangi tiplerin hafta içi kovası VAR (y bunların dışına çıkmasın)
hafta_tipler = {}
for wk, gunler in haftalar.items():
    hafta_tipler[wk] = sorted({saat[(ds, v)][0] for ds in gunler
                               if dt.date.fromisoformat(ds).weekday() < 5
                               for v in gun_vardiyalari[ds] if (ds, v) in talep})

# (3) takımın haftalık tipi (SERT, tam 1) + ayrılan üye (YUMUŞAK)
takim_tip, takim_sapan = {}, {}
n_y = 0
for T, uyeler in takimlar.items():
    for wk in haftalar:
        if wk in tatil_haftalari:              # tatil haftası → kural gevşek
            continue
        if wk == KILIT_HAFTA:                  # sınır haftası → H19E kilidi geçerli,
            continue                           #   takım bütünlüğü aranmaz
        # takımın o hafta gerçekten girebileceği tipler (en az bir üyenin değişkeni var)
        secenek = [bas for bas in hafta_tipler.get(wk, [])
                   if any((a, wk, bas) in agent_tip for a in uyeler)]
        if not secenek:
            continue                           # o hafta hafta içi kova yok (ör. sınır haftası)
        yv = {bas: model.NewBoolVar(f"y_{T}_{wk[0]}{wk[1]}_{bas}".replace(":", ""))
              for bas in secenek}
        model.AddExactlyOne(list(yv.values()))  # takım o hafta TEK tip seçer
        takim_tip.update({(T, wk, bas): b for bas, b in yv.items()})
        n_y += 1
        for a in uyeler:
            uye_tipler = [bas for bas in TIP_SET if (a, wk, bas) in agent_tip]
            if not uye_tipler:
                continue                       # o hafta hiç çalışamıyor (izin/off_t)
            # SERT: üye takımının tipinde kalmak ZORUNDA. Tek istisna FİZİKSEL
            # imkânsızlık — takımın seçtiği tipi üye yapamıyorsa (ör. sabahçı üye,
            # takım 15:00/geceye gitti → o tipte değişkeni yok). Kapı şart, yoksa
            # o üye hiçbir vardiyada çalışamaz ve kota (sert) tutmaz → INFEASIBLE.
            # Eskiden sapan HER ZAMAN açıktı ve ceza ödenerek bölünme satın
            # alınabiliyordu; artık ancak yapamadığı tip seçilirse 1 olabilir.
            # "yapamaz" iki kaynaktan gelir:
            #   (a) o tipte hiç DEĞİŞKENİ yok (izin/off_t2 vb. ile hafta kapanmış)
            #   (b) tip_yasak: değişken VAR ama sert kuralla 0'a çivili (H14B kıdem/gece).
            # (b) olmadan junior üye takımı geceye giderse hiçbir vardiyada çalışamaz
            # ve kota SERT olduğu için model INFEASIBLE olur.
            yapamaz = [yv[bas] for bas in secenek
                       if (a, wk, bas) not in agent_tip or (a, bas) in tip_yasak]
            sv = model.NewBoolVar(f"sap_{a}_{wk[0]}{wk[1]}")
            takim_sapan[(a, wk)] = sv
            if yapamaz:
                model.Add(sv <= sum(yapamaz))  # yapamadığı tip seçilmediyse ayrılamaz
            else:
                model.Add(sv == 0)             # her tipi yapabiliyor → ayrılma HAKKI YOK
            for bas in uye_tipler:
                model.Add(agent_tip[(a, wk, bas)] <= yv.get(bas, 0) + sv)

if takim_sapan:
    amac.append(W_TAKIM * sum(takim_sapan.values()))

print(f"takım bütünlüğü (haftalık): {len(takimlar)} takım, {n_y} (takım,hafta) tek-tip "
      f"seçimi [SERT]  |  {len(takim_sapan)} (üye,hafta) sapma değişkeni "
      f"— ayrılma SADECE fiziksel imkânsızlıkta (ağ. {W_TAKIM})")
print(f"  agent-hafta-tip göstergesi: {len(agent_tip)} (H20 ile ortak)")


# %% [HÜCRE 19B] — GEÇ VARDİYA GEÇMİŞ ADALETİ (takım bazında, df_gecmis) ─
# Geç vardiya (GEC_BASLANGIC=15:00 ve sonrası + gece) yükü TAKIMLAR arasında
# yıllara yayılsın: geçmişte adil payın üstünde geç vardiya yapmış takım, bu ay
# geç bir tipe atanırsa CEZALI. Az yapmış takım cezasız → model onları seçer.
#
# Ölçü ORAN (gün sayısı değil): büyük takımın toplam günü doğal olarak fazla.
#   oran[T]  = takımın geç gün sayısı ÷ toplam gün sayısı
#   ortalama = Σ geç gün ÷ Σ toplam gün        (ağırlıklı, tüm takımlar)
#   katsayı[T] = round(W_GECMIS × max(0, oran[T] − ortalama) × 100)
# Ceza doğrudan takim_tip değişkeninin KATSAYISINA giriyor → yeni değişken YOK,
# model büyümüyor. Takım o hafta geç tipe giderse katsayı kadar ceza yazılır.
# df_gecmis yoksa ya da W_GECMIS=0 ise hücre hiçbir şey yapmaz.
_gec_dk = dakika(GEC_BASLANGIC)                    # "15:00" → 900 (gece 00:00→1440 dahil)
gecmis_katsayi = {}                                # takım → geç tip başına ek ceza
if df_gecmis is not None and W_GECMIS:
    _gec = df_gecmis.copy()
    _gec["_gec_mi"] = _gec["shifts_adj"].map(                        # başlangıç ≥ 15:00 mı
        lambda s: bool(_vardiya_parse(s)) and dakika(_vardiya_parse(s)[0]) >= _gec_dk)
    _gec["_gec_gun"] = _gec["total_gun_sayisi"].where(_gec["_gec_mi"], 0)
    _tk = _gec.groupby("takim")[["_gec_gun", "total_gun_sayisi"]].sum()
    _tk.columns = ["gec", "top"]                                    # takım → geç / toplam gün
    _ort = _tk["gec"].sum() / max(1, _tk["top"].sum())              # ağırlıklı ortalama oran
    for T in takimlar:                                              # SADECE modeldeki takımlar
        if T not in _tk.index or _tk.at[T, "top"] == 0:
            continue                                                # geçmiş verisi yok → nötr
        _oran = _tk.at[T, "gec"] / _tk.at[T, "top"]
        _kat = round(W_GECMIS * max(0.0, _oran - _ort) * 100)
        if _kat:
            gecmis_katsayi[T] = _kat
    _n_gec = 0
    for (T, wk, bas), yv_ in takim_tip.items():
        if T in gecmis_katsayi and dakika(bas) >= _gec_dk:
            amac.append(gecmis_katsayi[T] * yv_)
            _n_gec += 1
    _eslesen = len(set(takimlar) & set(_tk.index))
    print(f"geç vardiya geçmiş adaleti: df_gecmis'te {_eslesen}/{len(takimlar)} takım eşleşti  |  "
          f"ortalama geç oran %{100 * _ort:.1f}  |  cezalı takım {len(gecmis_katsayi)}  |  "
          f"{_n_gec} (takım,hafta,geç tip) terimi (ağ. {W_GECMIS})")
    if gecmis_katsayi:
        _ilk = sorted(gecmis_katsayi.items(), key=lambda kv: -kv[1])[:5]
        print(f"  en cezalı 5 takım (geçmişte en çok geç çalışan): {_ilk}")
else:
    print("geç vardiya geçmiş adaleti: KAPALI "
          f"({'df_gecmis yok' if df_gecmis is None else 'W_GECMIS=0'})")


# %% [HÜCRE 19C] — TAKIM-TİP BAŞLANGIÇ İPUCU (solution hint) ───────────
# SORUN (H25B ile ölçüldü): hafta içi eksiğin ~%86'sı YAPISAL DEĞİL, takım→tip
# tahsisinin kötü olmasından. Çözücü 09:00'a ihtiyaçtan 30-46 kişi FAZLA takım
# atarken 11:00/15:00'ı 20-39 kişi EKSİK bırakıyordu. Her haftada
# Σ(zirve talep) ≤ toplam agent olduğu için daha iyi bir tahsis MATEMATİKSEL
# OLARAK VAR — çözücü 600 sn'de bulamıyor (takım×hafta×tip knapsack'i).
#
# ÇÖZÜM: modeli DEĞİŞTİRMEDEN çözücüye iyi bir başlangıç noktası ver.
#   1) her (hafta, tip) için ZİRVE hafta içi talep (H19 gereği takım hafta boyu
#      o tipte → kapasite zirveyi karşılamalı)
#   2) açgözlü tahsis: takımlar BÜYÜKTEN küçüğe, her biri o an açığı EN BÜYÜK
#      olan tipe → büyük takımlar büyük açıkları kapatır (klasik LPT sezgiseli)
#   3) seçilen y[T,hafta,tip] = 1, diğerleri 0 olarak AddHint
# Hint SADECE arama başlangıcı; kısıt DEĞİL. Çözücü daha iyisini bulursa onu
# kullanır, tutmazsa yok sayar → risk yok, takım bölünmesi yok, ağırlık değişmiyor.
# Hücre ayrıca açgözlü tahsisin bıraktığı açığı basar: çözücünün bulduğuyla
# (H25B [3]) karşılaştırınca ipucunun ne kadar iyi olduğu görünür.
TAKIM_HINT = True                                  # False → hiç ipucu verme (eski davranış)

# TAKIMIN O HAFTADAKİ ETKİN BOYUTU — hem bu hücre hem H19D bunu kullanır.
#   etkin = o haftanın EN DAR hafta içi gününde kaç üyesinin değişkeni var
#           (izin / off_t2 → değişken yok → sahada yok)
# NEDEN ham `len(uyeler)` DEĞİL (H25D [3] ile ölçüldü): bir tipe 183 üyelik takım
# atanmıştı, zirve talebi karşılıyordu; ama o gün 15'i izinliydi → sahada 168 kişi,
# aradaki 15 doğrudan coverage eksiğine dönüştü. Ham boyut izinliyi de sayıyor.
# EN DAR gün alınıyor çünkü takım hafta boyu o tipte kalıyor (H19) → kapasitenin
# haftanın her gününü taşıması gerekir.
takim_etkin = {}                                   # (takım, hafta) → etkin üye (tipten bağımsız)
takim_etkin_tip = {}                               # (takım, hafta, TİP) → o tipte çalışabilen üye
# TİPE DUYARLI SAYIM ŞART — yoksa model INFEASIBLE oluyordu (ölçüldü):
#   H19D geceye 12 kişilik takım atayıp "kapasite 12 ≥ talep 11, tamam" diyordu.
#   Ama o takımın 5'i kıdemsiz (H14B gece yasağı) + 2'si sabahçı (H13) →
#   gerçekte gece çalışabilen 5 kişi. Gece kovasının SERT bandı 8 istiyor → çözümsüz.
#   H19D'den önce model geceyi serbestçe kıdemsizsiz takıma veriyordu; "zirveyi
#   karşıla" zorunluluğu onu yanlış takıma yönlendirdi.
# _kova_calisabilir (H14B) tüm sert çivilemeleri biliyor: izin/off_t2 (değişken yok),
# H13 sabahçı, H14B kıdem-gece, H14 hamile/süt.
for _T, _uy in takimlar.items():
    for _wk2, _gnl in haftalar.items():
        _hi2 = [ds for ds in _gnl if dt.date.fromisoformat(ds).weekday() < 5]
        if not _hi2:
            continue
        takim_etkin[(_T, _wk2)] = min(
            sum(1 for a in _uy
                if any((a, ds, v) in x for v in gun_vardiyalari[ds]))
            for ds in _hi2)
        for _t2 in hafta_tipler.get(_wk2, []):
            takim_etkin_tip[(_T, _wk2, _t2)] = min(
                sum(1 for a in _uy
                    if any(_kova_calisabilir(a, ds, v)
                           for v in gun_vardiyalari[ds]
                           if (ds, v) in talep and saat[(ds, v)][0] == _t2))
                for ds in _hi2)

_hint = {}                                         # y değişkeni → 0/1
_hint_ozet = []                                    # (hafta, açık_önce, açık_sonra)
if TAKIM_HINT and takim_tip:
    _boyut = {T: len(u) for T, u in takimlar.items()}   # ham boyut (yedek)
    for _wk in sorted(haftalar):
        if _wk in tatil_haftalari or _wk == KILIT_HAFTA:   # sınır haftasında y yok
            continue                                       #   (H19E kilidi belirliyor)
        _hi = [ds for ds in haftalar[_wk] if dt.date.fromisoformat(ds).weekday() < 5]
        if not _hi:
            continue
        # (1) tip → o haftanın ZİRVE günlük talebi
        _ihtiyac = {}
        for _t in hafta_tipler.get(_wk, []):
            _ihtiyac[_t] = max((sum(talep[(ds, v)] for v in gun_vardiyalari[ds]
                                    if (ds, v) in talep and saat[(ds, v)][0] == _t)
                                for ds in _hi), default=0)
        if not _ihtiyac:
            continue
        _acik_once = sum(_ihtiyac.values())        # hiç takım atanmamış hâl
        _kalan = dict(_ihtiyac)
        # (2) açgözlü: büyük takım → en büyük açık
        #     boyut TİPE DUYARLI ETKİN — H19D kısıtı da aynı ölçüyü kullanıyor,
        #     yoksa "tanık" bütçesi kısıtla aynı dili konuşmazdı.
        def _kap_tip(T, t):                        # takımın o tipteki gerçek katkısı
            return takim_etkin_tip.get((T, _wk, t), takim_etkin.get((T, _wk), _boyut[T]))

        for T in sorted(takimlar,
                        key=lambda t: -max((_kap_tip(t, _x) for _x in _ihtiyac),
                                           default=0)):
            _uygun = [_t for _t in _ihtiyac if (T, _wk, _t) in takim_tip]
            if not _uygun:
                continue                           # takımın o hafta seçeneği yok
            _sec = max(_uygun, key=lambda t: _kalan.get(t, 0))
            _kalan[_sec] = _kalan.get(_sec, 0) - _kap_tip(T, _sec)
            for _t in _uygun:                      # (3) hint: seçilen 1, diğerleri 0
                _hint[takim_tip[(T, _wk, _t)]] = 1 if _t == _sec else 0
        _hint_ozet.append((_wk, _acik_once,
                           sum(max(0, v) for v in _kalan.values())))
    for _var, _val in _hint.items():
        model.AddHint(_var, _val)

if _hint:
    _top_acik = sum(a for _, _, a in _hint_ozet)
    print(f"takım-tip başlangıç ipucu: {len(_hint)} y değişkenine hint verildi "
          f"({len(_hint_ozet)} hafta)")
    print(f"  açgözlü tahsisin bıraktığı toplam açık: {_top_acik} kişi "
          f"(hafta bazında: {[(f'{w[0]}-W{w[1]}', a) for w, _, a in _hint_ozet]})")
    print(f"  → H25B [3]'teki açıkla karşılaştır: ipucu daha iyiyse çözücü "
          f"buradan başlayıp iyileştirecek (hint kısıt DEĞİL, tutmazsa yok sayılır)")
else:
    print(f"takım-tip başlangıç ipucu: KAPALI "
          f"({'TAKIM_HINT=False' if not TAKIM_HINT else 'takim_tip boş'})")


# %% [HÜCRE 19D] — TİP KAPASİTE KISITI (önce zirve talebi karşıla) ─────
# SORUN (H25D ile ölçüldü): 3 Ağustos 08:00'da talep 59, atanan 26. O tipe
# sadece 2 takım (30 üye) atanmış; 15:00'te ise 96 üye var, zirve talep 56 →
# 40 kişilik pay. Merve Muştu'nun takımı (13 uygun) taşınsaydı kazanç
# 13 × W_EKSIK_HI(25) × 5 gün = 1625, bedeli ~0. Model bu 1625'i masada
# bırakmış → TERCİH değil, BULAMAMA.
#
# NEDEN BULAMIYOR: eksik cezası `x` üzerinde (118 bin değişken), asıl karar ise
# `y[takım,hafta,tip]` üzerinde (~1160 ikili). LP gevşemesinde y KESİRLİ olabildiği
# için "takımın yarısı 08:00'de" gibi bir çözüm eksiği sıfır gösteriyor → alt sınır
# hiçbir zaman "bu tahsis kötü" demiyor, gap kapanmıyor (2700 sn'de %72).
# H19C ipucu doğru noktayı gösteriyor ama KISIT DEĞİL; arama uzaklaşıp dönemiyor.
#
# ÇÖZÜM: kısıtı doğrudan y üzerine koy.
#   kapasite(hafta,tip) = Σ_takım  üye × y[takım,hafta,tip]
#   kapasite + açık ≥ ZİRVE TALEP            (her tip için)
#   Σ_tip açık(hafta) ≤ BÜTÇE(hafta)         (haftalık toplam)
# "Açık kalabilir mi?" → EVET, ama sadece KAÇINILMAZ olduğu kadar. Bütçe:
#   BÜTÇE = max( yapısal açık , açgözlü tahsisin bıraktığı açık ) + TOLERANS
#     yapısal açık = max(0, Σ zirve − o hafta tip seçebilen toplam üye)
#         → kapasite gerçekten yetmiyorsa fark buradan gelir, model o kadar
#           eksik bırakabilir (mecburiyet ölçülüp tam o kadarına izin veriliyor).
#     açgözlü açık = H19C'nin LPT tahsisinin bıraktığı (varsa) → FİZİBİLİTE TANIĞI:
#         o çözüm bu bütçeyi sağladığı için kısıt ASLA INFEASIBLE yapmaz.
#         Takımlar bölünemez olduğu için tam paketleme her zaman mümkün değil;
#         bu terim o yuvarlama payını ölçüp bütçeye ekliyor (tahmin değil, tanık).
# AĞIRLIK YOK — sert kısıt. Eksik cezası (W_EKSIK_HI) zaten x tarafında duruyor,
# bu kısıt onu ARAMA için görünür kılıyor; amaç fonksiyonuna terim EKLENMİYOR.
TIP_KAPASITE_SERT = True     # False → kısıt kurulmaz (eski davranış)
TIP_ACIK_TOLERANS = 0        # bütçeye eklenen ek pay (hafta başına).
                             # 0 güvenli: bütçe zaten açgözlü tanığı içeriyor.
                             # INFEASIBLE gelirse 1-2 artır (yuvarlama payı).

tip_acik = {}                                      # (hafta, tip) → açık IntVar
_19d_ozet = []                                     # (hafta, Σzirve, üye, yapısal, açgözlü, bütçe)
if TIP_KAPASITE_SERT and takim_tip:
    # ETKİN boyut (H19C'de kuruldu): o haftanın en dar hafta içi gününde müsait üye.
    # Ham `len(uyeler)` izinlileri de sayıyordu → tipe yeterli takım atansa bile
    # o gün sahada daha az kişi oluyordu (H25D [3]: 183 atanmış, 15 izinli, 168 sahada).
    _boyut19d = {T: len(u) for T, u in takimlar.items()}   # ham (yedek)
    _greedy = {w: a for w, _, a in _hint_ozet}     # H19C açgözlü artığı (yoksa boş)
    for _wk in sorted(haftalar):
        # SINIR HAFTASI MUAF: o hafta tipler H19E ile önceki aydan geliyor, takım
        # seçimi (y) yok → "zirveyi karşıla" kısıtının dayanacağı değişken de yok.
        # Kurulsaydı kapasite 0 görünür ve bütçe şişerdi (kısıt işlevsiz + kafa karıştıran
        # çıktı). Kilitli dağılımın talebi karşılayıp karşılamadığını H19E kendi
        # ön kontrolünde ölçüp basıyor.
        if _wk in tatil_haftalari or _wk == KILIT_HAFTA:
            continue
        _hi = [ds for ds in haftalar[_wk] if dt.date.fromisoformat(ds).weekday() < 5]
        if not _hi:
            continue
        # o hafta tip SEÇEBİLEN takımlar (y değişkeni olanlar) ve ETKİN toplam üyesi
        _sec_takim = {T for (T, w, _t) in takim_tip if w == _wk}
        _etk = {T: takim_etkin.get((T, _wk), _boyut19d[T]) for T in _sec_takim}
        _uye_top = sum(_etk.values())
        # tip → ZİRVE hafta içi talep (H19: takım hafta boyu o tipte → zirveyi karşılamalı)
        _zirve19d = {}
        for _t in hafta_tipler.get(_wk, []):
            _zirve19d[_t] = max((sum(talep[(ds, v)] for v in gun_vardiyalari[ds]
                                     if (ds, v) in talep and saat[(ds, v)][0] == _t)
                                 for ds in _hi), default=0)
        if not _zirve19d:
            continue
        _yapisal = max(0, sum(_zirve19d.values()) - _uye_top)
        _butce = max(_yapisal, _greedy.get(_wk, 0)) + TIP_ACIK_TOLERANS
        _acik_var, _kt19 = [], []
        for _t, _z in _zirve19d.items():
            # TİPE DUYARLI kapasite: takımın o tipte FİİLEN çalışabilen üyesi
            # (kıdemsiz gece yapamaz, sabahçı geç tip yapamaz → 0 sayılır)
            _kap = sum(takim_etkin_tip.get((T, _wk, _t), _etk[T]) * takim_tip[(T, _wk, _t)]
                       for T in _sec_takim if (T, _wk, _t) in takim_tip)
            _av = model.NewIntVar(0, _z, f"tipacik_{_wk[0]}{_wk[1]}_{_t}".replace(":", ""))
            _kt19.append(model.Add(_kap + _av >= _z))   # zirve talebi karşıla (ya da açık yaz)
            tip_acik[(_wk, _t)] = _av
            _acik_var.append(_av)
        _kt19.append(model.Add(sum(_acik_var) <= _butce))   # açık SADECE kaçınılmaz kadar
        _tes_ekle(f"H19D_tip_kapasite_{_wk[0]}W{_wk[1]}", *_kt19)
        _19d_ozet.append((_wk, sum(_zirve19d.values()), _uye_top,
                          _yapisal, _greedy.get(_wk, 0), _butce))

if _19d_ozet:
    print(f"tip kapasite kısıtı [SERT]: {len(tip_acik)} (hafta,tip) açık değişkeni, "
          f"{len(_19d_ozet)} hafta  (ağırlık YOK)")
    print(f"    {'hafta':>10} {'Σzirve':>7} {'etkin üye':>10} {'yapısal':>8} "
          f"{'açgözlü':>8} {'BÜTÇE':>6}")
    print(f"    (etkin üye = izin/off_t2 düşülmüş; KAPASİTE ayrıca TİPE DUYARLI: "
          f"kıdemsiz geceye, sabahçı geç tipe 0 sayılır)")
    for _wk, _z, _u, _y, _g, _b in _19d_ozet:
        _im = "  ← tip açığı YASAK" if _b == 0 else ""
        print(f"    {f'{_wk[0]}-W{_wk[1]}':>10} {_z:>7} {_u:>10} {_y:>8} "
              f"{_g:>8} {_b:>6}{_im}")
    print(f"  BÜTÇE = max(yapısal, açgözlü) + TOLERANS({TIP_ACIK_TOLERANS}); açgözlü")
    print(f"  H19C'nin bulduğu ÇÖZÜM → o çözüm bütçeyi sağlar, kısıt INFEASIBLE yapmaz.")
    if not _greedy:
        print(f"  ⚠ H19C ipucu KAPALI → açgözlü tanık yok, bütçe sadece yapısal açık.")
        print(f"    Takım bölünmezliği yüzünden INFEASIBLE gelebilir → TAKIM_HINT=True")
        print(f"    yap ya da TIP_ACIK_TOLERANS'ı artır.")
else:
    print(f"tip kapasite kısıtı: KAPALI "
          f"({'TIP_KAPASITE_SERT=False' if not TIP_KAPASITE_SERT else 'takim_tip boş'})")


# %% [HÜCRE 19E] — SINIR HAFTASI TİP KİLİDİ (önceki aydan devamlılık) ──
# Ay ortasında başlayan ISO hafta, modelin GÖRMEDİĞİ bir çizelgeyle başlıyor:
# 1 Eylül Salı ise o haftanın Pazartesi'si 31 Ağustos'ta, önceki ayda. H20 (agent
# haftada tek tip) sadece ayın kendi günlerini kapsadığı için agent 31 Ağustos
# 15:00-24:00 çalışıp 1 Eylül 09:00-18:00'e yazılabiliyordu. Bu hücre o boşluğu
# kapatıyor: sınır haftasında agent önceki ayda SON çalıştığı tipte kalır.
#
# KAYNAK df_onceki (kişi × gün × vardiya). df_gecmis KULLANILMAZ: o takım bazlı
# (teamleader × shifts_adj × gün) — kişinin kendi son vardiyasını veremez.
#
# ÜÇ KADEME (agent'ın kendi geçmişi > takımın geçmişi > serbest):
#   1) SERT KİLİT   — agent sınır haftasının önceki aya düşen HAFTA İÇİ gününde
#      (TASIMA_GUNLER) çalışmışsa: o tip dışındaki tipler kapatılır.
#      "En son çalışılan gün" alınır; taşıma birden çok günse (ay Cuma başlarsa
#      Pzt-Per) en yenisi geçerli. Eski `onceki_tip` çok tip görünce None dönüp
#      pes ediyordu, bu kural her zaman tek cevap verir.
#   2) YUMUŞAK ÇEKİM (W_SINIR_MOD) — 31'inde izinli/off ise: PENCERE_GUNLER'deki
#      (bir önceki ISO hafta) son çalıştığı gün. Farklı hafta olduğu için sert
#      değil — "geçen hafta böyleydi" bir devamlılık kanıtı, kural değil.
#   3) YUMUŞAK ÇEKİM — o da yoksa: takımının sınır haftasındaki EN SIK tipi
#      (kademe 1'de kilitlenen üyelerin modu). Takımın hiç kilitli üyesi yoksa
#      devam ettirilecek bir şey de yok → agent serbest.
#
# NEDEN 2 ve 3 SERT DEĞİL: hepsi sert olsaydı sınır haftasının tip dağılımı
# tamamen veriden gelirdi. Eylül talebi Ağustos dağılımıyla uyuşmazsa gece
# kovasının SERT bandı (talep ± GECE_BUFFER) tutmaz ve model çözümsüz olur.
# Yumuşakta model normalde geçmişe sadık kalır, sadece bir sert band patlayacaksa
# oynatır — yani devamlılık coverage'ı kırmıyorsa bedava.
#
# ÜÇ EMNİYET VALFİ (kilit körü körüne uygulanmaz; atlananlar tek tek raporlanır):
#   a) tip o hafta YOK      → 31 Ağustos'ta 11:00 çalışmış ama Eylül'de 11:00 kovası
#      yoksa, diğer tipleri kapatmak agentı hiç çalışamaz hale getirir; kotası SERT
#      → INFEASIBLE. Etiket normalize edilir (24:00 ↔ 00:00), yine tutmazsa atlanır.
#   b) tip artık YASAK      → Eylül'de hamile olan biri 31 Ağustos'ta 15:00 çalışmış
#      olabilir (tip_yasak). Kilitlersek çalışamaz.
#   c) o tipte gösterge YOK → agent o hafta o tipte hiç değişkeni olmayacak şekilde
#      izinliyse kilit anlamsız.
from collections import Counter                    # H25B'den ÖNCE gerekiyor (hücre bağımsız)

_kilit_sert, _kilit_yumusak, _kilit_atlanan = {}, {}, []
if not (SINIR_TIP_KILIT and KILIT_HAFTA and onceki_gunluk):
    print(f"sınır haftası tip kilidi: KAPALI ("
          + ("SINIR_TIP_KILIT=False" if not SINIR_TIP_KILIT
             else "df_onceki yok" if not onceki_gunluk
             else "sınır haftası taşımıyor (ay Pazartesi başlıyor)") + ")")
else:
    _kw = KILIT_HAFTA
    _hafta_tip = hafta_tipler.get(_kw, [])         # o haftanın hafta içi tipleri
    # taşınan (önceki ay) hafta içi günler — en YENİDEN eskiye
    _tas_hi = sorted((d for d in TASIMA_GUNLER if d.weekday() < 5), reverse=True)
    # bir önceki ISO haftadan kalan hafta içi günler (kademe 2 kaynağı)
    _pen_hi = sorted((d for d in PENCERE_GUNLER
                      if d.weekday() < 5 and d not in set(TASIMA_GUNLER)), reverse=True)

    def _tip_esle(bas):
        """df_onceki'nin vardiya başlangıcını modelin TİP etiketine eşle.
        Gece iki türlü yazılabiliyor (00:00 / 24:00) → ikisini de dene."""
        if bas in _hafta_tip:
            return bas
        try:                                       # 24:00 ↔ 00:00 (aynı an, iki yazım)
            _h, _m = bas.split(":")
            _alt = f"{int(_h) % 24:02d}:{int(_m):02d}"
            if _alt in _hafta_tip:
                return _alt
            _alt2 = f"{24 if int(_h) % 24 == 0 else int(_h):02d}:{int(_m):02d}"
            if _alt2 in _hafta_tip:
                return _alt2
        except ValueError:
            pass
        return None

    def _son_tip(a, gunler):
        """agent'ın verilen günlerdeki (yeniden eskiye) son çalışılan vardiya tipi."""
        for d in gunler:
            _p = _vardiya_parse(onceki_gunluk.get(a, {}).get(d))
            if _p:
                return _p[0], d
        return None, None

    # ── kademe 1: SERT kilit adayları ────────────────────────────────
    for a in AGENTS:
        _ham, _d = _son_tip(a, _tas_hi)
        if _ham is None:
            continue
        _t = _tip_esle(_ham)
        if _t is None:
            _kilit_atlanan.append((a, _ham, "tip bu hafta YOK (etiket eşleşmedi)"))
        elif (a, _t) in tip_yasak:
            _kilit_atlanan.append((a, _t, "tip artık YASAK (hamile/kıdem/sabahçı)"))
        elif (a, _kw, _t) not in agent_tip:
            _kilit_atlanan.append((a, _t, "o tipte gösterge yok (hafta boyu izinli)"))
        else:
            _kilit_sert[a] = _t

    # ── takım modu: kilitlenen üyelerin en sık tipi (kademe 3 kaynağı) ─
    _takim_mod = {}
    for _T, _uy in takimlar.items():
        _c = Counter(_kilit_sert[a] for a in _uy if a in _kilit_sert)
        if _c:
            _takim_mod[_T] = _c.most_common(1)[0][0]

    # ── kademe 2 + 3: YUMUŞAK çekim ──────────────────────────────────
    for a in AGENTS:
        if a in _kilit_sert:
            continue
        _ham, _d = _son_tip(a, _pen_hi)                     # (2) kendi geçen haftası
        _t = _tip_esle(_ham) if _ham else None
        _kaynak = f"kendi son günü ({_d})" if _t else None
        if _t is None:                                      # (3) takımının modu
            _T = next((_T2 for _T2, _uy in takimlar.items() if a in _uy), None)
            _t = _takim_mod.get(_T)
            _kaynak = "takım modu" if _t else None
        if _t is None or (a, _t) in tip_yasak or (a, _kw, _t) not in agent_tip:
            continue                                        # çekilecek yer yok → serbest
        _kilit_yumusak[a] = (_t, _kaynak)

    # ── kısıtlar ─────────────────────────────────────────────────────
    _kt19e, _n_sert, _n_soft = [], 0, 0
    for a, _t in _kilit_sert.items():                       # SERT: diğer tipleri kapat
        for _bas in TIP_SET:
            if _bas != _t and (a, _kw, _bas) in agent_tip:
                _kt19e.append(model.Add(agent_tip[(a, _kw, _bas)] == 0))
                _n_sert += 1
    _tes_ekle("H19E_sinir_tip_kilidi", *_kt19e)
    for a, (_t, _src) in _kilit_yumusak.items():            # YUMUŞAK: sapmaya ceza
        for _bas in TIP_SET:
            if _bas != _t and (a, _kw, _bas) in agent_tip:
                amac.append(W_SINIR_MOD * agent_tip[(a, _kw, _bas)])
                _n_soft += 1

    print(f"sınır haftası tip kilidi [{_kw[0]}-W{_kw[1]}]: "
          f"{len(_kilit_sert)} agent SERT kilitli ({_n_sert} tip kapatma), "
          f"{len(_kilit_yumusak)} agent yumuşak çekim (ağ. {W_SINIR_MOD}, {_n_soft} terim)")
    print(f"  kaynak: {[d.isoformat() for d in _tas_hi]} (sert)  |  "
          f"{[d.isoformat() for d in _pen_hi]} (yumuşak, kendi geçmişi)")
    print(f"  takım bütünlüğü bu hafta ARANMIYOR (H19/H19C/H19D muaf) — "
          f"H20 agent tek tip kuralı GEÇERLİ")
    _sd = Counter(_kilit_sert.values())
    print(f"  SERT kilit tip dağılımı : {dict(sorted(_sd.items()))}")
    _yd = Counter(_t for _t, _ in _kilit_yumusak.values())
    _kd = Counter(_s.split(" (")[0] for _, _s in _kilit_yumusak.values())
    print(f"  yumuşak çekim dağılımı  : {dict(sorted(_yd.items()))}  |  "
          f"kaynak: {dict(_kd)}")
    _serbest = len(AGENTS) - len(_kilit_sert) - len(_kilit_yumusak)
    print(f"  serbest kalan agent     : {_serbest} "
          f"(devam ettirilecek geçmişi yok → coverage esnekliği bunlardan gelir)")
    if _kilit_atlanan:
        print(f"  ⚠ {len(_kilit_atlanan)} agentta kilit UYGULANAMADI (emniyet valfi):")
        for a, _t, _sb in _kilit_atlanan[:15]:
            print(f"       {a}: {_t} → {_sb}")
        if any("etiket eşleşmedi" in _s for _, _, _s in _kilit_atlanan):
            print(f"     → 'etiket eşleşmedi' çoksa df_onceki'nin vardiya yazımını kontrol et "
                  f"(gece 00:00- mi 24:00- mi).")
    else:
        print(f"  ✓ kilit adaylarının hepsinde uygulandı (emniyet valfi tetiklenmedi)")

    # ── FİZİBİLİTE ÖN KONTROLÜ: kilitli dağılım o haftanın talebini taşıyor mu? ──
    # H19D bu haftada devre dışı → "zirveyi karşıla" kısıtı yok, eksik YUMUŞAK cezaya
    # düşer (INFEASIBLE olmaz). TEK İSTİSNA gece kovaları: orada SERT band var
    # (talep ± GECE_BUFFER) ve kilit yüzünden geceye yeterli kişi kalmazsa model
    # çözümsüz olur. Aşağıdaki tablo bunu ÖNCEDEN gösterir.
    _kw_hi = [ds for ds in haftalar[_kw] if dt.date.fromisoformat(ds).weekday() < 5]
    print(f"\n  KİLİTLİ DAĞILIM vs TALEP ({_kw[0]}-W{_kw[1]}, {len(_kw_hi)} hafta içi gün)")
    print(f"    {'tip':>7} {'sert':>6} {'yumuşak':>8} {'serbest*':>9} "
          f"{'zirve talep':>12} {'PAY':>6}")
    for _t in _hafta_tip:
        _z = max((sum(talep[(ds, v)] for v in gun_vardiyalari[ds]
                      if (ds, v) in talep and saat[(ds, v)][0] == _t)
                  for ds in _kw_hi), default=0)
        _s1 = sum(1 for _v2 in _kilit_sert.values() if _v2 == _t)
        _s2 = sum(1 for _v2, _ in _kilit_yumusak.values() if _v2 == _t)
        _s3 = sum(1 for a in AGENTS if a not in _kilit_sert and a not in _kilit_yumusak
                  and (a, _kw, _t) in agent_tip)
        print(f"    {_t:>7} {_s1:>6} {_s2:>8} {_s3:>9} {_z:>12} {_s1 + _s2 - _z:>+6}")
    print(f"    * serbest = o tipe GİREBİLİR (tek tipe sayılmaz, birden çok tipte görünür)")
    # gece sert bandı — çözümsüzlük buradan gelir
    _gece_risk = []
    for ds in _kw_hi:
        for v in gun_vardiyalari[ds]:
            if (ds, v) not in talep or saat[(ds, v)][0] not in GECE_BASLANGIC:
                continue
            _alt = talep[(ds, v)] - GECE_BUFFER                # SERT alt sınır
            _t = saat[(ds, v)][0]
            _kap = sum(1 for a in AGENTS
                       if _kilit_sert.get(a, _t) == _t and _kova_calisabilir(a, ds, v))
            if _kap < _alt:
                _gece_risk.append((ds, _t, talep[(ds, v)], _alt, _kap))
    if _gece_risk:
        print(f"    ⚠ GECE SERT BANDI RİSKİ — kilit sonrası {len(_gece_risk)} kovada "
              f"müsait kişi alt sınırın altında (INFEASIBLE olur):")
        for ds, _t, _k, _alt, _kap in _gece_risk[:10]:
            print(f"       {ds} {_t}: talep {_k} (alt sınır {_alt}), kilit sonrası "
                  f"müsait {_kap}")
        print(f"      → SINIR_TIP_KILIT=False ya da o agentları kilitten çıkar.")
    else:
        print(f"    ✓ gece sert bandı kilit sonrası da dolabiliyor")


# %% [HÜCRE 20] — HAFTADA AYNI VARDİYA (agent hafta boyu tek tip) ──────
# Bir agent bir ISO-hafta içinde çalıştığı günlerde HEP aynı vardiyada olmalı
# (Pzt 09:00 ise Salı 15:00 olamaz). Vardiya tipi = başlangıç saati.
# Her (agent, hafta) için kullanılan başlangıç-saati tipi ≤ 1.

# ISO-haftalar (H12 peş-peşe moddaysa burada da kurulur → bağımsız çalışır)
haftalar = {}
for ds in PLAN_GUNLER:
    yil, hafta, _ = dt.date.fromisoformat(ds).isocalendar()
    haftalar.setdefault((yil, hafta), []).append(ds)

# hafta içi resmi tatil olan haftalar → o hafta agent tek-tip kuralı GEVŞETİLİR
tatil_haftalari = {dt.date.fromisoformat(t).isocalendar()[:2]
                   for t in RESMI_TATILLER if dt.date.fromisoformat(t).weekday() < 5}

# Göstergeler H19'da kuruldu (agent_tip) → burada sadece "≤1 tip" kısıtı yazılır.
# Eskiden bu hücre kendi göstergelerini üretiyordu; H19'unkilerle birebir aynı
# oldukları için değişken ve kısıt sayısı boşuna iki katına çıkıyordu.
n = 0
for a in AGENTS:
    for wk in haftalar:
        if wk in tatil_haftalari:             # tatil haftası → tek-tip serbest (vardiya farklılaşabilir)
            continue
        tv = [agent_tip[(a, wk, bas)] for bas in TIP_SET if (a, wk, bas) in agent_tip]
        if len(tv) <= 1:
            continue                          # zaten tek tip → kısıt gerekmez
        model.Add(sum(tv) <= 1)               # haftada en fazla 1 vardiya tipi
        n += 1

print(f"haftada aynı vardiya kısıtı: {n} (agent × hafta)  [göstergeler H19'dan]")


# %% [HÜCRE 20B] — HAFTALIK OFF DENGESİ + HAFTA SONU ÖNCELİĞİ (yumuşak) ─
# İki yumuşak hedef (ikisi de ≥0 değişken + pozitif katsayı → alt sınır temiz):
#  (1) Haftalık off (izin HARİÇ) ≤ 2  → "4-gün haftası"nı engelle.
#      Kural çalışma sayısına DEĞİL off'a: çalışma ≥ (o hafta izinsiz gün − 2).
#      İzin varsa o günün değişkeni yok → izinsiz gün düşer → az çalışmaya izin.
#  (2) Off önce HAFTA SONU olsun → hafta içi off'a küçük ceza. Eşitlikte model
#      hafta sonunu off seçer; hafta sonu coverage için hafta içi off gerekirse esner.

# HAFTALIK OFF TAVANI — SERT (yeni) + yumuşak ceza (eski, tercih olarak duruyor)
#   SERT kural: bir agent bir ISO HAFTADA en fazla MAX_HAFTA_OFF(2) gün OFF olur.
#   Sayıma GİRMEYENLER: izin (değişkeni yok), off_t2 (değişkeni yok), resmi tatil,
#   ve off_t (değişkeni VAR ama TALEP EDİLMİŞ off → agentın kendi isteği, tavanı
#   yemesin). Yani "modelin kendi verdiği off" ≤ 2.
#   Gerekçe: yumuşak hâli (ağırlık 3) hiç direnmiyordu — hafta içi off cezasıyla
#   birlikte 3. off ~7-17'ye mal oluyordu, model rahatça ödüyordu. Roster'da
#   çift hafta sonu off + hafta içi off (3) ve hatta 2 hafta içi + 1 hafta sonu
#   desenleri çıkıyordu.
#   SINIR HAFTASI: sert kural SADECE bu ayın günlerini sayar; Temmuz'un off'ları
#   girmez. Aksi hâlde 1-2 Ağustos (ikisi de hafta sonu) + Temmuz'dan 1 off ile
#   hamile/süt agent daha baştan ihlalde olurdu (H14: hafta sonu çalışamaz).
#   Yumuşak ceza (Temmuz'u SAYAN) aynen duruyor → sınır haftasında tercih olarak
#   çalışmaya devam ediyor, ama çözümsüzlük yaratmıyor.
HAFTA_OFF_SERT = True              # False → sadece eski yumuşak ceza
MAX_HAFTA_OFF  = 2                 # bir ISO haftada en fazla kaç OFF (off_t hariç)

n1, n1_tas, n1_sert = 0, 0, 0
_off_kapasite = {}                 # agent → Σ haftalık off tavanı (fizibilite kontrolü)
_off_zorunlu  = {}                 # agent → off_t dışı müsait gün sayısı
_kt_off = []                       # TESHIS_MODU: sert off kısıtları
for a in AGENTS:
    _soft_a = off_soft_map.get(a, set())      # off_t günleri → tavanın DIŞINDA
    _kap = _mus = 0
    for (yil, hafta), hafta_gunleri in haftalar.items():
        gun_var = []                          # bu agentın o haftadaki çalışma değişkenleri
        izinsiz_gun = set()                   # o hafta değişkeni olan (izinsiz) günler
        sert_var, sert_gun = [], 0            # off_t HARİÇ günler → sert kural
        for ds in hafta_gunleri:
            d = dt.date.fromisoformat(ds)
            if d in TATIL:                    # resmi tatil → izin gibi, avail'e girmez
                continue                      # (tatili dinlemek off sayılmasın)
            gunluk = [x[(a, ds, v)] for v in gun_vardiyalari[ds] if (a, ds, v) in x]
            if gunluk:
                gun_var += gunluk
                izinsiz_gun.add(ds)
                if d not in _soft_a:           # off_t günü sert sayıma girmez
                    sert_var += gunluk
                    sert_gun += 1
        avail = len(izinsiz_gun)
        # ── SERT: o haftada off_t dışı günlerin en fazla MAX_HAFTA_OFF'u off olabilir
        if HAFTA_OFF_SERT and sert_gun > MAX_HAFTA_OFF:
            _kt_off.append(model.Add(sum(sert_var) >= sert_gun - MAX_HAFTA_OFF))
            n1_sert += 1
        _mus += sert_gun
        _kap += min(MAX_HAFTA_OFF, sert_gun)
        # ── YUMUŞAK (eski): önceki ayın off'larını da sayar, tercih olarak kalıyor
        onc_cal = onc_off = 0                 # önceki aydan taşınan çalışma / off
        if (yil, hafta) == SINIR_HAFTA and a in onceki_gun:
            onc_cal, onc_off = onceki_gun[a], onceki_off[a]
            n1_tas += 1
        if avail + onc_cal + onc_off <= 2:
            continue                          # kısa/çok-izinli hafta → taban yok
        fazla_off = model.NewIntVar(0, avail + onc_off, f"fazlaoff_{a}_{yil}_{hafta}")
        model.Add(fazla_off >= (avail + onc_off - 2) - sum(gun_var))   # off>2 olursa ceza
        amac.append(W_HAFTA_OFF * fazla_off)
        n1 += 1
    _off_zorunlu[a], _off_kapasite[a] = _mus, _kap
_tes_ekle("H20B_haftalik_off_tavani", *_kt_off)

# ── FİZİBİLİTE ÖN KONTROLÜ (sert kural için) ──────────────────────────
# Sert kuralı haftalar üzerinden toplarsak:  Σ çalışma(off_t dışı) ≥ müsait − tavan
# Çalışma toplamı H17'nin ust'unu aşamaz → gerek şart:  müsait − tavan ≤ ust
# Sağlanmıyorsa o agent kuralı ASLA tutturamaz → model INFEASIBLE olur.
# 45 dakikalık çözümün sonunda öğrenmek yerine burada listeliyoruz.
if HAFTA_OFF_SERT:
    _fiz = [(a, _off_zorunlu[a], _off_kapasite[a], ust_map[a])
            for a in AGENTS
            if a in ust_map and _off_zorunlu[a] - _off_kapasite[a] > ust_map[a]]
    if _fiz:
        print(f"⚠ HAFTALIK OFF SERT KURALI TUTMAZ: {len(_fiz)} agent "
              f"(müsait − haftalık tavan > çalışma tavanı) → model INFEASIBLE olur:")
        for a, _m, _k, _u in _fiz[:10]:
            print(f"     {a}: off_t dışı müsait {_m}, haftalık off tavanı toplamı {_k}, "
                  f"zorunlu çalışma {_m - _k} > ust {_u}")
        print(f"     → HAFTA_OFF_SERT=False yap ya da MAX_HAFTA_OFF'u artır.")
    else:
        print(f"✓ haftalık off sert kuralı fizibil: {len(AGENTS)} agentın hepsi "
              f"haftada ≤{MAX_HAFTA_OFF} off ile kotasını doldurabiliyor")

# (2) hafta içi off cezası — GÜN-BAZLI ağırlıklı (H8B surplus'a göre):
#     ağırlık(gün) = W_HI_OFF + round(W_SURPLUS_OFF × (1 − gun_off_w[gün]))
#     → sıkı gün (düşük w) YÜKSEK ceza (herkes çalışsın); bol gün (yüksek w) TABAN ceza (off serbest).
#     Böylece off'lar sıkı/açık (Pzt) günlerden kaçıp bol (yüksek net) günlere gider.
#     off göstergesi = 1 − Σx (o gün çalışmadıysa 1). gun_off_w yoksa nötr 0.5.
n2 = 0
for a in AGENTS:
    _soft = off_soft_map.get(a, set())         # off_t günleri bu cezanın DIŞINDA
    for ds in PLAN_GUNLER:
        d = dt.date.fromisoformat(ds)
        if d.weekday() >= 5 or d in TATIL:
            continue                          # hafta sonu / resmi tatil → bu cezanın dışında
        if d in _soft:
            continue                          # TALEP EDİLMİŞ off (off_t) → model tercihi değil;
                                              #   kendi cezası (3) var, burada iki kez sayılmasın
        gunluk = [x[(a, ds, v)] for v in gun_vardiyalari[ds] if (a, ds, v) in x]
        if not gunluk:
            continue                          # o gün değişken yok (izin/off_t2) → off sayılmaz
        agirlik = W_HI_OFF + round(W_SURPLUS_OFF * (1 - gun_off_w.get(ds, 0.5)))
        amac.append(agirlik * (1 - sum(gunluk)))   # off (1−çalıştı) → gün ağırlığı kadar ceza
        n2 += 1

# (3) off_t = YUMUŞAK off talebi → KARŞILANMAZSA ceza ("verebildiğini ver").
#     off_t2 bloklu olduğu için buraya girmez (zaten her zaman karşılanır).
#     Ceza o gün ÇALIŞMAYA konuyor → model önce bu günleri off bırakmaya çalışır.
#     W_OFF_T, hafta içi off cezasından (4..14) yüksek seçilmeli; yoksa off vermek
#     zaten pahalı olduğu için talep hiç karşılanmaz.
n3 = 0
for a in AGENTS:
    for d in sorted(off_soft_map.get(a, set())):
        ds = d.isoformat()
        gunluk = [x[(a, ds, v)] for v in gun_vardiyalari.get(ds, []) if (a, ds, v) in x]
        if gunluk:
            amac.append(W_OFF_T * sum(gunluk))     # o gün çalıştırılırsa ceza
            n3 += 1

print(f"haftalık off: SERT tavan {n1_sert} (agent,hafta) kısıtı "
      f"(≤{MAX_HAFTA_OFF} off, off_t/off_t2/izin/tatil hariç)"
      if HAFTA_OFF_SERT else "haftalık off SERT tavan: KAPALI")
print(f"haftalık off dengesi (yumuşak): {n1} (agent,hafta) fazla-off cezası (ağ. {W_HAFTA_OFF})"
      + (f"  |  sınır haftası taşıması: {n1_tas} agent" if n1_tas else ""))
print(f"hafta içi off (surplus ağırlıklı): {n2} (agent,gün) ceza terimi "
      f"(taban {W_HI_OFF} + surplus {W_SURPLUS_OFF}×(1−w) → sıkı gün pahalı)")
print(f"off_t (yumuşak talep): {n3} (agent,gün) talep — karşılanmazsa ağ. {W_OFF_T}")


# %% [HÜCRE 20C] — HAFTA SONU ADALETİ (agent bazında, adil-pay üstü ceza) ─
# Hafta sonu yükü kişiler arası yayılsın: her agentın FAIR_HS üstündeki HER
# hafta sonu gününe ceza. Min-max'tan farkı: gradient var → 4 gün çalışanı 3'e
# indirmek ANINDA ceza azaltır (her fazla çalışan ayrı katkı) → çözücü aktif
# olarak yükü 0 gün çalışanlara dağıtır. Yumuşak: coverage gerekince esner.
# Not: hamile/süt zaten hafta sonu çalışamaz (H14) → değişkeni yok → sayılmaz.
hs_gunler = [ds for ds in PLAN_GUNLER if dt.date.fromisoformat(ds).weekday() >= 5]

# ADİL PAY OTOMATİK (FAIR_HS is None): talep ÷ uygun agent, YUKARI yuvarla.
# Yukarı yuvarlama şart — aşağı yuvarlarsak eşik zorunlu ortalamanın altında kalır,
# 1. kademe sabite döner (herkes cezalı → ceza ayırt etmez). Tavanda ise ortalamanın
# üstündeki KUYRUK cezalanır, asıl istenen bu.
if FAIR_HS is None:
    _hs_talep = sum(kisi for (ds, _v), kisi in talep.items()
                    if dt.date.fromisoformat(ds).weekday() >= 5)
    _hs_uygun = len(AGENTS) - len(hafta_sonu_yasak)      # hamile/süt hafta sonu çalışamaz
    FAIR_HS = -(-_hs_talep // _hs_uygun) if _hs_uygun else 2      # ceil
    print(f"FAIR_HS otomatik: {_hs_talep} hafta sonu kişi-günü ÷ {_hs_uygun} uygun agent "
          f"= {_hs_talep / max(1, _hs_uygun):.2f} → FAIR_HS = {FAIR_HS}")

nh = 0
for a in AGENTS:
    hs_var = [x[(a, ds, v)] for ds in hs_gunler
              for v in gun_vardiyalari[ds] if (a, ds, v) in x]
    if hs_var:
        toplam = sum(hs_var)
        # KONVEKS (2 kademe): 3.gün normal, 4-5.gün ekstra → tail 3'e yayılır
        fazla1 = model.NewIntVar(0, len(hs_gunler), f"fazlahs1_{a}")
        model.Add(fazla1 >= toplam - FAIR_HS)          # FAIR_HS(2) üstü
        fazla2 = model.NewIntVar(0, len(hs_gunler), f"fazlahs2_{a}")
        model.Add(fazla2 >= toplam - (FAIR_HS + 1))    # FAIR_HS+1(3) üstü → EKSTRA ceza
        amac.append(W_ADALET_HS * fazla1 + W_ADALET_HS2 * fazla2)
        nh += 1

print(f"hafta sonu adaleti: {nh} agent, FAIR_HS={FAIR_HS} üstü cezalı "
      f"(ağ. {W_ADALET_HS} + konveks {W_ADALET_HS2}, {len(hs_gunler)} hafta sonu günü)")


# %% [HÜCRE 20D] — VARDİYA-SAATİ ADALETİ (akşam+gece, HAFTA bazında) ────
# Akşam/gece HAFTALIK gelir (H20: agent hafta boyu tek tip) → GÜN değil HAFTA say:
# agent kaç FARKLI HAFTA akşam/gece çalışmış; adil pay (FAIR_AKSAM_HAFTA) üstü cezalı.
# Böylece "bir hafta akşamcı olmak" cezalı görünmez; asıl amaç: kimse çok HAFTA
# akşam/gece yapmasın (rotasyon). Gradient'li (H20C ile aynı mantık).
# Not: sabah_calisir geç vardiyaya giremez → değişkeni yok → o hafta akşam sayılmaz.
#      Uydu/gece rotasyonu ileride gelince gece buradan çıkarılır (çakışmasın).
AKSAM_DK = dakika(AKSAM_BASLANGIC)                    # 17:00 → 1020 (00:00→1440 → gece dahil)
aksam_gv_set = {(ds, v) for (ds, v) in talep if dakika(saat[(ds, v)][0]) >= AKSAM_DK}

# ADİL PAY OTOMATİK (FAIR_AKSAM_HAFTA is None): ölçü HAFTA olduğu için talebi de
# haftaya çeviriyoruz — agent hafta boyu tek tipte (H20), yani bir haftada akşam/gece
# tipinde OLMASI gereken kişi sayısı ≈ o haftanın ZİRVE günlük akşam/gece talebi.
# Σ(hafta zirvesi) = gereken agent-hafta; uygun agent = sabahçı olmayanlar (H13).
if FAIR_AKSAM_HAFTA is None:
    _ak_hafta = 0
    for _gunler in haftalar.values():
        _gunluk = [sum(talep[(ds, v)] for v in gun_vardiyalari[ds]
                       if (ds, v) in aksam_gv_set) for ds in _gunler]
        _ak_hafta += max(_gunluk) if _gunluk else 0
    _ak_uygun = len(AGENTS) - len(sabah_agents)        # sabahçı geç vardiyaya giremez
    FAIR_AKSAM_HAFTA = max(1, -(-_ak_hafta // _ak_uygun)) if _ak_uygun else 1   # ceil, en az 1
    print(f"FAIR_AKSAM_HAFTA otomatik: {_ak_hafta} agent-hafta ihtiyacı ÷ {_ak_uygun} "
          f"uygun agent = {_ak_hafta / max(1, _ak_uygun):.2f} → FAIR_AKSAM_HAFTA = "
          f"{FAIR_AKSAM_HAFTA}")

na = 0
for a in AGENTS:
    hafta_ind = []                                   # her hafta: agent o hafta akşam/gece mi (0/1)
    for wk, gunler in haftalar.items():
        wv = [x[(a, ds, v)] for ds in gunler for v in gun_vardiyalari[ds]
              if (a, ds, v) in x and (ds, v) in aksam_gv_set]
        if wv:
            ind = model.NewBoolVar(f"aksamhaf_{a}_{wk[0]}{wk[1]}")
            for xv in wv:
                model.Add(ind >= xv)                 # o hafta akşam/gece biri varsa 1
            hafta_ind.append(ind)
    if not hafta_ind:
        continue
    fazla = model.NewIntVar(0, len(hafta_ind), f"fazlaaksamh_{a}")
    model.Add(fazla >= sum(hafta_ind) - FAIR_AKSAM_HAFTA)   # adil pay (HAFTA) üstü cezalı
    amac.append(W_ADALET_AKSAM * fazla)
    na += 1

print(f"vardiya-saati adaleti (HAFTA): {na} agent, adil pay={FAIR_AKSAM_HAFTA} hafta "
      f"(ağ. {W_ADALET_AKSAM})")


# %% [HÜCRE 20E] — HAFTALIK YIĞILMA (6-günlük haftaları haftalara yay) ────
# DİKKAT — bu hücre "aylık mesai adaleti" DEĞİL. Ölçüsü HAFTALIK BRÜT:
#   haftalık(hafta) = max(0, çalışılan(tatil hariç) − (5 − hafta içi tatil − hafta içi izin))
#   ceza = W_ADALET_MESAI × max(0, Σ haftalık − FAIR_MESAI)
# Eksik kalan hafta fazla haftayı TELAFİ ETMEZ (max(0,…) negatifi keser) → bu ölçü
# H22'nin AY BAZLI mesai_gun'ünden farklıdır ve öyle kalmalıdır. İşlevi:
#   6,6,6,4,0 günlük haftalar → aylık mesai 1 ama haftalık brüt 3 → CEZALI.
#   H17 buna karışmaz (aylık nete bakar) → zamansal yığılmayı sadece bu hücre engeller.
# Norm haftası (4 hafta içi + 1 hafta sonu = 5 gün) → max(0,5−5)=0 → cezasız.
#
# AY BAZLI mesai adaleti bu hücrenin SONUNDA ayrı bir bölüm — artık CEZA değil,
# ORANSAL SERT KISIT (MESAI_TOL). Hafta sonu YÜKÜ (norm+mesai birlikte) H20C'nin
# işi ve orası hâlâ ağırlıkla yönetiliyor: hafta sonunda sert band var, oransal
# tavan orada INFEASIBLE riski taşıyor (H25C [3] ile ölçüldü: TOL=1'de 22 kişi-gün açık).

# ADİL PAY OTOMATİK (FAIR_MESAI is None): eşik = MAX_MESAI.
# Gerekçe: MAX_MESAI mesai günü yapan bir agent en fazla MAX_MESAI HAFTADA 5 günü
# aşar (her mesai günü ayrı bir haftaya düşse bile). Eşik bunun ALTINDA kalırsa
# sert tavanla çelişir: H17 "4 mesai yapabilirsin" derken bu hücre 3. ve 4. güne
# ceza yazar → tavan açık ama kimse kullanmaz (sabit 2 iken tam olarak bu oluyordu).
# Ölü terim değil: haftalık brüt = Σ max(0,·) negatifi kestiği için aylık mesaiden
# BÜYÜK olabilir → 6,6,6,4,0 gibi yığılma aylık mesai 1 iken bile cezalı kalır.
if FAIR_MESAI is None:
    FAIR_MESAI = MAX_MESAI
    print(f"FAIR_MESAI otomatik: MAX_MESAI={MAX_MESAI} → FAIR_MESAI = {FAIR_MESAI} "
          f"(haftalık brüt eşiği; sert tavanla çelişmesin)")

nmes, nmes_tas = 0, 0
for a in AGENTS:
    if a not in kota_map:
        continue
    hafta_mesai = []                                   # her hafta: 5-üstü (tatil hariç) çalışma
    for wk, gunler in haftalar.items():
        wtatil = sum(1 for ds in gunler
                     if dt.date.fromisoformat(ds).weekday() < 5
                     and dt.date.fromisoformat(ds) in TATIL)
        w_izin = sum(1 for ds in gunler                # hafta içi izin (kotayı düşürür → eşiği düşür)
                     if dt.date.fromisoformat(ds).weekday() < 5
                     and dt.date.fromisoformat(ds) in izin_map.get(a, set())
                     and dt.date.fromisoformat(ds) not in TATIL)
        nontatil = [x[(a, ds, v)] for ds in gunler for v in gun_vardiyalari[ds]
                    if (a, ds, v) in x and dt.date.fromisoformat(ds) not in TATIL]
        if not nontatil:
            continue
        esik = 5 - wtatil - w_izin                     # o haftanın normal iş günü
        # SINIR HAFTASI TAŞIMASI (H8C): önceki ayın izni eşiği düşürür, önceki ayın
        # ÇALIŞMASI eşiği TÜKETİR → kalan eşik kadarı bedava, üstü mesai.
        # Taşımasız hali: Temmuz'da 5 gün çalışmış agentın 01-02 Ağustos'u
        # "max(0, 2−5)=0" ile BEDAVA görünüyordu → adalet bütçesinden düşmüyordu.
        if wk == SINIR_HAFTA and a in onceki_gun:
            esik = max(0, esik - onceki_izin_hi.get(a, 0) - onceki_gun[a])
            nmes_tas += 1
        mw = model.NewIntVar(0, 7, f"haftamesai_{a}_{len(hafta_mesai)}")
        model.Add(mw >= sum(nontatil) - esik)          # haftalık mesai (ReLU, ≥0)
        hafta_mesai.append(mw)
    if not hafta_mesai:
        continue
    fazla = model.NewIntVar(0, 7 * len(hafta_mesai), f"fazlamesai_{a}")
    model.Add(fazla >= sum(hafta_mesai) - FAIR_MESAI)  # toplam haftalık mesai − adil pay
    amac.append(W_ADALET_MESAI * fazla)
    nmes += 1

print(f"haftalık yığılma (6-günlük hafta): {nmes} agent, adil pay={FAIR_MESAI} hafta "
      f"(ağ. {W_ADALET_MESAI}; ölçü HAFTALIK brüt — H22'nin aylık mesai_gun'ünden farklı)"
      + (f"  |  sınır haftası taşıması: {nmes_tas} agent" if nmes_tas else ""))


# ── AY BAZLI MESAİ ADALETİ — ORANSAL SERT TAVAN (AĞIRLIK YOK) ─────────
# ölçü: mesai_a = max(0, (çalışma − resmi tatilde çalışma) − kota − sınır alacağı)
#       → H22'nin mesai_gun'ü ve H17'nin sert tavanı ile AYNI ölçü.
# kısıt: N × mesai_a ≤ M + N × MESAI_TOL      (M = Σ mesai_a, N = uygun agent)
#        ⇔ mesai_a ≤ M/N + MESAI_TOL = "fiili ortalama + tolerans"
# M bir DEĞİŞKEN → eşik önceden hesaplanmıyor, modelin seçtiği toplama göre
# kendini ayarlıyor. Eskiden bu bir CEZAYDI (W_ADALET_MESAI_AY) ve satın
# alınabiliyordu: 4. günün maliyeti 16, coverage kazancı 25 → model ödeyip
# yine veriyordu (99 agent 4 mesai, 130 agent ≤2). Artık ödeyerek geçilemez.
#
# İKİ TAVAN ÜST ÜSTE: H17 zaten mesai_a ≤ MAX_MESAI diyor (mv'nin üst sınırı).
# Oransal kısıt sadece DARALTIR → fiili tavan = min(MAX_MESAI, ortalama+TOL).
# 4'e çıkmak için toplamın N×3'ü aşması gerekir = "önce herkes 3'e gelsin".
# Kilitlenme yok: ortalamayı yükseltmek için kimsenin tavanı aşması gerekmiyor
# (2 yapan 3'e çıkınca M artar, duvara değmeden) → 4'ün kapısı kendiliğinden açılır.
# Ters oyun da yok: M'yi küçültmek tavanı DARALTIR.
#
# EŞİTLİK ŞART (AddMaxEquality): sadece "mv ≥ net" deseydik, model az mesai
# yapan birinin mv'sini ŞİŞİRİP M'yi büyütür ve üsttekilerin tavanını gevşetirdi.
# Eşitlikle mv gerçek değere çivili → M manipüle edilemez.
#
# Sınır haftası alacağı için H17'nin `kredi` DEĞİŞKENİ (kredi_map) kullanılıyor →
# ölçü H22'nin mesai_gun'ü ile BİREBİR aynı.
# ÖNCEDEN sabit `onceki_eksik` (kredinin ÜST sınırı) kullanılıyordu ve rapor ile
# kısıt AYRIŞIYORDU: alacağı olan ama sınır hafta sonunu OFF geçiren agentta
# kredi 0 kalıyor, H22 mesai_gun'ü 1 fazla yazıyordu. Ölçüldü: oransal tavan 3
# iken Excel'de 3 agent 4 gösteriyordu (1-2 Ağustos'ta off + off_t'leri var,
# alacağı hiç kullanmamışlar). Aynı tutarsızlığı MAX_MESAI için H17'de daha önce
# kapatmıştık; burada geri gelmişti.
mesai_ay = {}                                          # agent → mesai günü (IntVar)
_gun_ub = len(PLAN_GUNLER)
for a in AGENTS:
    if a not in kota_map or a in ozel_agents:
        continue                                       # özel flag: H17'de pay 0 → mesai zaten yok
    tum = [x[(a, ds, v)] for ds in PLAN_GUNLER
           for v in gun_vardiyalari[ds] if (a, ds, v) in x]
    tat_v = [x[(a, ds, v)] for ds in PLAN_GUNLER
             if dt.date.fromisoformat(ds) in TATIL
             for v in gun_vardiyalari[ds] if (a, ds, v) in x]
    if not tum:
        continue
    _net = model.NewIntVar(-_gun_ub, _gun_ub, f"mesainet_{a}")
    model.Add(_net == sum(tum) - sum(tat_v) - kota_map[a] - kredi_map.get(a, 0))
    mv = model.NewIntVar(0, MAX_MESAI, f"mesaiay_{a}")  # üst sınır = H17'nin sert tavanı
    model.AddMaxEquality(mv, [_net, 0])                 # mv = max(0, net) — EŞİTLİK
    mesai_ay[a] = mv

N_mesai = len(mesai_ay)
if N_mesai and MESAI_TOL < MAX_MESAI:
    M_mesai = model.NewIntVar(0, N_mesai * MAX_MESAI, "mesai_toplam")
    model.Add(M_mesai == sum(mesai_ay.values()))
    _tes_ekle("H20E_oransal_mesai",
              *[model.Add(N_mesai * mv <= M_mesai + N_mesai * MESAI_TOL)
                for a, mv in mesai_ay.items()])
    print(f"ay bazlı mesai adaleti [SERT ORANSAL]: {N_mesai} agent, "
          f"mesai_a ≤ ortalama + {MESAI_TOL}  (ağırlık YOK; ikinci tavan "
          f"MAX_MESAI={MAX_MESAI} → fiili tavan = min(ikisi))")
    print(f"  4 gibi bir değere çıkabilmek için toplam mesainin "
          f"{N_mesai * (MAX_MESAI - MESAI_TOL)} günü geçmesi gerekir "
          f"→ 'önce herkes {max(0, MAX_MESAI - MESAI_TOL)}'e gelsin' kuralı")
elif N_mesai:
    print(f"ay bazlı mesai adaleti: KURULMADI — MESAI_TOL({MESAI_TOL}) ≥ "
          f"MAX_MESAI({MAX_MESAI}) → oransal tavan H17'nin üstünde kalır, ölü kısıt")
else:
    print("ay bazlı mesai adaleti: KURULMADI — mesai yapabilen agent yok")


# %% [HÜCRE 21] — ÇÖZ + DOĞRULA ─────────────────────────────────────────
COZUM_SURE_SN = 2700               # süre sınırı (sn) — fiilen kullanılan değer.
                                   # NOT: süre SORUN DEĞİL. 2700 sn'de de çözücü
                                   # takım-tip tahsisini iyileştiremiyor (gap %72,
                                   # 10 (hafta,tip) kombinasyonu açık kalıyor).
                                   # Yani ek süre çözüm değil → H19C ipucu / sabitleme.

if FIZIBILITE_MODU:                                # amaç YOK → sadece "çözüm var mı"
    print("⚑ FİZİBİLİTE MODU: amaç fonksiyonu KURULMADI — sadece bir çözüm aranıyor.")
    print("   Çözüm bulunursa model FİZİBİL demektir (sorun arama/süre), ama çıktı")
    print("   PLAN OLARAK KULLANILAMAZ: coverage/adalet optimize edilmemiştir.")
else:
    model.Minimize(sum(amac))                      # amaç: toplam cezayı küçült
if TESHIS_MODU and _teshis:                        # varsayımlar → INFEASIBLE'da suçlu grup
    model.AddAssumptions([_b for _ad, _b in _teshis])
    print(f"TEŞHİS MODU AÇIK: {len(_teshis)} kural grubu varsayıma bağlandı → "
          f"{[_ad for _ad, _ in _teshis][:6]}{' ...' if len(_teshis) > 6 else ''}")
solver = cp_model.CpSolver()
solver.parameters.num_search_workers = 16          # paralel çekirdek (CPU'ya göre artır)
solver.parameters.max_time_in_seconds = COZUM_SURE_SN   # en iyi BULUNAN'ı al (optimal şart değil)
solver.parameters.log_search_progress = True       # ilerlemeyi terminale bas (feasible bulundu mu görürsün)
status = solver.Solve(model)
print(f"durum: {solver.StatusName(status)}  (süre: {solver.WallTime():.2f} sn)")

if status not in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    # ── 0) DURUM AYRIMI: UNKNOWN ≠ INFEASIBLE ─────────────────────────
    # UNKNOWN  = süre doldu, çözücü ne çözüm buldu ne de yokluğunu kanıtladı.
    #            Model FİZİBİL OLABİLİR — "çözüm yok" demek DEĞİLDİR.
    # INFEASIBLE = çözüm olmadığı KANITLANDI.
    # Aşağıdaki taramalar ve varsayım teşhisi SADECE INFEASIBLE'da anlamlı;
    # UNKNOWN'da SufficientAssumptionsForInfeasibility() her zaman BOŞ döner
    # ve "suçlu yok" gibi yanlış okunur.
    _kanitli = (status == cp_model.INFEASIBLE)
    if not _kanitli:
        print(f"\n⚠ DURUM: {solver.StatusName(status)} — bu 'ÇÖZÜM YOK' DEMEK DEĞİL.")
        print(f"   Çözücü {COZUM_SURE_SN} sn içinde ne bir çözüm bulabildi ne de")
        print(f"   çözümsüzlüğü kanıtlayabildi. Sıradaki adımlar:")
        print(f"   1) FIZIBILITE_MODU=True ile koş (amaç fonksiyonu kapanır) →")
        print(f"      çözüm bulunursa model fizibil, sorun ARAMA; bulunmazsa kurallar sıkı.")
        print(f"   2) Süreyi artır (COZUM_SURE_SN) — ilk çözümü bulmak zaman alıyor olabilir.")
        print(f"   3) Yeni sert kuralları gevşet: TIP_ACIK_TOLERANS=2, MESAI_TOL=2.")
        print(f"   NOT: TESHIS_MODU açıkken varsayım literalleri aramayı YAVAŞLATIR →")
        print(f"        UNKNOWN alıyorsan teşhis modunu KAPAT.")
        print(f"   Aşağıdaki tarama yine de basılıyor ama UNKNOWN'da BAĞLAYICI DEĞİL.")
    else:
        # ── VARSAYIM TEŞHİSİ (TESHIS_MODU) — suçlu kural grubu ────────
        # CP-SAT, çözümsüzlüğü açıklamaya YETEN varsayım alt kümesini döndürür.
        if TESHIS_MODU and _teshis:
            _ad_map = {_b.Index(): _ad for _ad, _b in _teshis}
            _suclu = [_ad_map.get(i, f"?{i}")
                      for i in solver.SufficientAssumptionsForInfeasibility()]
            print("\n★ VARSAYIM TEŞHİSİ — çözümsüzlüğü açıklayan kural grupları:")
            if _suclu:
                for _s in _suclu:
                    print(f"     • {_s}")
                print(f"   → Bu grupların HEPSİ birden sağlanamıyor. Birini gevşet:")
                print(f"     H19D → TIP_ACIK_TOLERANS artır / TIP_KAPASITE_SERT=False")
                print(f"     H20E → MESAI_TOL artır (2 = kısıt ölü)")
                print(f"     H20B → MAX_HAFTA_OFF artır / HAFTA_OFF_SERT=False")
                print(f"     H18  → CIFT_HS_OFF=False   |   H16D → MAX_AKSAM_HAFTA artır")
            else:
                print("     (boş) → çözümsüzlük varsayıma bağlı OLMAYAN kurallardan")
                print("     geliyor: kota (H17), coverage sert bandı (H10), 11 saat (H15),")
                print("     kayan pencere (H12), takım tek tip (H19).")
        else:
            print("\n💡 İPUCU: TESHIS_MODU=True yapıp tekrar koş → CP-SAT hangi kural")
            print("   grubunun çözümsüzlüğe yol açtığını DOĞRUDAN söyler.")
    # ── SEBEP TARAMASI ────────────────────────────────────────────────
    print(f"\n⚠ {'INFEASIBLE' if _kanitli else solver.StatusName(status)} "
          f"— olası sebepler taranıyor:")
    # 1) agent kotayı dolduramıyor mu? (off_t artık kotayı DÜŞÜRMÜYOR → kota
    #    yükseldi; ama off_t günleri bloklu → kapasite yetmeyebilir.)
    #    kapasite = Σ min(o hafta müsait gün, haftalık tavan)  [tavan: 6, mesai_yok→5]
    kota_sorun = []
    for a in AGENTS:
        if a not in kota_map:
            continue
        bloklu = izin_map.get(a, set()) | off_block_map.get(a, set())
        hs_yasak = a in hafta_sonu_yasak                       # hamile/süt → hafta sonu çalışamaz
        cap = 5 if a in mesai_yok else 6                       # H16C haftalık tavan
        kapasite = sum(min(sum(1 for ds in gunler
                               if dt.date.fromisoformat(ds) not in bloklu
                               and not (hs_yasak and dt.date.fromisoformat(ds).weekday() >= 5)),
                           cap)
                       for gunler in haftalar.values())
        if kapasite < kota_map[a]:
            kota_sorun.append((a, kota_map[a], kapasite))
    if kota_sorun:
        print(f"  1) {len(kota_sorun)} agent kotayı DOLDURAMIYOR (kapasite < kota):")
        for a, kota, kap in sorted(kota_sorun, key=lambda t: t[2] - t[1])[:20]:
            print(f"       {a}: kota={kota}  kapasite={kap}  (açık {kap - kota})"
                  f"  → çok off_t/izin ya da hafta sonu telafisi yetmiyor")
    else:
        print("  1) kota-kapasite: sorun yok (her agent kotayı doldurabilir).")
    # 2) sert coverage bandı (hafta sonu ±HS_TOL, gece ±GECE_BUFFER) alt sınırı
    #    GERÇEK müsaitlik: "değişken var" yetmez — H13/H14/H16/H16B ve önceki ay
    #    taşıması (H15/H12) o değişkeni x==0'a çiviliyor olabilir. Hepsi düşülür.
    def _kapali(a, ds, v):
        """bu (agent,gün,vardiya) hangi SERT kural yüzünden 0'a çivili? (yoksa None)"""
        d = dt.date.fromisoformat(ds)
        bas, bit = saat[(ds, v)]
        if a in sabah_agents and not (dakika(bas) < dakika(bit) and dakika(bit) <= LIMIT):
            return "H13_sabah"
        if a in hafta_sonu_yasak and d.weekday() >= 5:
            return "H14_hamile_sut"
        if a in junior_agents and bas in GECE_TIPLERI:            # H14B kıdem/gece
            return "H14B_kidem_gece"
        if a in mesai_yok and d in TATIL:
            return "H16_tatil"
        if d in ARIFE:                                            # H16B arife atama kuralı
            if a in arife_kisitli and v != ARIFE_YARIM:
                return "H16B_arife"
            if a in mesai_yok and d.weekday() >= 5 and v == ARIFE_YARIM:
                return "H16B_arife"
            if a not in arife_kisitli and v == ARIFE_YARIM:
                return "H16B_arife"
        sv = onceki_son_vardiya.get(a)
        if sv and d == AY_ILK:                                    # H15 taşıma: 11 saat
            b1, e1 = sv.split("-")
            if bas_dakika(bas) + 1440 - bitis_abs(b1, e1) < DINLENME:
                return "H15_tasima"
        _cal = onceki_calisti.get(a)
        if _cal:                                                  # H12 taşıma: pencere tavanı 0
            for j in range(7):
                s = d - dt.timedelta(days=j)
                if sum(1 for k in range(7)
                       if s + dt.timedelta(days=k) < AY_ILK
                       and s + dt.timedelta(days=k) in _cal) >= 6:
                    return "H12_tasima"
        return None

    cov_sorun, _kural_say = [], {}
    for (ds, v), kisi in talep.items():
        d = dt.date.fromisoformat(ds)
        hs = d.weekday() >= 5
        gece = saat[(ds, v)][0] in GECE_BASLANGIC
        if not (hs or gece):
            continue                                          # sadece sert-band kovalar
        tol = HS_TOL if hs else GECE_BUFFER
        mus, kapali = 0, {}
        for a in AGENTS:
            if (a, ds, v) not in x:
                continue
            k = _kapali(a, ds, v)
            if k:
                kapali[k] = kapali.get(k, 0) + 1
                _kural_say[k] = _kural_say.get(k, 0) + 1
            else:
                mus += 1
        if mus < kisi - tol:                                  # alt bandı dolduramaz
            cov_sorun.append((ds, v, kisi, tol, mus, kapali))
    print(f"  2) sert-band kovalarda kapatan kurallar (toplam): {_kural_say}")
    if cov_sorun:
        print(f"     ⚠ {len(cov_sorun)} sert-band kova alt sınırı DOLAMIYOR:")
        for ds, v, kisi, tol, mus, kapali in cov_sorun[:20]:
            print(f"       {ds} {v} ({saat[(ds, v)][0]}-{saat[(ds, v)][1]}): "
                  f"talep={kisi} (min {kisi - tol}) ama GERÇEK müsait={mus}  "
                  f"| kapatanlar: {kapali}")
    else:
        print("     ✓ coverage sert-band: sorun yok (gerçek müsaitlik yeterli).")
    # 3) ÖNCEKİ AY TAŞIMASI: (2) sadece "değişken var mı" diye bakar — oysa taşıma
    #    o değişkenleri x==0 yapmış olabilir (H15 dinlenme yasağı, H12 tavan 0).
    #    Burada ayın ilk 7 gününde GERÇEKTEN atanabilir agent sayısı hesaplanır.
    if onceki_calisti:
        def _tasima_engelli(a, ds, v):
            """taşıma bu (agent,gün,vardiya)'yı kapatıyor mu?"""
            d = dt.date.fromisoformat(ds)
            sv = onceki_son_vardiya.get(a)
            if sv and d == AY_ILK:                                  # H15: 11 saat
                b1, e1 = sv.split("-")
                if bas_dakika(saat[(ds, v)][0]) + 1440 - bitis_abs(b1, e1) < DINLENME:
                    return "11saat"
            _cal = onceki_calisti.get(a)
            if _cal:                                                # H12: kayan pencere tavanı 0 mı
                for j in range(7):
                    s = d - dt.timedelta(days=j)
                    if sum(1 for k in range(7)
                           if s + dt.timedelta(days=k) < AY_ILK
                           and s + dt.timedelta(days=k) in _cal) >= 6:
                        return "7gun"
            return None
        _tas_sorun, _sebep = [], {"11saat": 0, "7gun": 0}
        for ds in PLAN_GUNLER[:7]:
            d = dt.date.fromisoformat(ds)
            for v in gun_vardiyalari[ds]:
                if (ds, v) not in talep:
                    continue
                hs = d.weekday() >= 5
                if not (hs or saat[(ds, v)][0] in GECE_BASLANGIC):
                    continue                                        # sadece sert-band kovalar
                kisi, tol = talep[(ds, v)], (HS_TOL if hs else GECE_BUFFER)
                mus = 0
                for a in AGENTS:
                    if (a, ds, v) not in x:
                        continue
                    e = _tasima_engelli(a, ds, v)
                    if e:
                        _sebep[e] += 1
                    else:
                        mus += 1
                if mus < kisi - tol:
                    _tas_sorun.append((ds, v, kisi, tol, mus))
        print(f"  3) taşıma sonrası ilk 7 gün: kapatılan (agent,gün,vardiya) → "
              f"11 saat {_sebep['11saat']}, 7 gün tavanı {_sebep['7gun']}")
        if _tas_sorun:
            print(f"     ⚠ {len(_tas_sorun)} sert-band kova taşıma YÜZÜNDEN dolamıyor:")
            for ds, v, kisi, tol, mus in _tas_sorun[:20]:
                print(f"       {ds} {v}: talep={kisi} (min {kisi - tol}) ama "
                      f"taşıma sonrası müsait agent={mus}")
        else:
            print("     ✓ taşıma tek başına sert-bandı kırmıyor "
                  "(sebep başka kısıtların birleşimi olabilir)")
    raise SystemExit(
        ("çözüm YOK — INFEASIBLE (kanıtlandı). Yukarıdaki teşhise bak."
         if _kanitli else
         f"çözüm BULUNAMADI — durum {solver.StatusName(status)}. Bu 'çözüm yok' "
         f"DEĞİL: süre yetmedi. FIZIBILITE_MODU=True ile teyit et."))
if FIZIBILITE_MODU:
    print("amaç: — (FİZİBİLİTE MODU: optimize EDİLMEDİ, çıktı plan değildir)")
else:
    print(f"amaç (toplam ceza): {solver.ObjectiveValue():.0f}")

# coverage: band içinde plana ne kadar yakın? (toplam sapma)
sapan, toplam_sapma = 0, 0
for (ds, v), kisi in talep.items():
    atanan = 0
    for a in AGENTS:
        if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
            atanan += 1
    fark = abs(atanan - kisi)
    if fark:
        sapan += 1
        toplam_sapma += fark
print(f"coverage: {sapan} çift talepten sapıyor (toplam sapma {toplam_sapma})")

# dağılım sağlaması: kişi başı çalışma günü (ilk 10 agent)
print("kişi başı çalışma günü (ilk 10):")
for a in AGENTS[:10]:
    calisma = 0
    for ds in PLAN_GUNLER:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
                calisma += 1
    print(f"  {a}: {calisma} gün")


# %% [HÜCRE 22] — SONUÇ / ROSTER ────────────────────────────────────────
# Çözümdeki 1 olan değişkenleri okunabilir tabloya çevir.
# solver.Value(x[...]) → 0/1; 1 olanlar atamadır.
sonuc = []
for a in AGENTS:
    for ds in PLAN_GUNLER:
