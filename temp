def ihtiyac_tablosu(df_actual, year, month, aht, queue='kitle', shrinkage=None,
                    verbose=True):
    """Gerçek çağrıdan gün × slot ihtiyaç.

    aht: DataFrame (data_date, interval, aht) | {saat: aht} | sayı
    Çıktı: data_date, gun, hafta_sonu, interval, cagri, aht, gereken
      gereken = Erlang-C · ASA ≤ 30 sn · shrinkage dahil (çizelgedeki kişi)
    """
    c = actual_calls_30(df_actual, year=year, month=month, queue=queue, verbose=False)
    c = c.rename(columns={f'actual_{queue}': 'cagri'})
    gunler = _ay_gunleri(year, month)
    d = pd.MultiIndex.from_product([gunler, SLOTS_30],
                                   names=['data_date', 'interval']).to_frame(index=False)
    d = d.merge(c, on=['data_date', 'interval'], how='left')
    d['cagri'] = d['cagri'].fillna(0).round().astype(int)

    if isinstance(aht, pd.DataFrame):
        d = d.merge(aht[['data_date', 'interval', 'aht']], on=['data_date', 'interval'],
                    how='left')
    elif isinstance(aht, dict):
        d['aht'] = d['interval'].str[:2].astype(int).map(
            lambda h: aht.get(h, aht.get('default', np.nan)))
    else:
        d['aht'] = float(aht)
    d['aht'] = pd.to_numeric(d['aht'], errors='coerce')
    gecerli = (d['cagri'] > 0) & (d['aht'] > 0)
    eksik = (d['cagri'] > 0) & ~gecerli
    if eksik.any():
        ort = float((d.loc[gecerli, 'aht'] * d.loc[gecerli, 'cagri']).sum()
                    / max(1, d.loc[gecerli, 'cagri'].sum()))
        d.loc[eksik, 'aht'] = ort
        if verbose:
            print(f"  ⚠ çağrısı olup AHT'si olmayan {int(eksik.sum()):,} slot → "
                  f"çağrı ağırlıklı ortalama AHT ({ort:.0f} sn) kullanıldı")
    d['aht'] = d['aht'].fillna(0).round(1)

    onbellek = {}
    def _g(cg, a, sl):
        key = (cg, round(a), sl)
        if key not in onbellek:
            onbellek[key] = gerekli_kisi(cg, a, sl, shrinkage)
        return onbellek[key]
    d['gereken'] = [_g(int(cg), float(a), sl)
                    for cg, a, sl in zip(d['cagri'], d['aht'], d['interval'])]
    d['gun'] = d['data_date'].dt.weekday.map(lambda i: GUN_TR[i])
    d['hafta_sonu'] = (d['data_date'].dt.weekday >= 5).astype(int)
    d = d[['data_date', 'gun', 'hafta_sonu', 'interval', 'cagri', 'aht', 'gereken']]

    if verbose:
        gc = d.groupby('data_date')['cagri'].sum()
        yok = list(gc[gc == 0].index)
        a = d[d['cagri'] > 0]['aht']
        print(f"İHTİYAÇ — {len(gunler) - len(yok)}/{len(gunler)} gün  |  toplam çağrı "
              f"{int(d['cagri'].sum()):,}  |  AHT {a.min():.0f}–{a.max():.0f} sn  |  "
              f"ihtiyaç {d['gereken'].sum() / 2:,.0f} kişi-saat")
        if yok:
            print(f"  ⚠ çağrı verisi olmayan {len(yok)} gün: "
                  f"{', '.join(x.strftime('%d.%m') for x in yok[:10])}")
    return d


def kaynak_tablosu(df_ihtiyac, kap):
    """İhtiyaç + tek kaynağın kapasitesi → karşılaştırma ve grafik girdisi."""
    out = df_ihtiyac.merge(kap, on=['data_date', 'interval'], how='left')
    out[KAP_KOL] = out[KAP_KOL].fillna(0).astype(int)
    return out


def ortak_gunler(tablolar, kodlar, verbose=True):
    """Karşılaştırmayı ADİL tutmak için: çağrısı olan VE her kaynağın planı olan
    günler. Birinin planı olmayan gün, o kaynağı 'eksik' göstermesin diye çıkar."""
    ilk = tablolar[kodlar[0]]
    gunler = set(ilk.loc[ilk['cagri'] > 0, 'data_date'])
    neden = {}
    for k in kodlar:
        t = tablolar[k]
        g = t.groupby('data_date')['kapasite_toplam'].sum()
        plansiz = set(g[g == 0].index) & gunler
        for x in plansiz:
            neden.setdefault(x, []).append(KAYNAKLAR[k])
        gunler -= plansiz
    out = {k: tablolar[k][tablolar[k]['data_date'].isin(gunler)].copy() for k in kodlar}
    if verbose and neden:
        print(f"  ℹ karşılaştırmadan çıkan {len(neden)} gün (planı yok): " + '; '.join(
            f"{x:%d.%m} {'/'.join(v)}" for x, v in sorted(neden.items())[:8]))
    return out, len(gunler)


