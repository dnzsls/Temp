# %% [HÜCRE 31] — INTERVAL BAZLI COVERAGE PICKLE (plan_vs_model girdisi) ─
# NE İŞE YARAR: plan_vs_model_karsilastirma.py bugün İKİ kaynağı kıyaslıyor —
#   build_plan_coverage(df_plan)        → elle yapılan vardiya planı (agent × gün)
#   model_coverage_from_results(results)→ Stage-1 pickle'ı (kova/slot talebi)
# EKSİK OLAN ÜÇÜNCÜ KAYNAK bu modelin ÇIKTISI: isimli agent ataması, yani
# "coverage'dan izin/off düşüldükten sonra sahada FİİLEN kaç kişi var".
# Stage-1 kaç kişi İSTEDİĞİNİ söylüyor, bu model kaç kişi KOYABİLDİĞİNİ.
# Bu hücre o farkı gün × 30dk interval bazında çıkarıp pickle'a yazar.
#
# İKİ TABLO BİRDEN yazılıyor (ikisi de aynı çözümden, tutarlı):
#   [A] agent_plan — agent × gün × vardiya, build_plan_coverage()'ın BİREBİR
#       beklediği kolon adlarıyla. Karşılaştırma tarafında yeni kod yazmadan
#       df_plan yerine bunu verip aynı fonksiyonu koşabilirsin.
#   [B] interval   — gün × interval hazır tablo: talep / atanan / fark.
#       Sadece merge edip bakmak istiyorsan bu yeter.
#
# SLOT KONVANSİYONU — plan_vs_model_karsilastirma.py ile BİREBİR aynı:
#   • 30 dakikalık slot, etiket slotun BAŞLANGICI ("09:00" = 09:00-09:30)
#   • '…-24:00' ve '…-00:00' gün sonu sayılır (48. slota kadar)
#   • GECEYİ AŞAN vardiya slotları AYNI GÜNE yazılır (00:00-08:00 → 3 Ağustos
#     kaydıysa 3 Ağustos'un ilk 16 slotu). Ertesi güne KAYDIRILMAZ — o taraftaki
#     shift_slots() de böyle yapıyor; iki tablo merge edilecekse aynı olmalı.
#     Gerçek çağrı verisiyle gece analizi yapılacaksa bu kaydırma İKİ TARAFTA
#     BİRDEN düzeltilmeli, tek tarafta değil.
COV_PKL_PATH = f"agent_cov_{QUEUE}_{AY_YIL}_{AY_AY:02d}.pkl"
ARIFE_SAY    = True     # arife yarım vardiyası (09:00-13:00) sahada sayılsın mı.
                        # Modelin coverage'ına GİRMİYOR (talep'e eklenmiyor, H8)
                        # ama o kişi fiilen telefonda → gerçek çağrıyla kıyasta
                        # sayılmalı. Ayrı kolonda da tutuluyor (arife_*), böylece
                        # "coverage ölçüsü" ile "sahadaki kişi" karışmıyor.

_SLOTS   = [f"{_h:02d}:{_m:02d}" for _h in range(24) for _m in (0, 30)]
_SLOT_IX = {_s: _i for _i, _s in enumerate(_SLOTS)}


def _slotlar(bas, bit):
    """('15:00','24:00') → kapsadığı 30dk slot listesi (geceyi aşan dahil).
    plan_vs_model_karsilastirma.shift_slots() ile aynı mantık."""
    _bh, _bm = (int(_t) for _t in str(bas).split(":"))
    _eh, _em = (int(_t) for _t in str(bit).split(":"))
    _i = _SLOT_IX[f"{_bh % 24:02d}:{(_bm // 30) * 30:02d}"]
    if _eh == 24 or (_eh % 24) * 60 + _em == 0:      # '…-24:00' / '…-00:00' → gün sonu
        _j = len(_SLOTS)
    else:
        _j = (_eh % 24) * 2 + _em // 30
    if _j <= _i:                                     # geceyi aşıyor → bir tur ekle
        _j += len(_SLOTS)
    return [_SLOTS[_k % len(_SLOTS)] for _k in range(_i, _j)]


def _mesai_mi(a, ds):
    """O gün ÜCRETLİ MESAİ mi? (Excel LEJANT'ındaki kategorilerle birebir)
    mesai  = resmi tatilde çalışma | arife tam gün | hafta sonu (norm/telafi DEĞİL)
    norm   = aynı hafta hafta içi off'unun karşılığı → kota İÇİNDE, mesai değil
    telafi = başka haftadaki fazla off'un karşılığı → ücretli mesai DEĞİL"""
    _d = dt.date.fromisoformat(ds)
    if _d in TATIL:
        return 1
    if _d in ARIFE and a not in arife_kisitli:       # LEJANT: 'ARİFE MESAİ'
        return 1
    if _d.weekday() < 5:
        return 0
    return int((a, ds) not in _norm_hucre and (a, ds) not in _telafi_hucre)


