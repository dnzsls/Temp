def _erlang_cfg(config, date_like):
    """calculate_erlang_all'ın beklediği ŞEKİLDE config döndürür.

    find_optimal_agents `config['queue_configs'][queue]['erlang']` diye
    okuyor — yani gün tipi katmanını bilmiyor. Burada o günün tipine ait
    blok, queue_configs'in DOĞRUDAN altına taşınır. Tüm kuyruklar için
    yapılır, çünkü calculate_erlang_all hepsini dolaşıyor.
    """
    tip = gun_tipi(date_like)
    qc = {q: config['queue_configs'][q][tip] for q in config['queues']}
    yeni = copy.copy(config)
    yeni['queue_configs'] = qc
    return yeni


def erlang_per_day(df_calls_30, queue, dates, config):
    """{tarih: {slot: ihtiyaç}} — her gün KENDİ gün tipinin shrinkage'ı ile.

    Shrinkage hafta içi / Cumartesi / Pazar için farklı. Tek config ile
    hesaplanamaz, bu yüzden gün gün blok çözülüp o günün satırları süzülür.
    """
    out = {}
    for ds in dates:
        cfg_d = _erlang_cfg(config, ds)
        df_g = df_calls_30[df_calls_30['data_date'] == pd.to_datetime(ds)]
        if len(df_g) == 0:
            out[ds] = {}
            continue
        df_e = calculate_erlang_all(df_g, config=cfg_d)
        df_q = df_e[df_e['queue'] == queue]
        out[ds] = {s: int(v) for s, v in zip(df_q['slot'], df_q['erlang_need'])}
    return out


