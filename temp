_s1 = []
for a in mesai_yok:
    if a not in kota_map:
        continue
    _top = 0
    for wk, gl in haftalar.items():
        _wd = sum(1 for ds in gl
                  if dt.date.fromisoformat(ds).weekday() < 5
                  and dt.date.fromisoformat(ds) not in TATIL
                  and any((a, ds, v) in x for v in gun_vardiyalari[ds]))
        _tav = _wd
        if wk == SINIR_HAFTA and a in onceki_gun:
            _tav = max(0, _wd + onceki_musait_hi.get(a, 0) - onceki_gun[a])
        _top += _tav
    if _top < kota_map[a]:
        _s1.append((a, "tavan toplamı", _top, "kota", kota_map[a]))
print(len(_s1), _s1[:20])



_s2 = []
