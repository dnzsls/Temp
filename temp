# BİZİM MODEL-2 PAKETİ (agent_cov_*.pkl) → slot
# ---------------------------------------------------------------------------


# Model 2'nin df_sonuc'u: agent | tarih | vardiya | saat  (+takim)
#   'saat' = "09:00-18:00" (çözümlenebilir), 'vardiya' = kova anahtarı (olmayabilir)
#   → shift adayları 'saat' ile BAŞLIYOR.
# Excel 'plan_vs_gerceklesen' sayfası: tarih | saat | planlanan | gerceklesen
#   → kisi adaylarında 'gerceklesen' var.
DEFAULT_M2_COLS = {
    'date':  ['data_date', 'date', 'tarih'],
    'slot':  ['interval', 'slot_30', 'slot', 'min_time_period_value'],
    'shift': ['saat', 'vardiya', 'shift'],
    'agent': ['agent_user_code', 'agent', 'agent_id', 'sicil'],
    'kisi':  ['kisi', 'kisi_sayisi', 'gerceklesen', 'coverage', 'count', 'adet'],
}


ARIFE_YARIM_KOD = '__ARIFE_YARIM__'    # model 2'nin coverage'a girmeyen 9-13 ek vardiyası


def model2_coverage(df_model2, year=2026, month=8, cols=None, queue='kitle',
                    kolon='sahada', verbose=True):
    """Atama modeli (model 2) çıktısını slot bazlı inhouse coverage'a çevirir.

    Girdi biçimleri:
      0) PAKET (dict) : agent_cov_*.pkl — {'interval','agent_plan','gun','atama'}
                        → 'interval' tablosu doğrudan kullanılır (en hızlı yol)
      1) SLOT   : data_date, interval, kisi
      2) VARDİYA: data_date, vardiya, kisi          → shift_slots ile açılır
      3) AGENT  : data_date, vardiya, agent_user_code → slotta tekil agent sayılır

    kolon: paket girdisinde hangi sütun okunacak
      'sahada' → atanan + arife  (sahada fiilen telefonda olan kişi) — VARSAYILAN
      'atanan' → arife hariç     (Stage-1 coverage ile aynı ölçü)

    Çıktı: data_date, interval, model2_in
    """
    # ── 0) PAKET (dict) → interval tablosu ────────────────────────────
    if isinstance(df_model2, dict):
        _meta = df_model2.get('meta', {})
        if 'interval' not in df_model2:
            raise KeyError(f"MODEL2 paketinde 'interval' tablosu yok. "
                           f"Anahtarlar: {list(df_model2)}")
        d = df_model2['interval'].copy()
        _q = _meta.get('kuyruk', queue)
        _tercih = [f"{kolon}_{_q}", f"sahada_{_q}", f"atanan_{_q}",
                   'sahada', 'atanan', 'model2_in']
        _kol = next((k for k in _tercih if k in d.columns), None)
        if _kol is None:
            raise KeyError(f"MODEL2 interval tablosunda kişi kolonu yok. "
                           f"Mevcut: {list(d.columns)}")
        if 'plani_var' in d.columns:
            d = d[d['plani_var'] == 1]              # planı olmayan gün → coverage yok
        out = pd.DataFrame({
            'data_date': _to_date_series(d['data_date']).dt.normalize(),
            'interval': d['interval'].map(_to_slot_30),
            'model2_in': pd.to_numeric(d[_kol], errors='coerce').fillna(0),
        })
        out = out.groupby(['data_date', 'interval'], as_index=False).sum()
        out = out[(out['data_date'].dt.year == year) &
                  (out['data_date'].dt.month == month)]
        out['model2_in'] = out['model2_in'].round().astype(int)
        out = out.sort_values(['data_date', 'interval']).reset_index(drop=True)
        if verbose:
            print(f"MODEL2 (paket '{_kol}') — {out['data_date'].nunique()} gün, "
                  f"{len(out):,} slot, tepe {int(out['model2_in'].max())} kişi"
                  + (f"  |  kaynak durum: {_meta['durum']}" if 'durum' in _meta else ""))
            if _kol.startswith('atanan'):
                print("  ℹ arife yarım vardiyası HARİÇ (coverage ölçüsü). "
                      "Sahadaki kişi için kolon='sahada'.")
        return out

    c = {**DEFAULT_M2_COLS, **(cols or {})}
    d_col = _resolve_col(df_model2, c['date'])
    s_col = _resolve_col(df_model2, c['slot'])
    v_col = _resolve_col(df_model2, c['shift'])
    a_col = _resolve_col(df_model2, c['agent'])
    k_col = _resolve_col(df_model2, c['kisi'])

    if d_col is None:
        raise KeyError(f"MODEL2: tarih kolonu yok  |  mevcut: {list(df_model2.columns)}")

    df = df_model2.copy()

    # Arife yarım vardiyası (09:00-13:00 ek) coverage'a GİRMEZ → düş
    for _k in ('vardiya', 'shift'):
        if _k in df.columns:
            _m = df[_k].astype(str) == ARIFE_YARIM_KOD
            if _m.any():
                if verbose:
                    print(f"  ℹ MODEL2: {int(_m.sum()):,} arife yarım vardiya satırı "
                          f"elendi (coverage dışı).")
                df = df[~_m]
            break

    df['data_date'] = _to_date_series(df[d_col]).dt.normalize()
    n0 = len(df)
    df = df[(df['data_date'].dt.year == year) & (df['data_date'].dt.month == month)]
    if verbose and len(df) < n0:
        print(f"  ℹ MODEL2: {n0 - len(df):,} satır {year}/{month:02d} dışında, elendi.")

    if s_col is not None and k_col is not None:                 # 1) slot bazlı
        bicim = 'slot bazlı'
        df['interval'] = df[s_col].map(_to_slot_30)
        df['model2_in'] = pd.to_numeric(df[k_col], errors='coerce').fillna(0)
        out = df.groupby(['data_date', 'interval'], as_index=False)['model2_in'].sum()

    elif v_col is not None:                                     # 2/3) vardiya bazlı
        slot_map = {v: shift_slots(v) for v in df[v_col].astype(str).unique()}
        cozulmeyen = [v for v, s in slot_map.items() if not s]
        if cozulmeyen:
            print(f"  ⚠ MODEL2: vardiya olarak okunamayan {len(cozulmeyen)} değer "
                  f"(off/izin sayıldı): {cozulmeyen[:8]}")
        df['interval'] = df[v_col].astype(str).map(slot_map)
        df = df.explode('interval').dropna(subset=['interval'])

        if k_col is not None:                                   # 2) vardiya + kişi
            bicim = 'vardiya bazlı (kişi sayısı)'
            df['model2_in'] = pd.to_numeric(df[k_col], errors='coerce').fillna(0)
            out = df.groupby(['data_date', 'interval'], as_index=False)['model2_in'].sum()
        elif a_col is not None:                                 # 3) agent bazlı
            bicim = 'agent bazlı (tekil agent)'
            out = (df.groupby(['data_date', 'interval'])[a_col]
                     .nunique().rename('model2_in').reset_index())
        else:
            raise KeyError("MODEL2: vardiya var ama ne kişi sayısı ne agent kolonu "
                           f"bulundu  |  mevcut: {list(df_model2.columns)}")
    else:
        raise KeyError("MODEL2: slot/vardiya kolonu bulunamadı  |  "
                       f"mevcut: {list(df_model2.columns)}")

    out['model2_in'] = out['model2_in'].round().astype(int)
    out = out.sort_values(['data_date', 'interval']).reset_index(drop=True)

    if verbose:
        print(f"MODEL2 ({bicim}) — {out['data_date'].nunique()} gün, "
              f"{len(out):,} slot, tepe {int(out['model2_in'].max())} kişi")
    return out


# ---------------------------------------------------------------------------
# AYLIK SLA DEFTERİ — ÇAĞRI cinsinden (HÜCRE 7-8)
# ---------------------------------------------------------------------------


SLA_HEDEF = 0.80          # aylık servis seviyesi hedefi


SLA_SANIYE = 30           # "30 saniye içinde"


def calc_sl(agents, traffic, aht, T=SLA_SANIYE):
    """P(bekleme ≤ T sn) — Erlang-C'nin SERVİS SEVİYESİ çıktısı.

    agents : TELEFONDA olan kişi (shrinkage DÜŞÜLMÜŞ) — çizelgedeki kişi DEĞİL
    traffic: erlang (çağrı × AHT / interval)
    aht    : saniye
    """
    if agents <= traffic or agents <= 0:
        return 0.0                       # kuyruk patlar → 30 sn içinde cevap ~0
    ec = _erlang_c(agents, traffic)
    return max(0.0, min(1.0, 1.0 - ec * math.exp(-(agents - traffic) * T / aht)))


def _telefonda(kisi, slot, shrinkage=None):
    """Çizelgedeki kişi → TELEFONDA olan kişi.

    erlang_need de dahil tüm kadro sayıları shrinkage ŞİŞİRİLMİŞ:
        final = ceil(raw / (1 − shr))
    SL'i şişirilmiş sayıyla hesaplamak SL'i olduğundan YÜKSEK gösterir.
    """
    shr_cfg = shrinkage if shrinkage is not None else KITLE_SHRINKAGE
    shr = shr_cfg.get(int(str(slot)[:2]), shr_cfg.get('default', 0.0))
    return float(kisi) * (1.0 - shr)


def _aht_kolonu(df, aht):
    """aht: sayı | {saat: aht} | DataFrame(data_date, interval, aht) → Series."""
    if isinstance(aht, pd.DataFrame):
        d = df[['data_date', 'interval']].merge(aht, on=['data_date', 'interval'],
                                                how='left')
        return d['aht'].fillna(float(aht['aht'].mean())).values
    return [_aht_of(aht, s) for s in df['interval']]


def gereken_telefonda(calls, aht, hedef=SLA_HEDEF, T=SLA_SANIYE):
    """O slotta SL ≥ hedef için TELEFONDA kaç kişi gerekir (tam sayı)."""
    if calls <= 0:
        return 0
    traffic = (calls * (aht / 60.0)) / INTERVAL_MIN
    ust = math.ceil(traffic * 3) + 30
    for a in range(math.ceil(traffic), ust + 1):
        if calc_sl(a, traffic, aht, T) >= hedef:
            return a
    return ust


def _cizelge_karsiligi(telefonda, slot, shrinkage=None):
    """TELEFONDA gereken kişi → ÇİZELGEYE yazılması gereken kişi (shrinkage ters)."""
    shr_cfg = shrinkage if shrinkage is not None else KITLE_SHRINKAGE
    shr = shr_cfg.get(int(str(slot)[:2]), shr_cfg.get('default', 0.0))
    return math.ceil(telefonda / (1.0 - shr)) if shr < 1 else telefonda


def sla_slot_tablosu(df_hakem, aht, hedef=SLA_HEDEF, T=SLA_SANIYE,
                     shrinkage=None, verbose=True):
    """df_hakem → her slot için katman başına SL + kredi/borç (ÇAĞRI cinsinden).

    Eklenen kolonlar (mevcut her katman için):
        sl_<kod>     : o slotta 30 sn içinde cevaplanma oranı (0..1)
        kredi_<kod>  : çağrı × (SL − hedef)   → (+) kredi, (−) borç
    Kimlik: Σ kredi_<kod> = −AÇIK   (defter kapanır)

    ÇAĞRISI OLMAYAN slot dışarıda bırakılır — SL tanımsız, ağırlığı da 0.
    """
    df = df_hakem.copy()
    if 'actual_kitle' not in df.columns:
        raise KeyError("sla_slot_tablosu: 'actual_kitle' (gerçek çağrı) yok — "
                       "hakem_tablosu çıktısını ver.")
    df = df[pd.to_numeric(df['actual_kitle'], errors='coerce').fillna(0) > 0].copy()
    if df.empty:
        raise ValueError("Çağrısı olan slot yok — df_actual ile kesişimi kontrol et.")

    df['aht_sn'] = _aht_kolonu(df, aht)
    df['traffic'] = (df['actual_kitle'] * (df['aht_sn'] / 60.0)) / INTERVAL_MIN

    _var = []
    for kod, _et, kol in SLA_KATMANLAR:
        if kol not in df.columns:
            continue
        _var.append(kod)
        df[f'tel_{kod}'] = [_telefonda(k, s, shrinkage)
                            for k, s in zip(df[kol], df['interval'])]
        df[f'sl_{kod}'] = [calc_sl(a, t, h, T) for a, t, h
                           in zip(df[f'tel_{kod}'], df['traffic'], df['aht_sn'])]
        df[f'kredi_{kod}'] = df['actual_kitle'] * (df[f'sl_{kod}'] - hedef)
    if verbose:
        _eks = [e for k, e, c in SLA_KATMANLAR if k not in _var]
        print(f"SLA slot tablosu: {len(df):,} slot (çağrısı olan), "
              f"{df['data_date'].nunique()} gün  |  katman: {_var}")
        if _eks:
            print(f"  ℹ girdisi olmayan katman (atlandı): {_eks}")
    return df


def sla_defteri(df_sla, hedef=SLA_HEDEF, T=SLA_SANIYE, verbose=True):
    """[BÖLÜM 1] AYLIK DEFTER — katman başına tek satır, ÇAĞRI cinsinden."""
    C = float(df_sla['actual_kitle'].sum())
    HEDEF = hedef * C
    satir = []
    for kod, et, kol in SLA_KATMANLAR:
        if f'sl_{kod}' not in df_sla.columns:
            satir.append({'katman': et, 'telefonda_ort': None, 'aylik_SL': None,
                          'cevaplanan': None, 'hedef': round(HEDEF),
                          'ACIK_cagri': None, 'durum': '— girdi yok'})
            continue
        A = float((df_sla['actual_kitle'] * df_sla[f'sl_{kod}']).sum())
        acik = HEDEF - A
        satir.append({
            'katman': et,
            'telefonda_ort': round(df_sla[f'tel_{kod}'].mean(), 1),
            'aylik_SL': round(100 * A / C, 2),
            'cevaplanan': round(A),
            'hedef': round(HEDEF),
            'ACIK_cagri': round(acik),
            'durum': '✓ TUTUYOR' if acik <= 0 else '⚠ AÇIK',
        })
    out = pd.DataFrame(satir)
    if verbose:
        print(f"\n[1] AYLIK SLA DEFTERİ  (hedef %{hedef*100:.0f} / {T} sn)")
        print(f"    toplam çağrı (C)          : {C:>12,.0f}")
        print(f"    hedef 30sn-içi ({hedef:.2f}×C) : {HEDEF:>12,.0f}")
        print(f"    → AÇIK = hedef − cevaplanan  (≤0 ise hedef tutuyor)")
        show(out)
        print(f"    NOT: SL, TELEFONDA olan kişiden hesaplanıyor "
              f"(shrinkage düşülmüş). Çizelgedeki kişi daha yüksek.")
    return out


def sla_kredi_borc(df_sla, katman='model2', hedef=SLA_HEDEF, verbose=True):
    """[BÖLÜM 2] Hangi slotlar ödüyor, hangileri yiyor — ÇAĞRI cinsinden.

    Kimlik: KREDİ + BORÇ = −AÇIK. Bol slottaki fazlalık dar slottaki açığı öder;
    bu yüzden slot bazlı %80 aramak GEREKSİZ.
    """
    kol = f'sl_{katman}'
    if kol not in df_sla.columns:
        print(f"  ℹ katman '{katman}' yok — atlandı.")
        return None
    ust = df_sla[df_sla[kol] >= hedef]
    alt = df_sla[df_sla[kol] < hedef]
    kredi = float(ust[f'kredi_{katman}'].sum())
    borc = float(alt[f'kredi_{katman}'].sum())          # negatif
    kadrosuz = df_sla[df_sla[f'tel_{katman}'] <= 0]
    out = pd.DataFrame([
        {'grup': f'SL ≥ %{hedef*100:.0f}', 'slot': len(ust),
         'cagri': round(ust['actual_kitle'].sum()), 'katki_cagri': round(kredi)},
        {'grup': f'SL < %{hedef*100:.0f}', 'slot': len(alt),
         'cagri': round(alt['actual_kitle'].sum()), 'katki_cagri': round(borc)},
        {'grup': 'NET', 'slot': len(df_sla),
         'cagri': round(df_sla['actual_kitle'].sum()),
         'katki_cagri': round(kredi + borc)},
    ])
    if verbose:
        print(f"\n[2] KREDİ / BORÇ  — katman '{katman}'")
        show(out)
        print(f"    NET katkı = −AÇIK  (defter kapanıyor)")
        if len(kadrosuz):
            print(f"    ⚠ ÇAĞRI VAR AMA KADRO YOK: {len(kadrosuz)} slot, "
                  f"{int(kadrosuz['actual_kitle'].sum()):,} çağrı → SAF BORÇ "
                  f"({round(float(kadrosuz[f'kredi_{katman}'].sum())):,})")
            print(f"      (gece dilimleri; borcun bu kısmı kadro ekleyerek değil "
                  f"vardiya AÇARAK kapanır)")
    return out


def sla_en_borclu(df_sla, katman='model2', n=15, verbose=True):
    """[BÖLÜM 3] En çok borç yazan slotlar — aylık açığın nereden geldiği."""
    kol = f'kredi_{katman}'
    if kol not in df_sla.columns:
        print(f"  ℹ katman '{katman}' yok — atlandı.")
        return None
    _, _, kisi_kol = next(k for k in SLA_KATMANLAR if k[0] == katman)
    out = (df_sla.nsmallest(n, kol)[
        ['data_date', 'interval', 'actual_kitle', kisi_kol,
         f'tel_{katman}', f'sl_{katman}', kol]].copy())
    out[f'sl_{katman}'] = (100 * out[f'sl_{katman}']).round(1)
    out[f'tel_{katman}'] = out[f'tel_{katman}'].round(1)
    out[kol] = out[kol].round(0)
    out = out.rename(columns={'actual_kitle': 'cagri', kisi_kol: 'cizelgede',
                              f'tel_{katman}': 'telefonda',
                              f'sl_{katman}': 'SL_%', kol: 'borc_cagri'})
    if verbose:
        print(f"\n[3] EN ÇOK BORÇ YAZAN {n} SLOT — katman '{katman}'")
        show(out)
    return out


def sla_marjinal(df_sla, katman='model2', n=15, hedef=SLA_HEDEF,
                 shrinkage=None, T=SLA_SANIYE, verbose=True):
    """[BÖLÜM 4] +1 KİŞİ NEREYE? — marjinal kazanç ÇAĞRI cinsinden.

        kazanc_i = çağrı_i × [ SL_i(kişi+1) − SL_i(kişi) ]

    200 çağrılı slotta +1 kişi, 20 çağrılı slotta +1 kişiden 10 KAT fazla
    aylık SL satın alır. Model-1 bu sayıyı hiç bilmiyor — erlang_need her
    slota bağımsız bakıyor, HACMİ hiç tartmıyor.
    """
    if f'sl_{katman}' not in df_sla.columns:
        print(f"  ℹ katman '{katman}' yok — atlandı.")
        return None
    _, _, kisi_kol = next(k for k in SLA_KATMANLAR if k[0] == katman)
    d = df_sla.copy()
    d['sl_art1'] = [calc_sl(_telefonda(k + 1, s, shrinkage), t, h, T)
                    for k, s, t, h in zip(d[kisi_kol], d['interval'],
                                          d['traffic'], d['aht_sn'])]
    d['kazanc_cagri'] = d['actual_kitle'] * (d['sl_art1'] - d[f'sl_{katman}'])

    # ── KRİTİK slot: telefonda ≤ trafik → kuyruk PATLIYOR, SL≈0.
    # Burada +1 kişi HİÇBİR ŞEY kazandırmaz (0 → 0) → saf marjinal sıralama bu
    # slotları EN SONA atar, oysa aylık açığın büyük kısmı buradan gelir.
    # Bu yüzden ayrı listelenir ve "kaç kişi gerekir" hesaplanır.
    d['kritik'] = d[f'tel_{katman}'] <= d['traffic']
    d['gereken_tel'] = [gereken_telefonda(c, h, hedef, T)
                        for c, h in zip(d['actual_kitle'], d['aht_sn'])]
    d['gereken_cizelge'] = [_cizelge_karsiligi(g, s, shrinkage)
                            for g, s in zip(d['gereken_tel'], d['interval'])]
    d['eksik_kisi'] = (d['gereken_cizelge'] - d[kisi_kol]).clip(lower=0)
    # o slotu hedefe çekmenin TAM kazancı (kısmi değil)
    d['tam_kazanc_cagri'] = d['actual_kitle'] * (hedef - d[f'sl_{katman}'])

    C = float(d['actual_kitle'].sum())
    A = float((d['actual_kitle'] * d[f'sl_{katman}']).sum())
    acik0 = hedef * C - A

    _kr = d[d['kritik']]
    if verbose and len(_kr):
        _o = _kr.nlargest(n, 'tam_kazanc_cagri')[
            ['data_date', 'interval', 'actual_kitle', kisi_kol,
             f'tel_{katman}', 'traffic', 'gereken_cizelge', 'eksik_kisi',
             'tam_kazanc_cagri']].copy()
        _o[f'tel_{katman}'] = _o[f'tel_{katman}'].round(1)
        _o['traffic'] = _o['traffic'].round(1)
        _o['tam_kazanc_cagri'] = _o['tam_kazanc_cagri'].round(0)
        _o = _o.rename(columns={'actual_kitle': 'cagri', kisi_kol: 'cizelgede',
                                f'tel_{katman}': 'telefonda',
                                'traffic': 'trafik',
                                'gereken_cizelge': 'gereken',
                                'eksik_kisi': '+kisi',
                                'tam_kazanc_cagri': 'kazanc_cagri'})
        print(f"\n[4a] ⚠ KRİTİK SLOTLAR — telefonda ≤ trafik, kuyruk PATLIYOR "
              f"(SL≈0)")
        print(f"     Burada +1 kişi işe YARAMAZ; '+kisi' kadar eklemek gerekir.")
        show(_o)
        print(f"     kritik slot: {len(_kr)}  |  "
              f"çağrı {int(_kr['actual_kitle'].sum()):,}  |  "
              f"toplam kazanç potansiyeli "
              f"{float(_kr['tam_kazanc_cagri'].sum()):,.0f} çağrı  "
              f"(AÇIK'ın %{100*float(_kr['tam_kazanc_cagri'].sum())/max(1,acik0):.0f}'i)")
        print(f"     gereken toplam ek kişi-slot: {int(_kr['eksik_kisi'].sum()):,}")

    d = d[~d['kritik']]                     # marjinal sıralama SADECE kalanlar
    if d.empty:
        if verbose:
            print(f"\n[4b] +1 KİŞİ NEREYE: kritik olmayan slot yok — "
                  f"önce [4a]'yı kapat.")
        return None
    ilk = d.nlargest(n, 'kazanc_cagri')
    kum = float(ilk['kazanc_cagri'].sum())

    out = ilk[['data_date', 'interval', 'actual_kitle', kisi_kol,
               f'sl_{katman}', 'sl_art1', 'kazanc_cagri']].copy()
    out[f'sl_{katman}'] = (100 * out[f'sl_{katman}']).round(1)
    out['sl_art1'] = (100 * out['sl_art1']).round(1)
    out['kazanc_cagri'] = out['kazanc_cagri'].round(1)
    out = out.rename(columns={'actual_kitle': 'cagri', kisi_kol: 'kisi',
                              f'sl_{katman}': 'SL_%', 'sl_art1': 'SL+1_%'})
    if verbose:
        print(f"\n[4b] +1 KİŞİ NEREYE?  — katman '{katman}' "
              f"(marjinal kazanç; kritik slotlar HARİÇ)")
        show(out)
        print(f"    bu {n} slota +1 kişi → kazanç {kum:,.0f} çağrı  |  "
              f"AÇIK {acik0:,.0f} → {acik0 - kum:,.0f}")
        if acik0 - kum <= 0:
            print(f"    ✓ bu {n} slot aylık hedefi TUTTURMAYA YETER")
        else:
            print(f"    ⚠ yetmez — aynı mantıkla listeyi uzat (n'i büyüt)")
    return out


def sla_saat_bazinda(df_sla, katman='model2', verbose=True):
    """Saat bazında toplu görünüm — hangi saat dilimi borcu taşıyor."""
    if f'sl_{katman}' not in df_sla.columns:
        return None
    g = df_sla.groupby(df_sla['interval'].str[:2]).apply(
        lambda x: pd.Series({
            'slot': len(x),
            'cagri': round(x['actual_kitle'].sum()),
            'SL_%': round(100 * (x['actual_kitle'] * x[f'sl_{katman}']).sum()
                          / max(1.0, x['actual_kitle'].sum()), 1),
            'katki_cagri': round(x[f'kredi_{katman}'].sum()),
        }), include_groups=False).reset_index(names='saat')
    if verbose:
        print(f"\n[5] SAAT BAZINDA — katman '{katman}'")
        show(g)
    return g


def _sla_kod_kol(katman):
    """katman kodu → df_hakem'deki kişi kolonu (SLA_KATMANLAR'dan)."""
    return next(k[2] for k in SLA_KATMANLAR if k[0] == katman)


def _sla_et(katman):
    return next(k[1] for k in SLA_KATMANLAR if k[0] == katman)


def _sla_toplam(df_sla, katman):
    """(C, A, AÇIK) — çağrı, 30sn-içi cevaplanan, açık."""
    C = float(df_sla['actual_kitle'].sum())
    A = float((df_sla['actual_kitle'] * df_sla[f'sl_{katman}']).sum())
    return C, A, SLA_HEDEF * C - A


def sla_ikili(df_sla, kod_a, kod_b, hedef=SLA_HEDEF, verbose=True):
    """İKİ KATMANI YAN YANA — tek tabloda, ÇAĞRI cinsinden fark.

    Amaç: "hangisi daha iyi ve aradaki fark kaç çağrı" sorusunu tek bakışta
    cevaplamak. Katmanlar arası fark = o adımda kaybedilen/kazanılan çağrı.
    """
    _yok = [k for k in (kod_a, kod_b) if f'sl_{k}' not in df_sla.columns]
    if _yok:
        print(f"  ℹ girdisi olmayan katman: {_yok} — bu karşılaştırma atlandı.")
        return None
    C = float(df_sla['actual_kitle'].sum())
    satir = []
    for k in (kod_a, kod_b):
        _, A, acik = _sla_toplam(df_sla, k)
        satir.append({
            'katman': _sla_et(k),
            'kisi_ort': round(df_sla[_sla_kod_kol(k)].mean(), 1),
            'telefonda_ort': round(df_sla[f'tel_{k}'].mean(), 1),
            'aylik_SL_%': round(100 * A / C, 2),
            'cevaplanan': round(A),
            'ACIK_cagri': round(acik),
            'durum': '✓ TUTUYOR' if acik <= 0 else '⚠ AÇIK',
        })
    out = pd.DataFrame(satir)
    if verbose:
        _, A_a, ac_a = _sla_toplam(df_sla, kod_a)
        _, A_b, ac_b = _sla_toplam(df_sla, kod_b)
        print(f"toplam çağrı {C:,.0f}  |  hedef (%{hedef*100:.0f}) "
              f"{hedef*C:,.0f} çağrı")
        show(out)
        _d = A_b - A_a
        print(f"  FARK ({_sla_et(kod_b).strip()} − {_sla_et(kod_a).strip()}): "
              f"{_d:+,.0f} çağrı  ({100*(A_b-A_a)/C:+.2f} puan SL)")
        print(f"  → eksi ise: bu adımda {abs(_d):,.0f} çağrı KAYBEDİLDİ")
    return out


def sla_slot_detay(df_sla, katmanlar=('model1', 'model2'), gun=None,
                   hedef=SLA_HEDEF, n=None, sirala='borc', verbose=True):
    """SLOT BAZLI: kişi + SL + İKİ TÜR RR, katmanlar yan yana.

    İki ayrı RR — karıştırmamak için ikisi de basılıyor:
      RRsl = SL_i / hedef          → 1.00 = tam hedefte (SERVİS ölçüsü)
      RRk  = kişi_i / ihtiyaç_i    → 1.00 = Erlang ihtiyacı kadar kişi (KADRO ölçüsü)
    Aynı slotta RRk = 1.00 ama RRsl = 0.85 olabilir: kadro "yeterli" ama
    ihtiyaç ASA=30'a göre hesaplandığı için SL %80'i tutmuyor. Model-1'in
    sizing kriteri (ASA) ile iş hedefi (SL) arasındaki fark tam buradan okunur.

    sirala: 'borc' (en çok borç yazan önce) | 'tarih' | 'cagri'
    gun   : '2026-08-05' → sadece o gün
    """
    _var = [k for k in katmanlar if f'sl_{k}' in df_sla.columns]
    if not _var:
        print(f"  ℹ hiçbiri yok: {katmanlar}")
        return None
    d = df_sla.copy()
    if gun is not None:
        d = d[pd.to_datetime(d['data_date']) == pd.Timestamp(gun)]
        if d.empty:
            print(f"  ℹ {gun} tabloda yok.")
            return None

    out = d[['data_date', 'interval', 'actual_kitle', 'ihtiyac', 'traffic']].copy()
    out['traffic'] = out['traffic'].round(1)
    for k in _var:
        kol = _sla_kod_kol(k)
        out[f'kisi_{k}'] = d[kol]
        out[f'SL_{k}_%'] = (100 * d[f'sl_{k}']).round(1)
        out[f'RRsl_{k}'] = (d[f'sl_{k}'] / hedef).round(2)
        out[f'RRk_{k}'] = (d[kol] / d['ihtiyac'].where(d['ihtiyac'] > 0)).round(2)
        out[f'borc_{k}'] = d[f'kredi_{k}'].round(0)
    out = out.rename(columns={'actual_kitle': 'cagri', 'traffic': 'trafik'})

    if sirala == 'borc':
        out = out.sort_values(f'borc_{_var[0]}')
    elif sirala == 'cagri':
        out = out.sort_values('cagri', ascending=False)
    else:
        out = out.sort_values(['data_date', 'interval'])
    out = out.reset_index(drop=True)

    if verbose:
        print(f"SLOT BAZLI — katman {list(_var)}  |  {len(out):,} slot"
              + (f"  |  {gun}" if gun else "")
              + f"  |  sıralama: {sirala}")
        print(f"  RRsl = SL / %{hedef*100:.0f}   (1.00 = tam hedefte)")
        print(f"  RRk  = kişi / Erlang ihtiyacı (1.00 = ihtiyaç kadar kişi)")
        show(out.head(n) if n else out)
        print(f"  ⚠ RRk 1.00 ama RRsl < 1.00 olan slotlar: kadro 'yeterli' ama")
        print(f"    SL tutmuyor → ihtiyaç ASA=30'a göre hesaplanmış, SL'e göre değil.")
    return out


def sla_gunluk(df_sla, katmanlar=None, hedef=SLA_HEDEF, verbose=True):
    """GÜN BAZINDA aylık SL — hangi günler açığı taşıyor.

    Aylık hedef AY TOPLAMINDA tutulur; gün bazlı satırlar 'hangi gün ne kadar
    borç yazdı' sorusunu cevaplar. Gün SL'lerinin ORTALAMASI aylık SL DEĞİLDİR
    (hacim ağırlıklı) — bu yüzden 'borc_cagri' kolonu asıl ölçü.
    """
    _var = [k for k, _e, _c in SLA_KATMANLAR if f'sl_{k}' in df_sla.columns]
    if katmanlar:
        _var = [k for k in katmanlar if k in _var]
    if not _var:
        return None
    g = df_sla.groupby('data_date', as_index=False).agg(
        cagri=('actual_kitle', 'sum'))
    # borc_* TAM DEĞER olarak tutuluyor (yuvarlanmıyor) — yoksa gün borçlarının
    # TOPLAMI aylık AÇIK'a eşit çıkmıyor (ölçüldü: 136 vs 137). Toplanabilirlik
    # bu tablonun tek işi; yuvarlama sadece EKRANDA yapılıyor.
    for k in _var:
        _a = (df_sla.assign(_x=df_sla['actual_kitle'] * df_sla[f'sl_{k}'])
                .groupby('data_date', as_index=False)['_x'].sum())
        g = g.merge(_a.rename(columns={'_x': f'_a_{k}'}), on='data_date')
        g[f'SL_{k}_%'] = 100 * g[f'_a_{k}'] / g['cagri']
        g[f'borc_{k}'] = hedef * g['cagri'] - g[f'_a_{k}']
        g = g.drop(columns=[f'_a_{k}'])
    g.insert(1, 'gun', pd.to_datetime(g['data_date']).dt.weekday.map(
        lambda i: ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'][i]))
    if verbose:
        print(f"GÜN BAZINDA — katman {list(_var)}  "
              f"(borc_* = o günün açığı, ÇAĞRI cinsinden)")
        _g = g.copy()
        for k in _var:                                  # SADECE ekran için yuvarla
            _g[f'SL_{k}_%'] = _g[f'SL_{k}_%'].round(1)
            _g[f'borc_{k}'] = _g[f'borc_{k}'].round(0)
        show(_g)
        print(f"  NOT: gün SL'lerinin ortalaması aylık SL DEĞİL (hacim ağırlıklı). "
              f"Aylık için 'borc_*' TOPLAMINA bak.")
        for k in _var:                                  # SAĞLAMA: toplanabilirlik
            _t = float(g[f'borc_{k}'].sum())
            _, _, _ac = _sla_toplam(df_sla, k)
            _isaret = '✓' if abs(_t - _ac) < 1e-6 else '⚠'
            print(f"  {_isaret} Σ borc_{k} = {_t:,.0f}  |  aylık AÇIK = "
                  f"{_ac:,.0f}  (eşit olmalı)")
    return g


