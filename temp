    # GERÇEK ikisinin arasında: ATANAN payı ≥ 0 kalıyorsa taşıma bedelsiz;
    # negatife düşüp MÜSAİT payı pozitifse, aradaki fark kadar kişinin off'tan
    # çekilmesi gerekir (mümkün olabilir de olmayabilir de) → "sınırda".
    print(f"\n[4] TAŞIMA ADAYLARI  (başka tipteki takımlar — {_tip}'e çekilebilir mi?)")
    _hi_gun = [g for g in _hafta_gun if dt.date.fromisoformat(g).weekday() < 5]
