            | set(onceki_calisti.get(a, set())))


def _tip32(a, wk):
    """agent'ın o HAFTA çalıştığı vardiya tipi (tek tip; yoksa None)."""
    _t = {roster.at[a, c].replace("mesai ", "").split("-")[0]
          for c in _gun
          if dt.date.fromisoformat(c).isocalendar()[:2] == wk
          and roster.at[a, c] not in _OFF_LIKE}
    return next(iter(_t)) if len(_t) == 1 else None


def _h12_serbest32(a, d, _cal):
    """o günü ÇALIŞSA kayan 7 günlük pencere (H12) 6'yı aşar mı? (aşmıyorsa True)"""
    for _j in range(7):
        _s = d - dt.timedelta(days=_j)
        _pen = {_s + dt.timedelta(days=_k) for _k in range(7)}
        if len(_cal & _pen) + 1 > 6:               # +1 = incelenen gün
            return False
    return True


def _h15_serbest32(a, ds, bas, bit):
    """önceki/sonraki günün vardiyasıyla 11 saat kuralı tutuyor mu?"""
    d = dt.date.fromisoformat(ds)
    for _yon in (-1, 1):
        _k = (d + dt.timedelta(days=_yon)).isoformat()
        _v = roster.at[a, _k] if _k in roster.columns else None
        _p = _vardiya_parse(str(_v).replace("mesai ", "")) if _v else None
        if not _p:
            continue                               # o gün off/izin → kısıt yok
        if _yon == -1:                             # önceki gün → bu gün
            if bas_dakika(bas) + 1440 - bitis_abs(*_p) < DINLENME:
                return False
        else:                                      # bu gün → sonraki gün
            if bas_dakika(_p[0]) + 1440 - bitis_abs(bas, bit) < DINLENME:
                return False
    return True


