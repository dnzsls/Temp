def slot_profili(df, hafta_sonu=None, olcu='ortalama'):
    """Slot bazlı profil — günler ortalanır (veya medyanı alınır).

    Girdi plan_tablosu() / model_tablosu() çıktısı OLMALI (df_uzun DEĞİL).
    """
    eksik = [k for k in ['hafta_sonu', 'interval'] + OLCU_KOL if k not in df.columns]
    if eksik:
        raise KeyError(
            f"slot_profili: {eksik} kolonu yok. Bu fonksiyon plan_tablosu() / "
            f"model_tablosu() çıktısı bekler — df_uzun ya da ham Excel değil.\n"
            f"  Gelen kolonlar: {list(df.columns)[:12]}")
    d = df if hafta_sonu is None else df[df['hafta_sonu'] == hafta_sonu]
    if d.empty:
        return pd.DataFrame()
    gb = d.groupby('interval', as_index=False)[OLCU_KOL]
    g = (gb.mean() if olcu == 'ortalama' else gb.median()).round(1)
    g['gun_sayisi'] = d['data_date'].nunique()
    return g.sort_values('interval').reset_index(drop=True)


def slot_farki(df_plan, df_model, olcu='ortalama'):
    """Gün tipi × slot: plan / model kişi ve fark."""
    import numpy as np
    parca = []
    for hs, ad in ((0, 'hafta içi'), (1, 'hafta sonu')):
        a, b = slot_profili(df_plan, hs, olcu), slot_profili(df_model, hs, olcu)
        if a.empty or b.empty:
            continue
        m = a[['interval', 'kapasite_in', 'kapasite_out', 'kapasite_pt',
               'kapasite_toplam']].merge(
            b[['interval', 'kapasite_in', 'kapasite_out', 'kapasite_pt',
               'kapasite_toplam']], on='interval', suffixes=('_plan', '_model'))
        m['fark_toplam'] = (m['kapasite_toplam_model'] - m['kapasite_toplam_plan']).round(1)
        m.insert(0, 'gun_tipi', ad)
        parca.append(m)
    return pd.concat(parca, ignore_index=True) if parca else pd.DataFrame()


def gunluk_kisi(df_uzun, results, year, month, queue='kitle', verbose=True):
    """Gün gün KİŞİ sayısı — plan (Excel) vs model (pickle). Slot hesabı yok."""
    p = df_uzun.copy()
    p['data_date'] = _to_date_series(p['data_date']).dt.normalize()
    p['sirket'] = _company(p['working_main_group'])
    p['kisi'] = pd.to_numeric(p['kisi_sayisi'], errors='coerce').fillna(0)
    tum_aralik = (p['data_date'].min(), p['data_date'].max()) if len(p) else (None, None)
    p = p[(p['data_date'].dt.year == year) & (p['data_date'].dt.month == month)]
    if p.empty and verbose:
        print(f"  ⚠ PLAN: {year}/{month:02d} için satır YOK. "
              f"Vardiya verisi {tum_aralik[0]:%d.%m.%Y}–{tum_aralik[1]:%d.%m.%Y} "
              f"aralığında — YEAR/MONTH'u kontrol et."
              if tum_aralik[0] is not None else "  ⚠ PLAN: vardiya tablosu boş.")
    plan = p.pivot_table(index='data_date', columns='sirket', values='kisi',
                         aggfunc='sum', fill_value=0)
    plan = plan.rename(columns={'inhouse': 'plan_in', 'outsource': 'plan_out',
                                'part_time': 'plan_pt'})
    for k in ('plan_in', 'plan_out', 'plan_pt'):
        if k not in plan:
            plan[k] = 0
    plan['plan_toplam'] = plan[['plan_in', 'plan_out', 'plan_pt']].sum(axis=1)

    sat = []
    for ds, day in (results or {}).items():
        d = pd.to_datetime(ds).normalize()
        if d.year != year or d.month != month:
            continue
        mi = ((day or {}).get(queue) or {}).get('mip_info', {}) or {}
        sat.append({'data_date': d,
                    'model_in': mi.get('total_inhouse_kisi', 0),
                    'model_out': mi.get('total_outsource_kisi', 0),
                    'model_pt': mi.get('total_part_time_kisi', 0),
                    'model_total_kisi': mi.get('total_kisi', 0)})
    model = pd.DataFrame(sat).set_index('data_date') if sat else pd.DataFrame()
    if not sat and verbose:
        _a = sorted({pd.to_datetime(ds).strftime('%Y-%m') for ds in (results or {})})
        print(f"  ⚠ MODEL: {year}/{month:02d} için gün YOK. "
              f"Pickle'daki aylar: {_a}")
    if len(model):
        # total_inhouse_kisi / _outsource_ / _part_time_ AYRIK kümeler — ÇIKARMA YOK
        model['model_toplam'] = model[['model_in', 'model_out', 'model_pt']].sum(axis=1)
        sapan = model[model['model_total_kisi'] != model['model_toplam']]
        if len(sapan) and verbose:
            print(f"  ⚠ {len(sapan)} günde in+out+pt ≠ total_kisi "
                  f"(ilk: {sapan.index[0]:%d.%m}) — pickle şeması değişmiş olabilir.")
        model = model.drop(columns=['model_total_kisi'])

    ay_bas = pd.Timestamp(year, month, 1)
    out = pd.DataFrame(index=pd.date_range(ay_bas, ay_bas + pd.offsets.MonthEnd(1)))
    out.index.name = 'data_date'
    for parca in (model, plan):
        if len(parca):
            out = out.join(parca)
    out = out.reset_index()
    out['gun'] = out['data_date'].dt.weekday.map(lambda i: GUN_TR[i])
    out['hafta_sonu'] = (out['data_date'].dt.weekday >= 5).astype(int)
    # Taraflardan biri boşsa kolonlar hiç oluşmaz → KeyError. Hep 0 ile kur.
    for k in ('model_in', 'model_out', 'model_pt', 'model_toplam',
              'plan_in', 'plan_out', 'plan_pt', 'plan_toplam'):
        if k not in out:
            out[k] = 0
    sayisal = [k for k in out.columns if k.startswith(('plan_', 'model_'))]
    out[sayisal] = out[sayisal].fillna(0).round().astype(int)
    out['fark'] = out['model_toplam'] - out['plan_toplam']

    kol = ['data_date', 'gun', 'hafta_sonu'] + \
          [k for k in ('model_in', 'model_out', 'model_pt', 'model_toplam',
                       'plan_in', 'plan_out', 'plan_pt', 'plan_toplam', 'fark')
           if k in out]
    out = out[kol]

    if verbose:
        for hs, ad in ((0, 'hafta içi'), (1, 'hafta sonu')):
            a = out[out['hafta_sonu'] == hs]
            if len(a):
                print(f"  {ad:<10} model {a['model_toplam'].mean():>6.1f} kişi  |  "
                      f"plan {a['plan_toplam'].mean():>6.1f} kişi  |  "
                      f"fark {a['fark'].mean():>+6.1f}")
    return out


def haftalik_kisi(df_kisi, verbose=True):
    """Ardışık HAFTA İÇİ / HAFTA SONU BLOKLARINA göre plan-model ortalaması.

    Girdi: gunluk_kisi() çıktısı (kişi bazında, slot hesabı yok).

    Gruplama ISO haftası DEĞİL, BLOK bazlıdır: Pzt–Cum bir satır, onu izleyen
    Cmt–Paz ayrı satır. ISO hafta numarası yalnızca etikete yazılır
    ("1. hafta ici (ISO 36)"). Ay sınırında kesilen blok kısa kalır — kaç gün
    olduğunu 'gun' kolonu söyler.

    İki tarafta da 0 olan günler (model koşmamış / plan yok) ortalamaya
    GİRMEZ; blok sırası yine tam takvim üzerinden sayılır.

    Çıktı: etiket · _tur · aralik · gun · hafta_sonu ·
           model_in/out/pt/toplam · plan_in/out/pt/toplam · fark
    """
    gerek = ['data_date', 'hafta_sonu', 'plan_toplam', 'model_toplam']
    eksik = [k for k in gerek if k not in df_kisi.columns]
    if eksik:
        raise KeyError(f"haftalik_kisi: {eksik} kolonu yok. Bu fonksiyon "
                       f"gunluk_kisi() çıktısı bekler.\n"
                       f"  Gelen kolonlar: {list(df_kisi.columns)[:12]}")

    d = df_kisi.copy()
    d['data_date'] = pd.to_datetime(d['data_date'])
    d = d.sort_values('data_date').reset_index(drop=True)

    hs = d['data_date'].dt.weekday >= 5
    d['_blok'] = (hs != hs.shift()).cumsum()
    d['_tur'] = hs.map({False: 'hafta ici', True: 'hafta sonu'})
    d['_iso'] = d['data_date'].dt.isocalendar().week.astype(int)

    # blok sırası TAM takvimden — boş gün elemesi "2. hafta ici"yi kaydırmasın
    _bt = d.groupby('_blok')['_tur'].first()
    d['_sira'] = d['_blok'].map(_bt.groupby(_bt).cumcount() + 1)

    dolu = d[(d['plan_toplam'] > 0) | (d['model_toplam'] > 0)]
    if dolu.empty:
        if verbose:
            print("  ⚠ plan ve model her günde 0 — haftalık özet boş.")
        return pd.DataFrame()
    if verbose and len(dolu) < len(d):
        bos = d.loc[d.index.difference(dolu.index), 'data_date']
        print(f"  ℹ {len(bos)} gün iki tarafta da 0 — ortalamaya girmedi: "
              f"{', '.join(bos.dt.strftime('%d.%m'))}")

    sayisal = [c for c in dolu.columns
               if c.startswith(('plan_', 'model_')) or c == 'fark']
    ozet = (dolu.groupby(['_blok', '_tur'])
                .agg(bas=('data_date', 'min'), bit=('data_date', 'max'),
                     gun=('data_date', 'size'),
                     iso=('_iso', 'min'), sira=('_sira', 'first'),
                     hafta_sonu=('hafta_sonu', 'first'),
                     **{c: (c, 'mean') for c in sayisal})
                .reset_index().sort_values('bas'))

    ozet['etiket'] = (ozet['sira'].astype(str) + '. ' + ozet['_tur']
                      + ' (ISO ' + ozet['iso'].astype(str) + ')')
    ozet['aralik'] = (ozet['bas'].dt.strftime('%d.%m') + '–'
                      + ozet['bit'].dt.strftime('%d.%m'))
    ozet[sayisal] = ozet[sayisal].round(1)
    ozet = ozet.drop(columns=['_blok', 'bas', 'bit', 'iso', 'sira'])
    on = ['etiket', '_tur', 'aralik', 'gun', 'hafta_sonu']
    ozet = ozet[on + [c for c in ozet.columns if c not in on]]
    ozet = ozet.reset_index(drop=True)

    if verbose:
        for tur in ('hafta ici', 'hafta sonu'):
            a = ozet[ozet['_tur'] == tur]
            if len(a):
                print(f"  {tur:<10} {len(a)} blok  |  "
                      f"model {a['model_toplam'].mean():>6.1f} kişi  |  "
                      f"plan {a['plan_toplam'].mean():>6.1f} kişi  |  "
                      f"fark {a['fark'].mean():>+6.1f}")
        kisa = ozet[ozet['gun'] < ozet.groupby('_tur')['gun'].transform('max')]
        if len(kisa):
            print(f"  ℹ {len(kisa)} blok EKSİK GÜNLÜ (ay sınırında kesilmiş): "
                  f"{', '.join(kisa['etiket'])}")
    return ozet


