def shift_slots_ofset(text, ek_slot=0):
    """'22:00-06:00' → [(0,'22:00'),…,(1,'00:00'),…,(1,'05:30')].

    Gece yarısını aşan kısım gün ofseti 1 ile işaretlenir.
    ek_slot: bitişe eklenecek 30 dk'lık slot sayısı (outsource +30 dk için 1).
    """
    m = _SHIFT_RE.search(str(text))
    if not m:
        return []
    sh, sm, eh, em = (int(g) for g in m.groups())
    bas = f"{sh % 24:02d}:{(sm // 30) * 30:02d}"
    son = (eh % 24) * 2 + (em // 30)
    if eh == 24 or (eh % 24) * 60 + em == 0:
        son = len(SLOTS_30)
    i, j = SLOT_IDX[bas], son
    if j <= i:
        j += len(SLOTS_30)
    j += int(ek_slot)
    return [(k // len(SLOTS_30), SLOTS_30[k % len(SLOTS_30)]) for k in range(i, j)]


def shift_baslangic(text):
    """'08:00-17:00' → '08:00' (başlangıç slotu); okunamazsa None."""
    m = _SHIFT_RE.search(str(text))
    if not m:
        return None
    return f"{int(m.group(1)) % 24:02d}:{(int(m.group(2)) // 30) * 30:02d}"


def _sirket_tek(x):
    x = str(x or 'inhouse').strip().lower()
    if 'outsource' in x:
        return 'outsource'
    if 'part' in x or 'kismi' in x or 'kısmi' in x:
        return 'part_time'
    return 'inhouse'


def _sirket(s):
    """'outsource' → outsource · 'kismi'/'part' → part_time · gerisi inhouse."""
    return s.map(_sirket_tek)


# 'line_based_main_group' BİLİNÇLİ OLARAK YOK: o KUYRUK kolonu ('kitle_cagrilar'),
# şirket değil — içinde 'outsource' geçmediği için outsource'u inhouse sayar.
VARDIYA_KOL = {
    'date':  ['data_date', 'date', 'tarih'],
    'shift': ['saat', 'vardiya', 'shift'],
    'group': ['working_main_group', 'company', 'sirket'],
    'kisi':  ['kisi_sayisi', 'kisi', 'count', 'adet'],
    'agent': ['agent_user_code', 'agent', 'agent_id', 'sicil'],
}


def _vardiya_kolonu(df):
    """Vardiya METNİ olan kolon ('09:00-18:00'). 'saat' önce denenir; ama
    içinde saat aralığı yoksa (ör. Model-2'nin kova anahtarı) sıradakine geçer."""
    for c in VARDIYA_KOL['shift']:
        col = _resolve_col(df, [c])
        if col is not None and df[col].astype(str).str.contains(_SHIFT_RE).any():
            return col
    return None


def vardiya_uzun(df, queue='kitle', ad='VARDİYA', verbose=True):
    """Ekip tablosunu tek şemaya çevirir: data_date · vardiya · sirket · kisi.

    Biçimi kolonlara bakıp kendisi seçer (ilk uyan):
      GENİŞ : kitle_in_kisi_sayisi / kitle_out_kisi_sayisi (/ kitle_kismi_…)
      UZUN  : working_main_group + kisi_sayisi
      AGENT : agent_user_code (+ working_main_group) → vardiyada tekil agent
    Kısmi satırlar 'part_time' işaretlenir; kapasite_vardiyadan() onları atar.
    """
    d_col = _resolve_col(df, VARDIYA_KOL['date'])
    v_col = _vardiya_kolonu(df)
    if d_col is None or v_col is None:
        raise KeyError(f"{ad}: tarih / vardiya kolonu yok  |  mevcut: {list(df.columns)}")
    tarih = _to_date_series(df[d_col], ad=f"{ad}.{d_col}").dt.normalize().values
    vard = df[v_col].astype(str).values

    q = queue
    in_col = _resolve_col(df, [f"{q}_in_kisi_sayisi", f"{q}_inhouse_kisi_sayisi", f"{q}_in"])
    out_col = _resolve_col(df, [f"{q}_out_kisi_sayisi", f"{q}_outsource_kisi_sayisi", f"{q}_out"])
    pt_col = _resolve_col(df, [f"{q}_kismi_kisi_sayisi", f"{q}_pt_kisi_sayisi", f"{q}_kismi"])
    g_col = _resolve_col(df, VARDIYA_KOL['group'])
    k_col = _resolve_col(df, VARDIYA_KOL['kisi'])
    a_col = _resolve_col(df, VARDIYA_KOL['agent'])

    notlar = []
    if in_col or out_col:
        bicim = 'GENİŞ'
        parca = [pd.DataFrame({'data_date': tarih, 'vardiya': vard, 'sirket': s,
                               'kisi': pd.to_numeric(df[c], errors='coerce').fillna(0).values})
                 for c, s in ((in_col, 'inhouse'), (out_col, 'outsource'),
                              (pt_col, 'part_time')) if c]
        u = pd.concat(parca, ignore_index=True)
        okunmayan = [c for c in df.columns if str(c).lower().endswith('kisi_sayisi')
                     and c not in (in_col, out_col, pt_col)]
        if okunmayan:
            notlar.append(f"okunmayan kolon: {okunmayan}")
    elif k_col or a_col:
        sirket = (_sirket(df[g_col]).values if g_col
                  else np.array(['inhouse'] * len(df), dtype=object))
        if not g_col:
            notlar.append("şirket kolonu yok → hepsi inhouse sayıldı")
        if k_col:
            bicim = 'UZUN'
            u = pd.DataFrame({'data_date': tarih, 'vardiya': vard, 'sirket': sirket,
                              'kisi': pd.to_numeric(df[k_col], errors='coerce').fillna(0).values})
        else:
            bicim = 'AGENT'
            u = (pd.DataFrame({'data_date': tarih, 'vardiya': vard, 'sirket': sirket,
                               'agent': df[a_col].values})
                   .groupby(['data_date', 'vardiya', 'sirket'], as_index=False)['agent']
                   .nunique().rename(columns={'agent': 'kisi'}))
    else:
        raise KeyError(f"{ad}: kişi kolonu bulunamadı. Beklenen: GENİŞ "
                       f"({q}_in_kisi_sayisi / {q}_out_kisi_sayisi) | UZUN "
                       f"(working_main_group + kisi_sayisi) | AGENT (agent_user_code)"
                       f"  |  mevcut: {list(df.columns)}")

    u = u[u['kisi'] > 0]
    u = (u.groupby(['data_date', 'vardiya', 'sirket'], as_index=False)['kisi'].sum()
          .sort_values(['data_date', 'vardiya']).reset_index(drop=True))
    if verbose:
        top = u.groupby('sirket')['kisi'].sum()
        print(f"  {ad}: {bicim} biçim  |  inhouse {int(top.get('inhouse', 0)):,} · "
              f"outsource {int(top.get('outsource', 0)):,} kişi-gün"
              + (f" · kısmi {int(top['part_time']):,} (HARİÇ tutulacak)"
                 if top.get('part_time', 0) else ""))
        for n in notlar:
            print(f"    ℹ {n}")
    return u


def _kap_izgara(gunler, k, b):
    """(data_date, interval, sirket, kisi) kapasite + başlangıç → gün × 48 slot."""
    out = pd.MultiIndex.from_product([gunler, SLOTS_30],
                                     names=['data_date', 'interval']).to_frame(index=False)
    for kaynak, onek in ((k, 'kapasite'), (b, 'baslangic')):
        for sirket, sonek in (('inhouse', 'in'), ('outsource', 'out')):
            if kaynak is None or kaynak.empty:
                out[f"{onek}_{sonek}"] = 0
                continue
            alt = (kaynak[kaynak['sirket'] == sirket]
                   .groupby(['data_date', 'interval'], as_index=False)['kisi'].sum())
            out = out.merge(alt.rename(columns={'kisi': f"{onek}_{sonek}"}),
                            on=['data_date', 'interval'], how='left')
    deger = ['kapasite_in', 'kapasite_out', 'baslangic_in', 'baslangic_out']
    out[deger] = out[deger].fillna(0).round().astype(int)
    out['kapasite_toplam'] = out['kapasite_in'] + out['kapasite_out']
    out['baslangic_toplam'] = out['baslangic_in'] + out['baslangic_out']
    return out[['data_date', 'interval'] + KAP_KOL].sort_values(
        ['data_date', 'interval']).reset_index(drop=True)


def _ay_gunleri(year, month):
    bas = pd.Timestamp(year=year, month=month, day=1)
    return pd.date_range(bas, bas + pd.offsets.MonthEnd(1), freq='D')


def kapasite_vardiyadan(df_u, year, month, outsource_ek_slot=OUTSOURCE_EK_SLOT,
                        ad='VARDİYA', verbose=True):
    """vardiya_uzun() çıktısı → gün × slot kapasite + vardiya başlangıcı.

    Sunum kuralları: gece 00:00 sonrası ERTESİ güne · outsource +30 dk ·
    kısmiler HARİÇ. Ayın 1'inin gecesi için ÖNCEKİ AYIN SON GÜNÜ de tabloda olmalı.
    """
    gunler = _ay_gunleri(year, month)
    ay_bas, ay_son = gunler[0], gunler[-1]
    onceki = ay_bas - pd.Timedelta(days=1)

    d = df_u.copy()
    pt = d['sirket'].eq('part_time')
    if pt.any() and verbose:
        print(f"    ℹ kısmi HARİÇ: {int(d.loc[pt, 'kisi'].sum()):,} kişi-gün atıldı")
    d = d[~pt]

    d_ay = d[(d['data_date'] >= ay_bas) & (d['data_date'] <= ay_son)]
    if d_ay.empty:
        aylar = sorted(d['data_date'].dt.strftime('%Y-%m').unique())
        raise ValueError(f"{ad}: {year}/{month:02d} için satır yok. Tablodaki aylar: {aylar}")
    d_kap = d[(d['data_date'] >= onceki) & (d['data_date'] <= ay_son)]

    uniq = d_kap['vardiya'].unique()
    p_in = {v: shift_slots_ofset(v) for v in uniq}
    p_out = {v: (shift_slots_ofset(v, outsource_ek_slot) if p_in[v] else []) for v in uniq}
    bas_map = {v: shift_baslangic(v) for v in uniq}
    cozulmeyen = [v for v, s in p_in.items() if not s]
    if cozulmeyen:
        print(f"    ⚠ okunamayan vardiya (atlandı): {cozulmeyen[:8]}")
    asan = [v for v in uniq if any(o for o, _ in p_in[v])]
    if asan and not (d['data_date'] == onceki).any():
        print(f"    ⚠ {onceki:%d.%m.%Y} tabloda YOK → {ay_bas:%d.%m} gece slotları "
              f"eksik kalır (sorguyu bir gün geriye çek)")

    k = d_kap.assign(_p=[(p_out if s == 'outsource' else p_in)[v]
                         for s, v in zip(d_kap['sirket'], d_kap['vardiya'])])
    k = k.explode('_p').dropna(subset=['_p'])
    k['interval'] = k['_p'].map(lambda t: t[1])
    k['data_date'] = k['data_date'] + pd.to_timedelta(k['_p'].map(lambda t: t[0]), unit='D')
    k = k[(k['data_date'] >= ay_bas) & (k['data_date'] <= ay_son)]

    b = d_ay.assign(interval=d_ay['vardiya'].map(bas_map)).dropna(subset=['interval'])
    out = _kap_izgara(gunler, k[['data_date', 'interval', 'sirket', 'kisi']],
                      b[['data_date', 'interval', 'sirket', 'kisi']])
    if verbose:
        print(f"    → {d_ay['data_date'].nunique()}/{len(gunler)} gün  |  tepe kapasite "
              f"in {int(out['kapasite_in'].max())} · out {int(out['kapasite_out'].max())}"
              f"  |  gece → ertesi gün · outsource +{outsource_ek_slot * 30} dk")
    return out


