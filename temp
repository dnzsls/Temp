# %% [HÜCRE 24B] — TAKIM BÖLÜNME + GEÇ TİP ADALETİ (SALT OKUNUR) ───────
# SORU (çıktıdan gözlendi): "hamile/süt üyeli takımlar hep sabaha yazılmış,
# akşam/gece hep aynı takımlara kalıyor — talep mi böyle gerektiriyor yoksa
# model bölünmekten mi kaçınıyor?"
# MEKANİZMA: hamile/süt agentlar sabahçı → geç tip onlara YASAK (tip_yasak).
# Takım geç tipe giderse o üyeler ayrılır ve her biri W_TAKIM ödetir. 3 üyeli
# takım haftada 3×W_TAKIM, temiz takım 0 → model temiz takımı seçer.
# Bu hücre iki şeyi ölçer:
#   [1] BÖLÜNME YAPISI — (takım,hafta) kaç farklı tipe dağılmış?
#       1 tip = bölünme yok, 2 tip = "tek takım 2 parça" (istenen yapı),
#       3+ tip = dağılmış → ayrılanları tek tipe toplayan kısıt gerekebilir.
#   [2] GEÇ TİP ADALETİ — takım bazında geç hafta sayısı vs hamile/süt üye.
#       hamile/süt yüksek olanların geç haftası sistematik 0 ise mekanizma doğrulanır.
from collections import Counter as _Counter24

print("=" * 78)
print("H24B — TAKIM BÖLÜNME YAPISI + GEÇ TİP ADALETİ")
print("=" * 78)

_gec_dk24 = dakika(GEC_BASLANGIC)                  # "15:00" ve sonrası = GEÇ (gece dahil)
_tw_tip = {}                                       # (takım, hafta) → {tip: {agent}}
for _, _r24 in df_sonuc.iterrows():
    if _r24["vardiya"] == ARIFE_YARIM:
        continue
    _d24 = dt.date.fromisoformat(_r24["tarih"])
    if _d24.weekday() >= 5:
        continue                                   # takım kuralı sadece hafta içi
    _tw_tip.setdefault((_r24["takim"], _d24.isocalendar()[:2]), {}) \
           .setdefault(_r24["saat"].split("-")[0], set()).add(_r24["agent"])

# ── [1] BÖLÜNME YAPISI ────────────────────────────────────────────────
_bol_dag = _Counter24(len(_tipler24) for _tipler24 in _tw_tip.values())
_ayrilan_toplam = sum(int(solver.Value(_sv24)) for _sv24 in takim_sapan.values())
print(f"\n[1] BÖLÜNME YAPISI  ({len(_tw_tip)} takım-hafta, hafta içi)")
for _k24 in sorted(_bol_dag):
    _not24 = ("bölünme yok" if _k24 == 1 else
              "tek takım 2 parça (istenen yapı)" if _k24 == 2 else
              "⚠ DAĞILMIŞ — ayrılanları tek tipe toplamak gerekebilir")
    print(f"    {_k24} tip: {_bol_dag[_k24]:4d} takım-hafta   {_not24}")
print(f"    H19 sapan (ayrılan üye-hafta): {_ayrilan_toplam}  (ağırlık W_TAKIM={W_TAKIM})")

# ── [2] GEÇ TİP ADALETİ ───────────────────────────────────────────────
_sut_hamile24 = {T: sum(1 for a in u if a in hafta_sonu_yasak)
                 for T, u in takimlar.items()}
_junior24 = {T: sum(1 for a in u if a in junior_agents) for T, u in takimlar.items()}
_gec_hafta24, _ayr24 = {}, {}
for T in takimlar:
    _gec_hafta24[T] = sum(1 for (T2, _wk24), _tipler24 in _tw_tip.items()
                          if T2 == T and any(dakika(_t24) >= _gec_dk24
                                             for _t24 in _tipler24))
    _ayr24[T] = sum(int(solver.Value(_sv24)) for (a24, _w24), _sv24 in takim_sapan.items()
                    if a24 in takimlar[T])
print(f"\n[2] GEÇ TİP ADALETİ  (geç = başlangıç ≥ {GEC_BASLANGIC}, gece dahil)")
print(f"    {'takım':<34} {'üye':>4} {'hamile/süt':>11} {'kıdemsiz':>9} "
      f"{'geç hafta':>10} {'ayrılan':>8}")
for T in sorted(takimlar, key=lambda t: (_gec_hafta24[t], -_sut_hamile24[t])):
    print(f"    {T[:34]:<34} {len(takimlar[T]):>4} {_sut_hamile24[T]:>11} "
          f"{_junior24[T]:>9} {_gec_hafta24[T]:>10} {_ayr24[T]:>8}")
# korelasyon özeti: hamile/süt olan vs olmayan takımların ortalama geç haftası
_ile = [_gec_hafta24[T] for T in takimlar if _sut_hamile24[T] > 0]
_siz = [_gec_hafta24[T] for T in takimlar if _sut_hamile24[T] == 0]
if _ile and _siz:
    print(f"\n    hamile/süt ÜYESİ OLAN  {len(_ile):>3} takım → ortalama geç hafta "
          f"{sum(_ile) / len(_ile):.2f}")
    print(f"    hamile/süt üyesi OLMAYAN {len(_siz):>3} takım → ortalama geç hafta "
          f"{sum(_siz) / len(_siz):.2f}")
