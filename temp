    hedef = int(round(butce * len(gun) / 7.0)) if butce else None
    print("  hafta" + str(h) + "  gun=" + str(len(gun)).rjust(2)
          + "  butce=" + str(butce).rjust(5)
          + "  hedef=" + str(hedef).rjust(5)
          + "  kullanilan=" + str(o_hi + o_hs).rjust(5)
          + "   h.ici=" + str(o_hi).rjust(5)
          + "  h.sonu=" + str(o_hs).rjust(4)
          + "   h.sonu payi=" + ("%.1f%%" % (100 * o_hs / max(1, o_hi + o_hs))))

