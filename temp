          f"{'MIP_Pk':>7} {'In':>5} {'Out':>5} {'PT':>4} {'Toplam':>7} {'Out%':>5} "
          f"{'Eksik':>6}  {'Çözüm':<28}")
    print('  ' + '-' * 118)

    t_cagri = t_erl_t = 0
