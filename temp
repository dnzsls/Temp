    'yuzey': '#fcfcfb',
}


def _eksen(ax, g, adim=4, y_adim=None):
    ax.set_xticks(range(0, len(g), adim))
    ax.set_xticklabels([g['interval'].iloc[i] for i in range(0, len(g), adim)],
                       fontsize=8, color=RENK['metin2'])
    ax.grid(axis='y', color=RENK['izgara'], lw=1, zorder=0)
    ax.set_axisbelow(True)
    for i in range(0, len(g), adim):          # dikey kılavuz, dolgunun ÜSTÜNDE
        ax.axvline(i, color=RENK['metin2'], lw=0.6, alpha=0.22, zorder=3.5)
    for k in ('top', 'right'):
        ax.spines[k].set_visible(False)
    for k in ('left', 'bottom'):
        ax.spines[k].set_color(RENK['izgara'])
    ax.tick_params(colors=RENK['metin2'], labelsize=8)
    ax.tick_params(labelbottom=True, labelleft=True)   # her panelde sayı yazsın
    ax.set_xlim(-0.5, len(g) - 0.5)
    ax.set_facecolor(RENK['yuzey'])
    if y_adim:
        from matplotlib.ticker import MultipleLocator
        ax.yaxis.set_major_locator(MultipleLocator(y_adim))
        ax.set_ylim(bottom=0)


def _kutu(ax, metin, konum=(0.98, 0.96)):
    ax.text(*konum, metin, transform=ax.transAxes, ha='right', va='top',
            fontsize=8, color=RENK['metin'],
            bbox=dict(boxstyle='round,pad=0.4', facecolor='#fff7d6',
                      edgecolor='#d9d2a8', linewidth=0.8))


def grafik_plan_model(df_plan, df_model, queue='KİTLE', olcu='ortalama',
                      y_adim=25, kaydet=None):
    """2×2: üst satır PLAN, alt satır MODEL · sol hafta içi, sağ hafta sonu.

    Yığılı alan = inhouse / outsource / kısmi. Y ekseni ORTAK.
    """
    import matplotlib.pyplot as plt

    kaynak = [('PLAN', df_plan), ('MODEL', df_model)]
    veri = {(ad, hs): slot_profili(d, hs, olcu) for ad, d in kaynak for hs in (0, 1)}
    dolu = [g for g in veri.values() if not g.empty]
    if not dolu:
        raise ValueError("Çizilecek veri yok.")
    y_max = max(g['kapasite_toplam'].max() for g in dolu) * 1.22

    fig, axes = plt.subplots(2, 2, figsize=(16, 10), sharex=True, sharey=True)
    fig.patch.set_facecolor(RENK['yuzey'])

    for i, (ad, _) in enumerate(kaynak):
        for j, (hs, gun_ad) in enumerate([(0, 'HAFTA İÇİ'), (1, 'HAFTA SONU')]):
            ax = axes[i][j]
            g = veri[(ad, hs)]
            if g.empty:
                ax.set_visible(False)
                continue
            x = range(len(g))
            u_in = g['kapasite_in']
            u_out = u_in + g['kapasite_out']

            ax.fill_between(x, u_in, color=RENK['inhouse'], alpha=0.45,
                            zorder=1, label='inhouse')
            ax.fill_between(x, u_in, u_out, color=RENK['outsource'], alpha=0.85,
                            zorder=1, label='outsource')
            if g['kapasite_pt'].sum() > 0:
                ax.fill_between(x, u_out, g['kapasite_toplam'], color=RENK['kismi'],
                                alpha=0.60, zorder=1, label='kısmi')
            ax.plot(x, g['kapasite_toplam'], color=RENK['kapasite'], lw=2.4,
                    zorder=4, label='Slot kapasitesi (sahadaki kişi)')
            ax.plot(x, g['baslangic_toplam'], color=RENK['baslangic'], lw=2,
                    marker='o', ms=3, zorder=5, label='Vardiya başlangıcı')

            pt_not = ' (kısmiler dahil)' if g['kapasite_pt'].sum() > 0 else ' (kısmisiz)'
            ax.set_ylabel('kişi', fontsize=9, color=RENK['metin2'])
            ax.set_title(f"{ad} — {gun_ad}{pt_not}", fontsize=11, fontweight='bold',
                         color=RENK['metin'], loc='left', pad=8)
            _eksen(ax, g, y_adim=y_adim)
            ax.set_ylim(0, y_max)

            i_tepe = int(g['kapasite_toplam'].idxmax())
            _kutu(ax, f"Tepe {g['kapasite_toplam'].iloc[i_tepe]:.0f} kişi "
                      f"@ {g['interval'].iloc[i_tepe]}\n"
                      f"kişi-saat {g['kapasite_toplam'].sum() / 2:,.0f}\n"
                      f"{int(g['gun_sayisi'].iloc[0])} gün {olcu}")
            if i == 0 and j == 0:
                ax.legend(loc='upper left', frameon=False, fontsize=8,
                          labelcolor=RENK['metin2'])

    fig.suptitle(f"{queue} — PLAN vs MODEL  (slot kapasitesi, kişi)",
                 fontsize=13, fontweight='bold', color=RENK['metin'],
                 x=0.01, ha='left', y=0.995)
    fig.tight_layout(rect=(0, 0, 1, 0.97))
    if kaydet:
        fig.savefig(kaydet, dpi=150, facecolor=fig.get_facecolor())
        print(f"✓ {kaydet}")
    return fig


def grafik_fark(df_plan, df_model, queue='KİTLE', olcu='ortalama',
                y_adim=25, kaydet=None):
    """MODEL − PLAN kişi farkı, slot bazında. Sıfırın üstü = model daha çok."""
    import matplotlib.pyplot as plt
    import numpy as np

    fig, axes = plt.subplots(1, 2, figsize=(16, 5), sharey=True)
    fig.patch.set_facecolor(RENK['yuzey'])
    f = slot_farki(df_plan, df_model, olcu)

    for j, (ad, gun_ad) in enumerate([('hafta içi', 'HAFTA İÇİ'),
                                      ('hafta sonu', 'HAFTA SONU')]):
        ax = axes[j]
        g = f[f['gun_tipi'] == ad].reset_index(drop=True)
        if g.empty:
            ax.set_visible(False)
            continue
        x = np.arange(len(g))
        d = g['fark_toplam'].values
        ax.bar(x, np.clip(d, 0, None), color='#2a78d6', alpha=0.75,
               zorder=2, label='model DAHA ÇOK kişi')
        ax.bar(x, np.clip(d, None, 0), color='#F94449', alpha=0.85,
               zorder=2, label='model DAHA AZ kişi')
        ax.axhline(0, color=RENK['metin'], lw=1, zorder=3)
        ax.set_ylabel('model − plan (kişi)', fontsize=9, color=RENK['metin2'])
        ax.set_title(f"{gun_ad}", fontsize=11, fontweight='bold',
                     color=RENK['metin'], loc='left', pad=8)
        _eksen(ax, g, y_adim=y_adim)
        ax.set_ylim(None)
        i_max, i_min = int(np.argmax(d)), int(np.argmin(d))
        _kutu(ax, f"en çok +{d[i_max]:.0f} @ {g['interval'].iloc[i_max]}\n"
                  f"en az  {d[i_min]:.0f} @ {g['interval'].iloc[i_min]}\n"
                  f"ortalama {d.mean():+.1f} kişi")
        if j == 0:
            ax.legend(loc='upper left', frameon=False, fontsize=8,
                      labelcolor=RENK['metin2'])

    fig.suptitle(f"{queue} — MODEL − PLAN kişi farkı (slot bazında)",
                 fontsize=13, fontweight='bold', color=RENK['metin'],
                 x=0.01, ha='left', y=0.995)
    fig.tight_layout(rect=(0, 0, 1, 0.94))
    if kaydet:
        fig.savefig(kaydet, dpi=150, facecolor=fig.get_facecolor())
        print(f"✓ {kaydet}")
    return fig


