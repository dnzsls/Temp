        print(f"    ⚠ BELİRGİN FARK: geç yük hamile/süt üyesi OLMAYAN takımlara yığılmış.")
        print(f"      W_TAKIM'i düşür (şu an {W_TAKIM}) ya da takım başına geç hafta")
        print(f"      sayısına oransal tavan koy (mesaide MESAI_TOL gibi).")
    else:
        print(f"    ✓ iki grup arasında belirgin fark yok — yük dengeli dağılmış.")
