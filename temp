def _eksen(ax, g, adim=4, y_adim=None):
    ax.set_xticks(range(0, len(g), adim))
    ax.set_xticklabels([g['interval'].iloc[i] for i in range(0, len(g), adim)],
                       fontsize=8, color=RENK['metin2'])
    ax.grid(axis='y', color=RENK['izgara'], lw=1, zorder=0)
    ax.set_axisbelow(True)
    for k in ('top', 'right'):
        ax.spines[k].set_visible(False)
    for k in ('left', 'bottom'):
        ax.spines[k].set_color(RENK['izgara'])
    ax.tick_params(colors=RENK['metin2'], labelsize=8)
    ax.set_xlim(-0.5, len(g) - 0.5)
    ax.set_facecolor(RENK['yuzey'])
    if y_adim:
        from matplotlib.ticker import MultipleLocator
        ax.yaxis.set_major_locator(MultipleLocator(y_adim))
        ax.set_ylim(bottom=0)


def _kutu(ax, metin, konum=(0.98, 0.95), renk='#fff7d6'):
    ax.text(*konum, metin, transform=ax.transAxes, ha='right', va='top',
            fontsize=8, color=RENK['metin'],
            bbox=dict(boxstyle='round,pad=0.4', facecolor=renk,
                      edgecolor='#d9d2a8', linewidth=0.8))


def grafik_genel(df, queue='KİTLE', kirilim=False, olcu='ortalama', y_adim=25,
                 cagri_adim=None, kaydet=None):
    """Hafta içi / hafta sonu: slot kapasitesi + vardiya başlangıcı + çağrı.

    kirilim=True  → kapasite inhouse/outsource ayrı çizilir
    olcu          → 'ortalama' (varsayılan) veya 'medyan'
    y_adim        → sol (kişi) ekseninde tick aralığı; None = otomatik
    cagri_adim    → sağ (çağrı) ekseninde tick aralığı; None = otomatik
    Çağrı SAĞ eksende (kesikli mor).
    """
    import matplotlib.pyplot as plt

    fig, axes = plt.subplots(1, 2, figsize=(16, 5.5))
    fig.patch.set_facecolor(RENK['yuzey'])

    for j, (hs, ad) in enumerate([(0, 'HAFTA İÇİ'), (1, 'HAFTA SONU')]):
        ax = axes[j]
        g = slot_ozet(df, hafta_sonu=hs, olcu=olcu)
        if g.empty:
            ax.set_visible(False)
            continue
        x = range(len(g))

        if kirilim:
            ax.fill_between(x, g['kapasite_in'], color=RENK['inhouse'],
                            alpha=0.25, zorder=1, label='Kapasite — inhouse')
            ax.fill_between(x, g['kapasite_in'], g['kapasite_toplam'],
                            color=RENK['outsource'], alpha=0.35, zorder=1,
                            label='Kapasite — outsource')
            ax.plot(x, g['kapasite_toplam'], color=RENK['kapasite'], lw=2, zorder=3)
        else:
            ax.fill_between(x, g['kapasite_toplam'], color=RENK['dolgu'],
                            zorder=1, label='Slot kapasitesi (sahadaki kişi)')
            ax.plot(x, g['kapasite_toplam'], color=RENK['kapasite'], lw=2,
                    marker='o', ms=3.5, zorder=3)

        ax.plot(x, g['baslangic_toplam'], color=RENK['baslangic'], lw=2,
                marker='o', ms=3.5, zorder=4, label='Vardiya başlangıcı (kaç kişi başlıyor)')

        ax.set_ylabel('kişi', fontsize=9, color=RENK['metin2'])
        ax.set_title(f"{queue} — {ad} ({olcu})\n"
                     f"Slot kapasitesi vs vardiya başlangıcı",
                     fontsize=11, fontweight='bold', color=RENK['metin'],
                     loc='left', pad=10)
        _eksen(ax, g, y_adim=y_adim)

        ax2 = ax.twinx()                                  # çağrı: SAĞ eksen
        ax2.plot(x, g['cagri'], color=RENK['cagri'], lw=1.8, ls='--', zorder=5,
                 label='Çağrı adedi')
        ax2.set_ylabel('çağrı adedi', fontsize=9, color=RENK['cagri'])
        ax2.tick_params(axis='y', colors=RENK['cagri'], labelsize=8)
        for k in ('top', 'left'):
            ax2.spines[k].set_visible(False)
        ax2.spines['right'].set_color(RENK['cagri'])
        ax2.grid(False)
        ax2.set_ylim(bottom=0)
        if cagri_adim:
            from matplotlib.ticker import MultipleLocator
            ax2.yaxis.set_major_locator(MultipleLocator(cagri_adim))

        i_tepe = int(g['kapasite_toplam'].idxmax())
        _kutu(ax, f"Tepe kapasite\n{g['kapasite_toplam'].iloc[i_tepe]:.0f} kişi "
                  f"@ {g['interval'].iloc[i_tepe]}")
        etiket = 'ortalaması' if olcu == 'ortalama' else 'medyanı'
        _kutu(ax, f"{int(g['gun_sayisi'].iloc[0])} gün {etiket}",
              konum=(0.98, 0.72), renk='#eaf1fb')

        h1, l1 = ax.get_legend_handles_labels()
        h2, l2 = ax2.get_legend_handles_labels()
        ax.legend(h1 + h2, l1 + l2, loc='upper left', frameon=False,
                  fontsize=8, labelcolor=RENK['metin2'])

    fig.tight_layout()
    if kaydet:
        fig.savefig(kaydet, dpi=150, facecolor=fig.get_facecolor())
        print(f"✓ {kaydet}")
    return fig


def grafik_gun_egrisi(df, queue='KİTLE', sifirdan=True, kaydet=None):
    """Gün gün: kapasite (kişi-saat) ve çağrı — ay boyunca seyir.

    sifirdan=True (varsayılan): her iki eksen de 0'dan başlar. Böylece
      çizgilerin birbirine yakınlığı/uzaklığı göz yanılgısı yaratmaz.
      False yaparsan matplotlib eksenleri otomatik kırpar — düşüşler
      olduğundan daha dramatik görünür.
    """
    import matplotlib.pyplot as plt

    g = gun_ozet(df)
    x = range(len(g))
    fig, ax = plt.subplots(figsize=(14, 5))
    fig.patch.set_facecolor(RENK['yuzey'])
    ax.set_facecolor(RENK['yuzey'])

    ax.bar([i for i in x if g['hafta_sonu'].iloc[i] == 1],
           [g['kisi_saat'].iloc[i] for i in x if g['hafta_sonu'].iloc[i] == 1],
           color=RENK['dolgu'], zorder=1, label='hafta sonu')
    ax.plot(x, g['kisi_saat'], color=RENK['kapasite'], lw=2, marker='o', ms=4,
            zorder=3, label='Kapasite (kişi-saat)')
    ax.set_ylabel('kişi-saat', fontsize=9, color=RENK['metin2'])
    if sifirdan:
        ax.set_ylim(bottom=0)

    ax2 = ax.twinx()
    ax2.plot(x, g['cagri'], color=RENK['cagri'], lw=1.8, ls='--', zorder=4,
             marker='o', ms=3, label='Çağrı adedi')
    ax2.set_ylabel('çağrı adedi', fontsize=9, color=RENK['cagri'])
    ax2.tick_params(axis='y', colors=RENK['cagri'], labelsize=8)
    for k in ('top', 'left'):
        ax2.spines[k].set_visible(False)
    ax2.spines['right'].set_color(RENK['cagri'])
    ax2.grid(False)
    if sifirdan:
        ax2.set_ylim(bottom=0)

    ax.set_xticks(list(x))
    ax.set_xticklabels([f"{d.day}\n{gg}" for d, gg in zip(g['data_date'], g['gun'])],
                       fontsize=7, color=RENK['metin2'])
    ax.grid(axis='y', color=RENK['izgara'], lw=1, zorder=0)
    ax.set_axisbelow(True)
    for k in ('top', 'right'):
        ax.spines[k].set_visible(False)
    ax.set_title(f"{queue} — gün gün kapasite ve çağrı\n"
                 f"sol eksen kişi-saat · sağ eksen çağrı adedi "
                 f"(ölçekler bağımsız, çizgilerin kesişmesi anlam taşımaz)",
                 fontsize=11,
                 fontweight='bold', color=RENK['metin'], loc='left', pad=10)
    h1, l1 = ax.get_legend_handles_labels()
    h2, l2 = ax2.get_legend_handles_labels()
    ax.legend(h1 + h2, l1 + l2, loc='upper left', frameon=False, fontsize=8,
              labelcolor=RENK['metin2'], ncol=3)

    fig.tight_layout()
    if kaydet:
        fig.savefig(kaydet, dpi=150, facecolor=fig.get_facecolor())
        print(f"✓ {kaydet}")
    return fig


def grafik_isi_haritasi(df, kolon='kapasite_toplam', queue='KİTLE', kaydet=None):
    """Gün × slot ısı haritası — yoğunluk deseni tek görselde."""
    import matplotlib.pyplot as plt

    p = df.pivot_table(index='data_date', columns='interval', values=kolon,
                       aggfunc='sum').reindex(columns=SLOTS_30).fillna(0)
    fig, ax = plt.subplots(figsize=(15, 0.32 * len(p) + 2))
    fig.patch.set_facecolor(RENK['yuzey'])
    im = ax.imshow(p.values, aspect='auto', cmap='Blues', interpolation='nearest')

    ax.set_xticks(range(0, len(SLOTS_30), 4))
    ax.set_xticklabels(SLOTS_30[::4], fontsize=8, color=RENK['metin2'])
    ax.set_yticks(range(len(p)))
    ax.set_yticklabels([f"{d.day:02d} {GUN_TR[d.weekday()]}" for d in p.index],
                       fontsize=7, color=RENK['metin2'])
    ax.set_title(f"{queue} — {kolon} (gün × slot)", fontsize=11, fontweight='bold',
                 color=RENK['metin'], loc='left', pad=10)
    cb = fig.colorbar(im, ax=ax, pad=0.01)
    cb.ax.tick_params(labelsize=8, colors=RENK['metin2'])
    for k in ax.spines.values():
        k.set_visible(False)

    fig.tight_layout()
    if kaydet:
        fig.savefig(kaydet, dpi=150, facecolor=fig.get_facecolor())
        print(f"✓ {kaydet}")
    return fig


def excel_yaz(df, yol=None, year=2026, month=7):
    """Slot özeti + gün özeti + ham tabloyu Excel'e yazar."""
    yol = yol or f"genel_bakis_{year}_{month:02d}.xlsx"
    with pd.ExcelWriter(yol) as w:
        slot_ozet(df, 0).to_excel(w, sheet_name='slot_haftaici', index=False)
        slot_ozet(df, 1).to_excel(w, sheet_name='slot_haftasonu', index=False)
        slot_ozet(df, 0, 'medyan').to_excel(w, sheet_name='slot_haftaici_med', index=False)
        slot_ozet(df, 1, 'medyan').to_excel(w, sheet_name='slot_haftasonu_med', index=False)
        gun_ozet(df).to_excel(w, sheet_name='gun_ozet', index=False)
        df.to_excel(w, sheet_name='ham_30dk', index=False)
    print(f"✓ {yol}")
    return yol


