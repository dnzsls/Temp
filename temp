from weekly_pipeline_unified_v1 import _week_of_month
AG = CONFIG['kadro']['outsource_adam_gun'].get(Q, {})

for h in (1, 2, 3, 4, 5):
    gun = [d for d in sorted(results) if _week_of_month(d) == h]
    if not gun:
        continue
    hi = [d for d in gun if _pd.to_datetime(d).weekday() < 5]
    hs = [d for d in gun if _pd.to_datetime(d).weekday() >= 5]

    def _out(lst):
        t = 0
        for d in lst:
            r = results[d].get(Q)
            if r:
                t += r['mip_info'].get('total_outsource_kisi', 0)
        return t

    o_hi, o_hs = _out(hi), _out(hs)
