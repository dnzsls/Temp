df_gun_ozet["toplam_fark"] = df_gun_ozet["fazla_fark"] + df_gun_ozet["eksik_fark"]
df_gun_ozet["fark"] = df_gun_ozet["gerceklesen"] - df_gun_ozet["planlanan"]
