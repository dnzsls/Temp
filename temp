    _t6_mod = _t6_k.groupby(df_tam["takim_ad"]).agg(
        lambda s: s.dropna().iloc[0] if s.notna().any() else None)
    _t6_parca = _t6_k.fillna(df_tam["takim_ad"].map(_t6_mod))
    _t6_bos = _t6_parca.isna()
    if _t6_bos.any():                        # takımda HİÇ kod yok → isme düş
