# %% GEÇİCİ TEŞHİS — H18E neyi bozuyor? (salt okunur; HS_TEK_GUN değerinden BAĞIMSIZ)
_aksam_dk = dakika(AKSAM_BASLANGIC)
_normal = set(hs_tek_normal)                      # H18E kapsamı
_hs_gun = [ds for ds in PLAN_GUNLER if dt.date.fromisoformat(ds).weekday() >= 5]

def _grup(bas):
    if bas in GECE_BASLANGIC: return "gece"
    return "aksam" if dakika(bas) >= _aksam_dk else "gunduz"

def _yapar(a, ds, grup=None):
    return any(_kova_calisabilir(a, ds, v) for v in gun_vardiyalari.get(ds, [])
               if (ds, v) in talep and (grup is None or _grup(saat[(ds, v)][0]) in grup))

def _hs_tavan(a):                                 # H18 + H18E ile ayda hafta sonu tavanı
    _cift = {g for c in hs_ciftleri for g in c}
    _k = [(min(1, _yapar(a, c) + _yapar(a, p)) if a in _normal
           else _yapar(a, c) + _yapar(a, p)) for c, p in hs_ciftleri]
    _tek = sum(_yapar(a, ds) for ds in _hs_gun if ds not in _cift)
    return sum(_k) - (max(_k) if CIFT_HS_OFF and _k else 0) + _tek

# ── [A] KOTA ─────────────────────────────────────────────────────────
_A = []
for a in _normal:
    if a not in kota_map: continue
    _hi = sum(1 for ds in PLAN_GUNLER
              if dt.date.fromisoformat(ds).weekday() < 5 and _yapar(a, ds))
    _hs = _hs_tavan(a)
    if _hi + _hs < kota_map[a]:
        _A.append((a, kota_map[a], _hi, _hs,
                   sorted(d.isoformat() for d in off_block_map.get(a, set()) if d.weekday() < 5)))
print(f"[A] KOTA: dolduramayan normal agent {len(_A)}")
for a, k, hi, hs, o2 in _A[:15]:
    print(f"   {a}: kota {k} > hafta içi {hi} + hafta sonu tavanı {hs}  | off_t2 {o2}")

# ── [B] HAFTA SONU KOVA TİPİ ─────────────────────────────────────────
print(f"\n[B] HAFTA SONU TİP BAZLI (gereken = Σ(talep−{HS_TOL}), Cmt+Pzr birlikte)")
_B = []
for c, p in hs_ciftleri:
    for _ad, _g in (("gece", {"gece"}), ("akşam", {"aksam"}),
                    ("akşam+gece", {"aksam", "gece"}), ("gündüz", {"gunduz"}),
                    ("TÜMÜ", {"gece", "aksam", "gunduz"})):
        _ger = sum(max(0, talep[(ds, v)] - HS_TOL) for ds in (c, p)
                   for v in gun_vardiyalari[ds]
                   if (ds, v) in talep and _grup(saat[(ds, v)][0]) in _g)
        if not _ger: continue
        _kap_yeni = _kap_eski = 0
        for a in AGENTS:
            _n = _yapar(a, c, _g) + _yapar(a, p, _g)
            _kap_eski += _n
            _kap_yeni += min(1, _n) if a in _normal else _n
        _B.append((c, _ad, _ger, _kap_eski, _kap_yeni))
for c, _ad, _ger, _ke, _ky in sorted(_B, key=lambda r: r[4] - r[2])[:15]:
    print(f"   {c} {_ad:<11} gereken {_ger:>4} | kapasite H18E öncesi {_ke:>4} → sonrası {_ky:>4}"
          f"  pay {_ky - _ger:+d}" + ("   ⚠ DOLMAZ" if _ky < _ger else ""))

# ── [C] AKŞAM HAFTASI BÜTÇESİ (H16D) ─────────────────────────────────
# hafta başına akşam/gece'de olması gereken EN AZ farklı kişi:
#   hafta içi: en dar günün sert alt sınırı | hafta sonu: Σ(talep−HS_TOL), normal agent ≤1 gün
_ak_uygun = [a for a in AGENTS if any(_yapar(a, ds, {"aksam", "gece"}) for ds in PLAN_GUNLER)]
_top_yeni = _top_eski = 0
print(f"\n[C] AKŞAM HAFTASI BÜTÇESİ (agent ayda ≤{MAX_AKSAM_HAFTA} hafta)")
for wk, gl in sorted(haftalar.items()):
    _hi = [ds for ds in gl if dt.date.fromisoformat(ds).weekday() < 5]
    _hs = [ds for ds in gl if dt.date.fromisoformat(ds).weekday() >= 5]
    _hi_ger = max((sum(max(talep[(ds, v)] - GECE_BUFFER, min(MIN_KOVA, talep[(ds, v)]))
                       if saat[(ds, v)][0] in GECE_BASLANGIC else min(MIN_KOVA, talep[(ds, v)])
                       for v in gun_vardiyalari[ds]
                       if (ds, v) in talep and _grup(saat[(ds, v)][0]) != "gunduz")
                   for ds in _hi), default=0)
    _hs_gun_ger = [sum(max(0, talep[(ds, v)] - HS_TOL) for v in gun_vardiyalari[ds]
                       if (ds, v) in talep and _grup(saat[(ds, v)][0]) != "gunduz") for ds in _hs]
    _eski = max([_hi_ger] + _hs_gun_ger)          # eskiden aynı kişi Cmt+Pzr tutabiliyordu
    _yeni = max(_hi_ger, sum(_hs_gun_ger))        # H18E: her gün ayrı kişi
    _top_eski += _eski; _top_yeni += _yeni
    print(f"   {wk[0]}-W{wk[1]}: hafta içi {_hi_ger:>3} | hafta sonu {_hs_gun_ger} "
          f"→ en az kişi-hafta önce {_eski}, sonra {_yeni}")
_kap = MAX_AKSAM_HAFTA * len(_ak_uygun)
print(f"   TOPLAM gereken: önce {_top_eski}, sonra {_top_yeni}  |  kapasite "
      f"{len(_ak_uygun)} × {MAX_AKSAM_HAFTA} = {_kap}"
      + ("   ⚠ AŞILDI" if _top_yeni > _kap else f"   (doluluk %{100*_top_yeni/max(1,_kap):.0f})"))
