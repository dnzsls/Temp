def solve_week(df_calls_30, df_shifts, queue, dates, config=CONFIG_UNIFIED,
               sarkan_ilk_gun=None, inhouse_esitlik=True, verbose=True):
    """Bir haftayı (1-7 gün) tek MIP'te çözer.

    dates           : sıralı tarih string listesi ('YYYY-MM-DD'), Pzt başlangıçlı
                      olmak zorunda değil; kısmi hafta olabilir
    sarkan_ilk_gun  : {slot: kişi} — ilk günün ilk saatlerine ÖNCEKİ günden
                      (bu haftanın dışından) gelen kadro. None → 0
    inhouse_esitlik : True  → Σ inhouse = günlük kadro   (MIP2: "elimizdeki kadro")
                      False → Σ inhouse ≤ günlük kadro   (MIP1: "en az kaç yeter")

    Returns: (info_per_day, ozet)
      info_per_day[tarih] → eski mip_info sözleşmesiyle aynı anahtarlar
      ozet                → hangi kısıt ne kadar esnedi
    """
    dates = list(dates)
    if not dates:
        return {}, None

    scol = config['shift_columns']
    ccfg = config['company']
    qcfg = config['queues'][queue]
    inhouse_value = ccfg['inhouse']['shift_value']
    outsource_value = ccfg['outsource']['shift_value']

    allowed = qcfg['companies']
    allowed_values = [ccfg[c]['shift_value'] for c in allowed]
    df_sf = df_shifts[df_shifts[scol['company']].isin(allowed_values)].copy()

    # ---- vardiya kapsaması (normal + part-time) ----
    cov = create_shift_coverage(df_sf, config)
    gun_etiket = {ds: _date_to_day_label(ds) for ds in dates}
    shift_days = _classify_shifts_by_days(df_sf, day_labels=list(TUM_GUN))
    for k, c in cov.items():
        c['available_days'] = shift_days.get(k, set(TUM_GUN))

    pt_cov = pt_vardiyalari(config)
    pt_sayi = int((config.get('part_time', {}).get('count', {}) or {}).get(queue, 0) or 0)
    if pt_sayi <= 0:
        pt_cov = {}
    cov.update(pt_cov)
    for k in pt_cov:
        cov[k]['available_days'] = set(TUM_GUN)

    inh = [s for s in cov if cov[s]['company'] == inhouse_value]
    out = [s for s in cov if cov[s]['company'] == outsource_value]
    pts = list(pt_cov.keys())

    # ---- gün tipleri ----
    tip = {ds: gun_tipi(ds) for ds in dates}
    h_ici = [ds for ds in dates if tip[ds] == 'hafta_ici']
    h_son = [ds for ds in dates if tip[ds] != 'hafta_ici']

    # ---- gün tipi bazlı config blokları ----
    cfg_d = {ds: blok_coz(config, queue, ds) for ds in dates}

    # ---- Erlang (HAM — hiçbir aşamada kurcalanmaz) ----
    erl = erlang_per_day(df_calls_30, queue, dates, config)

    # ---- alt-kuyruk min (K5) ----
    sq_in, sq_out = {}, {}
    for ds in dates:
        a, b = _build_subqueue_min_slots(df_calls_30, queue, ds, erl[ds], cfg_d[ds])
        sq_in[ds], sq_out[ds] = a or {}, b or {}

    prob = LpProblem(f"W_{queue}_{dates[0]}", LpMinimize)
    cost = []

    # =====================================================================
    # KARAR DEĞİŞKENLERİ
    # =====================================================================
    # İnhouse HAFTA İÇİ SABİT (operasyon kuralı korunuyor): tek değişken,
    # 5 güne de aynı sayı. Hafta sonu inhouse gün bazlı.
    M = {}
    for ds in dates:
        kad_in = _resolve_kadro(config['kadro']['inhouse'].get(queue, {}), ds)
        M[ds] = max(50, int(kad_in or 0) + 50)      # big-M: gerçekçi tavan

    xw = {s: LpVariable(f"xw_{s}", lowBound=0, cat='Integer') for s in inh} if h_ici else {}
    yw = {s: LpVariable(f"yw_{s}", cat='Binary') for s in inh} if h_ici else {}

    gun_shift = []                      # gün bazlı (s, ds) çiftleri
    for ds in dates:
        lbl = gun_etiket[ds]
        for s in cov:
            if lbl not in cov[s]['available_days']:
                continue
            if s in inh and tip[ds] == 'hafta_ici':
                continue                # xw ile temsil ediliyor
            gun_shift.append((s, ds))
    xd = {p: LpVariable(f"xd_{p[0]}_{p[1]}", lowBound=0, cat='Integer')
          for p in gun_shift}
    yd = {p: LpVariable(f"yd_{p[0]}_{p[1]}", cat='Binary') for p in gun_shift}

    def n(s, ds):
        """vardiya s, gün ds → kişi ifadesi (0 ise sayı döner)."""
        if s in inh and tip[ds] == 'hafta_ici':
            return xw.get(s, 0)
        return xd.get((s, ds), 0)

    # =====================================================================
    # MALİYET
    # =====================================================================
    for ds in dates:
        mcfg = cfg_d[ds]['mip']
        for s in cov:
            v = n(s, ds)
            if isinstance(v, int):          # o gün bu vardiya yok
                continue
            if s in pts:
                taban, ctip = mcfg['cost_inhouse'], 'inhouse'
            elif s in inh:
                taban, ctip = mcfg['cost_inhouse'], 'inhouse'
            else:
                taban, ctip = mcfg['cost_outsource'], 'outsource'
            carp = get_time_cost_multiplier(queue, ctip, cov[s]['start'],
                                            config, tip[ds])
            # hafta içi inhouse tek değişken 5 günü temsil ediyor → maliyeti
            # yalnız BİR kez say, gün döngüsünde tekrarlamasın
            if s in inh and tip[ds] == 'hafta_ici' and ds != h_ici[0]:
                continue
            kat = len(h_ici) if (s in inh and tip[ds] == 'hafta_ici') else 1
            cost.append(v * (taban * carp * kat))

    # =====================================================================
    # K1 — KAPSAMA (sarkan dahil, slack'li)
    # =====================================================================
    onc = {dates[i]: dates[i - 1] for i in range(1, len(dates))}
    sk0 = {k: int(v or 0) for k, v in (sarkan_ilk_gun or {}).items()}

    sf = {}          # kapsama açığı
    exc = {}         # RR fazlalığı
    sc_exc = {}      # slot_cap aşımı
    kapsama_ifade = {}

    for ds in dates:
        c_d = cfg_d[ds]
        rr = c_d.get('rr_penalty', {}) or {}
        rr_on = rr.get('enabled', False)
        rr_pen = rr.get('penalty_per_person', 5.0)
        rr_peak_pen = rr.get('peak_penalty', rr_pen)
        rr_peak_muaf = rr.get('peak_exempt', False)
        rr_peak_esik = rr.get('peak_threshold', 0.70)
        sc = c_d.get('slot_cap', {}) or {}
        sc_on = sc.get('enabled', False)
        sf_pen = (config['ceza']['kapsama_hafta_ici'] if tip[ds] == 'hafta_ici'
                  else config['ceza']['kapsama_hafta_sonu'])

        aktif = [t for t in SLOTS_30 if erl[ds].get(t, 0) > 0]
        max_erl = max((erl[ds].get(t, 0) for t in aktif), default=0)
        peak = ({t for t in aktif if erl[ds].get(t, 0) >= max_erl * rr_peak_esik}
                if (rr_peak_muaf and max_erl > 0) else set())

        _o = onc.get(ds)
        for t in SLOTS_30:
            ihtiyac = erl[ds].get(t, 0)
            gelen = (sk0.get(t, 0) if _o is None else 0)
            terim = [n(s, ds) for s in cov if t in cov[s]['slots']]
            if _o is not None:
                terim += [n(s, _o) for s in cov if t in cov[s].get('slots_d1', [])]
            terim = [z for z in terim if not isinstance(z, int)]
            if not terim and not gelen and ihtiyac <= 0:
                continue
            ifade = lpSum(terim) + gelen
            kapsama_ifade[(ds, t)] = ifade

            if ihtiyac > 0:
                v = LpVariable(f"sf_{ds}_{t}", lowBound=0, cat='Continuous')
                sf[(ds, t)] = v
                prob += ifade + v >= ihtiyac
                cost.append(v * sf_pen)

            if rr_on and (ihtiyac > 0 or gelen > 0):
                e = LpVariable(f"ex_{ds}_{t}", lowBound=0, cat='Continuous')
                exc[(ds, t)] = e
                prob += e >= ifade - ihtiyac
                # GECE ÇARPANI KALDIRILDI (2026-10-08): eskiden 00:00-07:00
                # arası RR cezası ×100 yapılıyordu (4.0 → 400). Aynı işi
                # slot_cap'in gece bandı yapıyor ve TEK mekanizma daha okunur:
                #   h.içi  kitle 02:30-07:00 r1.0 p500 · kurumsal/gold 00:00-07:00 r1.0 p100
                #   h.sonu üç kuyruk 00:00-07:00 r1.0 p400  (= eski 4.0 × 100)
                # Hafta içinde zaten üç kuyrukta da kapalıydı → ölü anahtardı;
                # hafta sonunda açıktı, karşılığı slot_cap bandına taşındı.
                p = rr_peak_pen if t in peak else rr_pen
                cost.append(e * p)

            if sc_on and ihtiyac > 0:
                bant = next((b for b in sc.get('bands', [])
                             if is_slot_in_shift(t, b['start'], b['end'])), None)
                if bant is not None:
                    tavan = max(math.ceil(ihtiyac * bant.get('max_ratio', 1.20)), 3)
                    e = LpVariable(f"sc_{ds}_{t}", lowBound=0, cat='Continuous')
                    sc_exc[(ds, t)] = (e, bant.get('penalty', 50.0))
                    prob += e >= ifade - tavan
                    cost.append(e * bant.get('penalty', 50.0))

        # ---- K5 alt-kuyruk min (inhouse / outsource) ----
        for t, mn in (sq_in.get(ds) or {}).items():
            if mn and mn > 0:
                tr = [n(s, ds) for s in (inh + pts) if t in cov[s]['slots']]
                tr = [z for z in tr if not isinstance(z, int)]
                if tr:
                    prob += lpSum(tr) >= mn
        for t, mn in (sq_out.get(ds) or {}).items():
            if mn and mn > 0:
                tr = [n(s, ds) for s in out if t in cov[s]['slots']]
                tr = [z for z in tr if not isinstance(z, int)]
                if tr:
                    prob += lpSum(tr) >= mn

    # =====================================================================
    # K2 — min_per_shift (big-M, gün tipine göre)
    # =====================================================================
    for ds in dates:
        mcfg = cfg_d[ds]['mip']
        mn_def = mcfg['min_per_shift']
        mn_ovr = mcfg.get('min_per_shift_overrides', {}) or {}
        pt_mn = int((config.get('part_time', {}) or {}).get('min_per_shift', 0) or 0)
        for s in cov:
            # PT kendi eşiğini kullanır — tam zamanlının 13'ünü miras almaz
            mn = pt_mn if s in pts else mn_ovr.get(cov[s]['start'], mn_def)
            if s in inh and tip[ds] == 'hafta_ici':
                if ds != h_ici[0] or s not in xw:
                    continue
                v, b = xw[s], yw[s]
            else:
                if (s, ds) not in xd:
                    continue
                v, b = xd[(s, ds)], yd[(s, ds)]
            if mn and mn > 0:
                prob += v >= mn * b
                prob += v <= M[ds] * b
            else:
                # min yok → ikili değişkene gerek yok, sadece tavan
                prob += v <= M[ds]

    # =====================================================================
    # K3 — İNHOUSE GÜNLÜK KADRO  (PT GİRMEZ: company='part_time')
    # =====================================================================
    # YALNIZ HAFTA İÇİ. Kadro sayıları (412-428) hafta içi kadrosudur; hafta
    # sonunda bugünkü modelde de kadro tavanı YOK — hafta sonu inhouse'u
    # kapsama ihtiyacı + maliyet belirliyor. Hafta sonuna 414 dayatmak
    # gerçek dışı (fiilen Cmt'de ~146 inhouse çalışıyor).
    for ds in h_ici:
        kad = _resolve_kadro(config['kadro']['inhouse'].get(queue, {}), ds)
        if not kad or kad <= 0:
            continue
        tr = [n(s, ds) for s in inh]
        tr = [z for z in tr if not isinstance(z, int)]
        if not tr:
            continue
        if inhouse_esitlik:
            prob += lpSum(tr) == kad
        else:
            prob += lpSum(tr) <= kad

    # =====================================================================
    # K4 — OUTSOURCE HAFTALIK ADAM-GÜN  (ön türetme YOK)
    # =====================================================================
    # Bütçe TAVAN mı HEDEF mi: bugünkü akışta surplus dağıtımı outsource'u
    # türetilen kadroya kadar DOLDURUYOR → fiilen hedef. Aynı davranışı
    # korumak için varsayılan eşitlik (slack'li). 'outsource_esitlik': False
    # dersen tavan gibi davranır, model yalnız gerektiği kadar kullanır.
    adam_gun = None
    ag_sl = None
    ag_cfg = (config['kadro'].get('outsource_adam_gun') or {}).get(queue)
    if ag_cfg and out:
        hafta = _week_of_month(dates[0])
        adam_gun = ag_cfg.get(f"hafta_{hafta}")
        if adam_gun:
            # kısmi hafta: bütçe çözülen aya yazılır, bölünmez (operasyon
            # kararı 2026-10-07) → gün sayısına göre ölçeklenir
            hedef_ag = int(round(int(adam_gun) * len(dates) / 7.0))
            tr = [xd[(s, ds)] for ds in dates for s in out if (s, ds) in xd]
            if tr:
                if config['kadro'].get('outsource_esitlik', True):
                    a = LpVariable("ag_lo", lowBound=0, cat='Continuous')
                    b = LpVariable("ag_hi", lowBound=0, cat='Continuous')
                    ag_sl = (a, b, hedef_ag)
                    prob += lpSum(tr) + a - b == hedef_ag
                    cost.append((a + b) * config['ceza']['adam_gun_sapma'])
                else:
                    prob += lpSum(tr) <= hedef_ag

    # =====================================================================
    # K5 — OUTSOURCE ORAN BANDI (yalnız hafta sonu, slack'li)
    # =====================================================================
    oran_sl = {}
    o_cfg = (config.get('outsource_ratio') or {}).get(queue)
    if o_cfg and out:
        for ds in h_son:
            t_in = [n(s, ds) for s in (inh + pts)]
            t_in = [z for z in t_in if not isinstance(z, int)]
            t_ou = [n(s, ds) for s in out]
            t_ou = [z for z in t_ou if not isinstance(z, int)]
            if not t_in or not t_ou:
                continue
            A, B = lpSum(t_in), lpSum(t_ou)
            s1 = LpVariable(f"or_lo_{ds}", lowBound=0, cat='Continuous')
            s2 = LpVariable(f"or_hi_{ds}", lowBound=0, cat='Continuous')
            oran_sl[ds] = (s1, s2)
            rmin, rmax = o_cfg['min'], o_cfg['max']
            prob += (1 - rmin) * B + s1 >= rmin * A
            prob += (1 - rmax) * B - s2 <= rmax * A
            cost.append((s1 + s2) * config['ceza']['oran_sapma'])

    # =====================================================================
    # K6 — PART-TIME
    # =====================================================================
    # · günlük tavan     : Σ PT[gün] ≤ P
    # · hafta sonu       : Σ PT[gün] = P   (hafta_sonu_tam → mevcut davranış)
    # · haftalık kişi-gün: Σ_tüm gün = hafta_gun · P   (slack'li)
    #   Kısmi haftada hedef gün sayısına göre ölçeklenir.
    pt_sl = None
    if pts and pt_sayi > 0:
        ptc = config['part_time']
        for ds in dates:
            tr = [xd[(s, ds)] for s in pts if (s, ds) in xd]
            if not tr:
                continue
            if ptc.get('hafta_sonu_tam', True) and tip[ds] != 'hafta_ici':
                prob += lpSum(tr) == pt_sayi
            else:
                prob += lpSum(tr) <= pt_sayi
        tum = [xd[(s, ds)] for ds in dates for s in pts if (s, ds) in xd]
        if tum:
            hedef = int(round(ptc.get('hafta_gun', 5) * pt_sayi * len(dates) / 7.0))
            a = LpVariable("pt_lo", lowBound=0, cat='Continuous')
            b = LpVariable("pt_hi", lowBound=0, cat='Continuous')
            pt_sl = (a, b, hedef)
            prob += lpSum(tum) + a - b == hedef
            cost.append((a + b) * config['ceza']['pt_hedef_sapma'])

    # =====================================================================
    # K7 — DENGE CEZASI (yalnız hafta içi, gün tipi bloğundan)
    # =====================================================================
    for ds in h_ici:
        bp = cfg_d[ds].get('balance_penalty', {}) or {}
        if not bp.get('enabled', False) or not out:
            continue
        for w in bp.get('windows', []):
            ic = [n(s, ds) for s in inh if w['start'] <= cov[s]['start'] <= w['end']]
            oc = [n(s, ds) for s in out if w['start'] <= cov[s]['start'] <= w['end']]
            ic = [z for z in ic if not isinstance(z, int)]
            oc = [z for z in oc if not isinstance(z, int)]
            if not ic or not oc:
                continue
            p = LpVariable(f"bp_{ds}_{w['name']}_p", lowBound=0, cat='Continuous')
            m_ = LpVariable(f"bp_{ds}_{w['name']}_m", lowBound=0, cat='Continuous')
            prob += lpSum(ic) - lpSum(oc) == p - m_
            cost.append((p + m_) * w.get('penalty', bp.get('penalty_per_diff', 2.0)))

    # =====================================================================
    # K8 — YAYMA (fazlalık tek vardiyaya yığılmasın)
    # =====================================================================
    # SORUN: inhouse_esitlik=True kadronun TAMAMINI yerleştirmeye zorluyor.
    # Fazlalığın bedeli bantsız saatlerde sıfır olduğu için modelin tek
    # vardiyaya yığmakla yaymak arasında maliyet farkı yok → CBC uç noktada
    # duruyor (gold'da V18'e 134 kadronun 114'ü).
    #
    # ESKİ MODELDE bu işi MIP değil, MIP'ten SONRA koşan
    # `_distribute_surplus_per_day` bölüştürücüsü yapıyordu: fazlalığı
    # pencerelere oranla bölüp, kalanı `kalan // vardiya_sayısı` ile eşit
    # dağıtıyordu. Dengeli görünüm optimizasyon değil aritmetik bölmeydi.
    #
    # BURADA aynı etkiyi MODEL İÇİNDE kuruyoruz: grup başına bir üst zarf z,
    # her vardiya z'nin altında, z'ye küçük bir ceza. Model z'yi küçültmek
    # için yükü yaymak zorunda kalır.
    #   · z GRUP başına TEK skaler → kişi başı değil, ucuz
    #   · ceza küçük tutulur: slot_cap (100-500) ve kapsama (5000) HER ZAMAN
    #     yaymadan önce gelir. Yayma yalnız BERABERLİĞİ bozar.
    #   · GÜN İÇİ zarf grupları: hafta içi inhouse (tek değişken seti 5 günü
    #     temsil eder), hafta sonu inhouse gün bazlı, outsource gün bazlı.
    #     PT gün içi zarfa GİRMEZ — yalnız 3 vardiyası var, yayacak yer yok.
    #   · PT yalnız aşağıdaki GÜN TOPLAMI zarfına girer (hafta içi günler
    #     arası dağılımı dengelensin diye)
    #
    # Bölüştürücüden FARKI: yayma kapsama, slot_cap ve RR ile AYNI ANDA
    # çözülür. Bölüştürücü MIP'ten sonra koştuğu için slot_cap'i deliyordu.
    yayma_pen = float((config.get('ceza', {}) or {}).get('yayma', 0.0) or 0.0)
    yayma_z = {}
    if yayma_pen > 0:
        gruplar = []
        if h_ici and xw:
            gruplar.append(('inhouse_hafta_ici', [xw[s] for s in inh if s in xw]))
        for ds in dates:
            if tip[ds] != 'hafta_ici':
                gruplar.append((f'inhouse_{ds}',
                                [xd[(s, ds)] for s in inh if (s, ds) in xd]))
            gruplar.append((f'outsource_{ds}',
                            [xd[(s, ds)] for s in out if (s, ds) in xd]))
        for ad, dgs in gruplar:
            if len(dgs) < 2:
                continue
            z = LpVariable(f"z_{ad}", lowBound=0, cat='Continuous')
            for v in dgs:
                prob += v <= z
            yayma_z[ad] = z
            cost.append(z * yayma_pen)

        # ---- GÜN TOPLAMI ZARFI (yalnız hafta içi) ----
        # Yukarıdaki z GÜN İÇİ düzlüğü sağlar, günler ARASI dağılıma
        # MATEMATİKSEL OLARAK KAYITSIZDIR: haftalık toplam sabitken
        # Σ_gün z_gün alt sınırı yükün hangi güne gittiğinden bağımsız.
        # İlk denemede bu yüzden yığın tek güne kaçtı (Perşembe 1162 kişi).
        #
        # SERT BANT ALTERNATİFİ DENENDİ VE TERK EDİLDİ (ölçüm, kitle hafta 2):
        #   cezalı zg,      gap 0.03 → 13.2 sn, günler 334·334·333·334·334
        #   sert bant ±%15, gap 0.03 → 21.9 sn, günler 385·285·337·384·285
        # Bantta eşitliği ödüllendiren bir şey olmadığı için model bandın
        # kenarlarına yapışıyor. Cezalı zarf hem hızlı hem düzgün.
        #
        # SOLVER NOTU: gap_rel=0.01 bu terimle süreyi 300 sn'ye çıkarıyor
        # (minimize edilen maksimum LP relaksasyonunu gevşetir). gap_rel=0.03
        # AYNI çözümü 13 sn'de veriyor — config'de 0.03'e çekildi.
        #   · yalnız outsource ve PT: hafta içi inhouse tek değişken setiyle
        #     temsil edildiği için 5 güne zaten EŞİT dağılıyor
        #   · yalnız HAFTA İÇİ: hafta sonu talebi gerçekten farklı (~%55),
        #     7 güne tek zarf koymak hafta sonunu hafta içine eşitlerdi
        if len(h_ici) > 1:
            for ad, kume in (('gun_outsource', out), ('gun_pt', pts)):
                if not kume:
                    continue
                gun_ifade = []
                for ds in h_ici:
                    tr = [xd[(s2, ds)] for s2 in kume if (s2, ds) in xd]
                    if tr:
                        gun_ifade.append(lpSum(tr))
                if len(gun_ifade) < 2:
                    continue
                zg = LpVariable(f"zg_{ad}", lowBound=0, cat='Continuous')
                for ifd in gun_ifade:
                    prob += ifd <= zg
                yayma_z[ad] = zg
                cost.append(zg * yayma_pen)

    # =====================================================================
    # ÇÖZ
    # =====================================================================
    prob += lpSum(cost)
    sol = config.get('solver', {}) or {}
    kw = {'msg': sol.get('msg', 0)}
    if sol.get('time_limit'):
        kw['timeLimit'] = sol['time_limit']
    # KUYRUK BAZLI OPTİMALLİK BOŞLUĞU
    # gap_rel objektife GÖRE görelidir: K8 yayma terimi küçük kuyruklarda
    # (gold amaç ~17k) boşluğun içinde kalıyor ve CBC yaymayı ATLIYOR.
    # Ölçüm (gold hafta 5): gap 0.03 → tek vardiyada 118 kişi, amaç 17.278;
    # gap 0.001 → 5 vardiyaya yayılmış, amaç 17.122 (DAHA İYİ, yani erken
    # durmuş). gold/kurumsal 0.1 sn'de çözüyor → sıkı boşluk bedava.
    # kitle'de 0.01 süreyi 300 sn'ye çıkarıyor, orada 0.03 kalıyor.
    # Cezayı yükseltmek alternatifi denendi: pen=20 gold'u düzeltiyor ama
    # kitle'de adam-gün bütçesini 2 kişi-gün kaydırıyor → tercih edilmedi.
    _gap = (sol.get('gap_rel_by_queue', {}) or {}).get(queue, sol.get('gap_rel'))
    if _gap:
        kw['gapRel'] = _gap
    import time as _t
    _t0 = _t.time()
    prob.solve(PULP_CBC_CMD(**kw))
    sure = round(_t.time() - _t0, 1)
    durum = LpStatus[prob.status]

    # ZAMAN LİMİTİ TOLERANSI: CBC limite takılırsa optimalliği KANITLAMAZ ama
    # bulduğu çözüm geçerlidir. Değişkenlere değer atanmışsa kabul edilir —
    # kadro planında %1-2 boşluk anlamsız, çözümsüz kalmak anlamlı.
    _deger_var = any(v.varValue is not None for v in prob.variables())
    kabul = (durum == 'Optimal') or _deger_var
    if verbose:
        print(f"  [solve_week] {queue} {dates[0]}→{dates[-1]} · {len(dates)} gün "
              f"· {len(xd) + len(xw)} tamsayı · durum={durum} · {sure} sn"
              + ('' if durum == 'Optimal' else
                 ('  ⚠ optimallik kanıtlanmadı, çözüm kabul edildi' if kabul
                  else '  ✗ çözüm yok')))
    if not kabul:
        return None, {'durum': durum, 'sure': sure}

    # =====================================================================
    # SONUÇ TOPLA — eski mip_info sözleşmesiyle aynı anahtarlar
    # =====================================================================
    def _v(z):
        return 0 if isinstance(z, int) else int(round(value(z) or 0))

    atama = {ds: {} for ds in dates}
    for ds in dates:
        for s in cov:
            k = _v(n(s, ds))
            if k > 0:
                atama[ds][s] = k

    info_per_day = {}
    for ds in dates:
        a = atama[ds]
        _o = onc.get(ds)
        mip, mi_in, mi_ou, mi_pt = {}, {}, {}, {}
        for t in SLOTS_30:
            tt = ii = oo = pp = 0
            for s, k in a.items():
                if t not in cov[s]['slots']:
                    continue
                tt += k
                if s in pts:
                    pp += k
                elif s in inh:
                    ii += k
                else:
                    oo += k
            mip[t], mi_in[t], mi_ou[t], mi_pt[t] = tt, ii, oo, pp

        # önceki günden sarkan (hafta içindeyse atamadan, ilk günse dışarıdan)
        sg = {}
        if _o is None:
            sg = dict(sk0)
        else:
            for s, k in atama[_o].items():
                for t in cov[s].get('slots_d1', []):
                    sg[t] = sg.get(t, 0) + k
        fiili = {t: mip.get(t, 0) + sg.get(t, 0) for t in SLOTS_30}

        sf_slot = {t: int(round(value(v) or 0))
                   for (d2, t), v in sf.items()
                   if d2 == ds and int(round(value(v) or 0)) > 0}
        ex_slot = {t: int(round(value(v) or 0))
                   for (d2, t), v in exc.items()
                   if d2 == ds and int(round(value(v) or 0)) > 0}
        sc_slot = {t: (int(round(value(v) or 0)), p)
                   for (d2, t), (v, p) in sc_exc.items()
                   if d2 == ds and int(round(value(v) or 0)) > 0}

        t_in = sum(k for s, k in a.items() if s in inh)
        t_ou = sum(k for s, k in a.items() if s in out)
        t_pt = sum(k for s, k in a.items() if s in pts)
        t_all = t_in + t_ou + t_pt

        info_per_day[ds] = {
            'assignments': a,
            'shift_coverage': cov,
            'erlang_by_slot': dict(erl[ds]),
            'erlang_by_slot_ham': dict(erl[ds]),   # artık kurcalanmıyor → aynı
            'mip_by_slot': mip,
            'mip_in_by_slot': mi_in,
            'mip_out_by_slot': mi_ou,
            'mip_pt_by_slot': mi_pt,
            'sarkan_gelen_by_slot': sg,
            'fiili_by_slot': fiili,
            'total_kisi': t_all,
            'total_inhouse_kisi': t_in,
            'total_outsource_kisi': t_ou,
            'total_part_time_kisi': t_pt,
            'outsource_ratio': (t_ou / t_all) if t_all > 0 else 0,
            'pt_available': pt_sayi,
            'target_date': ds,
            'gun_tipi': tip[ds],
            'total_shortfall': int(sum(sf_slot.values())),
            'shortfall_by_slot': sf_slot,
            'rr_excess_by_slot': ex_slot,
            'rr_total_excess': int(sum(ex_slot.values())),
            'sc_excess_by_slot': sc_slot,
            'inhouse_min_by_slot': sq_in.get(ds, {}),
            'outsource_min_by_slot': sq_out.get(ds, {}),
            'solution_stage': ('TEK ÇÖZÜM' if not sf_slot
                               else f"TEK ÇÖZÜM + eksik {sum(sf_slot.values())} kişi-slot"),
            'min_per_shift_used': cfg_d[ds]['mip']['min_per_shift'],
        }

    # =====================================================================
    # ÖZET — "neden böyle çözdü"
    # =====================================================================
    ozet = {
        'durum': durum,
        'sure_sn': sure,
        'kuyruk': queue,
        'gun_sayisi': len(dates),
        'tarih_aralik': (dates[0], dates[-1]),
        'hafta': _week_of_month(dates[0]),
        'amac': round(value(prob.objective) or 0, 1),
        'kapsama_acik': {ds: info_per_day[ds]['total_shortfall'] for ds in dates},
        'rr_fazla': {ds: info_per_day[ds]['rr_total_excess'] for ds in dates},
        'slot_cap_asim': {ds: sum(v for v, _ in info_per_day[ds]['sc_excess_by_slot'].values())
                          for ds in dates},
        'oran_sapma': {ds: round((value(a) or 0) + (value(b) or 0), 2)
                       for ds, (a, b) in oran_sl.items()},
        'adam_gun_butce': adam_gun,
        'adam_gun_hedef': (ag_sl[2] if ag_sl else None),
        'adam_gun_sapma': (round((value(ag_sl[0]) or 0) + (value(ag_sl[1]) or 0), 2)
                           if ag_sl else 0),
        'adam_gun_kullanilan': sum(info_per_day[ds]['total_outsource_kisi'] for ds in dates),
        'pt_hedef': (pt_sl[2] if pt_sl else None),
        'pt_gerceklesen': sum(info_per_day[ds]['total_part_time_kisi'] for ds in dates),
        'pt_sapma': (round((value(pt_sl[0]) or 0) + (value(pt_sl[1]) or 0), 2)
                     if pt_sl else 0),
        'toplam_kisi': {ds: info_per_day[ds]['total_kisi'] for ds in dates},
        'yayma_ceza': yayma_pen,
        'yayma_zarf': {ad: int(round(value(z) or 0)) for ad, z in yayma_z.items()},
    }
    return info_per_day, ozet


# =============================================================================
# ÖZET YAZDIRMA
# =============================================================================

def print_ozet(ozet):
    """'Neden böyle çözdü' tablosu — hangi kısıt ne kadar esnedi."""
    if not ozet:
        print("  (özet yok)")
        return
    if 'toplam_kisi' not in ozet:
        print(f"  ⚠ durum: {ozet.get('durum')} — çözüm yok")
        return
    a, b = ozet['tarih_aralik']
    print(f"\n  ── {ozet['kuyruk']} · hafta {ozet['hafta']} · {a}→{b} "
          f"({ozet['gun_sayisi']} gün) · amaç={ozet['amac']:,.0f} "
          f"· {ozet.get('sure_sn')} sn"
          + ('' if ozet.get('durum') == 'Optimal' else f" · {ozet.get('durum')}"))
    satir = [
        ('kapsama açığı (kişi-slot)', ozet['kapsama_acik']),
        ('RR fazlalığı (kişi-slot)',  ozet['rr_fazla']),
        ('slot_cap aşımı',            ozet['slot_cap_asim']),
        ('toplam kişi',               ozet['toplam_kisi']),
    ]
    gunler = list(ozet['toplam_kisi'])
    bas = '  ' + ' ' * 28 + ''.join(f"{GUN_TR[pd.to_datetime(d).weekday()]:>7}"
                                     for d in gunler) + f"{'Σ':>8}"
    print(bas)
    for ad, d in satir:
        vals = [d.get(g, 0) for g in gunler]
        print('  ' + f"{ad:<28}" + ''.join(f"{v:>7}" for v in vals)
              + f"{sum(vals):>8}")
    if ozet['oran_sapma']:
        print('  ' + f"{'outsource oran sapması':<28}"
              + '  '.join(f"{g[-5:]}={v}" for g, v in ozet['oran_sapma'].items()))
    if ozet['adam_gun_butce']:
        k = ozet['adam_gun_kullanilan']
        t = ozet.get('adam_gun_hedef') or ozet['adam_gun_butce']
        sp = ozet.get('adam_gun_sapma', 0)
        print('  ' + f"{'adam-gün kullanımı':<28}{k} / {t}"
              + (f"  sapma {sp}" if sp else '  ✓'))
    if ozet['pt_hedef']:
        print('  ' + f"{'PT kişi-gün':<28}{ozet['pt_gerceklesen']} / {ozet['pt_hedef']}"
              + (f"  sapma {ozet['pt_sapma']}" if ozet['pt_sapma'] else ''))
    if ozet.get('yayma_zarf'):
        # z = o gruptaki EN KALABALIK vardiya. Düşük z = yük yayılmış.
        zz = ozet['yayma_zarf']
        print('  ' + f"{'yayma zarfı (en kalabalık)':<28}"
              + '  '.join(f"{ad.replace('inhouse_', 'in·').replace('outsource_', 'out·')[:12]}={v}"
                          for ad, v in zz.items()))
