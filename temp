band = CONFIG['outsource_ratio'].get(Q)
print("  config bandi: " + str(band))
print("  tarih        gun   inhouse  outsource  part_time  toplam   oran    band disi")
for d in sorted(results):
    wd = _pd.to_datetime(d).weekday()
    if wd < 5:
        continue
    r = results[d].get(Q)
    if not r:
        continue
    mi = r['mip_info']
    i_ = mi.get('total_inhouse_kisi', 0)
    o_ = mi.get('total_outsource_kisi', 0)
    p_ = mi.get('total_part_time_kisi', 0)
    t_ = i_ + o_ + p_
    oran = o_ / t_ if t_ else 0
    if band:
        sap = max(0, band['min'] - oran) + max(0, oran - band['max'])
    else:
        sap = 0
    print("  " + d + "   " + ('Cmt' if wd == 5 else 'Paz')
          + "   " + str(i_).rjust(7) + "  " + str(o_).rjust(9)
          + "  " + str(p_).rjust(9) + "  " + str(t_).rjust(6)
          + "   " + ("%5.1f%%" % (100 * oran))
          + "   " + (("%.3f" % sap) if sap > 0.001 else "-"))

