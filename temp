#                      (Excel'de KIRMIZI hücre; W_OFF_T cezası ödendi)
# Sağlama-1: off_t_gun + off_t_verilemeyen = agentın toplam off_t talebi.
# Sağlama-2: off_gun + izin_gun + off_t2_gun + off_t_gun + calisma_gun + mesai_gun
#            + resmi_tatil_gun = ayın gün sayısı  (verilemeyen off_t zaten çalışma
#            günü olarak sayılıyor, iki kez toplanmasın).
roster_2["izin_gun"]          = [int((roster.loc[a, _gun] == "izin").sum())
                                 for a in roster_2.index]
roster_2["off_t2_gun"]        = [int((roster.loc[a, _gun] == "off_t2").sum())
                                 for a in roster_2.index]
roster_2["off_t_gun"]         = [int((roster.loc[a, _gun] == "off_t").sum())
                                 for a in roster_2.index]
from collections import Counter as _Counter22             # hücre tek başına da koşsun
_offt_yok = _Counter22(a for a, _ds in offt_karsilanmadi)  # agent → karşılanmayan off_t
roster_2["off_t_verilemeyen"] = [_offt_yok.get(a, 0) for a in roster_2.index]

# H18 ÇİFT OFF VERİLDİ Mİ: 1 → o agent ay içinde en az bir tam Cmt+Pzr çiftini
# birlikte off geçirdi. 0 → geçiremedi (H18'den muaf kalmış).
# ÖLÇÜ ROSTER'DAN: modelin muaf değişkenine DEĞİL, fiili çizelgeye bakılıyor →
# fizibilite modunda (amaç yok, muafiyet bedava) bile doğru sonuç verir ve
# H28B denetimiyle aynı ölçüyü kullanır.
# "off" = o gün çalışılmamış; sebebi fark etmez (izin / off_t2 / off_t / model off).
# Hamile-süt hafta sonu zaten çalışamaz → hep 1.
roster_2["cift_off_verildi"] = [
    int(any(all(roster.at[a, _c18] in _OFF_LIKE for _c18 in (_cmt18, _pzr18))
            for _cmt18, _pzr18 in hs_ciftleri))
