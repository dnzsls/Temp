# %% [HÜCRE 27] — ADALET KONTROLÜ (hafta sonu + akşam/gece dağılımı) ─────
# H20C (hafta sonu) ve H20D (akşam/gece) cezaları çalıştı mı → yük kişilere
# dengeli dağıldı mı? Her boyut için: kaç agent kaç gün çalışmış + adil pay
# ÜSTÜnde (cezalı bölgede) kaç kişi kaldı + max/ortalama.
from collections import Counter


def _adalet_ozet(baslik, gv_list, fair, sebep_fn=None):
    agent_c = {a: sum(solver.Value(x[(a, ds, v)]) for (ds, v) in gv_list if (a, ds, v) in x)
               for a in AGENTS}
    sayilar = list(agent_c.values())
    dag = Counter(sayilar)
    ust = sum(1 for c in sayilar if c > fair)
    print(f"\n=== {baslik}  (adil pay = {fair}) ===")
    print(f"max={max(sayilar)}  ortalama={sum(sayilar) / len(sayilar):.1f}  "
          f"adil pay ÜSTÜ agent={ust}  (ideal: az/sıfır)")
    print("gün → kaç agent:")
    for k in sorted(dag):
        isaret = "  ← cezalı (adil pay üstü)" if k > fair else ""
        ek = ""
        if k == 0 and sebep_fn is not None:                      # 0 gün → neden 0'da?
            ek = "   → " + sebep_fn([a for a in AGENTS if agent_c[a] == 0])
        print(f"  {k:2d} gün: {dag[k]:4d} agent{isaret}{ek}")


# hafta sonu (H20C) — hafta sonu günlerindeki kovalar
hs_gv = [(ds, v) for (ds, v) in talep
         if dt.date.fromisoformat(ds).weekday() >= 5]
hs_tarih = sorted({ds for (ds, _) in hs_gv})                    # hafta sonu tarihleri


def _hs_sebep(agents):
    # öncelikli kategori (bir agent birden fazlaysa ilk uyanı say)
    hs = sum(1 for a in agents if a in hafta_sonu_yasak)                    # hamile/süt (HS yasak)
    ms = sum(1 for a in agents if a not in hafta_sonu_yasak and a in mesai_yok)  # mesaiye_kalamaz
    iz = sum(1 for a in agents if a not in hafta_sonu_yasak and a not in mesai_yok
             and all(dt.date.fromisoformat(ds) in izin_map.get(a, set()) for ds in hs_tarih))
    kalan = len(agents) - hs - ms - iz                                     # kısıtsız (çözücü tercih)
    return f"hamile/süt {hs} | mesaiye_kalamaz {ms} | tüm-HS-izinli {iz} | kısıtsız {kalan}"


_adalet_ozet("HAFTA SONU adaleti (H20C)", hs_gv, FAIR_HS, _hs_sebep)

# akşam+gece (H20D) — HAFTA bazında (agent kaç FARKLI HAFTA akşam/gece çalışmış)
