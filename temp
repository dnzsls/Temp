# ── SARKAN VARDİYA ÖLÇÜMÜ (SALT OKUNUR — modele/plana/Excel'e dokunmaz) ──
import datetime as _dt, pandas as _pd
from collections import Counter as _C

_DAY = ["Pzt","Sal","Çar","Per","Cum","Cmt","Paz"]

def _mi_al(r, q):
    rq = (r or {}).get(q) or {}
    return rq.get("mip_info", {}) or {}, rq

def _slot_sozluk(mi, rq, ad):
    return mi.get(ad) or rq.get(ad) or {}

_gunler = sorted(d for d, r in (results or {}).items() if r)
_kuyruklar = sorted({q for d in _gunler for q in (results[d] or {})})
print("="*100)
print(f"SARKAN VARDİYA ÖLÇÜMÜ — {len(_gunler)} gün, kuyruklar: {_kuyruklar}")
print("="*100)

# ── [1] SARKAN VARDİYA KATALOĞU ──────────────────────────────────────
_kat = {}
for _d in _gunler:
    for _q in _kuyruklar:
        _mi, _rq = _mi_al(results[_d], _q)
        _cov = _mi.get("shift_coverage", {}) or {}
        _asg = _mi.get("assignments", {}) or {}
        for _k, _c in _cov.items():
            _st, _en = str(_c.get("start"))[:5], str(_c.get("end"))[:5]
            try:    _bn = f"{int(_st[:2])%24:02d}:{_st[3:5]}"
            except Exception: continue
            _tail = [s for s in (_c.get("slots") or []) if s < _bn]
            if not _tail: continue
            _key = (_q, _c.get("shift"), _st, _en, _c.get("company"))
            _r = _kat.setdefault(_key, {"gun":0, "kisi":0, "tail":len(_tail)})
            if _asg.get(_k, 0) > 0:
                _r["gun"]  += 1
                _r["kisi"] += int(_asg[_k])

print("\n[1] GECE YARISINI AŞAN VARDİYALAR  (start > end; 00:00/24:00 gece vardiyası DEĞİL)")
if not _kat:
    print("    ✓ hiç sarkan vardiya YOK → bu konu kapanır.")
else:
    print(f"    {'kuyruk':<10}{'vardiya':<16}{'baş':>6}{'bitiş':>7}{'şirket':>11}"
          f"{'sarkan slot':>12}{'kullanılan gün':>15}{'Σ kişi-gün':>12}")
    for _k, _v in sorted(_kat.items(), key=lambda kv: (-kv[1]["kisi"], kv[0])):
        _q,_sh,_st,_en,_co = _k
        print(f"    {str(_q):<10}{str(_sh)[:15]:<16}{_st:>6}{_en:>7}{str(_co):>11}"
              f"{_v['tail']:>12}{_v['gun']:>15}{_v['kisi']:>12}")

# ── [2] GÜN × SARKAN KİŞİ-SLOT ───────────────────────────────────────
_sark = {}
for _d in _gunler:
    for _q in _kuyruklar:
        _mi, _rq = _mi_al(results[_d], _q)
        _cov = _mi.get("shift_coverage", {}) or {}
        _asg = _mi.get("assignments", {}) or {}
        for _k, _c in _cov.items():
            _n = int(_asg.get(_k, 0) or 0)
            if _n <= 0: continue
            _st = str(_c.get("start"))[:5]
            try:    _bn = f"{int(_st[:2])%24:02d}:{_st[3:5]}"
            except Exception: continue
            for _s in (_c.get("slots") or []):
                if _s < _bn:
                    _sark.setdefault((_q,_d), {}).setdefault(_s, _C())[str(_c.get("company"))] += _n

print("\n[2] GÜNLÜK SARKAN KİŞİ-SLOT  (o günün vardiyasından ERTESİ GÜNE taşan kapasite)")
if not _sark:
    print("    (yok)")
else:
    _sat = []
    for (_q,_d), _sd in sorted(_sark.items()):
        _dd = _dt.date.fromisoformat(_d)
        _ert = (_dd + _dt.timedelta(days=1)).isoformat()
        _sinir = ("Cuma→Cmt" if _dd.weekday()==4 else
                  "Paz→Pzt"  if _dd.weekday()==6 else
                  "Cmt→Paz"  if _dd.weekday()==5 else "h.içi→h.içi")
        if _ert not in (results or {}): _sinir += " [AY SONU]"
        _co = _C()
        for _s, _c in _sd.items(): _co.update(_c)
        _sat.append({"kuyruk":_q, "tarih":_d, "gun":_DAY[_dd.weekday()], "sinir":_sinir,
                     "slot_sayisi":len(_sd), "kisi_slot":sum(_co.values()),
                     **{f"ks_{k}": v for k,v in _co.items()}})
    _df2 = _pd.DataFrame(_sat)
    print(_df2.to_string(index=False))

    print("\n[3] SINIR TÜRÜNE GÖRE TOPLAM  (kişi-slot; ÷2 = kişi-saat)")
    _g = (_df2.groupby(["kuyruk","sinir"])
               .agg(kisi_slot=("kisi_slot","sum"), gun_sayisi=("kisi_slot","size"))
               .reset_index())
    _g["kisi_saat"] = _g["kisi_slot"]/2
    print(_g.to_string(index=False))

    print("\n[4] SINIR GÜNLERİNDE HEDEF GÜN (D+1) SLOT DETAYI")
    print("    planlanan = D+1'in mip_by_slot'u  |  sarkan = D'den taşan  |  FİİLEN = ikisi")
    for (_q,_d), _sd in sorted(_sark.items()):
        _dd = _dt.date.fromisoformat(_d)
        if _dd.weekday() not in (4,6): continue
        _ert = (_dd + _dt.timedelta(days=1)).isoformat()
        _mi2, _rq2 = _mi_al((results or {}).get(_ert), _q)
        _mbs = _slot_sozluk(_mi2, _rq2, "mip_by_slot")
        _erl = _slot_sozluk(_mi2, _rq2, "erlang_by_slot")
        _cal = _slot_sozluk(_mi2, _rq2, "calls_by_slot")
        print(f"\n    ── {_q} | {_d} {_DAY[_dd.weekday()]} → {_ert} "
              f"{_DAY[(_dd+_dt.timedelta(days=1)).weekday()]}"
              + ("   ⚠ D+1 planda YOK (ay sonu)" if not _mbs and _ert not in (results or {}) else ""))
        print(f"       {'slot':>6}{'çağrı':>8}{'erlang':>8}{'planlanan':>11}"
              f"{'sarkan':>8}{'FİİLEN':>8}{'fazla%':>8}")
        for _s in sorted(_sd):
            _p = int(_mbs.get(_s, 0) or 0); _sk = sum(_sd[_s].values())
            _e = int(_erl.get(_s, 0) or 0); _cc = float(_cal.get(_s, 0) or 0)
            _or = f"{(_p+_sk)/_e*100:.0f}" if _e else "—"
            print(f"       {_s:>6}{_cc:>8.0f}{_e:>8}{_p:>11}{_sk:>8}{_p+_sk:>8}{_or:>8}")

    print("\n[5] HAYALİ DOLULUK  (D'nin 00:00-… slotuna D'NİN KENDİ sarkması yazılı;")
    print("    fiilen orada D−1'in sarkması olmalıydı. fark = hayali − gerçek)")
    print(f"       {'kuyruk':<9}{'tarih':<12}{'gün':>4}{'hayali(D)':>11}"
          f"{'gerçek(D−1)':>13}{'FARK':>8}  yorum")
    _h6 = []
    for _q in _kuyruklar:
        for _d in _gunler:
            _dd = _dt.date.fromisoformat(_d)
            _onc = (_dd - _dt.timedelta(days=1)).isoformat()
            _hay = sum(sum(c.values()) for c in _sark.get((_q,_d), {}).values())
            _ger = sum(sum(c.values()) for c in _sark.get((_q,_onc), {}).values())
            if not (_hay or _ger): continue
            _f = _hay - _ger
            _yor = ("✓ dengeleniyor" if abs(_f) <= 0.05*max(1,_hay)
                    else ("⚠ HAYALİ FAZLA — gece açığı gizli" if _f > 0
                          else "⚠ GÖRÜNMEYEN FAZLA — boşa kadro"))
            if _onc not in (results or {}): _yor += " [önceki ay verisi yok]"
            print(f"       {_q:<9}{_d:<12}{_DAY[_dd.weekday()]:>4}{_hay:>11}"
                  f"{_ger:>13}{_f:>+8}  {_yor}")
            _h6.append((_q,_d,_f))
    if _h6:
        _poz = sum(f for _,_,f in _h6 if f > 0); _neg = -sum(f for _,_,f in _h6 if f < 0)
        print(f"\n       AY TOPLAMI: hayali fazla {_poz} kişi-slot ({_poz/2:.1f} kişi-saat)"
              f"  |  görünmeyen fazla {_neg} kişi-slot ({_neg/2:.1f} kişi-saat)")

    print("\n[6] AYLIK TOPLAM")
    for _q in _kuyruklar:
        _t = _df2[_df2["kuyruk"]==_q]["kisi_slot"].sum()
        _b = _df2[(_df2["kuyruk"]==_q) & _df2["sinir"].str.startswith(("Cuma→","Paz→"))]["kisi_slot"].sum()
        print(f"    {_q:<10} toplam sarkan {int(_t):>6} kişi-slot ({_t/2:>7.1f} kişi-saat)  |  "
              f"gün-tipi sınırında {int(_b):>6} ({_b/2:>7.1f} kişi-saat)")
print("="*100)
