# ÖLÇÜLER — karşılanan çağrı (sunum kutusu) + aylık SL
# ---------------------------------------------------------------------------

def karsilama(cagri, gereken, kapasite):
    """Sunum grafiklerindeki kutunun ölçüleri.

    KARŞILANAN ÇAĞRI — fazlalık eksiği KAPATMAZ (mahsuplaşma yok):
      bir slotta kadronun %x'i eksikse o slotun çağrısının %x'i açıkta.
    """
    cg = np.asarray(cagri, dtype=float)
    ger = np.asarray(gereken, dtype=float)
    kap = np.asarray(kapasite, dtype=float)
    with np.errstate(divide='ignore', invalid='ignore'):
        acik_pay = np.where(ger > 0, np.clip(ger - kap, 0, None) / ger, 0.0)
    acik = float((cg * acik_pay).sum())
    top = float(cg.sum())
    return {
        'karsilanan': (1 - acik / top) if top else float('nan'),
        'acik_cagri': acik,
        'eksik_slot': int((kap < ger).sum()),
        'fazla_kisi_saat': float(np.clip(kap - ger, 0, None).sum()) / 2,
        'eksik_kisi_saat': float(np.clip(ger - kap, 0, None).sum()) / 2,
        'i_dip': int(np.argmin(kap - ger)) if len(kap) else 0,
    }


def sl_serisi(df, kap_kol, shrinkage=None, T=SLA_SANIYE):
    """Her slot için SL (30 sn içinde cevaplanma olasılığı) — sla_slot_tablosu
    ile AYNI formül: telefonda = kişi × (1 − shrinkage), trafik = çağrı × AHT."""
    tr = df['cagri'].values * df['aht'].values / 60.0 / INTERVAL_MIN
    onbellek, out = {}, []
    for kisi, sl, t, a, cg in zip(df[kap_kol].values, df['interval'].values, tr,
                                  df['aht'].values, df['cagri'].values):
        if cg <= 0:
            out.append(np.nan)
            continue
        key = (kisi, sl[:2], round(t, 4), a)
        if key not in onbellek:
            onbellek[key] = calc_sl(_telefonda(kisi, sl, shrinkage), t, a, T)
        out.append(onbellek[key])
    return np.array(out, dtype=float)


def karsilastirma_ozeti(tablolar, kod_ekip, kod_biz, hedef=SLA_HEDEF, verbose=True):
    """İHTİYAÇ ↔ EKİP ↔ BİZ — hap tablo (AY TOPLAMI, gün × slot üzerinden).

    Satırlar: İHTİYAÇ · EKİP · BİZ · FARK (BİZ − EKİP)
    Kolonlar : kişi-saat · karşılanan çağrı % · açıkta çağrı · fazla/eksik
               kişi-saat · aylık SL % · SL hedefe göre çağrı (+ fazla / − açık)
    """
    satir = []
    base = tablolar[kod_ekip]
    adaylar = [('İHTİYAÇ (Erlang)', base, 'gereken'),
               (KAYNAKLAR[kod_ekip], tablolar[kod_ekip], 'kapasite_toplam'),
               (KAYNAKLAR[kod_biz], tablolar[kod_biz], 'kapasite_toplam')]
    for et, t, kol in adaylar:
        m = karsilama(t['cagri'], t['gereken'], t[kol])
        sl = sl_serisi(t, kol)
        C = float(t['cagri'].sum())
        A = float(np.nansum(t['cagri'].values * sl))
        satir.append({
            'kaynak': et,
            'kisi_saat': round(t[kol].sum() / 2),
            'karsilanan_cagri_%': round(100 * m['karsilanan'], 1),
            'acikta_cagri': round(m['acik_cagri']),
            'fazla_kisi_saat': round(m['fazla_kisi_saat']),
            'eksik_kisi_saat': round(m['eksik_kisi_saat']),
            'aylik_SL_%': round(100 * A / C, 1) if C else np.nan,
            'SL_hedefe_gore_cagri': round(A - hedef * C),
        })
    out = pd.DataFrame(satir)
    fark = {'kaynak': 'FARK (BİZ − EKİP)'}
    for c in out.columns[1:]:
        fark[c] = round(out.loc[2, c] - out.loc[1, c], 1)
    out = pd.concat([out, pd.DataFrame([fark])], ignore_index=True)

    if verbose:
        show(out)
        e, b = out.loc[1], out.loc[2]
        isaret = lambda v: '✓' if v >= 100 * hedef else '✗'
        print(f"  • karşılanan çağrı: EKİP %{e['karsilanan_cagri_%']} · BİZ "
              f"%{b['karsilanan_cagri_%']}  → açıkta çağrı farkı "
              f"{fark['acikta_cagri']:+,.0f}")
        print(f"  • aylık SL (%{100 * hedef:.0f}/30sn): EKİP %{e['aylik_SL_%']} "
              f"{isaret(e['aylik_SL_%'])} · BİZ %{b['aylik_SL_%']} "
              f"{isaret(b['aylik_SL_%'])}  → fark {fark['SL_hedefe_gore_cagri']:+,.0f} çağrı")
        print(f"  • kadro: BİZ − EKİP = {fark['kisi_saat']:+,.0f} kişi-saat")
        print("  NOT: tablo AY TOPLAMI · grafik kutuları ORTALAMA GÜN → sayılar farklı ölçekte.")
    return out


def sl_ozeti(tablolar, df_ihtiyac, hedef=SLA_HEDEF, verbose=True):
    """Tüm kaynaklar için aylık SL — tek tablo, kaynak başına tek satır.

    SL hesabı sla_slot_tablosu() ile yapılır (detay hücresi aynı tabloyu okur).
    Dönüş: (özet, df_sla)
    """
    kodlar = [k for k in KAYNAKLAR if k in tablolar]
    ortak, n_gun = ortak_gunler(tablolar, kodlar, verbose=verbose)
    base = ortak[kodlar[0]][['data_date', 'interval', 'cagri', 'gereken']]
    base = base.rename(columns={'cagri': 'actual_kitle', 'gereken': 'ihtiyac'})
    for k in kodlar:
        base = base.merge(ortak[k][['data_date', 'interval', 'kapasite_toplam']]
                          .rename(columns={'kapasite_toplam': f'kap_{k}'}),
                          on=['data_date', 'interval'], how='left')
    aht_df = df_ihtiyac[['data_date', 'interval', 'aht']]
    df_sla = sla_slot_tablosu(base, aht=aht_df, hedef=hedef, verbose=False)

    C = float(df_sla['actual_kitle'].sum())
    satir = []
    for kod, et, kol in SLA_KATMANLAR:
        if f'sl_{kod}' not in df_sla.columns:
            continue
        A = float((df_sla['actual_kitle'] * df_sla[f'sl_{kod}']).sum())
        saat = df_sla.groupby(df_sla['interval'].str[:2])[f'kredi_{kod}'].sum()
        satir.append({
            'kaynak': et,
            'aylik_SL_%': round(100 * A / C, 1),
            'hedef': '✓' if A >= hedef * C else '✗',
            'hedefe_gore_cagri': round(A - hedef * C),
            'en_borclu_saat': f"{saat.idxmin()}:00" if saat.min() < 0 else '—',
        })
    out = pd.DataFrame(satir)
    if verbose:
        print(f"AYLIK SL — %{100 * hedef:.0f} / {SLA_SANIYE} sn  |  {n_gun} ortak gün  |  "
              f"{C:,.0f} çağrı")
        show(out)
        for kb, ke, ad in (('biz_m1', 'ekip_m1', 'PLAN seviyesi'),
                           ('biz_m2', 'ekip_m2', 'KİŞİ seviyesi')):
            if f'sl_{kb}' in df_sla.columns and f'sl_{ke}' in df_sla.columns:
                fk = float((df_sla['actual_kitle'] * (df_sla[f'sl_{kb}']
                                                      - df_sla[f'sl_{ke}'])).sum())
                print(f"  • {ad}: BİZ − EKİP = {fk:+,.0f} çağrı "
                      f"({100 * fk / C:+.1f} puan SL)")
        print("  hedefe_gore_cagri: + hedefin üstünde · − hedefe bu kadar çağrı eksik")
        print("  ⚠ nof_call cevaplanan çağrı sayılırsa kaçan çağrı yok → SL İYİMSER.")
    return out, df_sla


