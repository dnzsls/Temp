# =============================================================================
# VARDİYA PLANI → SLOT BAZLI KİŞİ SAYISI (30 DK)  —  BAĞIMSIZ
# =============================================================================
# Amaç: agent bazlı vardiya planını, modelin çıktısıyla aynı dilde konuşan bir
# tabloya çevirmek: her (gün × 30dk slot × kuyruk) için sahada kaç kişi var.
#
# Bu dosya veri çekmez, pipeline'a bağlı değildir. Sadece pandas.
#
# GİRDİ — VARDİYA PLANI (agent × gün):
#   agent_user_code, agent_name, date, vardiya ('08:00-17:00'),
#   line_based_main_group ('kitle_cagrilar' | 'gold_cagrilar' | 'kurumsal_cagrilar'),
#   mesai_mi_calisti, kismi_flg, hamile_flg, sut_izni_flg, kidem_1_ay_flg,
#   egitim_flg, vob_flg
#   → tamamı inhouse. Outsource ayrıca elle eklenir.
#
# ÇIKTI:
#   data_date, interval,
#   plan_kitle, plan_kurumsal, plan_gold          (o slotta sahadaki kişi)
#   mesai_kitle, mesai_kurumsal, mesai_gold       (bunun kaçı mesai kaydı)
# =============================================================================

# %% [HÜCRE 1] — FONKSİYONLAR

import re

import pandas as pd

try:                                   # Jupyter'da zengin tablo, terminalde düz metin
    from IPython.display import display as _display
except ImportError:                     # pragma: no cover
    _display = None


def show(df, n=None):
    """DataFrame'i Jupyter tablosu olarak gösterir (terminalde metne düşer)."""
    x = df.head(n) if n else df
    if _display is not None:
        _display(x)
    else:
        print(x.to_string(index=False))
    return x


SLOTS_30 = [f"{h:02d}:{m}" for h in range(24) for m in ('00', '30')]
SLOT_IDX = {s: i for i, s in enumerate(SLOTS_30)}

QUEUES = ('kitle', 'kurumsal', 'gold')

# line_based_main_group → kuyruk
QUEUE_BY_GROUP = {
    'kitle_cagrilar':    'kitle',
    'kurumsal_cagrilar': 'kurumsal',
    'gold_cagrilar':     'gold',
}

DEFAULT_MODEL_COLS = {
    'date':    ['data_date', 'date', 'tarih'],
    'queue':   ['kuyruk', 'queue', 'line_based_main_group'],
    'shift':   ['vardiya', 'shift'],
    'kisi':    ['kisi', 'kisi_sayisi', 'count', 'adet'],
    'company': ['company', 'sirket'],
}

DEFAULT_PLAN_COLS = {
    'agent': 'agent_user_code',
    'date':  'date',
    'shift': 'vardiya',
    'group': 'line_based_main_group',
    'mesai': 'mesai_mi_calisti',
}

# Her flag için: 'exclude' → o gün sahada saymaz | 'include' → normal sayılır.
# NOT: sut_izni_flg şimdilik 'include' — günün hangi saatinde ne kadar düşüleceği
# kuralı netleşince kısmi düşüm olarak ayrıca ele alınacak.
DEFAULT_FLAG_RULES = {
    'egitim_flg':     'exclude',
    'vob_flg':        'exclude',
    'hamile_flg':     'include',
    'sut_izni_flg':   'include',
    'kismi_flg':      'include',   # vardiya kolonu zaten kısa saati yazıyor
    'kidem_1_ay_flg': 'include',
}

TRUTHY = {1, '1', 1.0, True, 'e', 'evet', 'y', 'yes', 't', 'true', 'x', 'var'}


def _is_true(s):
    """1 / 'E' / 'Evet' / True / 'X' gibi değerleri bool'a çevirir."""
    return s.map(lambda v: str(v).strip().lower() in TRUTHY
                 if not isinstance(v, (int, float, bool)) or isinstance(v, bool)
                 else v in TRUTHY)


def _resolve_col(df, spec):
    """Aday kolon adlarından df'te bulunan ilkini döndürür (yoksa None)."""
    cands = [spec] if isinstance(spec, str) else list(spec)
    for c in cands:
        if c in df.columns:
            return c
    return None


def _normalize_queue(s):
    """'kitle_cagrilar' / 'Kitle' / 'kitle' → 'kitle'."""
    v = s.astype(str).str.strip().str.lower()
    return v.map(lambda x: QUEUE_BY_GROUP.get(x, x if x in QUEUES else None))


def _to_date_series(s):
    """ISO ('2026-08-03') ise dayfirst kapalı, aksi halde açık."""
    if pd.api.types.is_datetime64_any_dtype(s):
        return pd.to_datetime(s)
    sample = s.dropna().astype(str)
    is_iso = bool(len(sample)) and sample.str.match(r'^\d{4}-\d{2}-\d{2}').all()
    return pd.to_datetime(s, dayfirst=not is_iso)


_SHIFT_RE = re.compile(r'(\d{1,2})[:.](\d{2})\s*[-–—]\s*(\d{1,2})[:.](\d{2})')


def shift_slots(text):
    """'08:00-17:00' → kapsadığı 30dk slot listesi.

    Geceyi aşan vardiyaları da doğru işler ('22:00-06:00' → 22:00…05:30).
    Vardiya metni çözümlenemezse (OFF, İZİN, boş) boş liste döner.
    """
    m = _SHIFT_RE.search(str(text))
    if not m:
        return []

    sh, sm, eh, em = (int(g) for g in m.groups())
    start = f"{sh % 24:02d}:{(sm // 30) * 30:02d}"
    end_idx_raw = (eh % 24) * 2 + (em // 30)
    if eh == 24 or (eh % 24) * 60 + em == 0:       # '…-24:00' / '…-00:00'
        end_idx_raw = len(SLOTS_30)

    i, j = SLOT_IDX[start], end_idx_raw
    if j <= i:                                     # geceyi aşıyor
        j += len(SLOTS_30)
    return [SLOTS_30[k % len(SLOTS_30)] for k in range(i, j)]


def build_plan_coverage(df_plan, year=2026, month=8, plan_cols=None,
                        flag_rules=None, verbose=True):
    """Vardiya planını (gün × 30dk slot × kuyruk) kişi sayısına çevirir.

    Aynı agent aynı gün birden fazla satırda geçse bile bir slotta bir kez
    sayılır (agent_user_code üzerinden tekilleştirme).
    """
    cols = {**DEFAULT_PLAN_COLS, **(plan_cols or {})}
    rules = {**DEFAULT_FLAG_RULES, **(flag_rules or {})}

    eksik = [v for k, v in cols.items() if v not in df_plan.columns]
    if eksik:
        raise KeyError(f"PLAN: şu kolon(lar) yok: {eksik}  |  "
                       f"mevcut: {list(df_plan.columns)}")

    df = df_plan.copy()
    df['data_date'] = _to_date_series(df[cols['date']]).dt.normalize()
    df['queue'] = df[cols['group']].astype(str).str.strip().str.lower().map(QUEUE_BY_GROUP)
    df['mesai'] = _is_true(df[cols['mesai']])

    n0 = len(df)

    # Ay filtresi
    df = df[(df['data_date'].dt.year == year) & (df['data_date'].dt.month == month)]
    if verbose and len(df) < n0:
        print(f"  ℹ PLAN: {n0 - len(df):,} satır {year}/{month:02d} dışında, elendi.")

    # Tanınmayan kuyruk
    bilinmeyen = df[df['queue'].isna()][cols['group']].dropna().unique()
    if len(bilinmeyen):
        print(f"  ⚠ PLAN: tanınmayan {cols['group']} değerleri elendi: "
              f"{list(bilinmeyen)[:10]}")
    df = df[df['queue'].notna()]

    # Flag süzgeci
    for flag, rule in rules.items():
        if rule != 'exclude':
            continue
        if flag not in df.columns:
            if verbose:
                print(f"  ℹ PLAN: '{flag}' kolonu yok, kural atlandı.")
            continue
        maske = _is_true(df[flag])
        if verbose and maske.any():
            print(f"  ℹ PLAN: {flag} → {int(maske.sum()):,} satır sahada sayılmadı.")
        df = df[~maske]

    # Vardiya metni → slotlar
    vardiyalar = df[cols['shift']].astype(str).unique()
    slot_map = {v: shift_slots(v) for v in vardiyalar}
    cozulmeyen = [v for v, s in slot_map.items() if not s]
    if cozulmeyen and verbose:
        print(f"  ℹ PLAN: vardiya olarak okunamayan {len(cozulmeyen)} değer "
              f"(off/izin sayıldı): {cozulmeyen[:8]}")

    df['slot_30'] = df[cols['shift']].astype(str).map(slot_map)
    df = df.explode('slot_30').dropna(subset=['slot_30'])

    # Slot × kuyruk bazında tekil agent sayısı
    plan = (df.groupby(['data_date', 'slot_30', 'queue'])[cols['agent']]
              .nunique().rename('kisi').reset_index())
    mesai = (df[df['mesai']].groupby(['data_date', 'slot_30', 'queue'])[cols['agent']]
               .nunique().rename('mesai').reset_index())

    # Ayın tam ızgarası
    first = pd.Timestamp(year=year, month=month, day=1)
    all_days = pd.date_range(first, first + pd.offsets.MonthEnd(1), freq='D')
    out = pd.MultiIndex.from_product(
        [all_days, SLOTS_30], names=['data_date', 'slot_30']).to_frame(index=False)

    for q in QUEUES:
        for src, prefix in ((plan, 'plan'), (mesai, 'mesai')):
            col = 'kisi' if prefix == 'plan' else 'mesai'
            sub = src[src['queue'] == q][['data_date', 'slot_30', col]]
            sub = sub.rename(columns={col: f"{prefix}_{q}"})
            out = out.merge(sub, on=['data_date', 'slot_30'], how='left')

    value_cols = [f"{p}_{q}" for q in QUEUES for p in ('plan', 'mesai')]
    out[value_cols] = out[value_cols].fillna(0).astype(int)

    out['interval'] = out['slot_30']
    out = out.sort_values(['data_date', 'slot_30']).reset_index(drop=True)
    out = out[['data_date', 'interval'] +
              [f"plan_{q}" for q in QUEUES] + [f"mesai_{q}" for q in QUEUES]]

    if verbose:
        _print_plan_summary(out, all_days)
    return out


def _print_plan_summary(out, all_days):
    print(f"VARDİYA PLANI — SLOT BAZLI KİŞİ  |  {len(out):,} satır "
          f"({len(all_days)} gün × {len(SLOTS_30)} slot)")
    satirlar = []
    for q in QUEUES:
        s = out[f"plan_{q}"]
        tepe = out.loc[s.idxmax()] if s.max() else None
        satirlar.append({
            'kuyruk': q,
            'tepe_kisi': int(s.max()),
            'tepe_saat': tepe['interval'] if tepe is not None else '—',
            'ort_kisi_saat_gun': round(
                out.groupby('data_date')[f"plan_{q}"].sum().mean() / 2),
            'mesai_payi_%': round(out[f"mesai_{q}"].sum() / s.sum() * 100, 1)
                            if s.sum() else 0.0,
        })
    ozet = pd.DataFrame(satirlar)
    show(ozet)

    bos = out.groupby('data_date')[[f"plan_{q}" for q in QUEUES]].sum().sum(axis=1)
    if (bos == 0).any():
        gunler = ', '.join(bos[bos == 0].index.strftime('%d.%m'))
        print(f"  ⚠ planda hiç kişi olmayan günler: {gunler}")
    return ozet


# ---------------------------------------------------------------------------
# MODEL TARAFI — {data_date, kuyruk, vardiya, kisi, company}
# ---------------------------------------------------------------------------

def build_model_coverage(df_model, year=2026, month=8, model_cols=None,
                         company='inhouse', verbose=True):
    """Modelin vardiya bazlı kişi sayılarını slot ızgarasına açar.

    Plan tarafıyla AYNI shift_slots parser'ını kullanır — iki taraf arasında
    vardiya→slot yöntem farkı oluşmaz.

    Çıktı: data_date, interval, model_kitle, model_kurumsal, model_gold
    """
    cols = {**DEFAULT_MODEL_COLS, **(model_cols or {})}
    resolved = {k: _resolve_col(df_model, v) for k, v in cols.items()}

    zorunlu = ['date', 'queue', 'shift', 'kisi']
    eksik = [cols[k] for k in zorunlu if resolved[k] is None]
    if eksik:
        raise KeyError(f"MODEL: şu kolon(lar) yok: {eksik}  |  "
                       f"mevcut: {list(df_model.columns)}")

    df = df_model.copy()
    df['data_date'] = _to_date_series(df[resolved['date']]).dt.normalize()
    df['queue'] = _normalize_queue(df[resolved['queue']])
    df['kisi'] = pd.to_numeric(df[resolved['kisi']], errors='coerce').fillna(0)

    # Company filtresi
    if company and resolved['company'] is not None:
        c = df[resolved['company']].astype(str).str.strip().str.lower()
        n0 = len(df)
        df = df[c == str(company).lower()]
        if verbose and len(df) < n0:
            print(f"  ℹ MODEL: company='{company}' filtresi — "
                  f"{n0 - len(df):,} satır elendi ({len(df):,} kaldı).")
    elif company and verbose:
        print(f"  ℹ MODEL: company kolonu yok, filtre uygulanmadı.")

    n0 = len(df)
    df = df[(df['data_date'].dt.year == year) & (df['data_date'].dt.month == month)]
    if verbose and len(df) < n0:
        print(f"  ℹ MODEL: {n0 - len(df):,} satır {year}/{month:02d} dışında, elendi.")

    bilinmeyen = df[df['queue'].isna()][resolved['queue']].dropna().unique()
    if len(bilinmeyen):
        print(f"  ⚠ MODEL: tanınmayan kuyruk değerleri elendi: {list(bilinmeyen)[:10]}")
    df = df[df['queue'].notna()]

    slot_map = {v: shift_slots(v) for v in df[resolved['shift']].astype(str).unique()}
    cozulmeyen = [v for v, s in slot_map.items() if not s]
    if cozulmeyen:
        print(f"  ⚠ MODEL: vardiya olarak okunamayan {len(cozulmeyen)} değer "
              f"(kapsamaya girmedi): {cozulmeyen[:8]}")

    df['slot_30'] = df[resolved['shift']].astype(str).map(slot_map)
    df = df.explode('slot_30').dropna(subset=['slot_30'])

    model = (df.groupby(['data_date', 'slot_30', 'queue'])['kisi']
               .sum().rename('kisi').reset_index())

    first = pd.Timestamp(year=year, month=month, day=1)
    all_days = pd.date_range(first, first + pd.offsets.MonthEnd(1), freq='D')
    out = pd.MultiIndex.from_product(
        [all_days, SLOTS_30], names=['data_date', 'slot_30']).to_frame(index=False)

    for q in QUEUES:
        sub = model[model['queue'] == q][['data_date', 'slot_30', 'kisi']]
        out = out.merge(sub.rename(columns={'kisi': f"model_{q}"}),
                        on=['data_date', 'slot_30'], how='left')

    value_cols = [f"model_{q}" for q in QUEUES]
    out[value_cols] = out[value_cols].fillna(0).round().astype(int)
    out['interval'] = out['slot_30']
    out = out.sort_values(['data_date', 'slot_30']).reset_index(drop=True)
    out = out[['data_date', 'interval'] + value_cols]

    if verbose:
        print("MODEL kapsama — tepe kişi: " +
              '  '.join(f"{q}={int(out[f'model_{q}'].max())}" for q in QUEUES))
    return out


# ---------------------------------------------------------------------------
# KARŞILAŞTIRMA
# ---------------------------------------------------------------------------

def compare_plan_vs_model(df_plan_cov, df_model_cov, verbose=True):
    """Slot bazında model ↔ plan karşılaştırması.

    Çıktı: data_date, interval, her kuyruk için model_{q}, plan_{q}, fark_{q}
    (fark = plan - model; eksi ise modelin dediğinden az kişi konmuş)
    """
    df = df_model_cov.merge(df_plan_cov, on=['data_date', 'interval'], how='outer')

    cols = ['data_date', 'interval']
    for q in QUEUES:
        for c in (f"model_{q}", f"plan_{q}", f"mesai_{q}"):
            if c not in df.columns:
                df[c] = 0
        df[[f"model_{q}", f"plan_{q}", f"mesai_{q}"]] = \
            df[[f"model_{q}", f"plan_{q}", f"mesai_{q}"]].fillna(0).astype(int)
        df[f"fark_{q}"] = df[f"plan_{q}"] - df[f"model_{q}"]
        cols += [f"model_{q}", f"plan_{q}", f"fark_{q}"]

    df = df.sort_values(['data_date', 'interval'])[cols].reset_index(drop=True)
    if verbose:
        _print_compare_summary(df)
    return df


def _print_compare_summary(df):
    print("MODEL ↔ PLAN  (fark = plan - model  |  eksik/fazla slot: modelin kişi "
          "istediği slotlarda)")
    satirlar = []
    for q in QUEUES:
        mo, pl, fa = df[f"model_{q}"], df[f"plan_{q}"], df[f"fark_{q}"]
        aktif = mo > 0
        satirlar.append({
            'kuyruk': q,
            'model_kisi_slot': int(mo.sum()),
            'plan_kisi_slot': int(pl.sum()),
            'fark': int(fa.sum()),
            'eksik_slot': int((fa[aktif] < 0).sum()),
            'fazla_slot': int((fa[aktif] > 0).sum()),
        })
    ozet = pd.DataFrame(satirlar)
    show(ozet)
    return ozet


def summarize_by_interval(df_cmp_plan):
    """Saat bazında ortalama: hangi slotlarda sistematik eksik/fazla var."""
    cols = [c for q in QUEUES for c in (f"model_{q}", f"plan_{q}", f"fark_{q}")]
    out = df_cmp_plan.groupby('interval')[cols].mean().round(1)
    return out.reset_index()


# %% [HÜCRE 2] — KULLANIM

YEAR = 2026
MONTH = 8

if 'df_plan' in globals():
    df_plan_cov = build_plan_coverage(df_plan, year=YEAR, month=MONTH)
    show(df_plan_cov, 10)
else:
    print("df_plan bulunamadı — vardiya planı tablosunu getirip bu hücreyi çalıştır.")


# %% [HÜCRE 3] — MODEL KAPSAMASI + KARŞILAŞTIRMA
# df_model: data_date, kuyruk, vardiya, kisi, company  (inhouse)

if 'df_model' in globals() and 'df_plan_cov' in globals():
    df_model_cov = build_model_coverage(df_model, year=YEAR, month=MONTH,
                                        company='inhouse')
    df_cmp_plan = compare_plan_vs_model(df_plan_cov, df_model_cov)
    show(df_cmp_plan, 10)
else:
    print("df_model veya df_plan_cov yok — önce HÜCRE 2'yi ve model tablosunu hazırla.")


# %% [HÜCRE 4] — SAAT BAZINDA ORTALAMA (sistematik eksik/fazla)

if 'df_cmp_plan' in globals():
    show(summarize_by_interval(df_cmp_plan))
else:
    print("df_cmp_plan yok — önce HÜCRE 3'ü çalıştır.")
