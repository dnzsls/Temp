        print(f"    {_t:>7} {_s1:>6} {_s2:>8} {_s3:>9} {_z:>12} {_s1 + _s2 - _z:>+6}")
    print(f"    * serbest = o tipe GİREBİLİR (tek tipe sayılmaz, birden çok tipte")
    print(f"      görünür). SADECE o hafta değişkeni OLAN serbest agentları sayar →")
    print(f"      yukarıdaki 'o hafta MEVCUT' ({len(_serbest_var)}) ile aynı havuz.")
    # gece sert bandı — çözümsüzlük buradan gelir
