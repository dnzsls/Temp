# ===== SUNUM SAYILARI — MODEL 1 (mevcut pickle'dan, re-run YOK) =====
import pickle
QUEUE    = "kitle"
PKL_PATH = "monthly_v9_forecast_2026_08.pkl"   # results bellekte yoksa buradan yükler

try:
    results                                      # monthly run notebook'unda zaten varsa kullan
except NameError:
    with open(PKL_PATH, "rb") as f:
        results = pickle.load(f)

# 0) YAPI KONTROLÜ — alan adları tutuyor mu?
_g0 = next((g for g in sorted(results) if (results.get(g) or {}).get(QUEUE)), None)
_mi0 = results[_g0][QUEUE].get("mip_info", {}) if _g0 else {}
print("örnek gün:", _g0, "| mip_info anahtarları:", list(_mi0.keys()))

def _get(mi, *keys):
    for k in keys:
        if mi.get(k) is not None:
            return mi[k]
    return None

# 1) AYLIK ÖZET
gun_rr, W = [], 0
top_short = top_surp = 0
en_yogun = None                                  # (erlang, gün, slot, çağrı, atanan)
plani = 0
for g in sorted(results):
    rq = (results.get(g) or {}).get(QUEUE)
    if not rq:
        continue
    mi = rq.get("mip_info", {})
    erl_by  = _get(mi, "erlang_by_slot") or rq.get("erlang_by_slot") or {}
    mip_by  = mi.get("mip_by_slot", {}) or {}
    calls_by = rq.get("calls_by_slot", {}) or {}
    if not erl_by:
        continue
    plani += 1
    top_short += int(_get(mi, "total_shortfall", "shortfall_total") or 0)
    top_surp  += int(_get(mi, "surplus_total_added", "surplus_total") or 0)
    rr_vals, wv = [], []
    for slot, erl in erl_by.items():
        if erl <= 0:
            continue
        mip = mip_by.get(slot, 0)
        rr_vals.append(mip / erl); wv.append(erl)
        if en_yogun is None or erl > en_yogun[0]:
            en_yogun = (erl, g, slot, int(calls_by.get(slot, 0)), mip)
    if wv:
        gr = sum(r*x for r, x in zip(rr_vals, wv)) / sum(wv)
        gun_rr.append(gr * sum(wv)); W += sum(wv)

print(f"\n=== MODEL 1 — SUNUM SAYILARI ({QUEUE}) ===")
print(f"planı olan gün         : {plani}")
if W:
    print(f"AYLIK ort karşılama RR : %{sum(gun_rr)/W*100:.0f}  (Erlang-ağırlıklı; %100=tam)")
print(f"toplam AÇIK (shortfall): {top_short} kişi-gün")
print(f"toplam FAZLA (surplus) : {top_surp} kişi-gün")
if en_yogun:
    e, g, sl, ca, mp = en_yogun
    print(f"ayın en yoğun dilimi   : {g} {sl} → çağrı {ca}, Erlang {e}, atanan {mp}, rr %{mp/e*100:.0f}")
