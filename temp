import difflib

_model  = set(df_tam["takim"])
_gecmis = set(df_gecmis["takim"])
print(f"model: {len(_model)} takım  |  df_gecmis: {len(_gecmis)}  |  "
      f"EŞLEŞEN: {len(_model & _gecmis)}")

# 1) modelde var, geçmişte yok → bu takımlar cezasız kalır (asıl risk bu)
_yok = sorted(_model - _gecmis)
print(f"\n⚠ df_gecmis'te BULUNAMAYAN {len(_yok)} takım:")
for t in _yok:
    _y = difflib.get_close_matches(t, _gecmis, n=1, cutoff=0.6)
    print(f"  {t}" + (f"\n      ← olası yazım hatası: {_y[0]}" if _y else "   (yakın eşleşme yok)"))

# 2) geçmişte var, modelde yok → eski/başka kuyruk olabilir, zararsız
_fazla = sorted(_gecmis - _model)
print(f"\nmodelde OLMAYAN {len(_fazla)} takım (bilgi amaçlı):")
for t in _fazla[:15]:
    print(f"  {t}")

# 3) anahtar iki parçadan kuruluyor → hangi parçada tutmadığını ayrı gör
for _kol in ("teamleader_name", "working_main_group"):
    _m = set(df_tam[_kol].astype(str).str.strip())
    _g = set(df_gecmis[_kol].astype(str).str.strip())
    print(f"\n{_kol}: model {len(_m)} | geçmiş {len(_g)} | eşleşen {len(_m & _g)}")
    _f = sorted(_m - _g)
    if _f:
        print(f"  geçmişte yok ({len(_f)}): {_f[:10]}")
