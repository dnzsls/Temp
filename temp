# mesai olurdu ve hafta içi off gerekmezdi.
_cift32, _ayri32 = 0, 0
_cift_ornek = []
for a in _m32_uygun:
    _hs_cal = [c for c in _hs_kol32 if roster.at[a, c] not in _OFF_LIKE]
    if len(_hs_cal) < 2:
        continue
    # aynı hafta sonu = ardışık Cmt+Pzr (ISO hafta aynı)
    _wk = _Counter22(dt.date.fromisoformat(c).isocalendar()[:2] for c in _hs_cal)
    if max(_wk.values()) >= 2:
        _cift32 += 1
        if _m32[a] < MESAI_HEDEF and len(_cift_ornek) < 8:
            _cift_ornek.append((a, _m32[a], _hs_cal))
    else:
        _ayri32 += 1

print(f"\n[4] HAFTA SONU YERLEŞİMİ  (≥2 hafta sonu günü çalışan agentlar)")
print(f"    aynı hafta sonunda Cmt+Pzr : {_cift32:>5}  → o hafta H12 gereği "
      f"hafta içi off ZORUNLU")
print(f"    farklı hafta sonlarına dağılmış: {_ayri32:>5}  → hafta içi off gerekmez")
if _cift32:
    print(f"    Cmt+Pzr birlikte VE mesai < {MESAI_HEDEF} olan örnekler:")
    for a, _m, _hs in _cift_ornek:
        print(f"       {a}  mesai {_m}  hafta sonu günleri: {_hs}")
    print(f"    → bu desendekiler için çare off cezası DEĞİL, hafta sonu günlerini")
    print(f"      farklı hafta sonlarına dağıtmak (yeni bir kural gerektirir).")
print("=" * 78)
