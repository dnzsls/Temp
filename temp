# ── GÜN BAZINDA ETİKET: hangi hafta sonu günü NORM (yeşil), hangisi MESAİ (sarı) ──
# TOPLAM sayı ay bazlı (_norm_say) — ama DAĞITIM hafta önceliklidir:
#   1) AYNI HAFTA takası önce: o hafta hafta içi off'u varsa, o haftanın hafta sonu
#      günü NORM sayılır ("Cuma off ↔ Cumartesi çalışma" göz önünde eşleşsin).
#   2) Artan norm hakkı (borç BAŞKA haftada kapanmış) sondan geriye dağıtılır.
# Sadece "sondan N tane" seçmek görsel olarak karıştırıyordu: aynı hafta içinde
# offu olup hafta sonu çalışan gün MESAİ, norm ise alakasız bir haftada çıkıyordu.
# Sağlama: Σ_hafta min(o hafta hafta sonu, o hafta hafta içi eksiği) ≤ ay normu
# (çünkü ay eksiği = Σ hafta eksiği) → 1. adım toplamı asla aşamaz.
_hafta_kolon = {}                                  # (yıl,hafta) → {"wd": [...], "we": [...]}
for c in _gun:
    d = dt.date.fromisoformat(c)
    if d in TATIL:
        continue                                   # resmi tatil ikisinin de dışında
    wk = d.isocalendar()[:2]
    _hafta_kolon.setdefault(wk, {"wd": [], "we": []})
    _hafta_kolon[wk]["we" if d.weekday() >= 5 else "wd"].append(c)
_hs_kolon = sorted(c for c in _gun                 # tatil-dışı hafta sonu kolonları, kronolojik
                   if dt.date.fromisoformat(c).weekday() >= 5
                   and dt.date.fromisoformat(c) not in TATIL)


def _norm_gunleri(a):
    """(NORM günleri, TELAFİ günleri) — ikisi de kotaya sayılır, ücretli mesai DEĞİL.
    NORM   = AYNI HAFTA takası (o haftanın hafta içi off'unun karşılığı)
    TELAFİ = BAŞKA HAFTADAKİ fazla off'un telafisi (aynı haftada karşılığı yok)
    """
    kalan = _norm_say.get(a, 0)
    if not kalan:
        return set(), set()
    ayni = []
    for wk in sorted(_hafta_kolon):                # 1) aynı hafta takası → NORM
        h = _hafta_kolon[wk]
        T = sum(1 for c in h["wd"] if roster.at[a, c] != "izin")        # kotaya giren hafta içi gün
        W = sum(1 for c in h["wd"] if roster.at[a, c] not in _OFF_LIKE)  # o hafta çalışılan hafta içi
        we = [c for c in h["we"] if roster.at[a, c] not in _OFF_LIKE]
        eksik = max(0, T - W)                       # o haftanın hafta içi açığı
        if wk == SINIR_HAFTA:                       # sınır haftasının hafta içi günleri ÖNCEKİ AYDA →
            eksik += _kredi_say.get(a, 0)           #   açık oradan gelir (H8C alacağı)
        k = min(len(we), eksik)                     # o haftaki eksiği kapatan hafta sonu günü
        if k:
            ayni += we[-k:]
    ayni = ayni[:kalan]                             # güvenlik (teorik olarak zaten ≤ kalan)
    telafi = []
    if len(ayni) < kalan:                           # 2) borç BAŞKA haftada kapanmış → TELAFİ
        _sec = set(ayni)
        artan = [c for c in _hs_kolon
                 if roster.at[a, c] not in _OFF_LIKE and c not in _sec]
        telafi = artan[-(kalan - len(ayni)):]
    return set(ayni), set(telafi)


_norm_hucre, _telafi_hucre = set(), set()          # (agent, gün) → NORM (yeşil) / TELAFİ (açık yeşil)
for _a in roster_2.index:
    _n, _t = _norm_gunleri(_a)
    _norm_hucre |= {(_a, c) for c in _n}
    _telafi_hucre |= {(_a, c) for c in _t}
# calisma_gun = toplam − mesai − resmi_tatil (normal + arife + norm; overtime ve tatil hariç)
roster_2["calisma_gun"]     = [int(_cal_top[a]) - _mn[a][0] - _mn[a][2] for a in roster_2.index]
roster_2["mesai_gun"]       = [_mn[a][0] for a in roster_2.index]     # resmi tatil HARİÇ
roster_2["norm_gun"]        = [_mn[a][1] for a in roster_2.index]
roster_2["resmi_tatil_gun"] = [_mn[a][2] for a in roster_2.index]     # resmi tatilde çalışma
roster_2["off_gun"]         = [int(_off[a]) for a in roster_2.index]

# OFF/İZİN KIRILIMI — dört kolon, HER BİRİ AYRIK (üst üste binmiyor):
#   off_gun          = SADECE modelin verdiği off (talep edilmemiş)
#   izin_gun         = yıllık/idari izin (kotayı DÜŞÜRÜR, model değiştiremez)
#   off_t2_gun       = SERT off talebi — bloklu, her zaman karşılanır
#   off_t_gun        = YUMUŞAK off talebi, KARŞILANAN (o gün off verildi)
