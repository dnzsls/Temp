def compare_plan_vs_model(df_plan_cov, df_model_cov, verbose=True):
    """Slot bazında model ↔ plan karşılaştırması.

    Çıktı: data_date, interval, her kuyruk için model_{q}, plan_{q}, fark_{q}
    (fark = plan - model; eksi ise modelin dediğinden az kişi konmuş)
    """
    df = df_model_cov.merge(df_plan_cov, on=['data_date', 'interval'], how='outer')

    cols = ['data_date', 'interval']
    for q in QUEUES:
        for c in (f"model_{q}", f"plan_{q}", f"mesai_{q}"):
            if c not in df.columns:
                df[c] = 0
        df[[f"model_{q}", f"plan_{q}", f"mesai_{q}"]] = \
            df[[f"model_{q}", f"plan_{q}", f"mesai_{q}"]].fillna(0).astype(int)
        df[f"fark_{q}"] = df[f"plan_{q}"] - df[f"model_{q}"]
        cols += [f"model_{q}", f"plan_{q}", f"fark_{q}"]

    df = df.sort_values(['data_date', 'interval'])[cols].reset_index(drop=True)
    if verbose:
        _print_compare_summary(df)
    return df


def _print_compare_summary(df):
    print("MODEL ↔ PLAN  (fark = plan - model  |  eksik/fazla slot: modelin kişi "
          "istediği slotlarda)")
    satirlar = []
    for q in QUEUES:
        mo, pl, fa = df[f"model_{q}"], df[f"plan_{q}"], df[f"fark_{q}"]
        aktif = mo > 0
        satirlar.append({
            'kuyruk': q,
            'model_kisi_slot': int(mo.sum()),
            'plan_kisi_slot': int(pl.sum()),
            'fark': int(fa.sum()),
            'eksik_slot': int((fa[aktif] < 0).sum()),
            'fazla_slot': int((fa[aktif] > 0).sum()),
        })
    ozet = pd.DataFrame(satirlar)
    show(ozet)
    return ozet


def summarize_by_interval(df_cmp_plan):
    """Saat bazında ortalama: hangi slotlarda sistematik eksik/fazla var."""
    cols = [c for q in QUEUES for c in (f"model_{q}", f"plan_{q}", f"fark_{q}")]
    out = df_cmp_plan.groupby('interval')[cols].mean().round(1)
    return out.reset_index()


