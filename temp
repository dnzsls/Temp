    peak_slots = {s for s, e in erlang_by_slot.items() if e >= max_e * peak_thr}

    print(f"\n📋 SLOT BAZLI  * = peak")
    print(f"   {'Slot':<7} {'AHT':>5} {'Erlang':>7} {'MIP':>7} {'In':>5} {'Out':>5} {'RR':>6} {'E.F':>5}")
    print(f"   {'-'*50}")
    for slot in SLOTS_30:
