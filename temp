def gercek_ihtiyac(df_actual, year, month, df_aht=None, queue='kitle', verbose=True):
    """Gerçek çağrı → gün × slot gereken kişi (v10 formülü, gün tipi shrinkage).

    AHT: df_aht + resource_group_key → slotun alt kuyruk çağrı payıyla ağırlıklı
         df_aht (alt kuyruk yok)      → saatlik basit ortalama
         df_aht yok                   → DEFAULT_AHT
    """
    c = actual_calls_30(df_actual, year=year, month=month, queue=queue, verbose=False)
    c = c.rename(columns={f'actual_{queue}': 'cagri_gercek'})
    if df_aht is not None and _resolve_col(df_actual, DEFAULT_SQ_COLS['sub_queue']):
        c = c.merge(aht_slot_bazli(df_actual, df_aht, queue=queue, verbose=False),
                    on=['data_date', 'interval'], how='left')
        kaynak = 'df_aht · alt kuyruk çağrı ağırlıklı'
    elif df_aht is not None:
        saatlik = aht_saatlik(df_aht, queue=queue, verbose=False)
        c['aht'] = c['interval'].str[:2].astype(int).map(saatlik)
        kaynak = 'df_aht · saatlik basit ortalama (alt kuyruk kırılımı yok)'
    else:
        c['aht'] = np.nan
        kaynak = f'df_aht YOK → sabit {DEFAULT_AHT} sn'
    c['aht'] = pd.to_numeric(c['aht'], errors='coerce')
    gecerli = (c['cagri_gercek'] > 0) & (c['aht'] > 0)
    eksik = (c['cagri_gercek'] > 0) & ~gecerli
    if eksik.any():
        ort = (float((c.loc[gecerli, 'aht'] * c.loc[gecerli, 'cagri_gercek']).sum()
                     / c.loc[gecerli, 'cagri_gercek'].sum()) if gecerli.any() else DEFAULT_AHT)
        c.loc[eksik, 'aht'] = ort
        if verbose and gecerli.any():
            print(f"  ⚠ çağrısı olup AHT'si olmayan {int(eksik.sum()):,} slot → "
                  f"ağırlıklı ortalama {ort:.0f} sn")

    onbellek = {}
    def _g(cg, a, sl, d):
        gt = gun_tipi(d)
        key = (cg, round(a, 1), sl, gt)
        if key not in onbellek:
            onbellek[key] = ihtiyac_v10(cg, a, sl, SHRINKAGE_V10[gt])
        return onbellek[key]
    c['gereken_gercek'] = [_g(float(cg), float(a) if a == a else 0.0, sl, d) for cg, a, sl, d
                           in zip(c['cagri_gercek'], c['aht'], c['interval'], c['data_date'])]
    c = c.rename(columns={'aht': 'aht_gercek'})
    if verbose:
        print(f"GERÇEKLEŞEN — {c['data_date'].nunique()} gün  |  çağrı "
              f"{c['cagri_gercek'].sum():,.0f}  |  AHT: {kaynak}")
    return c[['data_date', 'interval', 'cagri_gercek', 'aht_gercek', 'gereken_gercek']]


def plan_dogrulama(m1, verbose=True):
    """Pickle'daki planlanan ihtiyaç, bu dosyadaki formül + SHRINKAGE_V10 ile
    yeniden üretilebiliyor mu? (AHT pickle'da sadece hafta sonu var.)
    Tutuyorsa plan ile gerçek AYNI hesapla kıyaslanıyor demektir."""
    d = m1[m1['aht_model'].notna() & (m1['cagri_tahmin'] > 0)].copy()
    if d.empty:
        if verbose:
            print("  ℹ doğrulama yapılamadı — pickle'da AHT (weighted_aht_by_slot) yok.")
        return None
    d['yeniden'] = [ihtiyac_v10(c, a, sl, SHRINKAGE_V10[gun_tipi(t)]) for c, a, sl, t
                    in zip(d['cagri_tahmin'], d['aht_model'], d['interval'], d['data_date'])]
    tutan = int((d['yeniden'] == d['gereken_plan']).sum())
    oran = tutan / len(d)
    if verbose:
        isaret = '✓' if oran >= 0.99 else '⚠'
        print(f"  {isaret} planlanan ihtiyaç doğrulaması: {tutan:,}/{len(d):,} slot "
              f"(%{100 * oran:.1f}) aynı formülle yeniden üretildi "
              f"({d['data_date'].nunique()} hafta sonu günü)")
        if oran < 0.99:
            print("    → SHRINKAGE_V10 ya da formül modelin config'iyle uyuşmuyor; "
                  "plan/gerçek farkına shrinkage farkı karışıyor. İlk sapmalar:")
            show(d[d['yeniden'] != d['gereken_plan']][
                ['data_date', 'interval', 'cagri_tahmin', 'aht_model',
                 'gereken_plan', 'yeniden']].head(5))
    return oran


