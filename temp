# =============================================================================
# AYLIK GENEL BAKIŞ — kapasite / vardiya başlangıcı / çağrı  (30 DK)
# =============================================================================
# Sunum görselleri için. Karşılaştırma akışından BAĞIMSIZ, sadece iki girdi:
#
#   df_actual  — gerçekleşen çağrı (uzun format)
#       data_date, min_time_period_value, line_based_main_group,
#       resource_group_key, nof_call
#     (geniş format da olur: data_date, min_time_period_value, kitle_nof_call…)
#
#   df_vardiya — vardiya planı, INHOUSE + OUTSOURCE BİR ARADA
#       DATA_DATE, VARDIYA ('09:00-18:00'), WORKING_MAIN_GROUP, KISI_SAYISI
#     'outsource' geçen grup → outsource, gerisi (izmir_kitle…) → inhouse
#
# İKİ FARKLI ÖLÇÜ — karıştırma:
#   SLOT KAPASİTESİ  = o slotta telefonda KAÇ KİŞİ VAR (vardiya boyunca sayılır)
#   VARDİYA BAŞLANGICI = o slotta KAÇ KİŞİ İŞE BAŞLIYOR (sadece başlangıç slotu)
# =============================================================================

# %% [HÜCRE 1] — FONKSİYONLAR

import datetime as _dt
import os
import pickle
import re

import pandas as pd

try:
    from IPython.display import display as _display
except ImportError:                     # pragma: no cover
    _display = None


def show(df, n=None):
    x = df.head(n) if n else df
    if _display is not None:
        _display(x)
    else:
        print(x.to_string(index=False))
    return x


SLOTS_30 = [f"{h:02d}:{m}" for h in range(24) for m in ('00', '30')]
SLOT_IDX = {s: i for i, s in enumerate(SLOTS_30)}
GUN_TR = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz']

_SHIFT_RE = re.compile(r'(\d{1,2})[:.](\d{2})\s*[-–—]\s*(\d{1,2})[:.](\d{2})')


def _resolve_col(df, spec):
    cands = [spec] if isinstance(spec, str) else list(spec)
    for c in cands:
        if c in df.columns:
            return c
    lower = {str(c).lower(): c for c in df.columns}
    for c in cands:
        if str(c).lower() in lower:
            return lower[str(c).lower()]
    return None


def _to_date_series(s):
    if pd.api.types.is_datetime64_any_dtype(s):
        return pd.to_datetime(s)
    ornek = s.dropna().astype(str)
    iso = bool(len(ornek)) and ornek.str.match(r'^\d{4}-\d{2}-\d{2}').all()
    return pd.to_datetime(s, dayfirst=not iso)


def _to_slot_30(value):
    """'10:45' / time / timedelta / timestamp → '10:30'."""
    if isinstance(value, (pd.Timedelta, _dt.timedelta)):
        tm = int(pd.Timedelta(value).total_seconds() // 60) % (24 * 60)
        h, m = divmod(tm, 60)
        return f"{h:02d}:{(m // 30) * 30:02d}"
    if isinstance(value, (_dt.datetime, pd.Timestamp, _dt.time)):
        return f"{value.hour:02d}:{(value.minute // 30) * 30:02d}"
    m = re.search(r'(\d{1,2}):(\d{2})', str(value).strip())
    if not m:
        raise ValueError(f"Saat çözümlenemedi: {value!r}")
    return f"{int(m.group(1)) % 24:02d}:{(int(m.group(2)) // 30) * 30:02d}"


def shift_slots(text):
    """'08:00-17:00' → kapsadığı 30dk slotlar (geceyi aşan dahil)."""
    m = _SHIFT_RE.search(str(text))
    if not m:
        return []
    sh, sm, eh, em = (int(g) for g in m.groups())
    bas = f"{sh % 24:02d}:{(sm // 30) * 30:02d}"
    son = (eh % 24) * 2 + (em // 30)
    if eh == 24 or (eh % 24) * 60 + em == 0:
        son = len(SLOTS_30)
    i, j = SLOT_IDX[bas], son
    if j <= i:
        j += len(SLOTS_30)
    return [SLOTS_30[k % len(SLOTS_30)] for k in range(i, j)]


def shift_slots_ofset(text, ek_slot=0):
    """'22:00-06:00' → [(0,'22:00'),…,(1,'00:00'),…,(1,'05:30')].

    Gece yarısını aşan kısım gün ofseti 1 ile işaretlenir.
    ek_slot: bitişe eklenecek 30dk'lık slot sayısı (outsource +30 dk için 1).
    """
    m = _SHIFT_RE.search(str(text))
    if not m:
        return []
    sh, sm, eh, em = (int(g) for g in m.groups())
    bas = f"{sh % 24:02d}:{(sm // 30) * 30:02d}"
    son = (eh % 24) * 2 + (em // 30)
    if eh == 24 or (eh % 24) * 60 + em == 0:
        son = len(SLOTS_30)
    i, j = SLOT_IDX[bas], son
    if j <= i:
        j += len(SLOTS_30)
    j += int(ek_slot)
    return [(k // len(SLOTS_30), SLOTS_30[k % len(SLOTS_30)]) for k in range(i, j)]


def gece_asan_vardiyalar(df_vardiya, cols=None):
    """Gece yarısını aşan vardiya değerlerini listeler (teşhis için)."""
    c = {**VARDIYA_KOL, **(cols or {})}
    v_col = _resolve_col(df_vardiya, c['shift'])
    d = pd.DataFrame({'vardiya': df_vardiya[v_col].astype(str).unique()})
    d['asiyor'] = d['vardiya'].map(lambda v: any(o for o, _ in shift_slots_ofset(v)))
    d['slot_in'] = d['vardiya'].map(lambda v: len(shift_slots_ofset(v)))
    d['slot_out'] = d['vardiya'].map(
        lambda v: len(shift_slots_ofset(v, OUTSOURCE_EK_SLOT)) if shift_slots_ofset(v) else 0)
    return d.sort_values(['asiyor', 'vardiya'], ascending=[False, True]).reset_index(drop=True)


def shift_baslangic(text):
    """'08:00-17:00' → '08:00' (başlangıç slotu); okunamazsa None."""
    m = _SHIFT_RE.search(str(text))
    if not m:
        return None
    sh, sm = int(m.group(1)), int(m.group(2))
    return f"{sh % 24:02d}:{(sm // 30) * 30:02d}"


VARDIYA_KOL = {
    'date':  ['data_date', 'date', 'tarih'],
    'shift': ['vardiya', 'shift', 'saat'],
    'group': ['working_main_group', 'company', 'line_based_main_group', 'sirket'],
    'kisi':  ['kisi_sayisi', 'kisi', 'count', 'adet'],
}

ACTUAL_KOL = {
    'date':  ['data_date', 'date', 'tarih'],
    'time':  ['min_time_period_value', 'interval', 'saat_dilimi'],
    'group': ['line_based_main_group'],
    'calls': ['nof_call', 'calls', 'cagri'],
}


OUTSOURCE_EK_SLOT = 1        # outsource inhouse'dan 30 dk fazla çalışıyor

# (şirket_adı, kolon_soneki) — kapasite_in / kapasite_out / kapasite_pt
SIRKETLER = (('inhouse', 'in'), ('outsource', 'out'), ('part_time', 'pt'))
OLCU_KOL = [f"{o}_{s}" for o in ('kapasite', 'baslangic')
            for s in ('in', 'out', 'pt', 'toplam')]

# Kısmi (part-time) vardiya etiketleri. PLAN tarafında hafta içi HARİÇ tutulur,
# hafta sonu DAHİL edilir. Kendi listeni buraya yaz ya da fonksiyona parametre
# olarak geç. SQL'de zaten filtreliyorsan boş bırak.
KISMI_VARDIYALAR = []


def _vardiya_anahtar(v):
    """'08:00 - 12:00' ve '08:00-12:00' aynı sayılsın diye normalize eder."""
    m = _SHIFT_RE.search(str(v))
    if not m:
        return re.sub(r'\s+', '', str(v)).lower()
    sh, sm, eh, em = (int(g) for g in m.groups())
    return f"{sh:02d}:{sm:02d}-{eh:02d}:{em:02d}"


def _company(s):
    """'outsource' geçen → outsource, gerisi inhouse."""
    v = s.astype(str).str.strip().str.lower()
    return v.map(lambda x: 'outsource' if 'outsource' in x else 'inhouse')


def vardiya_listesi(df_vardiya, cols=None):
    """Hangi vardiya değerleri var, hafta içi/sonu kaç kişi — kısmi listesini
    yazarken buna bak."""
    c = {**VARDIYA_KOL, **(cols or {})}
    r = {k: _resolve_col(df_vardiya, v) for k, v in c.items()}
    d = df_vardiya.copy()
    d['vardiya'] = d[r['shift']].astype(str)
    d['company'] = _company(d[r['group']])
    d['kisi'] = pd.to_numeric(d[r['kisi']], errors='coerce').fillna(0)
    d['hafta_sonu'] = _to_date_series(d[r['date']]).dt.weekday >= 5
    g = d.pivot_table(index=['vardiya', 'company'], columns='hafta_sonu',
                      values='kisi', aggfunc='sum', fill_value=0).reset_index()
    g.columns = [{False: 'hafta_ici_kisi', True: 'hafta_sonu_kisi'}.get(x, x)
                 for x in g.columns]
    for k in ('hafta_ici_kisi', 'hafta_sonu_kisi'):
        if k not in g:
            g[k] = 0
    g['sure_slot'] = g['vardiya'].map(lambda v: len(shift_slots(v)))
    g['sure_saat'] = (g['sure_slot'] / 2).round(1)
    return g.sort_values('vardiya').reset_index(drop=True)


def vardiya_tablosu(df_vardiya, year, month, cols=None, gece_ertesi_gune=True,
                    outsource_ek_slot=OUTSOURCE_EK_SLOT,
                    kismi_vardiyalar=None, kismi_haftaici_haric=True,
                    verbose=True):
    """Vardiya planından İKİ tablo: slot kapasitesi + vardiya başlangıcı.

    gece_ertesi_gune:
      True (varsayılan) — '22:00-06:00' gibi geceyi aşan vardiyanın 00:00
            sonrası kısmı ERTESİ güne yazılır. Fiziksel gerçek budur.
      False — aşan kısım aynı güne yazılır (eski davranış; ayın 1'inin gecesi
            önceki aydan gelmediği için şişme yaratır).

    outsource_ek_slot: outsource vardiyalarının bitişine eklenecek 30dk'lık
      slot sayısı. Varsayılan 1 → outsource inhouse'dan 30 dk fazla çalışıyor
      ('09:00-18:00' outsource fiilen 09:00-18:30 sayılır). 0 = kapalı.
      Vardiya BAŞLANGICI bundan etkilenmez.

    kismi_vardiyalar: kısmi (part-time) vardiya etiketleri listesi.
      kismi_haftaici_haric=True (varsayılan) → bu vardiyalar HAFTA İÇİ
      günlerde hesaba katılmaz, HAFTA SONU dahil edilir. Hangi etiketlerin
      olduğunu görmek için vardiya_listesi(df_vardiya) çağır.

    NOT: Ayın 1'inin gece slotları için ÖNCEKİ AYIN SON GÜNÜ de df_vardiya'da
    olmalı. Yoksa uyarı basılır ve 1. günün gecesi eksik kalır.

    Çıktı: data_date, interval,
           kapasite_in, kapasite_out, kapasite_toplam,
           baslangic_in, baslangic_out, baslangic_toplam
    """
    c = {**VARDIYA_KOL, **(cols or {})}
    r = {k: _resolve_col(df_vardiya, v) for k, v in c.items()}
    eksik = [c[k] for k, v in r.items() if v is None]
    if eksik:
        raise KeyError(f"VARDİYA: kolon yok: {eksik}  |  "
                       f"mevcut: {list(df_vardiya.columns)}")

    d = df_vardiya.copy()
    d['data_date'] = _to_date_series(d[r['date']]).dt.normalize()
    d['company'] = _company(d[r['group']])
    d['kisi'] = pd.to_numeric(d[r['kisi']], errors='coerce').fillna(0)
    d['_vardiya'] = d[r['shift']].astype(str)

    kismi = list(kismi_vardiyalar if kismi_vardiyalar is not None else KISMI_VARDIYALAR)
    if kismi:
        norm = {_vardiya_anahtar(v) for v in kismi}
        kismi_mi = d['_vardiya'].map(_vardiya_anahtar).isin(norm)
        veri_anahtar = set(d['_vardiya'].map(_vardiya_anahtar))
        bulunmayan = [v for v in kismi if _vardiya_anahtar(v) not in veri_anahtar]
        if kismi_haftaici_haric:
            at = (d['data_date'].dt.weekday < 5) & kismi_mi
            if verbose:
                print(f"  ℹ kısmi vardiya: hafta içi {int(at.sum()):,} satır "
                      f"({int(d.loc[at, 'kisi'].sum()):,} kişi) çıkarıldı, "
                      f"hafta sonu korundu.")
            d = d[~at]
            kismi_mi = kismi_mi[~at]
        d.loc[kismi_mi, 'company'] = 'part_time'
        if verbose:
            print(f"  ℹ kalan kısmi satır 'part_time' olarak ayrıldı "
                  f"({int(d.loc[kismi_mi, 'kisi'].sum()):,} kişi).")
            if bulunmayan:
                print(f"  ⚠ listede olup veride bulunmayan etiket: {bulunmayan}")

    ay_bas = pd.Timestamp(year=year, month=month, day=1)
    ay_son = ay_bas + pd.offsets.MonthEnd(1)
    onceki = ay_bas - pd.Timedelta(days=1)
    gunler = pd.date_range(ay_bas, ay_son, freq='D')

    uniq = d['_vardiya'].unique()
    pair_map = {v: shift_slots_ofset(v) for v in uniq}
    pair_map_out = {v: (shift_slots_ofset(v, outsource_ek_slot) if pair_map[v] else [])
                    for v in uniq}
    bas_map = {v: shift_baslangic(v) for v in uniq}
    cozulmeyen = [v for v, s in pair_map.items() if not s]
    if cozulmeyen:
        print(f"  ⚠ VARDİYA: okunamayan {len(cozulmeyen)} değer (atlandı): "
              f"{cozulmeyen[:8]}")
    asan = [v for v in uniq if any(o for o, _ in pair_map[v])]
    if verbose and outsource_ek_slot:
        print(f"  ℹ outsource vardiyaları +{outsource_ek_slot * 30} dk uzun "
              f"sayılıyor (kapasite); başlangıç saatleri değişmiyor.")

    # KAPASİTE için önceki ayın son gününü de tut (geceye sarkanlar ayın 1'ine)
    alt_sinir = onceki if gece_ertesi_gune else ay_bas
    d_kap = d[(d['data_date'] >= alt_sinir) & (d['data_date'] <= ay_son)]
    d_ay = d[(d['data_date'] >= ay_bas) & (d['data_date'] <= ay_son)]
    if verbose and len(d) > len(d_kap):
        print(f"  ℹ VARDİYA: {len(d) - len(d_kap):,} satır kapsam dışında, elendi.")
    if verbose and asan:
        nasil = "ERTESİ güne" if gece_ertesi_gune else "AYNI güne"
        print(f"  ℹ geceyi aşan {len(asan)} vardiya {asan[:5]}: "
              f"00:00 sonrası slotlar {nasil} yazılıyor.")
        if gece_ertesi_gune and not (d['data_date'] == onceki).any():
            print(f"  ⚠ {onceki:%d.%m.%Y} (önceki ayın son günü) veride YOK → "
                  f"{ay_bas:%d.%m} gece slotları eksik kalacak. "
                  f"Sorguyu bir gün geriye çek.")

    out = pd.MultiIndex.from_product([gunler, SLOTS_30],
                                     names=['data_date', 'interval']).to_frame(index=False)

    # (1) SLOT KAPASİTESİ — vardiya boyunca her slota yazılır
    kaynak = d_kap if gece_ertesi_gune else d_ay
    k = kaynak.assign(_p=[(pair_map_out if c == 'outsource' else pair_map)[v]
                          for c, v in zip(kaynak['company'], kaynak['_vardiya'])])
    k = k.explode('_p').dropna(subset=['_p'])
    k['interval'] = k['_p'].map(lambda t: t[1])
    if gece_ertesi_gune:
        k['data_date'] = k['data_date'] + pd.to_timedelta(
            k['_p'].map(lambda t: t[0]), unit='D')
        k = k[(k['data_date'] >= ay_bas) & (k['data_date'] <= ay_son)]
    k = k.groupby(['data_date', 'interval', 'company'], as_index=False)['kisi'].sum()

    # (2) VARDİYA BAŞLANGICI — sadece başlangıç slotu, hep kendi gününde
    b = d_ay.assign(interval=d_ay['_vardiya'].map(bas_map)).dropna(subset=['interval'])
    b = b.groupby(['data_date', 'interval', 'company'], as_index=False)['kisi'].sum()

    for kaynak, onek in ((k, 'kapasite'), (b, 'baslangic')):
        for sirket, sonek in SIRKETLER:
            alt = kaynak[kaynak['company'] == sirket][['data_date', 'interval', 'kisi']]
            out = out.merge(alt.rename(columns={'kisi': f"{onek}_{sonek}"}),
                            on=['data_date', 'interval'], how='left')

    deger = [f"{o}_{s}" for o in ('kapasite', 'baslangic') for _, s in SIRKETLER]
    out[deger] = out[deger].fillna(0).round().astype(int)
    out['kapasite_toplam'] = out[[f"kapasite_{s}" for _, s in SIRKETLER]].sum(axis=1)
    out['baslangic_toplam'] = out[[f"baslangic_{s}" for _, s in SIRKETLER]].sum(axis=1)
    out = out.sort_values(['data_date', 'interval']).reset_index(drop=True)

    if verbose:
        print(f"VARDİYA — {d_ay['data_date'].nunique()}/{len(gunler)} gün  |  "
              f"tepe kapasite: inhouse {int(out['kapasite_in'].max())} "
              f"outsource {int(out['kapasite_out'].max())} "
              f"kısmi {int(out['kapasite_pt'].max())}  |  "
              f"tepe başlangıç: {int(out['baslangic_toplam'].max())} kişi")
    return out


def slot_kaynagi(df_vardiya, tarih, interval, cols=None, gece_ertesi_gune=True,
                 outsource_ek_slot=OUTSOURCE_EK_SLOT):
    """TEŞHİS: verilen gün+slotun kapasitesine HANGİ vardiya satırları giriyor.

    Örn: slot_kaynagi(df_vardiya, '2026-07-01', '00:00')
    """
    c = {**VARDIYA_KOL, **(cols or {})}
    r = {k: _resolve_col(df_vardiya, v) for k, v in c.items()}
    d = df_vardiya.copy()
    d['data_date'] = _to_date_series(d[r['date']]).dt.normalize()
    d['company'] = _company(d[r['group']])
    d['kisi'] = pd.to_numeric(d[r['kisi']], errors='coerce').fillna(0)
    d['_vardiya'] = d[r['shift']].astype(str)

    hedef = pd.Timestamp(tarih).normalize()
    kayit = []
    for v in d['_vardiya'].unique():
        for sirket, ek in (('inhouse', 0), ('outsource', outsource_ek_slot)):
            for ofset, slot in shift_slots_ofset(v, ek):
                if slot != interval:
                    continue
                kayit.append((v, sirket, ofset if gece_ertesi_gune else 0))
    if not kayit:
        return pd.DataFrame(columns=['kaynak_gun', 'vardiya', 'company', 'kisi'])

    parca = []
    for v, sirket, ofset in kayit:
        alt = d[(d['_vardiya'] == v) & (d['company'] == sirket)
                & (d['data_date'] == hedef - pd.Timedelta(days=ofset))]
        if len(alt):
            parca.append(alt.assign(gun_ofseti=ofset))
    if not parca:
        return pd.DataFrame(columns=['kaynak_gun', 'vardiya', 'company', 'kisi'])

    g = pd.concat(parca)
    g = g.groupby(['data_date', '_vardiya', 'company', 'gun_ofseti'],
                  as_index=False)['kisi'].sum()
    g = g.rename(columns={'data_date': 'kaynak_gun', '_vardiya': 'vardiya'})
    g = g.sort_values('kisi', ascending=False).reset_index(drop=True)
    print(f"{hedef:%d.%m.%Y} {interval} → toplam {int(g['kisi'].sum())} kişi "
          f"(inhouse {int(g[g.company=='inhouse']['kisi'].sum())} / "
          f"outsource {int(g[g.company=='outsource']['kisi'].sum())})")
    return g


def cagri_tablosu(df_actual, year, month, queue='kitle', cols=None, verbose=True):
    """Gerçekleşen çağrıyı 30dk'ya toplar → data_date, interval, cagri."""
    c = {**ACTUAL_KOL, **(cols or {})}
    d_col = _resolve_col(df_actual, c['date'])
    t_col = _resolve_col(df_actual, c['time'])
    g_col = _resolve_col(df_actual, c['group'])
    n_col = _resolve_col(df_actual, c['calls'])
    w_col = _resolve_col(df_actual, [f"{queue}_nof_call", f"{queue}_nof_col"])

    if d_col is None or t_col is None:
        raise KeyError(f"ACTUAL: tarih/saat kolonu yok  |  "
                       f"mevcut: {list(df_actual.columns)}")

    if g_col is not None and n_col is not None:            # uzun format
        d = df_actual[df_actual[g_col].astype(str).str.strip().str.lower()
                      == f"{queue}_cagrilar"]
        if d.empty:
            mevcut = sorted(df_actual[g_col].dropna().astype(str).unique())
            raise ValueError(f"ACTUAL: '{queue}_cagrilar' yok. Mevcut: {mevcut[:10]}")
        deger = pd.to_numeric(d[n_col], errors='coerce').fillna(0)
    elif w_col is not None:                                # geniş format
        d = df_actual
        deger = pd.to_numeric(d[w_col], errors='coerce').fillna(0)
    else:
        raise KeyError(f"ACTUAL: '{queue}' çağrı kolonu bulunamadı.")

    out = pd.DataFrame({
        'data_date': _to_date_series(d[d_col]).dt.normalize(),
        'interval': d[t_col].map(_to_slot_30),
        'cagri': deger.values,
    })
    out = out.groupby(['data_date', 'interval'], as_index=False).sum()
    out = out[(out['data_date'].dt.year == year) & (out['data_date'].dt.month == month)]
    out['cagri'] = out['cagri'].round().astype(int)
    if verbose:
        print(f"ÇAĞRI ({queue}) — {out['data_date'].nunique()} gün, "
              f"toplam {int(out['cagri'].sum()):,}")
    return out.sort_values(['data_date', 'interval']).reset_index(drop=True)


def genel_bakis(df_vard, df_cagri, sadece_dolu_gun=True, verbose=True):
    """Vardiya + çağrıyı birleştirir, gün tipini işaretler.

    Çıktı: data_date, gun, hafta_sonu, interval,
           kapasite_in/out/toplam, baslangic_in/out/toplam, cagri
    """
    df = df_vard.merge(df_cagri, on=['data_date', 'interval'], how='left')
    df['cagri'] = df['cagri'].fillna(0).astype(int)

    if sadece_dolu_gun:
        gunluk = df.groupby('data_date')[['kapasite_toplam', 'cagri']].sum().sum(axis=1)
        bos = list(gunluk[gunluk == 0].index)
        if bos:
            df = df[~df['data_date'].isin(bos)]
            if verbose:
                print(f"  ℹ veri olmayan {len(bos)} gün çıkarıldı: "
                      f"{', '.join(d.strftime('%d.%m') for d in bos)}")

    df['gun'] = pd.to_datetime(df['data_date']).dt.weekday.map(lambda i: GUN_TR[i])
    df['hafta_sonu'] = (pd.to_datetime(df['data_date']).dt.weekday >= 5).astype(int)
    kol = ['data_date', 'gun', 'hafta_sonu', 'interval'] + OLCU_KOL + ['cagri']
    return df[kol].sort_values(['data_date', 'interval']).reset_index(drop=True)


def slot_ozet(df, hafta_sonu=None, olcu='ortalama'):
    """Slot bazında aylık profil (gün tipine göre süzülebilir).

    hafta_sonu: None → hepsi | 0 → hafta içi | 1 → hafta sonu
    olcu: 'ortalama' (varsayılan) | 'medyan'
      medyan aykırı günlerden (tatil, kampanya, eksik veri) etkilenmez.
    """
    if olcu not in ('ortalama', 'medyan'):
        raise ValueError("olcu: 'ortalama' veya 'medyan'")
    d = df if hafta_sonu is None else df[df['hafta_sonu'] == hafta_sonu]
    if d.empty:
        return pd.DataFrame()
    kol = OLCU_KOL + ['cagri']
    gb = d.groupby('interval', as_index=False)[kol]
    g = (gb.mean() if olcu == 'ortalama' else gb.median()).round(1)
    g['gun_sayisi'] = d['data_date'].nunique()
    return g.sort_values('interval').reset_index(drop=True)


def gun_ozet(df):
    """Gün bazında toplam — kapasite kişi-slot, çağrı adet."""
    kol = OLCU_KOL + ['cagri']
    g = df.groupby(['data_date', 'gun', 'hafta_sonu'], as_index=False)[kol].sum()
    g['kisi_saat'] = (g['kapasite_toplam'] / 2).round(1)     # slot = yarım saat
    g['cagri_kisi_basi'] = (g['cagri'] / g['kisi_saat'].replace(0, pd.NA)).round(1)
    return g.sort_values('data_date').reset_index(drop=True)


