              f"hiçbir üyesinde yazılı değil) → o takımlarda İSİM anahtarı "
              f"kullanıldı: {sorted(set(df_tam.loc[_t6_bos, 'takim_ad']))[:5]}")
        _t6_parca = _t6_parca.where(~_t6_bos, _t6_isim)
df_tam["takim"] = _t6_wmg + " | " + _t6_parca                  # EŞLEŞME anahtarı

# anahtar → gösterim / lider kodu: print'ler ve Excel bu haritaları kullanır
