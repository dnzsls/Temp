# ---------------------------------------------------------------------------

import math

# kitle erlang ayarları (CONFIG_WEEKDAY['queue_configs']['kitle']['erlang'])
TARGET_ASA = 30
INTERVAL_MIN = 30
KITLE_SHRINKAGE = {
    0: 0.07, 1: 0.07, 2: 0.07, 3: 0.07, 4: 0.07, 5: 0.07, 6: 0.07,
    7: 0.07, 8: 0.07, 9: 0.24, 10: 0.17, 11: 0.17, 12: 0.16,
    13: 0.19, 14: 0.21, 15: 0.25, 16: 0.26, 17: 0.29, 18: 0.18,
    19: 0.17, 20: 0.18, 21: 0.14, 22: 0.13, 23: 0.19, 'default': 0.0,
}


def _erlang_c(agents, traffic):
    if agents <= traffic or agents == 0:
        return 1.0
    eb = traffic / agents
    for i in range(2, int(agents) + 1):
        eb = (traffic * eb) / (i + traffic * eb)
    return min(eb / (1 - (traffic / agents) * (1 - eb)), 1.0)


def _asa(agents, traffic, aht):
    if agents <= traffic or agents == 0:
        return 999
    return (_erlang_c(agents, traffic) * (aht / 60)) / (agents - traffic) * 60


def gerekli_kisi(calls, aht, slot, shrinkage=None, target_asa=TARGET_ASA):
    """Bir slot için Erlang-C ihtiyacı (shrinkage uygulanmış)."""
    if calls <= 0:
        return 0
    traffic = (calls * (aht / 60)) / INTERVAL_MIN
    if traffic == 0:
        return 0
    ham = math.ceil(traffic * 3) + 10
    for a in range(math.ceil(traffic), ham + 1):
        if _asa(a, traffic, aht) <= target_asa:
            ham = a
            break
    shr_cfg = shrinkage if shrinkage is not None else KITLE_SHRINKAGE
    shr = shr_cfg.get(int(slot[:2]), shr_cfg.get('default', 0.0))
    return math.ceil(ham / (1 - shr))


def _erlang_serisi(calls_serisi, slot_serisi, aht):
    cache = {}
    out = []
    for c, s in zip(calls_serisi, slot_serisi):
        key = (int(c), s)
        if key not in cache:
            cache[key] = gerekli_kisi(int(c), aht, s)
        out.append(cache[key])
    return out


def kalibre_aht(results, queue='kitle', adaylar=range(90, 331, 10), verbose=True):
    """Pickle'daki Erlang'ı en iyi yeniden üreten AHT'yi bulur.

    Sadece pickle'ı kullanır: model, kendi forecast çağrılarından
    (calls_by_slot) bir Erlang (erlang_by_slot) üretti. Hangi AHT o Erlang'ı
    geri veriyorsa, gerçek çağrılar için de o AHT geçerlidir.

    df_aht'yi PL/SQL'den çekiyorsan buna gerek yok — aht_saatlik() kullan.
    """
    kayit = []
    for date_str, day in results.items():
        r = (day or {}).get(queue)
        if not r:
            continue
        erl = r.get('erlang_by_slot') or {}
        calls = r.get('calls_by_slot') or {}
        for slot, e in erl.items():
            c = calls.get(slot, 0)
            if e > 0 and c > 0:
                kayit.append({'interval': slot, 'calls': c, 'erlang_pkl': e})
    if not kayit:
        raise ValueError(f"results içinde {queue} için erlang_by_slot + "
                         f"calls_by_slot eşleşmesi yok.")

    df = pd.DataFrame(kayit)
    en_iyi, en_iyi_hata = None, None
    for aht in adaylar:
        tahmin = _erlang_serisi(df['calls'], df['interval'], aht)
        hata = (pd.Series(tahmin) - df['erlang_pkl'].values).abs().mean()
        if en_iyi_hata is None or hata < en_iyi_hata:
            en_iyi, en_iyi_hata = aht, hata

    if verbose:
        print(f"AHT kalibrasyonu: {en_iyi} sn  "
              f"(pickle Erlang'ından ortalama sapma {en_iyi_hata:.1f} kişi, "
              f"{len(df):,} slot üzerinden)")
        if en_iyi_hata > 3:
            print("  ⚠ sapma yüksek — alt-kuyruk ağırlıklı AHT tek değere "
                  "sığmıyor olabilir; hakem sonuçlarını temkinli yorumla.")
    return en_iyi


def _ihtiyac_kolonu(df, aht):
    """aht: sayı | {saat: aht} | DataFrame(data_date, interval, aht)."""
    if isinstance(aht, pd.DataFrame):
        d = df.merge(aht, on=['data_date', 'interval'], how='left')
        varsayilan = float(aht['aht'].mean())
        eksik = int(d['aht'].isna().sum())
        if eksik:
            print(f"  ℹ {eksik:,} slotta alt-kuyruk AHT'si yok, "
                  f"ortalama ({varsayilan:.0f} sn) kullanıldı.")
        d['aht'] = d['aht'].fillna(varsayilan)
        return [gerekli_kisi(int(c), a, s) for c, a, s in
                zip(d['actual_kitle'], d['aht'], d['interval'])]
    cache = {}
    out = []
    for c, s in zip(df['actual_kitle'], df['interval']):
        key = (int(c), s)
        if key not in cache:
            cache[key] = gerekli_kisi(int(c), _aht_of(aht, s), s)
        out.append(cache[key])
    return out


def hakem_tablosu(df_kitle, df_act30, aht, esik=2, df_m2=None, verbose=True):
    """Gerçek çağrı ihtiyacına kim daha yakın?

    df_kitle : compare_kitle çıktısı (model_toplam / plan_toplam)
    df_act30 : actual_calls_30 çıktısı (actual_kitle)
    df_m2    : model2_coverage çıktısı (opsiyonel) → model2 kolonları + üçlü skor
    esik     : sapma farkı bu değerin altındaysa BERABERE
    """
    df = df_kitle.merge(df_act30[['data_date', 'interval', 'actual_kitle']],
                        on=['data_date', 'interval'], how='inner')
    if df.empty:
        raise ValueError("df_kitle ile actual kesişmedi — tarih aralıklarını kontrol et.")

    df['ihtiyac'] = _ihtiyac_kolonu(df, aht)
    df['model_sapma'] = df['model_toplam'] - df['ihtiyac']
    df['plan_sapma'] = df['plan_toplam'] - df['ihtiyac']

    fark = df['plan_sapma'].abs() - df['model_sapma'].abs()
    df['kazanan'] = 'BERABERE'
    df.loc[fark < -esik, 'kazanan'] = 'PLAN'
    df.loc[fark > esik, 'kazanan'] = 'MODEL'
    df.loc[df['ihtiyac'] == 0, 'kazanan'] = '—'        # çağrı yok, kıyas anlamsız

    kolonlar = ['data_date', 'interval', 'actual_kitle', 'ihtiyac',
                'model_in', 'model_out', 'model_toplam', 'model_sapma',
                'plan_in', 'plan_out', 'plan_toplam', 'plan_sapma', 'kazanan']

    if df_m2 is not None:
        df = model2_ekle(df, df_m2, verbose=verbose)
        df['kazanan_3lu'] = _en_yakin(df, {
            'MODEL': 'model_toplam', 'MODEL2': 'model2_toplam',
            'PLAN': 'plan_toplam'}, esik=esik)
        kolonlar = (kolonlar[:-1]
                    + ['model2_in', 'model2_toplam', 'model2_sapma', 'kayip',
                       'kazanan', 'kazanan_3lu'])

    df = df[kolonlar]
    if verbose:
        skor_ozeti(df, esik)
        if df_m2 is not None:
            _skor_3lu(df, esik)
    return df


def _skor_3lu(df, esik=2):
    """MODEL / MODEL2 / PLAN üçlü skor + kayıp satırı."""
    k = df[df['kazanan_3lu'] != '—']
    n = len(k)
    if not n:
        return
    say = k['kazanan_3lu'].value_counts()
    print(f"ÜÇLÜ SKOR ({n:,} slot, berabere eşiği ±{esik} kişi)")
    for ad in ('MODEL', 'MODEL2', 'PLAN', 'BERABERE'):
        v = int(say.get(ad, 0))
        print(f"  {ad:<9} {v:>6,}  (%{v / n * 100:.0f})")
    show(pd.DataFrame([{
        'kim': ad,
        'ort_mutlak_sapma': round((k[kol] - k['ihtiyac']).abs().mean(), 1),
        'ort_sapma': round((k[kol] - k['ihtiyac']).mean(), 1),
    } for ad, kol in (('MODEL (MIP)', 'model_toplam'),
                      ('MODEL2 (atama)', 'model2_toplam'),
                      ('PLAN', 'plan_toplam'))]))


def skor_ozeti(df_hakem, esik=2):
    """Tek bakışta: kim kaç slotta daha iyi."""
    kiyaslanan = df_hakem[df_hakem['kazanan'] != '—']
    n = len(kiyaslanan)
    if not n:
        print("Kıyaslanacak slot yok.")
        return None

    sayim = kiyaslanan['kazanan'].value_counts()
    plan, model = int(sayim.get('PLAN', 0)), int(sayim.get('MODEL', 0))
    berabere = int(sayim.get('BERABERE', 0))

    print(f"SKOR ({n:,} slot, berabere eşiği ±{esik} kişi)")
    print(f"  PLAN     {plan:>6,}  (%{plan/n*100:.0f})")
    print(f"  MODEL    {model:>6,}  (%{model/n*100:.0f})")
    print(f"  BERABERE {berabere:>6,}  (%{berabere/n*100:.0f})")
    kazanan = 'PLAN' if plan > model else ('MODEL' if model > plan else 'BERABERE')
    print(f"  → genel: {kazanan}")

    ozet = pd.DataFrame([{
        'kim': etiket,
        'ort_mutlak_sapma': round(kiyaslanan[kol].abs().mean(), 1),
        'ort_sapma': round(kiyaslanan[kol].mean(), 1),
        'fazla_slot': int((kiyaslanan[kol] > 0).sum()),
        'eksik_slot': int((kiyaslanan[kol] < 0).sum()),
    } for etiket, kol in (('PLAN', 'plan_sapma'),
                          ('MODEL', 'model_sapma'))])
    show(ozet)
    return ozet


def _hakem_ozet(df_hakem, anahtar, nasil, esik=2):
    """hakem tablosunu gün ya da saat bazına toplar (model2 varsa dahil)."""
    d = df_hakem[df_hakem['kazanan'] != '—'].copy()
    m2 = 'model2_toplam' in d.columns
    agg = {
        'ihtiyac': ('ihtiyac', nasil),
        'model':   ('model_toplam', nasil),
        'plan':    ('plan_toplam', nasil),
        'model_mutlak_sapma': ('model_sapma',
                               (lambda s: s.abs().sum()) if nasil == 'sum'
                               else (lambda s: s.abs().mean())),
        'plan_mutlak_sapma':  ('plan_sapma',
                               (lambda s: s.abs().sum()) if nasil == 'sum'
                               else (lambda s: s.abs().mean())),
    }
    if m2:
        agg['model2'] = ('model2_toplam', nasil)
        agg['model2_mutlak_sapma'] = ('model2_sapma',
                                      (lambda s: s.abs().sum()) if nasil == 'sum'
                                      else (lambda s: s.abs().mean()))
        if 'kayip' in d.columns:
            agg['kayip'] = ('kayip', nasil)

    g = d.groupby(anahtar).agg(**agg).reset_index()
    if nasil == 'mean':
        g = g.round(1)

    adaylar = {'MODEL': 'model_mutlak_sapma', 'PLAN': 'plan_mutlak_sapma'}
    if m2:
        adaylar['MODEL2'] = 'model2_mutlak_sapma'
    g['kazanan'] = _kazanan_sapma(g, adaylar, esik=esik)

    kolonlar = [anahtar, 'ihtiyac', 'model'] + (['model2'] if m2 else []) + ['plan',
                'model_mutlak_sapma'] + (['model2_mutlak_sapma'] if m2 else []) + [
                'plan_mutlak_sapma'] + (['kayip'] if m2 and 'kayip' in g.columns else []) + [
                'kazanan']
    return g[kolonlar]


def hakem_gunluk(df_hakem, esik=2):
