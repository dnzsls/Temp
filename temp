GUN_TIPLERI = ('hafta_ici', 'cumartesi', 'pazar')

# gün tipi başına blok anahtarları. balance_penalty yalnız hafta içinde vardı →
# hafta sonu için boş (kapalı) kurulur.
_BLOK = ('erlang', 'mip', 'slot_cap', 'rr_penalty', 'hourly_report',
         'balance_penalty')

_KAPALI_BP = {'enabled': False, 'windows': []}


def _blok_hafta_ici(queue):
    q = _CW['queue_configs'][queue]
    return {k: copy.deepcopy(q.get(k, _KAPALI_BP if k == 'balance_penalty' else {}))
            for k in _BLOK}


def _blok_hafta_sonu(queue, gun):
    q = _CE['queue_configs'][queue][gun]
    out = {k: copy.deepcopy(q[k]) for k in _BLOK if k in q}
    out['balance_penalty'] = copy.deepcopy(_KAPALI_BP)
    return out


def _queue_configs():
    out = {}
    for queue in _CW['queues']:
        out[queue] = {
            'hafta_ici': _blok_hafta_ici(queue),
            'cumartesi': _blok_hafta_sonu(queue, 'cumartesi'),
            'pazar':     _blok_hafta_sonu(queue, 'pazar'),
        }
    return out


