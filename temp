def model1_tablosu(results, year, month, queue='kitle', verbose=True):
    """Model-1 pickle → gün × slot.

    cagri_tahmin ← calls_by_slot          gereken_plan ← erlang_by_slot
    aht_model    ← weighted_aht_by_slot   (sadece hafta sonu pickle'ında var)
    kap_in / kap_out / kap_pt ← mip_*_by_slot
    Kısmiler hafta içi SAYILMAZ (KISMI_HAFTA_ICI), hafta sonu sayılır.
    """
    satir, aylar, plansiz, pt_hi = [], {}, [], 0.0
    for ds, day in (results or {}).items():
        d = pd.to_datetime(ds).normalize()
        aylar[(d.year, d.month)] = aylar.get((d.year, d.month), 0) + 1
        if (d.year, d.month) != (year, month):
            continue
        r = (day or {}).get(queue)
        if not r:
            plansiz.append(d)
            continue
        mi = r.get('mip_info', {}) or {}
        erl = _slot_sozluk(r.get('erlang_by_slot') or mi.get('erlang_by_slot'))
        calls = _slot_sozluk(r.get('calls_by_slot'))
        aht = _slot_sozluk(r.get('weighted_aht_by_slot'))
        inn = _slot_sozluk(mi.get('mip_in_by_slot'))
        out = _slot_sozluk(mi.get('mip_out_by_slot'))
        pt = _slot_sozluk(mi.get('mip_pt_by_slot'))
        if not inn and not out:
            inn = _slot_sozluk(mi.get('mip_by_slot'))
        hafta_ici = d.weekday() < 5
        for sl in SLOTS_30:
            p = float(pt.get(sl, 0) or 0)
            if hafta_ici and not KISMI_HAFTA_ICI:
                pt_hi += p
                p = 0.0
            satir.append({
                'data_date': d, 'interval': sl,
                'cagri_tahmin': float(calls.get(sl, 0) or 0),
                'aht_model': float(aht[sl]) if sl in aht else np.nan,
                'gereken_plan': float(erl.get(sl, 0) or 0),
                'kap_in': float(inn.get(sl, 0) or 0),
                'kap_out': float(out.get(sl, 0) or 0),
                'kap_pt': p,
            })
    if not satir:
        liste = ', '.join(f"{y}/{m:02d} ({n} gün)" for (y, m), n in sorted(aylar.items()))
        raise ValueError(f"Model-1 pickle'ında {year}/{month:02d} '{queue}' yok. "
                         f"Pickle'daki aylar: {liste or '—'}")
    t = pd.DataFrame(satir)
    t['kap_toplam'] = t['kap_in'] + t['kap_out'] + t['kap_pt']
    if verbose:
        print(f"MODEL-1 — {t['data_date'].nunique()} gün planlı  |  tahmin çağrı "
              f"{t['cagri_tahmin'].sum():,.0f}  |  tepe kapasite {t['kap_toplam'].max():.0f}"
              + (f"  |  hafta içi kısmi HARİÇ ({pt_hi:,.0f} kişi-slot)" if pt_hi else ""))
        if plansiz:
            print(f"  ⚠ sonucu olmayan {len(plansiz)} gün: "
                  f"{', '.join(x.strftime('%d.%m') for x in plansiz[:10])}")
    return t


