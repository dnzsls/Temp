# %% MODEL-1 ESKİ vs YENİ — dağılım karşılaştırması (salt okunur)
import pickle, pandas as pd

ESKI_PKL = "BURAYA_model_1_new_pickle_yolu.pkl"     # eski akış (model_1_new v11)
YENI_PKL = "monthly_unified_2026_10_sabit_sur1_esit0_rrg1_k50000-50000_gap0.03.pkl"  # S1
Q = 'kitle'
eski = pickle.load(open(ESKI_PKL, 'rb'))
yeni = pickle.load(open(YENI_PKL, 'rb'))

def _mi(res, d):
    r = (res.get(d) or {}).get(Q)
    return (r or {}).get('mip_info') if r else None

def _ihtiyac(mi):
    return mi.get('erlang_by_slot_ham') or mi.get('erlang_by_slot') or {}

def _saha(mi):
    # sahadaki kişi = o gün giren + önceki günden sarkan (eski pickle'da yoksa mip_by_slot)
    return mi.get('fiili_by_slot') or mi.get('mip_by_slot') or {}

# ── 1) GÜN BAZINDA ──────────────────────────────────────────────────
gun = []
for d in sorted(set(eski) | set(yeni)):
    row = {'tarih': d, 'gun': pd.Timestamp(d).strftime('%a')}
    for ad, res in (('eski', eski), ('yeni', yeni)):
        mi = _mi(res, d)
        if not mi:
            continue
        e, s = _ihtiyac(mi), _saha(mi)
        rr = {t: s.get(t, 0) / v for t, v in e.items() if v > 0}
        row.update({
            f'{ad}_in':  mi.get('total_inhouse_kisi', 0),
            f'{ad}_out': mi.get('total_outsource_kisi', 0),
            f'{ad}_pt':  mi.get('total_part_time_kisi', 0),
            f'{ad}_eksik': int(sum(max(0, v - s.get(t, 0)) for t, v in e.items())),
            f'{ad}_rr_min': round(min(rr.values()), 2) if rr else None,
            f'{ad}_rr<95_slot': sum(1 for v in rr.values() if v < 0.95),
        })
    gun.append(row)
df_gun = pd.DataFrame(gun)
print(df_gun.to_string(index=False))
print(f"\nAYLIK eksik  eski {df_gun['eski_eksik'].sum():.0f}  |  yeni {df_gun['yeni_eksik'].sum():.0f}")

# ── 2) SAAT PROFİLİ (hafta içi ortalama) ────────────────────────────
hi = [d for d in sorted(yeni) if pd.Timestamp(d).weekday() < 5 and _mi(yeni, d) and _mi(eski, d)]
prof = []
for t in sorted({t for d in hi for t in _ihtiyac(_mi(yeni, d))}):
    ih = sum(_ihtiyac(_mi(yeni, d)).get(t, 0) for d in hi) / len(hi)
    es = sum(_saha(_mi(eski, d)).get(t, 0) for d in hi) / len(hi)
    ye = sum(_saha(_mi(yeni, d)).get(t, 0) for d in hi) / len(hi)
    prof.append({'slot': t, 'ihtiyac': round(ih, 1), 'eski': round(es, 1), 'yeni': round(ye, 1),
                 'eski_rr': round(es / ih, 2) if ih else None,
                 'yeni_rr': round(ye / ih, 2) if ih else None})
df_prof = pd.DataFrame(prof)
print("\nHAFTA İÇİ SAAT PROFİLİ (ortalama kişi)")
print(df_prof.to_string(index=False))

# ── 3) VARDİYA DAĞILIMI (başlangıç × şirket, aylık kişi-gün) ──────────
def _vardiya(res):
    out = {}
    for d in res:
        mi = _mi(res, d)
        if not mi:
            continue
        sc = mi.get('shift_coverage', {})
        for s, k in (mi.get('assignments') or {}).items():
            if k > 0:
                c = sc.get(s, {})
                key = (c.get('start'), c.get('company'))
                out[key] = out.get(key, 0) + k
    return out
ve, vy = _vardiya(eski), _vardiya(yeni)
df_var = pd.DataFrame([{'baslangic': k[0], 'sirket': k[1],
                        'eski': ve.get(k, 0), 'yeni': vy.get(k, 0),
                        'fark': vy.get(k, 0) - ve.get(k, 0)}
                       for k in sorted(set(ve) | set(vy), key=lambda k: (str(k[0]), str(k[1])))])
print("\nVARDİYA DAĞILIMI (aylık kişi-gün)")
print(df_var.to_string(index=False))

with pd.ExcelWriter("model1_eski_vs_yeni_2026_10.xlsx") as xl:
    df_gun.to_excel(xl, 'gun', index=False)
    df_prof.to_excel(xl, 'saat_profili', index=False)
    df_var.to_excel(xl, 'vardiya', index=False)
print("\nExcel: model1_eski_vs_yeni_2026_10.xlsx")
