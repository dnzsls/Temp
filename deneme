# %% [HÜCRE 5] — Teşhis: eksik/fazla NEREDEN geliyor? (TESHIS_KUYRUK, tahmine göre, ekrana)
# Sahadaki kişi atamalardan kurulur (gece sarkanı ertesi güne). İki aşama:
#   son = mip_info.assignments (dağıtıcı SONRASI) · mip = mip_info_stage1 (dağıtıcı ÖNCESİ)
_BOS3 = lambda: {"inhouse": 0, "outsource": 0, "part_time": 0}


def _atama(r, asama, q=TESHIS_KUYRUK):
    rq = (r or {}).get(q) or {}
    mi = rq.get("mip_info", {}) or {}
    if asama == "mip":
        st1 = mi.get("mip_info_stage1") or rq.get("mip_info_stage1") or {}
        if st1.get("assignments"):
            return st1["assignments"]
    return mi.get("assignments") or {}


def _saha(res, asama, q=TESHIS_KUYRUK):
    saha = {}
    for ds, r in res.items():
        cov = (((r or {}).get(q) or {}).get("mip_info", {}) or {}).get("shift_coverage", {}) or {}
        ert = (dt.date.fromisoformat(ds) + dt.timedelta(days=1)).isoformat()
        for s, k in _atama(r, asama, q).items():
            c = cov.get(s, {})
            if k <= 0:
                continue
            sk = c.get("company", "inhouse")
            sk = sk if sk in ("outsource", "part_time") else "inhouse"
            for g, sl_list in ((ds, c.get("slots", [])), (ert, c.get("slots_d1", []))):
                for sl in sl_list:
                    saha.setdefault((g, sl), _BOS3())[sk] += k
    return saha


def teshis_tablo(res, q=TESHIS_KUYRUK):
    """slot satırları: n (son), n_mip (dağıtıcı öncesi), n_in, tahmin çağrı, Kap ihtiyacı, kapasite."""
    son, mip = _saha(res, "son", q), _saha(res, "mip", q)
    sat = []
    for ds, r in res.items():
        rq = (r or {}).get(q) or {}
        hr = (rq.get("_config") or {}).get("hourly_report") or {}
        tcs = rq.get("calls_by_slot") or {}
        d = dt.date.fromisoformat(ds)
        for s in SLOTS:
            x, xm = son.get((ds, s), _BOS3()), mip.get((ds, s), _BOS3())
            n = x["inhouse"] + x["outsource"] + x["part_time"]
            tc = float(tcs.get(s, 0) or 0)
            h = int(s[:2])
            pay = (_oran(hr.get("cagri_adedi"), h, 15) / 2
                   * (1 - _oran(hr.get("rapor_etkisi"), h, 0) - _oran(hr.get("kapasite_kaybi"), h, 0)))
            sat.append({"gun": GUN_TR[d.weekday()], "hs": int(d.weekday() >= 5), "saat": s[:2],
                        "n": n, "n_mip": xm["inhouse"] + xm["outsource"] + xm["part_time"],
                        "n_in": x["inhouse"], "tc": tc,
                        "kap_ih": tc / pay if pay > 0 else 0.0,
                        "kar": min(_kap(n, tc, s, hr)[0], tc)})
    return pd.DataFrame(sat)


T = {ad: teshis_tablo(res) for ad, res in _res.items()}
print(f"\n################ TEŞHİS · {TESHIS_KUYRUK} · TAHMİNE göre ################")

# 1) saat saat sahadaki − Kap ihtiyacı (kişi; eksi = eksik, artı = fazla)
for etk, filt in (("CMT", lambda t: t["gun"] == "Cmt"), ("PZR", lambda t: t["gun"] == "Pzr"),
                  ("HAFTA İÇİ", lambda t: t["hs"] == 0)):
    tab = pd.DataFrame({ad: (t[filt(t)].groupby("saat")["n"].mean()
                             - t[filt(t)].groupby("saat")["kap_ih"].mean()).reindex(TESHIS_SAAT)
                        for ad, t in T.items()}).T.round(0)
    print(f"\n=== {etk} · sahadaki − Kap ihtiyacı (kişi; eksi = eksik) ===")
    print(tab.to_string())

# 2) hafta sonu saat bazında Kap_RR (tahmine göre, yarım saat tavanlı)
print("\n=== HAFTA SONU Kap_RR — saat (tahmine göre) ===")
print(pd.DataFrame({ad: (lambda g: g["kar"] / g["tc"].replace(0, np.nan))(
                        t[t["hs"] == 1].groupby("saat")[["kar", "tc"]].sum()).reindex(TESHIS_SAAT)
                    for ad, t in T.items()}).T.round(3).to_string())

# 3) HAFTA İÇİ: MIP'in kendi planı ↔ dağıtıcının eklediği
for ad, t in T.items():
    g = t[t["hs"] == 0].groupby("saat")[["n_mip", "n", "kap_ih"]].mean()
    print(f"\n=== {ad} · HAFTA İÇİ: MIP ↔ dağıtıcı (saat ortalaması, kişi) ===")
    print(pd.DataFrame({"MIP − kap ihtiyacı": g["n_mip"] - g["kap_ih"],
                        "dağıtıcının eklediği": g["n"] - g["n_mip"],
                        "SON − kap ihtiyacı": g["n"] - g["kap_ih"]}).reindex(TESHIS_SAAT).round(0).T.to_string())

# 4) dağıtıcının eklediği kişi — şirket × vardiya başlangıcı (hafta içi gün ortalaması)
for ad, res in _res.items():
    sat, n_gun = [], 0
    for ds, r in res.items():
        if dt.date.fromisoformat(ds).weekday() >= 5:
            continue
        n_gun += 1
        cov = (((r or {}).get(TESHIS_KUYRUK) or {}).get("mip_info", {}) or {}).get("shift_coverage", {}) or {}
        once, son = _atama(r, "mip"), _atama(r, "son")
        for s in set(once) | set(son):
            ek = son.get(s, 0) - once.get(s, 0)
            if ek:
                c = cov.get(s, {})
                sat.append({"sirket": c.get("company", "inhouse"),
                            "bas": str(c.get("start", "?"))[:5], "ek": ek})
    print(f"\n=== {ad} · dağıtıcının eklediği (hafta içi, gün başına ortalama kişi) ===")
    if sat:
        e = pd.DataFrame(sat).groupby(["sirket", "bas"])["ek"].sum() / max(n_gun, 1)
        print(e.round(1).unstack("bas", fill_value=0).to_string())
    else:
        print("  dağıtıcı bir şey eklememiş (ya da pickle'da mip_info_stage1 yok)")

# 5) HAFTA SONU yayma kontrolü — gün × vardiya başlangıcı × kişi
#    Birçok inhouse vardiyası AYNI tavan sayıda → yayma bağlayıcı
for ad, res in _res.items():
    sat = []
    for ds, r in sorted(res.items()):
        d = dt.date.fromisoformat(ds)
        if d.weekday() < 5:
            continue
        cov = (((r or {}).get(TESHIS_KUYRUK) or {}).get("mip_info", {}) or {}).get("shift_coverage", {}) or {}
        for s, k in _atama(r, "son").items():
            c = cov.get(s, {})
            if k > 0:
                sat.append({"gun": f"{ds[5:]} {GUN_TR[d.weekday()]}", "sirket": c.get("company", "inhouse"),
                            "bas": str(c.get("start", "?"))[:5], "k": k})
