import collections
print("=== 1) İngilizceciler: takım, gece yapabilir mi ===")
for a in sorted(eng_agents, key=lambda a: agent_takim_ad.get(a, "")):
    print(f"  {a}  {agent_takim_ad.get(a, ''):<40}"
          + ("  GECE YOK (kıdem)" if a in junior_agents else "")
          + ("  SABAHÇI" if a in sabah_agents else ""))

print("\n=== 2) Haftalık: İngilizceci nerede, takımı nerede ===")
_e = df_sonuc[df_sonuc.agent.isin(eng_agents)].copy()
_e = _e[_e.tarih.map(lambda d: dt.date.fromisoformat(d).weekday() < 5)]
_e["hafta"] = _e.tarih.map(lambda d: dt.date.fromisoformat(d).isocalendar()[:2])
for (a, wk), g in sorted(_e.groupby(["agent", "hafta"])):
    T = agent_takim.get(a)
    _tt = [b for b in TIP_SET if (T, wk, b) in takim_tip and solver.Value(takim_tip[(T, wk, b)])]
    print(f"  W{wk[1]}  {a}  kendisi {sorted(set(g.saat.str[:5]))}  takımı {_tt}")

print("\n=== 3) İngilizcecili takımlar 15:00'i seçebiliyor mu? ===")
for T in sorted({agent_takim[a] for a in eng_agents}, key=takim_gor):
    _var = [wk for wk in sorted(haftalar) if (T, wk, "15:00") in takim_tip]
    _sec = [f"W{wk[1]}" for wk in _var if solver.Value(takim_tip[(T, wk, "15:00")])]
    print(f"  {takim_gor(T, 40):<40} 15:00 seçeneği olan hafta {len(_var)} | seçilen {_sec}")

print("\n=== 4) Her hafta 15:00'e giden takımlar ===")
for wk in sorted(haftalar):
    _t = [takim_gor(T, 30) for (T, w, b), y in takim_tip.items()
          if w == wk and b == "15:00" and solver.Value(y)]
    print(f"  W{wk[1]}: {len(_t)} takım  {_t}")

