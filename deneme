_d = df_slot.assign(tip=df_slot["hafta_sonu"].map({0: "hafta içi", 1: "hafta sonu"}))
rows = []
for tip, g in _d.groupby("tip"):
    n = g["tarih"].nunique()
    for k in ("biz", "ekip"):
        f = g[f"{k}_sahadaki"] - g["kap_ihtiyac"]
        rows.append({"tip": tip, "taraf": k,
                     "kisi_saat/gün": g[f"{k}_sahadaki"].sum() / 2 / n,
                     "eksik_kisi_saat/gün": (-f).clip(lower=0).sum() / 2 / n,
                     "fazla_kisi_saat/gün": f.clip(lower=0).sum() / 2 / n,
                     "Kap_RR": np.minimum(g[f"{k}_kap"], g["cagri"]).sum() / g["cagri"].sum()})
print(pd.DataFrame(rows).round(3).to_string(index=False))
