def print_availability_report(avail_result, df_employees=None):
    """
    Müsaitlik matrisinin detaylı raporunu yazdırır.
    Jupyter'da kontrol için kullanılır.
    """
    print(f"\n{'='*70}")
    print("MÜSAİTLİK KONTROL RAPORU")
    print(f"{'='*70}")
    
    available = avail_result['available']
    unavailable = avail_result['unavailable']
    half_day = avail_result['half_day']
    constraints = avail_result['constraints']
    
    # Genel özet
    print(f"\nToplam kişi (constraints): {len(constraints)}")
    
    tip_counts = {}
    for aid, c in constraints.items():
        tip = c['tip']
        tip_counts[tip] = tip_counts.get(tip, 0) + 1
    print(f"Tip dağılımı: {tip_counts}")
    
    # Gün bazlı detay
    for dt_str in sorted(available.keys()):
        avail_ids = available[dt_str]
        unavail_dict = unavailable[dt_str]
        half_ids = half_day[dt_str]
        
        print(f"\n{'─'*50}")
        print(f"  {dt_str}")
        print(f"{'─'*50}")
        
        # Müsait olanları tip bazlı say
        avail_by_tip = {}
        for aid in avail_ids:
            if aid in constraints:
                tip = constraints[aid]['tip']
                avail_by_tip[tip] = avail_by_tip.get(tip, 0) + 1
        
        print(f"  Müsait: {len(avail_ids)} → {avail_by_tip}")
        print(f"  Yarım gün: {len(half_ids)}")
        print(f"  Müsait değil: {len(unavail_dict)}")
        
        # Sebep bazlı
        if unavail_dict:
            sebep_detay = {}
            for aid, sebep in unavail_dict.items():
                if sebep not in sebep_detay:
                    sebep_detay[sebep] = []
                sebep_detay[sebep].append(aid)
            
            for sebep in sorted(sebep_detay.keys()):
                ids = sebep_detay[sebep]
                aciklama = _izin_kodu_aciklama(sebep)
                print(f"    {sebep} ({aciklama}): {len(ids)} kişi")
                # İlk 5'ini göster
                if len(ids) <= 5:
                    print(f"      → {ids}")
                else:
                    print(f"      → {ids[:5]} ... (+{len(ids)-5})")
    
    # Ekip bütünlüğü kontrolü
    print(f"\n{'─'*50}")
    print("EKİP BÜTÜNLÜĞÜ KONTROLÜ")
    print(f"{'─'*50}")
    
    takim_members = {}
    for aid, c in constraints.items():
        t = c.get('takim', '')
        if t:
            if t not in takim_members:
                takim_members[t] = []
            takim_members[t].append(aid)
    
    for dt_str in sorted(available.keys()):
        avail_set = set(available[dt_str])
        print(f"\n  {dt_str}:")
        for takim in sorted(takim_members.keys()):
            members = takim_members[takim]
            musait = [m for m in members if m in avail_set]
            print(f"    {takim}: {len(musait)}/{len(members)} müsait")


def availability_to_pivot(avail_result):
    """
    Müsaitlik matrisini kişi × gün pivot tablosuna çevirir.
    Excel'e export veya görsel kontrol için.
    
    Returns
    -------
    pd.DataFrame
        index=agent_id, columns=tarihler, values=durum kodu
    """
    df_summary = avail_result['summary']
    
    if len(df_summary) == 0:
        return pd.DataFrame()
    
    pivot = df_summary.pivot_table(
        index=['agent_id', 'isim', 'tip', 'lokasyon', 'takim', 'ozel_durum'],
        columns='tarih',
        values='sebep',
        aggfunc='first'
    )
    
    pivot = pivot.reset_index()
    return pivot


