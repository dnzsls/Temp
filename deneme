# =============================================================================
# EKİP PLANI ↔ BİZİM PLAN (Model-1 pickle) — SLOT BAZINDA Kap_RR KARŞILAŞTIRMASI
# =============================================================================
# 2026-10-16. Ekibin elle yaptığı vardiya planından yarım saat bazında
# "sahadaki kişi" çıkarılır; bizim pickle'daki AYNI çağrı, Erlang ihtiyacı ve
# kayıp oranlarıyla iki tarafın Kap_RR'ı AYNI formülle hesaplanır.
#
#   Kap_RR (slot) = net kişi × (çağrı_adedi/2) ÷ gelen çağrı
#   net kişi      = sahadaki − round(sahadaki × rapor_etkisi) − round(sahadaki × kapasite_kaybi)
#   (Model-1 Excel raporundaki Kap_RR ile birebir aynı; oranlar pickle'daki
#    o günün config'inden — hourly_report)
#
# Gün / saat özetinde Kap_RR TAVANLI: her yarım saatte kapasite en fazla gelen
# çağrı kadar sayılır (boş kapasiteli saat açık saati örtmez).
#
# Hücreleri notebook'a sırayla yapıştır.
# =============================================================================


# %% [HÜCRE 1] — Ayarlar
import pickle
import datetime as dt
import pandas as pd

PKL_PATH = ""            # bizim Model-1 pickle'ı (monthly_unified_...pkl)
QUEUE = "kitle"          # karşılaştırılan kuyruk
CIKTI = f"ekip_vs_biz_kap_rr_{QUEUE}.xlsx"

# Ekip tablosunda outsource vardiyası 09:00-18:00 yazılıyor, sahada 18:30'a
# kadar kalıyor (bizim outsource vardiyaları +30 dk). 0 → kaydırma yok.
OUTSOURCE_EK_DK = 30
# PT (KISMI_FLG=1) sahadaki kişiye dahil mi? Bizim pickle'ın sahadaki kişisi
# (fiili_by_slot) PT'yi İÇERİR → adil kıyas için True.
KISMI_DAHIL = True


# %% [HÜCRE 2] — Veri
# df_ekip: ekibin planı, SQL'den. Kolonlar (büyük/küçük harf fark etmez):
#   WORKING_DATE · VARDIYA ('09:00-18:00') · KISI_SAYISI · OUTSOURCE_FLG (1/0)
#   · KISMI_FLG (1/0) · [LINE_BASED_MAIN_GROUP — varsa kuyruğa göre süzülür]
# Ayın 1'inin gecesi için önceki ayın SON gününün satırları da varsa gece
# sarkanı doğru sayılır (yoksa 1'i 00:00-03:00 eksik görünür).
with open(PKL_PATH, "rb") as f:
    results = pickle.load(f)
print(f"pickle: {len(results)} gün")

df_ekip = globals().get("df_ekip")
if df_ekip is None:
    raise SystemExit("df_ekip tanımlı değil — ekip planını SQL'den df_ekip olarak çek")


# %% [HÜCRE 3] — Fonksiyonlar
SLOTS = [f"{h:02d}:{m:02d}" for h in range(24) for m in (0, 30)]
GUN_TR = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Pzr"]


def _dk(t):
    h, m = str(t).strip()[:5].split(":")
    return int(h) * 60 + int(m)


def ekip_sahadaki(df, queue=QUEUE, ek_dk=OUTSOURCE_EK_DK, kismi=KISMI_DAHIL):
    """ekip tablosu → {tarih: {slot: {'inhouse','outsource','part_time'}}}.

    Vardiya başlangıcından bitişine kadar her yarım saat sayılır; gece
    yarısını aşan kısım ERTESİ güne yazılır. Outsource bitişine ek_dk eklenir.
    """
    d = df.copy()
    d.columns = [str(c).strip().lower() for c in d.columns]
    for k in ("working_date", "vardiya", "kisi_sayisi"):
        if k not in d.columns:
            raise ValueError(f"df_ekip'te '{k}' kolonu yok (var: {list(d.columns)})")
    if "line_based_main_group" in d.columns:
        _ad = {queue, f"{queue}_cagrilar"}
        d = d[d["line_based_main_group"].astype(str).str.strip().str.lower().isin(_ad)]
    d["working_date"] = pd.to_datetime(d["working_date"]).dt.date
    d["_out"] = pd.to_numeric(d.get("outsource_flg", 0), errors="coerce").fillna(0) == 1
    d["_pt"] = pd.to_numeric(d.get("kismi_flg", 0), errors="coerce").fillna(0) == 1
    if not kismi:
        d = d[~d["_pt"]]
    out, atlanan = {}, set()
    for _, r in d.iterrows():
        v = str(r["vardiya"]).strip()
        if "-" not in v:
            atlanan.add(v)
            continue
        bas, bit = v.split("-", 1)
        try:
            b, e = _dk(bas), _dk(bit)
        except Exception:
            atlanan.add(v)
            continue
        if e <= b:
            e += 1440                                   # gece yarısını aşıyor
        sirket = "part_time" if r["_pt"] else ("outsource" if r["_out"] else "inhouse")
        if sirket == "outsource":
            e += ek_dk
        n = int(pd.to_numeric(r["kisi_sayisi"], errors="coerce") or 0)
        for m in range(b - b % 30, e, 30):
            gun = r["working_date"] + dt.timedelta(days=m // 1440)
            s = SLOTS[(m % 1440) // 30]
            c = out.setdefault(gun.isoformat(), {}).setdefault(
                s, {"inhouse": 0, "outsource": 0, "part_time": 0})
            c[sirket] += n
    if atlanan:
        print(f"  ⚠ saat olmayan vardiya değerleri atlandı: {sorted(atlanan)[:8]}")
    # ekip tablosunda PLANI olan günler (yalnız sarkan gelen gün sayılmaz)
    out["_plan_gunleri"] = {t.isoformat() for t in d["working_date"].unique()}
    return out


def _oran(tbl, saat, vars_):
    tbl = tbl or {}
    return tbl.get(saat, tbl.get("default", vars_))


def kap(sahadaki, cagri, slot, hr):
    """(kapasite_cagri, Kap_RR) — Model-1 raporuyla AYNI formül."""
    h = int(slot[:2])
    re_ = _oran(hr.get("rapor_etkisi"), h, 0)
    kk_ = _oran(hr.get("kapasite_kaybi"), h, 0)
    ca_ = _oran(hr.get("cagri_adedi"), h, 15)
    net = sahadaki - round(sahadaki * re_) - round(sahadaki * kk_)
    ck = net * (ca_ / 2)
    return ck, ((ck / cagri) if cagri > 0 else None)


def karsilastir(results, ekip, queue=QUEUE):
    """slot tablosu: çağrı, Erlang ihtiyacı, ekip/biz sahadaki, Kap_RR, eksik."""
    satir = []
    # yalnız ekibin o gün PLAN yaptığı günler (önceki günden sadece sarkan gelen gün hariç)
    gunler = sorted(set(results) & ekip.get("_plan_gunleri", set()))
    for ds in gunler:
        rq = (results.get(ds) or {}).get(queue)
        if not rq:
            continue
        mi = rq.get("mip_info", {}) or {}
        cagri = rq.get("calls_by_slot", {}) or {}
        erl = (mi.get("erlang_by_slot_ham") or rq.get("erlang_by_slot") or {})
        biz = mi.get("fiili_by_slot") or mi.get("mip_by_slot") or {}
        hr = ((rq.get("_config") or {}).get("hourly_report") or {})
        d = dt.date.fromisoformat(ds)
        for s in SLOTS:
            c = float(cagri.get(s, 0) or 0)
            e = float(erl.get(s, 0) or 0)
            if c <= 0 and e <= 0:
                continue
            ek = ekip.get(ds, {}).get(s, {"inhouse": 0, "outsource": 0, "part_time": 0})
            ek_top = ek["inhouse"] + ek["outsource"] + ek["part_time"]
            bz = int(biz.get(s, 0) or 0)
            ek_ck, ek_kr = kap(ek_top, c, s, hr)
            bz_ck, bz_kr = kap(bz, c, s, hr)
            satir.append({
                "tarih": d, "gun": GUN_TR[d.weekday()], "slot": s, "cagri": round(c),
                "erlang_ihtiyac": round(e),
                "ekip_inhouse": ek["inhouse"], "ekip_outsource": ek["outsource"],
                "ekip_pt": ek["part_time"], "ekip_sahadaki": ek_top,
                "biz_sahadaki": bz, "fark_biz_eksi_ekip": bz - ek_top,
                "ekip_Kap_RR": ek_kr, "biz_Kap_RR": bz_kr,
                "ekip_kapasite_cagri": round(ek_ck, 1), "biz_kapasite_cagri": round(bz_ck, 1),
                "ekip_erl_eksik": max(0, e - ek_top), "biz_erl_eksik": max(0, e - bz),
                "ekip_erl_fazla": max(0, ek_top - e), "biz_erl_fazla": max(0, bz - e),
            })
    return pd.DataFrame(satir)


def ozetle(df, anahtar):
    """gün ya da saat bazında: Kap_RR (tavanlı), Erlang karşılama, eksik/fazla."""
    def _f(g):
        C = g["cagri"].sum()
        E = g["erlang_ihtiyac"].sum()
        o = {"cagri": int(C)}
        for k in ("ekip", "biz"):
            kar = g[[f"{k}_kapasite_cagri", "cagri"]].min(axis=1).clip(lower=0).sum()
            o[f"{k}_Kap_RR"] = (kar / C) if C else None
            o[f"{k}_karsilanamayan_cagri"] = round(C - kar)
            o[f"{k}_Erlang_karsilama"] = (1 - g[f"{k}_erl_eksik"].sum() / E) if E else None
            o[f"{k}_erl_eksik"] = round(g[f"{k}_erl_eksik"].sum())
            o[f"{k}_erl_fazla"] = round(g[f"{k}_erl_fazla"].sum())
            o[f"{k}_kap_rr_alti_slot"] = int((g[f"{k}_Kap_RR"] < 1).sum())
        o["Kap_RR_fark (biz−ekip)"] = ((o["biz_Kap_RR"] - o["ekip_Kap_RR"])
                                       if C else None)
        return pd.Series(o)
    return df.groupby(anahtar).apply(_f).reset_index()


# %% [HÜCRE 4] — Hesapla
ekip = ekip_sahadaki(df_ekip)
df_slot = karsilastir(results, ekip)
print(f"slot tablosu: {len(df_slot)} satır, {df_slot['tarih'].nunique()} gün")

df_gun = ozetle(df_slot, ["tarih", "gun"])
_s = df_slot.assign(saat=df_slot["slot"].str[:2] + ":00",
                    gun_tipi=df_slot["gun"].map(lambda g: "hafta sonu" if g in ("Cmt", "Pzr") else "hafta içi"))
df_saat = ozetle(_s, ["gun_tipi", "saat"])
df_ay = ozetle(df_slot.assign(donem="AY"), ["donem"])

# günlük kişi sayıları (sahada değil, o gün işe başlayan): ekip tablo vs bizim pickle
_e = df_ekip.copy()
_e.columns = [str(c).strip().lower() for c in _e.columns]
_e["working_date"] = pd.to_datetime(_e["working_date"]).dt.date
_e["sirket"] = [("part_time" if p == 1 else ("outsource" if o == 1 else "inhouse"))
                for o, p in zip(pd.to_numeric(_e.get("outsource_flg", 0), errors="coerce").fillna(0),
                                pd.to_numeric(_e.get("kismi_flg", 0), errors="coerce").fillna(0))]
_ek_kisi = _e.pivot_table(index="working_date", columns="sirket", values="kisi_sayisi",
                          aggfunc="sum", fill_value=0)
for _c in ("inhouse", "outsource", "part_time"):
    df_gun[f"ekip_{_c}_kisi"] = [int(_ek_kisi.at[t, _c]) if (t in _ek_kisi.index and _c in _ek_kisi.columns) else 0
                                 for t in df_gun["tarih"]]
    df_gun[f"biz_{_c}_kisi"] = [int((((results.get(t.isoformat()) or {}).get(QUEUE) or {})
                                     .get("mip_info", {}) or {}).get(f"total_{_c}_kisi", 0) or 0)
                                for t in df_gun["tarih"]]

pd.set_option("display.width", 200)
print(df_ay.T.to_string(header=False))
print(df_gun[["tarih", "gun", "cagri", "ekip_Kap_RR", "biz_Kap_RR",
              "ekip_Erlang_karsilama", "biz_Erlang_karsilama"]].to_string(index=False))


# %% [HÜCRE 5] — Excel
ACIKLAMA = pd.DataFrame([
    ("Kap_RR (slot)", "net kişi × çağrı_adedi/2 ÷ gelen çağrı; net = sahadaki − rapor − kayıp (pickle'daki oranlar). Model-1 raporuyla aynı"),
    ("Kap_RR (gün/saat/ay)", "Σ min(kapasite, çağrı) ÷ Σ çağrı — boş kapasiteli saat açık saati örtmez"),
    ("Erlang_karsilama", "1 − Σ eksik ÷ Σ Erlang ihtiyacı (kişi). İhtiyaç pickle'dan, iki taraf için AYNI"),
    ("ekip_sahadaki", f"ekip planından yarım saat bazında: gece yarısını aşan kısım ertesi güne; outsource bitişi +{OUTSOURCE_EK_DK} dk; PT {'dahil' if KISMI_DAHIL else 'hariç'}"),
    ("biz_sahadaki", "pickle fiili_by_slot: o gün başlayan + önceki günden sarkan + PT"),
    ("kap_rr_alti_slot", "Kap_RR %100'ün altında kalan yarım saat sayısı"),
    ("*_kisi (gun sayfası)", "o gün işe BAŞLAYAN kişi (sahadaki değil): ekip tablosu / pickle total_*_kisi"),
], columns=["kolon", "anlam"])

YUZDE = {"ekip_Kap_RR", "biz_Kap_RR", "ekip_Erlang_karsilama", "biz_Erlang_karsilama",
         "Kap_RR_fark (biz−ekip)"}
with pd.ExcelWriter(CIKTI, engine="openpyxl") as xl:
    for ad, df in (("ay_ozet", df_ay), ("gun", df_gun), ("saat", df_saat),
                   ("slot", df_slot), ("ACIKLAMA", ACIKLAMA)):
        df.to_excel(xl, sheet_name=ad, index=False)
    from openpyxl.styles import Font, PatternFill
    from openpyxl.utils import get_column_letter
    KIR, YES = PatternFill("solid", fgColor="FFC7CE"), PatternFill("solid", fgColor="C6EFCE")
    for ws in xl.book.worksheets:
        bas = [c.value for c in ws[1]]
        for c in ws[1]:
            c.font = Font(bold=True)
        ws.freeze_panes = "A2"
        if ws.max_row > 1:
            ws.auto_filter.ref = ws.dimensions
        for j, h in enumerate(bas, 1):
            ws.column_dimensions[get_column_letter(j)].width = (90 if h == "anlam"
                                                                else max(9, min(24, len(str(h)) + 2)))
            if h not in YUZDE:
                continue
            for r in range(2, ws.max_row + 1):
                cell = ws.cell(row=r, column=j)
                if isinstance(cell.value, (int, float)):
                    cell.number_format = "0.0%"
                    if h != "Kap_RR_fark (biz−ekip)":
                        cell.fill = KIR if cell.value < 0.99 else YES
print(f"✓ {CIKTI}  (ay_ozet · gun · saat · slot · ACIKLAMA)")
