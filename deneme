def prepare_df_for_oracle(df, date_cols):
    df = df.copy()
    
    # datetime64 → python date
    for col in date_cols:
        df[col] = pd.to_datetime(df[col], errors='coerce').dt.date
        df[col] = df[col].where(pd.notna(df[col]), None)
    
    # Kalan NaN → None
    df = df.where(pd.notna(df), None)
    
    return df

