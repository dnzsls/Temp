print(f"df_emp (ham): {df_emp.shape}")
print(f"Unique agent_user_code: {df_emp['agent_user_code'].nunique()}")

# Her plan tarihi için o tarihte geçerli olan kaydı bul
rows_filtered = []
for dt_str in PLAN_DATES:
    dt = pd.to_datetime(dt_str)
    mask = (df_emp['start_date'] <= dt) & (df_emp['end_date'] >= dt)
    df_day = df_emp[mask].copy()
    df_day['tarih'] = dt_str
    rows_filtered.append(df_day)

df_emp_plan = pd.concat(rows_filtered, ignore_index=True)

print(f"df_emp_plan: {df_emp_plan.shape}")
