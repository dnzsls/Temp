def expand_izin_to_days(df_izin, plan_start, plan_end):
    """
    İzin kayıtlarını gün bazlı satırlara açar.
    
    Her izin kaydı (başlangıç-bitiş aralığı) → planlama dönemiyle kesişen
    her gün için bir satır oluşturur.
    
    Parameters
    ----------
    df_izin : pd.DataFrame
        Ham izin tablosu
    plan_start : str/datetime
        Planlama dönemi başlangıcı (ör: '2026-04-04')
    plan_end : str/datetime
        Planlama dönemi bitişi (ör: '2026-04-05')
    
    Returns
    -------
    pd.DataFrame
        Kolonlar: sicil, tarih, izin_tipi, izin_tipi_2, yarim_gun, notlar
    """
    plan_start = pd.to_datetime(plan_start)
    plan_end = pd.to_datetime(plan_end)
    
    rows = []
    
    for _, r in df_izin.iterrows():
        izin_bas = r['izne_baslama_tarihi']
        goreve_bas = r['goreve_baslama_tarihi']
        
        if pd.isna(izin_bas):
            continue
        
        # İzin bitiş tarihi: göreve başlama - 1 gün
        # (göreve başlama = ilk çalışma günü, yani son izin günü ondan 1 öncesi)
        if pd.notna(goreve_bas):
            izin_son = goreve_bas - timedelta(days=1)
        else:
            # Göreve başlama yoksa → hala izinde, plan sonuna kadar izinli say
            izin_son = plan_end
        
        # Planlama dönemiyle kesişim
        eff_start = max(izin_bas, plan_start)
        eff_end = min(izin_son, plan_end)
        
        if eff_start > eff_end:
            continue  # Bu izin planlama dönemini kapsamıyor
        
        # Gün gün aç
        current = eff_start
        while current <= eff_end:
            yarim = False
            # İlk gün yarım mı?
            if current == izin_bas and r.get('izne_baslama_yarim_gun_mu', False):
                yarim = True
            # Son gün yarım mı? (göreve başlama günü yarım ise, bir önceki gün yarım izin)
            if pd.notna(goreve_bas) and current == (goreve_bas - timedelta(days=1)):
                if r.get('goreve_baslama_yarim_gun_mu', False):
                    yarim = True
            
            rows.append({
                'sicil': r.get('sicil', r.get('agent_id', '')),
                'tarih': current,
                'izin_tipi': r.get('izin_tipi', ''),
                'izin_tipi_2': r.get('izin_tipi_2', ''),
                'yarim_gun': yarim,
            })
            current += timedelta(days=1)
    
    df_gun = pd.DataFrame(rows)
    
    if len(df_gun) > 0:
        print(f"[expand_izin_to_days] {len(df_gun)} gün-bazlı izin kaydı oluşturuldu")
        print(f"  Planlama dönemi: {plan_start.date()} → {plan_end.date()}")
        print(f"  İzinli kişi sayısı: {df_gun['sicil'].nunique()}")
        print(f"  Yarım gün sayısı: {df_gun['yarim_gun'].sum()}")
    else:
        print(f"[expand_izin_to_days] Planlama döneminde izin kaydı yok")
    
    return df_gun


def build_availability(df_employees, df_izin, plan_dates, queue='kitle'):
    """
    Kişi × gün bazlı müsaitlik matrisi oluşturur.
    
    Parameters
    ----------
    df_employees : pd.DataFrame
        Çalışan listesi
    df_izin : pd.DataFrame
        Ham izin tablosu (veya None)
    plan_dates : list of str
        Planlama günleri ['2026-04-04', '2026-04-05']
    queue : str
        Kuyruk filtresi
    
    Returns
    -------
    dict
        {
            'available': {tarih: [agent_id listesi]},
            'unavailable': {tarih: {agent_id: sebep}},
            'half_day': {tarih: [agent_id listesi]},
            'constraints': {agent_id: {kısıt bilgileri}},
            'summary': pd.DataFrame  # kontrol için özet tablo
        }
    """
    plan_dates = [pd.to_datetime(d) for d in plan_dates]
    plan_start = min(plan_dates)
    plan_end = max(plan_dates)
    
    # Kuyruk filtresi
    df_q = df_employees[df_employees['kuyruk'] == queue].copy()
    print(f"\n{'='*60}")
    print(f"MÜSAİTLİK MATRİSİ — {queue.upper()} — {plan_start.date()} → {plan_end.date()}")
    print(f"{'='*60}")
    print(f"Toplam çalışan ({queue}): {len(df_q)}")
    
    # İzin verisi varsa gün bazlı aç
    if df_izin is not None and len(df_izin) > 0:
        df_izin_gun = expand_izin_to_days(df_izin, plan_start, plan_end)
    else:
        df_izin_gun = pd.DataFrame(columns=['sicil', 'tarih', 'izin_tipi', 'izin_tipi_2', 'yarim_gun'])
    
    available = {}      # tarih → müsait agent_id listesi
    unavailable = {}    # tarih → {agent_id: sebep kodu}
    half_day = {}       # tarih → yarım gün çalışacak agent_id listesi
    constraints = {}    # agent_id → kişiye özel kısıtlar
    
    summary_rows = []
    
    for dt in plan_dates:
        dt_str = dt.strftime('%Y-%m-%d')
        weekday = dt.weekday()  # 0=Pzt, 5=Cmt, 6=Paz
        is_weekend = weekday >= 5
        
        available[dt_str] = []
        unavailable[dt_str] = {}
        half_day[dt_str] = []
        
        for _, emp in df_q.iterrows():
            aid = emp['agent_id']
            reason = None  # None = müsait
            is_half = False
            
            # --- Filtreleme kuralları (öncelik sırasıyla) ---
            
            # 1. Aktif değilse
            if not emp.get('aktif', True):
                reason = 'pasif'
            
            # 2. Haftasonu çalışamaz (genel)
            elif is_weekend and not emp.get('haftasonu_calisabilir', True):
                reason = 'haftasonu_yok'
            
            # 3. Hamile → haftasonu çalışamaz (H5)
            elif is_weekend and emp['ozel_durum'] == 'hamile':
                reason = 'H'  # Hamile haftasonu yasağı
            
            # 4. Doğum izni flag'i (tüm dönem izinli)
            elif emp.get('dogum_izni_flg', 0) == 1:
                reason = 'D'  # Doğum izni
            
            # 5. İzin tablosunda bu gün izinli mi?
            else:
                izin_rows = df_izin_gun[
                    (df_izin_gun['sicil'] == aid) & 
                    (df_izin_gun['tarih'] == dt)
                ]
                if len(izin_rows) > 0:
                    izin_row = izin_rows.iloc[0]
                    izin_tip = str(izin_row.get('izin_tipi_2', izin_row.get('izin_tipi', 'izin')))
                    
                    if izin_row['yarim_gun']:
                        is_half = True
                        # Yarım gün izinli = yarım gün çalışabilir
                    else:
                        # Tam gün izin — izin tipine göre kod belirle
                        reason = _map_izin_kodu(izin_tip)
            
            # 6. Doğum günü izni
            if reason is None and 'dogum_gunu' in emp.index:
                dg = emp.get('dogum_gunu', '')
                if pd.notna(dg) and str(dg).strip() != '':
                    dg_date = pd.to_datetime(dg, errors='coerce')
                    if pd.notna(dg_date) and dg_date.date() == dt.date():
                        reason = 'DO'  # Doğum günü izni
            
            # Sonuç
            if reason:
                unavailable[dt_str][aid] = reason
            else:
                available[dt_str].append(aid)
                if is_half:
                    half_day[dt_str].append(aid)
            
            # Kişiye özel kısıtlar (bir kere hesapla)
            if aid not in constraints:
                constraints[aid] = {
                    'tip': emp['tip'],
                    'lokasyon': emp.get('lokasyon', ''),
                    'takim': emp.get('takim', ''),
                    'gunluk_saat': emp.get('gunluk_saat', 9),
                    'haftalik_gun': emp.get('haftalik_gun', 6),
                    'gece_ok': emp.get('gece_calisabilir', True),
                    'ozel_durum': emp.get('ozel_durum', 'yok'),
                    'mesai_flg': emp.get('mesai_flg', 0),
                    'max_saat': _get_max_saat(emp),
                }
            
            summary_rows.append({
                'agent_id': aid,
                'isim': emp.get('isim', ''),
                'tip': emp['tip'],
                'lokasyon': emp.get('lokasyon', ''),
                'takim': emp.get('takim', ''),
                'ozel_durum': emp['ozel_durum'],
                'tarih': dt_str,
                'musait': reason is None,
                'sebep': reason or ('yarim_gun' if is_half else 'musait'),
            })
    
    # Özet tablo
    df_summary = pd.DataFrame(summary_rows)
    
    # Print özet
    for dt in plan_dates:
        dt_str = dt.strftime('%Y-%m-%d')
        gun_adi = ['Pzt', 'Sal', 'Car', 'Per', 'Cum', 'Cmt', 'Paz'][dt.weekday()]
        n_avail = len(available[dt_str])
        n_unavail = len(unavailable[dt_str])
        n_half = len(half_day[dt_str])
        
        print(f"\n  {dt_str} ({gun_adi}):")
        print(f"    Müsait: {n_avail} kişi (yarım gün: {n_half})")
        print(f"    Müsait değil: {n_unavail} kişi")
        
        if n_unavail > 0:
            sebep_counts = {}
            for s in unavailable[dt_str].values():
                sebep_counts[s] = sebep_counts.get(s, 0) + 1
            for s, c in sorted(sebep_counts.items(), key=lambda x: -x[1]):
                kod_aciklama = _izin_kodu_aciklama(s)
                print(f"      {s} ({kod_aciklama}): {c}")
    
    # Tip bazlı özet
    if len(df_summary) > 0:
        print(f"\n  Tip bazlı müsaitlik:")
        for dt in plan_dates:
            dt_str = dt.strftime('%Y-%m-%d')
            gun_adi = ['Pzt', 'Sal', 'Car', 'Per', 'Cum', 'Cmt', 'Paz'][dt.weekday()]
            df_day = df_summary[df_summary['tarih'] == dt_str]
            tip_ozet = df_day.groupby('tip')['musait'].agg(['sum', 'count'])
            tip_ozet.columns = ['musait', 'toplam']
            print(f"    {dt_str} ({gun_adi}): ", end='')
            parts = []
            for tip, row in tip_ozet.iterrows():
                parts.append(f"{tip}={int(row['musait'])}/{int(row['toplam'])}")
            print(', '.join(parts))
    
    return {
        'available': available,
        'unavailable': unavailable,
        'half_day': half_day,
        'constraints': constraints,
        'summary': df_summary,
    }


def _map_izin_kodu(izin_tip_str):
    """İzin tipi string'ini MIP2 durum koduna çevirir."""
    izin_tip_str = str(izin_tip_str).strip().lower()
    
    mapping = {
        'yıllık izin': 'Y',
        'yillik izin': 'Y',
        'yıllık': 'Y',
        'doğum izni': 'D',
        'dogum izni': 'D',
        'doğum sonrası': 'D',
        'dogum sonrasi': 'D',
        'ücretsiz izin': 'D',  # doğum sonrası ücretsiz → D
        'ucretsiz izin': 'D',
        'ücretsiz izinler': 'D',
        'sağlık raporu': 'R',  # rapor
        'saglik raporu': 'R',
        'hastalık': 'R',
        'hastalik': 'R',
        'evlilik izni': 'O',
        'ölüm izni': 'O',
        'olum izni': 'O',
        'mazeret izni': 'O',
        'idari izin': 'O',
    }
    
    for key, code in mapping.items():
        if key in izin_tip_str:
            return code
    
    return 'O'  # default: genel izin


def _izin_kodu_aciklama(kod):
    """Durum kodu açıklaması."""
    aciklamalar = {
        'O': 'Off/İzin',
        'Y': 'Yıllık izin',
        'D': 'Doğum izni',
        'DO': 'Doğum günü izni',
        'H': 'Hamile (haftasonu yasak)',
        'R': 'Rapor/Hastalık',
        'M': 'Mesai',
        'K': 'Kısmi çalışan',
        'pasif': 'Aktif değil',
        'haftasonu_yok': 'Haftasonu çalışamaz',
        'musait': 'Müsait',
        'yarim_gun': 'Yarım gün',
    }
    return aciklamalar.get(kod, kod)


def _get_max_saat(emp):
    """Kişinin günlük max çalışma saatini belirler."""
    ozel = emp.get('ozel_durum', 'yok')
    if ozel in ['hamile', 'sut_izni']:
        return min(emp.get('gunluk_saat', 7), 11)  # max 20:00'a kadar
    return emp.get('gunluk_saat', 9)


