def parse_mip1_quotas(assignments, shift_coverage):
    """
    Girdi:
        assignments    → dict: {shift_key: kişi_sayısı}
                         ör: {"V08_inhouse": 35, "V08_outsource": 40, ...}
        shift_coverage → dict: {shift_key: {"company": ..., "start": ..., "end": ...}}

    Çıktı:
        df_quotas → DataFrame: sadece INHOUSE vardiyaları
                    Kolonlar: shift_key, company, start, end, kota

    Mantık:
        1. assignments'tan kota > 0 olanları al
        2. shift_coverage'dan company bilgisini eşle
        3. Sadece inhouse olanları filtrele (outsource sayı olarak kalacak)
    """
    rows = []

    for shift_key, kota in assignments.items():
        if kota <= 0:
            continue

        # shift_coverage'dan bu vardiyayı bul
        cov = shift_coverage.get(shift_key, {})
        company = cov.get("company", "unknown")
        start = cov.get("start", "")
        end = cov.get("end", "")

        rows.append({
            "shift_key": shift_key,
            "company": company,
            "start": start,
            "end": end,
            "kota": kota,
        })

    df_all = pd.DataFrame(rows)

    # Sadece inhouse kotalarını ayır
    df_inhouse = df_all[df_all["company"] == "inhouse"].copy()
    df_outsource = df_all[df_all["company"] != "inhouse"].copy()

    return df_inhouse, df_outsource


