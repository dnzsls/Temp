def load_employees(filepath, sheet_name='Calisan_Listesi'):
    """
    Çalışan listesini yükler ve tip dönüşümlerini yapar.
    
    Parameters
    ----------
    filepath : str
        Excel dosya yolu
    sheet_name : str
        Sheet adı
    
    Returns
    -------
    pd.DataFrame
    """
    df = pd.read_excel(filepath, sheet_name=sheet_name)
    
    # İlk satır açıklama satırıysa (şablondaki gibi) kaldır
    if df.iloc[0]['agent_id'] and 'Benzersiz' in str(df.iloc[0]['agent_id']):
        df = df.iloc[1:].reset_index(drop=True)
    
    # Tip dönüşümleri
    df['haftalik_gun'] = pd.to_numeric(df['haftalik_gun'], errors='coerce').fillna(6).astype(int)
    df['gunluk_saat'] = pd.to_numeric(df['gunluk_saat'], errors='coerce').fillna(9).astype(float)
    
    # evet/hayir → bool
    for col in ['gece_calisabilir', 'haftasonu_calisabilir', 'aktif']:
        if col in df.columns:
            df[col] = df[col].astype(str).str.strip().str.lower().map(
                {'evet': True, 'hayir': False, 'hayır': False, '1': True, '0': False}
            ).fillna(True)
    
    # ozel_durum boşsa 'yok'
    df['ozel_durum'] = df['ozel_durum'].fillna('yok').astype(str).str.strip().str.lower()
    
    print(f"[load_employees] {len(df)} çalışan yüklendi")
    print(f"  tip dağılımı: {df['tip'].value_counts().to_dict()}")
    print(f"  kuyruk dağılımı: {df['kuyruk'].value_counts().to_dict()}")
    print(f"  lokasyon dağılımı: {df['lokasyon'].value_counts().to_dict()}")
    
    return df


def load_izin(filepath, sheet_name=0):
    """
    İzin tablosunu yükler.
    
    Parameters
    ----------
    filepath : str
        Excel/CSV dosya yolu
    sheet_name : str/int
        Sheet adı veya index
    
    Returns
    -------
    pd.DataFrame
    """
    if filepath.endswith('.csv'):
        df = pd.read_csv(filepath)
    else:
        df = pd.read_excel(filepath, sheet_name=sheet_name)
    
    # Tarih kolonlarını datetime'a çevir
    for col in ['izne_baslama_tarihi', 'goreve_baslama_tarihi', 'isten_ayrilis_tarihi']:
        if col in df.columns:
            df[col] = pd.to_datetime(df[col], errors='coerce')
    
    # izin_gun_sayisi sayısal
    if 'izin_gun_sayisi' in df.columns:
        df['izin_gun_sayisi'] = pd.to_numeric(df['izin_gun_sayisi'], errors='coerce')
    
    # yarım gün flag'leri bool
    for col in ['izne_baslama_yarim_gun_mu', 'goreve_baslama_yarim_gun_mu']:
        if col in df.columns:
            df[col] = df[col].astype(str).str.strip().str.lower().map(
                {'evet': True, 'hayir': False, 'hayır': False, 
                 '1': True, '0': False, 'true': True, 'false': False,
                 'e': True, 'h': False}
            ).fillna(False)
    
    print(f"[load_izin] {len(df)} izin kaydı yüklendi")
    print(f"  izin tipi dağılımı: {df['izin_tipi'].value_counts().head(10).to_dict()}")
    if 'izin_tipi_2' in df.columns:
        print(f"  izin tipi 2 dağılımı: {df['izin_tipi_2'].value_counts().head(10).to_dict()}")
    
    return df


