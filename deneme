o = pd.DataFrame({"biz": bas_biz["outsource"], "ekip": bas_ekip["outsource"]}).fillna(0)
o.index = pd.to_datetime(o.index)
o = o[(o.index.year == YEAR) & (o.index.month == MONTH)]
o["hafta"] = o.index.isocalendar().week
o["hs"] = o.index.weekday >= 5
t = o.groupby(["hafta", "hs"])[["biz", "ekip"]].sum().unstack("hs").fillna(0)
t.columns = [f"{a}_{'hafta sonu' if b else 'hafta içi'}" for a, b in t.columns]
t["biz_top"] = o.groupby("hafta")["biz"].sum()
t["ekip_top"] = o.groupby("hafta")["ekip"].sum()
t["gun"] = o.groupby("hafta").size()
t["ekip_ima_kisi"] = (t["ekip_top"] / (t["gun"] * 0.8)).round(0)
print(t.fillna(0).astype(int).to_string())
print("AY:", int(o["biz"].sum()), "biz  /", int(o["ekip"].sum()), "ekip")
