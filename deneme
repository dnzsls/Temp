import pandas as pd

# ─── CONFIG: Sen sadece burayı değiştirirsin ───
# Lokasyon → Takım kodu → kişi sayısı
AGENT_CONFIG = {
    "L1": {
        "T01": 5,   # dummy sayılar, sen gerçeğini yaz
        "T02": 4,
        "T03": 6,
        "T04": 3,
        "T05": 5,
        "T06": 4,
    },
    "L2": {
        "T01": 3, "T02": 3, "T03": 3, "T04": 3, "T05": 3,
        "T06": 3, "T07": 3, "T08": 3, "T09": 3, "T10": 3,
        "T11": 3,
    },
    "L3_L4": {
        "T01": 3, "T02": 3, "T03": 3, "T04": 3, "T05": 3,
        "T06": 3, "T07": 3, "T08": 3, "T09": 3, "T10": 3,
    },
    "L5": {
        "T01": 3, "T02": 3, "T03": 3, "T04": 3, "T05": 3,
        "T06": 3,
    },
}

def generate_dummy_agents(config):
    """
    Girdi:  config dict → lokasyon: {takim_kodu: kisi_sayisi, ...}
    Çıktı:  df_agents → her satır bir agent
    """
    rows = []
    
    # 1. DIŞ DÖNGÜ: Her lokasyonu dolaş
    for lokasyon, takimlar in config.items():
        # lokasyon = "L1"
        # takimlar = {"T01": 5, "T02": 4, "T03": 6, ...}
        
        # 2. ORTA DÖNGÜ: O lokasyondaki her takımı dolaş
        for takim_kodu, kisi_sayisi in takimlar.items():
            # takim_kodu = "T01", kisi_sayisi = 5
            
            takim_adi = f"{lokasyon}_{takim_kodu}"
            # → "L1_T01"
            
            # 3. İÇ DÖNGÜ: O takımdaki her kişiyi üret
            for k in range(1, kisi_sayisi + 1):
                # kisi_sayisi=5 → k = 1, 2, 3, 4, 5
                
                agent_id = f"KIT_{lokasyon}_{takim_kodu}_{k:03d}"
                # → "KIT_L1_T01_001", "KIT_L1_T01_002", ...
                
                rows.append({
                    "agent_id": agent_id,
                    "kuyruk": "kitle",
                    "lokasyon": lokasyon,
                    "takim": takim_adi,
                    "tip": "inhouse",
                    "gunluk_saat": 9,
                    "haftalik_gun": 6,
                    "gece_calisabilir": True,
                    "haftasonu_calisabilir": True,
                    "aktif": True,
                })
    
    df = pd.DataFrame(rows)
    return df


# ─── ÇALIŞTIR VE ÇIKTIYI GÖSTER ───
print("=" * 60)
print("GİRDİ: AGENT_CONFIG")
print("=" * 60)
for lok, takimlar in AGENT_CONFIG.items():
    toplam = sum(takimlar.values())
    detay = ", ".join([f"{t}:{s}" for t, s in takimlar.items()])
    print(f"  {lok:8s} → {len(takimlar)} takım, toplam {toplam} agent")
    print(f"           ({detay})")

df_agents = generate_dummy_agents(AGENT_CONFIG)

print(f"\n{'=' * 60}")
print(f"ÇIKTI: df_agents  →  shape: {df_agents.shape}")
print(f"{'=' * 60}")

print(f"\nİlk 8 satır:")
print(df_agents.head(8).to_string(index=False))

print(f"\nTakım bazlı kişi sayıları:")
print(df_agents.groupby(["lokasyon", "takim"])["agent_id"].count().to_string())

print(f"\nLokasyon bazlı toplam:")
print(df_agents.groupby("lokasyon")["agent_id"].count().to_string())
print(f"\nToplam agent: {len(df_agents)}")
