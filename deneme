import pandas as pd

q = "kitle"
resolve = run_week_all_queues.__globals__["_resolve_kadro"]
kadro = CONFIG_WEEKDAY["surplus_distribution"]["total_kadro"][q]["inhouse"]

rows = []
for ds, r in sorted(results.items()):
    if pd.Timestamp(ds).weekday() >= 5:
        continue
    qr = (r or {}).get(q)
    if not qr:
        continue

    mi = qr["mip_info"]
    kullanilan = mi["total_inhouse_kisi"]
    tavan = resolve(kadro, ds)
    rows.append({
        "tarih": ds,
        "inhouse": kullanilan,
        "kadro_tavani": tavan,
        "bos_kadro": tavan - kullanilan,
    })

print(pd.DataFrame(rows).to_string(index=False))
