def durum_belirle(row):
    tarih = pd.to_datetime(row['tarih'])
    is_weekend = tarih.weekday() >= 5
    
    # 1. O tarihte aktif mi?
    end_date = pd.to_datetime(row.get('end_date'), errors='coerce')
    start_date = pd.to_datetime(row.get('start_date'), errors='coerce')
    
    if pd.notna(end_date) and end_date < tarih:
        return 'pasif'
    if pd.notna(start_date) and start_date > tarih:
        return 'pasif'
    
    # 2. İzin kaydı var mı?
    if pd.notna(row.get('izin_tipi')):
        return 'izinli'
    
    # 3. Müsait
    return 'musait'
