# =============================================================================
# AYLIK İNHOUSE KADRO — yazılabilir agent (NET) sayısından (Model-1'den ÖNCE)
# =============================================================================
# Model-1'e yazılacak inhouse kadroyu (CONFIG['kadro']['inhouse'][kuyruk]
# hafta_1..hafta_N) her gün "o gün yazılabilir agent" sayısından çıkarır.
# Kendi içinde hesaplar — Model-2 notebook'una ve pickle'a BAĞLI DEĞİL.
# Kurallar Model-2 (v7_gpt) HÜCRE 4-7 + 8D ile aynı:
#   agent   : kuyruk (line_based_main_group) · PT (kismi_calisan_flg) ve eğitim ekibi hariç
#   izin    : df_izin (öncelikli) + df_off gun_N · idari/doğum izni → tüm ay ·
#             Pzt..Cuma izinli flag'leri (süt izni: resmi tatil haftasında emilir) ·
#             hamile/süt: hafta içi off_t/off_t2 → izin, hafta sonu izinleri atılır
#   yazılamaz zinciri (tek sebep): izin > off_t2 > hamile/süt hafta sonu >
#             mesaiye kalamaz resmi tatil > (hamile/süt/mesai) arife
#   NET     = tam zamanlı agent − yazılamaz           (off_t YUMUŞAK → düşülmez)
#
# GİRDİLER (kernel'de; SQL'den çektiğin haliyle — ham ya da düzenlenmiş):
#   df_agents : agent_user_code · line_based_main_group · teamleader_name · *_flg …
#   df_izin   : agent_user_code · tarih · izin_tipi (izin / off_t / off_t2)
#   df_off    : agent_user_code · izin_tipi · gun_1 .. gun_31      (yoksa atlanır)
#
# ÇIKTI: gün gün tablo · hafta önerisi (hafta içi NET ort − NORM_PAYI) ·
#        Model-1 HÜCRE 3'e yapıştırılacak satır
#
# SIRA: tabloları çek → K1 → K2 → K3
# =============================================================================


# %% [K1] — Ayarlar
import calendar
import datetime as dt
import pandas as pd

YIL, AY = 2026, 10
QUEUE = "kitle"
RESMI_TATILLER = ["2026-10-29"]          # Ekim: 29 Ekim Cumhuriyet Bayramı
ARIFE_GUNLERI = ["2026-10-28"]           # Ekim: 28 Ekim öğleden sonra
NORM_PAYI = 12                           # kişi/gün — hafta sonuna NORM olarak giden pay (Eylül ölçümü)

GUNLER = [dt.date(YIL, AY, g) for g in range(1, calendar.monthrange(YIL, AY)[1] + 1)]
GUN_SET = set(GUNLER)
TATIL = {dt.date.fromisoformat(t) for t in RESMI_TATILLER}
ARIFE = {dt.date.fromisoformat(t) for t in ARIFE_GUNLERI}
GUN_TR = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz"]


# %% [K2] — Yazılabilir agent (NET) hesabı
def _kucuk(df):
    d = df.copy()
    d.columns = [str(c).strip().lower() for c in d.columns]
    return d


def _flag(seri):
    return pd.to_numeric(seri, errors="coerce").fillna(0).astype(int) == 1


# ---- agent listesi (H4 kuyruk · H5 PT + eğitim) ----
_ag = _kucuk(df_agents).fillna("")
_ag = _ag[_ag["line_based_main_group"].astype(str).str.strip() == f"{QUEUE}_cagrilar"]
_pt = _flag(_ag["kismi_calisan_flg"]) if "kismi_calisan_flg" in _ag else False
_eg = _ag["teamleader_name"].astype(str).str.lower().str.contains("eğit|egit", na=False)
_ag = _ag[~_pt & ~_eg].copy()
_ag["agent_user_code"] = _ag["agent_user_code"].astype(str).str.strip()
AGENTS = list(_ag["agent_user_code"])


def _f(row, kol):
    return pd.to_numeric(row.get(kol, 0), errors="coerce") == 1


# ---- tarih → tip (H7-1): df_izin önce (öncelikli), df_off gün kolonları sonra ----
_BILINEN = {"izin", "off_t", "off_t2"}
tip_map = {}
_iz = globals().get("df_izin")
if _iz is not None:
    _iz = _kucuk(_iz)
    _iz["tarih"] = pd.to_datetime(_iz["tarih"], errors="coerce").dt.date
    _iz["izin_tipi"] = _iz["izin_tipi"].astype(str).str.strip().str.lower()
    _iz = _iz[_iz["tarih"].isin(GUN_SET) & _iz["izin_tipi"].isin(_BILINEN)]
    for a, t, tp in zip(_iz["agent_user_code"].astype(str).str.strip(), _iz["tarih"], _iz["izin_tipi"]):
        tip_map.setdefault(a, {})[t] = tp
else:
    print("⚠ df_izin yok → izinler düşülmedi, NET olduğundan YÜKSEK çıkar")
_of = globals().get("df_off")
if _of is not None:
    _of = _kucuk(_of)
    _gk = [c for c in _of.columns if c.startswith("gun_")]
    _of[_gk] = _of[_gk].apply(pd.to_numeric, errors="coerce").fillna(0).astype(int)
    _tipli = "izin_tipi" in _of.columns
    for _, r in _of.iterrows():
        tp = str(r["izin_tipi"]).strip().lower() if _tipli else "izin"
        if tp not in _BILINEN:
            continue
        a = str(r["agent_user_code"]).strip()
        for c in _gk:
            if r[c] == 1:
                try:
                    t = dt.date(YIL, AY, int(c.split("_")[1]))
                except ValueError:
                    continue
                tip_map.setdefault(a, {}).setdefault(t, tp)     # df_izin'dekini ezmez
else:
    print("⚠ df_off yok → off_t2'ler düşülmedi")

# ---- agent başına izin / off_t2 / off_t (H7-3) ----
_HAFTAICI = {"pazartesi_izinli_flg": 0, "sali_izinli_flg": 1, "carsamba_izinli_flg": 2,
             "persembe_izinli_flg": 3, "cuma_izinli_flg": 4}
_tatil_hafta = {d.isocalendar()[:2] for d in TATIL if d.weekday() < 5}
izin_map, off2_map, off1_map = {}, {}, {}
hs_yasak, mesai_yok = set(), set()
for _, r in _ag.iterrows():
    a = r["agent_user_code"]
    izin, off2, off1 = set(), set(), set()
    for t, tp in tip_map.get(a, {}).items():
        (izin if tp == "izin" else off2 if tp == "off_t2" else off1).add(t)
    if _f(r, "idari_izinli_flg") or _f(r, "dogum_izni_flg"):
        izin |= GUN_SET
    sut, hamile = _f(r, "sut_izni_flg"), _f(r, "hamile_flg")
    for kol, wd in _HAFTAICI.items():
        if _f(r, kol):
            g = {d for d in GUNLER if d.weekday() == wd}
            if sut:
                g = {d for d in g if d.isocalendar()[:2] not in _tatil_hafta}
            izin |= g
    if sut or hamile:
        hs_yasak.add(a)
        izin |= {d for d in (off2 | off1) if d.weekday() < 5}
        off2, off1 = set(), set()
        izin = {d for d in izin if d.weekday() < 5}
    if _f(r, "mesaiye_kalamaz_flg"):
        mesai_yok.add(a)
    izin_map[a], off2_map[a], off1_map[a] = izin, off2, off1
arife_kis = hs_yasak | mesai_yok

# ---- gün gün yazılabilir agent (H8D zinciri) ----
_sat = []
for d in GUNLER:
    hs, tt, ar = d.weekday() >= 5, d in TATIL, d in ARIFE
    say = {"izin": 0, "off_t2": 0, "hs_y": 0, "tat_y": 0, "ari_y": 0, "off_t": 0}
    for a in AGENTS:
        if d in izin_map[a]:
            say["izin"] += 1
        elif d in off2_map[a]:
            say["off_t2"] += 1
        elif hs and a in hs_yasak:
            say["hs_y"] += 1
        elif tt and a in mesai_yok:
            say["tat_y"] += 1
        elif ar and a in arife_kis:
            say["ari_y"] += 1
        elif d in off1_map[a]:
            say["off_t"] += 1                       # yazılabilir ama off talebi var (bilgi)
    yaz = say["izin"] + say["off_t2"] + say["hs_y"] + say["tat_y"] + say["ari_y"]
    _sat.append({"tarih": d.isoformat(), "gun": GUN_TR[d.weekday()],
                 "hs": int(hs), "tatil": int(tt), "arife": int(ar), "toplam": len(AGENTS),
                 **say, "yazilamaz": yaz, "net": len(AGENTS) - yaz})
df_net = pd.DataFrame(_sat)
print(f"{QUEUE}: tam zamanlı agent {len(AGENTS)} · hamile/süt {len(hs_yasak)} · "
      f"mesaiye kalamaz {len(mesai_yok)} · izin/off kaydı olan {len(tip_map)}")


# %% [K3] — NET → Model-1 inhouse kadro önerisi
def _hafta_no(d):
    """Model-1'in hafta_N tanımı: ayın 1'i hafta_1, her Pazartesi yeni hafta, ay sınırı geçmez."""
    return (d.day - 1 + d.replace(day=1).weekday()) // 7 + 1


df_net["hafta"] = [f"hafta_{_hafta_no(dt.date.fromisoformat(t))}" for t in df_net["tarih"]]
pd.set_option("display.width", 200)
print("=== GÜN GÜN (yazılabilir agent) ===")
print(df_net[["tarih", "gun", "hafta", "hs", "tatil", "arife", "toplam", "izin", "off_t2",
              "hs_y", "tat_y", "ari_y", "net", "off_t"]].to_string(index=False))

_hi = df_net[(df_net["hs"] == 0) & (df_net["tatil"] == 0)]
_oz = (_hi.groupby("hafta")
       .agg(ilk=("tarih", "min"), son=("tarih", "max"), gun=("net", "size"),
            net_ort=("net", "mean"), net_min=("net", "min"), net_max=("net", "max")))
_oz = _oz.reindex(sorted(_oz.index, key=lambda h: int(h.split("_")[1])))
_oz["kadro_onerisi"] = (_oz["net_ort"] - NORM_PAYI).round().astype(int)
print(f"\n=== HAFTA (hafta içi, tatil hariç) — kadro_onerisi = NET ort − {NORM_PAYI} ===")
print(_oz.round(1).to_string())

_hs = df_net[df_net["hs"] == 1]
if len(_hs):
    print(f"\nhafta sonu NET ort: {_hs['net'].mean():.0f}  (bilgi — Model-1'de h.sonu inhouse tavanı yok)")

_kadro = {h: int(v) for h, v in _oz["kadro_onerisi"].items()}
_kadro["default"] = int(round(_oz["kadro_onerisi"].mean()))
print("\n# ---- Model-1 HÜCRE 3'e yapıştır ----")
print(f"CONFIG['kadro']['inhouse']['{QUEUE}'].update(\n    {_kadro})")
if TATIL:
    print(f"# NOT: tatil {sorted(t.isoformat() for t in TATIL)} ortalamaya katılmadı; "
          f"Model-1 sabit hafta içi kadroyu o güne de uygular.")
