mip_ihtiyac = {}                      # (gün, vardiya) → surplus öncesi MIP ihtiyacı
for ds, r in results.items():
    q = (r or {}).get(QUEUE)
    if not q:
        continue
    mi = q["mip_info"]
    sc = mi.get("shift_coverage", {})
    s1 = (mi.get("mip_info_stage1") or q.get("mip_info_stage1") or {}).get("assignments")
    for v, kisi in mi.get("assignments", {}).items():
        if kisi > 0 and sc.get(v, {}).get("company") == "inhouse":
            mip_ihtiyac[(ds, v)] = (int(kisi) if s1 is None
                                    else max(0, min(int(kisi), int(s1.get(v, 0) or 0))))
print(f"mip_ihtiyac: {len(mip_ihtiyac)} kova  |  surplus'lu kova "
      f"{sum(1 for k, m in mip_ihtiyac.items() if m < talep.get(k, m))}")
