SELECT off_gun, COUNT(*) AS ajan_sayisi
FROM (
    SELECT AGENT_USER_CODE,
           SUM(CASE WHEN LOWER(VARDIYA) = 'off' OR LOWER(CALISMAMA_TIPI) = 'off' THEN 1 ELSE 0 END) AS off_gun,
           SUM(CASE WHEN VARDIYA LIKE '%:%' THEN 1 ELSE 0 END) AS calisma_gun
    FROM BNS_VP_IS_BIRIMI_PLAN_OUTSOURCE_092026
    GROUP BY AGENT_USER_CODE
)
GROUP BY off_gun
ORDER BY off_gun;
