# Günler: slot tablosundaki günler (ekip planı + gerçek çağrı olan, SON_GUN'e kadar). PT: KISMI_DAHIL
def _bas_slot(metin):
    sl = _vardiya_slotlari(metin)
    return sl[0][1] if sl else None


def giris_tablosu(results, roster_gun, df_ekip, gunler, queue=QUEUE, kismi=KISMI_DAHIL):
    """→ taraf · tarih · slot (başlangıç) · sirket · kisi"""
    sat = []
    for t, vardiyalar in roster_gun.items():                 # Analitik Model inhouse: Model-2
        if t.isoformat() in gunler:
            for v in vardiyalar:
                b = _bas_slot(v)
                if b:
                    sat.append(("Analitik Model", t, b, "inhouse", 1))
    for ds, r in results.items():                            # Analitik Model outsource + PT: Model-1
        if ds not in gunler:
            continue
        mi = ((r or {}).get(queue) or {}).get("mip_info", {}) or {}
        cov = mi.get("shift_coverage", {}) or {}
        for s, k in (mi.get("assignments") or {}).items():
            c = cov.get(s, {})
            sk = c.get("company")
            if k <= 0 or sk not in ("outsource", "part_time") or (sk == "part_time" and not kismi):
                continue
            b = (c.get("slots") or [None])[0]
            if b:
                sat.append(("Analitik Model", dt.date.fromisoformat(ds), b, sk, int(k)))
    d = df_ekip                                               # Planlama Ekibi: df_ekip
    kt = _kol(d, "working_date", "tarih", "date", "data_date")
    kv, kn = _kol(d, "vardiya"), _kol(d, "kisi_sayisi", "count(*)", "count")
    ko, kp = _kol(d, "outsource_flg"), _kol(d, "kismi_flg")
    for t, v, n, o, p in zip(pd.to_datetime(d[kt]).dt.date, d[kv], d[kn],
                             d[ko] if ko else [0] * len(d), d[kp] if kp else [0] * len(d)):
        if t.isoformat() not in gunler:
            continue
        sk = ("part_time" if pd.to_numeric(p, errors="coerce") == 1 else
              "outsource" if pd.to_numeric(o, errors="coerce") == 1 else "inhouse")
        b = _bas_slot(v)
        if b and not (sk == "part_time" and not kismi):
            sat.append(("Planlama Ekibi", t, b, sk, int(pd.to_numeric(n, errors="coerce") or 0)))
    df = pd.DataFrame(sat, columns=["taraf", "tarih", "slot", "sirket", "kisi"])
    df["hafta_sonu"] = [int(t.weekday() >= 5) for t in df["tarih"]]
    return df


