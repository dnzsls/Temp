    "A_slotcap_erlang": "",     # pickle yolu
    "B_slotcap_kaprr":  "",
    "C_kap_denge":      "",
    # yayma karşılaştırması (C + yayma): boş bırakılan atlanır
    "D_kap_denge_yayma50":  "",
    "E_kap_denge_yayma500": "",
}
KUYRUKLAR = ("kitle", "kurumsal", "gold")
GECE = ("00:00", "07:00")     # [başlangıç, bitiş)
CIKTI = "senaryo_karsilastirma.xlsx"
TESHIS_KUYRUK = "kitle"                      # HÜCRE 5 teşhis tabloları bu kuyruk için
TESHIS_SAAT = [f"{h:02d}" for h in range(8, 21)]   # teşhis tablolarında gösterilen saatler


# %% [HÜCRE 2] — Fonksiyonlar
SLOTS = [f"{h:02d}:{m:02d}" for h in range(24) for m in (0, 30)]
GUN_TR = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Pzr"]


def _oran(tbl, saat, vars_):
    tbl = tbl or {}
    return tbl.get(saat, tbl.get("default", vars_))


def _kap(sahadaki, cagri, slot, hr):
    """(kapasite_cagri, Kap_RR) — Model-1 Excel raporuyla aynı formül."""
    h = int(slot[:2])
    net = (sahadaki - round(sahadaki * _oran(hr.get("rapor_etkisi"), h, 0))
           - round(sahadaki * _oran(hr.get("kapasite_kaybi"), h, 0)))
    ck = net * (_oran(hr.get("cagri_adedi"), h, 15) / 2)
    return ck, ((ck / cagri) if cagri > 0 else None)


def slot_tablosu(results, senaryo):
    """pickle → slot satırları (senaryo, kuyruk, tarih, slot, çağrı, ihtiyaç, sahadaki, Kap_RR …)."""
    sat = []
    for ds in sorted(results):
        for q in KUYRUKLAR:
            rq = (results.get(ds) or {}).get(q)
            if not rq:
                continue
            mi = rq.get("mip_info", {}) or {}
            cagri = rq.get("calls_by_slot", {}) or {}
            erl = mi.get("erlang_by_slot_ham") or rq.get("erlang_by_slot") or {}
            saha = mi.get("fiili_by_slot") or mi.get("mip_by_slot") or {}
            hr = (rq.get("_config") or {}).get("hourly_report") or {}
            d = dt.date.fromisoformat(ds)
            for s in SLOTS:
                c = float(cagri.get(s, 0) or 0)
                e = float(erl.get(s, 0) or 0)
                if c <= 0 and e <= 0:
                    continue
                n = int(saha.get(s, 0) or 0)
                ck, kr = _kap(n, c, s, hr)
                sat.append({"senaryo": senaryo, "kuyruk": q, "tarih": d,
                            "gun": GUN_TR[d.weekday()], "hafta_ici": d.weekday() < 5,
                            "slot": s, "gece": GECE[0] <= s < GECE[1],
                            "cagri": c, "ihtiyac": e, "sahadaki": n,
                            "eksik": max(0.0, e - n), "fazla": max(0.0, n - e),
                            "kapasite": ck, "karsilanan": max(0.0, min(ck, c)), "Kap_RR": kr})
    return pd.DataFrame(sat)


def vardiya_sayisi(results, senaryo):
    """hafta içi gün başına açık (kişi>0) vardiya sayısı — şirket bazında ortalama."""
    sat = []
    for ds in sorted(results):
        if dt.date.fromisoformat(ds).weekday() >= 5:
            continue
        for q in KUYRUKLAR:
            rq = (results.get(ds) or {}).get(q)
            if not rq:
                continue
            mi = rq.get("mip_info", {}) or {}
            sc = mi.get("shift_coverage", {}) or {}
            say = {}
            for s, k in (mi.get("assignments") or {}).items():
                if k > 0:
                    co = (sc.get(s) or {}).get("company", "?")
                    say[co] = say.get(co, 0) + 1
            sat.append({"senaryo": senaryo, "kuyruk": q, "tarih": ds, **say})
    df = pd.DataFrame(sat).fillna(0)
    if not len(df):
        return df
    kol = [c for c in ("inhouse", "outsource", "part_time") if c in df.columns]
    return (df.groupby(["senaryo", "kuyruk"])[kol].mean().round(1)
            .rename(columns={c: f"vardiya_{c}" for c in kol}).reset_index())


def baslangic_dagilimi(results, senaryo):
    """hafta içi gün ortalaması: başlangıç saati × şirket → kişi."""
    sat = []
    gunler = [ds for ds in sorted(results) if dt.date.fromisoformat(ds).weekday() < 5]
    for ds in gunler:
        for q in KUYRUKLAR:
            rq = (results.get(ds) or {}).get(q)
            if not rq:
                continue
            mi = rq.get("mip_info", {}) or {}
            sc = mi.get("shift_coverage", {}) or {}
            for s, k in (mi.get("assignments") or {}).items():
                if k > 0:
                    c = sc.get(s) or {}
                    sat.append({"senaryo": senaryo, "kuyruk": q, "tarih": ds,
                                "sirket": c.get("company", "?"),
                                "baslangic": str(c.get("start", "?"))[:5], "kisi": k})
    df = pd.DataFrame(sat)
    if not len(df):
        return df
    g = (df.groupby(["senaryo", "kuyruk", "sirket", "baslangic"])["kisi"].sum()
         / max(1, len(gunler))).round(1)
    return g.reset_index()


def yigilma(df_bas):
    """inhouse en kalabalık başlangıç: kişi, inhouse payı, %10+ alan başlangıç sayısı."""
    d = df_bas[df_bas["sirket"] == "inhouse"]
    sat = []
    for (sen, q), g in d.groupby(["senaryo", "kuyruk"]):
        top = g["kisi"].sum()
        en = g.loc[g["kisi"].idxmax()]
        sat.append({"senaryo": sen, "kuyruk": q,
                    "inhouse_en_kalabalik_baslangic": en["baslangic"],
                    "inhouse_en_kalabalik_kisi": en["kisi"],
                    "inhouse_en_kalabalik_payi": (en["kisi"] / top) if top else None,
                    "inhouse_%10_ustu_baslangic_sayisi": int((g["kisi"] >= 0.10 * top).sum())})
    return pd.DataFrame(sat)


def ozet(df, anahtar):
    def _f(g):
        gun = g[~g["gece"]]
        gc = g[g["gece"]]
        k = gun["Kap_RR"].dropna()
        E, C = g["ihtiyac"].sum(), g["cagri"].sum()
        return pd.Series({
            "Erlang_karsilama": (1 - g["eksik"].sum() / E) if E else None,
            "Kap_RR": (g["karsilanan"].sum() / C) if C else None,
            "eksik_kisi_slot": round(g["eksik"].sum()),
            "fazla_kisi_slot": round(g["fazla"].sum()),
            "gunduz_KapRR_ort": k.mean() if len(k) else None,
            "gunduz_KapRR_yayilma": k.std() if len(k) > 1 else None,
            "gunduz_KapRR_p10": k.quantile(0.10) if len(k) else None,
            "gunduz_KapRR_p90": k.quantile(0.90) if len(k) else None,
            "gunduz_%98_102_payi": ((k >= 0.98) & (k <= 1.02)).mean() if len(k) else None,
            "gunduz_%90_110_payi": ((k >= 0.90) & (k <= 1.10)).mean() if len(k) else None,
            "gece_KapRR_ort": gc["Kap_RR"].dropna().mean() if len(gc) else None,
            "gece_fazla_kisi_slot": round(gc["fazla"].sum()),
        })
    return df.groupby(anahtar).apply(_f).reset_index()


# %% [HÜCRE 3] — Hesapla
_parcalar, _vard, _bas, _res = [], [], [], {}
for ad, yol in SENARYOLAR.items():
    if not yol:
        print(f"  ⚠ {ad}: pickle yolu boş → atlandı")
        continue
    with open(yol, "rb") as f:
        res = pickle.load(f)
    _parcalar.append(slot_tablosu(res, ad))
    _vard.append(vardiya_sayisi(res, ad))
    _bas.append(baslangic_dagilimi(res, ad))
    _res[ad] = res                          # HÜCRE 5 teşhis için
    print(f"  ✓ {ad}: {len(res)} gün  ({yol})")

df_slot = pd.concat(_parcalar, ignore_index=True)
df_bas = pd.concat(_bas, ignore_index=True)
df_ozet = (ozet(df_slot, ["kuyruk", "senaryo"])
           .merge(pd.concat(_vard, ignore_index=True), on=["kuyruk", "senaryo"], how="left")
           .merge(yigilma(df_bas), on=["kuyruk", "senaryo"], how="left"))
# başlangıç saati × senaryo (hafta içi gün ortalaması kişi), şirket ayrı
df_baslangic = (df_bas.pivot_table(index=["kuyruk", "sirket", "baslangic"], columns="senaryo",
                                   values="kisi", aggfunc="sum", fill_value=0)
                .reset_index())
df_gun = ozet(df_slot, ["kuyruk", "tarih", "gun", "senaryo"])
# saat profili (hafta içi): her saatin ortalama Kap_RR'ı — dağılımın şekli
df_saat = (df_slot[df_slot["hafta_ici"]]
           .assign(saat=lambda d: d["slot"].str[:2] + ":00")
           .groupby(["kuyruk", "saat", "senaryo"])["Kap_RR"].mean()
