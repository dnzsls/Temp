_sorun = []
if HS_TEK_GUN:
    for a in hs_tek_normal:
        _blok = off_block_map.get(a, set())
        for cmt, pzr in hs_ciftleri:
            if not all(any((a, ds, v) in x for v in gun_vardiyalari[ds]) for ds in (cmt, pzr)):
                continue                      # hafta sonu günlerinden biri zaten off/izin → sorun yok
            gunler = haftalar[dt.date.fromisoformat(cmt).isocalendar()[:2]]
            _o2 = [ds for ds in gunler if dt.date.fromisoformat(ds) in _blok
                   and dt.date.fromisoformat(ds) not in TATIL]
            if len(_o2) >= MAX_HAFTA_OFF:
                _sorun.append((a, cmt, ", ".join(_o2)))
print(f"H18E + H20B çakışan agent-hafta: {len(_sorun)}")
print(pd.DataFrame(_sorun, columns=["agent", "cumartesi", "off_t2_gunleri"]).to_string(index=False))
