# %% [K2] — Model-2 hücrelerini çalıştır (H0 + H3 → H8D), pickle'sız
def _model2_kaynak(yol):
    if yol.endswith(".ipynb"):
        nb = json.load(open(yol, encoding="utf-8"))
        return "\n\n".join("".join(c["source"]) for c in nb["cells"] if c.get("cell_type") == "code")
    return open(yol, encoding="utf-8").read()


def _hucreler(kaynak):
    """'# %% [HÜCRE n]' işaretlerine göre böler → [(ad, kod), …] dosya sırasıyla."""
    isaret = list(re.finditer(r"^# %% \[HÜCRE ([0-9]+[A-Z]?)\]", kaynak, flags=re.M))
    return [(m.group(1), kaynak[m.start(): (isaret[i + 1].start() if i + 1 < len(isaret) else len(kaynak))])
            for i, m in enumerate(isaret)]


