# %% GEÇİCİ — MİNİMAL ÇELİŞKİ: hangi gruplar GERÇEKTEN gerekli? (deletion filter)
# Her grubu tek tek çıkarır; model yine INFEASIBLE ise o grup masumdur → atılır.
# Grup çıkınca çözüm aranır; 60 sn'de bulunamazsa (UNKNOWN) grup GEREKLİ sayılır
# (temkinli taraf → liste biraz büyük kalabilir ama yanlış grup atılmaz).
import time

def _dene(gruplar, sure=60):
    model.ClearAssumptions()
    model.AddAssumptions([b for _, b in gruplar])
    _s = cp_model.CpSolver()
    _s.parameters.num_search_workers = 16
    _s.parameters.max_time_in_seconds = sure
    _s.parameters.stop_after_first_solution = True     # çözüm varsa ilkinde dur
    return _s.StatusName(_s.Solve(model))

_cekirdek = list(_teshis)
print(f"tam liste ({len(_cekirdek)} grup): {_dene(_cekirdek)}")
for _g in list(_cekirdek):
    _deneme = [h for h in _cekirdek if h is not _g]
    _t0 = time.time()
    _st = _dene(_deneme)
    print(f"  {_g[0]:<40} çıkarılınca: {_st:<10} ({time.time() - _t0:4.0f} sn)"
          + ("  → masum, atıldı" if _st == "INFEASIBLE" else "  → GEREKLİ"))
    if _st == "INFEASIBLE":
        _cekirdek = _deneme
print("\n★ MİNİMAL ÇELİŞKİ:", [g[0] for g in _cekirdek])
