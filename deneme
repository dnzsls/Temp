# %% [K2] — Model-2 hücrelerini çalıştır (H0 + H3 → H8D), pickle'sız
# YALNIZ "# %% [HÜCRE n]" başlıklı hücreler (ve aynı bölümün devamı) çalışır.
# Notebook'taki başlıksız hücreler (SQL bağlantısı, veri çekme, düzenleme) ve
# HÜCRE 0'dan önceki her şey ATLANIR → şifre sormaz; veriyi sen önceden çekiyorsun.
def _model2_hucreleri(yol):
    """→ {ad: kod}. .ipynb: başlıklı hücre + başlıksız devam hücreleri (HÜCRE 0 hariç:
    onun devamı SQL olabilir → yalnız başlıklı hücre). .py: bir sonraki başlığa kadar."""
    if yol.endswith(".ipynb"):
        nb = json.load(open(yol, encoding="utf-8"))
        hucre, ad = {}, None
        for c in nb["cells"]:
            if c.get("cell_type") != "code":
                continue
            kod = "".join(c["source"])
            m = re.search(r"^# %% \[HÜCRE ([0-9]+[A-Z]?)\]", kod, flags=re.M)
            if m:
                ad = m.group(1)
                hucre[ad] = kod
            elif ad is not None and ad != "0":
                hucre[ad] += "\n\n" + kod        # aynı bölümün devam hücresi
        return hucre
    kaynak = open(yol, encoding="utf-8").read()
    isaret = list(re.finditer(r"^# %% \[HÜCRE ([0-9]+[A-Z]?)\]", kaynak, flags=re.M))
    return {m.group(1): kaynak[m.start(): (isaret[k + 1].start() if k + 1 < len(isaret) else len(kaynak))]
            for k, m in enumerate(isaret)}


