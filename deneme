import pandas as pd
from ortools.sat.python import cp_model

# ─── Def 1, 2, 3'ü çalıştır ───
from def1_generate_agents_v2 import generate_dummy_agents, AGENT_CONFIG
from def2_parse_mip1_quotas import parse_mip1_quotas, DUMMY_MIP1_RESULT
from def3_build_model import build_assignment_model


def solve_and_extract(model, X, meta, time_limit=30):
    """
    Girdi:
        model      → Def 3 çıktısı: CP-SAT model (henüz çözülmemiş)
        X          → Def 3 çıktısı: karar değişkenleri dict
        meta       → Def 3 çıktısı: yardımcı bilgiler
        time_limit → max çözüm süresi (saniye)

    Çıktı:
        df_assignments → DataFrame: kim hangi gün hangi vardiya
                         Kolonlar: agent_id, gun, shift, lokasyon, takim
        solve_info     → dict: çözüm durumu, süre, bonus değeri
    """

    # ─── ADIM 1: Solver oluştur ve çöz ───
    solver = cp_model.CpSolver()
    solver.parameters.max_time_in_seconds = time_limit

    status = solver.Solve(model)

    status_map = {
        cp_model.OPTIMAL: "OPTIMAL",
        cp_model.FEASIBLE: "FEASIBLE",
        cp_model.INFEASIBLE: "INFEASIBLE",
        cp_model.MODEL_INVALID: "MODEL_INVALID",
        cp_model.UNKNOWN: "UNKNOWN",
    }
    status_str = status_map.get(status, str(status))

    print(f"  Çözüm durumu: {status_str}")
    print(f"  Çözüm süresi: {solver.WallTime():.2f} saniye")

    # Çözüm bulunamadıysa boş dön
    if status not in (cp_model.OPTIMAL, cp_model.FEASIBLE):
        print("  ❌ Çözüm bulunamadı!")
        return pd.DataFrame(), {"status": status_str}

    print(f"  Ekip bonus değeri: {solver.ObjectiveValue()}")

    # ─── ADIM 2: X değişkenlerinden sonuçları çek ───
    agents = meta["agents"]
    days = meta["days"]
    shifts = meta["shifts"]
    agent_info = meta["agent_info"]

    rows = []
    for a in agents:
        for d in days:
            for s in shifts:
                # solver.Value() → çözümdeki değeri döner (0 veya 1)
                if solver.Value(X[(a, d, s)]) == 1:
                    # Bu agent bu gün bu vardiyaya atanmış
                    rows.append({
                        "agent_id": a,
                        "gun": d,
                        "shift": s,
                        "lokasyon": agent_info[a]["lokasyon"],
                        "takim": agent_info[a]["takim"],
                        "shift_start": meta["shift_info"][s]["start"],
                    })

    df_assignments = pd.DataFrame(rows)

    # ─── ADIM 3: Atanmayan agentları bul ───
    atanan_agents = set(df_assignments["agent_id"].unique())
    tum_agents = set(agents)
    atanmayan = tum_agents - atanan_agents

    # Gün bazlı izinli listesi
    izinli_rows = []
    for a in agents:
        for d in days:
            gun_atandi = any(solver.Value(X[(a, d, s)]) == 1 for s in shifts)
            if not gun_atandi:
                izinli_rows.append({
                    "agent_id": a,
                    "gun": d,
                    "lokasyon": agent_info[a]["lokasyon"],
                    "takim": agent_info[a]["takim"],
                })

    df_izinli = pd.DataFrame(izinli_rows)

    # ─── ADIM 4: Özet bilgiler ───
    solve_info = {
        "status": status_str,
        "sure_sn": round(solver.WallTime(), 2),
        "ekip_bonus": solver.ObjectiveValue(),
        "toplam_atama": len(df_assignments),
        "toplam_izinli_gun": len(df_izinli),
        "benzersiz_atanan_agent": len(atanan_agents),
        "hic_atanmayan_agent": len(atanmayan),
    }

    return df_assignments, df_izinli, solve_info


# ─── ÇALIŞTIR VE ÇIKTIYI GÖSTER ───
if __name__ == "__main__":
    # Def 1
    df_agents = generate_dummy_agents(AGENT_CONFIG)

    # Def 2
    df_inhouse, _ = parse_mip1_quotas(
        DUMMY_MIP1_RESULT["assignments"],
        DUMMY_MIP1_RESULT["info"]["shift_coverage"]
    )

    # Def 3
    days = ["cumartesi", "pazar"]
    model, X, meta = build_assignment_model(df_agents, df_inhouse, days)

    # Def 4
    print("\n" + "=" * 60)
    print("DEF 4: ÇÖZÜM")
    print("=" * 60)

    df_assignments, df_izinli, solve_info = solve_and_extract(model, X, meta)

    print(f"\n{'=' * 60}")
    print("ÇIKTI 1: df_assignments (kim nereye atandı)")
    print("=" * 60)
    print(f"Shape: {df_assignments.shape}")
    print(f"\nİlk 15 satır:")
    print(df_assignments.head(15).to_string(index=False))

    print(f"\n{'=' * 60}")
    print("ÇIKTI 2: df_izinli (o gün atanmayanlar)")
    print("=" * 60)
    print(f"Shape: {df_izinli.shape}")
    print(f"\nİlk 10 satır:")
    print(df_izinli.head(10).to_string(index=False))

    print(f"\n{'=' * 60}")
    print("ÇIKTI 3: solve_info")
    print("=" * 60)
    for k, v in solve_info.items():
        print(f"  {k:30s} → {v}")

    print(f"\n{'=' * 60}")
    print("VARDIYA BAZLI DAĞILIM")
    print("=" * 60)
    pivot = df_assignments.groupby(["gun", "shift"])["agent_id"].count().unstack(fill_value=0)
    print(pivot.to_string())

    print(f"\n{'=' * 60}")
    print("LOKASYON BAZLI DAĞILIM")
    print("=" * 60)
    lok_pivot = df_assignments.groupby(["gun", "lokasyon"])["agent_id"].count().unstack(fill_value=0)
    print(lok_pivot.to_string())

    print(f"\n{'=' * 60}")
    print("TAKIM BÜTÜNLÜĞÜ ÖRNEĞİ (L1_T01)")
    print("=" * 60)
    t01 = df_assignments[df_assignments["takim"] == "L1_T01"]
    if len(t01) > 0:
        print(t01.to_string(index=False))
    else:
        print("  L1_T01 hiç atanmamış")
