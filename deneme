# =============================================================================
# AYLIK GENEL BAKIŞ — MODEL-2 (Analitik Model) ↔ Planlama Ekibi — GERÇEKLEŞEN ÇAĞRIYA GÖRE (2026-10-20)
# =============================================================================
# aylik_genel_bakis_v2'nin yeni kapasite ölçüleriyle sade hâli. Soru:
#   "Gerçekleşen çağrıya göre Analitik Model'in planı mı, Planlama Ekibi'nin planı mı daha iyi?"
#
# SAHADAKİ KİŞİ (yarım saat bazında, gece yarısını aşan kısım ertesi güne):
#   Analitik Model  : inhouse  → Model-2 pickle'ı (agent_cov_*.pkl → 'agent_plan': agent × gün × vardiya)
#          outsource + PT → Model-1 pickle'ı (Model-2 bunları planlamıyor)
#   Planlama Ekibi : df_ekip (SQL: WORKING_DATE · VARDIYA · KISI_SAYISI · OUTSOURCE_FLG · KISMI_FLG)
#          outsource vardiyası tabloda 30 dk kısa yazılıyor → bitişe +30 dk
#   Ayın 1'inin gecesi: önceki ayın son günü İKİ TARAFA DA df_ekip'ten (gerçek plan).
#
# İHTİYAÇ / KAPASİTE — hepsi GERÇEKLEŞEN çağrıdan, iki taraf için AYNI:
#   Erlang ihtiyacı : gerçek çağrı + alt-kuyruk ağırlıklı AHT → Erlang-C (ASA hedefi)
#                     + o gün tipinin shrinkage'ı  [ayarlar Model-1 pickle'ındaki config]
#   Kap (15 kuralı) : net kişi × 15/2 çağrı (net = sahadaki − rapor − kayıp)
#   AHT kapasitesi  : net kişi × 1800 sn ÷ AHT
#
# ÖLÇÜLER (gün/saat/ay — fazla saat açık saati ÖRTMEZ):
#   Erlang_karsilama = 1 − Σ eksik ÷ Σ Erlang ihtiyacı          (KİŞİ)
#   Kap_RR           = Σ min(Kap kapasitesi, çağrı) ÷ Σ çağrı   (ÇAĞRI, iş birimi)
#   AHT_RR           = Σ min(AHT kapasitesi, çağrı) ÷ Σ çağrı   (ÇAĞRI, model AHT'si)
#
# Hücreleri notebook'a sırayla yapıştır.
# =============================================================================


# %% [HÜCRE 1] — Ayarlar
import os, re, math, pickle
import datetime as dt
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

YEAR, MONTH = 2026, 10
QUEUE = "kitle"

PKL_PATH = ""        # Model-1 pickle (outsource + PT + config)
M2_PKL_PATH = ""     # Model-2 pickle'ı (agent_cov_kitle_2026_10.pkl) — inhouse buradan
CIKTI = f"genel_bakis_model2_{QUEUE}_{YEAR}_{MONTH:02d}.xlsx"
GRAFIK_KLASOR = "."  # PNG'ler buraya

SON_GUN = None       # çağrı verisi ayın sonuna kadar yoksa son TAM gün: '2026-10-19'
OUTSOURCE_EK_DK = 30 # ekip tablosunda outsource bitişine eklenecek dk
KISMI_DAHIL = True   # PT sahadaki kişiye dahil (Model-1 sahadakisi PT'yi içeriyor)

# GİRDİLER (kernel'de tanımlı olmalı):
#   df_ekip   : WORKING_DATE · VARDIYA · KISI_SAYISI · OUTSOURCE_FLG · KISMI_FLG
#               (ayın 1'i gecesi için önceki ayın son günü de olsun)
#   df_actual : data_date · min_time_period_value · line_based_main_group ·
#               resource_group_key · nof_call         (gerçekleşen, uzun format)
#   df_aht    : (opsiyonel) saat · sub_queue · line_based_main_group · weighted_avg_aht
#               yoksa AHT Model-1 pickle'ındaki config'ten


# %% [HÜCRE 2] — Fonksiyonlar
# İki taraf: Analitik Model (Model-1 + Model-2) · Planlama Ekibi (df_ekip)
# Kolon ön ekleri model_* / planlama_* · grafik adları AD'den
AD = {"model": "Analitik Model", "planlama": "Planlama Ekibi"}
SLOTS = [f"{h:02d}:{m:02d}" for h in range(24) for m in (0, 30)]
GUN_TR = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Pzr"]
_SAAT_RE = re.compile(r"(\d{1,2})[:.](\d{2})\s*[-–—]\s*(\d{1,2})[:.](\d{2})")
_BOS = lambda: {"inhouse": 0, "outsource": 0, "part_time": 0}


def _kol(df, *adaylar):
    m = {str(c).strip().lower(): c for c in df.columns}
    for a in adaylar:
        if a in m:
            return m[a]
    return None


def _vardiya_slotlari(metin, ek_dk=0):
    """'09:00-18:00' → [(gün_ofseti, slot), …]; bitiş ≤ başlangıç → ertesi gün."""
    m = _SAAT_RE.search(str(metin))
    if not m:
        return []
    h1, m1, h2, m2 = (int(x) for x in m.groups())
    b, e = h1 * 60 + m1, h2 * 60 + m2
    if e <= b:
        e += 1440
    e += ek_dk
    return [(t // 1440, SLOTS[(t % 1440) // 30]) for t in range(b - b % 30, e, 30)]


def _ekle(saha, tarih, metin, sirket, kisi, ek_dk=0):
    for ofs, s in _vardiya_slotlari(metin, ek_dk):
        g = (tarih + dt.timedelta(days=ofs)).isoformat()
        saha.setdefault(g, {}).setdefault(s, _BOS())[sirket] += kisi


def planlama_sahadaki(df_ekip, kismi=KISMI_DAHIL, ek_dk=OUTSOURCE_EK_DK):
    """df_ekip → ({tarih: {slot: {inhouse, outsource, part_time}}}, başlayan kişi tablosu)."""
    d = df_ekip.copy()
    kt = _kol(d, "working_date", "tarih", "date", "data_date")
    kv = _kol(d, "vardiya")
    kn = _kol(d, "kisi_sayisi", "count(*)", "count")
    ko, kp = _kol(d, "outsource_flg"), _kol(d, "kismi_flg")
    if None in (kt, kv, kn):
        raise KeyError(f"df_ekip kolonları eksik: {list(d.columns)}")
    d["_t"] = pd.to_datetime(d[kt]).dt.date
    d["_n"] = pd.to_numeric(d[kn], errors="coerce").fillna(0).astype(int)
    d["_s"] = np.where(pd.to_numeric(d[kp], errors="coerce").fillna(0) == 1 if kp else False,
                       "part_time",
                       np.where(pd.to_numeric(d[ko], errors="coerce").fillna(0) == 1 if ko else False,
                                "outsource", "inhouse"))
    if not kismi:
        d = d[d["_s"] != "part_time"]
    saha = {}
    for t, v, s, n in zip(d["_t"], d[kv], d["_s"], d["_n"]):
        _ekle(saha, t, v, s, n, ek_dk if s == "outsource" else 0)
    bas = d.groupby(["_t", "_s"])["_n"].sum().unstack(fill_value=0)
    return saha, bas


def model2_oku(yol=None):
    """Model-2 pickle'ı → {tarih: [vardiya, …]} (yalnız ÇALIŞILAN agent-gün).

    Pickle (H31): {'meta', 'interval', 'gun', 'agent_plan', 'atama'}.
    'agent_plan' kolonları: agent_user_code · date ('YYYY-MM-DD') · vardiya ('09:00-18:00') …
    Arife yarım vardiyası da satır olarak var → sahadaki kişiye girer.
    """
    yol = yol or M2_PKL_PATH
    with open(yol, "rb") as f:
        p = pickle.load(f)
    ap = p["agent_plan"] if isinstance(p, dict) else p
    out = {}
    for t, v in zip(pd.to_datetime(ap["date"]).dt.date, ap["vardiya"].astype(str)):
        if _SAAT_RE.search(v):
            out.setdefault(t, []).append(v)
    meta = p.get("meta", {}) if isinstance(p, dict) else {}
    print(f"Model-2 pickle: {sum(len(v) for v in out.values()):,} agent-gün · {len(out)} gün"
          + (f" · durum {meta.get('durum')}" if meta.get("durum") else ""))
    return out


def model_sahadaki(results, roster_gun, queue=QUEUE):
    """Analitik Model: inhouse Model-2 pickle'ından, outsource + PT Model-1 pickle'ından."""
    saha, bas = {}, {}
    for t, vardiyalar in roster_gun.items():
        if (t.year, t.month) != (YEAR, MONTH):
            continue        # önceki ay kolonları: gece sarkanı ekip tablosundan (çift sayılmasın)
        for v in vardiyalar:
            _ekle(saha, t, v, "inhouse", 1)
        bas.setdefault(t, _BOS())["inhouse"] = len(vardiyalar)
    for ds, r in results.items():
        rq = (r or {}).get(queue)
        if not rq:
            continue
        mi = rq.get("mip_info", {}) or {}
        cov = mi.get("shift_coverage", {}) or {}
        t = dt.date.fromisoformat(ds)
        ertesi = (t + dt.timedelta(days=1)).isoformat()
        for s, k in (mi.get("assignments") or {}).items():
            c = cov.get(s, {})
            sk = c.get("company")
            if k <= 0 or sk not in ("outsource", "part_time"):
                continue
            for sl in c.get("slots", []):
                saha.setdefault(ds, {}).setdefault(sl, _BOS())[sk] += k
            for sl in c.get("slots_d1", []):
                saha.setdefault(ertesi, {}).setdefault(sl, _BOS())[sk] += k
            bas.setdefault(t, _BOS())[sk] += k
    return saha, pd.DataFrame(bas).T.fillna(0).astype(int)


def gercek_cagri(df_actual, queue=QUEUE):
    """→ {tarih: {slot: çağrı}}, {(tarih, slot): {alt_kuyruk: çağrı}}"""
    d = df_actual.copy()
    kt = _kol(d, "data_date", "date", "tarih")
    ks = _kol(d, "min_time_period_value", "interval", "saat_dilimi")
    kg = _kol(d, "line_based_main_group")
    kq = _kol(d, "resource_group_key", "sub_queue", "alt_kuyruk")
    kn = _kol(d, "nof_call", "calls", "cagri")
    if kg:
        d = d[d[kg].astype(str).str.strip().str.lower() == f"{queue}_cagrilar"]
    d["_t"] = pd.to_datetime(d[kt]).dt.date.astype(str)

    def _slot(v):
        m = re.search(r"(\d{1,2})[:.](\d{2})", str(v))
        return f"{int(m.group(1)):02d}:{(int(m.group(2)) // 30) * 30:02d}" if m else None
    d["_s"] = d[ks].map(_slot)
    d["_n"] = pd.to_numeric(d[kn], errors="coerce").fillna(0)
    d = d.dropna(subset=["_s"])
    cagri = {}
    for (t, s), n in d.groupby(["_t", "_s"])["_n"].sum().items():
        cagri.setdefault(t, {})[s] = float(n)
    sq = {}
    if kq:
        for (t, s, q), n in d.groupby(["_t", "_s", kq])["_n"].sum().items():
            sq.setdefault((t, s), {})[str(q).strip()] = float(n)
    return cagri, sq


def aht_slot(cfg, sq_cagri, slot, df_aht=None, queue=QUEUE):
    """Alt-kuyruk çağrı payıyla ağırlıklı AHT (Model-1'in calculate_weighted_aht'i)."""
    h = int(slot[:2])
    if df_aht is not None:
        a = df_aht[df_aht["line_based_main_group"] == f"{queue}_cagrilar"]
        tbl = {str(q).strip(): float(x) for q, x in zip(a[a["saat"].astype(int) == h]["sub_queue"],
                                                         a[a["saat"].astype(int) == h]["weighted_avg_aht"])}
    else:
        sc = (cfg.get("sub_queues") or {}).get(queue, {})
        tbl = {q: float((sc.get("aht", {}).get(q, {})).get(h, sc.get("aht", {}).get(q, {}).get("default", 0)) or 0)
               for q in sc.get("queues", [])}
    tbl = {q: v for q, v in tbl.items() if v > 0}
    pay = {q: n for q, n in (sq_cagri or {}).items() if q in tbl and n > 0}
    if pay:
        return sum(n * tbl[q] for q, n in pay.items()) / sum(pay.values())
    return (sum(tbl.values()) / len(tbl)) if tbl else float(cfg.get("default_aht", 150))


def erlang_ihtiyac(cagri, aht, slot, ecfg):
    """Model-1 ile aynı: ASA ≤ hedef için en az kişi, ÷ (1 − shrinkage)."""
    if cagri <= 0 or aht <= 0:
        return 0
    trafik = cagri * (aht / 60) / ecfg.get("interval_minutes", 30)
    hedef = ecfg.get("target_asa", 30)

    def _asa(n):
        if n <= trafik:
            return 999
        eb = trafik / n
        for i in range(2, int(n) + 1):
            eb = (trafik * eb) / (i + trafik * eb)
        ec = min(eb / (1 - (trafik / n) * (1 - eb)), 1.0)
        return ec * aht / (n - trafik)
    n = math.ceil(trafik)
    while _asa(n) > hedef and n < trafik * 3 + 10:
        n += 1
    shr = ecfg.get("shrinkage", {})
    s = shr.get(int(slot[:2]), shr.get("default", 0)) if isinstance(shr, dict) else shr
    return math.ceil(n / (1 - s))


def _oran(tbl, h, vars_):
    tbl = tbl or {}
    return tbl.get(h, tbl.get("default", vars_))


def kapasite(n, cagri, aht, slot, hr):
    """(Kap kapasitesi, AHT kapasitesi) — net = n − round(n×rapor) − round(n×kayıp)."""
    h = int(slot[:2])
    net = n - round(n * _oran(hr.get("rapor_etkisi"), h, 0)) - round(n * _oran(hr.get("kapasite_kaybi"), h, 0))
    return net * _oran(hr.get("cagri_adedi"), h, 15) / 2, (net * 1800 / aht) if aht else 0.0


def slot_tablosu(results, saha_model, saha_plan, cagri, sq, df_aht=None, queue=QUEUE):
    _erl_cache = {}
    sat = []
    for ds in sorted(results):
        rq = (results.get(ds) or {}).get(queue)
        if not rq or ds not in cagri:
            continue
        if SON_GUN and ds > SON_GUN:
            continue
        cfg = rq.get("_config") or {}
        ecfg, hr = cfg.get("erlang") or {}, cfg.get("hourly_report") or {}
        d = dt.date.fromisoformat(ds)
        # TAHMİN tarafı (2026-10-21): ihtiyaç + tahmine göre RR → BUFFER'LI (MIP'in hedefi);
        # tahmin_cagri (ham) yalnız tahmin_sapma ve üst paneldeki düz yeşil çizgi için.
        t_buf = rq.get("calls_by_slot") or {}                  # MIP'in gördüğü (buffer dahil)
        t_cagri = rq.get("calls_by_slot_ham") or t_buf         # ham tahmin (buffer öncesi)
        _mi = rq.get("mip_info", {}) or {}
        t_erl = _mi.get("erlang_by_slot_ham") or rq.get("erlang_by_slot") or {}   # buffer dahil
        for s in SLOTS:
            c = cagri[ds].get(s, 0.0)
            a = aht_slot(cfg, sq.get((ds, s)), s, df_aht, queue)
            key = (round(c), round(a), s, d.weekday() >= 5)
            if key not in _erl_cache:
                _erl_cache[key] = erlang_ihtiyac(c, a, s, ecfg)
            ih = _erl_cache[key]
            kap_ih = (c / (_oran(hr.get("cagri_adedi"), int(s[:2]), 15) / 2
                           * (1 - _oran(hr.get("rapor_etkisi"), int(s[:2]), 0)
                              - _oran(hr.get("kapasite_kaybi"), int(s[:2]), 0)))) if c > 0 else 0.0
            tc = float(t_cagri.get(s, 0) or 0)
            tb = float(t_buf.get(s, 0) or 0)
            # İHTİYAÇ ve tahmine göre RR: Model-1'in planladığı (buffer'lı) çağrıdan — MIP'in hedefi
            te = float(t_erl.get(s, 0) or 0)                  # pickle Erlang'ı zaten buffer'lı
            _pay = (_oran(hr.get("cagri_adedi"), int(s[:2]), 15) / 2
                    * (1 - _oran(hr.get("rapor_etkisi"), int(s[:2]), 0)
                       - _oran(hr.get("kapasite_kaybi"), int(s[:2]), 0)))
            r = {"tarih": d, "gun": GUN_TR[d.weekday()], "hafta_sonu": int(d.weekday() >= 5),
                 "slot": s, "cagri": c, "aht": round(a, 1),
                 "erlang_ihtiyac": ih, "kap_ihtiyac": round(kap_ih, 1),
                 "tahmin_cagri": tc, "tahmin_cagri_buffer": tb,
                 "tahmin_erlang_ihtiyac": te,
                 "tahmin_kap_ihtiyac": round(tb / _pay, 1) if (tb > 0 and _pay > 0) else 0.0}
            for ad, saha in (("model", saha_model), ("planlama", saha_plan)):
                x = saha.get(ds, {}).get(s, _BOS())
                n = x["inhouse"] + x["outsource"] + x["part_time"]
                ck, ak = kapasite(n, c, a, s, hr)
                te = r["tahmin_erlang_ihtiyac"]
                r.update({f"{ad}_t_eksik": max(0, te - n),
                          f"{ad}_Kap_RR_tahmin": (ck / tb) if tb > 0 else None})
                r.update({f"{ad}_in": x["inhouse"], f"{ad}_out": x["outsource"],
                          f"{ad}_pt": x["part_time"], f"{ad}_sahadaki": n,
                          f"{ad}_eksik": max(0, ih - n), f"{ad}_fazla": max(0, n - ih),
                          f"{ad}_kap": ck, f"{ad}_aht_kap": ak,
                          f"{ad}_Kap_RR": (ck / c) if c > 0 else None})
            sat.append(r)
    return pd.DataFrame(sat)


def ozetle(df, anahtar):
    def _f(g):
        C, E = g["cagri"].sum(), g["erlang_ihtiyac"].sum()
        TC, TE = g["tahmin_cagri"].sum(), g["tahmin_erlang_ihtiyac"].sum()
        TB = g["tahmin_cagri_buffer"].sum()
        o = {"cagri": int(C), "tahmin_cagri": int(TC), "tahmin_cagri_buffer": int(TB),
             "tahmin_sapma": (C / TC - 1) if TC else None,          # HAM tahmine göre
             "erlang_ihtiyac_kisi_saat": round(E / 2),
             "tahmin_erlang_ihtiyac_kisi_saat": round(TE / 2)}
        for k in ("model", "planlama"):
            o[f"{k}_kisi_saat"] = round(g[f"{k}_sahadaki"].sum() / 2)
            o[f"{k}_Erlang_karsilama"] = (1 - g[f"{k}_eksik"].sum() / E) if E else None
            o[f"{k}_Kap_RR"] = (np.minimum(g[f"{k}_kap"], g["cagri"]).sum() / C) if C else None
            o[f"{k}_AHT_RR"] = (np.minimum(g[f"{k}_aht_kap"], g["cagri"]).sum() / C) if C else None
            o[f"{k}_karsilanamayan_cagri"] = round(np.maximum(g["cagri"] - g[f"{k}_kap"], 0).sum())
            o[f"{k}_eksik_kisi_slot"] = round(g[f"{k}_eksik"].sum())
            o[f"{k}_fazla_kisi_slot"] = round(g[f"{k}_fazla"].sum())
            o[f"{k}_kap_rr_alti_slot"] = int((g[f"{k}_Kap_RR"].fillna(1) < 1).sum())
            # TAHMİNE göre (Model-1'in gördüğü dünya)
            o[f"{k}_Erlang_karsilama_tahmin"] = (1 - g[f"{k}_t_eksik"].sum() / TE) if TE else None
            o[f"{k}_Kap_RR_tahmin"] = (np.minimum(g[f"{k}_kap"], g["tahmin_cagri_buffer"]).sum() / TB) if TB else None
        o["Kap_RR_fark (model−planlama)"] = ((o["model_Kap_RR"] - o["planlama_Kap_RR"]) if C else None)
        return pd.Series(o)
    return df.groupby(anahtar).apply(_f).reset_index()


def grafik_profil(df, hafta_sonu, baslik, dosya=None):
    """üst: gerçek çağrı · alt: Erlang ihtiyacı, Kap ihtiyacı, Analitik Model, Planlama Ekibi (slot ortalaması)."""
    g = df[df["hafta_sonu"] == hafta_sonu].groupby("slot")[
        ["cagri", "erlang_ihtiyac", "kap_ihtiyac", "model_sahadaki", "planlama_sahadaki",
         "tahmin_cagri", "tahmin_cagri_buffer", "tahmin_erlang_ihtiyac", "tahmin_kap_ihtiyac"]].mean()
    if g.empty:
        return
    fig, (a1, a2) = plt.subplots(2, 1, figsize=(15, 8), sharex=True,
                                 gridspec_kw={"height_ratios": [1, 2.3]})
    x = range(len(g))
    a1.fill_between(x, g["cagri"], color="#c2a5cf", alpha=.8, label="Gerçek Çağrı")
    a1.plot(x, g["tahmin_cagri"], color="#1a9850", lw=2.0, label="Tahmin Çağrı")
    if (g["tahmin_cagri_buffer"] - g["tahmin_cagri"]).abs().max() > 0.5:      # tahmin buffer var
        a1.plot(x, g["tahmin_cagri_buffer"], color="#1a9850", ls="--", lw=1.4,
                label="Tahmin + Buffer (Model-1'in Planladığı)")
    a1.legend(loc="upper left")
    a1.set_ylabel("Çağrı")
    a1.set_title(baslik)
    # GERÇEK çağrıya göre ihtiyaç → MOR · TAHMİNE göre (Model-1'in planladığı) → YEŞİL
    a2.plot(x, g["erlang_ihtiyac"], color="#7b3294", ls="--", lw=2.0,
            label="Erlang İhtiyacı — Gerçek Çağrı")
    a2.plot(x, g["kap_ihtiyac"], color="#c2a5cf", ls=":", lw=2.2,
            label="Kap İhtiyacı — Gerçek Çağrı")
    a2.plot(x, g["tahmin_erlang_ihtiyac"], color="#1a9850", ls="--", lw=2.0,
            label="Erlang İhtiyacı — Tahmin + Buffer (Model-1'in Planladığı)")
    a2.plot(x, g["tahmin_kap_ihtiyac"], color="#a6d96a", ls=":", lw=2.2,
            label="Kap İhtiyacı — Tahmin + Buffer (Model-1'in Planladığı)")
    a2.plot(x, g["model_sahadaki"], color="#1f77b4", lw=2.2, label=f"{AD['model']} Sahadaki")
    a2.plot(x, g["planlama_sahadaki"], color="#ff7f0e", lw=2.2, label=f"{AD['planlama']} Sahadaki")
    a2.set_ylabel("Kişi")
    a2.legend(loc="upper left")
    a2.set_xticks(list(x)[::2])
    a2.set_xticklabels(list(g.index)[::2], rotation=90)
    for a in (a1, a2):
        a.grid(alpha=.3)
    plt.tight_layout()
    if dosya:
        plt.savefig(dosya, dpi=120)
    plt.show()


def grafik_kaprr(df_saat, df_gun, dosya=None):
