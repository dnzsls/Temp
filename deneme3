from weekly_pipeline_unified_v3 import _resolve_kadro

def inhouse_fazla(results, config, kuyruk='kitle'):
    rows = []
    for ds in sorted(results):
        if kuyruk not in results[ds]:
            continue
        mi = results[ds][kuyruk]['mip_info']
        rows.append({'tarih': ds, 'hafta': _week_of_month(ds), 'gun_tipi': mi.get('gun_tipi'),
                     'en_az_inhouse': mi.get('total_inhouse_kisi', 0),
                     'eksik': mi.get('total_shortfall', 0),
                     'net_kadro': _resolve_kadro(config['kadro']['inhouse'][kuyruk], date_str=ds)})
    df = pd.DataFrame(rows)
    hi = df[df.gun_tipi == 'hafta_ici']
    hs = df[df.gun_tipi != 'hafta_ici'].groupby('hafta')['en_az_inhouse'].sum().rename('hsonu_inhouse_adam_gun')
    ozet = hi.groupby('hafta').agg(net_kadro=('net_kadro', 'max'),
                                   en_az_inhouse=('en_az_inhouse', 'max'),
                                   eksik=('eksik', 'sum')).join(hs)
    ozet['fazla'] = ozet['net_kadro'] - ozet['en_az_inhouse']
    return ozet

