SELECT NVL(a.line_based_main_group, '(eslesmedi)') AS grup,
       COUNT(DISTINCT p.agent_user_code)         AS agent_sayisi
FROM BSEN_VP_EKIM_IS_BIRIMI_PLAN_V1 p
LEFT JOIN (SELECT DISTINCT agent_user_code, line_based_main_group
           FROM BSEN_VP_AGENT_INFORMATIONS_202611_V2) a
  ON a.agent_user_code = p.agent_user_code
GROUP BY NVL(a.line_based_main_group, '(eslesmedi)')
ORDER BY agent_sayisi DESC;
