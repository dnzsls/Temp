SELECT
  ROUND(SUM(KITLE_NOF_CALL), 2)       AS kitle,
  ROUND(SUM(KARTTEMELBANKACLIK), 2)   AS karttemelbankaclik,
  ROUND(SUM(KAYIPCALINTISUPHELI), 2)  AS kayipcalintisupheli,
  ROUND(SUM(RETENTION_LINE), 2)       AS retention_line,
  ROUND(SUM(INTERNET_DESTEK), 2)      AS internet_destek,
  ROUND(SUM(HIZMETHATTI), 2)          AS hizmethatti,
  ROUND(SUM(EPASSWORD), 2)            AS epassword,
  ROUND(SUM(BCD), 2)                  AS bcd,
  ROUND(SUM(PROGRAM_44), 2)           AS program_44
FROM BNS_VP_CAGRI_ADEDI_FORECAST_112026_V3
WHERE model_data_date >= TO_DATE('03112026 11:00', 'ddmmyyyy hh24:mi')
  AND model_data_date <  TO_DATE('03112026 11:30', 'ddmmyyyy hh24:mi');
