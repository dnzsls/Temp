_cift = sorted((a, d) for (a, d), v in ardisik_off.items() if solver.Value(v))
for a, d2 in _cift:
    d1 = (dt.date.fromisoformat(d2) - dt.timedelta(days=1)).isoformat()
    _g = lambda ds: ("izin/blok" if not any((a, ds, v) in x for v in gun_vardiyalari.get(ds, []))
                     else ("çalışıyor" if any(solver.Value(x[(a, ds, v)]) for v in gun_vardiyalari.get(ds, [])
                                               if (a, ds, v) in x) else "model off"))
    print(f"{a}  {d1} ({_g(d1) if d1 in gun_vardiyalari else 'önceki ay'})  →  {d2} ({_g(d2)})",
          "| hamile/süt" if a in hafta_sonu_yasak else "")
