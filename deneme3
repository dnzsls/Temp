# %% [KONTROL] — Sunum sayfası için rakamlar (SALT OKUNUR, model çözmez)
# Gerekli: results, CONFIG, df_forecast (HÜCRE 6 sonrası)
import math, datetime as dt
import pandas as pd
from weekly_pipeline_unified_v3 import (outsource_kadro, calc_asa, prepare_forecast_calls_30,
                                        calculate_weighted_aht, get_sub_queue_aht)

ORNEK_KUYRUK = "kitle"
ORNEK_TARIH  = None        # None → ilk TAM haftanın Salı'sı · ya da "2026-11-10"
ORNEK_SAAT   = "11:00"

_Q   = tuple(CONFIG['queues'])
_TR  = sorted(t for t in results if results[t])
_dd  = dt.date.fromisoformat
_hno = lambda d: (d.day - 1 + d.replace(day=1).weekday()) // 7 + 1
_GUN = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Pzr']
_mi  = lambda ds, q: ((results.get(ds) or {}).get(q) or {}).get('mip_info') or {}
_yuz = lambda x: f"%{x*100:.0f}"

def _baslik(t): print(f"\n{'='*70}\n{t}\n{'='*70}")

# ---------------------------------------------------------------- 1
_baslik("1) KAYNAKLAR (CONFIG)")
_kd = CONFIG['kadro']; _pt = CONFIG.get('part_time', {}) or {}
print(f"outsource_off_orani: {_kd.get('outsource_off_orani')} · PT vardiyaları: {_pt.get('shifts')} · PT hafta_gun: {_pt.get('hafta_gun')}")
for q in _Q:
    print(f"  {q:<9} inhouse kadro: {_kd['inhouse'].get(q)}")
    print(f"  {'':<9} outsource kişi: {(_kd.get('outsource_kisi') or {}).get(q)} · PT kişi: {(_pt.get('count') or {}).get(q)}")

# ---------------------------------------------------------------- 2
_baslik("2) HAFTALIK ADAM-GÜN (results)")
_haf = {}
for ds in _TR:
    _haf.setdefault(_hno(_dd(ds)), []).append(ds)
print(f"  {'kuyruk':<9}{'hafta':>6}{'gün':>5}{'in/gün(hi)':>12}{'in hi':>8}{'in hs':>8}"
      f"{'out':>7}{'out bütçe':>11}{'out max/gün':>12}{'PT':>6}{'PT hedef':>9}")
for q in _Q:
    for h, dts in sorted(_haf.items()):
        hi = [d for d in dts if _dd(d).weekday() < 5]; hs = [d for d in dts if _dd(d).weekday() >= 5]
        if not any(_mi(d, q) for d in dts):
            continue
        ti = lambda L, k: sum(_mi(d, q).get(k, 0) or 0 for d in L)
        _, but = outsource_kadro(CONFIG, q, dts)
        ptc = (_pt.get('count') or {}).get(q) or 0
        pth = int(round((_pt.get('hafta_gun', 5)) * ptc * len(dts) / 7.0)) if ptc else 0
        ig = (_mi(hi[0], q).get('total_inhouse_kisi', 0) if hi else 0)
        omax = max((_mi(d, q).get('total_outsource_kisi', 0) or 0 for d in dts), default=0)
        print(f"  {q:<9}{h:>6}{len(dts):>5}{ig:>12}{ti(hi,'total_inhouse_kisi'):>8}{ti(hs,'total_inhouse_kisi'):>8}"
              f"{ti(dts,'total_outsource_kisi'):>7}{str(but or '-'):>11}{omax:>12}"
              f"{ti(dts,'total_part_time_kisi'):>6}{pth:>9}")

# ---------------------------------------------------------------- 3
_baslik("3) SHRINKAGE (CONFIG, 09–23 gündüz · 00–08 gece)")
for q in _Q:
    for tip in ('hafta_ici', 'cumartesi', 'pazar'):
        b = ((CONFIG['queue_configs'].get(q) or {}).get(tip) or {})
        s = (b.get('erlang') or {}).get('shrinkage') or {}
        kk = (b.get('hourly_report') or {}).get('kapasite_kaybi') or {}
        g = [s.get(h, s.get('default', 0)) for h in range(9, 24)]
        n = [s.get(h, s.get('default', 0)) for h in range(0, 9)]
        ayni = all(s.get(h) == kk.get(h) for h in range(24))
        print(f"  {q:<9}{tip:<10} gündüz ort {_yuz(sum(g)/len(g)):>4} (min {_yuz(min(g))}, max {_yuz(max(g))})"
              f" · gece max {_yuz(max(n))} · Kap kaybı = shrinkage? {'evet' if ayni else 'HAYIR'}")
_s = CONFIG['queue_configs'][ORNEK_KUYRUK]['hafta_ici']['erlang']['shrinkage']
print(f"  {ORNEK_KUYRUK} hafta içi saatlik: " + " ".join(f"{h}:{_s.get(h, 0):.2f}" for h in range(24)))

# ---------------------------------------------------------------- 4
_baslik("4) KURALLAR / CEZALAR (CONFIG)")
print(f"  kapsama cezası hi/hs: {CONFIG['ceza'].get('kapsama_hafta_ici')} / {CONFIG['ceza'].get('kapsama_hafta_sonu')}"
      f" · outsource_ratio: {CONFIG.get('outsource_ratio')}")
for q in _Q:
    kd = (CONFIG.get('kap_denge') or {}).get(q) or {}
    mps = {t: ((CONFIG['queue_configs'][q].get(t) or {}).get('mip') or {}).get('min_per_shift')
           for t in ('hafta_ici', 'cumartesi', 'pazar')}
    print(f"  {q:<9} min_per_shift {mps} · kap_denge {'AÇIK' if kd.get('enabled') else 'kapalı'}"
          + (f" alt={kd.get('alt')} ust={kd.get('ust')}" if kd.get('enabled') else ""))
    for k in kd.get('kurallar', []) or []:
        print(f"  {'':<9}   kural: {k}")
_w = (CONFIG.get('surplus_distribution') or {}).get('windows')
for q in _Q:
    _wq = (_w.get(q, _w.get('default')) if isinstance(_w, dict) else _w) or []
    print(f"  surplus pencere {q:<9}: " + " · ".join(f"{p.get('start')}-{p.get('end')} {p.get('ratio')}" for p in _wq))

# ---------------------------------------------------------------- 5
q = ORNEK_KUYRUK
if ORNEK_TARIH is None:
    _tam = [dts for h, dts in sorted(_haf.items()) if len(dts) == 7]
    ORNEK_TARIH = (_tam[0] if _tam else _TR)[1]
ds, sl = ORNEK_TARIH, ORNEK_SAAT
rq = results[ds][q]; mi = rq['mip_info']; cf = rq['_config']
_baslik(f"5) ÖRNEK YARIM SAAT — {q} · {ds} ({_GUN[_dd(ds).weekday()]}) · {sl}")
c   = float((rq.get('calls_by_slot') or {}).get(sl, 0) or 0)
cH  = float((rq.get('calls_by_slot_ham') or {}).get(sl, c) or 0)
_d30 = prepare_forecast_calls_30(df_forecast, config=CONFIG)
_row = _d30[(_d30['data_date'] == pd.to_datetime(ds)) & (_d30['slot_30'] == sl)].iloc[0]
aht = calculate_weighted_aht(_row, q, sl, CONFIG)
print(f"  çağrı {c:.0f} (ham {cH:.0f}) · ağırlıklı AHT {aht:.0f} sn")
for sq in ((CONFIG.get('sub_queues', {}).get(q) or {}).get('queues') or []):
    v = float(_row.get(f"{sq}_calls", 0) or 0)
    if v > 0:
        print(f"     alt kuyruk {sq:<28} çağrı {v:>6.1f}  AHT {get_sub_queue_aht(q, sq, sl, CONFIG):>5.0f} sn")
A = c * aht / 1800.0
ham = math.ceil(A)
while ham < 3 * A + 10 and calc_asa(ham, A, aht) > cf['erlang']['target_asa']:
    ham += 1
h = int(sl[:2]); sh = cf['erlang']['shrinkage']; s = sh.get(h, sh.get('default', 0))
print(f"  trafik {A:.1f} · Erlang (hatta) {ham} kişi (ASA {calc_asa(ham, A, aht):.0f} sn)"
      f" · shrinkage {_yuz(s)} → ihtiyaç {math.ceil(ham/(1-s))}  [model: {rq['erlang_by_slot'].get(sl)}]")
n = (mi.get('fiili_by_slot') or {}).get(sl, 0)
hr = cf.get('hourly_report') or {}
_g = lambda t, d: (t or {}).get(h, (t or {}).get('default', d))
kk = float(_g(hr.get('kapasite_kaybi'), 0)) + float(_g(hr.get('rapor_etkisi'), 0))
ca = float(_g(hr.get('cagri_adedi'), 15)) / 2
net = n - round(n * kk)
print(f"  planda sahada {n} kişi · Kap: net {net} × {ca:g} = {net*ca:.0f} çağrı kapasitesi"
      f" · Kap_RR {_yuz(net*ca/c) if c else '-'} · Kap ihtiyacı {c/(ca*(1-kk)) if c else 0:.1f} kişi")

# ---------------------------------------------------------------- 6
_baslik(f"6) ÖRNEK GÜN VARDİYA PLANI — {q} · {ds}")
cov = mi.get('shift_coverage') or {}
rows = [(cov.get(k, {}).get('shift', k), cov.get(k, {}).get('company', '?'), v)
        for k, v in (mi.get('assignments') or {}).items() if v > 0]
for sft, co, v in sorted(rows, key=lambda r: (r[0], r[1])):
    print(f"  {sft:<14}{co:<11}{v:>5}")
st1 = mi.get('mip_info_stage1') or {}
for k, ad in (('total_inhouse_kisi', 'inhouse'), ('total_outsource_kisi', 'outsource'), ('total_part_time_kisi', 'PT')):
    print(f"  {ad:<10} son plan {mi.get(k, 0):>5}" + (f" · MIP (dağıtım öncesi) {st1.get(k, 0)}" if st1 else ""))
print(f"  vardiya sayısı: {len(rows)}")

# ---------------------------------------------------------------- 7
_baslik("7) AYLIK ÖZET (yarım saat bazında; Excel gun_ozet ile ±1 fark olabilir)")
print(f"  {'kuyruk':<9}{'çağrı(ham)':>12}{'Erlang karş.':>14}{'Kap_RR':>9}{'eksik k-slot':>14}{'kişi-gün':>10}")
for q in _Q:
    C = Ih = Ek = Kc = Kk = KG = 0.0
    for ds in _TR:
        r = (results.get(ds) or {}).get(q)
        if not r:
            continue
        m = r['mip_info']; cf = r['_config']; hr = cf.get('hourly_report') or {}
        KG += m.get('total_kisi', 0) or 0
        for sl, ih in (r.get('erlang_by_slot') or {}).items():
            f = (m.get('fiili_by_slot') or {}).get(sl, 0)
            Ih += ih; Ek += max(0, ih - f)
            c = float((r.get('calls_by_slot_ham') or r.get('calls_by_slot') or {}).get(sl, 0) or 0)
            h = int(sl[:2]); _g = lambda t, d: (t or {}).get(h, (t or {}).get('default', d))
            kk = float(_g(hr.get('kapasite_kaybi'), 0)) + float(_g(hr.get('rapor_etkisi'), 0))
            kap = (f - round(f * kk)) * float(_g(hr.get('cagri_adedi'), 15)) / 2
            C += c; Kc += min(kap, c)
    print(f"  {q:<9}{C:>12,.0f}{_yuz(1 - Ek/Ih) if Ih else '-':>14}{_yuz(Kc/C) if C else '-':>9}{Ek:>14,.0f}{KG:>10,.0f}")
