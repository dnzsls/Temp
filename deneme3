SELECT
  COUNT(*) AS satir,
  -- KİTLE
  ROUND(SUM(KITLE_NOF_CALL), 1) AS kitle_toplam,
  ROUND(SUM(KARTTEMELBANKACLIK + EPASSWORD + KAYIPCALINTISUPHELI + RETENTION_LINE
          + PROGRAM_44 + INTERNET_DESTEK + BCD + HIZMETHATTI), 1) AS kitle_alt,
  ROUND(MAX(ABS(KITLE_NOF_CALL - (KARTTEMELBANKACLIK + EPASSWORD + KAYIPCALINTISUPHELI + RETENTION_LINE
          + PROGRAM_44 + INTERNET_DESTEK + BCD + HIZMETHATTI))), 4) AS kitle_max_fark,
  -- KURUMSAL
  ROUND(SUM(KURUMSAL_NOF_CALL), 1) AS kurumsal_toplam,
  ROUND(SUM(POSHIZMETLERI + KURUMSALKART + KURUMSALTELEFONLABANKACILIK + PROVIZYON
          + MAASODEMELERI + KURUMSAL_INTERNET_DESTEK), 1) AS kurumsal_alt,
  -- GOLD
  ROUND(SUM(GOLD_NOF_CALL), 1) AS gold_toplam,
  ROUND(SUM(OZELBANKACILIK + ENGLISH + KOCAILEM + FORDFINANS), 1) AS gold_alt,
  -- YATIRIM
  ROUND(SUM(YATIRIM_NOF_CALL), 1) AS yatirim_toplam,
  -- BOŞ SATIRLAR
  SUM(CASE WHEN KITLE_NOF_CALL IS NULL OR KURUMSAL_NOF_CALL IS NULL
            OR GOLD_NOF_CALL IS NULL OR YATIRIM_NOF_CALL IS NULL THEN 1 ELSE 0 END) AS bos_toplam_satiri
FROM BNS_VP_CAGRI_ADEDI_FORECAST_112026_V3;
