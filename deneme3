SELECT groupname,
       SUM(incall)                                AS cagri,
       ROUND(SUM(aht * incall) / SUM(incall))     AS ort_aht
FROM BNS_VP_BO_KUYRUKAHTCALL_TOTAL_LINE_202609_202610
WHERE flddate >= DATE '2026-10-01'
  AND flddate <  DATE '2026-11-01'
GROUP BY groupname
ORDER BY cagri DESC;
