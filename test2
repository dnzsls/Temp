# -*- coding: utf-8 -*-
"""
AGENT DETAYLI MODEL — tek dosya akışı (hücre hücre, detaylı print)
==================================================================
2. aşama: aylık modelin kova-sayılarına İSİMLİ inhouse agent oturtma.

Çözüm birimi = TÜM AY, hafta içi + hafta sonu BİRLİKTE (spec 6.1).

Bu dosya `# %% [HÜCRE n]` bloklarıyla bölünmüştür; her hücre kendi
kontrol/print'ini basar. Spyder/VSCode'da hücre hücre, ya da düz
`python3 agent_detayli_model.py` ile baştan sona çalışır.

KAPSAM — KISITLAR VE CEZALAR (hücre hücre):

  SERT KISITLAR (ihlal edilemez):
    H9  müsaitlik    : izinli gün → değişken yok (atanamaz).
    H10 hafta sonu cov.: hafta sonu kovaları talep ± HS_TOL(2) sıkı band (tam otursun).
    H10 gece coverage: hafta içi gece kovaları (00:00/24:00) talep ± GECE_BUFFER(3) bandı.
    H11 günde ≤1     : bir agent bir günde en çok 1 vardiya.
    H12 haftada ≤6   : her ISO-hafta ≤6 gün (≥1 off).
    H13 sabah_calisir: bitişi ≤20:00, gece/ertesi-güne-sarkan vardiya yok.
    H14 hamile/süt   : Cmt/Pzr çalışamaz.
    H15 11s dinlenme : ardışık iki gün arası <11s bırakan vardiya çifti yasak.
    H16 mesaiye_kalamaz: resmi tatilde çalışamaz.
    H16B arife atama : arife → süt/hamile/mesai SADECE 09:00-13:00 ek yarım vardiya (coverage'a girmez, 9-18 talebini düşürmez); normal agent tam gün. Mesai HAFTA SONU arifede off.
    H16C mesaiye_kalamaz: haftada ≤5 gün (6. gün mesai olur; günler serbest, hafta sonu dahil).
    H16D akşam/gece  : agent ayda ≤MAX_AKSAM_HAFTA(2) hafta akşam/gece (başlangıç ≥17:00); hafta bazında sayım.
    H17 kota         : kota ≤ çalışma ≤ kota+MAX_MESAI(2)+tatil (özel flag = kota).
                       kota = ayın iş günü − hafta içi izin.
    H18 hafta sonu off: ayda ≥1 tam Cmt+Pzr çifti off.
    H20 tek tip      : agent hafta içi tek vardiya tipinde (hafta sonu + resmi tatil haftası serbest).

  YUMUŞAK CEZALAR (amaç fonksiyonu — minimize):
    H10 coverage sapma: serbest ±SERBEST(5); W_COVERAGE(1) 5–15; W_COVERAGE2(20) 15+.
    H19 takım bölünme : W_TAKIM(100) × takımın o hafta FAZLADAN kullandığı vardiya-tipi (haftalık, hafta içi; resmi tatil haftası cezasız).
    H20B haftalık off : W_HAFTA_OFF(3) × (haftalık off − 2)  [izin hariç → 4-gün haftasını engelle].
    H20B hafta sonu önceliği: W_HI_OFF(1) × hafta içi off sayısı [off'u hafta sonuna iter].
    H20C hafta sonu adaleti: W_ADALET_HS(6)×(hs günü−FAIR_HS)+ + W_ADALET_HS2(6)×(hs günü−FAIR_HS−1)+ [konveks → 4-5'i 3'e yay].
    H20D vardiya-saati adaleti: W_ADALET_AKSAM(3) × (akşam/gece HAFTASI − FAIR_AKSAM_HAFTA)+ [17:00+ & gece rotasyonu].
    H20E mesai adaleti: W_ADALET_MESAI × (HAFTALIK mesai − FAIR_MESAI)+ [3.+ 6-günlük haftayı cezala → "önce hafta içi doldur"; norm'a dokunmaz].

  HENÜZ YOK (sonraki adımlar): gece/uydu rotasyonu (2 ayda 1, 2 hafta — bu ay yok),
    mesai/swap mekanizması, resmi tatil takvimi (hamile/süt yasağı).

GİRDİLER (hepsi GERÇEK — dummy yok):
  1) PKL_PATH   : aylık modelin results[date][queue] çıktısı (planlama, pkl dosyası).
  2) df_agents  : agent master (SQL'den DataFrame). Beklenen kolonlar:
       agent_user_code        agent kimliği (U111111)
       agent_name
       teamleader_name        takım parçası
       groupname              takım parçası (+lokasyon)
       working_main_group     lokasyon+kuyruk (okunur)
       line_based_main_group  KUYRUK: kitle_cagrilar | kurumsal_cagrilar | gold_cagrilar
       idari_izinli_flg       1 → tüm ay müsait değil
       pazartesi_izinli_flg   1 → her Pazartesi off
       sali_izinli_flg        1 → her Salı off
       carsamba_izinli_flg    1 → her Çarşamba off
       persembe_izinli_flg    1 → her Perşembe off
       cuma_izinli_flg        1 → her Cuma off
       sabah_calisir_flg      1 → yalnız bitişi ≤20:00 vardiya (sonraki adım)
       mesaiye_kalamaz_flg    1 → mesai yok + gün tavanı (sonraki adım)
       dogum_izni_flg         1 → tüm ay müsait değil
       hamile_flg             1 → hafta sonu/tatil yok (sonraki adım)
       sut_izni_flg           1 → ≤20:00 + 2sa eksik + mesai yok (sonraki adım)
       kismi_calisan_flg      1 → PART-TIME, ÇIKARILIR (haftaiçi planlamada yok)
  3) df_off     : özel off tablosu (SQL'den DataFrame). Kolonlar:
       agent_user_code, agent_name, teamleader_name,
       off_talebi, off_talebi_desc,
       gun_1 .. gun_30/31   1 → o tarih izinli (gun_N = çalışılan ayın N'inci günü)
"""

import pickle
import datetime as dt
import pandas as pd
from ortools.sat.python import cp_model

# DataFrame'leri tek geniş blok halinde (alt satıra kaymadan) yazdır
pd.set_option("display.max_columns", None)
pd.set_option("display.width", None)
pd.set_option("display.expand_frame_repr", False)


# %% [HÜCRE 0] — KONFİG ─────────────────────────────────────────────────
QUEUE       = "kitle"          # kitle | kurumsal | gold
PKL_PATH    = ""               # aylık model çıktısı pkl yolu
RESMI_TATILLER   = []          # manuel resmi tatil tarihleri, ör. ["2026-07-15", "2026-08-30"]
ARIFE_GUNLERI    = []          # arife (yarım gün) tarihleri, ör. ["2026-06-16"]; öğleden sonra resmi tatil
ARIFE_SON_BASLANGIC = "09:00"  # arife günü flag'liler (süt/hamile/mesai) bu saate KADAR başlayabilir (4 saat → 13:00)
SERBEST_COVERAGE = 5           # serbest bölge: talep ± SERBEST bedava (ceza yok) — HAFTA İÇİ
AGIR_ESIK        = 15          # bunu aşan sapma AĞIR cezalı (konveks → sapma yayılır) — HAFTA İÇİ
GECE_BASLANGIC   = ("00:00", "24:00")   # gece vardiyası başlangıçları
GECE_BUFFER      = 3           # hafta içi gece kovaları SERT band: talep ± 3 (fazlalık gündüzde kalır)
HS_TOL           = 2           # HAFTA SONU kovaları SERT band: talep ± 2 (coverage'a tam otursun; takım bütünlüğü yok → boşaltılmasın)
# amaç fonksiyonu ağırlıkları (yüksek = o hedef daha öncelikli)
W_COVERAGE  = 1                # coverage sapma (5–15 arası)
W_COVERAGE2 = 20               # coverage sapma 15 ÜSTÜ ek ceza (büyük sapmayı engeller)
W_TAKIM      = 100             # takım bölünme: takımın o hafta fazladan kullandığı her vardiya-tipi (HAFTALIK; günlükten ~5× yüksek olmalı)
W_HAFTA_OFF = 3                # haftalık >2 off cezası (yumuşak → 4-gün haftasını engelle, izin hariç)
W_HI_OFF    = 4                # hafta içi off cezası (=norm) → "önce mesai" (2 dolmadan norm yapma)
W_ADALET_HS  = 12              # hafta sonu adaleti: FAIR_HS üstü her hafta sonu gününe ceza
W_ADALET_HS2 = 12              # hafta sonu KONVEKS ek: FAIR_HS+1 üstü ekstra ceza (4-5 günü 3'e yay)
FAIR_HS     = 2                # agent başına "adil" hafta sonu günü; üstü cezalı (yük yayılsın)
W_ADALET_MESAI = 6             # MESAİ (overtime) adaleti: adil pay üstü her fazla mesai gününe ceza (H20E)
FAIR_MESAI  = 2                # "adil" fazla mesai (rotasyon hedefi, YUMUŞAK); üstü cezalı ama yasak değil
MAX_MESAI   = 2                # SERT tavan: agent ay içinde EN FAZLA bu kadar mesai (ust=kota+MAX_MESAI). Ekip 3-4 yapabilir
W_ADALET_AKSAM = 3             # akşam+gece adaleti: adil pay üstü her akşam/gece HAFTASINA ceza
AKSAM_BASLANGIC = "17:00"      # başlangıcı bundan SONRA = "akşam"; gece (00:00→1440) otomatik dahil
FAIR_AKSAM_HAFTA = 1           # agent başına "adil" akşam/gece HAFTA sayısı; üstü cezalı (H20 haftalık tiple uyumlu)
MAX_AKSAM_HAFTA  = 2           # SERT tavan: agent ay içinde en fazla bu kadar hafta akşam/gece (H16D)
# NOT: agent master ve özel off SQL'den gelir → bu dosyadan ÖNCE notebook'ta
#      df_agents ve df_off DataFrame'leri tanımlı olmalı.

DAY_TR = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Pzr"]


# %% [HÜCRE 1] — PICKLE YÜKLE (planlama) ────────────────────────────────
try:
    with open(PKL_PATH, "rb") as f:
        results = pickle.load(f)
except Exception:
    raise SystemExit("[H1] pickle yüklenemedi — PKL_PATH yanlış ya da dosya yok.")

print(f"pickle yüklendi: {len(results)} gün")

# 'planı olan gün' = o kuyrukta sonuç üretilmiş (feasible) gün; None/eksik olanlar hariç
plani_olan = sorted(ds for ds, r in results.items() if r and QUEUE in r and r[QUEUE])
print(f"'{QUEUE}' planı olan gün: {len(plani_olan)}/{len(results)}")

# içerik önizlemesi (df.head gibi) — bir günün yapısı
if plani_olan:
    ds0 = plani_olan[0]
    mi0 = results[ds0][QUEUE]["mip_info"]
    print(f"örnek gün {ds0}: mip_info anahtarları = {list(mi0.keys())}")
    print(f"     assignments (ilk 5): {dict(list(mi0.get('assignments', {}).items())[:5])}")
    sc0 = mi0.get("shift_coverage", {})
    if sc0:
        k0 = next(iter(sc0))
        print(f"     shift_coverage örnek: {k0} → {sc0[k0]}")


# %% [HÜCRE 2] — PLANLAMAYI TEMİZ TALEP TABLOSUNA ÇEVİR ────────────────
# Pickle'daki iç içe sözlüğü tidy DataFrame'e çevir: her satır = gün × inhouse
# vardiya. Outsource / part_time atılır (modelin işi değil).
satirlar = []
for ds in sorted(results.keys()):
    r = results.get(ds)
    if not r or QUEUE not in r or not r[QUEUE]:
        continue
    mi = r[QUEUE]["mip_info"]
    sc = mi.get("shift_coverage", {})
    for shift, kisi in mi.get("assignments", {}).items():
        info = sc.get(shift, {})
        if kisi <= 0 or info.get("company") != "inhouse":
            continue
        d = dt.date.fromisoformat(ds)
        satirlar.append({
            "tarih":      ds,
            "gun":        DAY_TR[d.weekday()],
            "hafta_sonu": int(d.weekday() > 4),
            "vardiya":    shift,
            "baslangic":  info.get("start"),
            "bitis":      info.get("end"),
            "talep":      int(kisi),
        })

df_talep = pd.DataFrame(satirlar)
print(f"talep tablosu: {len(df_talep)} satır (gün × inhouse vardiya)")
print(df_talep.head(8).to_string(index=False))

# Ay bilgisi (H3'te izin/gün eşlemesi için)
GUNLER  = sorted(results.keys())
AY_YIL  = dt.date.fromisoformat(GUNLER[0]).year
AY_AY   = dt.date.fromisoformat(GUNLER[0]).month
GUN_SET = {dt.date.fromisoformat(ds) for ds in GUNLER}
print(f"ay: {AY_YIL}-{AY_AY:02d}  ({len(GUNLER)} gün)")


# %% [HÜCRE 3] — AGENT VERİLERİNİ TEMİZLE (df_agents + df_off) ──────────
# SQL'den gelen iki DataFrame'i al, temel temizlik yap, içeriğine bak.
# (Kuyruk süzme, PT eleme, izin birleştirme SONRAKİ adımlarda.)

df_agents = globals().get("df_agents", globals().get("df_agent"))
if df_agents is None:
    raise SystemExit("[H3] df_agents tanımlı değil — SQL'den df_agents çek.")

df_agents = df_agents.copy()
df_agents.columns = [str(c).strip().lower() for c in df_agents.columns]   # kolon adı sadeleştir
df_agents = df_agents.fillna("")                                          # boşları '' yap

print(f"df_agents: {df_agents.shape[0]} satır × {df_agents.shape[1]} kolon")
print(f"kolonlar: {list(df_agents.columns)}")
print(df_agents.head())

df_off = globals().get("df_off")
if df_off is not None:
    df_off = df_off.copy()
    df_off.columns = [str(c).strip().lower() for c in df_off.columns]
    # gün kolonları float (1.0/0.0) geliyor → int (0/1)
    gun_cols = [c for c in df_off.columns if c.startswith("gun_")]
    df_off[gun_cols] = (df_off[gun_cols].apply(pd.to_numeric, errors="coerce")
                        .fillna(0).astype(int))
    if "izin_tipi" in df_off.columns:                    # YENİ: izin / off_t ayrımı
        df_off["izin_tipi"] = df_off["izin_tipi"].astype(str).str.strip().str.lower()
    df_off = df_off.fillna("")
    print(f"\ndf_off: {df_off.shape[0]} satır × {df_off.shape[1]} kolon "
          f"({len(gun_cols)} gün kolonu int'e çevrildi)")
    print(f"kolonlar: {list(df_off.columns)}")
    if "izin_tipi" in df_off.columns:
        print(f"df_off izin_tipi: {df_off['izin_tipi'].value_counts().to_dict()}")
    print(df_off.head())
else:
    print("df_off yok")

# df_izin (tidy): agent_user_code + tarih + izin_tipi (izin / off_t2)
df_izin = globals().get("df_izin")
if df_izin is not None:
    df_izin = df_izin.copy()
    df_izin.columns = [str(c).strip().lower() for c in df_izin.columns]
    df_izin["tarih"] = pd.to_datetime(df_izin["tarih"], errors="coerce").dt.date   # → date
    df_izin["izin_tipi"] = df_izin["izin_tipi"].astype(str).str.strip().str.lower()
    df_izin = df_izin.dropna(subset=["tarih"])
    _yil_disi = (~df_izin["tarih"].isin(GUN_SET)).sum()                # tüm yıl → planlama ayı
    df_izin = df_izin[df_izin["tarih"].isin(GUN_SET)]                  # SADECE planlanan ay
    print(f"\ndf_izin: {df_izin.shape[0]} satır × {df_izin.shape[1]} kolon "
          f"(ay dışı {_yil_disi} satır atıldı)")
    print(f"df_izin izin_tipi: {df_izin['izin_tipi'].value_counts().to_dict()}")
    print(df_izin.head())
else:
    print("df_izin yok")


# %% [HÜCRE 4] — KUYRUĞA SÜZ ────────────────────────────────────────────
# line_based_main_group == "kitle_cagrilar" olanları tut.
hedef = f"{QUEUE}_cagrilar"                        # "kitle" → "kitle_cagrilar"
df_kuyruk = df_agents[df_agents["line_based_main_group"].str.strip() == hedef].copy()
df_kuyruk["kuyruk"] = QUEUE                        # temiz kuyruk kolonu

print(f"'{QUEUE}' agent: {len(df_kuyruk)} / {len(df_agents)} (diğer kuyruklar elendi)")
print(df_kuyruk[["agent_user_code", "agent_name",
                 "line_based_main_group", "kuyruk"]].head())


# %% [HÜCRE 5] — PT + EĞİTİM EKİPLERİNİ ELE ────────────────────────────
# kismi_calisan_flg=1 → PT.  teamleader_name "eğitim" → eğitim ekibi.
# İkisini de ana kitleden çıkar (modele hiç girmesinler).
pt_mask = pd.to_numeric(df_kuyruk["kismi_calisan_flg"],
                        errors="coerce").fillna(0).astype(int) == 1
egitim_mask = (df_kuyruk["teamleader_name"].astype(str).str.lower()
               .str.contains("eğit|egit", na=False))    # "eğitim"/"egitim" (büyük/küçük farketmez)
df_tam = df_kuyruk[~pt_mask & ~egitim_mask].copy()

print(f"PT elendi: {int(pt_mask.sum())}  |  eğitim elendi: {int(egitim_mask.sum())}  "
      f"→  kalan tam zamanlı: {len(df_tam)} / {len(df_kuyruk)}")
print(df_tam[["agent_user_code", "agent_name", "teamleader_name"]].head())


# %% [HÜCRE 6] — TAKIM KOLONU (working_main_group + teamleader_name) ────
df_tam["takim"] = (df_tam["working_main_group"].str.strip() + " | "
                   + df_tam["teamleader_name"].str.strip())
print(f"takım sayısı: {df_tam['takim'].nunique()}")
print("takım → kişi sayısı:")
print(df_tam["takim"].value_counts())


# %% [HÜCRE 7] — İZİN GÜNLERİNİ BİRLEŞTİR ───────────────────────────────
# Her agent için tek izin kümesi: özel-off + tekrarlı(Pzt/Cuma) + tam-ay(idari/doğum)

# 1) df_izin (ÖNCELİKLİ) + df_off → agent başına tarih→tip haritası (tip_map).
#    tip: "izin" (kotadan düşer) | "off_t"/"off_t2" (blok ama kota DÜŞMEZ).
#    Çakışan tarihte df_izin kazanır: df_izin'i ÖNCE yazıyoruz, df_off'u setdefault
#    ile ekliyoruz → df_izin'de olan tarihi df_off EZEMEZ.
tip_map = {}                                            # code -> {tarih: tip}
_BILINEN_TIP = {"izin", "off_t", "off_t2"}              # tanınan tipler; boş/diğer → YOK SAY (normal çalışma)
if df_izin is not None:                                 # df_izin ÖNCE → öncelikli
    for _, row in df_izin.iterrows():
        code = str(row["agent_user_code"]).strip()
        if row["izin_tipi"] not in _BILINEN_TIP:        # boş/tanınmayan tip → yok say
            continue
        tip_map.setdefault(code, {})[row["tarih"]] = row["izin_tipi"]
if df_off is not None:
    _off_tipli = "izin_tipi" in df_off.columns
    _off_bos = 0                                        # boş/tanınmayan izin_tipi satır sayısı
    for _, row in df_off.iterrows():
        code = str(row["agent_user_code"]).strip()
        tipi = row["izin_tipi"] if _off_tipli else "izin"   # tip kolonu yoksa izin varsay
        if tipi not in _BILINEN_TIP:                    # boş/tanınmayan tip → YOK SAY (normal çalışma)
            _off_bos += 1
            continue
        for c in gun_cols:                              # gun_cols H3'te tanımlandı
            if int(row[c]) == 1:
                try:
                    d = dt.date(AY_YIL, AY_AY, int(c.split("_")[1]))
                except ValueError:
                    continue                            # ayda olmayan gün (gun_31 vs.)
                tip_map.setdefault(code, {}).setdefault(d, tipi)   # df_izin varsa DOKUNMA
    if _off_bos:
        print(f"df_off: {_off_bos} satır boş/tanınmayan izin_tipi → YOK SAYILDI (normal çalışma)")

# 2) tekrarlı hafta içi izin: flag → hafta günü (0=Pzt .. 4=Cuma)
#    Yeni gün eklemek için tek yer burası (tek format).
HAFTAICI_IZIN_FLG = {
    "pazartesi_izinli_flg": 0,
    "sali_izinli_flg":      1,
    "carsamba_izinli_flg":  2,
    "persembe_izinli_flg":  3,
    "cuma_izinli_flg":      4,
}
gunluk_izin = {wd: {d for d in GUN_SET if d.weekday() == wd}
               for wd in set(HAFTAICI_IZIN_FLG.values())}   # hafta günü → o ayın tüm o günleri


def _b(row, col):
    """flag (float/str) → bool"""
    return pd.to_numeric(row.get(col, 0), errors="coerce") == 1


# süt izni ↔ resmi tatil emilimi: bir ISO haftada HAFTA İÇİ resmi tatil varsa,
# o hafta süt izni "tatile sayılır" → süt agent o hafta süt iznini KULLANMAZ
# (normal gününde çalışır), tatil günü zaten off. Sadece süt izni için geçerli;
# hafta sonu tatil emilmez (zaten AYLIK_IS_GUNU'yu da etkilemez).
_TATIL = set(dt.date.fromisoformat(t) for t in RESMI_TATILLER)   # H16 ile aynı liste
tatil_haftalari = {d.isocalendar()[:2] for d in _TATIL if d.weekday() < 5}

# 3) agent başına birleştir → izin_map (kotadan düşer) + off_block_map (blok, kota DÜŞMEZ)
izin_map = {}
off_block_map = {}
off_tip_map = {}                                       # code -> {tarih: off_t/off_t2} (roster etiketi)
for _, row in df_tam.iterrows():
    code = str(row["agent_user_code"]).strip()
    izin = set()
    off_block = set()
    off_tip = {}
    for d, tipi in tip_map.get(code, {}).items():      # df_izin+df_off tarihlerini tipe ayır
        if tipi == "izin":
            izin.add(d)
        else:                                          # off_t / off_t2 → blok ama kota düşmez
            off_block.add(d)
            off_tip[d] = tipi                          # tipini sakla (off_t / off_t2 ayrı göster)
    if _b(row, "idari_izinli_flg") or _b(row, "dogum_izni_flg"):
        izin |= GUN_SET                                # tüm ay
    sut = _b(row, "sut_izni_flg")                      # süt izni → tatil haftası emilimi
    for flg, wd in HAFTAICI_IZIN_FLG.items():          # tekrarlı hafta içi izin günleri
        if _b(row, flg):
            gunler = gunluk_izin[wd]
            if sut:                                    # süt: tatil haftasındaki izni EMME
                gunler = {d for d in gunler
                          if d.isocalendar()[:2] not in tatil_haftalari}
