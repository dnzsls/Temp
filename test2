from collections import Counter


def _adalet_ozet(baslik, gv_list, fair, sebep_fn=None):
    agent_c = {a: sum(solver.Value(x[(a, ds, v)]) for (ds, v) in gv_list if (a, ds, v) in x)
               for a in AGENTS}
    sayilar = list(agent_c.values())
    dag = Counter(sayilar)
    ust = sum(1 for c in sayilar if c > fair)
    print(f"\n=== {baslik}  (adil pay = {fair}) ===")
    print(f"max={max(sayilar)}  ortalama={sum(sayilar) / len(sayilar):.1f}  "
          f"adil pay ÜSTÜ agent={ust}  (ideal: az/sıfır)")
    print("gün → kaç agent:")
    for k in sorted(dag):
        isaret = "  ← cezalı (adil pay üstü)" if k > fair else ""
        ek = ""
        if k == 0 and sebep_fn is not None:                      # 0 gün → neden 0'da?
            ek = "   → " + sebep_fn([a for a in AGENTS if agent_c[a] == 0])
        print(f"  {k:2d} gün: {dag[k]:4d} agent{isaret}{ek}")


