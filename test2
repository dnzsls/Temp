# %% [HÜCRE 24] — TAKIM BAZLI DAĞILIM (günlük takım → vardiya) ─────────
# Bir takım o gün hangi vardiya(lar)da, kaç kişi. Bölünme buradan görünür.
df_sonuc["takim"] = df_sonuc["agent"].map(agent_takim)

# takım × gün × saat → kaç kişi (sadece çalışanlar)
df_takim = (df_sonuc.groupby(["takim", "tarih", "saat"]).size()
            .reset_index(name="kisi"))

# takım roster: satır=takım, sütun=gün, hücre = "saat×kişi" (bölünmüşse '|' ile ayrık)
df_takim["hucre"] = df_takim["saat"] + "×" + df_takim["kisi"].astype(str)
takim_roster = (df_takim.groupby(["takim", "tarih"])["hucre"]
                .apply(lambda s: " | ".join(s))
                .unstack("tarih"))
print(f"takım dağılımı: {df_takim['takim'].nunique()} takım")
print(takim_roster.head(15))

# bölünme özeti: kaç (takım,gün) birden çok vardiyaya bölünmüş
bolunme = df_takim.groupby(["takim", "tarih"]).size()
print(f"\n(takım,gün) toplam: {len(bolunme)}  |  bölünmüş (>1 vardiya): {int((bolunme > 1).sum())}")
print("en çok bölünen 10 (takım,gün):")
print(bolunme[bolunme > 1].sort_values(ascending=False).head(10))
