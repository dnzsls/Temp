dag = Counter(hafta_say)
ust = sum(1 for c in hafta_say if c > FAIR_AKSAM_HAFTA)
print(f"\n=== AKŞAM+GECE adaleti (H20D, HAFTA)  (adil pay = {FAIR_AKSAM_HAFTA} hafta) ===")
print(f"max={max(hafta_say)}  ortalama={sum(hafta_say) / len(hafta_say):.2f}  "
      f"adil pay ÜSTÜ agent={ust}")
print("hafta → kaç agent:")
