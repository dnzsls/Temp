# -*- coding: utf-8 -*-
"""
ADIM 1 — CP-SAT iskeleti + saf COVERAGE
========================================
Amaç: Agent atama motorunun en küçük çekirdeğini görmek.
  - Karar değişkeni tanımla
  - Kısıt ekle
  - Çöz
  - Roster (agent × gün → vardiya) yazdır

Bu adımda SADECE iki sert kısıt var (spec 5.1-1 ve 5.1-2):
  (1) Coverage : her gün × vardiya için talep KADAR kişi atanır.
  (2) Günde tek vardiya.

Henüz YOK (sonraki adımlarda gelecek): off günleri, takım, hafta sonu,
aylık sayaçlar, adalet. Bu adımda herkes 5 günün hepsinde çalışır.

Veri, GERÇEK aylık model çıktısının (results[date][queue]['mip_info'])
formatını birebir taklit eder; böylece ileride gerçek çıktıyı takmak kolay.
"""

from ortools.sat.python import cp_model


# ─────────────────────────────────────────────────────────────────────────
# 1) GİRDİ — aylık model çıktısı (dummy ama gerçek formatta)
# ─────────────────────────────────────────────────────────────────────────
# Gerçekte bu yapı: results[date_str][queue]['mip_info']
#   'assignments'    = {shift_key: kişi}                  → MIP2 (talep)
#   'shift_coverage' = {shift_key: {start,end,company}}   → vardiya bilgisi
# Burada tek hafta (Pzt..Cum) için elle örnek kuruyoruz.

DAYS = ["Pzt", "Sal", "Çar", "Per", "Cum"]   # gün indeksleri 0..4

# Her gün için aylık model çıktısı. company=inhouse olanlarla ilgileniyoruz.
MONTHLY_OUTPUT = {
    "Pzt": {
        "assignments":    {"S1": 4, "S2": 2},
        "shift_coverage": {"S1": {"start": "09:00", "end": "18:00", "company": "inhouse"},
                           "S2": {"start": "12:00", "end": "21:00", "company": "inhouse"}},
    },
    "Sal": {
        "assignments":    {"S1": 3, "S2": 3},
        "shift_coverage": {"S1": {"start": "09:00", "end": "18:00", "company": "inhouse"},
                           "S2": {"start": "12:00", "end": "21:00", "company": "inhouse"}},
    },
    "Çar": {
        "assignments":    {"S1": 4, "S2": 2},
        "shift_coverage": {"S1": {"start": "09:00", "end": "18:00", "company": "inhouse"},
                           "S2": {"start": "12:00", "end": "21:00", "company": "inhouse"}},
    },
    "Per": {
        "assignments":    {"S1": 2, "S2": 4},
        "shift_coverage": {"S1": {"start": "09:00", "end": "18:00", "company": "inhouse"},
                           "S2": {"start": "12:00", "end": "21:00", "company": "inhouse"}},
    },
    "Cum": {
        "assignments":    {"S1": 3, "S2": 3},
        "shift_coverage": {"S1": {"start": "09:00", "end": "18:00", "company": "inhouse"},
                           "S2": {"start": "12:00", "end": "21:00", "company": "inhouse"}},
    },
}

# Agent master (dummy) — Adım 1'de hepsi tek kuyruk, esnek, izin yok.
AGENTS = ["A1", "A2", "A3", "A4", "A5", "A6"]


# ─────────────────────────────────────────────────────────────────────────
# 2) ÖN-İŞLEME — gerçek formattan motorun ihtiyacı olan talebi süz
# ─────────────────────────────────────────────────────────────────────────
# demand[day][shift] = inhouse talebi  (company != inhouse olanları atla)
def build_demand(monthly):
    demand = {}
    shifts = set()
    for day in DAYS:
        mi = monthly[day]
        sc = mi["shift_coverage"]
        demand[day] = {}
        for shift, cnt in mi["assignments"].items():
            if sc.get(shift, {}).get("company") != "inhouse":
                continue                     # outsource / part_time motorun işi değil
            demand[day][shift] = cnt
            shifts.add(shift)
    return demand, sorted(shifts)


demand, SHIFTS = build_demand(MONTHLY_OUTPUT)


# ─────────────────────────────────────────────────────────────────────────
# 3) CP-SAT MODELİ
# ─────────────────────────────────────────────────────────────────────────
model = cp_model.CpModel()

# --- Karar değişkeni: x[agent, gün, vardiya] ∈ {0,1} ---
# 1 ise "o agent o gün o vardiyada çalışıyor".
x = {}
for a in AGENTS:
    for day in DAYS:
        for s in SHIFTS:
            x[(a, day, s)] = model.NewBoolVar(f"x_{a}_{day}_{s}")

# --- KISIT 1: Coverage (sert) — her gün×vardiya talep kadar kişi ---
# spec 5.1-1
for day in DAYS:
    for s in SHIFTS:
        model.Add(
            sum(x[(a, day, s)] for a in AGENTS) == demand[day].get(s, 0)
        )

# --- KISIT 2: Günde tek vardiya (sert) ---
# spec 5.1-2. Adım 1'de off yok → herkes her gün TAM 1 vardiya (== 1).
# (Adım 2'de bunu "<= 1" yapıp off'a izin vereceğiz.)
for a in AGENTS:
    for day in DAYS:
        model.Add(sum(x[(a, day, s)] for s in SHIFTS) == 1)

# Adım 1'de amaç fonksiyonu yok — sadece feasibility (kısıtları sağlayan
# herhangi bir çözüm). Amaç/optimizasyon sonraki adımlarda gelecek.


# ─────────────────────────────────────────────────────────────────────────
# 4) ÇÖZ
# ─────────────────────────────────────────────────────────────────────────
solver = cp_model.CpSolver()
status = solver.Solve(model)

print("=" * 60)
print("ADIM 1 — saf coverage")
print("=" * 60)
print(f"Çözüm durumu: {solver.StatusName(status)}")
print(f"Vardiyalar: {SHIFTS}  |  Agentlar: {len(AGENTS)}")
print()

if status not in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    print("⚠ Çözüm bulunamadı (INFEASIBLE). Talep ile agent sayısı tutmuyor olabilir.")
    raise SystemExit

# ─────────────────────────────────────────────────────────────────────────
# 5) ÇIKTI — Roster (agent × gün matrisi)
# ─────────────────────────────────────────────────────────────────────────
print("ROSTER (agent × gün → vardiya):")
print(f"{'Agent':<8}" + "".join(f"{d:<7}" for d in DAYS))
for a in AGENTS:
    row = f"{a:<8}"
    for day in DAYS:
        cell = "off"
        for s in SHIFTS:
            if solver.Value(x[(a, day, s)]) == 1:
                cell = s
        row += f"{cell:<7}"
    print(row)

# --- Coverage kontrolü: isimli atama sonrası sayılar tutuyor mu? (spec Bölüm 7) ---
print("\nCOVERAGE KONTROLÜ (atanan / talep):")
print(f"{'Gün':<6}" + "".join(f"{s:>10}" for s in SHIFTS))
for day in DAYS:
    row = f"{day:<6}"
    for s in SHIFTS:
        atanan = sum(solver.Value(x[(a, day, s)]) for a in AGENTS)
        row += f"{atanan:>4}/{demand[day].get(s, 0):<5}"
    print(row)
