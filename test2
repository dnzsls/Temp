def _hs_sebep(agents):
    # öncelikli kategori (bir agent birden fazlaysa ilk uyanı say)
    hs = sum(1 for a in agents if a in hafta_sonu_yasak)                    # hamile/süt (HS yasak)
    ms = sum(1 for a in agents if a not in hafta_sonu_yasak and a in mesai_yok)  # mesaiye_kalamaz
    iz = sum(1 for a in agents if a not in hafta_sonu_yasak and a not in mesai_yok
             and all(dt.date.fromisoformat(ds) in izin_map.get(a, set()) for ds in hs_tarih))
    kalan = len(agents) - hs - ms - iz                                     # kısıtsız (çözücü tercih)
    return f"hamile/süt {hs} | mesaiye_kalamaz {ms} | tüm-HS-izinli {iz} | kısıtsız {kalan}"


