kadro = CONFIG_WEEKDAY["surplus_distribution"]["total_kadro"]["kitle"]

for d in ["2026-08-03","2026-08-04","2026-08-05","2026-08-06","2026-08-07"]:
    r = results.get(d,{}).get("kitle")
    if not r: continue
