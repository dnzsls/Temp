# %% [HÜCRE 29] — EXCEL ÇIKTISI (roster + plan_vs_gerçekleşen) ──────────
# Sheet1 "roster"           : roster_2 (agent × gün çizelge + flag + calisma/mesai/off özet)
# Sheet2 "plan_vs_gerceklesen": her kova için PLANLANAN (Stage-1 talebi) vs
#                              GERÇEKLEŞEN (kişi atamasından sonra) + fark.
XLSX_PATH = f"roster_{QUEUE}_{AY_YIL}_{AY_AY:02d}.xlsx"     # çıktı dosyası (dilediğin yolu ver)

# Sheet2 verisi: (gün, vardiya) → planlanan talep vs gerçekleşen atama
# (ARIFE_YARIM talep'te olmadığı için otomatik hariç → sadece gerçek kovalar)
_satir = []
for (ds, v), kisi in talep.items():
    atanan = sum(1 for a in AGENTS if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1)
    bas, bit = saat[(ds, v)]
    _satir.append({"tarih": ds,
                   "gun": DAY_TR[dt.date.fromisoformat(ds).weekday()],
