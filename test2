from openpyxl.styles import Font, PatternFill

_BOLD    = Font(bold=True)
_KIRMIZI = PatternFill("solid", fgColor="FFC7CE")          # off → açık kırmızı
_TURUNCU = PatternFill("solid", fgColor="FFC000")          # resmi tatil çalışması → turuncu
_SARI    = PatternFill("solid", fgColor="FFEB9C")          # hafta sonu MESAİ haftası → sarı
_YESIL   = PatternFill("solid", fgColor="C6EFCE")          # hafta sonu NORM haftası → yeşil
_GRI     = PatternFill("solid", fgColor="D9D9D9")          # off_t / off_t2 (blok, kota nötr) → gri

# Excel roster başlıkları: gün kolonlarına gün adı ekle (haftaları ayırt et) → "06-01 Pzt"
def _gun_etiket(c):
    try:
        d = dt.date.fromisoformat(str(c))
        return f"{str(c)[5:]} {DAY_TR[d.weekday()]}"
    except (ValueError, TypeError):
        return c                                    # takim/flag/özet kolonları → değişmez
roster_xl = roster_2.rename(columns=_gun_etiket)

# Renklendirme hazırlığı:
#  (1) kolon → (hafta sonu mu, ISO hafta); takim/flag/özet kolonları None
_col_info = []
for _c in roster_2.columns:
    try:
        _d = dt.date.fromisoformat(str(_c))
        _col_info.append((_d.weekday() >= 5, _d.isocalendar()[:2]))
    except (ValueError, TypeError):
        _col_info.append(None)
#  (2) her agent × hafta: MESAİ haftası mı (o hafta çalışılan > 5 − hafta içi tatil)
_wk_cols = {}
for _c in [c for c in roster.columns if c != "takim"]:
    _d = dt.date.fromisoformat(str(_c))
    _wk = _d.isocalendar()[:2]
    _wk_cols.setdefault(_wk, {"gun": [], "wtatil": 0})
    _wk_cols[_wk]["gun"].append(_c)
    if _d in TATIL and _d.weekday() < 5:
        _wk_cols[_wk]["wtatil"] += 1
_mesai_hafta = {}
for _a in roster_2.index:
    for _wk, _h in _wk_cols.items():
        _worked = sum(1 for c in _h["gun"]
                      if roster.at[_a, c] not in ("off", "off_t", "off_t2", "izin"))
        _w_izin = sum(1 for c in _h["gun"]                       # hafta içi izin (eşiği düşürür)
                      if dt.date.fromisoformat(str(c)).weekday() < 5
                      and roster.at[_a, c] == "izin")
        _mesai_hafta[(_a, _wk)] = _worked > (5 - _h["wtatil"] - _w_izin)
_agents_sirali = list(roster_2.index)

with pd.ExcelWriter(XLSX_PATH, engine="openpyxl") as _xl:
    roster_xl.to_excel(_xl, sheet_name="roster")                      # agent = index, gün-adlı başlık
    df_plan_gercek.to_excel(_xl, sheet_name="plan_vs_gerceklesen", index=False)
    df_gun_ozet.to_excel(_xl, sheet_name="gun_ozet", index=False)

    # başlık satırı (1. satır) tüm sheet'lerde BOLD
    for _ws in _xl.book.worksheets:
        for _cell in _ws[1]:
            _cell.font = _BOLD

    # roster sheet renklendirme:
    #   off=kırmızı | resmi tatil çalışması=turuncu | hafta sonu MESAİ=sarı | hafta sonu NORM=yeşil
    _ws = _xl.sheets["roster"]
    for _row in _ws.iter_rows(min_row=2):
        _a = _agents_sirali[_row[0].row - 2]                 # bu satırın agenti
        for _cell in _row:
            _v = _cell.value
            if not isinstance(_v, str):
                continue
            if _v == "off":
                _cell.fill = _KIRMIZI
            elif _v in ("off_t", "off_t2"):                  # blok off (kota nötr) → gri
                _cell.fill = _GRI
            elif _v == "izin":
                continue                                     # izin → renksiz
            elif _v.startswith("mesai"):                     # resmi tatil çalışması
                _cell.fill = _TURUNCU
            else:                                            # vardiya → hafta sonuysa mesai/norm rengi
                _j = _cell.column - 2                        # index kolonu (1) hariç
                if 0 <= _j < len(_col_info) and _col_info[_j] and _col_info[_j][0]:
                    _cell.fill = (_SARI if _mesai_hafta.get((_a, _col_info[_j][1]), False)
                                  else _YESIL)

print(f"Excel yazıldı: {XLSX_PATH}")
print(f"  Sheet1 'roster': {roster_2.shape[0]} agent × {roster_2.shape[1]} kolon")
print(f"  Sheet2 'plan_vs_gerceklesen': {df_plan_gercek.shape[0]} kova "
      f"(planlanan toplam {df_plan_gercek['planlanan'].sum()}, "
      f"gerçekleşen {df_plan_gercek['gerceklesen'].sum()})")
print(f"  Sheet3 'gun_ozet': {df_gun_ozet.shape[0]} gün (günlük ihtiyaç vs gerçekleşen)")
