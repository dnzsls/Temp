# -*- coding: utf-8 -*-
"""
AGENT DETAYLI MODEL — tek dosya akışı (hücre hücre, detaylı print)
==================================================================
2. aşama: aylık modelin kova-sayılarına İSİMLİ inhouse agent oturtma.

Çözüm birimi = TÜM AY, hafta içi + hafta sonu BİRLİKTE (spec 6.1).

Bu dosya `# %% [HÜCRE n]` bloklarıyla bölünmüştür; her hücre kendi
kontrol/print'ini basar. Spyder/VSCode'da hücre hücre, ya da düz
`python3 agent_detayli_model.py` ile baştan sona çalışır.

KAPSAM (şu an):
  AKTİF : coverage (sert), günde ≤1 vardiya, müsaitlik bloğu
          (özel-off + tam-ay bayrakları + tekrarlı Pzt/Cuma).
  OKUNUR ama henüz UYGULANMAZ : takim, sabah_calisir (≤20:00), sut/hamile
          (saat/hafta sonu/tatil), mesaiye_kalamaz (mesai+gün tavanı),
          off-kotası (haftada max 6), aylık sayaçlar, adalet.
          → kendi adımlarında roster üstünde görüp ekleyeceğiz.

GİRDİLER (hepsi GERÇEK — dummy yok):
  1) PKL_PATH   : aylık modelin results[date][queue] çıktısı (planlama).
  2) AGENT_PATH : agent master (xlsx/csv). Beklenen kolonlar:
       agent_user_code        agent kimliği (U111111)
       agent_name
       teamleader_name        takım parçası
       groupname              takım parçası (+lokasyon)
       working_main_group     lokasyon+kuyruk (okunur)
       line_based_main_group  KUYRUK: kitle_cagrilar | kurumsal_cagrilar | gold_cagrilar
       idari_izinli_flg       1 → tüm ay müsait değil
       pazartesi_izinli_flg   1 → her Pazartesi off
       cuma_izinli_flg        1 → her Cuma off
       sabah_calisir_flg      1 → yalnız bitişi ≤20:00 vardiya (sonraki adım)
       mesaiye_kalamaz_flg    1 → mesai yok + gün tavanı (sonraki adım)
       dogum_izni_flg         1 → tüm ay müsait değil
       hamile_flg             1 → hafta sonu/tatil yok (sonraki adım)
       sut_izni_flg           1 → ≤20:00 + 2sa eksik + mesai yok (sonraki adım)
       kismi_calisan_flg      1 → PART-TIME, ÇIKARILIR (haftaiçi planlamada yok)
  3) OFF_PATH   : özel off tablosu (xlsx/csv). Kolonlar:
       agent_user_code, agent_name, teamleader_name,
       off_talebi, off_talebi_desc,
       gun_1 .. gun_30/31   1 → o tarih izinli (gun_N = çalışılan ayın N'inci günü)
"""

import os
import pickle
import datetime as dt
import pandas as pd
from ortools.sat.python import cp_model


# %% [HÜCRE 0] — KONFİG ─────────────────────────────────────────────────
QUEUE       = "kitle"          # kitle | kurumsal | gold
PKL_PATH    = ""               # aylık model çıktısı pkl yolu
AGENT_PATH  = ""               # agent master xlsx/csv yolu
OFF_PATH    = ""               # özel off tablosu xlsx/csv yolu ("" → izin yalnız bayraklardan)

DAY_TR = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Pzr"]

print("=" * 70)
print(f"AGENT DETAYLI MODEL — kuyruk={QUEUE}  (çözüm birimi: TÜM AY)")
print("=" * 70)


def _read_table(path):
    """xlsx ya da csv'yi string olarak oku, boşları '' yap."""
    if path.lower().endswith(".csv"):
        return pd.read_csv(path, dtype=str).fillna("")
    return pd.read_excel(path, dtype=str).fillna("")


def _flag(v):
    """'1'/'0'/'' → bool"""
    return str(v).strip() in {"1", "1.0", "evet", "true", "True"}


# %% [HÜCRE 1] — PICKLE YÜKLE (planlama) ────────────────────────────────
if not PKL_PATH or not os.path.exists(PKL_PATH):
    raise SystemExit(f"[H1] PKL_PATH ayarlı değil / yok: {PKL_PATH!r}\n"
                     f"     H0'da aylık model çıktısı pkl yolunu ver.")

with open(PKL_PATH, "rb") as f:
    results = pickle.load(f)
print(f"[H1] Pickle yüklendi: {PKL_PATH}  →  {len(results)} gün")
ok = sum(1 for r in results.values() if r and QUEUE in r and r[QUEUE])
print(f"[H1] '{QUEUE}' kuyruğu OK gün sayısı: {ok}/{len(results)}")


# %% [HÜCRE 2] — AYIN GÜNLERİ (hafta içi + sonu) + TALEP ────────────────
def haftalara_bol(results):
    """Tüm tarihleri ISO-haftaya göre gruplar (hafta sonu DAHİL)."""
    haftalar = {}
    for ds in sorted(results.keys()):
        d = dt.date.fromisoformat(ds)
        yil, hafta, _ = d.isocalendar()
        haftalar.setdefault((yil, hafta), []).append(ds)
    return [sorted(v) for _, v in sorted(haftalar.items())]


def talep_cikar(results, queue, gunler):
    """Verilen günler için inhouse talebi süz."""
    demand, sc_by_day, shifts = {}, {}, set()
    for ds in gunler:
        demand[ds], sc_by_day[ds] = {}, {}
        r = results.get(ds)
        if not r or queue not in r or not r[queue]:
            continue
        mi = r[queue]["mip_info"]
        sc = mi.get("shift_coverage", {})
        for shift, cnt in mi.get("assignments", {}).items():
            if cnt <= 0 or sc.get(shift, {}).get("company") != "inhouse":
                continue                           # outsource / part_time → modelin işi değil
            demand[ds][shift] = cnt
            sc_by_day[ds][shift] = sc[shift]
            shifts.add(shift)
    return demand, sc_by_day, sorted(shifts)


HAFTALAR = haftalara_bol(results)
GUNLER   = sorted(results.keys())                     # ayın TÜM günleri
demand, sc_by_day, SHIFTS = talep_cikar(results, QUEUE, GUNLER)

# Çalışılan ay (gun_x eşlemesi ve tekrarlı izinler için)
AY_YIL  = dt.date.fromisoformat(GUNLER[0]).year
AY_AY   = dt.date.fromisoformat(GUNLER[0]).month
GUN_SET = {dt.date.fromisoformat(ds) for ds in GUNLER}


def is_hs(ds):
    return dt.date.fromisoformat(ds).weekday() > 4


def etiket(ds):
    d = dt.date.fromisoformat(ds)
    return f"{d.day:02d}{DAY_TR[d.weekday()]}" + ("*" if d.weekday() > 4 else " ")


hs_gun = sum(1 for ds in GUNLER if is_hs(ds))
print(f"[H2] Ay: {AY_YIL}-{AY_AY:02d}  ({len(GUNLER)} gün, {len(HAFTALAR)} hafta; "
      f"hafta içi {len(GUNLER)-hs_gun}, hafta sonu {hs_gun})")
print(f"[H2] inhouse vardiyalar: {SHIFTS}")
print(f"[H2] AY toplam inhouse kişi-slot: {sum(sum(g.values()) for g in demand.values())}")


# %% [HÜCRE 3] — AGENT MASTER + ÖZEL OFF YÜKLE (gerçek şema) ────────────
if not AGENT_PATH or not os.path.exists(AGENT_PATH):
    raise SystemExit(f"[H3] AGENT_PATH ayarlı değil / yok: {AGENT_PATH!r}")

df_agents = _read_table(AGENT_PATH)
print(f"[H3] Agent master yüklendi: {len(df_agents)} satır, kolon: {list(df_agents.columns)}")


def norm_kuyruk(v):
    """'kitle_cagrilar' → 'kitle'"""
    return str(v).strip().lower().replace("_cagrilar", "").replace("_cagri", "")


# --- 3a) Özel off tablosu → off_map[code] = set(date) -------------------
off_map = {}
if OFF_PATH and os.path.exists(OFF_PATH):
    df_off = _read_table(OFF_PATH)
    gun_kolonlari = [c for c in df_off.columns if c.lower().startswith("gun_")]
    for _, row in df_off.iterrows():
        d = row.to_dict()
        code = str(d.get("agent_user_code", "")).strip()
        if not code:
            continue
        gunler = set()
        for c in gun_kolonlari:
            if _flag(d.get(c, "")):
                n = int(c.split("_")[1])               # gun_5 → 5
                try:
                    gunler.add(dt.date(AY_YIL, AY_AY, n))
                except ValueError:
                    pass                                # ayda olmayan gün (gun_31 vs.)
        if gunler:
            off_map[code] = gunler
    print(f"[H3] Özel off yüklendi: {len(df_off)} satır, "
          f"{len(off_map)} agentın özel izni var ({len(gun_kolonlari)} gün kolonu)")
else:
    print(f"[H3] Özel off tablosu yok (OFF_PATH boş) → izin yalnız bayraklardan")

# --- 3b) Agent master → AG sözlüğü --------------------------------------
PAZARTESI, CUMA = 0, 4
AG = {}
pt_elendi = 0
for _, row in df_agents.iterrows():
    d = row.to_dict()
    code = str(d.get("agent_user_code", "")).strip()
    if not code:
        continue
    if norm_kuyruk(d.get("line_based_main_group", "")) != QUEUE:
        continue                                       # başka kuyruk
    if _flag(d.get("kismi_calisan_flg", "")):
        pt_elendi += 1
        continue                                       # PART-TIME → çıkar

    # tekrarlı + tam-ay + özel off → tek bir izin kümesi
    izin = set(off_map.get(code, set()))
    if _flag(d.get("idari_izinli_flg", "")) or _flag(d.get("dogum_izni_flg", "")):
        izin |= GUN_SET                                # tüm ay müsait değil
    if _flag(d.get("pazartesi_izinli_flg", "")):
        izin |= {x for x in GUN_SET if x.weekday() == PAZARTESI}
    if _flag(d.get("cuma_izinli_flg", "")):
        izin |= {x for x in GUN_SET if x.weekday() == CUMA}

    AG[code] = {
        "name":   str(d.get("agent_name", "")).strip(),
        "takim":  f"{str(d.get('groupname','')).strip()}|{str(d.get('teamleader_name','')).strip()}",
        "tip":    "esnek",                             # calisma_tipi yok → hepsi esnek
        "sabit_vardiya": "",
        "izin":   izin,
        # aşağıdakiler OKUNUR, sonraki adımlarda uygulanacak
        "hamile":        _flag(d.get("hamile_flg", "")),
        "sut":           _flag(d.get("sut_izni_flg", "")),
        "sabah":         _flag(d.get("sabah_calisir_flg", "")),
        "mesai_yok":     _flag(d.get("mesaiye_kalamaz_flg", "")),
        "idari":         _flag(d.get("idari_izinli_flg", "")),
        "dogum":         _flag(d.get("dogum_izni_flg", "")),
    }

SABIT = [a for a in AG if AG[a]["tip"] == "sabit"]     # şimdilik boş (calisma_tipi yok)
ESNEK = [a for a in AG if AG[a]["tip"] == "esnek"]

print(f"[H3] '{QUEUE}' agent: {len(AG)}  (PT elendi: {pt_elendi})")
print(f"[H3] takım sayısı: {len({AG[a]['takim'] for a in AG})}")
print(f"[H3] bayraklar — hamile:{sum(AG[a]['hamile'] for a in AG)}  "
      f"sut:{sum(AG[a]['sut'] for a in AG)}  "
      f"sabah_calisir:{sum(AG[a]['sabah'] for a in AG)}  "
      f"mesai_yok:{sum(AG[a]['mesai_yok'] for a in AG)}")
tam_ay_off = [a for a in AG if AG[a]['izin'] >= GUN_SET]
print(f"[H3] tüm-ay izinli (idari/doğum): {len(tam_ay_off)} → {tam_ay_off[:10]}"
      f"{' ...' if len(tam_ay_off) > 10 else ''}")
izinli = {a: len(AG[a]['izin']) for a in AG if AG[a]['izin'] and a not in tam_ay_off}
print(f"[H3] kısmi izinli agent sayısı: {len(izinli)}  "
      f"(kişi başı izin günü, ilk 10): {dict(list(izinli.items())[:10])}")


# %% [HÜCRE 4] — ÖN-İŞLEME (sabit gömme → rezidüel + müsaitlik) ─────────
def saat_to_shift(ds, saat):
    for s, info in sc_by_day[ds].items():
        if f"{info.get('start')}-{info.get('end')}" == saat:
            return s
    return None


fixed_roster = {}
sabit_count = {ds: {s: 0 for s in SHIFTS} for ds in GUNLER}
uyari_sabit = []

for a in SABIT:                                        # şimdilik boş
    sv = AG[a]["sabit_vardiya"]
    fixed_roster[a] = {}
    for ds in GUNLER:
        d = dt.date.fromisoformat(ds)
        if d in AG[a]["izin"]:
            fixed_roster[a][ds] = "izin"
            continue
        s = saat_to_shift(ds, sv)
        if s is None:
            fixed_roster[a][ds] = f"?{sv}"
            uyari_sabit.append((a, ds, sv))
        else:
            fixed_roster[a][ds] = s
            sabit_count[ds][s] += 1

residual = {ds: {} for ds in GUNLER}
uyari_negatif = []
for ds in GUNLER:
    for s in SHIFTS:
        ham = demand[ds].get(s, 0) - sabit_count[ds][s]
        residual[ds][s] = max(0, ham)
        if ham < 0:
            uyari_negatif.append((ds, s, demand[ds].get(s, 0), sabit_count[ds][s]))

if uyari_negatif:
    print(f"[H4] ⚠ NEGATİF rezidüel (sabit > talep) — kırpıldı: {uyari_negatif[:8]}")
else:
    print(f"[H4] ✓ negatif rezidüel yok (sabit agent: {len(SABIT)})")

print(f"[H4] MÜSAİTLİK ÖN-KONTROL (esnek-müsait vs rezidüel talep):")
yetersiz = []
for ds in GUNLER:
    d = dt.date.fromisoformat(ds)
    musait = [a for a in ESNEK if d not in AG[a]["izin"]]
    rez_top = sum(residual[ds].values())
    if len(musait) < rez_top:
        yetersiz.append((etiket(ds).strip(), len(musait), rez_top))
if yetersiz:
    print(f"  ⚠ YETERSİZ günler (müsait<talep): {yetersiz}")
else:
    print(f"  ✓ her gün esnek-müsait ≥ rezidüel talep")


# %% [HÜCRE 5] — CP-SAT MODEL ───────────────────────────────────────────
model = cp_model.CpModel()

x = {}
for a in ESNEK:
    for ds in GUNLER:
        d = dt.date.fromisoformat(ds)
        if d in AG[a]["izin"]:
            continue                                   # izin → o gün hiç değişken yok
        for s in SHIFTS:
            x[(a, ds, s)] = model.NewBoolVar(f"x_{a}_{ds}_{s}")

# KISIT 1 — Coverage (sert): esnek atama == rezidüel talep
for ds in GUNLER:
    for s in SHIFTS:
        model.Add(sum(x[(a, ds, s)] for a in ESNEK if (a, ds, s) in x) == residual[ds][s])

# KISIT 2 — Günde ≤1 vardiya
for a in ESNEK:
    for ds in GUNLER:
        gunun = [x[(a, ds, s)] for s in SHIFTS if (a, ds, s) in x]
        if gunun:
            model.Add(sum(gunun) <= 1)

print(f"[H5] Model kuruldu. Karar değişkeni (x): {len(x)}")
print(f"[H5] Sert kısıt: coverage ({len(GUNLER)*len(SHIFTS)} adet) + günde≤1 vardiya")


# %% [HÜCRE 6] — ÇÖZ ────────────────────────────────────────────────────
solver = cp_model.CpSolver()
status = solver.Solve(model)
print(f"[H6] Çözüm durumu: {solver.StatusName(status)}  (süre: {solver.WallTime():.3f} sn)")
if status not in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    print("[H6] ⚠ INFEASIBLE — bir günde esnek-müsait < rezidüel talep olabilir (H4'e bak).")
    raise SystemExit


# %% [HÜCRE 7] — ÇIKTI: ROSTER + COVERAGE KONTROL ───────────────────────
def hucre(a, ds):
    d = dt.date.fromisoformat(ds)
    if a in SABIT:
        return fixed_roster[a][ds]
    if d in AG[a]["izin"]:
        return "izin"
    for s in SHIFTS:
        if (a, ds, s) in x and solver.Value(x[(a, ds, s)]) == 1:
            return s
    return "off"


print(f"[H7] ROSTER (agent × gün, hafta hafta; * = hafta sonu)")
for i, hafta in enumerate(HAFTALAR):
    print(f"  ── Hafta {i+1} ──")
    print(f"  {'agent':<9}" + "".join(f"{etiket(ds):<7}" for ds in hafta))
    for a in SABIT + ESNEK:
        row = f"  {a:<9}" + "".join(f"{hucre(a, ds):<7}" for ds in hafta)
        print(row)

print(f"[H7] COVERAGE KONTROLÜ (atanan / talep) — sadece SAPANLAR:")
tum_ok = True
for ds in GUNLER:
    parcalar = []
    for s in SHIFTS:
        esnek_atanan = sum(solver.Value(x[(a, ds, s)]) for a in ESNEK if (a, ds, s) in x)
        toplam = esnek_atanan + sabit_count[ds][s]
        talep = demand[ds].get(s, 0)
        if toplam != talep:
            tum_ok = False
            parcalar.append(f"{s}:{toplam}/{talep}✗")
    if parcalar:
        print(f"  {etiket(ds).strip()}: " + "  ".join(parcalar))
print(f"[H7] {'✓ TÜM AY COVERAGE TUTUYOR' if tum_ok else '⚠ COVERAGE SAPMASI VAR'}")

print(f"[H7] kişi başı AY sayaçları (esnek)  — hs = hafta sonu çalışma:")
for a in ESNEK:
    calisma = sum(1 for ds in GUNLER if hucre(a, ds) in SHIFTS)
    hs_cal  = sum(1 for ds in GUNLER if is_hs(ds) and hucre(a, ds) in SHIFTS)
    izin_say = len(AG[a]["izin"] & GUN_SET)
    print(f"  {a:<9} çalışma={calisma:>2}  hs={hs_cal:>2}  izin={izin_say:>2}")
