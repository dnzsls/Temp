# roster_2 SONUNA özet kolonlar: çalışma / mesai / norm / resmi_tatil / off (HAFTALIK)
#   Her hafta: W=hafta içi (tatil-dışı) çalışma, E=hafta sonu (tatil-dışı) çalışma,
#              tat=resmi tatilde çalışma, T=normal iş günü (5 − hafta içi tatil).
#   mesai_gun       = Σ max(0, (W+E) − T)  → RESMİ TATİL HARİÇ eşiği aşan (fazla mesai)
#   norm_gun        = Σ min(E, max(0, T − W))  → hafta içi off yerine hafta sonu (swap)
#   resmi_tatil_gun = Σ tat  → resmi tatilde çalışılan gün (mesaiden AYRI)
#   calisma_gun     = toplam − mesai − resmi_tatil (normal + arife + norm)
#   off_gun         = off gün sayısı
_gun = [c for c in roster.columns if c != "takim"]                 # tarih kolonları
_OFF_ONLY = ["off", "off_t", "off_t2"]                             # off türleri (model off + blok off_t/off_t2)
_OFF_LIKE = _OFF_ONLY + ["izin"]                                   # çalışma-dışı tüm hücreler (off + izin)
_hafta = {}                                        # (yıl,hafta) → gün kolonları kategorili
for c in _gun:
    d = dt.date.fromisoformat(c)
    wk = d.isocalendar()[:2]
    _hafta.setdefault(wk, {"wd": [], "we": [], "tat": [], "wtatil": 0})
    if d in TATIL:                                  # resmi tatil (hafta içi/sonu farketmez)
        _hafta[wk]["tat"].append(c)
        if d.weekday() < 5:
            _hafta[wk]["wtatil"] += 1
    elif d.weekday() >= 5:                          # hafta sonu (tatil değil)
        _hafta[wk]["we"].append(c)
    else:                                           # hafta içi (tatil değil)
        _hafta[wk]["wd"].append(c)


# SINIR HAFTASI TAŞIMASI (H8C): o haftanın önceki aya düşen günleri W/E/T'ye
# KATILIR. Katılmazsa Temmuz'da 5 gün çalışan agentın 01 Ağustos Cmt'si "norm"
# görünür (W=0 sanılır) — oysa eşik zaten dolu, o gün MESAİ.
# Çift sayma yok: önceki ayın KENDİ payı (sadece önceki ay günleriyle hesaplanan
# mesai/norm) düşülür → bu aya yalnız BU AYIN günlerinden doğan mesai/norm yazılır.
#   Ör. Temmuz 5 gün + 01 Ağustos: tam hafta mesai=1, Temmuz payı=0 → Ağustos'a 1 mesai.
#   Ör. ay Pazar başlıyorsa ve önceki ay kısmı zaten 6 gün ise → o fazla gün
#       önceki ayın mesaisi, buraya YAZILMAZ.
_TAS_HI = [d for d in TASIMA_GUNLER if d.weekday() < 5]     # önceki ay hafta içi günleri
_TAS_HS = [d for d in TASIMA_GUNLER if d.weekday() >= 5]    # önceki ay hafta sonu günleri
_hafta_norm = {}                                   # (agent, hafta) → BU AYA ait norm günü (H29 rengi okur)


def _mesai_norm_say(a):
    mesai, norm, rtatil = 0, 0, 0
    _cal = onceki_calisti.get(a, set())             # önceki ayda çalıştığı günler (yoksa boş → taşıma yok)
    for wk, h in _hafta.items():
        W   = sum(1 for c in h["wd"]  if roster.at[a, c] not in _OFF_LIKE)
        E   = sum(1 for c in h["we"]  if roster.at[a, c] not in _OFF_LIKE)
        tat = sum(1 for c in h["tat"] if roster.at[a, c] not in _OFF_LIKE)
        w_izin = sum(1 for c in h["wd"] if roster.at[a, c] == "izin")   # hafta içi izin (kotayı düşürür)
        T = 5 - h["wtatil"] - w_izin                # normal iş günü (hafta içi tatil + İZİN düşülmüş)
        W_o = E_o = 0                               # önceki aydan taşınan hafta içi / hafta sonu çalışma
        if wk == SINIR_HAFTA and TASIMA_GUNLER:
            W_o = sum(1 for d in _TAS_HI if d in _cal)
            E_o = sum(1 for d in _TAS_HS if d in _cal)
            T -= onceki_izin_hi.get(a, 0)           # önceki ay hafta içi izni de eşiği düşürür
        # tam hafta (iki ay birlikte) − önceki ayın kendi payı = BU AYIN mesai/norm'u
        m_tam = max(0, (W + W_o + E + E_o) - T)
        n_tam = min(E + E_o, max(0, T - (W + W_o)))
        m_onc = max(0, (W_o + E_o) - T)             # taşıma yoksa 0 → eski davranış
        n_onc = min(E_o, max(0, T - W_o))
        mesai += max(0, m_tam - m_onc)              # RESMİ TATİL HARİÇ eşiği aşan → mesai
        norm  += max(0, n_tam - n_onc)              # hafta içi off yerine hafta sonu → norm
        _hafta_norm[(a, wk)] = max(0, n_tam - n_onc)   # H29: bu haftanın kaç HS günü yeşil
        rtatil += tat                               # resmi tatilde çalışma → ayrı sayaç
    return mesai, norm, rtatil


_cal_top = (~roster[_gun].isin(_OFF_LIKE)).sum(axis=1)             # toplam çalışma
_off     = (roster[_gun].isin(_OFF_ONLY)).sum(axis=1)             # off_gun = off + off_t + off_t2 (A)
_mn = {a: _mesai_norm_say(a) for a in roster_2.index}
# calisma_gun = toplam − mesai − resmi_tatil (normal + arife + norm; overtime ve tatil hariç)
roster_2["calisma_gun"]     = [int(_cal_top[a]) - _mn[a][0] - _mn[a][2] for a in roster_2.index]
roster_2["mesai_gun"]       = [_mn[a][0] for a in roster_2.index]     # resmi tatil HARİÇ
roster_2["norm_gun"]        = [_mn[a][1] for a in roster_2.index]
roster_2["resmi_tatil_gun"] = [_mn[a][2] for a in roster_2.index]     # resmi tatilde çalışma
roster_2["off_gun"]         = [int(_off[a]) for a in roster_2.index]

