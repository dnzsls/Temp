# =============== GECE ATAMA TANI SCRIPT'İ ===============
TARIH = "2026-08-05"        # 16 ihtiyacı olan gün
QUEUE = "kitle"
BIND  = "00:30"             # bağlayıcı slot (16'yı belirleyen)
CFG   = CONFIG_WEEKDAY

qr = results[TARIH][QUEUE]
mi = qr["mip_info"]
sc = mi["shift_coverage"]
s1 = mi.get("mip_info_stage1")           # MIP1 snapshot (surplus ÖNCESİ)
surp = mi.get("surplus_added", {}) or {}

if s1 is None:
    print("⚠ mip_info_stage1 yok (surplus kapalı olabilir) — MIP1 kırılımı gösterilemez")
    s1_assign, s1_in, s1_out = {}, {}, {}
else:
    s1_assign = s1.get("assignments", {})
    s1_in  = s1.get("mip_in_by_slot", {})
    s1_out = s1.get("mip_out_by_slot", {})

# ---- 1) Bağlayıcı slotu (00:30) kapsayan TÜM vardiyalar: MIP1 vs surplus vs final ----
print("="*78)
print(f"{BIND} SLOTUNU KAPSAYAN VARDİYALAR — MIP1(taban) → +SURPLUS → FINAL")
print("="*78)
print(f"{'vardiya':26} {'şirket':10} {'saat':13} {'MIP1':>5} {'+surp':>6} {'final':>6}")
covering = [s for s in sc if BIND in sc[s].get("slots", [])]
tot_in_base = tot_out_base = tot_in_surp = tot_out_surp = 0
for shift in sorted(covering, key=lambda s: (sc[s].get("company",""), sc[s].get("start",""))):
    info = sc[shift]
    base = s1_assign.get(shift, 0)
    add  = surp.get(shift, 0)
    fin  = mi["assignments"].get(shift, 0)
    if base == 0 and fin == 0:
        continue
    comp = info.get("company","")
    print(f"{shift:26} {comp:10} {info.get('start','')}-{info.get('end',''):<6} "
          f"{base:>5} {add:>6} {fin:>6}")
    if comp == "inhouse":  tot_in_base += base;  tot_in_surp += add
    else:                  tot_out_base += base; tot_out_surp += add

print("-"*78)
print(f"{'TOPLAM inhouse':26} {'':10} {'':13} {tot_in_base:>5} {tot_in_surp:>6} {tot_in_base+tot_in_surp:>6}")
print(f"{'TOPLAM outsource':26} {'':10} {'':13} {tot_out_base:>5} {tot_out_surp:>6} {tot_out_base+tot_out_surp:>6}")

# ---- 2) Bağlayıcı slotta MIP1 taban: inhouse/outsource nasıl bölünmüş ----
print("\n" + "="*78)
print(f"{BIND} SLOTUNDA COVERAGE — MIP1 taban vs FINAL")
print("="*78)
print(f"erlang ihtiyaç       : {qr['erlang_by_slot'].get(BIND)}")
print(f"MIP1  → inhouse {s1_in.get(BIND,0):>3}  + outsource {s1_out.get(BIND,0):>3}  = {s1_in.get(BIND,0)+s1_out.get(BIND,0)}")
print(f"FINAL → inhouse {mi['mip_in_by_slot'].get(BIND,0):>3}  + outsource {mi['mip_out_by_slot'].get(BIND,0):>3}  = {mi['mip_in_by_slot'].get(BIND,0)+mi['mip_out_by_slot'].get(BIND,0)}")

# ---- 3) Kadro / surplus özeti (gün toplamı) ----
print("\n" + "="*78)
print("GÜN TOPLAMI — MIP1 vs FINAL vs KADRO")
print("="*78)
kadro = CFG["surplus_distribution"]["total_kadro"].get(QUEUE, {})
if s1:
    print(f"inhouse : MIP1={s1.get('total_inhouse_kisi')}  final={mi['total_inhouse_kisi']}  "
          f"→ surplus eklendi = {mi['total_inhouse_kisi']-s1.get('total_inhouse_kisi',0)}  (kadro={kadro.get('inhouse')})")
    print(f"outsrc  : MIP1={s1.get('total_outsource_kisi')}  final={mi['total_outsource_kisi']}  "
          f"→ surplus eklendi = {mi['total_outsource_kisi']-s1.get('total_outsource_kisi',0)}  (kadro={kadro.get('outsource')})")
