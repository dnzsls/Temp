# 1) H19'un GERÇEKLEŞEN cezası: takım-hafta başına kaç fazla tip
_bol = {}
for T, uyeler in takimlar.items():
    for wk, gunler in haftalar.items():
        if wk in tatil_haftalari:
            continue
        hi = [ds for ds in gunler if dt.date.fromisoformat(ds).weekday() < 5]
        tipler = {saat[(ds, v)][0] for a in uyeler for ds in hi
                  for v in gun_vardiyalari[ds]
                  if (a, ds, v) in x and solver.Value(x[(a, ds, v)])}
        if tipler:
            _bol[(T, wk)] = len(tipler) - 1
print(f"takım-hafta: {len(_bol)}  |  tek tip: {sum(1 for v in _bol.values() if v == 0)}"
      f"  |  fazla tip toplamı: {sum(_bol.values())}"
      f"  → H19 cezası = {W_TAKIM * sum(_bol.values())}")
print("en bölünmüş 10:", sorted(_bol.items(), key=lambda kv: -kv[1])[:10])

# 2) rakip kalemler ne kadar yer kaplıyor
_sapma = sum(max(0, abs(sum(1 for a in AGENTS if (a, ds, v) in x and solver.Value(x[(a, ds, v)])) - k) - SERBEST_COVERAGE)
             for (ds, v), k in talep.items())
_agir  = sum(max(0, abs(sum(1 for a in AGENTS if (a, ds, v) in x and solver.Value(x[(a, ds, v)])) - k) - AGIR_ESIK)
             for (ds, v), k in talep.items())
print(f"coverage ceza1={W_COVERAGE*_sapma}  ceza2(AĞIR)={W_COVERAGE2*_agir}  "
      f"amaç toplam={solver.ObjectiveValue():.0f}")

