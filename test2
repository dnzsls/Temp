# roster_2 SONUNA özet kolonlar: çalışma / mesai / norm / resmi_tatil / off (HAFTALIK)
#   Her hafta: W=hafta içi (tatil-dışı) çalışma, E=hafta sonu (tatil-dışı) çalışma,
#              tat=resmi tatilde çalışma, T=normal iş günü (5 − hafta içi tatil).
#   mesai_gun       = Σ max(0, (W+E) − T)  → RESMİ TATİL HARİÇ eşiği aşan (fazla mesai)
#   norm_gun        = Σ min(E, max(0, T − W))  → hafta içi off yerine hafta sonu (swap)
#   resmi_tatil_gun = Σ tat  → resmi tatilde çalışılan gün (mesaiden AYRI)
#   calisma_gun     = toplam − mesai − resmi_tatil (normal + arife + norm)
#   off_gun         = off gün sayısı
_gun = [c for c in roster.columns if c != "takim"]                 # tarih kolonları
_OFF_ONLY = ["off", "off_t", "off_t2"]                             # off türleri (model off + blok off_t/off_t2)
_OFF_LIKE = _OFF_ONLY + ["izin"]                                   # çalışma-dışı tüm hücreler (off + izin)
_hafta = {}                                        # (yıl,hafta) → gün kolonları kategorili
for c in _gun:
    d = dt.date.fromisoformat(c)
    wk = d.isocalendar()[:2]
    _hafta.setdefault(wk, {"wd": [], "we": [], "tat": [], "wtatil": 0})
    if d in TATIL:                                  # resmi tatil (hafta içi/sonu farketmez)
        _hafta[wk]["tat"].append(c)
        if d.weekday() < 5:
            _hafta[wk]["wtatil"] += 1
    elif d.weekday() >= 5:                          # hafta sonu (tatil değil)
        _hafta[wk]["we"].append(c)
    else:                                           # hafta içi (tatil değil)
        _hafta[wk]["wd"].append(c)


def _mesai_norm_say(a):
    mesai, norm, rtatil = 0, 0, 0
    for h in _hafta.values():
        W   = sum(1 for c in h["wd"]  if roster.at[a, c] not in _OFF_LIKE)
        E   = sum(1 for c in h["we"]  if roster.at[a, c] not in _OFF_LIKE)
        tat = sum(1 for c in h["tat"] if roster.at[a, c] not in _OFF_LIKE)
        w_izin = sum(1 for c in h["wd"] if roster.at[a, c] == "izin")   # hafta içi izin (kotayı düşürür)
        T = 5 - h["wtatil"] - w_izin                # normal iş günü (hafta içi tatil + İZİN düşülmüş)
        mesai  += max(0, (W + E) - T)               # RESMİ TATİL HARİÇ eşiği aşan → mesai
        norm   += min(E, max(0, T - W))             # hafta içi off yerine hafta sonu → norm
        rtatil += tat                               # resmi tatilde çalışma → ayrı sayaç
    return mesai, norm, rtatil


_cal_top = (~roster[_gun].isin(_OFF_LIKE)).sum(axis=1)             # toplam çalışma
_off     = (roster[_gun].isin(_OFF_ONLY)).sum(axis=1)             # off_gun = off + off_t + off_t2 (A)
_mn = {a: _mesai_norm_say(a) for a in roster_2.index}
# calisma_gun = toplam − mesai − resmi_tatil (normal + arife + norm; overtime ve tatil hariç)
