
# --- ÖNCEKİ AY TAŞIMA TABLOSU: keşif ---
df_onceki = pd.read_sql("SELECT * FROM <SEMA>.<TABLO>", conn)   # tablo adını yaz

print("boyut:", df_onceki.shape)
print("\ndtypes:\n", df_onceki.dtypes)
print("\nilk 10 satır:")
print(df_onceki.head(10).to_string(index=False))

# az sayıda farklı değer taşıyan kolonlar → durum/off/izin kodlaması burada görünür
print("\nkategorik kolonlar:")
for c in df_onceki.columns:
    n = df_onceki[c].nunique(dropna=False)
    if n <= 25:
        print(f"  {c} ({n} farklı): {sorted(df_onceki[c].astype(str).unique())[:25]}")

# tarih kolonu varchar → gerçek format ve aralık
for c in df_onceki.columns:
    if "tarih" in c.lower() or "date" in c.lower() or "gun" in c.lower():
        s = df_onceki[c].astype(str)
        print(f"\n{c}: min={s.min()}  max={s.max()}  örnek={s.head(3).tolist()}")

# agent × gün kapsama: her agent için kaç gün satır var (eksik gün var mı?)
_ac = [c for c in df_onceki.columns if "agent" in c.lower() and "code" in c.lower()]
_tc = [c for c in df_onceki.columns if "tarih" in c.lower() or "date" in c.lower()]
if _ac and _tc:
    g = df_onceki.groupby(_ac[0])[_tc[0]].nunique()
    print(f"\nagent sayısı: {g.size}  |  agent başına gün: min={g.min()} max={g.max()}")
    print("gün sayısı dağılımı:", g.value_counts().sort_index().to_dict())
