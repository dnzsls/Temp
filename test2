# Sheet3: GÜN SONU — her gün toplam ihtiyaç (planlanan) vs gerçekleşen + fark
df_gun_ozet = (df_plan_gercek.groupby(["tarih", "gun"], as_index=False)
               [["planlanan", "gerceklesen"]].sum())
