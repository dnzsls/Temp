def _gece(v):
    p = _vardiya_parse(v);  return bool(p) and p[0] in ("00:00", "24:00")
def _gunduz(v):
    p = _vardiya_parse(v);  return bool(p) and p[0] not in ("00:00", "24:00")

A = B = 0
ornA, ornB = [], []
for a, g in _d.groupby("agent_user_code"):
    gv = dict(zip(g["tarih"], g["vardiya"]))
    for d, v in gv.items():
        n = gv.get(d + dt.timedelta(days=1))
        if n is None:
            continue
        if _gece(v) and _gunduz(n):
            A += 1
            if len(ornA) < 3: ornA.append((a, d.isoformat(), v, "→", n))
        if _gunduz(v) and _gece(n):
            B += 1
            if len(ornB) < 3: ornB.append((a, d.isoformat(), v, "→", n))

print("\n3) konvansiyon testi:")
print(f"   A = gece(D) → gündüz(D+1) : {A}")
for o in ornA: print("       ", o)
print(f"   B = gündüz(D) → gece(D+1) : {B}")
