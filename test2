# %% [HÜCRE 13] — SABAH ÇALIŞANLAR (bitiş ≤ 20:00) ─────────────────────
# sabah_calisir_flg=1 → yalnız aynı gün biten ve bitişi ≤20:00 vardiyalar.
# Uygun olmayan (gün, vardiya) için o agentın değişkeni = 0.
def dakika(t):                                     # "09:00" → 540, "24:00"/"00:00" → 1440
    s, d = str(t).split(":")
    m = int(s) * 60 + int(d)
    return 1440 if m == 0 else m                    # 00:00 = gece yarısı (gün sonu)

LIMIT = dakika("20:00")                            # 1200

sabah_agents = set()
for _, row in df_tam.iterrows():
    if pd.to_numeric(row.get("sabah_calisir_flg", 0), errors="coerce") == 1:
        sabah_agents.add(str(row["agent_user_code"]).strip())

n = 0
for a in sabah_agents:
    for ds in PLAN_GUNLER:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) not in x:
                continue
            bas, bit = saat[(ds, v)]
            uygun = dakika(bas) < dakika(bit) and dakika(bit) <= LIMIT
            if not uygun:
                model.Add(x[(a, ds, v)] == 0)      # bu vardiyada çalışamaz
                n += 1

print(f"sabah çalışan agent: {len(sabah_agents)}  |  yasaklanan (agent,gün,vardiya): {n}")


# %% [HÜCRE 14] — HAMİLE / SÜT: HAFTA SONU ÇALIŞAMAZ ──────────────────
# hamile_flg / sut_izni_flg = 1 → Cmt/Pzr çalışamaz.
# (≤20:00 bu agentlarda zaten sabah_calisir ile sağlanıyor.
#  Resmi tatil kısmı, tatil takvimi girdisi gelince eklenecek.)
hafta_sonu_yasak = set()
for _, row in df_tam.iterrows():
    hamile = pd.to_numeric(row.get("hamile_flg", 0), errors="coerce") == 1
    sut    = pd.to_numeric(row.get("sut_izni_flg", 0), errors="coerce") == 1
    if hamile or sut:
        hafta_sonu_yasak.add(str(row["agent_user_code"]).strip())

n = 0
for a in hafta_sonu_yasak:
    for ds in PLAN_GUNLER:
        if dt.date.fromisoformat(ds).weekday() < 5:    # hafta içi → serbest
            continue
        for v in gun_vardiyalari[ds]:                  # Cmt/Pzr → yasak
            if (a, ds, v) in x:
                model.Add(x[(a, ds, v)] == 0)
                n += 1

print(f"hafta sonu yasaklı agent (hamile/süt): {len(hafta_sonu_yasak)}  |  "
      f"yasaklanan (agent,gün,vardiya): {n}")


# %% [HÜCRE 15] — 11 SAAT DİNLENME (vardiyalar arası) ─────────────────
# Ardışık iki gün arasında ≥11 saat dinlenme:
#   önceki bitiş + 11 saat ≤ sonraki başlangıç.
# Gece yarısını aşan vardiya (bitiş ≤ başlangıç) ertesi güne sarkar (+1 gün).
DINLENME = 11 * 60                                  # 660 dk


def bitis_abs(bas, bit):
    """gün başından itibaren mutlak bitiş dakikası (aşıyorsa +1 gün)."""
    b0, b1 = dakika(bas), dakika(bit)
    return b1 if b1 > b0 else b1 + 1440


# ardışık (peş peşe takvim) gün çiftleri
gunler_d = [dt.date.fromisoformat(ds) for ds in PLAN_GUNLER]
ardisik = []
for i in range(len(gunler_d) - 1):
    if (gunler_d[i + 1] - gunler_d[i]).days == 1:
        ardisik.append((gunler_d[i].isoformat(), gunler_d[i + 1].isoformat()))

n = 0
for a in AGENTS:
    for ds1, ds2 in ardisik:
        for v1 in gun_vardiyalari[ds1]:
            if (a, ds1, v1) not in x:
                continue
            bas1, bit1 = saat[(ds1, v1)]
            b1_abs = bitis_abs(bas1, bit1)          # gün1 başına göre bitiş
            for v2 in gun_vardiyalari[ds2]:
                if (a, ds2, v2) not in x:
                    continue
                bas2, _ = saat[(ds2, v2)]
                b2_abs = dakika(bas2) + 1440        # gün2 başlangıcı (gün1 + 1440)
                if b2_abs - b1_abs < DINLENME:      # dinlenme < 11s → ikisi birden olamaz
                    model.Add(x[(a, ds1, v1)] + x[(a, ds2, v2)] <= 1)
                    n += 1

print(f"11 saat dinlenme kısıtı: {n} (yasaklanan ardışık vardiya çifti)")


# %% [HÜCRE 16] — MESAİYE KALAMAZ: RESMİ TATİL YASAĞI ────────────────
# mesaiye_kalamaz_flg=1 → (a) resmi tatilde çalışamaz,
#                          (b) toplam çalışma günü ≤ ayın iş günü sayısı.
# Hafta sonu yasak DEĞİL: hafta içi izin alıp hafta sonu çalışsa bile tavanı
# (örn. 22) aşmadığı sürece mesai sayılmaz.
TATIL = set(dt.date.fromisoformat(d) for d in RESMI_TATILLER)

# ayın iş günü sayısı = hafta içi günler − resmi tatiller
AYLIK_IS_GUNU = 0
for d in GUN_SET:
    if d.weekday() < 5 and d not in TATIL:
        AYLIK_IS_GUNU += 1

mesai_yok = set()
for _, row in df_tam.iterrows():
    if pd.to_numeric(row.get("mesaiye_kalamaz_flg", 0), errors="coerce") == 1:
        mesai_yok.add(str(row["agent_user_code"]).strip())

# (a) resmi tatilde çalışamaz
yasak = 0
for a in mesai_yok:
    for ds in PLAN_GUNLER:
        if dt.date.fromisoformat(ds) in TATIL:
            for v in gun_vardiyalari[ds]:
                if (a, ds, v) in x:
                    model.Add(x[(a, ds, v)] == 0)
                    yasak += 1

# (b) gün tavanı → yeni H17'de (tüm agentlar için min/max birlikte)
print(f"ayın iş günü: {AYLIK_IS_GUNU}  |  mesaiye kalamaz agent: {len(mesai_yok)}  |  "
      f"tatil yasağı (agent,gün,vardiya): {yasak}  (gün tavanı → H17)")


# %% [HÜCRE 17] — ÇALIŞMA GÜN ARALIĞI (kota ≤ çalışma ≤ kota+mesai) ───
# Her agent kotası = AYLIK_IS_GUNU − hafta içi izin (SERT, doldurmak zorunda).
#   normal           → kota ≤ çalışma ≤ kota+2   (≤2 mesai)
#   hamile/süt/mesai → çalışma = kota            (mesai yok)
# Örn: 3 gün hafta içi izin → kota=19 → normal 19..21, özel flag tam 19.
ozel_agents = hafta_sonu_yasak | mesai_yok       # hamile/süt + mesaiye_kalamaz

for a in AGENTS:
    tum = []
    for ds in PLAN_GUNLER:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) in x:
                tum.append(x[(a, ds, v)])
    if not tum:
        continue
    calisma = sum(tum)
    hi_izin = sum(1 for d in izin_map.get(a, set())
                  if d in GUN_SET and d.weekday() < 5)   # hafta içi izin günü
    kota = max(0, AYLIK_IS_GUNU - hi_izin)
    if kota == 0:
        continue
    ust = kota if a in ozel_agents else kota + 2          # tavan
    model.Add(calisma >= kota)                            # SERT taban: kotayı doldur
    model.Add(calisma <= ust)                             # SERT tavan

print(f"çalışma aralığı: {len(AGENTS)} agent  (kota=22−haftaiçi_izin; "
      f"normal kota..kota+2, özel flag={len(ozel_agents)} =kota)")


# %% [HÜCRE 18] — AYDA ≥1 ÇİFT HAFTA SONU OFF (sert) ──────────────────
# Her agent ay boyunca en az bir Cmt+Pzr çiftini BİRLİKTE off geçirmeli.
gset = set(PLAN_GUNLER)
hs_ciftleri = []                                 # ardışık (Cmt, Pzr) çiftleri
for ds in PLAN_GUNLER:
    d = dt.date.fromisoformat(ds)
    if d.weekday() == 5:                          # Cumartesi
        pzr = (d + dt.timedelta(days=1)).isoformat()
        if pzr in gset:
            hs_ciftleri.append((ds, pzr))

n = 0
for a in AGENTS:
    cift_off = []
    for cmt, pzr in hs_ciftleri:
        gun_var = [x[(a, cmt, v)] for v in gun_vardiyalari[cmt] if (a, cmt, v) in x]
        gun_var += [x[(a, pzr, v)] for v in gun_vardiyalari[pzr] if (a, pzr, v) in x]
        co = model.NewBoolVar(f"ciftoff_{a}_{cmt}")
        for xv in gun_var:
            model.Add(co + xv <= 1)              # o hafta sonu çalışıyorsa co=0
        cift_off.append(co)
    if cift_off:
        model.Add(sum(cift_off) >= 1)            # en az bir tam hafta sonu off
        n += 1

print(f"çift hafta sonu off: {n} agent (≥1 tam Cmt+Pzr off), {len(hs_ciftleri)} hafta sonu")


# %% [HÜCRE 19] — TAKIM BİRLİKTELİĞİ (yumuşak: aynı vardiya, sadece hafta içi) ─
# Ceza(takım, gün) = (o gün kullanılan vardiya sayısı) − (takım o gün çalışıyor mu)
#   = FAZLADAN bölünme. Tek vardiya → 0, iki → 1, üç → 2 ... (baz ceza yok)
# Ağırlık W_TAKIM yüksek → takımlar mümkün olduğunca bütün kalır.
# Yalnız HAFTA İÇİ uygulanır (Cmt/Pzr'de takım bütünlüğü aranmaz).
# (Hamile/süt üyesi o vardiyaya giremiyorsa mecbur bölünür → ceza yenir, sert
#  kısıt ihlal edilmez.)

# takım → üye agent kodları
takimlar = {}
for _, row in df_tam.iterrows():
    takimlar.setdefault(row["takim"], []).append(str(row["agent_user_code"]).strip())

n = 0
for T, uyeler in takimlar.items():
    for ds in PLAN_GUNLER:
        if dt.date.fromisoformat(ds).weekday() >= 5:   # hafta sonu → takım bütünlüğü kısıtı YOK
            continue
        # o gün vardiya başına üye değişkenleri
        vardiya_uye = {}
        for v in gun_vardiyalari[ds]:
            uv = [x[(a, ds, v)] for a in uyeler if (a, ds, v) in x]
            if uv:
                vardiya_uye[v] = uv
        if not vardiya_uye:
            continue
        # takım o gün çalışıyor mu (herhangi üye, herhangi vardiya)
        tum_uye = [xv for uv in vardiya_uye.values() for xv in uv]
        tw = model.NewBoolVar(f"tw_{T}_{ds}")
        model.Add(tw <= sum(tum_uye))            # kimse çalışmıyorsa tw=0; çalışınca minimize tw=1 yapar
        # her vardiya için kullanım göstergesi
        tu_list = []
        for v, uv in vardiya_uye.items():
            tu = model.NewBoolVar(f"tu_{T}_{ds}_{v}")
            for xv in uv:
                model.Add(tu >= xv)
            tu_list.append(tu)
        # ceza = kullanılan vardiya sayısı − çalışıyor mu  (≥0, sadece fazla bölünme)
        amac.append(W_TAKIM * (sum(tu_list) - tw))
        n += 1

print(f"takım birlikteliği: {len(takimlar)} takım, {n} (takım,gün) bölünme cezası "
      f"(ağırlık {W_TAKIM}, sadece hafta içi)")


# %% [HÜCRE 20] — HAFTADA AYNI VARDİYA (agent hafta boyu tek tip) ──────
# Bir agent bir ISO-hafta içinde çalıştığı günlerde HEP aynı vardiyada olmalı
# (Pzt 09:00 ise Salı 15:00 olamaz). Vardiya tipi = başlangıç saati.
# Her (agent, hafta) için kullanılan başlangıç-saati tipi ≤ 1.

# ISO-haftalar (H12 peş-peşe moddaysa burada da kurulur → bağımsız çalışır)
haftalar = {}
for ds in PLAN_GUNLER:
    yil, hafta, _ = dt.date.fromisoformat(ds).isocalendar()
    haftalar.setdefault((yil, hafta), []).append(ds)

n = 0
for a in AGENTS:
    for wi, hafta_gunleri in enumerate(haftalar.values()):
        tip_varlar = {}                       # baslangic_saati -> [x değişkenleri]
        for ds in hafta_gunleri:
            for v in gun_vardiyalari[ds]:
                if (a, ds, v) in x:
                    bas = saat[(ds, v)][0]    # başlangıç saati = vardiya tipi
                    tip_varlar.setdefault(bas, []).append(x[(a, ds, v)])
        if len(tip_varlar) <= 1:
            continue                          # zaten tek tip → kısıt gerekmez
        tip_kullan = []
        for bas, varlar in tip_varlar.items():
            tk = model.NewBoolVar(f"tip_{a}_w{wi}_{bas}".replace(":", ""))
            for xv in varlar:
                model.Add(tk >= xv)           # bu tipte çalışırsa gösterge 1
            tip_kullan.append(tk)
        model.Add(sum(tip_kullan) <= 1)       # haftada en fazla 1 vardiya tipi
        n += 1

print(f"haftada aynı vardiya kısıtı: {n} (agent × hafta)")


# %% [HÜCRE 21] — ÇÖZ + DOĞRULA ─────────────────────────────────────────
model.Minimize(sum(amac))                          # amaç: toplam cezayı (sapma + takım) küçült
solver = cp_model.CpSolver()
solver.parameters.num_search_workers = 16          # paralel çekirdek (CPU'ya göre artır)
solver.parameters.max_time_in_seconds = 300        # süre sınırı → en iyi BULUNAN'ı al (optimal şart değil)
solver.parameters.log_search_progress = True       # ilerlemeyi terminale bas (feasible bulundu mu görürsün)
status = solver.Solve(model)
print(f"durum: {solver.StatusName(status)}  (süre: {solver.WallTime():.2f} sn)")

if status not in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    raise SystemExit("çözüm yok (INFEASIBLE) — bir günde talep, müsait agent sayısını "
                     "aşıyor olabilir.")
print(f"amaç (toplam ceza): {solver.ObjectiveValue():.0f}")

# coverage: band içinde plana ne kadar yakın? (toplam sapma)
sapan, toplam_sapma = 0, 0
for (ds, v), kisi in talep.items():
    atanan = 0
    for a in AGENTS:
        if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
            atanan += 1
    fark = abs(atanan - kisi)
    if fark:
        sapan += 1
        toplam_sapma += fark
print(f"coverage: {sapan} çift talepten sapıyor (toplam sapma {toplam_sapma}, band ±{TOL_COVERAGE})")

# dağılım sağlaması: kişi başı çalışma günü (ilk 10 agent)
print("kişi başı çalışma günü (ilk 10):")
for a in AGENTS[:10]:
    calisma = 0
    for ds in PLAN_GUNLER:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
                calisma += 1
    print(f"  {a}: {calisma} gün")


# %% [HÜCRE 22] — SONUÇ / ROSTER ────────────────────────────────────────
# Çözümdeki 1 olan değişkenleri okunabilir tabloya çevir.
# solver.Value(x[...]) → 0/1; 1 olanlar atamadır.
sonuc = []
for a in AGENTS:
    for ds in PLAN_GUNLER:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
                bas, bit = saat[(ds, v)]               # H8'deki saat sözlüğünden
                sonuc.append({"agent": a, "tarih": ds, "vardiya": v,
                              "saat": f"{bas}-{bit}"})

df_sonuc = pd.DataFrame(sonuc)                      # tidy: agent × tarih × vardiya × saat
print(f"toplam atama: {len(df_sonuc)}")
print(df_sonuc.head(20).to_string(index=False))

# agent → takım eşlemesi (roster'da takımı göstermek için)
agent_takim = dict(zip(df_tam["agent_user_code"].astype(str).str.strip(),
                       df_tam["takim"]))

# roster matrisi: TÜM agentlar × gün; hücre = izin / saat / off
# index = (takım, agent) → aynı takım üyeleri yan yana
hucreler = []
for a in AGENTS:
    izinli = izin_map.get(a, set())
    tk = agent_takim.get(a, "")
    for ds in PLAN_GUNLER:
        if dt.date.fromisoformat(ds) in izinli:
            deger = "izin"
        else:
            deger = "off"
            for v in gun_vardiyalari[ds]:
                if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
                    bas, bit = saat[(ds, v)]
                    deger = f"{bas}-{bit}"
                    break
        hucreler.append({"takim": tk, "agent": a, "tarih": ds, "deger": deger})

roster = pd.DataFrame(hucreler).pivot(index="agent", columns="tarih", values="deger")
roster.insert(0, "takim", roster.index.map(lambda a: agent_takim.get(a, "")))  # takım = kolon
roster = roster.sort_values("takim")                                           # takıma göre grupla
print(f"\nroster: {roster.shape[0]} agent × {roster.shape[1]-1} gün (izin/saat/off)")
print(roster.head(15))


# %% [HÜCRE 23] — AGENT ÖZET (çalışma / off / izin gün sayısı) ──────────
# roster hücreleri "izin" / "off" / saat → her agent için say.
gun_kolon = [c for c in roster.columns if c != "takim"]
df_ozet = pd.DataFrame({
    "takim":   roster["takim"],
    "calisma": (~roster[gun_kolon].isin(["off", "izin"])).sum(axis=1),  # saat = çalışma
    "off":     (roster[gun_kolon] == "off").sum(axis=1),
    "izin":    (roster[gun_kolon] == "izin").sum(axis=1),
})
df_ozet["toplam"] = df_ozet[["calisma", "off", "izin"]].sum(axis=1)     # = gün sayısı (sağlama)
print(f"agent özet: {len(df_ozet)} agent (toplam {len(gun_kolon)} gün/agent olmalı)")
print(df_ozet.head(15))


# %% [HÜCRE 24] — TAKIM BAZLI DAĞILIM (günlük takım → vardiya) ─────────
# Bir takım o gün hangi vardiya(lar)da, kaç kişi. Bölünme buradan görünür.
df_sonuc["takim"] = df_sonuc["agent"].map(agent_takim)

# takım × gün × saat → kaç kişi (sadece çalışanlar)
df_takim = (df_sonuc.groupby(["takim", "tarih", "saat"]).size()
            .reset_index(name="kisi"))

# takım roster: satır=takım, sütun=gün, hücre = "saat×kişi" (bölünmüşse '|' ile ayrık)
df_takim["hucre"] = df_takim["saat"] + "×" + df_takim["kisi"].astype(str)
takim_roster = (df_takim.groupby(["takim", "tarih"])["hucre"]
                .apply(lambda s: " | ".join(s))
                .unstack("tarih"))
print(f"takım dağılımı: {df_takim['takim'].nunique()} takım")
print(takim_roster.head(15))

# bölünme özeti: kaç (takım,gün) birden çok vardiyaya bölünmüş
bolunme = df_takim.groupby(["takim", "tarih"]).size()
print(f"\n(takım,gün) toplam: {len(bolunme)}  |  bölünmüş (>1 vardiya): {int((bolunme > 1).sum())}")
print("en çok bölünen 10 (takım,gün):")
print(bolunme[bolunme > 1].sort_values(ascending=False).head(10))


# %% [HÜCRE 25] — COVERAGE RAPORU (talep / atanan / fazla / eksik) ─────
# Sert band kaldırıldığı için her kova talebi aşabilir/eksik kalabilir.
# Burada her (gün,vardiya) için talep vs atanan ve sapma görülür.
satir = []
for (ds, v), kisi in talep.items():
    atanan = 0
    for a in AGENTS:
        if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
            atanan += 1
    bas, bit = saat[(ds, v)]
    satir.append({"tarih": ds, "vardiya": v, "saat": f"{bas}-{bit}",
                  "talep": kisi, "atanan": atanan, "fark": atanan - kisi})

df_cov = pd.DataFrame(satir)                    # tüm kovaların talep/atanan/fark detayı
toplam_fazla = int(df_cov.loc[df_cov["fark"] > 0, "fark"].sum())
toplam_eksik = int(-df_cov.loc[df_cov["fark"] < 0, "fark"].sum())
tam = int((df_cov["fark"] == 0).sum())
print(f"coverage raporu: {len(df_cov)} kova  |  tam tutan: {tam}  |  "
      f"toplam FAZLA: +{toplam_fazla}  |  toplam EKSİK: -{toplam_eksik}")
print("en çok sapan 12 kova:")
print(df_cov.reindex(df_cov["fark"].abs().sort_values(ascending=False).index)
      .head(12).to_string(index=False))
