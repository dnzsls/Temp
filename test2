# %% [HÜCRE 5] — PT + EĞİTİM EKİPLERİNİ ELE ────────────────────────────
# kismi_calisan_flg=1 → PT.  teamleader_name "eğitim" → eğitim ekibi.
# İkisini de ana kitleden çıkar (modele hiç girmesinler).
pt_mask = pd.to_numeric(df_kuyruk["kismi_calisan_flg"],
                        errors="coerce").fillna(0).astype(int) == 1
egitim_mask = (df_kuyruk["teamleader_name"].astype(str).str.lower()
               .str.contains("eğit|egit", na=False))    # "eğitim"/"egitim" (büyük/küçük farketmez)
df_tam = df_kuyruk[~pt_mask & ~egitim_mask].copy()

print(f"PT elendi: {int(pt_mask.sum())}  |  eğitim elendi: {int(egitim_mask.sum())}  "
      f"→  kalan tam zamanlı: {len(df_tam)} / {len(df_kuyruk)}")
print(df_tam[["agent_user_code", "agent_name", "teamleader_name"]].head())
