#  (2) her agent × hafta: hafta sonu çalışmasının KAÇI norm, kaçı mesai — GÜN bazında.
#      Sayı H22'nin _hafta_norm'undan okunur (formül burada TEKRARLANMAZ) → renkler
#      norm_gun / mesai_gun kolonlarıyla her zaman birebir tutar; sınır haftası
#      taşıması (önceki ay çalışması) da otomatik yansır.
#      Sıra: çalışılan hafta sonu günlerinin İLK `norm` tanesi NORM (yeşil), kalanı MESAİ (sarı).
_norm_hucre = set()                                  # (agent, gün kolonu) → NORM sayılan hafta sonu günü
for _a in roster_2.index:
    for _wk, _h in _hafta.items():                   # _hafta: H22'de kurulan (wd/we/tat/wtatil) kırılımı
        _we_calisan = [c for c in sorted(_h["we"]) if roster.at[_a, c] not in _OFF_LIKE]
        for c in _we_calisan[:_hafta_norm.get((_a, _wk), 0)]:
            _norm_hucre.add((_a, c))
_agents_sirali = list(roster_2.index)

with pd.ExcelWriter(XLSX_PATH, engine="openpyxl") as _xl:
    roster_xl.to_excel(_xl, sheet_name="roster")                      # agent = index, gün-adlı başlık
    df_plan_gercek.to_excel(_xl, sheet_name="plan_vs_gerceklesen", index=False)
    df_gun_ozet.to_excel(_xl, sheet_name="gun_ozet", index=False)

    # başlık satırı (1. satır) tüm sheet'lerde BOLD
    for _ws in _xl.book.worksheets:
        for _cell in _ws[1]:
            _cell.font = _BOLD

    # roster sheet renklendirme:
    #   off=kırmızı | resmi tatil çalışması=turuncu | hafta sonu MESAİ=sarı | hafta sonu NORM=yeşil
    _ws = _xl.sheets["roster"]
    for _row in _ws.iter_rows(min_row=2):
