# -*- coding: utf-8 -*-
"""
AGENT DETAYLI MODEL — tek dosya akışı (hücre hücre, detaylı print)
==================================================================
2. aşama: aylık modelin kova-sayılarına İSİMLİ inhouse agent oturtma.

Çözüm birimi = TÜM AY, hafta içi + hafta sonu BİRLİKTE (spec 6.1).

Bu dosya `# %% [HÜCRE n]` bloklarıyla bölünmüştür; her hücre kendi
kontrol/print'ini basar. Spyder/VSCode'da hücre hücre, ya da düz
`python3 agent_detayli_model.py` ile baştan sona çalışır.

KAPSAM (şu an):
  AKTİF : coverage (sert), günde ≤1 vardiya, müsaitlik bloğu
          (özel-off + tam-ay bayrakları + tekrarlı Pzt/Cuma).
  OKUNUR ama henüz UYGULANMAZ : takim, sabah_calisir (≤20:00), sut/hamile
          (saat/hafta sonu/tatil), mesaiye_kalamaz (mesai+gün tavanı),
          off-kotası (haftada max 6), aylık sayaçlar, adalet.
          → kendi adımlarında roster üstünde görüp ekleyeceğiz.

GİRDİLER (hepsi GERÇEK — dummy yok):
  1) PKL_PATH   : aylık modelin results[date][queue] çıktısı (planlama, pkl dosyası).
  2) df_agents  : agent master (SQL'den DataFrame). Beklenen kolonlar:
       agent_user_code        agent kimliği (U111111)
       agent_name
       teamleader_name        takım parçası
       groupname              takım parçası (+lokasyon)
       working_main_group     lokasyon+kuyruk (okunur)
       line_based_main_group  KUYRUK: kitle_cagrilar | kurumsal_cagrilar | gold_cagrilar
       idari_izinli_flg       1 → tüm ay müsait değil
       pazartesi_izinli_flg   1 → her Pazartesi off
       cuma_izinli_flg        1 → her Cuma off
       sabah_calisir_flg      1 → yalnız bitişi ≤20:00 vardiya (sonraki adım)
       mesaiye_kalamaz_flg    1 → mesai yok + gün tavanı (sonraki adım)
       dogum_izni_flg         1 → tüm ay müsait değil
       hamile_flg             1 → hafta sonu/tatil yok (sonraki adım)
       sut_izni_flg           1 → ≤20:00 + 2sa eksik + mesai yok (sonraki adım)
       kismi_calisan_flg      1 → PART-TIME, ÇIKARILIR (haftaiçi planlamada yok)
  3) df_off     : özel off tablosu (SQL'den DataFrame). Kolonlar:
       agent_user_code, agent_name, teamleader_name,
       off_talebi, off_talebi_desc,
       gun_1 .. gun_30/31   1 → o tarih izinli (gun_N = çalışılan ayın N'inci günü)
"""

import pickle
import datetime as dt
import pandas as pd
from ortools.sat.python import cp_model

# DataFrame'leri tek geniş blok halinde (alt satıra kaymadan) yazdır
pd.set_option("display.max_columns", None)
pd.set_option("display.width", None)
pd.set_option("display.expand_frame_repr", False)


# %% [HÜCRE 0] — KONFİG ─────────────────────────────────────────────────
QUEUE       = "kitle"          # kitle | kurumsal | gold
PKL_PATH    = ""               # aylık model çıktısı pkl yolu
# NOT: agent master ve özel off SQL'den gelir → bu dosyadan ÖNCE notebook'ta
#      df_agents ve df_off DataFrame'leri tanımlı olmalı.

DAY_TR = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Pzr"]


# %% [HÜCRE 1] — PICKLE YÜKLE (planlama) ────────────────────────────────
try:
    with open(PKL_PATH, "rb") as f:
        results = pickle.load(f)
except Exception:
    raise SystemExit("[H1] pickle yüklenemedi — PKL_PATH yanlış ya da dosya yok.")

print(f"pickle yüklendi: {len(results)} gün")

# 'planı olan gün' = o kuyrukta sonuç üretilmiş (feasible) gün; None/eksik olanlar hariç
plani_olan = sorted(ds for ds, r in results.items() if r and QUEUE in r and r[QUEUE])
print(f"'{QUEUE}' planı olan gün: {len(plani_olan)}/{len(results)}")

# içerik önizlemesi (df.head gibi) — bir günün yapısı
if plani_olan:
    ds0 = plani_olan[0]
    mi0 = results[ds0][QUEUE]["mip_info"]
    print(f"örnek gün {ds0}: mip_info anahtarları = {list(mi0.keys())}")
    print(f"     assignments (ilk 5): {dict(list(mi0.get('assignments', {}).items())[:5])}")
    sc0 = mi0.get("shift_coverage", {})
    if sc0:
        k0 = next(iter(sc0))
        print(f"     shift_coverage örnek: {k0} → {sc0[k0]}")


# %% [HÜCRE 2] — PLANLAMAYI TEMİZ TALEP TABLOSUNA ÇEVİR ────────────────
# Pickle'daki iç içe sözlüğü tidy DataFrame'e çevir: her satır = gün × inhouse
# vardiya. Outsource / part_time atılır (modelin işi değil).
satirlar = []
for ds in sorted(results.keys()):
    r = results.get(ds)
    if not r or QUEUE not in r or not r[QUEUE]:
        continue
    mi = r[QUEUE]["mip_info"]
    sc = mi.get("shift_coverage", {})
    for shift, kisi in mi.get("assignments", {}).items():
        info = sc.get(shift, {})
        if kisi <= 0 or info.get("company") != "inhouse":
            continue
        d = dt.date.fromisoformat(ds)
        satirlar.append({
            "tarih":      ds,
            "gun":        DAY_TR[d.weekday()],
            "hafta_sonu": int(d.weekday() > 4),
            "vardiya":    shift,
            "baslangic":  info.get("start"),
            "bitis":      info.get("end"),
            "talep":      int(kisi),
        })

df_talep = pd.DataFrame(satirlar)
print(f"talep tablosu: {len(df_talep)} satır (gün × inhouse vardiya)")
print(df_talep.head(8).to_string(index=False))

# Ay bilgisi (H3'te izin/gün eşlemesi için)
GUNLER  = sorted(results.keys())
AY_YIL  = dt.date.fromisoformat(GUNLER[0]).year
AY_AY   = dt.date.fromisoformat(GUNLER[0]).month
GUN_SET = {dt.date.fromisoformat(ds) for ds in GUNLER}
print(f"ay: {AY_YIL}-{AY_AY:02d}  ({len(GUNLER)} gün)")


# %% [HÜCRE 3] — AGENT VERİLERİNİ TEMİZLE (df_agents + df_off) ──────────
# SQL'den gelen iki DataFrame'i al, temel temizlik yap, içeriğine bak.
# (Kuyruk süzme, PT eleme, izin birleştirme SONRAKİ adımlarda.)

df_agents = globals().get("df_agents", globals().get("df_agent"))
if df_agents is None:
    raise SystemExit("[H3] df_agents tanımlı değil — SQL'den df_agents çek.")

df_agents = df_agents.copy()
df_agents.columns = [str(c).strip().lower() for c in df_agents.columns]   # kolon adı sadeleştir
df_agents = df_agents.fillna("")                                          # boşları '' yap

print(f"df_agents: {df_agents.shape[0]} satır × {df_agents.shape[1]} kolon")
print(f"kolonlar: {list(df_agents.columns)}")
print(df_agents.head())

df_off = globals().get("df_off")
if df_off is not None:
    df_off = df_off.copy()
    df_off.columns = [str(c).strip().lower() for c in df_off.columns]
    # gün kolonları float (1.0/0.0) geliyor → int (0/1)
    gun_cols = [c for c in df_off.columns if c.startswith("gun_")]
    df_off[gun_cols] = (df_off[gun_cols].apply(pd.to_numeric, errors="coerce")
                        .fillna(0).astype(int))
    df_off = df_off.fillna("")
    print(f"\ndf_off: {df_off.shape[0]} satır × {df_off.shape[1]} kolon "
          f"({len(gun_cols)} gün kolonu int'e çevrildi)")
    print(f"kolonlar: {list(df_off.columns)}")
    print(df_off.head())
else:
    print("df_off yok")


# %% [HÜCRE 4] — KUYRUĞA SÜZ ────────────────────────────────────────────
# line_based_main_group == "kitle_cagrilar" olanları tut.
hedef = f"{QUEUE}_cagrilar"                        # "kitle" → "kitle_cagrilar"
df_kuyruk = df_agents[df_agents["line_based_main_group"].str.strip() == hedef].copy()
df_kuyruk["kuyruk"] = QUEUE                        # temiz kuyruk kolonu

print(f"'{QUEUE}' agent: {len(df_kuyruk)} / {len(df_agents)} (diğer kuyruklar elendi)")
print(df_kuyruk[["agent_user_code", "agent_name",
                 "line_based_main_group", "kuyruk"]].head())


# %% [HÜCRE 5] — PART-TIME ELE (kismi_calisan_flg=1 çıkar) ──────────────
# Bayrak float (1.0/0.0) gelebilir → to_numeric ile sağlamca oku.
pt_mask = pd.to_numeric(df_kuyruk["kismi_calisan_flg"],
                        errors="coerce").fillna(0).astype(int) == 1
df_tam = df_kuyruk[~pt_mask].copy()

print(f"PT elendi: {int(pt_mask.sum())}  →  kalan tam zamanlı: "
      f"{len(df_tam)} / {len(df_kuyruk)}")
print(df_tam[["agent_user_code", "agent_name", "kismi_calisan_flg"]].head())


# %% [HÜCRE 6] — TAKIM KOLONU (working_main_group + teamleader_name) ────
df_tam["takim"] = (df_tam["working_main_group"].str.strip() + " | "
                   + df_tam["teamleader_name"].str.strip())
print(f"takım sayısı: {df_tam['takim'].nunique()}")
print("takım → kişi sayısı:")
print(df_tam["takim"].value_counts())


# %% [HÜCRE 7] — İZİN GÜNLERİNİ BİRLEŞTİR ───────────────────────────────
# Her agent için tek izin kümesi: özel-off + tekrarlı(Pzt/Cuma) + tam-ay(idari/doğum)

# 1) özel-off tablosu → off_map[code] = {tarih}
# NOT: bir agent df_off'ta birden fazla satırda olabilir → günleri BİRLEŞTİR (union).
off_map = {}
if df_off is not None:
    for _, row in df_off.iterrows():
        code = str(row["agent_user_code"]).strip()
        for c in gun_cols:                              # gun_cols H3'te tanımlandı
            if int(row[c]) == 1:
                try:
                    off_map.setdefault(code, set()).add(
                        dt.date(AY_YIL, AY_AY, int(c.split("_")[1])))
                except ValueError:
                    pass                                # ayda olmayan gün (gun_31 vs.)

# 2) tekrarlı izin günleri (ayın tüm Pzt / Cuma'ları)
mondays = {d for d in GUN_SET if d.weekday() == 0}
fridays = {d for d in GUN_SET if d.weekday() == 4}


def _b(row, col):
    """flag (float/str) → bool"""
    return pd.to_numeric(row.get(col, 0), errors="coerce") == 1


# 3) agent başına birleştir → izin_map
izin_map = {}
for _, row in df_tam.iterrows():
    code = str(row["agent_user_code"]).strip()
    izin = set(off_map.get(code, set()))
    if _b(row, "idari_izinli_flg") or _b(row, "dogum_izni_flg"):
        izin |= GUN_SET                                # tüm ay
    if _b(row, "pazartesi_izinli_flg"):
        izin |= mondays
    if _b(row, "cuma_izinli_flg"):
        izin |= fridays
    izin_map[code] = izin

df_tam["izin_gun_sayisi"] = df_tam["agent_user_code"].map(
    lambda c: len(izin_map.get(str(c).strip(), set())))

tam_ay = sum(1 for v in izin_map.values() if v >= GUN_SET)
print(f"özel-off tablosundan izinli agent: {len(off_map)}")
print(f"tüm-ay izinli (idari/doğum): {tam_ay}")
print("en çok izinli 10 agent:")
print(df_tam[["agent_user_code", "izin_gun_sayisi"]]
      .sort_values("izin_gun_sayisi", ascending=False).head(10).to_string(index=False))


# %% [HÜCRE 8] — MODEL GİRDİLERİNİ HAZIRLA ─────────────────────────────
# df'leri CP-SAT'ın anlayacağı sade yapılara çevir (henüz model/kısıt yok).
AGENTS = [str(c).strip() for c in df_tam["agent_user_code"]]

# gün → o gün talebi olan vardiyalar  +  (gün, vardiya) → kaç kişi
# saat[(gün, vardiya)] = (baslangic, bitis)  → saat-bazlı kısıtlar için (sonra)
gun_vardiyalari = {}
talep = {}
saat = {}
for _, row in df_talep.iterrows():
    ds, v, kisi = row["tarih"], row["vardiya"], int(row["talep"])
    gun_vardiyalari.setdefault(ds, []).append(v)
    talep[(ds, v)] = kisi
    saat[(ds, v)] = (row["baslangic"], row["bitis"])

PLAN_GUNLER = sorted(gun_vardiyalari)              # talebi olan günler

print(f"agent (tam zamanlı, {QUEUE}): {len(AGENTS)}")
print(f"planlanacak gün: {len(PLAN_GUNLER)}  ({PLAN_GUNLER[0]} .. {PLAN_GUNLER[-1]})")
print(f"(gün × vardiya) çift: {len(talep)}  | toplam kişi-slot: {sum(talep.values())}")


# %% [HÜCRE 9] — CP-SAT MODEL + KARAR DEĞİŞKENLERİ ─────────────────────
# x[(agent, gün, vardiya)] = 1 → o agent o gün o vardiyada çalışıyor.
# İzinli gün için değişken AÇILMAZ (o gün atanamaz). Henüz kısıt yok.
model = cp_model.CpModel()

x = {}
for a in AGENTS:
    izinli = izin_map.get(a, set())
    for ds in PLAN_GUNLER:
        if dt.date.fromisoformat(ds) in izinli:
            continue
        for v in gun_vardiyalari[ds]:
            x[(a, ds, v)] = model.NewBoolVar(f"x_{a}_{ds}_{v}")

ust_sinir = len(AGENTS) * len(talep)
print(f"karar değişkeni: {len(x)}  (izinsiz üst sınır {ust_sinir}; "
      f"izin günleri düşüldü → {ust_sinir - len(x)} adet açılmadı)")


# %% [HÜCRE 10] — COVERAGE KISITI ───────────────────────────────────────
# Her (gün, vardiya) çiftinde atanan kişi = talep (sert kısıt).
# cov[(gün, vardiya)] = kısıt sapı (x gibi defter).
cov = {}
for (ds, v), kisi in talep.items():
    katilan = []                              # bu çiftte değişkeni olan agentlar
    for a in AGENTS:
        if (a, ds, v) in x:
            katilan.append(x[(a, ds, v)])
    cov[(ds, v)] = model.Add(sum(katilan) == kisi)

print(f"coverage kısıtı: {len(cov)} çift")
ornek = next(iter(cov))
print(f"örnek {ornek}:\n{cov[ornek].proto}")


# %% [HÜCRE 11] — GÜNDE ≤1 VARDİYA ──────────────────────────────────────
# Bir agent bir günde en fazla 1 vardiyada çalışır (0 = o gün off).
n = 0
for a in AGENTS:
    for ds in PLAN_GUNLER:
        gunun = []                            # bu agentın o günkü vardiya değişkenleri
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) in x:
                gunun.append(x[(a, ds, v)])
        if gunun:
            model.Add(sum(gunun) <= 1)
            n += 1

print(f"günde ≤1 vardiya kısıtı: {n} (agent × gün)")


# %% [HÜCRE 12] — HAFTADA ≥1 OFF (7 gün üst üste çalışamaz) ─────────────
# Her agent, her ISO-hafta içinde en fazla 6 gün çalışır (≥1 off).
# Günde ≤1 olduğundan, o haftadaki değişkenlerin toplamı = çalışılan gün sayısı.

# PLAN_GUNLER'i ISO-haftalara grupla
haftalar = {}
for ds in PLAN_GUNLER:
    yil, hafta, _ = dt.date.fromisoformat(ds).isocalendar()
    haftalar.setdefault((yil, hafta), []).append(ds)

n = 0
for a in AGENTS:
    for hafta_gunleri in haftalar.values():
        haftalik = []                          # bu agentın o haftadaki tüm vardiya değişkenleri
        for ds in hafta_gunleri:
            for v in gun_vardiyalari[ds]:
                if (a, ds, v) in x:
                    haftalik.append(x[(a, ds, v)])
        if haftalik:
            model.Add(sum(haftalik) <= 6)
            n += 1

print(f"haftada ≥1 off kısıtı: {n} (agent × hafta)")

# ─── ALTERNATİF (AKTİF DEĞİL): peş peşe 7 gün çalışamaz ────────────────
# ISO-hafta yerine KAYAN 7 GÜNLÜK PENCERE → hafta sınırını aşan ardışıklığı
# da yakalar (spec 5.1-4). Kullanmak istersen yukarıdaki H12 bloğunu kapatıp
# bu bloğu aç:
#
# gunler_d = [dt.date.fromisoformat(ds) for ds in PLAN_GUNLER]
# n = 0
# for a in AGENTS:
#     for i in range(len(gunler_d) - 6):
#         pencere = gunler_d[i:i + 7]                 # 7 günlük dilim
#         if (pencere[-1] - pencere[0]).days != 6:    # gerçekten 7 ardışık gün mü?
#             continue                                # araya boş gün giriyorsa atla
#         pencere_varlar = []
#         for d in pencere:
#             ds = d.isoformat()
#             for v in gun_vardiyalari[ds]:
#                 if (a, ds, v) in x:
#                     pencere_varlar.append(x[(a, ds, v)])
#         if pencere_varlar:
#             model.Add(sum(pencere_varlar) <= 6)
#             n += 1
# print(f"peş peşe ≤6 gün kısıtı: {n}")


# %% [HÜCRE 13] — SABAH ÇALIŞANLAR (bitiş ≤ 20:00) ─────────────────────
# sabah_calisir_flg=1 → yalnız aynı gün biten ve bitişi ≤20:00 vardiyalar.
# Uygun olmayan (gün, vardiya) için o agentın değişkeni = 0.
def dakika(t):                                     # "09:00" → 540, "24:00" → 1440
    s, d = str(t).split(":")
    return int(s) * 60 + int(d)

LIMIT = dakika("20:00")                            # 1200

sabah_agents = set()
for _, row in df_tam.iterrows():
    if pd.to_numeric(row.get("sabah_calisir_flg", 0), errors="coerce") == 1:
        sabah_agents.add(str(row["agent_user_code"]).strip())

n = 0
for a in sabah_agents:
    for ds in PLAN_GUNLER:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) not in x:
                continue
            bas, bit = saat[(ds, v)]
            uygun = dakika(bas) < dakika(bit) and dakika(bit) <= LIMIT
            if not uygun:
                model.Add(x[(a, ds, v)] == 0)      # bu vardiyada çalışamaz
                n += 1

print(f"sabah çalışan agent: {len(sabah_agents)}  |  yasaklanan (agent,gün,vardiya): {n}")


# %% [HÜCRE 14] — ÇÖZ + DOĞRULA ─────────────────────────────────────────
solver = cp_model.CpSolver()
status = solver.Solve(model)
print(f"durum: {solver.StatusName(status)}  (süre: {solver.WallTime():.2f} sn)")

if status not in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    raise SystemExit("çözüm yok (INFEASIBLE) — bir günde talep, müsait agent sayısını "
                     "aşıyor olabilir.")

# coverage gerçekten tuttu mu? (sapan çift sayısı)
sapan = 0
for (ds, v), kisi in talep.items():
    atanan = 0
    for a in AGENTS:
        if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
            atanan += 1
    if atanan != kisi:
        sapan += 1
print("coverage: " + ("✓ tüm çiftler tutuyor" if sapan == 0 else f"⚠ {sapan} çift sapıyor"))

# dağılım sağlaması: kişi başı çalışma günü (ilk 10 agent)
print("kişi başı çalışma günü (ilk 10):")
for a in AGENTS[:10]:
    calisma = 0
    for ds in PLAN_GUNLER:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
                calisma += 1
    print(f"  {a}: {calisma} gün")


# %% [HÜCRE 15] — SONUÇ / ROSTER ────────────────────────────────────────
# Çözümdeki 1 olan değişkenleri okunabilir tabloya çevir.
# solver.Value(x[...]) → 0/1; 1 olanlar atamadır.
sonuc = []
for a in AGENTS:
    for ds in PLAN_GUNLER:
        for v in gun_vardiyalari[ds]:
            if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
                bas, bit = saat[(ds, v)]               # H8'deki saat sözlüğünden
                sonuc.append({"agent": a, "tarih": ds, "vardiya": v,
                              "saat": f"{bas}-{bit}"})

df_sonuc = pd.DataFrame(sonuc)                      # tidy: agent × tarih × vardiya × saat
print(f"toplam atama: {len(df_sonuc)}")
print(df_sonuc.head(20).to_string(index=False))

# roster matrisi: TÜM agentlar × gün; hücre = izin / saat / off
hucreler = []
for a in AGENTS:
    izinli = izin_map.get(a, set())
    for ds in PLAN_GUNLER:
        if dt.date.fromisoformat(ds) in izinli:
            deger = "izin"
        else:
            deger = "off"
            for v in gun_vardiyalari[ds]:
                if (a, ds, v) in x and solver.Value(x[(a, ds, v)]) == 1:
                    bas, bit = saat[(ds, v)]
                    deger = f"{bas}-{bit}"
                    break
        hucreler.append({"agent": a, "tarih": ds, "deger": deger})

roster = pd.DataFrame(hucreler).pivot(index="agent", columns="tarih", values="deger")
print(f"\nroster: {roster.shape[0]} agent × {roster.shape[1]} gün (izin/saat/off)")
print(roster.head(10))
