PKL_S4 = "…S4 Model-1 pickle yolu…"
PKL_S7 = "…S7 Model-1 pickle yolu…"

def m1_tablo(yol, queue=QUEUE):
    with open(yol, "rb") as f:
        res = pickle.load(f)
    res = {ds: r for ds, r in res.items()
           if dt.date.fromisoformat(ds).year == YEAR and dt.date.fromisoformat(ds).month == MONTH}
    saha = {}
    for ds, r in res.items():
        mi = ((r or {}).get(queue) or {}).get("mip_info", {}) or {}
        cov = mi.get("shift_coverage", {}) or {}
        ert = (dt.date.fromisoformat(ds) + dt.timedelta(days=1)).isoformat()
        for s, k in (mi.get("assignments") or {}).items():
            c = cov.get(s, {})
            if k <= 0:
                continue
            sk = c.get("company", "inhouse")
            for g, sl_list in ((ds, c.get("slots", [])), (ert, c.get("slots_d1", []))):
                for sl in sl_list:
                    saha.setdefault((g, sl), _BOS())[sk if sk in ("outsource", "part_time") else "inhouse"] += k
    sat = []
    for ds, r in res.items():
        rq = (r or {}).get(queue) or {}
        hr = (rq.get("_config") or {}).get("hourly_report") or {}
        tcs = rq.get("calls_by_slot") or {}
        te = (rq.get("mip_info", {}) or {}).get("erlang_by_slot_ham") or rq.get("erlang_by_slot") or {}
        d = dt.date.fromisoformat(ds)
        for s in SLOTS:
            x = saha.get((ds, s), _BOS())
            n = x["inhouse"] + x["outsource"] + x["part_time"]
            tc = float(tcs.get(s, 0) or 0)
            h = int(s[:2])
            pay = (_oran(hr.get("cagri_adedi"), h, 15) / 2
                   * (1 - _oran(hr.get("rapor_etkisi"), h, 0) - _oran(hr.get("kapasite_kaybi"), h, 0)))
            sat.append({"tarih": ds, "gun": GUN_TR[d.weekday()], "hs": int(d.weekday() >= 5),
                        "slot": s, "saat": s[:2], "n": n, "n_in": x["inhouse"],
                        "n_out": x["outsource"], "tc": tc, "te": float(te.get(s, 0) or 0),
                        "kap_ih": tc / pay if pay > 0 else 0,
                        "kap": kapasite(n, tc, 300, s, hr)[0]})
    t = pd.DataFrame(sat)
    t["erl_acik"] = (t["te"] - t["n"]).clip(lower=0)
    return t

def ozet_m1(t):
    g = t.assign(tip=t["hs"].map({0: "hafta içi", 1: "hafta sonu"})).groupby("tip")
    return pd.DataFrame({
        "kisi_saat": g["n"].sum() / 2,
        "Kap_RR_tahmin": g.apply(lambda d: np.minimum(d["kap"], d["tc"]).sum() / d["tc"].sum()),
        "erl_acik_kisi_slot": g["erl_acik"].sum(),
        "kap_alti_slot": g.apply(lambda d: int(((d["kap"] < d["tc"]) & (d["tc"] > 0)).sum()))}).round(4)

t4, t7 = m1_tablo(PKL_S4), m1_tablo(PKL_S7)
print("=== GENEL ===")
print(pd.concat({"S4": ozet_m1(t4), "S7": ozet_m1(t7)}, axis=1).to_string())

