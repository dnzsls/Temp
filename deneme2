        # PT hiç yok). Eskiden PT bir kez daha düşülüyordu → h.sonu satırlarında
        # 'In' ve 'Toplam' PT kadar EKSİK çıkıyordu.
        in_ft = mi.get('total_inhouse_kisi', 0)
