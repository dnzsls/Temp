    ], columns=['sayfa', 'kolon', 'ne_gosterir', 'nasil_hesaplanir'])

    with pd.ExcelWriter(output_path, engine='openpyxl') as xl:
        for ad, df in (('gun_ozet', df_gun), ('slot_detay', df_slot),
                       ('hafta_ozet', df_hafta), ('surplus_dagitimi', df_sur),
                       ('vardiya_liste', df_var), ('aht_detay', df_aht_det),
                       ('ACIKLAMA', aciklama)):
            (df if len(df) else pd.DataFrame({'bilgi': ['veri yok']})) \
                .to_excel(xl, sheet_name=ad, index=False)

        # surplus özeti aynı sayfanın SAĞINA (vardiya bazında aylık toplam)
        if len(df_sur_ozet):
            df_sur_ozet.to_excel(xl, sheet_name='surplus_dagitimi', index=False,
                                 startcol=len(df_sur.columns) + 2)
        KIR, YES, MAV = (_P('solid', fgColor='FFC7CE'), _P('solid', fgColor='C6EFCE'),
                         _P('solid', fgColor='BDD7EE'))
        YUZDE = {'outsource_%', 'Erlang_karsilama', 'AHT_RR', 'Kap_RR', 'AHT_kap/Çağrı', 'MIP1/Erl', 'MIP2/Erl'}
        DONDUR = {'surplus_dagitimi': 'D2', 'gun_ozet': 'D2', 'vardiya_liste': 'E2', 'slot_detay': 'E2',
                  'hafta_ozet': 'C2', 'aht_detay': 'E2', 'ACIKLAMA': 'A2'}
        for ws in xl.book.worksheets:
            bas = [c.value for c in ws[1]]
            for c in ws[1]:
                c.font = _F(bold=True)
            ws.freeze_panes = DONDUR.get(ws.title, 'A2')
            if ws.max_row > 1:
                ws.auto_filter.ref = ws.dimensions
            for j, h in enumerate(bas, 1):
                L = _col(j)
                ws.column_dimensions[L].width = (70 if h in ('ne_gosterir', 'nasil_hesaplanir',
                                                             'outsource_vardiyalari')
                                                 else 24 if ws.title == 'ACIKLAMA'
                                                 else max(9, min(18, len(str(h)) + 2)))
                if ws.title == 'ACIKLAMA':
                    from openpyxl.styles import Alignment as _Al
                    for r in range(2, ws.max_row + 1):
                        ws.cell(row=r, column=j).alignment = _Al(wrap_text=True, vertical='top')
                if h not in YUZDE:
                    continue
                for r in range(2, ws.max_row + 1):
                    cell = ws.cell(row=r, column=j)
                    v = cell.value
                    if not isinstance(v, (int, float)):
                        continue
                    # RR (tavanlı) ≤ %100 → 0.0%, <%99 kırmızı; slot MIP/Erl ve Kap_RR eski renk
                    # gün/hafta oranları tavanlı (≤%100); slot_detay'dakiler tavansız
                    _tav = h in ('Erlang_karsilama', 'AHT_RR') or (h == 'Kap_RR' and ws.title != 'slot_detay')
                    cell.number_format = '0.0%' if _tav else '0%'
                    if _tav:
                        cell.fill = KIR if v < 0.99 else YES
                    elif h in ('Kap_RR', 'AHT_kap/Çağrı', 'MIP1/Erl', 'MIP2/Erl'):
                        cell.fill = KIR if v < 1.0 else (YES if v <= 1.05 else MAV)

        # ---- slot_detay FORMÜLLERİ (2026-10-14) ----
        # Satır içi hesaplar Excel formülü olarak yazılır → hücreye tıklayan
        # hesabı görür. Girdiler (çağrı, ihtiyaç, MIP, AHT, net_agent) SAYI
        # kalır. net_agent formül DEĞİL: Python round (2,5→2) ile Excel ROUND
        # (2,5→3) farklı → 1 kişi sapma olurdu. Renkler koşullu biçim.
        if len(df_slot) and 'slot_detay' in xl.book.sheetnames:
            from openpyxl.formatting.rule import CellIsRule as _CR
            _ws = xl.book['slot_detay']
            _c = {h: _col(j) for j, h in enumerate([c.value for c in _ws[1]], 1)}
            _n = _ws.max_row
            for r in range(2, _n + 1):
                C, I = f"{_c['cagri']}{r}", f"{_c['ihtiyac']}{r}"
                M1, M2 = f"{_c['MIP1']}{r}", f"{_c['MIP2']}{r}"
                _ws[f"{_c['MIP1/Erl']}{r}"] = f"=IF({I}>0,{M1}/{I},\"\")"
                _ws[f"{_c['MIP2/Erl']}{r}"] = f"=IF({I}>0,{M2}/{I},\"\")"
                _ws[f"{_c['eksik']}{r}"] = f"=MAX(0,{I}-{M2})"
                NA = f"{_c['net_agent']}{r}"
                _ca = _slot_ca[r - 2] if r - 2 < len(_slot_ca) else 15
                _ws[f"{_c['Kap_RR']}{r}"] = f"=IF({C}>0,{NA}*{_ca:g}/2/{C},\"\")"
                A = f"{_c['aht_sn']}{r}"
                if _ws[A].value not in (None, ''):
                    K = f"{_c['aht_kapasite_cagri']}{r}"
                    _ws[K] = f"={NA}*1800/{A}"
                    _ws[f"{_c['AHT_kap/Çağrı']}{r}"] = f"=IF({C}>0,{K}/{C},\"\")"
                    _ws[f"{_c['karsilanan']}{r}"] = f"=MIN({C},{K})"
                    _ws[K].number_format = '0.0'
                    _ws[f"{_c['karsilanan']}{r}"].number_format = '0.0'
            for h in ('MIP1/Erl', 'MIP2/Erl', 'Kap_RR', 'AHT_kap/Çağrı'):
                rng = f"{_c[h]}2:{_c[h]}{_n}"
                for r in range(2, _n + 1):
                    _ws[f"{_c[h]}{r}"].number_format = '0%'
                    _ws[f"{_c[h]}{r}"].fill = _P()          # Python rengi → koşullu biçime bırak
                _ws.conditional_formatting.add(rng, _CR(operator='lessThan', formula=['1'], fill=KIR))
                _ws.conditional_formatting.add(rng, _CR(operator='between', formula=['1', '1.05'], fill=YES))
                _ws.conditional_formatting.add(rng, _CR(operator='greaterThan', formula=['1.05'], fill=MAV))

        # ---- VARDİYA PLANI — eski haftalık düzen, BİRLEŞTİRME YOK ----
        # Eski export_monthly_plan_to_excel düzeni: her hafta bir blok, günler yan
        # yana, her gün KOLON SAYISI kadar kolon. Tarih başlığı bloğun ilk
        # hücresine yazılır, blok aynı renge boyanır (birleşik görünür ama
        # merge_cells YOK → Excel onarım uyarısı vermez). PT artık hafta içinde
        # de çalıştığı için ayrı blok yerine her kuyruğun yanında kolon.
        _wsv = xl.book.create_sheet('Vardiya Planı', 0)
        _GN = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Pzr']
        _ALT = ['SHIFT', 'kitle inhouse', 'kitle outsource', 'kitle PT', 'gold', 'gold PT',
                'kurumsal', 'kurumsal PT', 'Toplam', 'Toplam kısmi']
        _NK = len(_ALT)
        _f_tarih = _P('solid', fgColor='D9E1F2')
        _f_bas = _P('solid', fgColor='1F4E78')
        _f_top = _P('solid', fgColor='E7E6E6')
        from openpyxl.styles import Alignment as _A, Border as _B, Side as _S
        _ince = _S(border_style='thin', color='888888')
        _brd = _B(left=_ince, right=_ince, top=_ince, bottom=_ince)
        _ort = _A(horizontal='center', vertical='center')

        def _say(ds):
            """o günün {başlangıç: {(kuyruk, şirket): kişi}} + başlangıç → bitiş etiketi"""
            out, bit = {}, {}
            for q in queues:
                rq = (results.get(ds) or {}).get(q)
                if not rq:
                    continue
                mi = rq.get('mip_info', {}) or {}
                sc = mi.get('shift_coverage', {}) or {}
                for sh, k in (mi.get('assignments') or {}).items():
                    if k <= 0:
                        continue
                    c = sc.get(sh, {})
                    st, co = c.get('start', '?'), c.get('company', 'inhouse')
                    out.setdefault(st, {})
                    out[st][(q, co)] = out[st].get((q, co), 0) + k
                    bit.setdefault(st, {}).setdefault(co, set()).add(c.get('end', '?'))
            return out, bit

        def _satir(cnt):
            g = lambda q, co: cnt.get((q, co), 0)
            k_in, k_out, k_pt = g('kitle', 'inhouse'), g('kitle', 'outsource'), g('kitle', 'part_time')
            g_in = g('gold', 'inhouse') + g('gold', 'outsource')
            u_in = g('kurumsal', 'inhouse') + g('kurumsal', 'outsource')
            g_pt, u_pt = g('gold', 'part_time'), g('kurumsal', 'part_time')
            return [k_in, k_out, k_pt, g_in, g_pt, u_in, u_pt,
                    k_in + k_out + g_in + u_in, k_pt + g_pt + u_pt]

        _ilk = pd.to_datetime(tarihler[0])
        _son = pd.to_datetime(tarihler[-1])
        _pzt = _ilk - pd.Timedelta(days=_ilk.weekday())
        _row = 1
        while _pzt <= _son:
            hafta = [(_pzt + pd.Timedelta(days=i)).strftime('%Y-%m-%d') for i in range(7)]
            _pzt += pd.Timedelta(days=7)
            gun_v = {ds: _say(ds) for ds in hafta}
            baslar = sorted({st for ds in hafta for st in gun_v[ds][0]})
            if not baslar:
                continue
            # vardiya etiketi: başlangıç-bitiş (inhouse bitişi öncelikli)
            etiket = {}
            for st in baslar:
                bits = {}
                for ds in hafta:
                    for co, ss in gun_v[ds][1].get(st, {}).items():
                        bits.setdefault(co, set()).update(ss)
                for co in ('inhouse', 'outsource', 'part_time'):
                    if bits.get(co):
                        etiket[st] = f"{st}-{sorted(bits[co])[0]}"
                        break
                else:
                    etiket[st] = st
            # tarih başlığı + alt başlık
            for i, ds in enumerate(hafta):
                c0 = i * _NK + 1
                for j in range(_NK):
                    cc = _wsv.cell(row=_row, column=c0 + j)
                    cc.fill = _f_tarih
                    hc = _wsv.cell(row=_row + 1, column=c0 + j, value=_ALT[j])
                    hc.fill, hc.font, hc.alignment, hc.border = (
                        _f_bas, _F(color='FFFFFF', bold=True, size=9), _A(horizontal='center',
                        vertical='center', wrap_text=True), _brd)
                tc = _wsv.cell(row=_row, column=c0,
                               value=f"{_GN[i]} {pd.to_datetime(ds).strftime('%d.%m.%Y')}")
                tc.font = _F(bold=True, size=11)
            _row += 2
            # vardiya satırları
            toplam = {ds: [0] * (_NK - 1) for ds in hafta}
            for st in baslar:
                for i, ds in enumerate(hafta):
                    c0 = i * _NK + 1
                    v = _satir(gun_v[ds][0].get(st, {}))
                    toplam[ds] = [a + b for a, b in zip(toplam[ds], v)]
                    for j, val in enumerate([etiket[st]] + v):
                        cc = _wsv.cell(row=_row, column=c0 + j, value=val)
                        cc.alignment, cc.border = _ort, _brd
                _row += 1
            # toplam satırı
            for i, ds in enumerate(hafta):
                c0 = i * _NK + 1
                for j, val in enumerate(['Toplam'] + toplam[ds]):
                    cc = _wsv.cell(row=_row, column=c0 + j, value=val)
                    cc.fill, cc.font, cc.alignment, cc.border = _f_top, _F(bold=True), _ort, _brd
            _row += 3
        for i in range(7):
            _wsv.column_dimensions[_col(i * _NK + 1)].width = 12
            for j in range(1, _NK):
                _wsv.column_dimensions[_col(i * _NK + 1 + j)].width = 9
        _wsv.freeze_panes = 'B1'

        # ---- CONFIG (2026-10-14) — Excel'ler birikince hangisi hangi ayarla ----
        # KOŞUDAKİ config pickle'dan okunur: results[gün][kuyruk]['_config']
        # koşu anındaki CONFIG'in sığ kopyası (blok_coz). Böylece cache'ten
        # yüklenen eski bir plan, notebook'ta sonradan değişen ayarla
        # etiketlenmez. Üç sütun: koşudaki · dosyadaki (config_unified_v1.py)
        # · şimdiki (bu fonksiyona verilen config).
        from config_unified_v1 import CONFIG_UNIFIED as _DOSYA, _BLOK as _BL
        _ATLA = {'sub_queues', '_gun_tipi'} | set(_BL)   # AHT → aht_detay; _BLOK üste kopyalanmış tekrar

        def _duz(d, on=''):
            out = {}
            if isinstance(d, dict):
                for k, v in d.items():
                    if not on and k in _ATLA:
                        continue
                    out.update(_duz(v, f"{on}.{k}" if on else str(k)))
            elif (isinstance(d, (list, tuple)) and d and
                  all(isinstance(x, dict) and 'start' in x and 'end' in x for x in d)):
                for x in d:                  # bant listesi → saat aralığıyla anahtarla
                    out.update(_duz({k: v for k, v in x.items() if k not in ('start', 'end')},
                                    f"{on}[{x['start']}-{x['end']}]"))
            else:
                out[on] = d
            return out

        _kcfg = next((rq['_config'] for ds in tarihler for rq in (results.get(ds) or {}).values()
                      if rq and rq.get('_config')), None)
        _kaynak = 'pickle (koşu anındaki config)' if _kcfg else 'şimdiki CONFIG (pickle\'da config yok)'
        _K = _duz(_kcfg if _kcfg else config)
        _D, _S = _duz(_DOSYA), _duz(config)
        _yaz = lambda v: v if isinstance(v, (int, float, str)) and not isinstance(v, bool) else repr(v)
        _sat, n_ez, n_deg = [], 0, 0
        for k in list(dict.fromkeys(list(_K) + list(_D) + list(_S))):   # config dosyasındaki sıra
            kv, dv, sv = _K.get(k, '—'), _D.get(k, '—'), _S.get(k, '—')
            dur = []
            if kv == '—' and _kcfg:
                dur.append('koşuda yok (eski pickle, ayar sonradan eklendi)')
            elif repr(kv) != repr(dv):
                dur.append("notebook'ta ezildi"); n_ez += 1
            if repr(sv) != repr(kv) and kv != '—':
                dur.append('⚠ koşudan sonra değişti'); n_deg += 1
            _sat.append((k, _yaz(kv), _yaz(dv), _yaz(sv) if repr(sv) != repr(kv) else '', ' · '.join(dur)))

        _g = lambda yol, vars=None: _K.get(yol, vars)
        _kosu = kosu or {}
        _kart = [
            ('Excel', os.path.basename(output_path)),
            ('pickle', _kosu.get('pickle', '—')),
            ('Excel oluşturma', dt.datetime.now().strftime('%d.%m.%Y %H:%M')),
            ('config kaynağı', _kaynak),
            ("notebook'ta ezilen ayar", n_ez),
            ('⚠ koşudan sonra değişen ayar', n_deg if n_deg else 0),
            ('', ''),
            ('inhouse_mod', _g('haftalik_vardiya.inhouse_mod')),
            ('inhouse_surplus', _g('haftalik_vardiya.inhouse_surplus')),
            ('outsource_ortak_set', _g('haftalik_vardiya.outsource_ortak_set')),
            ('outsource_gunluk_esit', _g('haftalik_vardiya.outsource_gunluk_esit')),
            ('surplus dağıtımı', _g('surplus_distribution.enabled')),
            ('rr_gun_dengesi', _g('rr_gun_dengesi.enabled')),
            ('sarkan_devret', _g('haftalik_vardiya.sarkan_devret', 'bilinmiyor (eski pickle, config\'te yoktu)')),
            ('önceki ay son günü', _kosu.get('onceki_ay_son_gun', '—')),
            ('devrik hafta (inhouse önceki aydan)', _kosu.get('devrik', '—')),
            ('ceza kapsama hafta içi', _g('ceza.kapsama_hafta_ici')),
            ('ceza kapsama hafta sonu', _g('ceza.kapsama_hafta_sonu')),
            ('solver gap_rel', _g('solver.gap_rel')),
            ('solver gap_rel_by_queue', repr({k.split('.')[-1]: v for k, v in _K.items()
                                              if k.startswith('solver.gap_rel_by_queue.')})),
            ('solver time_limit', _g('solver.time_limit')),
            ('PT sayısı', repr({k.split('.')[-1]: v for k, v in _K.items()
                                if k.startswith('part_time.count.')})),
            ('outsource oran bandı kitle', f"{_g('outsource_ratio.kitle.min')} – {_g('outsource_ratio.kitle.max')}"),
        ] + [(f"min_per_shift {q} {t}", _g(f"queue_configs.{q}.{t}.mip.min_per_shift"))
             for q in queues for t in ('hafta_ici', 'cumartesi', 'pazar')]

        _wc = xl.book.create_sheet('CONFIG', xl.book.sheetnames.index('ACIKLAMA'))
        _wc.cell(row=1, column=1, value='KOŞU KARTI').font = _F(bold=True, size=12)
        for i, (a, v) in enumerate(_kart, 2):
            _wc.cell(row=i, column=1, value=a).font = _F(bold=True)
            _wc.cell(row=i, column=2, value=_yaz(v) if v != '' else None)
            if a.startswith('⚠') and v:
                _wc.cell(row=i, column=2).fill = _P('solid', fgColor='F8CBAD')
        _r0 = len(_kart) + 4
        _wc.cell(row=_r0 - 1, column=1, value='TÜM CONFIG').font = _F(bold=True, size=12)
        for j, h in enumerate(['ayar', 'kosudaki_deger', 'dosyadaki_deger', 'simdiki_notebook', 'durum'], 1):
            _wc.cell(row=_r0, column=j, value=h).font = _F(bold=True)
        _SAR, _TUR = _P('solid', fgColor='FFF2CC'), _P('solid', fgColor='F8CBAD')
        for i, row in enumerate(_sat, _r0 + 1):
            for j, v in enumerate(row, 1):
                c = _wc.cell(row=i, column=j, value=v)
                if row[4]:
                    c.fill = _TUR if '⚠' in row[4] else _SAR
        _wc.auto_filter.ref = f"A{_r0}:E{_r0 + len(_sat)}"
        for L, wd in zip('ABCDE', (58, 24, 24, 20, 34)):
            _wc.column_dimensions[L].width = wd
        _wc.freeze_panes = f"A{_r0 + 1}"

    print(f"✓ Excel (v2, birleştirme yok): {output_path}")
    print(f"  gun_ozet {len(df_gun)} · vardiya_plani {len(df_var)} · "
          f"slot_detay {len(df_slot)} · hafta_ozet {len(df_hafta)} · "
          f"surplus_dagitimi {len(df_sur)} satır")
    return output_path


