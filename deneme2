# %% [KONTROL] MESAİYE KALAMAZ — AGENT BAZLI MİNİ MODEL (H12+H16C+H17+H18M)
from ortools.sat.python import cp_model as _cpk
from collections import Counter as _Cmx


def _ok_mx(a, ds):
    """o gün fiilen çalışabilir mi (H9/H13/H14B/H16/H16B/H15-ay başı)."""
    d = dt.date.fromisoformat(ds)
    if d in TATIL:
        return False
    for v in gun_vardiyalari.get(ds, []):
        if (a, ds, v) not in x or not _kova_calisabilir(a, ds, v):
            continue
        if d in ARIFE and (v != ARIFE_YARIM or d.weekday() >= 5):
            continue
        if d == AY_ILK and not _h18m_h15_uygun(a, ds, v):
            continue
        return True
    return False


_gd_mx = [dt.date.fromisoformat(ds) for ds in PLAN_GUNLER]
_pen_mx = [AY_ILK - dt.timedelta(days=k) for k in range(6, 0, -1)] + _gd_mx
_talep_off_mx = set(mesai_hs_talep_off)
_sz_mx = set(mesai_sinir_zorunlu)


def _mini_mx(a, kurallar):
    m = _cpk.CpModel()
    w = {ds: m.NewBoolVar(ds) for ds in PLAN_GUNLER if _ok_mx(a, ds)}
    if "H16C" in kurallar:
        for wk, g in haftalar.items():
            m.Add(sum(w[ds] for ds in g if ds in w) <= _ay_ici_haftalik_norm_tavan(a, g))
    if "H17" in kurallar:
        m.Add(sum(w.values()) >= kota_map[a])
    if "H12" in kurallar:
        _cal = onceki_calisti.get(a, set())
        for s in _pen_mx:
            if s + dt.timedelta(days=6) > _gd_mx[-1]:
                continue
            _p = [s + dt.timedelta(days=k) for k in range(7)]
            _v = [w[d.isoformat()] for d in _p if d.isoformat() in w]
            if _v:
                m.Add(sum(_v) <= max(0, 6 - sum(1 for d in _p if d < AY_ILK and d in _cal)))
    if "H18M" in kurallar:
        for (b, cmt), (_uyg, _ger) in mesai_hs_zorunlu.items():
            if b == a:
                m.Add(sum(w[ds] for ds in _uyg if ds in w) >= _ger)
        for ds in PLAN_GUNLER:
            if (a, ds) in _talep_off_mx and ds in w:
                m.Add(w[ds] == 0)
            if (a, ds) in _sz_mx:
                m.Add(w[ds] == 1) if ds in w else m.Add(0 == 1)
    s = _cpk.CpSolver()
    s.parameters.max_time_in_seconds = 5
    return s.StatusName(s.Solve(m))


_KUR = ["H12", "H16C", "H17", "H18M"]
_bozuk_mx = []
for a in sorted(set(mesai_yok) & set(kota_map)):
    if _mini_mx(a, set(_KUR)) == "INFEASIBLE":
        _gerekli = [k for k in _KUR if _mini_mx(a, set(_KUR) - {k}) != "INFEASIBLE"]
        _bozuk_mx.append((a, _gerekli))

print("=" * 96)
print(f"MESAİYE KALAMAZ MİNİ MODEL: {len(set(mesai_yok) & set(kota_map))} agent, "
      f"{len(_bozuk_mx)} agent TEK BAŞINA çözümsüz")
print(f"  çelişkide gereken kurallar: {dict(_Cmx(tuple(g) for _, g in _bozuk_mx))}")
_onc_mx = sorted(d for d in PENCERE_GUNLER)
for a, _g in _bozuk_mx[:12]:
    _cal = onceki_calisti.get(a, set())
    print(f"\n  {a}  kota {kota_map[a]}  gerekli: {_g}")
    print("    önceki ay: " + " ".join(f"{d.day:02d}{'█' if d in _cal else '·'}" for d in _onc_mx))
    for wk in sorted(haftalar):
        _gg = haftalar[wk]
        _s = []
        for ds in _gg:
            d = dt.date.fromisoformat(ds)
            if (a, ds) in _sz_mx:
                k = "Z"                                   # H18M sınır zorunlu
            elif (a, ds) in _talep_off_mx:
                k = "o"                                   # hafta sonu off_t kesin off
            elif not _ok_mx(a, ds):
                k = "x"                                   # çalışamaz (izin/off_t2/tatil/kıdem/H15)
            elif any(b == a and ds in u for (b, _c), (u, _r) in mesai_hs_zorunlu.items()):
                k = "H"                                   # H18M hafta sonu zorunlu
            else:
                k = "."
            _s.append(f"{d.day:02d}{DAY_TR[d.weekday()][:2]}{k}")
        print(f"    W{wk[1]} tavan {_ay_ici_haftalik_norm_tavan(a, _gg)}: " + " ".join(_s)
              + "".join(f"  [{mesai_sinir_muaf[(a, ds)]}]" for ds in _gg if (a, ds) in mesai_sinir_muaf))
if len(_bozuk_mx) > 12:
    print(f"\n  ... {len(_bozuk_mx) - 12} agent daha")
print("  lejant: Z sınır zorunlu | H h.sonu zorunlu | o h.sonu off_t | x çalışamaz | . serbest | █ önceki ay çalıştı")
print("=" * 96)
