def _short_stage_note(solution_stage, total_shortfall=0):
    """solution_stage → kısa not.

    İKİ AŞAMA (2026-10-09): tavan MIP + MIP sonrası surplus dağıtımı.
    Eksik kapsama yine slack değişkeniyle modelin içinde.
    """
    if not solution_stage:
        return 'tavan+dağıtım' if not total_shortfall else f"eksik {total_shortfall}"
    return str(solution_stage)

