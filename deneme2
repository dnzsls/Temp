def _compute_rr_metrics_for_day(r_queue, queue, cfg_weekday=None, cfg_weekend=None,
                                  is_weekend=False, aht_by_slot=None):
    """Bir günün bir kuyruğu için slot-bazlı RR metrikleri.

    Returns:
        (slot_rows, day_summary)
        - slot_rows: liste [{slot, calls, erlang, mip1, mip2, rr1, rr2,
                              nmt, ck, kap_rr}, ...]  — sadece Erlang>0 olan slotlar
        - day_summary: dict {erl_pk, mip2_pk, rr2_at_peak, rr2_min, rr2_max,
                              rr2_avg (Erlang-weighted), kap_rr_day, total_calls,
                              total_ck}  — slot yoksa None
    """
    if r_queue is None:
        return [], None
    mi = r_queue.get('mip_info', {})
    s1 = mi.get('mip_info_stage1') or r_queue.get('mip_info_stage1') or {}
    # ── SAHA GERÇEĞİ TABANI (2026-10-05) ──────────────────────────────
    # erlang : HAM (sarkan düşümü öncesi) → gerçek ihtiyaç
    # mip2   : FİİLİ (o gün giren + önceki günden sarkan) → sahadaki kişi
    # mip1   : stage1 ham MIP + AYNI sarkan. Sarkan surplus'tan bağımsız
    #          değil ama stage1 tanısal bir ara aşama; tek taban kullanılır.
    erl_by_slot = (mi.get('erlang_by_slot_ham') or
                    r_queue.get('erlang_by_slot_ham') or
                    mi.get('erlang_by_slot') or
                    r_queue.get('erlang_by_slot') or {})
    _sg = mi.get('sarkan_gelen_by_slot', {}) or {}
    mip2_by_slot = mi.get('fiili_by_slot') or mi.get('mip_by_slot', {}) or {}
    # RR1 (2026-10-12 düzeltmesi): dağıtım ÖNCESİ anlık görüntünün KENDİ
    # fiili_by_slot'u (o günün MIP'i + önceki günün dağıtım ÖNCESİ sarkanı).
    # Eskiden stage1 mip_by_slot'a dağıtım SONRASI sarkan ekleniyordu → gece
    # slotlarında RR1 şişiyor, dağıtımın etkisi küçük görünüyordu.
    # Eski pickle'da snapshot fiili'si yoksa: snapshot'ın KENDİ mip_by_slot +
    # KENDİ sarkan_gelen_by_slot'u (dağıtım SONRASI sarkan eklenmez).
    _m1_ham = s1.get('mip_by_slot')
    _sg1 = s1.get('sarkan_gelen_by_slot') or {}
    mip1_by_slot = (s1.get('fiili_by_slot')
                    or ({sl: v + _sg1.get(sl, 0) for sl, v in _m1_ham.items()}
                        if _m1_ham else mip2_by_slot))
    calls_by_slot = r_queue.get('calls_by_slot', {}) or {}

    # Kap_RR için hourly_report config — adresi akışa göre değişir, aşağıdaki
    # zincir ÜÇ yapıyı birden karşılar:
    #   1. hafta sonu : queue_configs[kuyruk][gün]['hourly_report']
    #                   (day_type sonuçta taşınıyor: 'cumartesi' | 'pazar')
    #   2. hafta içi  : queue_configs[kuyruk]['hourly_report']
    #                   (day_type None → gün kademesi atlanır)
    #   3. düzleşmiş  : _config üst seviyesi — hafta sonu pipeline'ı bloğu
    #                   öne aldığı için hourly_report orada da bulunur
    #
    # Boş dönerse rapor_etkisi/kapasite_kaybi 0 sayılır ve Kap_RR olduğundan
    # YÜKSEK çıkar (kayıp düşülmemiş olur) — bu yüzden zincir üç adımlı.
    base_cfg = cfg_weekend if is_weekend else cfg_weekday
    eff_cfg = r_queue.get('_config') or base_cfg or {}
    _qc = eff_cfg.get('queue_configs', {}).get(queue, {})
    _gun = r_queue.get('day_type')              # 'cumartesi'|'pazar'; hafta içi → None
    hr_cfg = ((_qc.get(_gun) or _qc).get('hourly_report')
              or eff_cfg.get('hourly_report', {}))
    re_cfg = hr_cfg.get('rapor_etkisi', {})
    kk_cfg = hr_cfg.get('kapasite_kaybi', {})
    ca_cfg = hr_cfg.get('cagri_adedi', {})

    slot_rows = []
    rr2_values = []
    erl_weights = []
    t_ck = 0.0
    t_ck_kar = 0.0       # Kap_RR tavanlı: her yarım saatte min(kapasite, çağrı)
    t_cagri = 0
    # AHT KAPASİTESİ (2026-10-14): 15 çağrı/saat yerine o yarım saatin
    # alt-kuyruk ağırlıklı AHT'si. Net kişi Kap_RR ile AYNI (rapor etkisi +
    # kapasite kaybı düşülmüş). Doluluk %100 varsayılır (boşta bekleme yok).
    _aht = aht_by_slot or {}
    t_aht_c, t_aht_ck, t_aht_kar, t_aht_kmy = 0.0, 0.0, 0.0, 0.0

    for slot in sorted(erl_by_slot.keys()):
        erl = erl_by_slot[slot]
        if erl <= 0:
            continue
        mip1 = mip1_by_slot.get(slot, 0)
        mip2 = mip2_by_slot.get(slot, 0)
        calls = int(calls_by_slot.get(slot, 0))

        rr1 = mip1 / erl
        rr2 = mip2 / erl

        # Kapasite hesabı (actual_pipeline_v9_weekly._capacity_calc_v7 ile aynı)
        h = int(slot[:2])
        re_oran = re_cfg.get(h, re_cfg.get('default', 0))
        kk_oran = kk_cfg.get(h, kk_cfg.get('default', 0))
        ca = ca_cfg.get(h, ca_cfg.get('default', 15))
        re_v = round(mip2 * re_oran)
        kk_v = round(mip2 * kk_oran)
        nmt = mip2 - re_v - kk_v
        ck = nmt * (ca / 2)
        kap_rr = (ck / calls) if calls > 0 else None

        aht = _aht.get(slot)
        aht_ck = (nmt * 1800 / aht) if aht else None          # 30 dk = 1800 sn
        if aht_ck is not None:
            t_aht_c += calls * aht
            t_aht_ck += aht_ck
            t_aht_kar += min(aht_ck, calls)
            t_aht_kmy += max(0.0, calls - aht_ck)

        slot_rows.append({
            'slot': slot, 'calls': calls, 'erlang': erl,
            'mip1': mip1, 'mip2': mip2,
            'rr1': rr1, 'rr2': rr2,
            'nmt': nmt, 'ck': ck, 'kap_rr': kap_rr, 'ca': ca,
            'aht': aht, 'aht_ck': aht_ck,
            'aht_kap': (aht_ck / calls) if (aht_ck is not None and calls > 0) else None,
        })
        rr2_values.append(rr2)
        erl_weights.append(erl)
        t_ck += ck
        t_ck_kar += min(ck, calls)
        t_cagri += calls

    if not rr2_values:
        return slot_rows, None

    total_w = sum(erl_weights)
    rr2_avg = (sum(r * w for r, w in zip(rr2_values, erl_weights)) / total_w
                if total_w > 0 else 0)
    peak_idx = erl_weights.index(max(erl_weights))
    _mip2_top = sum(s['mip2'] for s in slot_rows)
    day_summary = {
        # TOPLAMLAR (2026-10-12): aylık ağırlık ve özet tablo bunları kullanır
        'erl_top': total_w,                                   # Σ ihtiyaç (kişi-slot)
        'mip2_top': _mip2_top,                                # Σ sahadaki kişi (aynı slotlar)
        'eksik': sum(max(0, s['erlang'] - s['mip2']) for s in slot_rows),
        'fazla': sum(max(0, s['mip2'] - s['erlang']) for s in slot_rows),
        # RR (2026-10-14, tavanlı): her slotta sahadaki en fazla ihtiyaç kadar
        # sayılır → fazla saat açık saati ÖRTMEZ. = 1 − Σ eksik ÷ Σ ihtiyaç.
        # rr2_avg (eski, Σ sahadaki ÷ Σ ihtiyaç = doluluk) uyumluluk için duruyor.
        'rr': (1 - sum(max(0, s['erlang'] - s['mip2']) for s in slot_rows) / total_w
               if total_w > 0 else 1.0),
        'rr_alti_slot': sum(1 for s in slot_rows if s['mip2'] < s['erlang']),
        'erl_pk': max(erl_weights),
        'mip2_pk': max((s['mip2'] for s in slot_rows), default=0),
        'rr2_at_peak': rr2_values[peak_idx],
        'rr2_min': min(rr2_values),
        'rr2_max': max(rr2_values),
        'rr2_avg': rr2_avg,
        # 2026-10-14: TAVANLI — fazla kapasiteli yarım saat açık olanı örtmez
        # (eskisi Σ kapasite ÷ Σ çağrı idi). total_ck tavansız toplam kalır.
        'kap_rr_day': (t_ck_kar / t_cagri) if t_cagri > 0 else 0,
        # AHT kapasitesi (aht_by_slot verildiyse; yoksa None)
        'ort_aht': (t_aht_c / t_cagri) if (_aht and t_cagri > 0) else None,
        'aht_karsilanan': t_aht_kar if _aht else None,       # Σ min(kapasite, çağrı)
        'aht_karsilanamayan': t_aht_kmy if _aht else None,   # Σ max(0, çağrı − kapasite)
        'aht_rr': ((t_aht_kar / (t_aht_kar + t_aht_kmy))
                   if (_aht and (t_aht_kar + t_aht_kmy) > 0) else None),
        'total_calls': t_cagri,
        'total_ck': t_ck,
    }
    return slot_rows, day_summary

def _rr_color(rr2):
    """RR2 değerine göre renk: <1.0 kırmızı, >1.05 mavi, arada yeşil."""
    if rr2 is None:
        return None
    if rr2 < 1.0:
        return Font(bold=True, color='C00000')
    if rr2 > 1.05:
        return Font(color='0070C0')
    return Font(color='006100')

def _add_weekly_detail_sheet(wb, week_idx, week_dates, results, queues,
                              header_fill, header_font, date_fill, date_font,
                              total_fill, total_font, border, center,
                              cfg_weekday=None, cfg_weekend=None):
    """Bir hafta için detay sheet'i ekle. 3 kuyruk için sırayla:
    1) Günlük MIP1/MIP2/Fark/Eksik özeti
       MIP1 = inhouse ≤ kadro (en az kaç yeter) · MIP2 = inhouse = kadro
    2) Eksik kapsama detayı (modelin kapatamadığı slotlar)
    3) Slot bazlı RR
    """
    sheet_name = f"Hafta {week_idx}"
    ws = wb.create_sheet(sheet_name)
    DAY_TR_W = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Pzr']

    # Üst başlık
    title = f"HAFTA {week_idx}: {week_dates[0]} → {week_dates[-1]}"
    cell = ws.cell(row=1, column=1, value=title)
    cell.fill = date_fill
    cell.font = Font(bold=True, size=12)
    cell.alignment = center
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=10)

    current_row = 3

    for queue in queues:
        # Kuyruk başlığı
        # DİKKAT: metin '=' ile BAŞLAMAMALI. openpyxl '=' ile başlayan string'i
        # FORMÜL olarak yazıyor; Excel "=== KITLE ===" ifadesini ayrıştıramayıp
        # "Removed Records: Formula from /xl/worksheets/sheetN.xml part" uyarısıyla
        # dosyayı onarıyordu. Görsel ayraç için '──' kullanıldı.
        cell = ws.cell(row=current_row, column=1, value=f"── {queue.upper()} ──")
        cell.font = Font(bold=True, size=11, color='1F4E78')
        ws.merge_cells(start_row=current_row, start_column=1,
                       end_row=current_row, end_column=10)
        current_row += 1

        # ---- A) Günlük MIP1 / MIP2 / Fark / Eksik tablosu ----
        # 2026-10-09: tavan MIP + MIP SONRASI dağıtım yapısına dönüldü →
        # kolonlar tekrar 'önce/sonra' anlamına kavuştu (tek koşu, iki aşama):
        #   MIP (en az)      : Σ inhouse ≤ kadro, Σ outsource ≤ bütçe
        #   Dağıtım sonrası  : rr_first aritmetiğiyle kadro/bütçe dolduruldu
        #   Dağıtılan        : aradaki fark = surplus_total_added
        headers = ['Gün', 'Tarih', 'MIP (en az)', 'Dağıtım sonrası',
                   'Dağıtılan', 'Eksik', 'Çözüm']
        for j, h in enumerate(headers, 1):
            c = ws.cell(row=current_row, column=j, value=h)
            c.fill = header_fill
            c.font = header_font
            c.alignment = center
            c.border = border
        current_row += 1

        t_mip1 = t_mip2 = t_surp = t_short = 0
        any_data = False
        for ds in week_dates:
            d = pd.to_datetime(ds)
            gun = DAY_TR_W[d.weekday()]
            r = results.get(ds)
            if r is None or queue not in r or r[queue] is None:
                # Boş satır
                ws.cell(row=current_row, column=1, value=gun).border = border
                ws.cell(row=current_row, column=2,
                        value=d.strftime('%d.%m.%Y')).border = border
                for j in range(3, 8):
                    c = ws.cell(row=current_row, column=j, value='-')
                    c.alignment = center
                    c.border = border
                current_row += 1
                continue

            any_data = True
            mi = r[queue]['mip_info']
            # mip_info_stage1 = MIP1 koşusu (run_month_unified mip1=True ise)
            s1 = mi.get('mip_info_stage1') or r[queue].get('mip_info_stage1') or {}
            mip2 = mi.get('total_kisi', 0)
            # MIP1 yoksa MIP2 ile aynı (weekend: surplus yok)
            mip1 = s1.get('total_kisi', mip2)
            surplus = mip2 - mip1
            shortfall = mi.get('total_shortfall', 0)
            sol = mi.get('solution_stage')
            stage_str = _short_stage_note(sol, shortfall)

            vals = [gun, d.strftime('%d.%m.%Y'), mip1, mip2,
                    f"+{surplus}" if surplus > 0 else str(surplus),
                    shortfall if shortfall > 0 else '-',
                    stage_str]
            for j, v in enumerate(vals, 1):
                c = ws.cell(row=current_row, column=j, value=v)
                c.alignment = center
                c.border = border
            t_mip1 += mip1; t_mip2 += mip2; t_surp += surplus; t_short += shortfall
            current_row += 1

        if any_data:
            # Toplam satırı
            totals_vals = ['TOPLAM', '', t_mip1, t_mip2,
                            f"+{t_surp}" if t_surp > 0 else str(t_surp),
                            t_short if t_short > 0 else '-', '']
            for j, v in enumerate(totals_vals, 1):
                c = ws.cell(row=current_row, column=j, value=v)
                c.fill = total_fill
                c.font = total_font
                c.alignment = center
                c.border = border
            current_row += 1
        current_row += 1

        # ---- C) Eksik kapsama: hangi gün, hangi slotlar ----
        # 'Önerilen Ek Kadro' kolonu KALDIRILDI (2026-10-08): yeni model
        # shortfall_recommendations üretmiyor, kolon her satırda "(öneri yok)"
        # yazıyordu. Yerine modelin GERÇEKTEN ürettiği shortfall_by_slot:
        # açığın hangi saatlerde olduğunu doğrudan gösterir.
        shortfall_rows = []
        for ds in week_dates:
            r = results.get(ds)
            if r is None or queue not in r or r[queue] is None:
                continue
            mi = r[queue]['mip_info']
            total_sf = mi.get('total_shortfall', 0)
            if total_sf <= 0:
                continue
            d = pd.to_datetime(ds)
            sf_slot = mi.get('shortfall_by_slot', {}) or {}
            slot_str = ', '.join(f"{t}: {v}" for t, v in sorted(sf_slot.items()))
            shortfall_rows.append([DAY_TR_W[d.weekday()], d.strftime('%d.%m.%Y'),
                                   total_sf, slot_str or '-'])

        if shortfall_rows:
            cell = ws.cell(row=current_row, column=1,
                           value=f"⚠ EKSİK KAPSAMA — {queue}")
            cell.font = Font(bold=True, italic=True, color='C00000')
            ws.merge_cells(start_row=current_row, start_column=1,
                           end_row=current_row, end_column=8)
            current_row += 1
            sf_headers = ['Gün', 'Tarih', 'Toplam Eksik (kişi-slot)',
                          'Açık Slotlar (saat: kişi)']
            for j, h in enumerate(sf_headers, 1):
                c = ws.cell(row=current_row, column=j, value=h)
                c.fill = header_fill
                c.font = header_font
                c.alignment = center
                c.border = border
            ws.column_dimensions[
                ws.cell(row=current_row, column=4).column_letter].width = 60
            current_row += 1
            for row_vals in shortfall_rows:
                for j, v in enumerate(row_vals, 1):
                    c = ws.cell(row=current_row, column=j, value=v)
                    c.alignment = (Alignment(horizontal='left', vertical='center',
                                             wrap_text=True) if j == 4 else center)
                    c.border = border
                current_row += 1
            current_row += 1

        # ---- D) SLOT BAZLI RR (YENİ) ----
        # Her aktif slot için: Çağrı, Erlang, MIP1, MIP2, MIP1/Erl, MIP2/Erl, Kap_RR
        # (2026-10-14: RR1/RR2 başlıkları MIP/Erl oldu — gün RR'siyle karışıyordu)
        # Her günün altında ÖZET satırı: avg/min/max + Kap_RR_Day
        cell = ws.cell(row=current_row, column=1,
                        value=f"SLOT BAZLI RR — {queue}")
        cell.font = Font(bold=True, italic=True, color='1F4E78')
        ws.merge_cells(start_row=current_row, start_column=1,
                       end_row=current_row, end_column=10)
        current_row += 1

        rr_headers = ['Gün', 'Tarih', 'Slot', 'Çağrı', 'Erlang',
                      'MIP1', 'MIP2', 'MIP1/Erl %', 'MIP2/Erl %', 'Kap_RR %']
        for j, h in enumerate(rr_headers, 1):
            c = ws.cell(row=current_row, column=j, value=h)
            c.fill = header_fill
            c.font = header_font
            c.alignment = center
            c.border = border
        current_row += 1

        for ds in week_dates:
            r = results.get(ds)
            if r is None or queue not in r or r[queue] is None:
                continue
            d = pd.to_datetime(ds)
            gun = DAY_TR_W[d.weekday()]
            is_wknd = d.weekday() >= 5
            slot_rows, day_summary = _compute_rr_metrics_for_day(
                r[queue], queue, cfg_weekday=cfg_weekday,
                cfg_weekend=cfg_weekend, is_weekend=is_wknd)
            if not slot_rows:
                continue

            # Slot satırları
            for sr in slot_rows:
                vals = [gun, d.strftime('%d.%m.%Y'), sr['slot'],
                        sr['calls'], sr['erlang'],
                        sr['mip1'], sr['mip2'],
                        f"{sr['rr1']:.0%}", f"{sr['rr2']:.0%}",
                        (f"{sr['kap_rr']:.0%}" if sr['kap_rr'] is not None else '-')]
                for j, v in enumerate(vals, 1):
                    c = ws.cell(row=current_row, column=j, value=v)
                    c.alignment = center
                    c.border = border
                    # RR2 renklendirme
                    if j == 9:
                        col_font = _rr_color(sr['rr2'])
                        if col_font:
                            c.font = col_font
                current_row += 1

            # Günlük ÖZET satırı
            if day_summary is not None:
                # 2026-10-14: RR tavanlı (fazla açığı örtmez) + eksik + fazla
                _E = day_summary['erl_top']
                ds_vals = [
                    gun, d.strftime('%d.%m.%Y'), 'ÖZET',
                    day_summary['total_calls'], round(_E),
                    '', round(day_summary['mip2_top']),
                    '',
                    f"Erlang_karsilama {day_summary['rr']:.1%} | "
                    f"eksik {round(day_summary['eksik'])} | "
                    f"fazla {round(day_summary['fazla'])}",
                    f"{day_summary['kap_rr_day']:.0%}",
                ]
                for j, v in enumerate(ds_vals, 1):
                    c = ws.cell(row=current_row, column=j, value=v)
                    c.fill = total_fill
                    c.font = total_font
                    c.alignment = center
                    c.border = border
                # ÖZET RR cell'inde alignment'i daha geniş kolon için sola
                c9 = ws.cell(row=current_row, column=9)
                c9.alignment = Alignment(horizontal='center', vertical='center',
                                          wrap_text=True)
                current_row += 1

        current_row += 1   # gün/kuyruk arası boşluk ekstra

        # Kuyruklar arası boşluk
        current_row += 1

    # Kolon genişlikleri
    widths = {'A': 6, 'B': 12, 'C': 28, 'D': 14, 'E': 10,
              'F': 10, 'G': 12, 'H': 10}
    for col, w in widths.items():
        ws.column_dimensions[col].width = w

def _add_rr_report_sheet(wb, results, queues, all_dates,
                          header_fill, header_font, date_fill, date_font,
                          total_fill, total_font, border, center,
                          cfg_weekday=None, cfg_weekend=None):
    """Aylık RR raporu — günlük min/max/avg + Kap_RR (3 kuyruk yan yana).

    Her kuyruk için 6 kolon:
       Erl_Pk | MIP2_Pk | RR2_Avg | RR2_Min | RR2_Max | Kap_RR
    """
    ws = wb.create_sheet("RR Raporu")
    DAY_TR_R = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Pzr']
    # 2026-10-12: Erl_Pk / MIP2_Pk / RR Min / RR Max kaldırıldı (kullanıcı:
    # ağırlıklı RR yeterli). Yerine HAP bilgi: çağrı, RR, kapsama, eksik,
    # açık slot, Kap_RR.
    #   2026-10-14: RR tavanlı — her slotta sahadaki en fazla ihtiyaç kadar sayılır
    #   RR        = 1 − Σ eksik ÷ Σ ihtiyaç (fazla saat açığı ÖRTMEZ; eski Kapsama %)
    #   Eksik     = Σ max(0, ihtiyaç − sahadaki)  kişi-slot
    #   Fazla     = Σ max(0, sahadaki − ihtiyaç)  kişi-slot (RR'ye girmez)
    #   Açık slot = sahadaki < ihtiyaç olan yarım saat sayısı
    METRICS_PER_QUEUE = 6
    SUB_HEADERS = ['Çağrı', 'Erlang_karsilama', 'Eksik', 'Fazla', 'Açık slot', 'Kap_RR']

    # Başlık
    cell = ws.cell(row=1, column=1,
                    value="AYLIK RR RAPORU — RR (tavanlı) · eksik · fazla · kapasite RR")
    cell.fill = date_fill
    cell.font = Font(bold=True, size=12)
    cell.alignment = center
    total_cols = 2 + len(queues) * METRICS_PER_QUEUE
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=total_cols)

    # Üst başlık satırı (Tarih, Gün + kuyruk blokları)
    row1 = 3
    for k, h in enumerate(['Tarih', 'Gün'], 1):
        c = ws.cell(row=row1, column=k, value=h)
        c.fill = header_fill
        c.font = header_font
        c.alignment = center
        c.border = border
    ws.merge_cells(start_row=row1, start_column=1, end_row=row1 + 1, end_column=1)
    ws.merge_cells(start_row=row1, start_column=2, end_row=row1 + 1, end_column=2)

    col_offset = 3
    for queue in queues:
        cell = ws.cell(row=row1, column=col_offset, value=queue.upper())
        cell.fill = header_fill
        cell.font = header_font
        cell.alignment = center
        ws.merge_cells(start_row=row1, start_column=col_offset,
                       end_row=row1, end_column=col_offset + METRICS_PER_QUEUE - 1)
        col_offset += METRICS_PER_QUEUE

    # Alt başlık (metric isimleri)
    row2 = row1 + 1
    col_offset = 3
    for queue in queues:
        for k, h in enumerate(SUB_HEADERS):
            c = ws.cell(row=row2, column=col_offset + k, value=h)
            c.fill = header_fill
            c.font = header_font
            c.alignment = center
            c.border = border
        col_offset += METRICS_PER_QUEUE

    # Veri satırları
    current_row = row2 + 1
    # Aylık özet için biriktir
    monthly = {q: {'cagri': 0, 'erl': 0.0, 'mip2': 0.0, 'eksik': 0.0, 'fazla': 0.0, 'acik': 0,
                   'kap_rr_vals': []} for q in queues}

    for ds in sorted(all_dates):
        d = pd.to_datetime(ds)
        gun = DAY_TR_R[d.weekday()]
        is_wknd = d.weekday() >= 5
        r = results.get(ds)

        for k, v in enumerate([d.strftime('%d.%m.%Y'), gun], 1):
            c = ws.cell(row=current_row, column=k, value=v)
            c.alignment = center
            c.border = border

        col_offset = 3
        for queue in queues:
            if r is None or queue not in r or r[queue] is None:
                for k in range(METRICS_PER_QUEUE):
                    c = ws.cell(row=current_row, column=col_offset + k, value='-')
                    c.alignment = center
                    c.border = border
            else:
                _slot_rows, day_summary = _compute_rr_metrics_for_day(
                    r[queue], queue, cfg_weekday=cfg_weekday,
                    cfg_weekend=cfg_weekend, is_weekend=is_wknd)
                if day_summary is None:
                    for k in range(METRICS_PER_QUEUE):
                        c = ws.cell(row=current_row, column=col_offset + k, value='-')
                        c.alignment = center
                        c.border = border
                else:
                    rr_t = day_summary['rr']
                    kap_rr = day_summary['kap_rr_day']
                    _E, _K = day_summary['erl_top'], day_summary['eksik']
                    vals = [day_summary['total_calls'], f"{rr_t:.1%}",
                            int(round(_K)), int(round(day_summary['fazla'])),
                            day_summary['rr_alti_slot'], f"{kap_rr:.0%}"]
                    for k, v in enumerate(vals):
                        c = ws.cell(row=current_row, column=col_offset + k, value=v)
                        c.alignment = center
                        c.border = border
                        if k == 1:
                            c.font = (Font(bold=True, color='C00000') if rr_t < 0.99
                                      else Font(color='006100'))
                        elif k == 5:
                            f = _rr_color(kap_rr)
                            if f: c.font = f
                    m = monthly[queue]
                    m['cagri'] += day_summary['total_calls']
                    m['erl'] += _E
                    m['mip2'] += day_summary['mip2_top']
                    m['eksik'] += _K
                    m['fazla'] += day_summary['fazla']
                    m['acik'] += day_summary['rr_alti_slot']
                    m['kap_rr_vals'].append((kap_rr, day_summary['total_calls']))
            col_offset += METRICS_PER_QUEUE
        current_row += 1

    # Aylık özet satırı
    ws.cell(row=current_row, column=1, value='AYLIK').fill = total_fill
    ws.cell(row=current_row, column=1).font = total_font
    ws.cell(row=current_row, column=1).alignment = center
    ws.cell(row=current_row, column=1).border = border
    ws.cell(row=current_row, column=2, value='—').fill = total_fill
    ws.cell(row=current_row, column=2).font = total_font
    ws.cell(row=current_row, column=2).alignment = center
    ws.cell(row=current_row, column=2).border = border

    col_offset = 3
    for queue in queues:
        m = monthly[queue]
        # AYLIK RR (2026-10-14, tavanlı) = 1 − Σ eksik ÷ Σ ihtiyaç — ağırlık
        # günlerin Σ ihtiyacı; fazla açığı örtmez.
        _rr_ay = (1 - m['eksik'] / m['erl']) if m['erl'] > 0 else 1.0
        # Çağrı-ağırlıklı aylık Kap_RR
        if m['kap_rr_vals']:
            total_calls = sum(c for _, c in m['kap_rr_vals'])
            wkap = (sum(r * c for r, c in m['kap_rr_vals']) / total_calls
                     if total_calls > 0 else 0)
        else:
            wkap = 0
        vals = [m['cagri'], f"{_rr_ay:.1%}", int(round(m['eksik'])),
                int(round(m['fazla'])), m['acik'], f"{wkap:.0%}"]
        for k, v in enumerate(vals):
            c = ws.cell(row=current_row, column=col_offset + k, value=v)
            c.fill = total_fill
            c.font = total_font
            c.alignment = center
            c.border = border
        col_offset += METRICS_PER_QUEUE

    # Açıklama
    current_row += 2
    cell = ws.cell(row=current_row, column=1,
                    value="Erlang_karsilama = 1 − Σ eksik ÷ Σ ihtiyaç (planda yeterli KİŞİ var mı; tavanlı: her yarım saatte sahadaki en fazla ihtiyaç kadar sayılır, fazla açığı örtmez; <%99 kırmızı)  |  "
                          "Eksik = karşılanamayan kişi-slot  |  Fazla = ihtiyacın üstündeki kişi-slot (RR'ye girmez)  |  "
                          "Açık slot = ihtiyacın altında kalan yarım saat  |  "
                          "Kap_RR = karşılanabilen çağrı ÷ gelen çağrı (15 çağrı/saat, kayıplar düşülmüş; her yarım saatte en fazla gelen çağrı kadar sayılır, fazla açığı örtmez)")
    cell.alignment = Alignment(horizontal='left', vertical='center', wrap_text=True)
    ws.merge_cells(start_row=current_row, start_column=1,
                   end_row=current_row, end_column=total_cols)
    ws.row_dimensions[current_row].height = 30

    # Kolon genişlikleri
    ws.column_dimensions['A'].width = 12
    ws.column_dimensions['B'].width = 5
    col_letter_offset = 3
    for queue in queues:
        for k in range(METRICS_PER_QUEUE):
            col_letter = ws.cell(row=row2, column=col_letter_offset + k).column_letter
            ws.column_dimensions[col_letter].width = 10
        col_letter_offset += METRICS_PER_QUEUE

def export_monthly_plan_to_excel(results, year, month,
                                  cfg_weekday=None, cfg_weekend=None,
                                  queues=('kitle', 'gold', 'kurumsal'),
                                  output_path=None):
    """Aylık vardiya planını Excel'e yazar (forecast).

    cfg_weekday / cfg_weekend: RR hesabı için hourly_report config'i gerekli
    (rapor_etkisi, kapasite_kaybi, cagri_adedi). Verilmezse Kap_RR çalışmaz.
    """
    if output_path is None:
        ay_isimleri = ['Ocak', 'Subat', 'Mart', 'Nisan', 'Mayis', 'Haziran',
                       'Temmuz', 'Agustos', 'Eylul', 'Ekim', 'Kasim', 'Aralik']
        ay_adi = ay_isimleri[month - 1]
        output_path = f"vardiya_plani_forecast_{year}_{month:02d}_{ay_adi}.xlsx"

    all_dates = sorted(results.keys())
    if not all_dates:
        print("⚠ results boş, export atlandı")
        return None

    first = pd.to_datetime(all_dates[0])
    last = pd.to_datetime(all_dates[-1])
    start_mon = first - pd.Timedelta(days=first.weekday())
    end_sun = last + pd.Timedelta(days=(6 - last.weekday()))

    weeks = []
    cur = start_mon
    while cur <= end_sun:
        week = [(cur + pd.Timedelta(days=i)).strftime('%Y-%m-%d')
                for i in range(7)]
        weeks.append(week)
        cur += pd.Timedelta(days=7)

    DAY_TR = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Pzr']
    # 2026-10-08: PT ana tabloya girdi, 'INH Total'/'OS Total' kaldırıldı.
    #   · PT eskiden SADECE sağdaki ayrı blokta ve YALNIZ Cmt/Pzr için vardı
    #     (eski modelde PT yalnız hafta sonu çalışıyordu). Yeni modelde
    #     part_time.hafta_gun=5 → PT hafta içinde de var, o blok eksik kalıyordu.
    #   · Toplam       = inhouse + outsource  (PT HARİÇ)
    #   · Toplam kısmi = PT kolonlarının toplamı
    COLS_PER_DAY = 10
    SUB_HEADERS = ['SHIFT', 'kitle inhouse', 'kitle outsource', 'kitle part time',
                   'gold', 'gold part time', 'kurumsal', 'kurumsal part time',
                   'Toplam', 'Toplam kısmi']

    wb = Workbook()
    ws = wb.active
    ws.title = 'Vardiya Planı'

    header_fill = PatternFill(start_color='1F4E78', end_color='1F4E78', fill_type='solid')
    header_font = Font(color='FFFFFF', bold=True, size=10)
    date_fill = PatternFill(start_color='D9E1F2', end_color='D9E1F2', fill_type='solid')
    date_font = Font(bold=True, size=11)
    total_fill = PatternFill(start_color='E7E6E6', end_color='E7E6E6', fill_type='solid')
    total_font = Font(bold=True)
    thin = Side(border_style='thin', color='888888')
    border = Border(left=thin, right=thin, top=thin, bottom=thin)
    center = Alignment(horizontal='center', vertical='center')

    def _collect_week_data(week):
        all_starts = set()
        counts = {}
        ends_per_start_company = {}
        for day_idx, ds in enumerate(week):
            r = results.get(ds)
            if not r:
                continue
            for queue in queues:
                qr = r.get(queue)
                if not qr:
                    continue
                mi = qr.get('mip_info', {})
                sc = mi.get('shift_coverage', {})
                for s, c in mi.get('assignments', {}).items():
                    if c <= 0:
                        continue
                    sci = sc.get(s, {})
                    company = sci.get('company', 'inhouse')
                    start = sci.get('start', '?')
                    end = sci.get('end', '?')
                    all_starts.add(start)
                    ends_per_start_company.setdefault(start, {})\
                        .setdefault(company, set()).add(end)
                    counts.setdefault(start, {}).setdefault(day_idx, {})\
                        .setdefault(queue, {})
                    counts[start][day_idx][queue][company] = \
                        counts[start][day_idx][queue].get(company, 0) + c
        labels = {}
        for start in all_starts:
            ebc = ends_per_start_company.get(start, {})
            if ebc.get('inhouse'):
                end_repr = sorted(ebc['inhouse'])[0]
            elif ebc.get('outsource'):
                end_repr = sorted(ebc['outsource'])[0]
            elif ebc.get('part_time'):
                end_repr = sorted(ebc['part_time'])[0]   # yalnız PT olan satır
            else:
                end_repr = '?'
            labels[start] = f"{start}-{end_repr}"
        return sorted(all_starts), labels, counts

    def _row_values(start_counts):
        """SUB_HEADERS ile AYNI sırada 9 değer (SHIFT kolonu hariç).

        gold/kurumsal'da outsource YOK (companies: ['inhouse']) → o kuyrukların
        kolonu inhouse sayısıdır; PT'leri ayrı kolonda.
        Toplam       = inhouse + outsource  (PT HARİÇ)
        Toplam kısmi = PT toplamı
        """
        def _g(q, co):
            return start_counts.get(q, {}).get(co, 0)

        k_inh, k_out, k_pt = _g('kitle', 'inhouse'), _g('kitle', 'outsource'), _g('kitle', 'part_time')
        g_inh, g_pt = _g('gold', 'inhouse'), _g('gold', 'part_time')
        u_inh, u_pt = _g('kurumsal', 'inhouse'), _g('kurumsal', 'part_time')
        # gold/kurumsal'da outsource beklenmiyor; config değişirse kaybolmasın
        g_inh += _g('gold', 'outsource')
        u_inh += _g('kurumsal', 'outsource')
        toplam = k_inh + k_out + g_inh + u_inh
        toplam_kismi = k_pt + g_pt + u_pt
        return [k_inh, k_out, k_pt, g_inh, g_pt, u_inh, u_pt,
                toplam, toplam_kismi]

    current_row = 1
    for week in weeks:
        sorted_starts, labels, counts = _collect_week_data(week)
        if not sorted_starts:
            continue

        # Tarih başlığı
        for day_idx, ds in enumerate(week):
            col_offset = day_idx * COLS_PER_DAY
            d = pd.to_datetime(ds)
            date_label = f"{DAY_TR[day_idx]} {d.strftime('%d.%m.%Y')}"
            cell = ws.cell(row=current_row, column=col_offset + 1, value=date_label)
            cell.fill = date_fill
            cell.font = date_font
            cell.alignment = center
            ws.merge_cells(start_row=current_row, start_column=col_offset + 1,
                           end_row=current_row, end_column=col_offset + COLS_PER_DAY)
        current_row += 1

        # Sub-header
        for day_idx in range(7):
            col_offset = day_idx * COLS_PER_DAY
            for j, h in enumerate(SUB_HEADERS):
                cell = ws.cell(row=current_row, column=col_offset + j + 1, value=h)
                cell.fill = header_fill
                cell.font = header_font
                cell.alignment = center
                cell.border = border
        current_row += 1

        # Main shift satırları
        for start in sorted_starts:
            for day_idx in range(7):
                col_offset = day_idx * COLS_PER_DAY
                cell = ws.cell(row=current_row, column=col_offset + 1,
                               value=labels[start])
                cell.alignment = center
                cell.border = border
                day_start_counts = counts.get(start, {}).get(day_idx, {})
                vals = _row_values(day_start_counts)
                for j, v in enumerate(vals):
                    cell = ws.cell(row=current_row, column=col_offset + j + 2,
                                   value=v)
                    cell.alignment = center
                    cell.border = border
            current_row += 1

        # Main toplam
        main_toplam_row = current_row
        for day_idx in range(7):
            col_offset = day_idx * COLS_PER_DAY
            cell = ws.cell(row=main_toplam_row, column=col_offset + 1, value='Toplam')
            cell.fill = total_fill
            cell.font = total_font
            cell.alignment = center
            cell.border = border
            totals = [0] * (COLS_PER_DAY - 1)
            for start in sorted_starts:
                day_start_counts = counts.get(start, {}).get(day_idx, {})
                vals = _row_values(day_start_counts)
                for j in range(COLS_PER_DAY - 1):
                    totals[j] += vals[j]
            for j, v in enumerate(totals):
                cell = ws.cell(row=main_toplam_row, column=col_offset + j + 2, value=v)
                cell.fill = total_fill
                cell.font = total_font
                cell.alignment = center
                cell.border = border
        current_row += 1

        current_row += 2

    # Kolon genişlikleri
    for day_idx in range(7):
        col_offset = day_idx * COLS_PER_DAY
        ws.column_dimensions[
            ws.cell(row=2, column=col_offset + 1).column_letter].width = 12
        for j in range(1, COLS_PER_DAY):
            col_letter = ws.cell(row=2, column=col_offset + j + 1).column_letter
            ws.column_dimensions[col_letter].width = 11


    # =========================================================================
    # Sheet 3+: Haftalık detay sheet'leri (Hafta 1, Hafta 2, ...)
    # Her sheet: 3 kuyruk için günlük MIP1/MIP2/Surplus/Eksik + dağıtım +
    # shortfall + SLOT BAZLI RR
    # =========================================================================
    n_weekly_sheets = 0
    for week_idx, week_dates in enumerate(weeks, 1):
        valid_dates = [d for d in week_dates if results.get(d) is not None]
        if not valid_dates:
            continue
        _add_weekly_detail_sheet(
            wb, week_idx, week_dates, results, queues,
            header_fill, header_font, date_fill, date_font,
            total_fill, total_font, border, center,
            cfg_weekday=cfg_weekday, cfg_weekend=cfg_weekend,
        )
        n_weekly_sheets += 1

    # =========================================================================
    # Son sheet: RR Raporu — tüm ay için tek tablo
    # =========================================================================
    _add_rr_report_sheet(
        wb, results, queues, all_dates,
        header_fill, header_font, date_fill, date_font,
        total_fill, total_font, border, center,
        cfg_weekday=cfg_weekday, cfg_weekend=cfg_weekend,
    )


    wb.save(output_path)

    n_rows_plan = ws.max_row
    print(f"✓ Excel kaydedildi: {output_path}")
    print(f"  Sheet 'Vardiya Planı': {len(weeks)} hafta, {n_rows_plan} satır")
    print(f"  Haftalık detay sheet'leri: {n_weekly_sheets}")
    print(f"  Sheet 'RR Raporu': aylık")
    return output_path

def export_excel_v2(results, year, month, config,
                    queues=('kitle', 'gold', 'kurumsal'), output_path=None,
                    df_forecast=None, kosu=None):
    """Aylık plan → Excel, PANDAS ile (2026-10-12).

    Eski export_monthly_plan_to_excel elle kurulan, çok sayıda BİRLEŞTİRİLMİŞ
    hücre içeren sayfalar yazıyordu → Excel açılışta "onarım" uyarısı veriyordu.
    Bu sürüm yalnız düz tablolar yazar (birleştirme YOK), sonra biçim verir:
    kalın başlık, dondurulmuş başlık, filtre, RR renkleri.

    Sayfalar:
      gun_ozet       tarih × kuyruk: çağrı, in/out/PT, eksik, fazla, RR (tavanlı), Kap_RR
      vardiya_plani  kuyruk × şirket × vardiya × saat  →  kolonlar tarih (kişi)
      slot_detay     tarih × kuyruk × yarım saat: çağrı, ihtiyaç, MIP1/MIP2, MIP1/Erl, MIP2/Erl, Kap_RR, eksik
      hafta_ozet     kuyruk × hafta: kişi, eksik, fazla, RR, adam-gün, PT, outsource seti
      aht_detay      tarih × kuyruk × yarım saat: alt-kuyruk çağrı + AHT → ağırlıklı AHT
      CONFIG         koşu kartı + config'in tamamı (koşudaki · dosyadaki · şimdiki)
      ACIKLAMA       kolon anlamları
    df_forecast verilirse (HÜCRE 2'deki) AHT kapasitesi hesaplanır: AHT_RR,
    ort_aht_sn, karsilanan/karsilanamayan_cagri. Verilmezse bu kolonlar boş.
    Ölçüler RR Raporu (_compute_rr_metrics_for_day) ile AYNI.
    """
    from openpyxl.styles import Font as _F, PatternFill as _P
    from openpyxl.utils import get_column_letter as _col

    if output_path is None:
        ay = ['Ocak', 'Subat', 'Mart', 'Nisan', 'Mayis', 'Haziran', 'Temmuz',
              'Agustos', 'Eylul', 'Ekim', 'Kasim', 'Aralik'][month - 1]
        output_path = f"vardiya_plani_forecast_{year}_{month:02d}_{ay}_v2.xlsx"
    tarihler = sorted(results)
    if not tarihler:
        print("⚠ results boş, export atlandı")
        return None
    GUN = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Pzr']

    # ---- AHT (2026-10-14): Erlang'ın kullandığı ağırlıklı AHT, yarım saat bazında ----
    # results'ta saklanmıyor → tahmin verisinden yeniden hesaplanır (model
    # yeniden çözülmez). Ağırlık = o yarım saatteki alt-kuyruk çağrı payı.
    aht_map, aht_s = {}, []
    if df_forecast is not None:
        from weekly_pipeline_unified_v1 import calculate_weighted_aht, get_sub_queue_aht
        _d30 = prepare_forecast_calls_30(df_forecast, config=config)
        _d30 = _d30[_d30['data_date'].isin(pd.to_datetime(tarihler))]
        for _, row in _d30.iterrows():
            _ds, _sl = row['data_date'].strftime('%Y-%m-%d'), row['slot_30']
            for q in queues:
                _a = calculate_weighted_aht(row, q, _sl, config)
                aht_map.setdefault((_ds, q), {})[_sl] = _a
                det = {'tarih': row['data_date'].date(),
                       'gun': GUN[row['data_date'].weekday()], 'kuyruk': q, 'slot': _sl,
                       'cagri': row.get(f"{q}_total")}
                for sq in (config.get('sub_queues', {}).get(q, {}) or {}).get('queues', []):
                    det[f"{sq}_cagri"] = row.get(f"{sq}_calls")
                    det[f"{sq}_aht"] = get_sub_queue_aht(q, sq, _sl, config)
                det['agirlikli_aht_sn'] = _a
                aht_s.append(det)
    else:
        print("  ⚠ df_forecast verilmedi → AHT kapasitesi (AHT_RR) hesaplanmadı")
    df_aht_det = pd.DataFrame(aht_s)
    if len(df_aht_det):
        _bas = ['tarih', 'gun', 'kuyruk', 'slot', 'cagri']
        df_aht_det = df_aht_det[_bas + [c for c in df_aht_det.columns if c not in _bas
                                        and c != 'agirlikli_aht_sn'] + ['agirlikli_aht_sn']]
        df_aht_det = df_aht_det.sort_values(['kuyruk', 'tarih', 'slot'])

    gun_s, slot_s, var_s, sur_s = [], [], {}, []
    for ds in tarihler:
        d = pd.to_datetime(ds)
        for q in queues:
            rq = (results.get(ds) or {}).get(q)
            if not rq:
                continue
            mi = rq.get('mip_info', {}) or {}
            slot_rows, ozet = _compute_rr_metrics_for_day(
                rq, q, cfg_weekday=config, cfg_weekend=config,
                is_weekend=d.weekday() >= 5, aht_by_slot=aht_map.get((ds, q)))
            t_in = mi.get('total_inhouse_kisi', 0)
            t_ou = mi.get('total_outsource_kisi', 0)
            t_pt = mi.get('total_part_time_kisi', 0)
            E = (ozet or {}).get('erl_top', 0) or 0
            K = (ozet or {}).get('eksik', 0) or 0
            gun_s.append({
                'tarih': d.date(), 'gun': GUN[d.weekday()], 'kuyruk': q,
                'cagri': int(sum((rq.get('calls_by_slot') or {}).values())),
                'inhouse': t_in, 'outsource': t_ou, 'part_time': t_pt,
                'toplam': t_in + t_ou + t_pt,
                'outsource_%': (t_ou / (t_in + t_ou + t_pt)) if (t_in + t_ou + t_pt) else None,
                'ihtiyac_kisi_slot': round(E),
                'eksik_kisi_slot': round(K),
                'fazla_kisi_slot': round((ozet or {}).get('fazla', 0) or 0),
                # 2026-10-14: başlık 'RR' → 'Erlang_karsilama' (çağrı oranlarıyla karışıyordu)
                'Erlang_karsilama': (1 - K / E) if E else None,   # tavanlı
                'Kap_RR': (ozet or {}).get('kap_rr_day'),
                'acik_slot': (ozet or {}).get('rr_alti_slot', 0),
                'ort_aht_sn': (round(ozet['ort_aht'], 1)
                               if (ozet or {}).get('ort_aht') is not None else None),
                'karsilanan_cagri': (round(ozet['aht_karsilanan'])
                                     if (ozet or {}).get('aht_karsilanan') is not None else None),
                'karsilanamayan_cagri': (round(ozet['aht_karsilanamayan'])
                                         if (ozet or {}).get('aht_karsilanamayan') is not None else None),
                'AHT_RR': (ozet or {}).get('aht_rr'),
            })
            for r in slot_rows:
                slot_s.append({
                    'tarih': d.date(), 'gun': GUN[d.weekday()], 'kuyruk': q,
                    'slot': r['slot'], 'cagri': r['calls'], 'ihtiyac': r['erlang'],
                    'MIP1': r['mip1'], 'MIP2': r['mip2'],
                    'MIP1/Erl': r['rr1'], 'MIP2/Erl': r['rr2'], 'Kap_RR': r['kap_rr'],
                    'eksik': max(0, r['erlang'] - r['mip2']),
                    'aht_sn': r['aht'], 'net_agent': r['nmt'],
                    'aht_kapasite_cagri': (round(r['aht_ck'], 1) if r['aht_ck'] is not None else None),
                    'AHT_kap/Çağrı': r['aht_kap'],
                    'karsilanan': (round(min(r['calls'], r['aht_ck']), 1)
                                   if r['aht_ck'] is not None else None),
                    '_ca': r['ca'],             # Excel'e yazılmaz; Kap_RR formülündeki çağrı/saat
                })
            sc = mi.get('shift_coverage', {}) or {}
            # SURPLUS: dağıtım sonrası − dağıtım öncesi (mip_info_stage1) vardiya farkı
            _once = ((mi.get('mip_info_stage1') or rq.get('mip_info_stage1') or {})
                     .get('assignments') or {})
            if _once:
                _son = mi.get('assignments') or {}
                for s in set(_once) | set(_son):
                    _ek = _son.get(s, 0) - _once.get(s, 0)
                    if _ek:
                        c = sc.get(s, {})
                        sur_s.append({'tarih': d.date(), 'gun': GUN[d.weekday()], 'kuyruk': q,
                                      'sirket': c.get('company', '?'), 'vardiya': s,
                                      'saat': f"{c.get('start', '?')}-{c.get('end', '?')}",
                                      'mip_once': _once.get(s, 0), 'eklenen': _ek,
                                      'son_plan': _son.get(s, 0)})
            for s, k in (mi.get('assignments') or {}).items():
                if k <= 0:
                    continue
                c = sc.get(s, {})
                key = (q, c.get('company', '?'), s, f"{c.get('start', '?')}-{c.get('end', '?')}")
                var_s.setdefault(key, {})[str(d.date())] = k

    df_gun = pd.DataFrame(gun_s)
    df_slot = pd.DataFrame(slot_s)
    _slot_ca = df_slot.pop('_ca').tolist() if '_ca' in df_slot.columns else []
    df_var = pd.DataFrame([{'kuyruk': k[0], 'sirket': k[1], 'vardiya': k[2], 'saat': k[3], **v}
                           for k, v in var_s.items()])
    if len(df_var):
        _tc = sorted(c for c in df_var.columns if c[:2] == '20')
        df_var = (df_var[['kuyruk', 'sirket', 'vardiya', 'saat'] + _tc]
                  .sort_values(['kuyruk', 'sirket', 'saat']).fillna(0))
        df_var[_tc] = df_var[_tc].astype(int)
        df_var['toplam_kisi_gun'] = df_var[_tc].sum(axis=1)

    # ---- hafta özeti ----
    hafta_s = []
    if len(df_gun):
        df_gun['_hafta'] = df_gun['tarih'].map(lambda x: _week_of_month(str(x)))
        for (q, h), g in df_gun.groupby(['kuyruk', '_hafta']):
            ag = ((config.get('kadro', {}).get('outsource_adam_gun') or {})
                  .get(q, {}) or {}).get(f"hafta_{h}")
            hi_g = [str(t) for t in g['tarih'] if pd.Timestamp(t).weekday() < 5]
            seti = sorted({s for t in hi_g
                           for s, k in ((results[t][q]['mip_info'].get('assignments') or {}).items())
                           if k > 0 and (results[t][q]['mip_info'].get('shift_coverage', {})
                                         .get(s, {}).get('company')) == 'outsource'})
            E, K = g['ihtiyac_kisi_slot'].sum(), g['eksik_kisi_slot'].sum()
            F = g['fazla_kisi_slot'].sum()
            _kar = g['karsilanan_cagri'].sum(min_count=1)
            _kmy = g['karsilanamayan_cagri'].sum(min_count=1)
            hafta_s.append({
                'kuyruk': q, 'hafta': h, 'ilk_gun': g['tarih'].min(), 'son_gun': g['tarih'].max(),
                'gun_sayisi': len(g), 'kisi_gun': int(g['toplam'].sum()),
                'eksik_kisi_slot': int(K), 'fazla_kisi_slot': int(F),
                'Erlang_karsilama': (1 - K / E) if E else None,
                'karsilanamayan_cagri': (None if pd.isna(_kmy) else int(_kmy)),
                'AHT_RR': (None if pd.isna(_kar) or (_kar + _kmy) <= 0
                           else _kar / (_kar + _kmy)),
                'outsource_kullanilan': int(g['outsource'].sum()), 'outsource_butce': ag,
                'part_time_kisi_gun': int(g['part_time'].sum()),
                'outsource_hafta_ici_set': len(seti), 'outsource_vardiyalari': ', '.join(seti),
            })
        df_gun = df_gun.drop(columns='_hafta')
    df_hafta = pd.DataFrame(hafta_s)
    df_sur = pd.DataFrame(sur_s, columns=['tarih', 'gun', 'kuyruk', 'sirket', 'vardiya', 'saat',
                                          'mip_once', 'eklenen', 'son_plan'])
    if len(df_sur):
        df_sur = df_sur.sort_values(['kuyruk', 'tarih', 'sirket', 'saat'])
        df_sur_ozet = (df_sur.groupby(['kuyruk', 'sirket', 'saat', 'vardiya'], as_index=False)
                       .agg(eklenen_kisi_gun=('eklenen', 'sum'), gun_sayisi=('tarih', 'nunique'))
                       .sort_values(['kuyruk', 'sirket', 'saat']))
    else:
        df_sur_ozet = pd.DataFrame(columns=['kuyruk', 'sirket', 'saat', 'vardiya',
                                            'eklenen_kisi_gun', 'gun_sayisi'])

    # ACIKLAMA (2026-10-14): planlama dışından okuyan herkes anlasın diye sade dil
    aciklama = pd.DataFrame([
        # ---- üç oran: ne soruyor? ----
