_bas = _sh[_scol['start']].astype(str).str[:5]
_inh = _sh[_scol['company']].astype(str) == 'inhouse'


def _bedel(ipd):
    b = {'eksik': 0.0, 'rr_dengesi': 0.0, 'tavan': 0.0}
    for ds in HAFTA:
        s1 = ipd[ds].get('mip_info_stage1') or ipd[ds]
        tip = gun_tipi(ds)
        sf = s1.get('shortfall_by_slot') or {}
        b['eksik'] += sum(v * _W.kapsama_cezasi(CONFIG, tip, t) for t, v in sf.items())
        E, S = sum(v for v in (ipd[ds].get('erlang_by_slot') or {}).values() if v > 0), sum(sf.values())
        taban = CONFIG['ceza']['kapsama_hafta_ici' if tip == 'hafta_ici' else 'kapsama_hafta_sonu']
        if _rg.get('enabled'):
            for e, k in zip(_rg.get('esikler', [0.01, 0.02]), _rg.get('carpanlar', [1.0, 2.0])):
                b['rr_dengesi'] += max(0.0, S - e * E) * k * taban
        b['tavan'] += sum(v * p for v, p in (s1.get('sc_excess_by_slot') or {}).values())
    return b


