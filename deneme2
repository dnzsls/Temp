import re, difflib
DOSYA = "/Users/deniz/Documents/Beyza/shift_planning/agent_detay_v2/kurumsal_cagrilar_agent_detayli_model_v2.py"

def _parcala(t):
    d = {}
    for p in re.split(r"(?m)^(?=# %% \[HÜCRE )", t):
        m = re.match(r"# %% \[HÜCRE ([^\]]+)\]", p)
        if m: d[m.group(1)] = p
    return d
_norm = lambda s: [l.rstrip() for l in s.strip().splitlines() if l.strip()]

_dosya = _parcala(open(DOSYA, encoding="utf-8").read())
_nb = {}
for _kod in In[:-1]:                      # en son koşulan sürüm kazanır
    _nb.update(_parcala(_kod))

for _k, _dk in _dosya.items():
    if _k not in _nb:
        print(f"HÜCRE {_k:4s} — bu oturumda koşulmamış"); continue
    _a, _b = _norm(_nb[_k]), _norm(_dk)
    if _a == _b:
        print(f"HÜCRE {_k:4s} ✓"); continue
    _fark = [l for l in difflib.unified_diff(_a, _b, "notebook", "dosya", n=0, lineterm="")
             if l[:1] in "+-" and l[:3] not in ("+++", "---")]
    print(f"HÜCRE {_k:4s} ✗ FARKLI ({len(_fark)} satır) — ilk farklar:")
    for l in _fark[:4]: print("      ", l[:110])
