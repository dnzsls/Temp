def _haftalar(year, month):
    """Ayın günlerini hafta_N'e göre gruplar → [(hafta_no, [tarih,...]), ...]

    `_week_of_month` ile AYNI bölümleme (Pzt başlangıçlı, ay sınırına saygılı).
    Kısmi hafta olabilir: ay ilk/son haftası 7 günden az.
    """
    cal = calendar.Calendar()
    gunler = [d for d in cal.itermonthdates(year, month) if d.month == month]
    grup = {}
    for d in gunler:
        ds = d.strftime('%Y-%m-%d')
        grup.setdefault(_week_of_month(ds), []).append(ds)
    return [(w, sorted(grup[w])) for w in sorted(grup)]

def _sarkan_son_gun(info_per_day, dates):
    """Haftanın SON gününün ertesi güne taşan kadrosu → {slot: kişi}"""
    if not info_per_day or not dates:
        return {}
    son = dates[-1]
    inf = info_per_day.get(son) or {}
    cov = inf.get('shift_coverage', {}) or {}
    asg = inf.get('assignments', {}) or {}
    out = {}
    for k, n in asg.items():
        if n <= 0 or k not in cov:
            continue
        for t in cov[k].get('slots_d1', []):
            out[t] = out.get(t, 0) + int(n)
    return out

def _sarkan_disaridan(gun_result, queue):
    """results[tarih][kuyruk] → {slot: kişi} (önceki ayın son günü için)"""
    qr = (gun_result or {}).get(queue) or {}
    mi = qr.get('mip_info', {}) or {}
    cov = mi.get('shift_coverage', {}) or {}
    asg = mi.get('assignments', {}) or {}
    out = {}
    for k, c in cov.items():
        n = int(asg.get(k, 0) or 0)
        if n <= 0:
            continue
        d1 = c.get('slots_d1')
        if d1 is None:                                  # eski pickle
            st = str(c.get('start'))[:5]
            try:
                bn = f"{int(st[:2]) % 24:02d}:{st[3:5]}"
            except Exception:
                continue
            d1 = [t for t in (c.get('slots') or []) if t < bn]
        for t in d1:
            out[t] = out.get(t, 0) + n
    return out

def gece_sarkan_gun(vardiyalar):
    """ELLE GİRİŞ → `onceki_ay_son_gun` şekli (önceki ayın SON günü).

    NE İÇİN: ayın 1'inin ilk saatleri önceki ayın son akşamının vardiyasıyla
    doluyor. O gün bu ayın `results`'ında olmadığı için sarkan bilinmiyor →
    ayın 1'i gece slotlarında EKSİK kadro görünüyor. Önceki ayın pickle'ı
    varsa `onceki_ay_son_gun=res_onceki['2026-09-30']` yeter; yoksa bu
    fonksiyonla elle kurulur.

    vardiyalar: {kuyruk: [(baslangic, bitis, sirket, kisi), ...]}
        Örn: {'kitle': [('19:00', '03:00', 'outsource', 13),
                        ('17:00', '01:30', 'outsource', 23)],
              'gold':  [('19:00', '03:00', 'inhouse', 4)],
              'kurumsal': []}
        SADECE gece yarısını aşan vardiyaları yazmak YETER. '00:00-08:00' ve
        '15:00-24:00' gibi vardiyalar sarkmaz, sonucu değiştirmez.
        sirket: 'inhouse' / 'outsource' / 'part_time'

    Kullanımı:
        eylul30 = gece_sarkan_gun({...})
        results = run_month_forecast(2026, 10, ...,
                                      onceki_ay_son_gun=eylul30)

    Döndürdüğü şey `results[tarih]` ile aynı şekli taşır ama YALNIZ
    sarkan hesabı için gereken alanları içerir (shift_coverage + assignments);
    başka hiçbir yerde kullanılmaz.
    """
    SL = [f"{h:02d}:{m:02d}" for h in range(24) for m in (0, 30)]
    out = {}
    for q, liste in (vardiyalar or {}).items():
        cov, asg = {}, {}
        for i, (bas, bit, sirket, kisi) in enumerate(liste or []):
            bas, bit = str(bas)[:5], str(bit)[:5]
            bn = f"{int(bas[:2]) % 24:02d}:{bas[3:5]}"
            bi = SL.index(bn)
            # '…-24:00' / '…-00:00' → gün sonu
            ei = (len(SL) if bit[:2] in ('24', '00') and bit[3:5] == '00'
                  else SL.index(f"{int(bit[:2]) % 24:02d}:{bit[3:5]}"))
            if ei <= bi:                          # geceyi aşıyor
                ei += len(SL)
            tum = [SL[k % len(SL)] for k in range(bi, ei)]
            key = f"{bas}-{bit}_{sirket}_{i}"
            cov[key] = {'shift': f"{bas}-{bit}", 'company': sirket,
                        'start': bas, 'end': bit,
                        'slots':    [sl for sl in tum if sl >= bn],
                        'slots_d1': [sl for sl in tum if sl <  bn]}
            asg[key] = int(kisi)
        out[q] = {'mip_info': {'shift_coverage': cov, 'assignments': asg}}
    return out

def run_month_unified(year, month, df_forecast, df_shifts_dict,
                      config=CONFIG_UNIFIED,
                      queues=('kitle', 'kurumsal', 'gold'),
                      mip1=True,
                      sarkan_devret=False,
                      onceki_ay_son_gun=None,
                      verbose=True):
    """Bir ayı haftalık birleşik modelle çözer.

    mip1           : True → her hafta İKİNCİ kez (inhouse ≤ kadro) çözülür ve
                     sonuç mip_info['mip_info_stage1'] olarak saklanır.
                     False → tek çözüm, süre yarıya iner.
    sarkan_devret  : True → bir haftanın Pazar'ından ertesi haftanın
                     Pazartesi'sine sarkan kadro aktarılır (haftalar SIRAYLA
                     çözülür). False → her hafta sıfırdan planlanır
                     (operasyon kararı: Paz→Pzt geçişi kritik değil).
    onceki_ay_son_gun : önceki ayın son gününün sonucu ({kuyruk: {...}}).
                     Verilirse ayın 1'ine o günün sarkması enjekte edilir.

    Returns: {tarih: {kuyruk: {...}} | None}
    """
    results = {}
    df30 = prepare_forecast_calls_30(df_forecast, config=config)
    haftalar = _haftalar(year, month)

    print(f"\n{'='*78}")
    print(f"BİRLEŞİK HAFTALIK MODEL — {year}/{month:02d} · {len(haftalar)} hafta "
          f"· {len(queues)} kuyruk")
    print(f"  MIP1: {'açık' if mip1 else 'kapalı'}  |  "
          f"Paz→Pzt devri: {'açık' if sarkan_devret else 'kapalı'}")
    print(f"{'='*78}")

    devir = {q: {} for q in queues}          # {kuyruk: {slot: kişi}} — önceki haftadan
    ozetler = []

    for hafta, dates in haftalar:
        g0, g1 = dates[0], dates[-1]
        print(f"\n▶ Hafta {hafta}: {g0} → {g1} ({len(dates)} gün)")

        for queue in queues:
            df_sh = (df_shifts_dict.get(queue)
                     if isinstance(df_shifts_dict, dict) else df_shifts_dict)
            if df_sh is None:
                print(f"  ✗ {queue}: vardiya tablosu yok")
                continue

            # ---- ilk güne gelen sarkan ----
            sk = {}
            if dt.date.fromisoformat(g0).day == 1 and onceki_ay_son_gun:
                sk = _sarkan_disaridan(onceki_ay_son_gun, queue)
                if sk and verbose:
                    print(f"  ↳ {queue}: önceki aydan {sum(sk.values())} kişi-slot")
            elif sarkan_devret and devir.get(queue):
                sk = devir[queue]
                if sk and verbose:
                    print(f"  ↳ {queue}: önceki haftadan {sum(sk.values())} kişi-slot")

            # ---- MIP2 (asıl plan): inhouse = kadro ----
            ipd, oz = solve_week(df30, df_sh, queue, dates, config=config,
                                 sarkan_ilk_gun=sk or None,
                                 inhouse_esitlik=True, verbose=verbose)
            if ipd is None:
                print(f"  ✗ {queue}: çözüm yok ({oz})")
                for ds in dates:
                    results.setdefault(ds, {})[queue] = None
                continue

            # ---- MIP1 (tanısal): inhouse ≤ kadro ----
            ipd1 = None
            if mip1:
                ipd1, _ = solve_week(df30, df_sh, queue, dates, config=config,
                                     sarkan_ilk_gun=sk or None,
                                     inhouse_esitlik=False, verbose=False)

            # ---- sonucu sözleşmeye yaz ----
            for ds in dates:
                inf = ipd[ds]
                if ipd1 and ds in ipd1:
                    inf['mip_info_stage1'] = ipd1[ds]
                cbs = {}
                col = f"{queue}_total"
                df_g = df30[df30['data_date'] == pd.to_datetime(ds)]
                if col in df_g.columns:
                    cbs = {s: float(v) for s, v in zip(df_g['slot_30'], df_g[col])}
                tip = gun_tipi(ds)
                results.setdefault(ds, {})[queue] = {
                    'mip_info': inf,
                    'erlang_by_slot': inf['erlang_by_slot'],
                    'erlang_by_slot_ham': inf['erlang_by_slot_ham'],
                    'calls_by_slot': cbs,
                    'actual': None,
                    'date': pd.to_datetime(ds),
                    'queue': queue,
                    # hafta sonu Kap_RR config adresi için (monthly Excel okuyor)
                    'day_type': (None if tip == 'hafta_ici' else tip),
                    '_config': blok_coz(config, queue, ds),
                }

            if verbose:
                print_ozet(oz)
            ozetler.append(oz)
            devir[queue] = _sarkan_son_gun(ipd, dates)

    # ---- aylık özet ----
    print(f"\n{'='*78}")
    print("AYLIK ÖZET")
    print(f"{'='*78}")
    print(f"  {'kuyruk':<10}{'hafta':>6}{'gün':>5}{'kişi':>8}{'açık':>8}"
          f"{'RR fazla':>10}{'adam-gün':>10}{'PT':>8}{'sn':>7}")
    for oz in ozetler:
        if not oz or 'toplam_kisi' not in oz:
            continue
        print(f"  {oz['kuyruk']:<10}{oz['hafta']:>6}{oz['gun_sayisi']:>5}"
              f"{sum(oz['toplam_kisi'].values()):>8}"
              f"{sum(oz['kapsama_acik'].values()):>8}"
              f"{sum(oz['rr_fazla'].values()):>10}"
              f"{oz['adam_gun_kullanilan']:>10}"
              f"{oz['pt_gerceklesen']:>8}"
              f"{oz.get('sure_sn', 0):>7}")
    _t = sum(o.get('sure_sn', 0) for o in ozetler if o)
    print(f"\n  toplam çözüm süresi: {_t:.1f} sn "
          f"({len(ozetler)} MIP, MIP1 dahil değil)")
    return results

