def h18e_kota_kontrol():
    import datetime as dt
    import pandas as pd

    haftalar_k = {}
    for ds in PLAN_GUNLER:
        wk = dt.date.fromisoformat(ds).isocalendar()[:2]
        haftalar_k.setdefault(wk, []).append(ds)

    satirlar = []
    for a in hs_tek_normal:
        if a not in kota_map:
            continue

        kapasite_eski = kapasite_h18e = 0

        for gunler in haftalar_k.values():
            uygun = [
                ds for ds in gunler
                if any(
                    _kova_calisabilir(a, ds, v)
                    for v in gun_vardiyalari.get(ds, [])
                )
            ]
            hi = sum(
                dt.date.fromisoformat(ds).weekday() < 5
                for ds in uygun
            )
            hs = len(uygun) - hi

            # H12: tam haftada en fazla 6 çalışma günü.
            kapasite_eski += min(6, hi + hs)
            # H18E: aynı hafta sonunda en fazla 1 çalışma günü.
            kapasite_h18e += min(6, hi + min(1, hs))

        kota = kota_map[a]
        satirlar.append({
            "agent": a,
            "kota": kota,
            "H18E_oncesi_ust": kapasite_eski,
            "H18E_sonrasi_ust": kapasite_h18e,
            "kesin_kota_acigi": max(0, kota - kapasite_h18e),
        })

    tablo = pd.DataFrame(satirlar)
    if tablo.empty:
        print("Kontrol edilecek agent bulunamadı.")
        return

    sorun = tablo[tablo["kesin_kota_acigi"] > 0]
    print(f"Kontrol edilen normal agent: {len(tablo)}")
    print(f"H18E ile kotasına ulaşamayan agent: {len(sorun)}")

    if not sorun.empty:
        print(sorun.sort_values(
            "kesin_kota_acigi", ascending=False
        ).to_string(index=False))
    else:
        print("Bu kontrolde bireysel kota açığı bulunmadı.")

h18e_kota_kontrol()
